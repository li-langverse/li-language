 512:\n          i_max = 512\n        var k_max: int = kk + 64\n        if k_max > 512:\n          k_max = 512\n        var j_max: int = jj + 64\n        if j_max > 512:\n          j_max = 512\n        var ti: int = ii\n        while ti < i_max\n          var tk: int = kk\n          while tk < k_max\n            var aik: float = A[ti][tk]\n            var tj: int = jj\n            while tj < j_max\n              C[ti][tj] = C[ti][tj] + aik * B[tk][tj]\n              tj = tj + 1\n            tk = tk + 1\n          ti = ti + 1\n        jj = jj + 64\n      kk = kk + 64\n    ii = ii + 64\n  var acc: float = 0.0\n  var i_sum: int = 0\n  while i_sum < 512\n    var j_sum: int = 0\n    while j_sum < 512\n      acc = acc + C[i_sum][j_sum]\n      j_sum = j_sum + 1\n    i_sum = i_sum + 1\n  li_rt_volatile_sink_f64(acc)\n  return 0\n",
