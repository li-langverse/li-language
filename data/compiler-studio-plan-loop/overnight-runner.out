              "content": "name: Lean semantics\n\non:\n  pull_request:\n    branches: [main, dev]\n  push:\n    branches: [main]\n\njobs:\n  lake-build:\n    runs-on: ubuntu-24.04\n    steps:\n      - uses: actions/checkout@v4\n\n      - name: Install LLVM 22 and build lic\n        run: |\n          chmod +x scripts/ci-install-llvm.sh\n          sudo LI_LLVM_MAJOR=22 bash scripts/ci-install-llvm.sh\n          cmake -B build -G Ninja -DLLVM_DIR=/usr/lib/llvm-22/lib/cmake/llvm -DCMAKE_C_COMPILER=clang-22 -DCMAKE_CXX_COMPILER=clang++-22\n          cmake --build build -j \"$(nproc)\" --target lic\n\n      - name: Install elan (Lean 4)\n        run: |\n          curl -sSf https://raw.githubusercontent.com/leanprover/elan/master/elan-init.sh | sh -s -- -y --default-toolchain stable\n          echo \"$HOME/.elan/bin\" >> \"$GITHUB_PATH\"\n\n      - name: Discharge corpus + P-linalg AutoVC lake typecheck\n        env:\n          LI_REPO_ROOT: ${{ github.workspace }}\n        run: |\n          chmod +x scripts/check-autovc-open-goals.sh scripts/lean-verify-stub.sh \\\n            li-tests/tooling/discharge_trivial_lean.sh \\\n            li-tests/tooling/discharge_linalg_int_lean.sh \\\n            li-tests/tooling/contracts_verify_lean.sh \\\n            li-tests/tooling/autovc_lake_typecheck.sh \\\n            li-tests/tooling/glean_strict_build_smoke.sh\n          ./li-tests/tooling/discharge_trivial_lean.sh\n          LIC=\"${{ github.workspace }}/build/compiler/lic/lic\"\n          \"$LIC\" build li-tests/contracts_verify/sqrt_contract.li -o /dev/null\n          ./li-tests/tooling/discharge_linalg_int_lean.sh\n          \"$LIC\" build li-tests/contracts_verify/linalg_dot4_float_closed.li -o /dev/null\n          ./li-tests/tooling/autovc_lake_typecheck.sh\n          ./li-tests/tooling/glean_strict_build_smoke.sh\n",
