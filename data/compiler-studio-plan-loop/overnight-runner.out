ty.sh\n-rwxr-xr-x  1 s4il0r s4il0r  2904 May 22 22:39 check-version.sh\n/home/s4il0r/Documents/Cursor/li-langverse/lic/benchmarks/harness/reference.py\nanimate_md.py\nanimate_physics.py\nbench_ecosystem.py\nbench.py\nparams_schema.toml\nplot.py\nplot_theme.py\nrequirements.txt\nstability.py\ntrace_energy.py\nverify.py\n",
