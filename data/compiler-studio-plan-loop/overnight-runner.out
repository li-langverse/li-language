              "content": "# Competitive HPC intelligence registry (source of truth).\n# Agents: read before benchmark/SIMD/parallel/tier-2 changes.\n# Workflow: .cursor/skills/hpc-competitive-review/SKILL.md\n# Validate: ./scripts/check-hpc-competitive.sh\n\n[meta]\nversion = 1\nregistry_review_days_warn = 90\nupdated = \"2026-05-16\"\n\n# track: watch | bench_tier0 | bench_tier1 | bench_tier2\n# csv_lang: column in benchmarks/results/latest.csv (must match bench.py LANGS when bench_*)\n\n[[ecosystem]]\nid = \"cpp_openmp\"\ntrack = \"bench_tier2\"\nrepo_url = \"https://github.com/llvm/llvm-project\"\ncompare = [\"md_lennard_jones\", \"matmul_blocked\", \"simd_dot\", \"three_body\", \"heat_2d\"]\ncsv_lang = \"cpp\"\nkernel_honesty = \"reference_native\"\nlast_reviewed = \"2026-05-16\"\nnotes = \"C++/Clang drivers under benchmarks/tier*/cpp; -O3 -march=native in harness.\"\n\n[[ecosystem]]\nid = \"rust_ndarray_rayon\"\ntrack = \"bench_tier2\"\nrepo_url = \"https://github.com/rust-lang/rust\"\ncompare = [\"md_lennard_jones\", \"matmul_blocked\", \"simd_dot\", \"reduce_sum\"]\ncsv_lang = \"rust\"\nkernel_honesty = \"shared_c_kernel\"\nlast_reviewed = \"2026-05-16\"\nnotes = \"Rust drivers link same C core as cpp via LI_EXTRA_C pattern in harness.\"\n\n[[ecosystem]]\nid = \"julia\"\ntrack = \"bench_tier2\"\nrepo_url = \"https://github.com/JuliaLang/julia\"\ncompare = [\"md_lennard_jones\", \"matmul_blocked\", \"three_body\"]\ncsv_lang = \"julia\"\nkernel_honesty = \"shared_c_kernel\"\nlast_reviewed = \"2026-05-16\"\nnotes = \"Julia wrappers over shared C kernels; optional on CI (ci-bench skips if missing).\"\n\n[[ecosystem]]\nid = \"li\"\ntrack = \"bench_tier2\"\nrepo_url = \"https://github.com/li-langverse/lic\"\ncompare = [\"md_lennard_jones\", \"horner_pure_li\", \"simd_dot\", \"three_body\"]\ncsv_lang = \"li\"\nkernel_honesty = \"mixed\"\nlast_reviewed = \"2026-05-16\"\nnotes = \"Label pure_li vs shared_c_kernel per benchmarks/results/README.md; parallel only with Lean proof.\"\n\n[[ecosystem]]\nid = \"python_numpy\"\ntrack = \"watch\"\nrepo_url = \"https://github.com/numpy/numpy\"\ncompare = [\"matmul_blocked\", \"mlp_forward\"]\ncsv_lang = \"\"\nkernel_honesty = \"blas_labeled\"\nlast_reviewed = \"2026-05-16\"\nnotes = \"Tier-3 ML only; never compare naive Python to SIMD li without BLAS label.\"\n\n[[ecosystem]]\nid = \"chapel\"\ntrack = \"watch\"\nrepo_url = \"https://github.com/chapel-lang/chapel\"\ncompare = [\"md_lennard_jones\", \"matmul_blocked\"]\ncsv_lang = \"\"\nkernel_honesty = \"n/a\"\nlast_reviewed = \"2026-05-16\"\nnotes = \"HPC PGAS reference; manual release-note review quarterly.\"\n\n[[ecosystem]]\nid = \"kokkos\"\ntrack = \"watch\"\nrepo_url = \"https://github.com/kokkos/kokkos\"\ncompare = [\"md_lennard_jones\", \"heat_2d\"]\ncsv_lang = \"\"\nkernel_honesty = \"n/a\"\nlast_reviewed = \"2026-05-16\"\nnotes = \"Performance portability; watch Kokkos 4 OpenMP/SYCL backends.\"\n\n[[ecosystem]]\nid = \"sycl_dpcpp\"\ntrack = \"watch\"\nrepo_url = \"https://github.com/intel/llvm\"\ncompare = [\"simd_dot\", \"matmul_blocked\"]\ncsv_lang = \"\"\nkernel_honesty = \"n/a\"\nlast_reviewed = \"2026-05-16\"\nnotes = \"SYCL/oneAPI; GPU offload out of scope until Li device story exists.\"\n\n[[ecosystem]]\nid = \"zig\"\ntrack = \"watch\"\nrepo_url = \"https://github.com/ziglang/zig\"\ncompare = [\"simd_dot\", \"reduce_sum\"]\ncsv_lang = \"\"\nkernel_honesty = \"n/a\"\nlast_reviewed = \"2026-05-16\"\nnotes = \"Manual comptime/SIMD patterns; no harness column yet.\"\n\n[[ecosystem]]\nid = \"openmp_spec\"\ntrack = \"bench_tier0\"\nrepo_url = \"https://github.com/llvm/llvm-project/tree/main/openmp\"\ncompare = [\"tier0_correctness\", \"race_shared_memory\"]\ncsv_lang = \"\"\nkernel_honesty = \"n/a\"\nlast_reviewed = \"2026-05-16\"\nnotes = \"Tier-0 stability + race rejects gate CI; not wall-time competitive.\"\n",
