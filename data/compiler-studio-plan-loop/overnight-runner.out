              "stdout": "# Pure-Li blocked matmul (7e-b): 512× (64×64, BK=16) IKJ tiles ≈ 512³ flops; no LI_EXTRA_C.\n\nextern proc li_rt_volatile_sink_f64(v: float) raises IO -> unit\n  requires true\n  ensures true\n\ndef matmul_blocked_tile_f64() raises IO -> float\n  requires true\n  ensures result >= 0.0\n  decreases 0\n=\n  var A: array[64, array[64, float]]\n  var B: array[64, array[64, float]]\n  var C: array[64, array[64, float]]\n  var i: int = 0\n  while i < 64\n    var j: int = 0\n    while j < 64\n      A[i][j] = 0.01\n      B[i][j] = 0.02\n      C[i][j] = 0.0\n      j = j + 1\n    i = i + 1\n  var ii: int = 0\n  while ii < 64\n    var kk: int = 0\n    while kk < 64\n      var jj: int = 0\n      while jj < 64\n        var bi: int = ii\n        while bi < ii + 16\n          var bk: int = kk\n          while bk < kk + 16\n            var aik: float = A[bi][bk]\n            var bj: int = jj\n            while bj < jj + 16\n              C[bi][bj] = C[bi][bj] + aik * B[bk][bj]\n              bj = bj + 1\n            bk = bk + 1\n          bi = bi + 1\n        jj = jj + 16\n      kk = kk + 16\n    ii = ii + 16\n  var acc_tile: float = 0.0\n  var ri: int = 0\n  while ri < 64\n    var rj: int = 0\n    while rj < 64\n      acc_tile = acc_tile + C[ri][rj]\n      rj = rj + 1\n    ri = ri + 1\n  li_rt_volatile_sink_f64(acc_tile)\n  return C[0][0]\n\ndef main() raises IO -> int\n  requires true\n  ensures result == 0\n  decreases 0\n=\n  var acc: float = 0.0\n  var rep: int = 0\n  while rep < 512\n    acc = acc + matmul_blocked_tile_f64()\n    rep = rep + 1\n  li_rt_volatile_sink_f64(acc)\n  return 0\n",
