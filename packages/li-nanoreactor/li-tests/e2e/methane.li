# E2E — full nanoreactor driver on the methane sample system.
import nanoreactor

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  var s: NanoSystem = nano_system_methane()
  if s.n != 5:
    return 1
  # methane starts covalently bonded: C-H distance (sqrt(3)*0.9) is inside the
  # bond cutoff, so the initial bond count is nonzero (system sanity check).
  var px: array[8, float] = s.px
  var py: array[8, float] = s.py
  var pz: array[8, float] = s.pz
  var b0: int = nano_bond_count(px, py, pz, 5, nano_bond_cutoff2())
  if b0 < 1:
    return 2
  var r: NanoRunResult = nano_run_cycles(s, 4)
  if r.ok != 1:
    return 3
  if r.steps != 32:
    return 4
  if r.checksum <= 0.0:
    return 5
  return 0
