# E2E — full nanoreactor driver on the H2 + O2 reactive sample system.
# This is the classic nanoreactor-style reactive collision test: separate
# diatomics in a box, piston compression + thermal cycling drive them
# together, and bond-count changes are detected as reaction events.
import nanoreactor

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  var s: NanoSystem = nano_system_h2_o2()
  if s.n != 4:
    return 1
  var r: NanoRunResult = nano_run_cycles(s, 8)
  if r.ok != 1:
    return 2
  if r.steps != 64:
    return 3
  if r.checksum <= 0.0:
    return 4
  return 0
