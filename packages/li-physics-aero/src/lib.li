
extern def li_rt_sqrt(x: float) raises IO -> float
  requires true
  ensures true
  decreases 0
extern def li_rt_sin(x: float) raises IO -> float
  requires true
  ensures true
  decreases 0
extern def li_rt_cos(x: float) raises IO -> float
  requires true
  ensures true
  decreases 0
extern def li_rt_exp(x: float) raises IO -> float
  requires true
  ensures true
  decreases 0
def li_std_physics_aero_version() raises IO -> int
  requires true
  ensures result == 1
  decreases 0
=
  return 1
def atmosphere_density_exponential(altitude: float, rho0: float, scale_h: float) raises IO -> float
  requires rho0 > 0.0
  requires scale_h > 0.0
  ensures result == rho0 * li_rt_exp(-altitude / scale_h)
  decreases 0
=
  return rho0 * li_rt_exp(-altitude / scale_h)
def lift_coefficient_alpha(alpha_rad: float) -> float
  requires true
  ensures result == 2.0 * 3.14159265 * alpha_rad
  decreases 0
=
  return 2.0 * 3.14159265 * alpha_rad
def drag_force(speed: float, rho: float, cd: float, area: float) -> float
  requires speed >= 0.0
  requires rho >= 0.0
  requires cd >= 0.0
  requires area >= 0.0
  ensures result == 0.5 * rho * speed * speed * cd * area
  decreases 0
=
  return 0.5 * rho * speed * speed * cd * area
def orbit_circular_period(mu: float, radius: float) raises IO -> float
  requires mu > 0.0
  requires radius > 0.0
  ensures result == two_pi * li_rt_sqrt(radius * radius * radius / mu)
  decreases 0
=
  var two_pi: float = 2.0 * 3.14159265
  return two_pi * li_rt_sqrt(radius * radius * radius / mu)
def two_body_accel(
    ax: float, ay: float, bx: float, by: float,
    mu: float, soft: float,
    out_ax: float, out_ay: float) -> unit
  requires mu > 0.0
  ensures true
  decreases 0
=
  return
