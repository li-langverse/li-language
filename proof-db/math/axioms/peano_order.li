# Peano + order axioms — the trusted base of the Li proof database (M-AX-PEANO-*,
# M-AX-ORDER-*). These mirror `MathAxioms.lean` (Li.ProofDb.Math.*) so the math
# layer lives in li source; `int` stands in for Nat and `+1` for succ.
#
# Declared with `axiom` = trusted, no proof (tiny trusted base, same as
# docs/semantics/trusted.lean). Discharge of derived theorems is Layer 2.

axiom peano_zero_not_succ(n: int) : not (n + 1 == 0)

axiom peano_succ_injective(a: int, b: int) : (a + 1 == b + 1) -> a == b

# NOTE: peano_induction (M-AX-PEANO-IND) is second-order (P : Nat -> Prop) and is
# not expressible as a first-order li axiom until higher-order support lands;
# it stays a Lean axiom (Li.ProofDb.Math.peano_induction) for now.

axiom order_trichotomy_nat(a: int, b: int) : (a < b) or (a == b) or (b < a)

axiom order_antisym(a: int, b: int) : (a <= b and b <= a) -> a == b

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  return 0
