def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  var A: array[2, array[2, float]]
  var B: array[2, array[2, float]]
  var D: array[2, array[2, float]]
  var C: array[2, array[2, float]]
  A[0][0] = 1.0
  A[0][1] = 2.0
  A[1][0] = 3.0
  A[1][1] = 4.0
  B[0][0] = 5.0
  B[0][1] = 6.0
  B[1][0] = 7.0
  B[1][1] = 8.0
  D[0][0] = 9.0
  D[0][1] = 10.0
  D[1][0] = 11.0
  D[1][1] = 12.0
  C = (A @ B) @ D
  var s: float = C[0][0] + C[0][1] + C[1][0] + C[1][1]
  if s < 0.0:
    return 1
  return 0
