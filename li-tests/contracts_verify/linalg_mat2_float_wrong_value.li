# P-linalg negative guard: the matmul value fold is real — asserting a wrong
# cell value must fail requires enforcement at typecheck (E0304), like ints.

def mat2_mul(A: array[2, array[2, float]], B: array[2, array[2, float]]) -> array[2, array[2, float]]
  requires true
  ensures result[0][0] == A[0][0] * B[0][0] + A[0][1] * B[1][0] and result[0][1] == A[0][0] * B[0][1] + A[0][1] * B[1][1] and result[1][0] == A[1][0] * B[0][0] + A[1][1] * B[1][0] and result[1][1] == A[1][0] * B[0][1] + A[1][1] * B[1][1]
  decreases 0
=
  return A @ B

def check_cell(c: float, want: float) -> int
  requires c == want
  ensures result == 0
  decreases 0
=
  return 0

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  var A: array[2, array[2, float]]
  var B: array[2, array[2, float]]
  A[0][0] = 1.0
  A[0][1] = 2.0
  A[1][0] = 3.0
  A[1][1] = 4.0
  B[0][0] = 5.0
  B[0][1] = 6.0
  B[1][0] = 7.0
  B[1][1] = 8.0
  var C: array[2, array[2, float]] = mat2_mul(A, B)
  check_cell(C[0][0], 20.0)
  return 0
