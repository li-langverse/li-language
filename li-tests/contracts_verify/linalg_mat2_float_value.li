# P-linalg: 2×2 float matmul — finished value certificate.
#
# `C = mat2_mul(A, B)` on array[2, array[2, float]] tiles: the callee `ensures`
# is a conjunction of per-cell equations, so the call folds each cell to a
# constant (`C[0][0] == 19.0`, ...) from the 2D element stores, and every
# `check_cell` requires discharges natively. The closed form `return A @ B` is
# witnessed by the mat2 spec (Li.Discharge.mat2_at2_float_spec).

def mat2_mul(A: array[2, array[2, float]], B: array[2, array[2, float]]) -> array[2, array[2, float]]
  requires true
  ensures result[0][0] == A[0][0] * B[0][0] + A[0][1] * B[1][0] and result[0][1] == A[0][0] * B[0][1] + A[0][1] * B[1][1] and result[1][0] == A[1][0] * B[0][0] + A[1][1] * B[1][0] and result[1][1] == A[1][0] * B[0][1] + A[1][1] * B[1][1]
  decreases 0
=
  return A @ B

def check_cell(c: float, want: float) -> int
  requires c == want
  ensures result == 0
  decreases 0
=
  return 0

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  var A: array[2, array[2, float]]
  var B: array[2, array[2, float]]
  A[0][0] = 1.0
  A[0][1] = 2.0
  A[1][0] = 3.0
  A[1][1] = 4.0
  B[0][0] = 5.0
  B[0][1] = 6.0
  B[1][0] = 7.0
  B[1][1] = 8.0
  var C: array[2, array[2, float]] = mat2_mul(A, B)
  check_cell(C[0][0], 19.0)
  check_cell(C[0][1], 22.0)
  check_cell(C[1][0], 43.0)
  check_cell(C[1][1], 50.0)
  return 0
