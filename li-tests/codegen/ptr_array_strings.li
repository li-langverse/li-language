# Regression: `array[N, ptr]` element loads/stores must be pointer-width (i64),
# and string-literal element stores must materialize the global. Previously the
# element type was i32 and string literals were dropped, so the sum read
# garbage (E0360-class codegen bug found during the Layer-4 policy port).
extern def li_rt_str_len(s: ptr) -> int
  requires true
  ensures true
def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  var a: array[4, ptr]
  a[0] = "alpha"
  a[1] = "beta"
  a[2] = "gamma"
  a[3] = "delta"
  var total: int = 0
  var q: int = 0
  while q < 4:
    total = total + li_rt_str_len(a[q])
    q = q + 1
  if total != 19:
    return 1
  return 0
