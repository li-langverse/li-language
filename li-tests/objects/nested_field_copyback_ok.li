# The supported way to mutate a nested object field. A multi-hop field-path
# store (`o.t.a = v`) is rejected at the MIR stage by both compilers (see
# nested_field_write.li), so the nested object is copied out, mutated on the
# copy, and assigned back whole — one-hop stores (`o.t = v` whole object,
# `o.a = v` scalar leaf) plus nested array-element writes
# (`o.t.arr[0] = v`, see nested_index_write.li) stay supported. This fixture
# pins that the copy-back shape compiles, runs, and actually carries the
# mutated values (and the untouched sibling field) through the copy, in both
# directions: writing the copy back into the field, and reading a populated
# nested field out into a local (including an object-valued leaf, which the
# object-copy path has to carry too).
type Tier = object
  public tier_id: int
  public fps_target: float

type Draw = object
  public tier: Tier
  public frame_count: int

type Inner = object
  public x: int
  public y: float

type Mid = object
  public inner: Inner
  public tag: int

type Outer = object
  public mid: Mid

def main() -> int
  requires true
  ensures result == 0
  decreases 0
=
  var d: Draw
  d.frame_count = 3
  var tier_t: Tier = d.tier
  tier_t.tier_id = 7
  tier_t.fps_target = 250.0
  d.tier = tier_t
  if d.tier.tier_id != 7:
    return 1
  if d.tier.fps_target != 250.0:
    return 2
  if d.frame_count != 3:
    return 3
  # Copy a populated nested field OUT into a local: the leaves must come along.
  var tier_u: Tier = d.tier
  if tier_u.tier_id != 7:
    return 4
  if tier_u.fps_target != 250.0:
    return 5
  # A second copy-back cycle writes every field explicitly.
  var frame: Tier
  frame.tier_id = 8
  frame.fps_target = 260.0
  d.tier = frame
  if d.tier.tier_id != 8:
    return 6
  if d.tier.fps_target != 260.0:
    return 7
  if d.frame_count != 3:
    return 8
  # The same copy-out over a nested field whose type itself has an
  # object-valued leaf (o.mid -> Mid{inner: Inner}), i.e. the recursive
  # object-copy path rather than a flat leaf list.
  var i: Inner
  i.x = 11
  i.y = 22.0
  var m: Mid
  m.tag = 5
  m.inner = i
  var o: Outer
  o.mid = m
  if o.mid.tag != 5:
    return 9
  if o.mid.inner.x != 11:
    return 10
  if o.mid.inner.y != 22.0:
    return 11
  var m2: Mid = o.mid
  if m2.tag != 5:
    return 12
  if m2.inner.x != 11:
    return 13
  if m2.inner.y != 22.0:
    return 14
  return 0
