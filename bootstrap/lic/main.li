  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_nl()
  lastop[0] = op
  return 0

# Emit INS with a mangled name as LHS of a binop
def mir_ins_mangled_binop(src: var ptr, op: int, dest_s: int, dest_e: int, lhs_s: int, lhs_e: int, rhs_s: int, rhs_e: int, flag1: int, flag2: int, binop: int, lastop: var array[1, int]) raises IO -> int
  requires true
  ensures result == 0
  decreases 0
=
  li_rt_mir_str("INS")
  li_rt_ast_space()
  li_rt_ast_int(op)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  # dest name cell: __li_o_<dest>
  li_rt_mir_str("__li_o_")
  li_rt_mir_esc(src, dest_s, dest_e)
  # lhs name cell
  li_rt_ast_space()
  li_rt_mir_str("__li_o_")
  li_rt_mir_esc(src, lhs_s, lhs_e)
  # rhs name cell
  li_rt_ast_space()
  li_rt_mir_str("__li_o_")
  li_rt_mir_esc(src, rhs_s, rhs_e)
  # 3 empty name cells
  li_rt_ast_space()
  li_rt_ast_space()
  li_rt_ast_space()
  # f18..f21
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(flag1)
  # name cell 6 (empty)
  li_rt_ast_space()
  # f25..f36
  li_rt_ast_space()
  li_rt_ast_int(flag2)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_nl()
  lastop[0] = op
  return 0
def mir_obj_type_count(itmp: var array[4096, int]) -> int
  requires true
  ensures result >= 0
  decreases 0
=
  var n: int = li_rt_reg_get(lr_n_type())
  return n

# Simple polynomial hash of a name slice — used for cross-source type lookups
# where the registered positions point into a different source buffer.
def mir_name_hash(src: var ptr, s: int, e: int) -> int
  requires true
  ensures result >= 0
  decreases 0
=
  var h: int = 0
  var i: int = s
  while i < e:
    h = h * 31 + li_rt_str_char_at(src, i)
    h = h % 2147483647
    i = i + 1
  return h

def mir_obj_reg_type(itmp: var array[4096, int], src: var ptr, ts: var array[262144, int], te: var array[262144, int],
  type_start: int, type_end: int, nf: int, fbase: int, base_start: int, base_end: int) raises IO -> int
  requires true
  ensures result == 0
  decreases 0
=
  var i: int = li_rt_reg_get(lr_n_type())
  # Capacity is derived (lr_type_cap), not a magic bound. Exceeding it marks
  # the registry unusable so the module build fails loudly instead of emitting
  # MIR with a silently dropped object type.
  if i >= lr_type_cap():
    mir_reg_fail()
    return 0
  mir_reg_set(lr_type_b() + i * 6 + 0, type_start)
  mir_reg_set(lr_type_b() + i * 6 + 1, type_end)
  mir_reg_set(lr_type_b() + i * 6 + 2, nf)
  mir_reg_set(lr_type_b() + i * 6 + 3, fbase)
  mir_reg_set(lr_type_b() + i * 6 + 4, base_start)
  mir_reg_set(lr_type_b() + i * 6 + 5, base_end)
  # Store hash + length in the type hash/length region for cross-source lookup
  mir_reg_set(lr_thash_b() + i, mir_name_hash(src, type_start, type_end))
  mir_reg_set(lr_tlen_b() + i, type_end - type_start)
  li_rt_type_src_store(i, src)
  mir_reg_set(lr_n_type(), i + 1)
  return 0

def mir_obj_find_type(src: var ptr, ts: var array[262144, int], te: var array[262144, int],
  itmp: var array[4096, int], name_start: int, name_end: int) -> int
  requires true
  ensures result >= -1
  decreases 0
=
  var nobj: int = li_rt_reg_get(lr_n_type())
  var h: int = mir_name_hash(src, name_start, name_end)
  var nlen: int = name_end - name_start
  var i: int = 0
  while i < nobj:
    if li_rt_reg_get(lr_thash_b() + i) == h and li_rt_reg_get(lr_tlen_b() + i) == nlen:
      return i
    i = i + 1
  return -1

def mir_obj_find_rettype(itmp: var array[4096, int], pid: int) -> int
  requires true
  ensures result >= -1
  decreases 0
=
  # Look up the object layout for a callee's return type via the retname
  # registry (hash+len match, cross-file safe like mir_obj_find_type).
  var h: int = li_rt_mir_retname_hash(pid)
  var nlen: int = li_rt_mir_retname_len(pid)
  if nlen == 0:
    return -1
  var nobj: int = li_rt_reg_get(lr_n_type())
  var i: int = 0
  while i < nobj:
    if li_rt_reg_get(lr_thash_b() + i) == h and li_rt_reg_get(lr_tlen_b() + i) == nlen:
      return i
    i = i + 1
  return -1

def mir_obj_field_count(itmp: var array[4096, int], type_idx: int) -> int
  requires true
  ensures result >= 0
  decreases 0
=
  var nf: int = li_rt_reg_get(lr_type_b() + type_idx * 6 + 2)
  return nf

def mir_obj_field_name(itmp: var array[4096, int], type_idx: int, field_idx: int, ret: var array[2, int]) -> int
  requires true
  ensures result == 0
  decreases 0
=
  var fbase: int = li_rt_reg_get(lr_type_b() + type_idx * 6 + 3)
  var s0: int = li_rt_reg_get(lr_fname_b() + (fbase + field_idx) * 2 + 0)
  var s1: int = li_rt_reg_get(lr_fname_b() + (fbase + field_idx) * 2 + 1)
  ret[0] = s0
  ret[1] = s1
  return 0

def mir_obj_field_float(itmp: var array[4096, int], type_idx: int, field_idx: int) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  var fbase: int = li_rt_reg_get(lr_type_b() + type_idx * 6 + 3)
  var f: int = li_rt_reg_get(lr_ffloat_b() + (fbase + field_idx) + 0)
  return f

# Recursive helper: emit CopyObj/StoreFloat for every leaf field of an
# object type, building compound prefix names via the objname registry.
# dst_oi/src_oi are objname indices for the base prefix (e.g. __li_o_d, __li_o___cr71).
def mir_obj_emit_copy_r(src: var ptr,  ts: var array[262144, int],  te: var array[262144, int], itmp: var array[4096, int],  type_idx: int,  dst_oi: int,  src_oi: int,  tc: var array[1, int]) raises IO -> int
  requires true
  ensures result == 0
  decreases 0
=
  var nf: int = mir_obj_field_count(itmp, type_idx)
  var i: int = 0
  var fa_r: array[2, int]
  var tsrc_r: ptr = li_rt_type_src_get(type_idx)
  if tsrc_r == 0:
    tsrc_r = src
  while i < nf:
    mir_obj_field_name(itmp, type_idx, i, fa_r)
    var sub_r: int = mir_obj_field_obj_type(src, ts, te, itmp, type_idx, i)
    if sub_r >= 0:
      # Sub-object: recurse with nested objname for both dst and src
      var ndst: int = li_rt_mir_objname_add_nested(dst_oi, tsrc_r, fa_r[0], fa_r[1])
      var nsrc: int = li_rt_mir_objname_add_nested(src_oi, tsrc_r, fa_r[0], fa_r[1])
      mir_obj_emit_copy_r(src, ts, te, itmp, sub_r, ndst, nsrc, tc)
    else:
      var fel_r: int = mir_obj_field_elems(itmp, type_idx, i)
      if fel_r == 0:
        # Scalar leaf: emit CopyObj/StoreFloat
        var cop_r: int = 26
        if mir_obj_field_float(itmp, type_idx, i) == 1:
          cop_r = 28
        li_rt_mir_str("INS")
        li_rt_ast_space()
        li_rt_ast_int(cop_r)
        li_rt_ast_space()
        li_rt_ast_int(0)
        li_rt_ast_space()
        li_rt_ast_int(0)
        li_rt_ast_space()
        var ndst2: int = li_rt_mir_objname_add_nested(dst_oi, tsrc_r, fa_r[0], fa_r[1])
        li_rt_mir_objname_out(ndst2)
        li_rt_ast_space()
        li_rt_ast_space()
        li_rt_ast_space()
        li_rt_ast_space()
        var nsrc2: int = li_rt_mir_objname_add_nested(src_oi, tsrc_r, fa_r[0], fa_r[1])
        li_rt_mir_objname_out(nsrc2)
        li_rt_ast_space()
        li_rt_ast_space()
        li_rt_ast_int(0)
        li_rt_ast_space()
        li_rt_ast_int(0)
        li_rt_ast_space()
        li_rt_ast_int(0)
        li_rt_ast_space()
        li_rt_ast_int(1)
        li_rt_ast_space()
        li_rt_ast_space()
        li_rt_ast_int(0)
        li_rt_ast_space()
        li_rt_ast_int(0)
        li_rt_ast_space()
        li_rt_ast_int(0)
        li_rt_ast_space()
        li_rt_ast_int(0)
        li_rt_ast_space()
        li_rt_ast_int(0)
        li_rt_ast_space()
        li_rt_ast_int(0)
        li_rt_ast_space()
        li_rt_ast_int(0)
        li_rt_ast_space()
        li_rt_ast_int(0)
        li_rt_ast_space()
        li_rt_ast_int(0)
        li_rt_ast_space()
        li_rt_ast_int(0)
        li_rt_ast_space()
        li_rt_ast_int(0)
        li_rt_ast_space()
        li_rt_ast_int(0)
        li_rt_ast_nl()
      else:
        # Array leaf: element-wise load/store
        var cop_r2: int = 10
        if mir_obj_field_float(itmp, type_idx, i) == 1:
          cop_r2 = 12
        var e_r: int = 0
        while e_r < fel_r:
          var t_r: int = tc[0]
          tc[0] = t_r + 1
          li_rt_mir_str("INS")
          li_rt_ast_space()
          li_rt_ast_int(11)
          li_rt_ast_space()
          li_rt_ast_int(e_r)
          li_rt_ast_space()
          li_rt_ast_int(0)
          li_rt_ast_space()
          li_rt_mir_objname_out(src_oi)
          li_rt_mir_str("_")
          li_rt_mir_esc(tsrc_r, fa_r[0], fa_r[1])
          li_rt_ast_space()
          li_rt_ast_space()
          li_rt_ast_space()
          li_rt_mir_str("__t")
          li_rt_ast_int(t_r)
          li_rt_ast_space()
          li_rt_ast_space()
          li_rt_ast_space()
          li_rt_ast_int(0)
          li_rt_ast_space()
          li_rt_ast_int(0)
          li_rt_ast_space()
          li_rt_ast_int(0)
          li_rt_ast_space()
          li_rt_ast_int(1)
          li_rt_ast_space()
          li_rt_ast_space()
          li_rt_ast_int(0)
          li_rt_ast_space()
          li_rt_ast_int(1)
          li_rt_ast_space()
          li_rt_ast_int(0)
          li_rt_ast_space()
          li_rt_ast_int(0)
          li_rt_ast_space()
          li_rt_ast_int(0)
          li_rt_ast_space()
          li_rt_ast_int(0)
          li_rt_ast_space()
          li_rt_ast_int(0)
          li_rt_ast_space()
          li_rt_ast_int(0)
          li_rt_ast_space()
          li_rt_ast_int(0)
          li_rt_ast_space()
          li_rt_ast_int(0)
          li_rt_ast_nl()
          li_rt_mir_str("INS")
          li_rt_ast_space()
          li_rt_ast_int(cop_r2)
          li_rt_ast_space()
          li_rt_ast_int(e_r)
          li_rt_ast_space()
          li_rt_ast_int(0)
          li_rt_ast_space()
          li_rt_mir_objname_out(dst_oi)
          li_rt_mir_str("_")
          li_rt_mir_esc(tsrc_r, fa_r[0], fa_r[1])
          li_rt_ast_space()
          li_rt_ast_space()
          li_rt_ast_space()
          li_rt_ast_space()
          li_rt_mir_str("__t")
          li_rt_ast_int(t_r)
          li_rt_ast_space()
          li_rt_ast_space()
          li_rt_ast_int(0)
          li_rt_ast_space()
          li_rt_ast_int(0)
          li_rt_ast_space()
          li_rt_ast_int(0)
          li_rt_ast_space()
          li_rt_ast_int(1)
          li_rt_ast_space()
          li_rt_ast_space()
          li_rt_ast_int(0)
          li_rt_ast_space()
          li_rt_ast_int(0)
          li_rt_ast_space()
          li_rt_ast_int(0)
          li_rt_ast_space()
          li_rt_ast_int(0)
          li_rt_ast_space()
          li_rt_ast_int(0)
          li_rt_ast_space()
          li_rt_ast_int(0)
          li_rt_ast_nl()
          e_r = e_r + 1
    i = i + 1
  return 0

def mir_obj_emit_copy(src: var ptr,  ts: var array[262144, int],  te: var array[262144, int], itmp: var array[4096, int],  obj_ti: int,  fidx: int,  dst_s: int,  dst_e: int,  src_s: int,  src_e: int,  src_is_cr: int,  crid: int,  tc: var array[1, int]) raises IO -> int
  requires true
  ensures result == 0
  decreases 0
=
  var fel: int = mir_obj_field_elems(itmp, obj_ti, fidx)
  var fa: array[2, int]
  mir_obj_field_name(itmp, obj_ti, fidx, fa)
  var fs: int = fa[0]
  var fe: int = fa[1]
  var sub_obj: int = mir_obj_field_obj_type(src, ts, te, itmp, obj_ti, fidx)
  # Object-valued fields use one aggregate base copy; their flattened leaf
  # slots are described separately in the enclosing OBJ/PARAM layout.
  # Field positions are from the type's source (stored during mir_obj_reg_field)
  var tsrc: ptr = li_rt_type_src_get(obj_ti)
  if tsrc == 0:
    tsrc = src
  # Sub-object fields: recurse to emit individual leaf copies with compound
  # prefix names (e.g. __li_o_d_tier_tier_id). Mirrors C++ emit_copy_object_slots_r.
  if sub_obj >= 0:
    # Register compound prefixes via C helper (avoids Li move-semantics issues)
    # Determine dst prefix type: src_is_cr==2 means dst is wb temp
    var dst_cr: int = 0
    var dst_crid: int = 0
    if src_is_cr == 2:
      dst_cr = 3
      dst_crid = crid
    var dst_oi: int = li_rt_mir_objname_reg_prefix(src, dst_s, dst_e, fs, fe, dst_cr, dst_crid, tsrc)
    # Determine src prefix type: src_is_cr==1 means cr, src_is_cr==3 means wb,
    # src_is_cr==4 means the source is a nested field path held in the
    # fieldpath registry at crid (__li_o_<fieldpath>_<field>).
    var src_cr: int = src_is_cr
    if src_is_cr == 2:
      src_cr = 0
    var src_oi: int = 0
    if src_is_cr == 4:
      src_oi = li_rt_mir_objname_reg_prefix_fp(crid, fs, fe, tsrc)
    else:
      src_oi = li_rt_mir_objname_reg_prefix(src, src_s, src_e, fs, fe, src_cr, crid, tsrc)
    mir_obj_emit_copy_r(src, ts, te, itmp, sub_obj, dst_oi, src_oi, tc)
    return 0
  if fel == 0:
    var cop: int = 26
    if mir_obj_field_float(itmp, obj_ti, fidx) == 1:
      cop = 28
    li_rt_mir_str("INS")
    li_rt_ast_space()
    li_rt_ast_int(cop)
    li_rt_ast_space()
    li_rt_ast_int(0)
    li_rt_ast_space()
    li_rt_ast_int(0)
    li_rt_ast_space()
    if src_is_cr == 2:
      # dst is wb temp: __li_o_wb<crid>_<field>
      li_rt_mir_str("__li_o_wb")
      li_rt_ast_int(crid)
      li_rt_mir_str("_")
      li_rt_mir_esc(tsrc, fs, fe)
    else:
      li_rt_mir_str("__li_o_")
      li_rt_mir_esc(src, dst_s, dst_e)
      li_rt_mir_str("_")
      li_rt_mir_esc(tsrc, fs, fe)
    li_rt_ast_space()
    li_rt_ast_space()
    li_rt_ast_space()
    li_rt_ast_space()
    if src_is_cr == 1:
      li_rt_mir_str("__li_o___cr")
      li_rt_ast_int(crid)
    else:
      if src_is_cr == 3:
        # src is wb temp: __li_o_wb<crid>_<field>
        li_rt_mir_str("__li_o_wb")
        li_rt_ast_int(crid)
      else:
        if src_is_cr == 4:
          # Nested field-path source: __li_o_<fieldpath>_<field>
          li_rt_mir_str("__li_o_")
          li_rt_mir_fieldpath_out(crid)
        else:
          li_rt_mir_str("__li_o_")
          li_rt_mir_esc(src, src_s, src_e)
    li_rt_mir_str("_")
    li_rt_mir_esc(tsrc, fs, fe)
    li_rt_ast_space()
    li_rt_ast_space()
    li_rt_ast_int(0)
    li_rt_ast_space()
    li_rt_ast_int(0)
    li_rt_ast_space()
    li_rt_ast_int(0)
    li_rt_ast_space()
    li_rt_ast_int(1)
    li_rt_ast_space()
    li_rt_ast_space()
    li_rt_ast_int(0)
    li_rt_ast_space()
    li_rt_ast_int(0)
    li_rt_ast_space()
    li_rt_ast_int(0)
    li_rt_ast_space()
    li_rt_ast_int(0)
    li_rt_ast_space()
    li_rt_ast_int(0)
    li_rt_ast_space()
    li_rt_ast_int(0)
    li_rt_ast_space()
    li_rt_ast_int(0)
    li_rt_ast_space()
    li_rt_ast_int(0)
    li_rt_ast_space()
    li_rt_ast_int(0)
    li_rt_ast_space()
    li_rt_ast_int(0)
    li_rt_ast_space()
    li_rt_ast_int(0)
    li_rt_ast_space()
    li_rt_ast_int(0)
    li_rt_ast_nl()
    return 0
  # array field: element-wise INS 11 load into temp + INS 10/12 store
  var cop_a: int = 10
  if mir_obj_field_float(itmp, obj_ti, fidx) == 1:
    cop_a = 12
  var e: int = 0
  while e < fel:
    var t: int = tc[0]
    tc[0] = t + 1
    li_rt_mir_str("INS")
    li_rt_ast_space()
    li_rt_ast_int(11)
    li_rt_ast_space()
    li_rt_ast_int(e)
    li_rt_ast_space()
    li_rt_ast_int(0)
    li_rt_ast_space()
    if src_is_cr == 1:
      li_rt_mir_str("__li_o___cr")
      li_rt_ast_int(crid)
    else:
      if src_is_cr == 4:
        li_rt_mir_str("__li_o_")
        li_rt_mir_fieldpath_out(crid)
      else:
        li_rt_mir_str("__li_o_")
        li_rt_mir_esc(src, src_s, src_e)
    li_rt_mir_str("_")
    li_rt_mir_esc(tsrc, fs, fe)
    li_rt_ast_space()
    li_rt_ast_space()
    li_rt_ast_space()
    li_rt_mir_str("__t")
    li_rt_ast_int(t)
    li_rt_ast_space()
    li_rt_ast_space()
    li_rt_ast_space()
    li_rt_ast_int(0)
    li_rt_ast_space()
    li_rt_ast_int(0)
    li_rt_ast_space()
    li_rt_ast_int(0)
    li_rt_ast_space()
    li_rt_ast_int(1)
    li_rt_ast_space()
    li_rt_ast_space()
    li_rt_ast_int(0)
    li_rt_ast_space()
    li_rt_ast_int(1)
    li_rt_ast_space()
    li_rt_ast_int(0)
    li_rt_ast_space()
    li_rt_ast_int(0)
    li_rt_ast_space()
    li_rt_ast_int(0)
    li_rt_ast_space()
    li_rt_ast_int(0)
    li_rt_ast_space()
    li_rt_ast_int(0)
    li_rt_ast_space()
    li_rt_ast_int(0)
    li_rt_ast_space()
    li_rt_ast_int(0)
    li_rt_ast_space()
    li_rt_ast_int(0)
    li_rt_ast_space()
    li_rt_ast_int(0)
    li_rt_ast_space()
    li_rt_ast_int(0)
    li_rt_ast_nl()
    li_rt_mir_str("INS")
    li_rt_ast_space()
    li_rt_ast_int(cop_a)
    li_rt_ast_space()
    li_rt_ast_int(e)
    li_rt_ast_space()
    li_rt_ast_int(0)
    li_rt_ast_space()
    li_rt_mir_str("__li_o_")
    li_rt_mir_esc(src, dst_s, dst_e)
    li_rt_mir_str("_")
    li_rt_mir_esc(tsrc, fs, fe)
    li_rt_ast_space()
    li_rt_ast_space()
    li_rt_ast_space()
    li_rt_ast_space()
    li_rt_mir_str("__t")
    li_rt_ast_int(t)
    li_rt_ast_space()
    li_rt_ast_space()
    li_rt_ast_int(0)
    li_rt_ast_space()
    li_rt_ast_int(0)
    li_rt_ast_space()
    li_rt_ast_int(0)
    li_rt_ast_space()
    li_rt_ast_int(1)
    li_rt_ast_space()
    li_rt_ast_space()
    li_rt_ast_int(0)
    li_rt_ast_space()
    li_rt_ast_int(0)
    li_rt_ast_space()
    li_rt_ast_int(0)
    li_rt_ast_space()
    li_rt_ast_int(0)
    li_rt_ast_space()
    li_rt_ast_int(0)
    li_rt_ast_space()
    li_rt_ast_int(0)
    li_rt_ast_space()
    li_rt_ast_int(0)
    li_rt_ast_space()
    li_rt_ast_int(0)
    li_rt_ast_space()
    li_rt_ast_int(0)
    li_rt_ast_space()
    li_rt_ast_int(0)
    li_rt_ast_space()
    li_rt_ast_int(0)
    li_rt_ast_space()
    li_rt_ast_int(0)
    li_rt_ast_nl()
    e = e + 1
  return 0
# fixed-array element count of a field (0 = scalar)
def mir_obj_field_elems(itmp: var array[4096, int], type_idx: int, field_idx: int) -> int
  requires true
  ensures result >= 0
  decreases 0
=
  var fbase: int = li_rt_reg_get(lr_type_b() + type_idx * 6 + 3)
  var e: int = li_rt_reg_get(lr_felems_b() + (fbase + field_idx) + 0)
  return e

def mir_obj_find_field(src: var ptr, itmp: var array[4096, int], type_idx: int, fs: int, fe: int) -> int
  requires true
  ensures result >= -1
  decreases 0
=
  var nfld: int = mir_obj_field_count(itmp, type_idx)
  var fi: int = 0
  var fa: array[2, int]
  var lookup_hash: int = mir_name_hash(src, fs, fe)
  var lookup_len: int = fe - fs
  var fbase: int = li_rt_reg_get(lr_type_b() + type_idx * 6 + 3)
  while fi < nfld:
    if li_rt_reg_get(lr_fhash_b() + fbase + fi) == lookup_hash:
      mir_obj_field_name(itmp, type_idx, fi, fa)
      if fe - fs == fa[1] - fa[0]:
        return fi
    fi = fi + 1
  return -1

def mir_obj_var_count(itmp: var array[4096, int]) -> int
  requires true
  ensures result >= 0
  decreases 0
=
  var n: int = li_rt_reg_get(lr_n_var())
  return n

def mir_obj_reg_var(itmp: var array[4096, int], var_start: int, var_end: int, type_idx: int) -> int
  requires true
  ensures result == 0
  decreases 0
=
  var k: int = li_rt_reg_get(lr_n_var())
  if k >= lr_var_cap():
    mir_reg_fail()
    return 0
  # Objvar records live in their own derived region, separate from the field
  # floatness cells: the old layout had the field-float zone clobber the
  # floatness of the first two fields of the first registered type once 34+
  # object vars accumulated.
  mir_reg_set(lr_var_b() + k * 3 + 0, var_start)
  mir_reg_set(lr_var_b() + k * 3 + 1, var_end)
  mir_reg_set(lr_var_b() + k * 3 + 2, type_idx)
  mir_reg_set(lr_n_var(), k + 1)
  return 0

def mir_obj_find_var(src: var ptr, ts: var array[262144, int], te: var array[262144, int],
  itmp: var array[4096, int], name_start: int, name_end: int) -> int
  requires true
  ensures result >= -1
  decreases 0
=
  var nobjvar: int = li_rt_reg_get(lr_n_var())
  var k: int = 0
  var found: int = -1
  while k < nobjvar:
    # Last registration wins: a var name reused across procs with different
    # object types (e.g. `var out` in several lig procs) resolves to the most
    # recent declaration in source order, matching per-proc scoping.
    if mir_slice_eq(src, name_start, name_end, li_rt_reg_get(lr_var_b() + k * 3 + 0), li_rt_reg_get(lr_var_b() + k * 3 + 1)) == 1:
      found = li_rt_reg_get(lr_var_b() + k * 3 + 2)
    k = k + 1
  return found

def mir_obj_reg_field(itmp: var array[4096, int], src: var ptr, fs: int, fe: int, fflt: int, elems: int, tname_s: int, tname_e: int) -> int
  requires true
  ensures result == 0
  decreases 0
=
  var nf: int = li_rt_reg_get(lr_n_field())
  if nf >= lr_field_cap():
    mir_reg_fail()
    return 0
  mir_reg_set(lr_fname_b() + nf * 2 + 0, fs)
  mir_reg_set(lr_fname_b() + nf * 2 + 1, fe)
  mir_reg_set(lr_ffloat_b() + nf + 0, fflt)
  mir_reg_set(lr_felems_b() + nf + 0, elems)
  # Store the declared field-type identity by value (hash, length). The
  # original token spans are not reusable after an imported file is re-lexed.
  if tname_s >= 0 and tname_e > tname_s:
    mir_reg_set(lr_ftype_b() + nf * 2 + 0, mir_name_hash(src, tname_s, tname_e))
    mir_reg_set(lr_ftype_b() + nf * 2 + 1, tname_e - tname_s)
  else:
    mir_reg_set(lr_ftype_b() + nf * 2 + 0, 0)
    mir_reg_set(lr_ftype_b() + nf * 2 + 1, 0)
  mir_reg_set(lr_fhash_b() + nf, mir_name_hash(src, fs, fe))
  mir_reg_set(lr_n_field(), nf + 1)
  return 0

def mir_obj_field_obj_type(src: var ptr, ts: var array[262144, int], te: var array[262144, int], itmp: var array[4096, int], type_idx: int, field_idx: int) -> int
  requires true
  ensures result >= -1
  decreases 0
=
  var fbase: int = li_rt_reg_get(lr_type_b() + type_idx * 6 + 3)
  var h: int = li_rt_reg_get(lr_ftype_b() + (fbase + field_idx) * 2 + 0)
  var nlen: int = li_rt_reg_get(lr_ftype_b() + (fbase + field_idx) * 2 + 1)
  if h == 0 or nlen == 0:
    return -1
  # The declared type identity is stored by value during collection; no
  # caller token buffer or declaring-source span is needed for this lookup.
  var nobj_src: int = li_rt_reg_get(lr_n_type())
  var oi: int = 0
  while oi < nobj_src:
    if li_rt_reg_get(lr_thash_b() + oi) == h and li_rt_reg_get(lr_tlen_b() + oi) == nlen:
      return oi
    oi = oi + 1
  return -1

# Descend a (possibly nested) field chain from its root object var to the
# leaf object type, resolving each hop through the field's declared type
# identity (hash lookup, order-independent — unlike the callee param's type
# token, which only resolves if the declaring file has already been walked).
# chain_rec is the outermost kind-9 record; returns -1 when any hop is not an
# object field or a segment fails to resolve.
def mir_chain_leaf_type(darena: var array[65536, int], src: var ptr, ts: var array[262144, int], te: var array[262144, int], itmp: var array[4096, int], chain_rec: int) -> int
  requires true
  ensures result >= -1
  decreases 0
=
  # Collect segments outermost -> innermost, then the root var rec.
  var seg_s: array[8, int]
  var seg_e: array[8, int]
  var nseg: int = 0
  var cur: int = chain_rec
  while peek65536(darena, cur + 0) == 9:
    if nseg >= 8:
      return -1
    seg_s[nseg] = peek65536(darena, cur + 2)
    seg_e[nseg] = peek65536(darena, cur + 3)
    nseg = nseg + 1
    cur = peek65536(darena, cur + 1)
  if (peek65536(darena, cur + 0) != 3 and peek65536(darena, cur + 0) != 8) or nseg < 1:
    return -1
  # Root descriptor: kind 3 keeps the raw spans in rec+1/rec+2; kind 8 is a
  # lowered ident whose original token spans live in rec+2/rec+3.
  var root_s: int = peek65536(darena, cur + 1)
  var root_e: int = peek65536(darena, cur + 2)
  if peek65536(darena, cur + 0) == 8:
    root_s = peek65536(darena, cur + 2)
    root_e = peek65536(darena, cur + 3)
  var ti: int = mir_obj_find_var(src,  ts,  te,  itmp,  root_s,  root_e)
  if ti < 0:
    return -1
  var si: int = nseg - 1
  while si >= 0:
    var fi: int = mir_obj_find_field(src, itmp, ti, seg_s[si], seg_e[si])
    if fi < 0:
      return -1
    var nxt: int = mir_obj_field_obj_type(src, ts, te, itmp, ti, fi)
    if nxt < 0:
      return -1
    ti = nxt
    si = si - 1
  return ti

# Simpler sub-object check that doesn't require ts/te arrays.
# Returns the sub-object type index or -1 if the field is not an object.
def mir_field_is_subobj(itmp: var array[4096, int], type_idx: int, field_idx: int) -> int
  requires true
  ensures result >= -1
  decreases 0
=
  var fbase: int = li_rt_reg_get(lr_type_b() + type_idx * 6 + 3)
  var h: int = li_rt_reg_get(lr_ftype_b() + (fbase + field_idx) * 2 + 0)
  var nlen: int = li_rt_reg_get(lr_ftype_b() + (fbase + field_idx) * 2 + 1)
  if h == 0 or nlen == 0:
    return -1
  var nobj_src: int = li_rt_reg_get(lr_n_type())
  var oi: int = 0
  while oi < nobj_src:
    if li_rt_reg_get(lr_thash_b() + oi) == h and li_rt_reg_get(lr_tlen_b() + oi) == nlen:
      return oi
    oi = oi + 1
  return -1

# float-ness of a descriptor (mirrors is_float_expr on the AST)
def mir_desc_float(darena: var array[65536, int],  rec: int,  src: var ptr, ts: var array[262144, int],  te: var array[262144, int], ftok: var array[4096, int],  nft: var array[1, int], ftmp: var array[32768, int],  fatok: var array[512, int], nfa: var array[1, int], itmp: var array[4096, int]) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  var k: int = peek65536(darena, rec + 0)
  if k == 1:
    # kind 1 = float literal — always float
    return 1
  if k == 3:
    return mir_name_float(src,  ts,  te,  peek65536(darena, rec + 1),  peek65536(darena, rec + 2),  ftok,  nft)
  if k == 8:
    if peek65536(darena, rec + 1) == 1:
      if peek32768(ftmp, peek65536(darena, rec + 2)) > 0:
        return 1
      return 0
    return mir_name_float(src,  ts,  te,  peek65536(darena, rec + 2),  peek65536(darena, rec + 3),  ftok,  nft)
  if k == 7:
    var opk: int = peek65536(darena, rec + 1)
    if opk == 76:
      return 1
    if opk == 37 or opk == 38 or opk == 59 or opk == 60 or opk == 61 or opk == 63 or opk == 64 or opk == 65:
      if mir_desc_float(darena,  peek65536(darena, rec + 2),  src,  ts,  te,  ftok,  nft,  ftmp,  fatok,  nfa, itmp) == 1:
        return 1
      return mir_desc_float(darena,  peek65536(darena, rec + 3),  src,  ts,  te,  ftok,  nft,  ftmp,  fatok,  nfa, itmp)
    return 0
  if k == 11:
    return mir_desc_float(darena,  peek65536(darena, rec + 1),  src,  ts,  te,  ftok,  nft,  ftmp,  fatok,  nfa, itmp)
  if k == 9:
    # Object-field access: look up the field's float bit from the object
    # registry (same source the kind-12 resolved descriptor carries), so a
    # nested binop classifies `int_field * c + 1` as int before the field
    # is lowered. Unresolved/unknown fields default to int.
    var fb9d: int = peek65536(darena, rec + 1)
    if peek65536(darena, fb9d + 0) == 3:
      var ov9d: int = mir_obj_find_var(src,  ts,  te,  itmp,  peek65536(darena, fb9d + 1),  peek65536(darena, fb9d + 2))
      if ov9d >= 0:
        var fx9d: int = mir_obj_find_field(src, itmp, ov9d, peek65536(darena, rec + 2), peek65536(darena, rec + 3))
        if fx9d >= 0:
          return mir_obj_field_float(itmp, ov9d, fx9d)
    return 0
  if k == 12:
    # The field descriptor carries the registry's float bit in rec+3.
    return peek65536(darena, rec + 3)
  if k == 5:
    var base: int = peek65536(darena, rec + 1)
    if peek65536(darena, base + 0) == 3:
      if mir_name_farray(src, ts, te, peek65536(darena, base + 1), peek65536(darena, base + 2), fatok, nfa) == 1:
        return 1
      return mir_name_matrix_local(src, ts, te, peek65536(darena, base + 1), peek65536(darena, base + 2), fatok)
    if peek65536(darena, base + 0) == 5:
      var rowbase: int = peek65536(darena, base + 1)
      if peek65536(darena, rowbase + 0) == 3:
        return mir_name_matrix_local(src, ts, te, peek65536(darena, rowbase + 1), peek65536(darena, rowbase + 2), fatok)
    return 0
  return 0

# ---- emission helpers ----
# Name cells peek40(f, off..off+2): [v1, v2, code] (code 0 empty, 1 slice, 2 counter-name)
def mir_name_out(src: var ptr,  f: var array[44, int],  off: int) raises IO -> int
  requires true
  ensures result == 0
  decreases 0
=
  li_rt_ast_space()
  if peek40(f, off + 2) == 0:
    return 0
  if peek40(f, off + 2) == 1:
    li_rt_mir_esc(src,  peek40(f, off + 0),  peek40(f, off + 1))
    return 0
  if peek40(f, off + 2) == 3:
    li_rt_mir_literal(peek40(f, off + 0))
    return 0
  if peek40(f, off + 2) == 4:
    li_rt_mir_objname_out(peek40(f, off + 0))
    return 0
  li_rt_mir_label(peek40(f, off + 1),  peek40(f, off + 0))
  return 0

# INS field layout: 0..2 ident | 3..5 str_value | 6..8 callee | 9..11 lhs
# 12..14 rhs | 15..17 label | 18 bin_op | 19 retf | 20 reti64 | 21 idx_lit
# 22..24 index_ident | 25 use_li | 26 rhs_lit | 27 rhs_int | 28 rhs_str
# 29 lhs_lit | 30 lhs_int | 31 is_i64 | 32 arrf | 33 arrm | 34 brl | 35 brr
# 36 simd

def mir_fdef(f: var array[44, int]) -> int
  requires true
  ensures result == 0
  decreases 0
=
  var i: int = 0
  while i < 44:
    set40(f, i + 0,0)
    i = i + 1
  f[21] = 1
  f[26] = 1
  return 0

def mir_ins_line(src: var ptr,  f: var array[44, int],  op: int,  iv: int,  fid: int, lastop: var array[1, int]) raises IO -> int
  requires true
  ensures result == 0
  decreases 0
=
  li_rt_mir_str("INS")
  li_rt_ast_space()
  li_rt_ast_int(op)
  li_rt_ast_space()
  li_rt_ast_int(iv)
  li_rt_ast_space()
  if fid >= 0:
    li_rt_mir_f64_fmt(fid)
  else:
    li_rt_ast_int(0)
  mir_name_out(src,  f,  0)
  mir_name_out(src,  f,  3)
  mir_name_out(src,  f,  6)
  mir_name_out(src,  f,  9)
  mir_name_out(src,  f,  12)
  mir_name_out(src,  f,  15)
  li_rt_ast_space()
  li_rt_ast_int(f[18])
  li_rt_ast_space()
  li_rt_ast_int(f[19])
  li_rt_ast_space()
  li_rt_ast_int(f[20])
  li_rt_ast_space()
  li_rt_ast_int(f[21])
  mir_name_out(src,  f,  22)
  li_rt_ast_space()
  li_rt_ast_int(f[25])
  li_rt_ast_space()
  li_rt_ast_int(f[26])
  li_rt_ast_space()
  if f[37] != 0:
    li_rt_mir_int64_out(src,  f[37],  f[38],  f[41])
  else:
    li_rt_ast_int(f[27])
  li_rt_ast_space()
  li_rt_ast_int(f[28])
  li_rt_ast_space()
  li_rt_ast_int(f[29])
  li_rt_ast_space()
  if f[39] != 0:
    li_rt_mir_int64_out(src,  f[39],  f[40],  f[42])
  else:
    li_rt_ast_int(f[30])
  li_rt_ast_space()
  li_rt_ast_int(f[31])
  li_rt_ast_space()
  li_rt_ast_int(f[32])
  li_rt_ast_space()
  li_rt_ast_int(f[33])
  li_rt_ast_space()
  li_rt_ast_int(f[34])
  li_rt_ast_space()
  li_rt_ast_int(f[35])
  li_rt_ast_space()
  li_rt_ast_int(f[36])
  li_rt_ast_nl()
  lastop[0] = op
  return 0

def mir_binop_code(opk: int) -> int
  requires true
  ensures result >= 0
  decreases 0
=
  if opk == 59:
    return 0
  if opk == 60:
    return 1
  if opk == 61:
    return 2
  if opk == 63:
    return 3
  if opk == 65:
    return 4
  if opk == 64:
    return 5
  if opk == 62:
    return 6
  if opk == 76:
    return 7
  if opk == 66:
    return 8
  if opk == 67:
    return 9
  if opk == 68:
    return 10
  if opk == 69:
    return 11
  if opk == 70:
    return 12
  if opk == 71:
    return 13
  if opk == 37:
    return 14
  if opk == 38:
    return 15
  return 0

def mir_slice_is(src: var ptr,  s: int,  e: int,  s2: ptr) raises IO -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  var len: int = li_rt_str_len(s2)
  if e - s != len:
    return 0
  var j: int = 0
  while j < len:
    if li_rt_str_char_at(src,  s + j) != li_rt_str_char_at(s2,  j):
      return 0
    j = j + 1
  return 1

# Name-cell mode for a just-lowered value descriptor: mode 4 = registered
# objname (an object field path read), mode 2 = materialized temp label. This
# mirrors the mode mir_name_cells assigns for the same descriptors.
def mir_name_mode_lowered(darena: var array[65536, int], rec: int) -> int
  requires true
  ensures result == 2 or result == 4
  decreases 0
=
  if peek65536(darena, rec + 0) == 12:
    return 4
  return 2

# Argument record kind for a just-lowered name descriptor: an object field
# path (kind 12) passes as its flattened mangled slot name (kind 6), any other
# lowered form (temp / literal) keeps the temp-label form (kind 4).
def mir_arg_lowered_kind(darena: var array[65536, int], arec: int) -> int
  requires true
  ensures result == 4 or result == 6
  decreases 0
=
  if peek65536(darena, arec + 0) == 12:
    return 6
  return 4

def mir_arg_line(src: var ptr,  il: int,  iv: int,  ifl: int,  fid: int, id_s: int,  id_e: int,  id_c: int, is_s: int,  st_s: int,  st_e: int,  iai: int,  ivr: int) raises IO -> int
  requires true
  ensures result == 0
  decreases 0
=
  li_rt_mir_str("ARG")
  li_rt_ast_space()
  li_rt_ast_int(il)
  li_rt_ast_space()
  li_rt_ast_int(iv)
  li_rt_ast_space()
  li_rt_ast_int(ifl)
  li_rt_ast_space()
  if fid >= 0:
    li_rt_mir_f64_fmt(fid)
  else:
    li_rt_ast_int(0)
  li_rt_ast_space()
  if id_c == 0:
    li_rt_ast_space()
  else:
    if id_c == 1:
      li_rt_ast_text(src,  id_s,  id_e)
    else:
      li_rt_mir_label(0,  id_s)
    li_rt_ast_space()
  li_rt_ast_int(is_s)
  li_rt_ast_space()
  if is_s == 1:
    li_rt_mir_esc(src,  st_s,  st_e)
  li_rt_ast_space()
  li_rt_ast_int(iai)
  li_rt_ast_space()
  li_rt_ast_int(ivr)
  li_rt_ast_nl()
  return 0

# Recursive helper: emit ARG lines for every leaf field of a sub-object.
# parent_oi is the objname index for the parent compound name prefix.
def mir_arg_obj_line_r(src: var ptr, itmp: var array[4096, int], type_idx: int, parent_oi: int, iai: int, is_var: int) raises IO -> int
  requires true
  ensures result == 0
  decreases 0
=
  var nf_a: int = mir_obj_field_count(itmp, type_idx)
  var i_a: int = 0
  var fa_a: array[2, int]
  var tsrc_a: ptr = li_rt_type_src_get(type_idx)
  if tsrc_a == 0:
    tsrc_a = src
  while i_a < nf_a:
    mir_obj_field_name(itmp, type_idx, i_a, fa_a)
    var sub_a: int = mir_field_is_subobj(itmp, type_idx, i_a)
    if sub_a >= 0:
      var noi: int = li_rt_mir_objname_add_nested(parent_oi, tsrc_a, fa_a[0], fa_a[1])
      mir_arg_obj_line_r(src, itmp, sub_a, noi, iai, is_var)
    else:
      var noi2: int = li_rt_mir_objname_add_nested(parent_oi, tsrc_a, fa_a[0], fa_a[1])
      li_rt_mir_str("ARG")
      li_rt_ast_space()
      li_rt_ast_int(0)
      li_rt_ast_space()
      li_rt_ast_int(0)
      li_rt_ast_space()
      li_rt_ast_int(0)
      li_rt_ast_space()
      li_rt_ast_int(0)
      li_rt_ast_space()
      li_rt_mir_objname_out(noi2)
      li_rt_ast_space()
      li_rt_ast_int(0)
      li_rt_ast_space()
      li_rt_ast_space()
      li_rt_ast_int(iai)
      li_rt_ast_space()
      li_rt_ast_int(is_var)
      li_rt_ast_nl()
    i_a = i_a + 1
  return 0

def mir_arg_obj_line(src: var ptr, base_s: int, base_e: int, itmp: var array[4096, int], type_idx: int, field_idx: int, iai: int, is_var: int) raises IO -> int
  requires true
  ensures result == 0
  decreases 0
=
  var fa: array[2, int]
  mir_obj_field_name(itmp, type_idx, field_idx, fa)
  var sub_a2: int = mir_field_is_subobj(itmp, type_idx, field_idx)
  if sub_a2 >= 0:
    # Sub-object: emit flattened ARG lines for each leaf field
    var ao_tsrc2: ptr = li_rt_type_src_get(type_idx)
    if ao_tsrc2 == 0:
      ao_tsrc2 = src
    var base_oi: int = li_rt_mir_objname_reg_prefix(src, base_s, base_e, fa[0], fa[1], 0, 0, ao_tsrc2)
    mir_arg_obj_line_r(src, itmp, sub_a2, base_oi, iai, is_var)
    return 0
  li_rt_mir_str("ARG")
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_mir_str("__li_o_")
  li_rt_mir_esc(src, base_s, base_e)
  li_rt_mir_str("_")
  var ao_tsrc: ptr = li_rt_type_src_get(type_idx)
  if ao_tsrc == 0:
    ao_tsrc = src
  li_rt_mir_esc(ao_tsrc,  fa[0],  fa[1])
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_space()
  li_rt_ast_int(iai)
  li_rt_ast_space()
  li_rt_ast_int(is_var)
  li_rt_ast_nl()
  return 0

# ARG line for an argument that is an object field path already registered as
# a mangled objname (__li_o_<path>): C++ passes field-access arguments as the
# flattened slot name, not as a materialized temp.
def mir_arg_objname_line(src: var ptr, oi: int, iai: int, is_var: int) raises IO -> int
  requires true
  ensures result == 0
  decreases 0
=
  li_rt_mir_str("ARG")
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  if oi < 0:
    li_rt_ast_space()
  else:
    li_rt_mir_objname_out(oi)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_space()
  li_rt_ast_int(iai)
  li_rt_ast_space()
  li_rt_ast_int(is_var)
  li_rt_ast_nl()
  return 0

# ARG line for a method-call write-back slot: __li_o_wb<id>_<field>.
def mir_arg_wb_line(src: var ptr, itmp: var array[4096, int], type_idx: int, field_idx: int, wbid: int, iai: int, is_var: int) raises IO -> int
  requires true
  ensures result == 0
  decreases 0
=
  var fw: array[2, int]
  mir_obj_field_name(itmp, type_idx, field_idx, fw)
  var sub_wb: int = mir_field_is_subobj(itmp, type_idx, field_idx)
  if sub_wb >= 0:
    # Sub-object: emit flattened ARG lines using wb prefix
    var ao_tsrc3: ptr = li_rt_type_src_get(type_idx)
    if ao_tsrc3 == 0:
      ao_tsrc3 = src
    var wb_oi2: int = li_rt_mir_objname_reg_prefix(src, 0, 0, fw[0], fw[1], 3, wbid, ao_tsrc3)
    mir_arg_obj_line_r(src, itmp, sub_wb, wb_oi2, iai, is_var)
    return 0
  li_rt_mir_str("ARG")
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_mir_str("__li_o_wb")
  li_rt_ast_int(wbid)
  li_rt_mir_str("_")
  var wb_tsrc: ptr = li_rt_type_src_get(type_idx)
  if wb_tsrc == 0:
    wb_tsrc = src
  li_rt_mir_esc(wb_tsrc,  fw[0],  fw[1])
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_space()
  li_rt_ast_int(iai)
  li_rt_ast_space()
  li_rt_ast_int(is_var)
  li_rt_ast_nl()
  return 0

# ---- expression parse (descriptor build, no emission) ----
def mir_parse_postfix(darena: var array[65536, int],  dasp: var array[1, int], src: var ptr,  tk: var array[262144, int],  ts: var array[262144, int], te: var array[262144, int],  n: var array[1, int],  pi: var array[1, int], err: var array[1, int],  rec: int) -> int
  requires true
  ensures result >= -1
  decreases 0
=
  var loop: int = 1
  while loop == 1:
    if cur_kind(tk,  n,  pi,  err) == 51:
      pi[0] = pi[0] + 1
      var ix: int = mir_parse_expr(darena,  dasp,  src,  tk,  ts,  te,  n,  pi,  err, 0)
      if ix < 0:
        return -1
      expect_k(tk,  n,  pi,  err, 52)
      rec = d_alloc(darena,  dasp,  5,  rec,  ix,  0)
      continue
    if cur_kind(tk,  n,  pi,  err) == 72:
      # field access: x.field -> arena kind 9 (base, field_start, field_end)
      pi[0] = pi[0] + 1
      if cur_kind(tk,  n,  pi,  err) != 4:
        err[0] = 1
        return -1
      var fld_t: int = pi[0]
      pi[0] = pi[0] + 1
      # Method call: x.field(...) -> kind 13 (base, method_s, method_e,
      # argc, arglist). The kind-9 field access is replaced by a method call
      # descriptor so lowering can emit the var-object write-back dance.
      if cur_kind(tk,  n,  pi,  err) == 49:
        pi[0] = pi[0] + 1
        var ma: array[32, int]
        var mac: int = 0
        if cur_kind(tk,  n,  pi,  err) != 50:
          var md: int = 0
          while md == 0:
            var marg: int = mir_parse_expr(darena,  dasp,  src,  tk,  ts,  te,  n,  pi,  err, 0)
            if marg < 0:
              return -1
            if mac < 32:
              set32(ma, mac + 0, marg)
            mac = mac + 1
            if accept_k(tk,  n,  pi,  err, 55) == 1:
              md = 0
            else:
              md = 1
        expect_k(tk,  n,  pi,  err, 50)
        var mrec: int = d_alloc(darena,  dasp,  13,  rec,  peek_tk(ts, fld_t + 0),  peek_tk(te, fld_t + 0))
        set65536(darena, mrec + 4, mac)
        var mrt: int = dasp[0]
        var mri: int = 0
        while mri < mac:
          set65536(darena, mrt + mri, peek32(ma, mri + 0))
          mri = mri + 1
        dasp[0] = mrt + mac
        set65536(darena, mrec + 5, mrt)
        rec = mrec
        continue
      rec = d_alloc(darena,  dasp,  9,  rec, peek_tk(ts, fld_t + 0), peek_tk(te, fld_t + 0))
      continue
    loop = 0
  return rec

def mir_parse_primary(darena: var array[65536, int],  dasp: var array[1, int], src: var ptr,  tk: var array[262144, int],  ts: var array[262144, int], te: var array[262144, int],  n: var array[1, int],  pi: var array[1, int], err: var array[1, int]) raises IO -> int
  requires true
  ensures result >= -1
  decreases 0
=
  var k: int = cur_kind(tk,  n,  pi,  err)
  if k == 34:
    # await: transparent for the scalar slice (no await in the MIR corpus)
    pi[0] = pi[0] + 1
    return mir_parse_primary(darena,  dasp,  src,  tk,  ts,  te,  n,  pi,  err)
  if k == 8:
    var t0: int = pi[0]
    pi[0] = pi[0] + 1
    var rec0: int = d_alloc(darena,  dasp,  2,  peek_tk(ts, t0 + 0) + 1,  peek_tk(te, t0 + 0) - 1,  0)
    return mir_parse_postfix(darena,  dasp,  src,  tk,  ts,  te,  n,  pi,  err,  rec0)
  if k == 5:
    var t1: int = pi[0]
    pi[0] = pi[0] + 1
    var rec1: int = d_alloc(darena,  dasp,  0,  li_rt_mir_int(src,  peek_tk(ts, t1 + 0),  peek_tk(te, t1 + 0)), peek_tk(ts, t1 + 0),  peek_tk(te, t1 + 0))
    return mir_parse_postfix(darena,  dasp,  src,  tk,  ts,  te,  n,  pi,  err,  rec1)
  if k == 6:
    var t2: int = pi[0]
    pi[0] = pi[0] + 1
    var rec2: int = d_alloc(darena,  dasp,  1,  li_rt_mir_f64(src,  peek_tk(ts, t2 + 0),  peek_tk(te, t2 + 0)), peek_tk(ts, t2 + 0),  peek_tk(te, t2 + 0))
    return mir_parse_postfix(darena,  dasp,  src,  tk,  ts,  te,  n,  pi,  err,  rec2)
  if k == 7:
    # Binary literal `0b10110100`: value is the base-2 interpretation of the
    # bits (span covers the full literal incl. the `0b` prefix, like C++).
    # Descriptor kind 0 (int literal) so mir_return/mir_lower_expr treat it
    # as a literal const, not a temp name. The span cells are 0 so the
    # StoreInt path prints the computed value (mir_ins_line f[27]) instead of
    # re-deriving it from the source span as decimal (which would mis-read
    # the bits, e.g. 0b10110100 -> 10110100); the return path prints rec+1
    # directly either way.
    var t3: int = pi[0]
    pi[0] = pi[0] + 1
    var bv: int = 0
    var bp: int = peek_tk(ts, t3 + 0) + 2
    var be: int = peek_tk(te, t3 + 0)
    while bp < be:
      bv = bv * 2 + (li_rt_str_char_at(src, bp) - 48)
      bp = bp + 1
    var rec3: int = d_alloc(darena,  dasp,  0,  bv,  0,  0)
    return mir_parse_postfix(darena,  dasp,  src,  tk,  ts,  te,  n,  pi,  err,  rec3)
  if k == 4 or k == 46 or k == 35 or k == 36:
    var t4: int = pi[0]
    pi[0] = pi[0] + 1
    if accept_k(tk,  n,  pi,  err, 49) == 1:
      var aroots: array[32, int]
      var argc: int = 0
      if cur_kind(tk,  n,  pi,  err) != 50:
        var done: int = 0
        # Multi-line call arguments: skip continued-line layout tokens like
        # parse_primary (newlines + indents inside the parens).
        skip_arg_layout(tk, n, pi, err)
        while done == 0:
          skip_arg_layout(tk, n, pi, err)
          var a: int = mir_parse_expr(darena,  dasp,  src,  tk,  ts,  te,  n,  pi,  err, 0)
          if a < 0:
            return -1
          if argc < 32:
            set32(aroots, argc + 0,a)
          argc = argc + 1
          if accept_k(tk,  n,  pi,  err, 55) == 1:
            done = 0
          else:
            done = 1
        skip_arg_layout(tk, n, pi, err)
      expect_k(tk,  n,  pi,  err, 50)
      var crec: int = d_alloc(darena,  dasp,  4,  peek_tk(ts, t4 + 0),  peek_tk(te, t4 + 0),  0)
      set65536(darena, crec + 4,argc)
      var rt: int = dasp[0]
      var ri: int = 0
      while ri < argc:
        set65536(darena, rt + ri,peek32(aroots, ri + 0))
        ri = ri + 1
      dasp[0] = rt + argc
      set65536(darena, crec + 5,rt)
      return mir_parse_postfix(darena,  dasp,  src,  tk,  ts,  te,  n,  pi,  err,  crec)
    var rec4: int = d_alloc(darena,  dasp,  3,  peek_tk(ts, t4 + 0),  peek_tk(te, t4 + 0),  0)
    return mir_parse_postfix(darena,  dasp,  src,  tk,  ts,  te,  n,  pi,  err,  rec4)
  if accept_k(tk,  n,  pi,  err, 49) == 1:
    var e: int = mir_parse_expr(darena,  dasp,  src,  tk,  ts,  te,  n,  pi,  err, 0)
    if e < 0:
      return -1
    expect_k(tk,  n,  pi,  err, 50)
    return mir_parse_postfix(darena,  dasp,  src,  tk,  ts,  te,  n,  pi,  err,  e)
  err[0] = 1
  return -1

def mir_parse_expr(darena: var array[65536, int],  dasp: var array[1, int], src: var ptr,  tk: var array[262144, int],  ts: var array[262144, int], te: var array[262144, int],  n: var array[1, int],  pi: var array[1, int], err: var array[1, int],  min_prec: int) -> int
  requires true
  ensures result >= -1
  decreases 0
=
  var k: int = cur_kind(tk,  n,  pi,  err)
  var left: int = -1
  if k == 39:
    pi[0] = pi[0] + 1
    var op: int = mir_parse_expr(darena,  dasp,  src,  tk,  ts,  te,  n,  pi,  err, 100)
    if op < 0:
      return -1
    left = d_alloc(darena,  dasp,  6,  op,  0,  0)
  else:
    if k == 60:
      pi[0] = pi[0] + 1
      left = mir_parse_primary(darena,  dasp,  src,  tk,  ts,  te,  n,  pi,  err)
      if left >= 0:
        if peek65536(darena, left + 0) == 0:
          # Fold `-N` into the int literal (0 - N avoids the compiler's
          # unary-minus-on-call gap; the value is what matters here).
          # rec+4 marks the literal as negated so span-printing (which reads
          # the source slice, e.g. `5`) can emit the minus sign.
          set65536(darena, left + 1,0 - peek65536(darena, left + 1))
          set65536(darena, left + 4,1)
        else:
          if peek65536(darena, left + 0) == 1:
            set65536(darena, left + 1,li_rt_mir_f64_neg(peek65536(darena, left + 1)))
          else:
            # `-x` on a general expression: keep a unary-minus descriptor
            # (kind 11), lowered later to `0 - x` / `0.0 - x` like the C++.
            left = d_alloc(darena,  dasp,  11,  left,  0,  0)
    else:
      left = mir_parse_primary(darena,  dasp,  src,  tk,  ts,  te,  n,  pi,  err)
  if left < 0:
    return -1
  while 1 == 1:
    var p: int = prec_of(cur_kind(tk,  n,  pi,  err))
    if p < 0:
      break
    if p < min_prec:
      break
    var opk: int = cur_kind(tk,  n,  pi,  err)
    pi[0] = pi[0] + 1
    var right: int = mir_parse_expr(darena,  dasp,  src,  tk,  ts,  te,  n,  pi,  err, p + 1)
    if right < 0:
      return -1
    left = d_alloc(darena,  dasp,  7,  opk,  left,  right)
  return left

# ---- lowering helpers ----
def mir_proc_find(src: var ptr,  ts: var array[262144, int],  te: var array[262144, int], s: int,  e: int,  ptok: var array[128, int],  pn: var array[1, int]) -> int
  requires true
  ensures result >= -1
  decreases 0
=
  # First pass: pname registry lookup (works for cross-file procs)
  # Do pname FIRST so imported procs resolve correctly even when
  # stale ptok values from the import walk cause false token matches.
  var _pn_limit: int = li_rt_pn_get()
  var k: int = 0
  while k < _pn_limit:
    if li_rt_mir_pname_eq(k, src, s, e) == 1:
      return k
    k = k + 1
  # Second pass: token-based lookup (works for same-file procs)
  k = 0
  while k < _pn_limit:
    if mir_slice_eq(src,  s,  e,  peek_tk(ts, li_rt_preg_get(0, k) + 0),  peek_tk(te, li_rt_preg_get(0, k) + 0)) == 1:
      return k
    k = k + 1
  return -1

# Find the proc whose name is the mangled method callee `Type_method`
# (type-name span ty_s..ty_e, method-name span ms..me). Returns the pid or -1.
def mir_method_pid(src: var ptr,  ts: var array[262144, int],  te: var array[262144, int], ty_s: int,  ty_e: int,  ms: int,  me: int,  ptok: var array[128, int],  pn: var array[1, int]) -> int
  requires true
  ensures result >= -1
  decreases 0
=
  var tlen: int = ty_e - ty_s
  var mlen: int = me - ms
  var _pn_limit2: int = li_rt_pn_get()
  var k: int = 0
  while k < _pn_limit2:
    var ns: int = peek_tk(ts, li_rt_preg_get(0, k) + 0)
    var ne: int = peek_tk(te, li_rt_preg_get(0, k) + 0)
    if ne - ns == tlen + 1 + mlen:
      if mir_slice_eq(src,  ns,  ns + tlen,  ty_s,  ty_e) == 1:
        if li_rt_str_char_at(src,  ns + tlen) == 95:
          if mir_slice_eq(src,  ns + tlen + 1,  ne,  ms,  me) == 1:
            return k
    k = k + 1
  return -1

# Is the first param of proc pid a `var Object` (write-back receiver)?
def mir_method_first_var(src: var ptr,  ts: var array[262144, int],  te: var array[262144, int], pid: int,  pp0: var array[128, int],  pvar: var array[512, int]) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  if pid < 0:
    return 0
  var fi: int = li_rt_preg_get(2, pid)
  var pv: int = li_rt_preg_get(10, fi)
  # Type 6 (var object): pv = 1000 + type_tok*2 + var_bit
  if pv >= 1000:
    if (pv - 1000) % 2 == 1:
      return 1
  # Type 5 (var scalar/ptr): pv = ti[1] = 1 for var, 0 for non-var
  if pv == 1:
    return 1
  return 0

# Overwrite descriptor rec in place with a name record (kind 8).
def mir_mk_name(darena: var array[65536, int],  rec: int,  is_tmp: int,  v1: int,  v2: int) -> int
  requires true
  ensures result == 0
  decreases 0
=
  set65536(darena, rec + 0,8)
  set65536(darena, rec + 1,is_tmp)
  set65536(darena, rec + 2,v1)
  set65536(darena, rec + 3,v2)
  return 0

# Lower one descriptor to a name (kind 8 in place), emitting INS/ARG lines.
def mir_lower_expr(darena: var array[65536, int],  dasp: var array[1, int],  rec: int, src: var ptr,  tk: var array[262144, int],  ts: var array[262144, int], te: var array[262144, int],  n: var array[1, int],  pi: var array[1, int], err: var array[1, int],  tc: var array[1, int],  lastop: var array[1, int], ftok: var array[4096, int],  nft: var array[1, int], ftmp: var array[32768, int],  itok: var array[4096, int],  nit: var array[1, int], itmp: var array[4096, int],  fatok: var array[512, int],  nfa: var array[1, int], matok: var array[512, int],  nmat: var array[1, int], ptok: var array[128, int],  pex: var array[128, int], pp0: var array[128, int],  ppn: var array[128, int], pret: var array[128, int],  pn: var array[1, int], ptok2: var array[512, int],  pty: var array[512, int], pelems: var array[512, int],  pef: var array[512, int], pei: var array[512, int],  pvar: var array[512, int]) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  var f: array[44, int]
  mir_fdef(f)
  var k: int = peek65536(darena, rec + 0)
  if k == 0:
    var c0: int = tc[0]
    tc[0] = c0 + 1
    f[0] = c0
    f[2] = 2
    f[26] = 1
    f[27] = peek65536(darena, rec + 1)
    f[37] = peek65536(darena, rec + 2)
    f[38] = peek65536(darena, rec + 3)
    f[41] = peek65536(darena, rec + 4)
    mir_ins_line(src,  f,  26,  0,  -1,  lastop)
    mir_mk_name(darena,  rec,  1,  c0,  0)
    return 0
  if k == 1:
    var c1: int = tc[0]
    tc[0] = c1 + 1
    f[0] = c1
    f[2] = 2
    f[26] = 1
    mir_ins_line(src,  f,  28,  0,  peek65536(darena, rec + 1),  lastop)
    set32768(ftmp, c1 + 0,1)
    mir_mk_name(darena,  rec,  1,  c1,  0)
    return 0
  if k == 2:
    var c2: int = tc[0]
    tc[0] = c2 + 1
    f[0] = c2
    f[2] = 2
    f[3] = peek65536(darena, rec + 1)
    f[4] = peek65536(darena, rec + 2)
    f[5] = 1
    f[28] = 1
    mir_ins_line(src,  f,  27,  0,  -1,  lastop)
    mir_reg_flag(c2)
    mir_mk_name(darena,  rec,  1,  c2,  0)
    return 0
  if k == 3:
    mir_mk_name(darena,  rec,  0,  peek65536(darena, rec + 1),  peek65536(darena, rec + 2))
    return 0
  if k == 10:
    var c10: int = tc[0]
    tc[0] = c10 + 1
    mir_mk_name(darena,  rec,  1,  c10,  0)
    return 0
  if k == 6:
    var c6: int = tc[0]
    tc[0] = c6 + 1
    mir_mk_name(darena,  rec,  1,  c6,  0)
    return 0
  if k == 11:
    # `-x` lowers to `0 - x` (int, literal lhs) / `0.0 - x` (float, zero temp)
    # exactly like the C++ lower_expr_to UnaryMinus case.
    var c11: int = tc[0]
    tc[0] = c11 + 1
    var f11: array[44, int]
    mir_fdef(f11)
    f11[0] = c11
    f11[2] = 2
    f11[18] = 1
    var opnd11: int = peek65536(darena, rec + 1)
    if mir_desc_float(darena,  opnd11,  src,  ts,  te,  ftok,  nft,  ftmp,  fatok,  nfa, itmp) == 1:
      var z11: int = tc[0]
      tc[0] = z11 + 1
      var fz: array[44, int]
      mir_fdef(fz)
      fz[0] = z11
      fz[2] = 2
      fz[26] = 1
      mir_ins_line(src,  fz,  28,  0,  li_rt_mir_f64_of_int(0),  lastop)
      set32768(ftmp, z11 + 0,1)
      f11[9] = z11
      f11[11] = 2
      if mir_lower_expr(darena,  dasp,  opnd11,  src,  tk,  ts,  te,  n,  pi,  err,  tc,  lastop, ftok,  nft,  ftmp,  itok,  nit,  itmp,  fatok,  nfa, matok,  nmat, ptok,  pex,  pp0,  ppn,  pret,  pn,  ptok2,  pty,  pelems,  pef, pei,  pvar) == 1:
        return 1
      mir_name_cells(darena,  opnd11,  f11,  12)
      f11[26] = 0
      mir_ins_line(src,  f11,  31,  0,  -1,  lastop)
      set32768(ftmp, c11 + 0,1)
      mir_mk_name(darena,  rec,  1, c11,  0)
    else:
      f11[29] = 1
      f11[30] = 0
      if mir_lower_expr(darena,  dasp,  opnd11,  src,  tk,  ts,  te,  n,  pi,  err,  tc,  lastop, ftok,  nft,  ftmp,  itok,  nit,  itmp,  fatok,  nfa, matok,  nmat, ptok,  pex,  pp0,  ppn,  pret,  pn,  ptok2,  pty,  pelems,  pef, pei,  pvar) == 1:
        return 1
      mir_name_cells(darena,  opnd11,  f11,  12)
      f11[26] = 0
      mir_ins_line(src,  f11,  30,  0,  -1,  lastop)    mir_mk_name(darena,  rec,  1, c11,  0)
    return 0
  if k == 12:
    # Already-resolved object-field name descriptor; emission is handled by
    # mir_name_cells and must not be treated as an unsupported expression.
    return 0
  if k == 9:
    # field access: base.field -> name cell referencing __li_o_<base>_<field>
    var fbase: int = peek65536(darena, rec + 1)
    var fld_s: int = peek65536(darena, rec + 2)
    var fld_e: int = peek65536(darena, rec + 3)
    if peek65536(darena, fbase + 0) == 3:
      var base_s: int = peek65536(darena, fbase + 1)
      var base_e: int = peek65536(darena, fbase + 2)
      var obj_type: int = mir_obj_find_var(src, ts, te, itmp, base_s, base_e)
      if obj_type >= 0:
        var nidx: int = li_rt_mir_objname_add(src, base_s, base_e, fld_s, fld_e)
        var fidx_obj: int = mir_obj_find_field(src, itmp, obj_type, fld_s, fld_e)
        var ffloat_obj: int = 0
        if fidx_obj >= 0:
          ffloat_obj = mir_obj_field_float(itmp, obj_type, fidx_obj)
        # rewrite rec to object-field name: kind 12, idx in rec+2, and
        # retain field float-ness for later BinOp classification.
        set65536(darena, rec + 0,12)
        set65536(darena, rec + 3,ffloat_obj)
        set65536(darena, rec + 1,0)
        set65536(darena, rec + 2,nidx)
        set65536(darena, rec + 3,ffloat_obj)
        return 0
    # Nested field access: the base is (or lowers to) an object-field
    # descriptor (kind 12). Resolve the base first when it is still a raw
    # field access, so a multi-hop chain accumulates its whole path in the
    # objname registry (__li_o_o_mid_inner_x) instead of leaving this record
    # as a raw field access whose name cells print only the leaf span.
    var fbase_k: int = peek65536(darena, fbase + 0)
    if fbase_k == 12 or fbase_k == 9:
      if fbase_k == 9:
        if mir_lower_expr(darena,  dasp,  fbase,  src,  tk,  ts,  te,  n,  pi,  err,  tc,  lastop, ftok,  nft,  ftmp,  itok,  nit,  itmp,  fatok,  nfa, matok,  nmat, ptok,  pex,  pp0,  ppn,  pret,  pn,  ptok2,  pty,  pelems,  pef, pei,  pvar) == 1:
          return 1
      if peek65536(darena, fbase + 0) == 12:
        # (draw.tier).fps_target -> __li_o_draw_tier_fps_target
        var pnidx: int = peek65536(darena, fbase + 2)
        var nidx2: int = li_rt_mir_objname_add_nested(pnidx, src, fld_s, fld_e)
        var ffloat_obj2: int = peek65536(darena, fbase + 3)
        set65536(darena, rec + 0, 12)
        set65536(darena, rec + 1, 0)
        set65536(darena, rec + 2, nidx2)
        set65536(darena, rec + 3, ffloat_obj2)
      return 0
    # Computed base (call result/temp, literal, or any non-ident flattening):
    # the C++ host does NOT recurse here — obj_field_slot_chain roots at
    # object vars only, and the legacy single-level fallback keeps the base
    # EMPTY for every non-Ident base, so the slot prints as __li_o__<field>
    # (zero-width base span) and the base itself emits no INs.
    if fbase_k != 3:
      var nz8: int = li_rt_mir_objname_add(src, 0, 0, fld_s, fld_e)
      set65536(darena, rec + 0, 12)
      set65536(darena, rec + 1, 0)
      set65536(darena, rec + 2, nz8)
      set65536(darena, rec + 3, 0)
      return 0
    # fallback: treat as LoadIntToIdent from the base expression
    if mir_lower_expr(darena,  dasp,  fbase,  src,  tk,  ts,  te,  n,  pi,  err,  tc,  lastop, ftok,  nft,  ftmp,  itok,  nit,  itmp,  fatok,  nfa, matok,  nmat, ptok,  pex,  pp0,  ppn,  pret,  pn,  ptok2,  pty,  pelems,  pef, pei,  pvar) == 1:
      return 1
    return 0
  if k == 5:
    var base: int = peek65536(darena, rec + 1)
    var idx: int = peek65536(darena, rec + 2)
    if peek65536(darena, base + 0) == 9:
      # Object array-field load: b.xs[i] -> INS 11 (int) / INS 13 (float) into temp
      var fb9e: int = peek65536(darena, base + 1)
      var fs9e: int = peek65536(darena, base + 2)
      var fe9e: int = peek65536(darena, base + 3)
      if peek65536(darena, fb9e + 0) == 3:
        var ov9e: int = mir_obj_find_var(src,  ts,  te,  itmp,  peek65536(darena, fb9e + 1),  peek65536(darena, fb9e + 2))
        if ov9e >= 0:
          var fidx9e: int = mir_obj_find_field(src, itmp, ov9e, fs9e, fe9e)
          var fel9e: int = 0
          if fidx9e >= 0:
            fel9e = mir_obj_field_elems(itmp, ov9e, fidx9e)
          if fel9e > 0:
            if peek65536(darena, idx + 0) == 0:
              # C++ typecheck rejects a literal index outside 0..size-1 for the
              # object field's fixed array (typecheck.cpp Index on IntLit).
              var iv9e: int = peek65536(darena, idx + 1)
              if iv9e < 0:
                return 1
              if iv9e >= fel9e:
                return 1
              var c9e: int = tc[0]
              tc[0] = c9e + 1
              li_rt_mir_str("INS")
              li_rt_ast_space()
              li_rt_ast_int(11)
              li_rt_ast_space()
              li_rt_ast_int(iv9e)
              li_rt_ast_space()
              li_rt_ast_int(0)
              li_rt_ast_space()
              li_rt_mir_str("__li_o_")
              li_rt_mir_esc(src, peek65536(darena, fb9e + 1), peek65536(darena, fb9e + 2))
              li_rt_mir_str("_")
              li_rt_mir_esc(src, fs9e, fe9e)
              li_rt_ast_space()
              li_rt_ast_space()
              li_rt_ast_space()
              li_rt_mir_str("__t")
              li_rt_ast_int(c9e)
              li_rt_ast_space()
              li_rt_ast_space()
              li_rt_ast_space()
              li_rt_ast_int(0)
              li_rt_ast_space()
              li_rt_ast_int(0)
              li_rt_ast_space()
              li_rt_ast_int(0)
              li_rt_ast_space()
              li_rt_ast_int(1)
              li_rt_ast_space()
              li_rt_ast_space()
              li_rt_ast_int(0)
              li_rt_ast_space()
              li_rt_ast_int(1)
              li_rt_ast_space()
              li_rt_ast_int(0)
              li_rt_ast_space()
              li_rt_ast_int(0)
              li_rt_ast_space()
              li_rt_ast_int(0)
              li_rt_ast_space()
              li_rt_ast_int(0)
              li_rt_ast_space()
              li_rt_ast_int(0)
              li_rt_ast_space()
              li_rt_ast_int(0)
              li_rt_ast_space()
              li_rt_ast_int(0)
              li_rt_ast_space()
              li_rt_ast_int(0)
              li_rt_ast_space()
              li_rt_ast_int(0)
              li_rt_ast_space()
              li_rt_ast_int(0)
              li_rt_ast_nl()
              mir_mk_name(darena,  rec,  1,  c9e,  0)
              return 0
      if peek65536(darena, fb9e + 0) == 9:
        # Nested object array-field load: d.tier.vals[i] in an expression.
        # Same descriptor-chain walk as the store side; the generic
        # fallthrough below reads descriptor cells as a source span and would
        # print a corrupted ident (and C++ previously emitted no load at all).
        var csp: array[16, int]
        var cidx: int = 0
        var cur: int = fb9e
        while peek65536(darena, cur + 0) == 9 and cidx < 6:
          csp[cidx * 2 + 2] = peek65536(darena, cur + 2)
          csp[cidx * 2 + 3] = peek65536(darena, cur + 3)
          cidx = cidx + 1
          cur = peek65536(darena, cur + 1)
        if peek65536(darena, cur + 0) == 3:
          csp[0] = peek65536(darena, cur + 1)
          csp[1] = peek65536(darena, cur + 2)
          var cn: int = cidx + 2
          csp[(cn - 1) * 2] = fs9e
          csp[(cn - 1) * 2 + 1] = fe9e
          var rovt: int = mir_obj_find_var(src,  ts,  te,  itmp,  csp[0],  csp[1])
          if rovt >= 0:
            var ok_c: int = 1
            var ci: int = 1
            while ci < cn - 1 and ok_c == 1:
              var ff_c: int = mir_obj_find_field(src, itmp, rovt, csp[ci * 2], csp[ci * 2 + 1])
              if ff_c < 0:
                ok_c = 0
              else:
                rovt = mir_obj_field_obj_type(src, ts, te, itmp, rovt, ff_c)
                if rovt < 0:
                  ok_c = 0
              ci = ci + 1
            if ok_c == 1:
              var fl_c: int = mir_obj_find_field(src, itmp, rovt, csp[(cn - 1) * 2], csp[(cn - 1) * 2 + 1])
              var fel_c: int = 0
              if fl_c >= 0:
                fel_c = mir_obj_field_elems(itmp, rovt, fl_c)
              if fel_c > 0:
                if peek65536(darena, idx + 0) == 0:
                  # Same literal bound check as the single-level object field.
                  var ivc: int = peek65536(darena, idx + 1)
                  if ivc < 0:
                    return 1
                  if ivc >= fel_c:
                    return 1
                  var c9c: int = tc[0]
                  tc[0] = c9c + 1
                  li_rt_mir_str("INS")
                  li_rt_ast_space()
                  li_rt_ast_int(11)
                  li_rt_ast_space()
                  li_rt_ast_int(ivc)
                  li_rt_ast_space()
                  li_rt_ast_int(0)
                  li_rt_ast_space()
                  li_rt_mir_str("__li_o_")
