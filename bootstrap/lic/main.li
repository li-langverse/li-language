    return parse_postfix(src, tk, ts, te, n, pi, err, d)
  if k == 6:
    var t2: int = pi[0]
    pi[0] = pi[0] + 1
    if d == 1:
      a_line_text(d, src, 61, peek_tk(ts, t2 + 0), peek_tk(te, t2 + 0))
    return parse_postfix(src, tk, ts, te, n, pi, err, d)
  if k == 7:
    var t3: int = pi[0]
    pi[0] = pi[0] + 1
    if d == 1:
      a_line_text(d, src, 62, peek_tk(ts, t3 + 0), peek_tk(te, t3 + 0))
    return parse_postfix(src, tk, ts, te, n, pi, err, d)
  if k == 4 or k == 46 or k == 35 or k == 36:
    var t4: int = pi[0]
    pi[0] = pi[0] + 1
    if accept_k(tk, n, pi, err, 49) == 1:
      if d == 1:
        a_line_text(d, src, 66, peek_tk(ts, t4 + 0), peek_tk(te, t4 + 0))
      if cur_kind(tk, n, pi, err) != 50:
        var done: int = 0
        while done == 0:
          if parse_expr(src, tk, ts, te, n, pi, err, 0, d) == 0:
            return 0
          if accept_k(tk, n, pi, err, 55) == 1:
            done = 0
          else:
            done = 1
      if expect_k(tk, n, pi, err, 50) == 0:
        return 0
    else:
      if d == 1:
        a_line_text(d, src, 64, peek_tk(ts, t4 + 0), peek_tk(te, t4 + 0))
    return parse_postfix(src, tk, ts, te, n, pi, err, d)
  if accept_k(tk, n, pi, err, 49) == 1:
    if parse_expr(src, tk, ts, te, n, pi, err, 0, d) == 0:
      return 0
    if expect_k(tk, n, pi, err, 50) == 0:
      return 0
    return parse_postfix(src, tk, ts, te, n, pi, err, d)
  err[0] = 1
  return 0

def parse_expr(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], min_prec: int, d: int) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  var left_ok: int = 0
  var k: int = cur_kind(tk, n, pi, err)
  if k == 39:
    pi[0] = pi[0] + 1
    if d == 1:
      a_line(d, 67)
    left_ok = parse_expr(src, tk, ts, te, n, pi, err, 100, d)
  if k == 60:
    pi[0] = pi[0] + 1
    var nk60: int = cur_kind(tk, n, pi, err)
    if nk60 == 5 or nk60 == 6:
      # `-1` / `-1.5` fold into the literal (span excludes the minus), so the
      # dump shows the bare literal — matching the C++ parser's fold.
      left_ok = parse_primary(src, tk, ts, te, n, pi, err, d)
    else:
      # `-x` on a general expression: emit the unary-minus node (code 72)
      # before the operand subtree, like `not` (code 67).
      if d == 1:
        a_line(d, 72)
      left_ok = parse_primary(src, tk, ts, te, n, pi, err, d)
  if k != 39:
    if k != 60:
      left_ok = parse_primary(src, tk, ts, te, n, pi, err, d)
  if left_ok == 0:
    return 0
  while 1 == 1:
    var p: int = prec_of(cur_kind(tk, n, pi, err))
    if p < 0:
      break
    if p < min_prec:
      break
    var opk: int = cur_kind(tk, n, pi, err)
    pi[0] = pi[0] + 1
    if d == 1:
      a_line_i(d, 65, opk)
    if parse_expr(src, tk, ts, te, n, pi, err, p + 1, d) == 0:
      return 0
  return 1

def parse_contract_expr(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], d: int) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  skip_newlines(tk, n, pi, err)
  return parse_expr(src, tk, ts, te, n, pi, err, 0, d)

