          if mir_lower_expr(darena,  dasp,  rrec,  src,  tk,  ts,  te,  n,  pi,  err,  tc,  lastop, ftok,  nft,  ftmp,  itok,  nit,  itmp,  fatok,  nfa, matok,  nmat, ptok,  pex,  pp0,  ppn,  pret,  pn,  ptok2,  pty,  pelems,  pef, pei,  pvar) == 1:
            return 1
          f2[26] = 0
          f2[12] = peek65536(darena, rrec + 2)
          f2[14] = 2
    else:
      if peek65536(darena, rrec + 0) == 0:
        f2[26] = 1
        f2[27] = peek65536(darena, rrec + 1)
      else:
        if peek65536(darena, rrec + 0) == 3:
          f2[26] = 0
          f2[12] = peek65536(darena, rrec + 1)
          f2[13] = peek65536(darena, rrec + 2)
          f2[14] = 1
        else:
          if mir_lower_expr(darena,  dasp,  rrec,  src,  tk,  ts,  te,  n,  pi,  err,  tc,  lastop, ftok,  nft,  ftmp,  itok,  nit,  itmp,  fatok,  nfa, matok,  nmat, ptok,  pex,  pp0,  ppn,  pret,  pn,  ptok2,  pty,  pelems,  pef, pei,  pvar) == 1:
            return 1
          f2[26] = 0
          f2[12] = peek65536(darena, rrec + 2)
          f2[14] = 2
    mir_ins_line(src,  f2,  op2,  0,  fid2,  lastop)
    return 0
  err[0] = 1
  return 1

def mir_fn_line(src: var ptr,  ts: var array[262144, int],  te: var array[262144, int], name_tok: int,  retf: int,  reti64: int,  retvoid: int,  retobj: int,  is_extern: int,  no_vec: int,  is_async_fn: int) raises IO -> int
  requires true
  ensures result == 0
  decreases 0
=
  li_rt_mir_str("FN")
  li_rt_ast_space()
  li_rt_ast_text(src,  peek_tk(ts, name_tok + 0),  peek_tk(te, name_tok + 0))
  li_rt_ast_space()
  li_rt_ast_int(retf)
  li_rt_ast_space()
  li_rt_ast_int(reti64)
  li_rt_ast_space()
  li_rt_ast_int(retvoid)
  li_rt_ast_space()
  li_rt_ast_int(retobj)
  li_rt_ast_space()
  li_rt_ast_int(is_extern)
  li_rt_ast_space()
  li_rt_ast_int(is_async_fn)
  li_rt_ast_space()
  li_rt_ast_int(no_vec)
  li_rt_ast_nl()
  return 0

def mir_retparam_line(src: var ptr,  ts: var array[262144, int],  te: var array[262144, int], itmp: var array[4096, int],  type_idx: int,  field_idx: int) raises IO -> int
  requires true
  ensures result == 0
  decreases 0
=
  var fa: array[2, int]
  mir_obj_field_name(itmp, type_idx, field_idx, fa)
  var fflt: int = mir_obj_field_float(itmp, type_idx, field_idx)
  var felems_r: int = mir_obj_field_elems(itmp, type_idx, field_idx)
  var tsrc: ptr = li_rt_type_src_get(type_idx)
  if tsrc == 0:
    tsrc = src
  li_rt_mir_str("RETPARAM")
  li_rt_ast_space()
  li_rt_ast_text(tsrc,  fa[0],  fa[1])
  li_rt_ast_space()
  li_rt_ast_int(fflt)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(felems_r)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_nl()
  return 0

def mir_retparam_line_nested(src: var ptr,  ts: var array[262144, int],  te: var array[262144, int], itmp: var array[4096, int],  type_idx: int,  field_idx: int,  p_s: int,  p_e: int) raises IO -> int
  requires true
  ensures result == 0
  decreases 0
=
  var fa2: array[2, int]
  mir_obj_field_name(itmp, type_idx, field_idx, fa2)
  var fflt2: int = mir_obj_field_float(itmp, type_idx, field_idx)
  var felems_r2: int = mir_obj_field_elems(itmp, type_idx, field_idx)
  var tsrc2: ptr = li_rt_type_src_get(type_idx)
  if tsrc2 == 0:
    tsrc2 = src
  li_rt_mir_str("RETPARAM")
  li_rt_ast_space()
  li_rt_ast_text(tsrc2,  p_s,  p_e)
  li_rt_mir_str("_")
  li_rt_ast_text(tsrc2,  fa2[0],  fa2[1])
  li_rt_ast_space()
  li_rt_ast_int(fflt2)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(felems_r2)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_nl()
  return 0

# Recursively emit RETPARAM lines for a return object, flattening nested
# object fields into compound names (swapchain_viewport_w etc.).
def mir_obj_retparams(src: var ptr,  ts: var array[262144, int],  te: var array[262144, int], itmp: var array[4096, int],  type_idx: int,  p_s: int,  p_e: int) raises IO -> int
  requires true
  ensures result == 0
  decreases 0
=
  var nf_r: int = mir_obj_field_count(itmp, type_idx)
  var i_r: int = 0
  var fa_r: array[2, int]
  while i_r < nf_r:
    mir_obj_field_name(itmp, type_idx, i_r, fa_r)
    var sub_r: int = mir_obj_field_obj_type(src, ts, te, itmp, type_idx, i_r)
    if sub_r >= 0:
      mir_obj_retparams(src,  ts,  te,  itmp,  sub_r,  fa_r[0],  fa_r[1])
    else:
      if p_s >= 0:
        mir_retparam_line_nested(src,  ts,  te,  itmp,  type_idx,  i_r,  p_s,  p_e)
      else:
        mir_retparam_line(src,  ts,  te,  itmp,  type_idx,  i_r)
    i_r = i_r + 1
  return 0

def mir_obj_line_r(src: var ptr,  ts: var array[262144, int],  te: var array[262144, int], itmp: var array[4096, int],  type_idx: int,  field_idx: int,  parent_path: int) raises IO -> int
  requires true
  ensures result == 0
  decreases 0
=
  var fa: array[2, int]
  mir_obj_field_name(itmp, type_idx, field_idx, fa)
  var obj_tsrc: ptr = li_rt_type_src_get(type_idx)
  if obj_tsrc == 0:
    obj_tsrc = src
  var sub: int = mir_obj_field_obj_type(src, ts, te, itmp, type_idx, field_idx)
  var path: int = li_rt_mir_fieldpath_add(parent_path, obj_tsrc, fa[0], fa[1])
  if sub >= 0:
    var sn: int = mir_obj_field_count(itmp, sub)
    var si: int = 0
    while si < sn:
      mir_obj_line_r(src, ts, te, itmp, sub, si, path)
      si = si + 1
  else:
    var fflt: int = mir_obj_field_float(itmp, type_idx, field_idx)
    var felems_o: int = mir_obj_field_elems(itmp, type_idx, field_idx)
    li_rt_mir_str("OBJ")
    li_rt_ast_space()
    if parent_path == 0:
      li_rt_ast_text(obj_tsrc, fa[0], fa[1])
    else:
      li_rt_mir_fieldpath_out(path)
    li_rt_ast_space()
    li_rt_ast_int(fflt)
    li_rt_ast_space()
    li_rt_ast_int(0)
    li_rt_ast_space()
    li_rt_ast_int(0)
    li_rt_ast_space()
    li_rt_ast_int(0)
    li_rt_ast_space()
    li_rt_ast_int(0)
    li_rt_ast_space()
    li_rt_ast_int(felems_o)
    li_rt_ast_space()
    li_rt_ast_int(0)
    li_rt_ast_space()
    li_rt_ast_int(0)
    li_rt_ast_space()
    li_rt_ast_int(0)
    li_rt_ast_nl()
  return 0

def mir_obj_line(src: var ptr,  ts: var array[262144, int],  te: var array[262144, int], itmp: var array[4096, int],  type_idx: int,  field_idx: int) raises IO -> int
  requires true
  ensures result == 0
  decreases 0
=
  mir_obj_line_r(src, ts, te, itmp, type_idx, field_idx, 0)
  return 0

def mir_dec_line(src: var ptr,  ts: var array[262144, int],  te: var array[262144, int], name_tok: int,  lanes: int,  vectorized: int,  parallel: int,  disjoint: int) raises IO -> int
  requires true
  ensures result == 0
  decreases 0
=
  li_rt_mir_str("DEC")
  li_rt_ast_space()
  li_rt_ast_text(src,  peek_tk(ts, name_tok + 0),  peek_tk(te, name_tok + 0))
  li_rt_ast_space()
  li_rt_ast_int(lanes)
  li_rt_ast_space()
  li_rt_ast_int(vectorized)
  li_rt_ast_space()
  li_rt_ast_int(parallel)
  li_rt_ast_space()
  li_rt_ast_int(disjoint)
  li_rt_ast_nl()
  return 0

def mir_param_line(src: var ptr,  ts: var array[262144, int],  te: var array[262144, int], name_tok: int,  ty: int,  elems: int,  ef: int,  ei: int,  is_var: int,  mx: int,  mc: int) raises IO -> int
  requires true
  ensures result == 0
  decreases 0
=
  li_rt_mir_str("PARAM")
  li_rt_ast_space()
  li_rt_ast_text(src,  peek_tk(ts, name_tok + 0),  peek_tk(te, name_tok + 0))
  var pf: int = 0
  if ty == 1:
    pf = 1
  if ty == 5:
    if ef == 1:
      pf = 1
    if mx == 1:
      pf = 1
  var ps: int = 0
  if ty == 2 or ty == 3:
    ps = 1
  var pi2: int = 0
  if ty == 4 or ty == 2:
    pi2 = 1
  if ty == 5:
    if ei == 1:
      pi2 = 1
  var fe: int = 0
  if ty == 5:
    fe = elems
  li_rt_ast_space()
  li_rt_ast_int(pf)
  li_rt_ast_space()
  li_rt_ast_int(ps)
  li_rt_ast_space()
  li_rt_ast_int(pi2)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(fe)
  li_rt_ast_space()
  li_rt_ast_int(mx)
  li_rt_ast_space()
  li_rt_ast_int(mc)
  li_rt_ast_space()
  if mx == 1:
    # C++ lower_to_mir only sets is_var for plain fixed-size arrays; 2D
    # matrix params keep is_var false (default MirParam).
    li_rt_ast_int(0)
  else:
    li_rt_ast_int(is_var)
  li_rt_ast_nl()
  return 0

# Emit one flattened object parameter, e.g. Vec3 a -> __li_o_a_x.
def mir_obj_param_line_r(src: var ptr, ts: var array[262144, int], te: var array[262144, int], itmp: var array[4096, int], type_idx: int, base_s: int, base_e: int, field_idx: int, is_var: int, parent_path: int) raises IO -> int
  requires true
  ensures result == 0
  decreases 0
=
  var fa: array[2, int]
  mir_obj_field_name(itmp, type_idx, field_idx, fa)
  var op_tsrc: ptr = li_rt_type_src_get(type_idx)
  if op_tsrc == 0:
    op_tsrc = src
  var sub: int = mir_obj_field_obj_type(src, ts, te, itmp, type_idx, field_idx)
  var path: int = li_rt_mir_fieldpath_add(parent_path, op_tsrc, fa[0], fa[1])
  if sub >= 0:
    var sn: int = mir_obj_field_count(itmp, sub)
    var si: int = 0
    while si < sn:
      mir_obj_param_line_r(src, ts, te, itmp, sub, base_s, base_e, si, is_var, path)
      si = si + 1
  else:
    var ffloat: int = mir_obj_field_float(itmp, type_idx, field_idx)
    var felems: int = mir_obj_field_elems(itmp, type_idx, field_idx)
    li_rt_mir_str("PARAM")
    li_rt_ast_space()
    li_rt_mir_str("__li_o_")
    li_rt_mir_esc(src, base_s, base_e)
    li_rt_mir_str("_")
    if parent_path == 0:
      li_rt_mir_esc(op_tsrc, fa[0], fa[1])
    else:
      li_rt_mir_fieldpath_out(path)
    li_rt_ast_space()
    li_rt_ast_int(ffloat)
    li_rt_ast_space()
    li_rt_ast_int(0)
    li_rt_ast_space()
    li_rt_ast_int(0)
    li_rt_ast_space()
    li_rt_ast_int(0)
    li_rt_ast_space()
    li_rt_ast_int(0)
    li_rt_ast_space()
    li_rt_ast_int(felems)
    li_rt_ast_space()
    li_rt_ast_int(0)
    li_rt_ast_space()
    li_rt_ast_int(0)
    li_rt_ast_space()
    li_rt_ast_int(is_var)
    li_rt_ast_nl()
  return 0

def mir_obj_param_line(src: var ptr, ts: var array[262144, int], te: var array[262144, int], itmp: var array[4096, int], type_idx: int, base_s: int, base_e: int, field_idx: int, is_var: int) raises IO -> int
  requires true
  ensures result == 0
  decreases 0
=
  mir_obj_param_line_r(src, ts, te, itmp, type_idx, base_s, base_e, field_idx, is_var, 0)
  return 0

def mir_emit_object_params(src: var ptr, ts: var array[262144, int], te: var array[262144, int], itmp: var array[4096, int], type_idx: int, base_s: int, base_e: int, is_var: int) raises IO -> int
  requires true
  ensures result == 0
  decreases 0
=
  var nf: int = mir_obj_field_count(itmp, type_idx)
  var j: int = 0
  while j < nf:
    mir_obj_param_line(src, ts, te, itmp, type_idx, base_s, base_e, j, is_var)
    j = j + 1
  return 0

def mir_skip_raises(tk: var array[262144, int],  n: var array[1, int],  pi: var array[1, int],  err: var array[1, int]) -> int

  requires true
  ensures result == 0
  decreases 0
=
  if cur_kind(tk,  n,  pi,  err) == 31:
    pi[0] = pi[0] + 1
    if cur_kind(tk,  n,  pi,  err) == 4:
      var done: int = 0
      while done == 0:
        pi[0] = pi[0] + 1
        if accept_k(tk,  n,  pi,  err, 55) == 1:
          done = 0
        else:
          done = 1
  return 0

def mir_skip_contracts(src: var ptr,  tk: var array[262144, int],  ts: var array[262144, int], te: var array[262144, int],  n: var array[1, int],  pi: var array[1, int], err: var array[1, int]) -> int
  requires true
  ensures result == 0
  decreases 0
=
  while 1 == 1:
    var ck: int = cur_kind(tk,  n,  pi,  err)
    if ck == 41 or ck == 42 or ck == 43 or ck == 44 or ck == 45:
      parse_contract(src,  tk,  ts,  te,  n,  pi,  err, 0)
      continue
    break
  return 0

def mir_collect_proc(src: var ptr,  tk: var array[262144, int],  ts: var array[262144, int], te: var array[262144, int],  n: var array[1, int],  pi: var array[1, int], err: var array[1, int],  is_extern: int,  pid: int, ptok: var array[128, int],  pex: var array[128, int], pp0: var array[128, int],  ppn: var array[128, int], pret: var array[128, int],  ptok2: var array[512, int], pty: var array[512, int],  pelems: var array[512, int],  pef: var array[512, int],  pei: var array[512, int], pvar: var array[512, int],  pmx: var array[512, int],  pmc: var array[512, int],  itmp: var array[4096, int],  pcount: var array[1, int]) raises IO -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  if is_extern == 0:
    if cur_kind(tk,  n,  pi,  err) == 16:
      pi[0] = pi[0] + 1
    else:
      if cur_kind(tk,  n,  pi,  err) == 17:
        pi[0] = pi[0] + 1
    if cur_kind(tk,  n,  pi,  err) == 10:
      pi[0] = pi[0] + 1
    else:
      err[0] = 1
      return 1
  var pname: int = pi[0]
  pi[0] = pi[0] + 1
  li_rt_preg_set(0, pid, pname)
  li_rt_preg_set(1, pid, is_extern)
  parse_type_params(src,  tk,  ts,  te,  n,  pi,  err, 0, 1)
  expect_k(tk,  n,  pi,  err, 49)
  skip_param_layout(tk,  n,  pi,  err)
  var _pc: int = li_rt_pidx_get()
  li_rt_preg_set(2, pid, _pc)
  if cur_kind(tk,  n,  pi,  err) != 50:
    var done: int = 0
    while done == 0:
      skip_param_layout(tk,  n,  pi,  err)
      var pn2: int = pi[0]
      pi[0] = pi[0] + 1
      expect_k(tk,  n,  pi,  err, 56)
      var type_tok: int = pi[0]
      if peek_tk(tk, type_tok + 0) == 20:
        type_tok = type_tok + 1
      var ti: array[6, int]
      if mir_type_info(src,  tk,  ts,  te,  n,  pi,  err,  ti) == 1:
        return 1
      li_rt_preg_set(5, _pc, pn2)
      li_rt_preg_set(6, _pc, ti[0])
      li_rt_preg_set(7, _pc, ti[2])
      if ti[3] == 1:
        li_rt_preg_set(8, _pc, 1)
      else:
        li_rt_preg_set(8, _pc, 0)
      if ti[3] == 2 or ti[3] == 4:
        li_rt_preg_set(9, _pc, 1)
      else:
        li_rt_preg_set(9, _pc, 0)
      if ti[3] == 5:
        if ti[5] == 1:
          li_rt_preg_set(11, _pc, 1)
          li_rt_preg_set(12, _pc, ti[4])
        else:
          li_rt_preg_set(11, _pc, 0)
          li_rt_preg_set(12, _pc, 0)
      else:
        li_rt_preg_set(11, _pc, 0)
        li_rt_preg_set(12, _pc, 0)
      if ti[0] == 5:
        li_rt_preg_set(10, _pc, ti[1])
        li_rt_preg_set(13, _pc, -1)
      else:
        if ti[0] == 6:
          li_rt_preg_set(10, _pc, 1000 + type_tok * 2 + ti[1])
          # Preserve the resolved object index for cross-file emit. The type
          # token itself belongs to this source file and cannot be reused
          # against the caller's token buffer.
          li_rt_preg_set(13, _pc, mir_obj_find_type(src, ts, te, itmp, peek_tk(ts, type_tok + 0), peek_tk(te, type_tok + 0)))
        else:
          li_rt_preg_set(10, _pc, 0)
          li_rt_preg_set(13, _pc, -1)
      if ti[0] == 6:
        li_rt_preg_set(12, _pc, type_tok)
      _pc = _pc + 1
      skip_param_layout(tk,  n,  pi,  err)
      if accept_k(tk,  n,  pi,  err, 55) == 1:
        done = 0
      else:
        done = 1
  li_rt_pidx_set(_pc)
  li_rt_preg_set(3, pid, _pc - li_rt_preg_get(2, pid))
  skip_param_layout(tk,  n,  pi,  err)
  expect_k(tk,  n,  pi,  err, 50)
  skip_newlines(tk,  n,  pi,  err)
  mir_skip_raises(tk,  n,  pi,  err)
  skip_newlines(tk,  n,  pi,  err)
  var ret: int = 8
  if accept_k(tk,  n,  pi,  err, 57) == 1:
    var rt_tok2: int = -1
    var rk3: int = cur_kind(tk,  n,  pi,  err)
    if rk3 == 4 or rk3 == 47 or rk3 == 48:
      rt_tok2 = pi[0]
    var ti2: array[6, int]
    if mir_type_info(src,  tk,  ts,  te,  n,  pi,  err,  ti2) == 1:
      return 1
    if ti2[0] == 7:
      ret = 0
    else:
      if ti2[0] == 0:
        ret = 1
      else:
        if ti2[0] == 1:
          ret = 2
        else:
          if ti2[0] == 2:
            ret = 3
          else:
            if ti2[0] == 3:
              ret = 3
            else:
              if ti2[0] == 4:
                ret = 4
              else:
                if ti2[0] == 5:
                  ret = 5
                else:
                  ret = 6
                  # Store the return type name so the call-site lowering can
                  # resolve this callee's object layout (C++ callee_ret_obj).
                  if rt_tok2 >= 0:
                    li_rt_mir_retname_store(pid, src, peek_tk(ts, rt_tok2 + 0), peek_tk(te, rt_tok2 + 0))
  li_rt_preg_set(4, pid, ret)
  skip_newlines(tk,  n,  pi,  err)
  mir_skip_raises(tk,  n,  pi,  err)
  skip_newlines(tk,  n,  pi,  err)
  mir_skip_contracts(src,  tk,  ts,  te,  n,  pi,  err)
  if is_extern == 1:
    skip_newlines(tk,  n,  pi,  err)
    return 0
  expect_k(tk,  n,  pi,  err, 58)
  skip_newlines(tk,  n,  pi,  err)
  parse_block(src,  tk,  ts,  te,  n,  pi,  err, 0)
  return 0

def mir_proc(src: var ptr,  tk: var array[262144, int],  ts: var array[262144, int], te: var array[262144, int],  n: var array[1, int],  pi: var array[1, int], err: var array[1, int],  is_extern: int,  pid: int, tc: var array[1, int],  lastop: var array[1, int], ftok: var array[4096, int],  nft: var array[1, int], ftmp: var array[32768, int],  itok: var array[4096, int],  nit: var array[1, int], itmp: var array[4096, int],  fatok: var array[512, int],  nfa: var array[1, int], matok: var array[512, int],  nmat: var array[1, int], ptok: var array[128, int],  pex: var array[128, int], pp0: var array[128, int],  ppn: var array[128, int], pret: var array[128, int],  pn: var array[1, int], ptok2: var array[512, int],  pty: var array[512, int], pelems: var array[512, int],  pef: var array[512, int], pei: var array[512, int],  pvar: var array[512, int], pmx: var array[512, int],  pmc: var array[512, int]) raises IO -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  # Float/i64/float-array name tables are per-proc (the C++ lowering uses a
  # fresh float_names / i64_locals / float_array_names set per proc). Temp
  # flag tables (ftmp/itmp) stay global because temp counters are global.
  nft[0] = 0
  nit[0] = 0
  nfa[0] = 0
  nmat[0] = 0
  set512(fatok, 62, 0)
  set512(fatok, 63, 0)
  if is_extern == 0:
    if cur_kind(tk,  n,  pi,  err) == 16:
      pi[0] = pi[0] + 1
    else:
      if cur_kind(tk,  n,  pi,  err) == 17:
        pi[0] = pi[0] + 1
    if cur_kind(tk,  n,  pi,  err) == 10:
      pi[0] = pi[0] + 1
    else:
      err[0] = 1
      return 1
  var pname: int = pi[0]
  pi[0] = pi[0] + 1
  parse_type_params(src,  tk,  ts,  te,  n,  pi,  err, 0, 1)
  expect_k(tk,  n,  pi,  err, 49)
  skip_param_layout(tk,  n,  pi,  err)
  if cur_kind(tk,  n,  pi,  err) != 50:
    var done: int = 0
    while done == 0:
      skip_param_layout(tk,  n,  pi,  err)
      pi[0] = pi[0] + 1
      expect_k(tk,  n,  pi,  err, 56)
      var ti: array[6, int]
      if mir_type_info(src,  tk,  ts,  te,  n,  pi,  err,  ti) == 1:
        return 1
      skip_param_layout(tk,  n,  pi,  err)
      if accept_k(tk,  n,  pi,  err, 55) == 1:
        done = 0
      else:
        done = 1
  skip_param_layout(tk,  n,  pi,  err)
  expect_k(tk,  n,  pi,  err, 50)
  skip_newlines(tk,  n,  pi,  err)
  mir_skip_raises(tk,  n,  pi,  err)
  skip_newlines(tk,  n,  pi,  err)
  var rt_tok2: int = -1
  if accept_k(tk,  n,  pi,  err, 57) == 1:
    var rk3: int = cur_kind(tk,  n,  pi,  err)
    if rk3 == 4 or rk3 == 47 or rk3 == 48:
      rt_tok2 = pi[0]
    var ti2: array[6, int]
    if mir_type_info(src,  tk,  ts,  te,  n,  pi,  err,  ti2) == 1:
      return 1
  skip_newlines(tk,  n,  pi,  err)
  mir_skip_raises(tk,  n,  pi,  err)
  skip_newlines(tk,  n,  pi,  err)
  mir_skip_contracts(src,  tk,  ts,  te,  n,  pi,  err)
  var ret: int = li_rt_preg_get(4, pid)
  var retf: int = 0
  var reti64: int = 0
  var retvoid: int = 0
  var retobj: int = 0
  var ret_obj_ti: int = -1
  if ret == 2:
    retf = 1
  if ret == 3 or ret == 4:
    reti64 = 1
  if ret == 0:
    retvoid = 1
  if ret == 8:
    # No `-> type` clause. C++ sets returns_void=false for non-extern procs
    # with no return type; extern procs without a return type are void.
    if is_extern == 1:
      retvoid = 1
  if ret == 6:
    if rt_tok2 >= 0:
      ret_obj_ti = mir_obj_find_type(src, ts, te, itmp, peek_tk(ts, rt_tok2 + 0), peek_tk(te, rt_tok2 + 0))
      if ret_obj_ti >= 0:
        retobj = 1
  set32768(ftmp, 4090, pid)
  # Hold-buffer this proc's output: if the body contains `parallel for`, its
  # synthesized __li_par_* function text must replay BEFORE this FN header
  # (C++ push-order parity). Passthrough otherwise.
  li_rt_mir_hold_open()
  mir_fn_line(src,  ts,  te,  li_rt_preg_get(0, pid),  retf,  reti64,  retvoid,  retobj,  is_extern,  peek32768(ftmp, 4092),  peek32768(ftmp, 4091))
  if peek32768(ftmp, 4093) >= 0:
    if peek32768(ftmp, 4088) == 1:
      if peek32768(ftmp, 4086) >= 0:
        mir_dec_line(src, ts, te, peek32768(ftmp, 4086), 0, 0, 0, 0)
      mir_dec_line(src, ts, te, peek32768(ftmp, 4093), 0, 0, 1, peek32768(ftmp, 4087))
    else:
      mir_dec_line(src,  ts,  te,  peek32768(ftmp, 4093),  peek32768(ftmp, 4094),  peek32768(ftmp, 4095),  0,  0)
  var j: int = 0
  while j < li_rt_preg_get(3, pid):
    var pi2: int = li_rt_preg_get(2, pid) + j
    var ptype2: int = li_rt_preg_get(6, pi2)
    var pobj2: int = -1
    if ptype2 == 6:
      pobj2 = li_rt_preg_get(13, pi2)
      if pobj2 < 0:
        var ptype_tok2: int = li_rt_preg_get(12, pi2)
        pobj2 = mir_obj_find_type(src, ts, te, itmp, peek_tk(ts, ptype_tok2 + 0), peek_tk(te, ptype_tok2 + 0))
    if pobj2 >= 0:
      mir_obj_reg_var(itmp, peek_tk(ts, li_rt_preg_get(5, pi2) + 0), peek_tk(te, li_rt_preg_get(5, pi2) + 0), pobj2)
      var obj_is_var2: int = 0
      var obj_code2: int = li_rt_preg_get(10, pi2)
      if obj_code2 >= 1000:
        obj_is_var2 = (obj_code2 - 1000) % 2
      mir_emit_object_params(src, ts, te, itmp, pobj2, peek_tk(ts, li_rt_preg_get(5, pi2) + 0), peek_tk(te, li_rt_preg_get(5, pi2) + 0), obj_is_var2)
    else:
      if ptype2 == 6:
        # Unknown named types (generic/protocol parameters) are not object
        # layouts; do not leak the encoded type-token through PARAM fields.
        mir_param_line(src, ts, te, li_rt_preg_get(5, pi2), ptype2, 0, 0, 0, 0, 0, 0)
      else:
        mir_param_line(src, ts, te, li_rt_preg_get(5, pi2), ptype2, li_rt_preg_get(7, pi2), li_rt_preg_get(8, pi2), li_rt_preg_get(9, pi2), li_rt_preg_get(10, pi2), li_rt_preg_get(11, pi2), li_rt_preg_get(12, pi2))
    if ptype2 == 1:
      set4096(ftok, nft[0],li_rt_preg_get(5, pi2))
      nft[0] = nft[0] + 1
    else:
      if li_rt_preg_get(6, pi2) == 2 or li_rt_preg_get(6, pi2) == 3 or li_rt_preg_get(6, pi2) == 4:
        set4096(itok, nit[0],li_rt_preg_get(5, pi2))
        nit[0] = nit[0] + 1
      else:
        if li_rt_preg_get(6, pi2) == 5:
          if li_rt_preg_get(8, pi2) == 1:
            set512(fatok, 2 * nfa[0],li_rt_preg_get(5, pi2))
            set512(fatok, 2 * nfa[0] + 1,li_rt_preg_get(7, pi2))
            nfa[0] = nfa[0] + 1
          if li_rt_preg_get(8, pi2) == 0:
            var pnia: int = peek512(fatok, 63)
            set512(fatok, 2 * nfa[0] + 2 * pnia, li_rt_preg_get(5, pi2))
            set512(fatok, 2 * nfa[0] + 2 * pnia + 1, li_rt_preg_get(7, pi2))
            set512(fatok, 63, pnia + 1)
    j = j + 1
  if ret_obj_ti >= 0:
    mir_obj_retparams(src,  ts,  te,  itmp,  ret_obj_ti,  -1,  -1)
  lastop[0] = -1
  if is_extern == 1:
    skip_newlines(tk,  n,  pi,  err)
    li_rt_mir_hold_flush_close()
    return 0
  expect_k(tk,  n,  pi,  err, 58)
  var is_async_proc: int = peek32768(ftmp, 4091)
  if is_async_proc == 1:
    var fae: array[44, int]
    mir_fdef(fae)
    mir_ins_line(src,  fae,  47,  0,  -1,  lastop)
    var fal: array[44, int]
    mir_fdef(fal)
    mir_ins_line(src,  fal,  48,  0,  -1,  lastop)
  var lhead: array[32, int]
  var lexit: array[32, int]
  var nlp: array[1, int]
  nlp[0] = 0
  var darena: array[65536, int]
  var dasp: array[1, int]
  dasp[0] = 0
  if mir_stmts(darena,  dasp,  src,  tk,  ts,  te,  n,  pi,  err,  tc,  lastop, ftok,  nft,  ftmp,  itok,  nit,  itmp,  fatok,  nfa, matok,  nmat, ptok,  pex,  pp0,  ppn,  pret,  pn,  ptok2,  pty,  pelems,  pef,  pei,  pvar,  retf,  reti64,  lhead,  lexit,  nlp) == 1:
    li_rt_mir_hold_flush_close()
    return 1
  if lastop[0] < 0:
    var f0: array[44, int]
    mir_fdef(f0)
    mir_ins_line(src,  f0,  0,  0,  -1,  lastop)
  else:
    if lastop[0] > 4:
      var f0b: array[44, int]
      mir_fdef(f0b)
      mir_ins_line(src,  f0b,  0,  0,  -1,  lastop)
  li_rt_mir_hold_flush_close()
  return 0

def mir_walk(src: var ptr,  tk: var array[262144, int],  ts: var array[262144, int], te: var array[262144, int],  n: var array[1, int],  pi: var array[1, int], err: var array[1, int],  mode: int, tc: var array[1, int],  lastop: var array[1, int], ftok: var array[4096, int],  nft: var array[1, int], ftmp: var array[32768, int],  itok: var array[4096, int],  nit: var array[1, int], itmp: var array[4096, int],  fatok: var array[512, int],  nfa: var array[1, int], matok: var array[512, int],  nmat: var array[1, int], ptok: var array[128, int],  pex: var array[128, int], pp0: var array[128, int],  ppn: var array[128, int], pret: var array[128, int],  pn: var array[1, int], ptok2: var array[512, int],  pty: var array[512, int], pelems: var array[512, int],  pef: var array[512, int], pei: var array[512, int],  pvar: var array[512, int], pmx: var array[512, int],  pmc: var array[512, int], pcount: var array[1, int]) raises IO -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=

  # Sync proc count from C global (workaround var-array pass-by-value bug)
  var _pn: int = 0
  if mode == 0:
    _pn = li_rt_pn_get()
  skip_newlines(tk,  n,  pi,  err)
  set32768(ftmp, 4092, 0)
  set32768(ftmp, 4093, -1)
  set32768(ftmp, 4094, 0)
  set32768(ftmp, 4095, 0)
  set32768(ftmp, 4088, 0)
  set32768(ftmp, 4087, 0)
  set32768(ftmp, 4086, -1)
  while 1 == 1:
    set32768(ftmp, 4092, 0)
    set32768(ftmp, 4093, -1)
    set32768(ftmp, 4094, 0)
    set32768(ftmp, 4095, 0)
    set32768(ftmp, 4088, 0)
    set32768(ftmp, 4087, 0)
    set32768(ftmp, 4086, -1)
    var k: int = cur_kind(tk,  n,  pi,  err)
    if k == 0:
      break
    if k == 3:
      break
    if k == 18:
      parse_import(src,  tk,  ts,  te,  n,  pi,  err, 0)
      skip_newlines(tk,  n,  pi,  err)
      continue
    if k == 32:
      pi[0] = pi[0] + 1
      if cur_kind(tk,  n,  pi,  err) == 10:
        pi[0] = pi[0] + 1
      if mode == 0:
        if mir_collect_proc(src,  tk,  ts,  te,  n,  pi,  err,  1,  _pn, ptok,  pex,  pp0,  ppn,  pret,  ptok2,  pty,  pelems,  pef,  pei,  pvar,  pmx,  pmc,  itmp,  pcount) == 1:
          return 1
        # Store name + mark as extern so mir_proc_find yields INS 7.
        var _pns1: int = peek_tk(ts, li_rt_preg_get(0, _pn) + 0)
        var _pne1: int = peek_tk(te, li_rt_preg_get(0, _pn) + 0)
        li_rt_mir_pname_store(_pn, src, _pns1, _pne1)
        li_rt_mir_pname_set_extern(_pn, 1)
        _pn = _pn + 1
      else:
        # Emit pid from pcount; pn stays at the collected total so
        # mir_proc_find can resolve calls to any proc (incl. recursion).
        if mir_proc(src,  tk,  ts,  te,  n,  pi,  err,  1,  pcount[0], tc,  lastop,  ftok,  nft,  ftmp,  itok,  nit,  itmp,  fatok,  nfa, matok,  nmat, ptok,  pex,  pp0,  ppn,  pret,  pn,  ptok2,  pty,  pelems,  pef, pei,  pvar,  pmx,  pmc) == 1:
          return 1
        pcount[0] = pcount[0] + 1
      skip_newlines(tk,  n,  pi,  err)
      continue
    if k == 33:
      pi[0] = pi[0] + 1
      set32768(ftmp, 4091, 1)
      if mode == 0:
        if mir_collect_proc(src,  tk,  ts,  te,  n,  pi,  err,  0,  _pn, ptok,  pex,  pp0,  ppn,  pret,  ptok2,  pty,  pelems,  pef,  pei,  pvar,  pmx,  pmc,  itmp,  pcount) == 1:
          return 1
        var _pns2: int = peek_tk(ts, li_rt_preg_get(0, _pn) + 0)
        var _pne2: int = peek_tk(te, li_rt_preg_get(0, _pn) + 0)
        li_rt_mir_pname_store(_pn, src, _pns2, _pne2)
        _pn = _pn + 1
      else:
        if mir_proc(src,  tk,  ts,  te,  n,  pi,  err,  0,  pcount[0], tc,  lastop,  ftok,  nft,  ftmp,  itok,  nit,  itmp,  fatok,  nfa, matok,  nmat, ptok,  pex,  pp0,  ppn,  pret,  pn,  ptok2,  pty,  pelems,  pef,  pei,  pvar,  pmx,  pmc) == 1:
          return 1
        pcount[0] = pcount[0] + 1
      skip_newlines(tk,  n,  pi,  err)
      continue
    if k == 76:
      var save0: int = pi[0]
      parse_decorator_list(src,  tk,  ts,  te,  n,  pi,  err, 0)
      var dpos: int = pi[0]
      if at_fn_kw(tk,  n,  pi,  err) == 0:
        err[0] = 1
        return 1
      # Extract decorator name and args from token stream at save0
      # save0: 76(@) 4(name) ... 49(Args) 4(argname) 58(=) 5(int) 50(CloseArgs) ...
      var dec_name_tok: int = save0 + 1
      var dec_lanes: int = 0
      var dec_vectorized: int = 0
      var dec_no_vectorize: int = 0
      var dec_parallel: int = 0
      var dec_disjoint: int = 0
      var dec_parallel_tok: int = -1
      var dec_cpu_tok: int = -1
      # Check if decorator is vectorized
      if tok_is(src, ts, te, dec_name_tok + 0, "vectorized") == 1:
        dec_vectorized = 1
        # Look for lanes=N arg -- scan for tok "lanes" followed by 58(=) then 5(int)
        if peek_tk(tk, save0 + 2) == 49:
          var ai: int = save0 + 3
          while ai < dpos:
            if tok_is(src, ts, te, ai + 0, "lanes") == 1:
              if peek_tk(tk, ai + 1) == 58 and peek_tk(tk, ai + 2) == 5:
                dec_lanes = li_rt_mir_int(src, peek_tk(ts, ai + 2), peek_tk(te, ai + 2))
              break
            ai = ai + 1
      if tok_is(src, ts, te, dec_name_tok + 0, "no_vectorize") == 1:
        dec_no_vectorize = 1
      # Decorator lists may contain @cpu followed by @parallel(...). Scan the
      # complete list so the parallel DEC is retained rather than only the
      # first decorator name.
      var di: int = save0 + 1
      while di < dpos:
        if tok_is(src, ts, te, di, "parallel") == 1:
          dec_parallel = 1
          dec_parallel_tok = di
        if tok_is(src, ts, te, di, "cpu") == 1:
          dec_cpu_tok = di
        if tok_is(src, ts, te, di, "disjoint") == 1:
          dec_disjoint = 1
        di = di + 1
      if tok_is(src, ts, te, dec_name_tok + 0, "async") == 1:
        set32768(ftmp, 4091, 1)
      pi[0] = save0
      parse_decorator_list(src,  tk,  ts,  te,  n,  pi,  err, 0)
      pi[0] = dpos
      # Store decorator info in ftmp side-channel for mir_proc to emit DEC
      set32768(ftmp, 4092, dec_no_vectorize)
      set32768(ftmp, 4093, dec_name_tok)
      set32768(ftmp, 4094, dec_lanes)
      set32768(ftmp, 4095, dec_vectorized)
      set32768(ftmp, 4088, dec_parallel)
      set32768(ftmp, 4087, dec_disjoint)
      if dec_parallel_tok >= 0:
        set32768(ftmp, 4093, dec_parallel_tok)
      if dec_cpu_tok >= 0:
        set32768(ftmp, 4086, dec_cpu_tok)
      if mode == 0:
        if mir_collect_proc(src,  tk,  ts,  te,  n,  pi,  err,  0,  _pn, ptok,  pex,  pp0,  ppn,  pret,  ptok2,  pty,  pelems,  pef,  pei,  pvar,  pmx,  pmc,  itmp,  pcount) == 1:
          return 1
        var _pns3: int = peek_tk(ts, li_rt_preg_get(0, _pn) + 0)
        var _pne3: int = peek_tk(te, li_rt_preg_get(0, _pn) + 0)
        li_rt_mir_pname_store(_pn, src, _pns3, _pne3)
        _pn = _pn + 1
      else:
        if mir_proc(src,  tk,  ts,  te,  n,  pi,  err,  0,  pcount[0], tc,  lastop,  ftok,  nft,  ftmp,  itok,  nit,  itmp,  fatok,  nfa, matok,  nmat, ptok,  pex,  pp0,  ppn,  pret,  pn,  ptok2,  pty,  pelems,  pef,  pei,  pvar,  pmx,  pmc) == 1:
          return 1
        set32768(ftmp, 4093, -1)
        pcount[0] = pcount[0] + 1
      skip_newlines(tk,  n,  pi,  err)
      continue
    if k == 16:
      if peek_off(tk,  n,  pi,  1) == 10:
        if mode == 0:
          if mir_collect_proc(src,  tk,  ts,  te,  n,  pi,  err,  0,  _pn, ptok,  pex,  pp0,  ppn,  pret,  ptok2,  pty,  pelems,  pef,  pei,  pvar,  pmx,  pmc,  itmp,  pcount) == 1:
            return 1
          var _pns4: int = peek_tk(ts, li_rt_preg_get(0, _pn) + 0)
          var _pne4: int = peek_tk(te, li_rt_preg_get(0, _pn) + 0)
          li_rt_mir_pname_store(_pn, src, _pns4, _pne4)
          _pn = _pn + 1
        else:
          if mir_proc(src,  tk,  ts,  te,  n,  pi,  err,  0,  pcount[0], tc,  lastop,  ftok,  nft,  ftmp,  itok,  nit,  itmp,  fatok,  nfa, matok,  nmat, ptok,  pex,  pp0,  ppn,  pret,  pn,  ptok2,  pty,  pelems,  pef,  pei,  pvar,  pmx,  pmc) == 1:
            return 1
          pcount[0] = pcount[0] + 1
        skip_newlines(tk,  n,  pi,  err)
        continue
      err[0] = 1
      return 1
    if k == 17:
      if peek_off(tk,  n,  pi,  1) == 10:
        if mode == 0:
          if mir_collect_proc(src,  tk,  ts,  te,  n,  pi,  err,  0,  _pn, ptok,  pex,  pp0,  ppn,  pret,  ptok2,  pty,  pelems,  pef,  pei,  pvar,  pmx,  pmc,  itmp,  pcount) == 1:
            return 1
          var _pns5: int = peek_tk(ts, li_rt_preg_get(0, _pn) + 0)
          var _pne5: int = peek_tk(te, li_rt_preg_get(0, _pn) + 0)
          li_rt_mir_pname_store(_pn, src, _pns5, _pne5)
          _pn = _pn + 1
        else:
          if mir_proc(src,  tk,  ts,  te,  n,  pi,  err,  0,  pcount[0], tc,  lastop,  ftok,  nft,  ftmp,  itok,  nit,  itmp,  fatok,  nfa, matok,  nmat, ptok,  pex,  pp0,  ppn,  pret,  pn,  ptok2,  pty,  pelems,  pef,  pei,  pvar,  pmx,  pmc) == 1:
            return 1
          pcount[0] = pcount[0] + 1
        skip_newlines(tk,  n,  pi,  err)
        continue
      err[0] = 1
      return 1
    if k == 10:
      if mode == 0:
        if mir_collect_proc(src,  tk,  ts,  te,  n,  pi,  err,  0,  _pn, ptok,  pex,  pp0,  ppn,  pret,  ptok2,  pty,  pelems,  pef,  pei,  pvar,  pmx,  pmc,  itmp,  pcount) == 1:
          return 1
        var _pns6: int = peek_tk(ts, li_rt_preg_get(0, _pn) + 0)
        var _pne6: int = peek_tk(te, li_rt_preg_get(0, _pn) + 0)
        li_rt_mir_pname_store(_pn, src, _pns6, _pne6)
        _pn = _pn + 1
      else:
        if mir_proc(src,  tk,  ts,  te,  n,  pi,  err,  0,  pcount[0], tc,  lastop,  ftok,  nft,  ftmp,  itok,  nit,  itmp,  fatok,  nfa, matok,  nmat, ptok,  pex,  pp0,  ppn,  pret,  pn,  ptok2,  pty,  pelems,  pef,  pei,  pvar,  pmx,  pmc) == 1:
          return 1
        pcount[0] = pcount[0] + 1
      skip_newlines(tk,  n,  pi,  err)
      continue
    if k == 11:
      var obj_save: int = pi[0]
      parse_type_alias(src,  tk,  ts,  te,  n,  pi,  err, 0)
      # Check if this was 'type X = object' and record fields
      var chk: int = obj_save + 1
      # skip type name (token kind 4)
      if chk < n[0] and peek_tk(tk, chk) == 4:
        chk = chk + 1
        # skip generic params [T] if present
        if chk < n[0] and peek_tk(tk, chk) == 51:
          var gd: int = 1
          chk = chk + 1
          while gd > 0 and chk < n[0]:
            if peek_tk(tk, chk) == 51:
              gd = gd + 1
            if peek_tk(tk, chk) == 52:
              gd = gd - 1
            chk = chk + 1
        # skip newlines and =
        while chk < n[0] and peek_tk(tk, chk) == 1:
          chk = chk + 1
        if chk < n[0] and peek_tk(tk, chk) == 58:
          chk = chk + 1
          # skip newlines
          while chk < n[0] and peek_tk(tk, chk) == 1:
            chk = chk + 1
          if chk < n[0] and peek_tk(tk, chk) == 15:
            # This is 'type X = object' — record type and fields
            var obj_type_start: int = peek_tk(ts, obj_save + 1)
            var obj_type_end: int = peek_tk(te, obj_save + 1)
            # skip 'object' and optional 'of Base'
            chk = chk + 1
            while chk < n[0] and peek_tk(tk, chk) == 1:
              chk = chk + 1
            var base_s: int = -1
            var base_e: int = -1
            if chk < n[0] and tok_is(src, ts, te, chk, "of") == 1:
              chk = chk + 1
              while chk < n[0] and peek_tk(tk, chk) == 1:
                chk = chk + 1
              if chk < n[0] and peek_tk(tk, chk) == 4:
                base_s = peek_tk(ts, chk)
                base_e = peek_tk(te, chk)
              chk = chk + 1
              while chk < n[0] and peek_tk(tk, chk) == 1:
                chk = chk + 1
            # Now scan fields: [public|private] name: type
            var field_base: int = peek4096(itmp, 3200)
            var nfields: int = 0
            while chk < n[0]:
              var fk: int = peek_tk(tk, chk)
              if fk != 16 and fk != 17 and fk != 4:
                break
              # skip visibility
              if fk == 16 or fk == 17:
                chk = chk + 1
              if chk >= n[0] or peek_tk(tk, chk) != 4:
                break
              # field name token
              var fld_s: int = peek_tk(ts, chk)
              var fld_e: int = peek_tk(te, chk)
              chk = chk + 1
              # capture the field type name (token after ':') to know
              # float-ness for LocalAllocFloat/StoreFloat parity, the
              # array[N, ...] element count, and nested-object types
              var fld_float: int = 0
              var fld_elems: int = 0
              var fld_tn_s: int = -1
              var fld_tn_e: int = -1
              if chk + 1 < n[0] and peek_tk(tk, chk) == 56:
                var ty_tok: int = chk + 1
                fld_tn_s = peek_tk(ts, ty_tok)
                fld_tn_e = peek_tk(te, ty_tok)
                if tok_is(src, ts, te, ty_tok, "float") == 1 or tok_is(src, ts, te, ty_tok, "float64") == 1 or tok_is(src, ts, te, ty_tok, "float32") == 1 or tok_is(src, ts, te, ty_tok, "float16") == 1 or tok_is(src, ts, te, ty_tok, "float8") == 1 or tok_is(src, ts, te, ty_tok, "float4") == 1 or tok_is(src, ts, te, ty_tok, "f64") == 1 or tok_is(src, ts, te, ty_tok, "f32") == 1 or tok_is(src, ts, te, ty_tok, "f16") == 1 or tok_is(src, ts, te, ty_tok, "f8") == 1 or tok_is(src, ts, te, ty_tok, "f4") == 1:
                  fld_float = 1
                if ty_tok + 2 < n[0] and tok_is(src, ts, te, ty_tok, "array") == 1 and tok_is(src, ts, te, ty_tok + 1, "[") == 1:
                  fld_elems = li_rt_mir_int(src,  peek_tk(ts, ty_tok + 2),  peek_tk(te, ty_tok + 2))
                  # Check element type inside array[N, elem]: array[8, float] -> float
                  if ty_tok + 4 < n[0] and tok_is(src, ts, te, ty_tok + 3, ",") == 1:
                    var elem_tok: int = ty_tok + 4
                    if tok_is(src, ts, te, elem_tok, "float") == 1 or tok_is(src, ts, te, elem_tok, "float64") == 1 or tok_is(src, ts, te, elem_tok, "float32") == 1 or tok_is(src, ts, te, elem_tok, "f64") == 1 or tok_is(src, ts, te, elem_tok, "f32") == 1:
                      fld_float = 1
              # skip : and type tokens until newline
              while chk < n[0] and peek_tk(tk, chk) != 1:
                chk = chk + 1
              # skip newlines
              while chk < n[0] and peek_tk(tk, chk) == 1:
                chk = chk + 1
              if mode == 0:
                mir_obj_reg_field(itmp, src, fld_s, fld_e, fld_float, fld_elems, fld_tn_s, fld_tn_e)
              nfields = nfields + 1
            # Inheritance: `type Dog = object of Animal` — C++ for_each_object_field
            # recurses into the base first, so base fields precede derived fields.
            # Copy the base's field descriptors into a fresh contiguous range and
            # register the derived type with (base_nf + nfields) fields there.
            var reg_nf: int = nfields
            var reg_fb: int = field_base
            if base_s >= 0:
              var base_ti: int = mir_obj_find_type(src, ts, te, itmp, base_s, base_e)
              if base_ti >= 0:
                var base_nf: int = mir_obj_field_count(itmp, base_ti)
                var base_fb: int = peek4096(itmp, 3001 + base_ti * 6 + 3)
                var merged_base: int = peek4096(itmp, 3200)
                var bj: int = 0
                while bj < base_nf:
                  set4096(itmp, 3201 + (merged_base + bj) * 2 + 0, peek4096(itmp, 3201 + (base_fb + bj) * 2 + 0))
                  set4096(itmp, 3201 + (merged_base + bj) * 2 + 1, peek4096(itmp, 3201 + (base_fb + bj) * 2 + 1))
                  set4096(itmp, 3401 + (merged_base + bj) + 0, peek4096(itmp, 3401 + (base_fb + bj) + 0))
                  set4096(itmp, 3501 + (merged_base + bj) + 0, peek4096(itmp, 3501 + (base_fb + bj) + 0))
                  set4096(itmp, 3601 + (merged_base + bj) * 2 + 0, peek4096(itmp, 3601 + (base_fb + bj) * 2 + 0))
                  set4096(itmp, 3601 + (merged_base + bj) * 2 + 1, peek4096(itmp, 3601 + (base_fb + bj) * 2 + 1))
                  set4096(itmp, 3801 + merged_base + bj, peek4096(itmp, 3801 + base_fb + bj))
                  bj = bj + 1
                # Derived fields that shadow a same-named base field replace
                # the base descriptor in place (the derived type wins, and
                # leaf names are mangled by field name so the base copy must
                # not stay registered). Shadow detection uses the stored name
                # hash + span length, which are buffer-independent.
                var sh_n: int = 0
                var dj: int = 0
                while dj < nfields:
                  var sh_m: int = -1
                  var dj_len: int = peek4096(itmp, 3201 + (field_base + dj) * 2 + 1) - peek4096(itmp, 3201 + (field_base + dj) * 2 + 0)
                  var dj_h: int = peek4096(itmp, 3801 + field_base + dj)
                  var bj2: int = 0
                  while bj2 < base_nf:
                    var bj_len: int = peek4096(itmp, 3201 + (base_fb + bj2) * 2 + 1) - peek4096(itmp, 3201 + (base_fb + bj2) * 2 + 0)
                    if dj_len == bj_len:
                      if dj_h == peek4096(itmp, 3801 + base_fb + bj2):
                        sh_m = bj2
                    bj2 = bj2 + 1
                  if sh_m >= 0:
                    set4096(itmp, 3201 + (merged_base + sh_m) * 2 + 0, peek4096(itmp, 3201 + (field_base + dj) * 2 + 0))
                    set4096(itmp, 3201 + (merged_base + sh_m) * 2 + 1, peek4096(itmp, 3201 + (field_base + dj) * 2 + 1))
                    set4096(itmp, 3401 + merged_base + sh_m + 0, peek4096(itmp, 3401 + field_base + dj + 0))
                    set4096(itmp, 3501 + merged_base + sh_m + 0, peek4096(itmp, 3501 + field_base + dj + 0))
                    set4096(itmp, 3601 + (merged_base + sh_m) * 2 + 0, peek4096(itmp, 3601 + (field_base + dj) * 2 + 0))
                    set4096(itmp, 3601 + (merged_base + sh_m) * 2 + 1, peek4096(itmp, 3601 + (field_base + dj) * 2 + 1))
                    set4096(itmp, 3801 + merged_base + sh_m, dj_h)
                    sh_n = sh_n + 1
                  else:
                    var ap2: int = dj - sh_n
                    set4096(itmp, 3201 + (merged_base + base_nf + ap2) * 2 + 0, peek4096(itmp, 3201 + (field_base + dj) * 2 + 0))
                    set4096(itmp, 3201 + (merged_base + base_nf + ap2) * 2 + 1, peek4096(itmp, 3201 + (field_base + dj) * 2 + 1))
                    set4096(itmp, 3401 + (merged_base + base_nf + ap2) + 0, peek4096(itmp, 3401 + (field_base + dj) + 0))
                    set4096(itmp, 3501 + (merged_base + base_nf + ap2) + 0, peek4096(itmp, 3501 + (field_base + dj) + 0))
                    set4096(itmp, 3601 + (merged_base + base_nf + ap2) * 2 + 0, peek4096(itmp, 3601 + (field_base + dj) * 2 + 0))
                    set4096(itmp, 3601 + (merged_base + base_nf + ap2) * 2 + 1, peek4096(itmp, 3601 + (field_base + dj) * 2 + 1))
                    set4096(itmp, 3801 + merged_base + base_nf + ap2, dj_h)
                  dj = dj + 1
                set4096(itmp, 3200, merged_base + base_nf + nfields - sh_n)
                reg_nf = base_nf + nfields - sh_n
                reg_fb = merged_base
            if mode == 0:
              mir_obj_reg_type(itmp, src, ts, te, obj_type_start, obj_type_end, reg_nf, reg_fb, base_s, base_e)
      skip_newlines(tk,  n,  pi,  err)
      continue
    if k == 29:
      parse_error_decl(src,  tk,  ts,  te,  n,  pi,  err, 0)
      skip_newlines(tk,  n,  pi,  err)
      continue
    if k == 12:
      pi[0] = pi[0] + 1
      parse_theorem(src,  tk,  ts,  te,  n,  pi,  err,  1,  0,  0)
      skip_newlines(tk,  n,  pi,  err)
      continue
    if k == 13:
      pi[0] = pi[0] + 1
      parse_theorem(src,  tk,  ts,  te,  n,  pi,  err,  0,  0,  0)
      skip_newlines(tk,  n,  pi,  err)
      continue
    if k == 14:
      pi[0] = pi[0] + 1
      parse_theorem(src,  tk,  ts,  te,  n,  pi,  err,  0,  1,  0)
      skip_newlines(tk,  n,  pi,  err)
      continue
    err[0] = 1
    return 1
  # Sync proc count back to C global
  if mode == 0:
    li_rt_pn_set(_pn)
  return 0

# Scan the token stream for extern call sites and set the MIR module
# runtime-link flags in ftmp cells (4086=needs_rt_httpd, 4087=needs_rt_net,
# 4088=needs_rt_log), mirroring mir_runtime_link.cpp's prefix rules. A call
# site is `ident(` where ident resolves to a collected extern proc.
def mir_scan_rt_flags(src: var ptr,  tk: var array[262144, int],  ts: var array[262144, int], te: var array[262144, int],  n: var array[1, int],  ftmp: var array[32768, int],  ptok: var array[128, int],  pex: var array[128, int],  pn: var array[1, int]) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  var pi2: array[1, int]
  pi2[0] = 0
  var err2: array[1, int]
  err2[0] = 0
  skip_newlines(tk,  n,  pi2,  err2)
  while 1 == 1:
    var k: int = cur_kind(tk,  n,  pi2,  err2)
    if k == 0:
      break
    if k == 4:
      # Skip declaration names; only an identifier immediately followed by
      # an opening parenthesis is a call site.
      var is_decl: int = 0
      if pi2[0] >= 1:
        if peek_tk(tk, pi2[0] - 1) == 10:
          is_decl = 1
      if is_decl == 0:
        if peek_off(tk,  n,  pi2,  1) == 49:
          var scan_nm: ptr = bytes_slice_i(src,  peek_tk(ts, pi2[0] + 0),  peek_tk(te, pi2[0] + 0) - peek_tk(ts, pi2[0] + 0))
          # Do not classify by spelling before symbol resolution: imported
          # Li procedures such as net_tag are ordinary CallProc functions and
          # must not set runtime-link bits. The resolved-name path below is
          # the only call-name scanner used for MIR parity.
          var pid: int = mir_proc_find(src,  ts,  te,  peek_tk(ts, pi2[0] + 0),  peek_tk(te, pi2[0] + 0),  ptok,  pn)
          if pid >= 0:
            # Runtime-link flags come from CallExtern, not ordinary imported
            # CallProc bodies. Keep the symbol-resolution boundary identical
            # to C++ lowering before applying runtime-name prefixes.
            if li_rt_preg_get(1, pid) == 1:
              var nm: ptr = bytes_slice_i(src,  peek_tk(ts, pi2[0] + 0),  peek_tk(te, pi2[0] + 0) - peek_tk(ts, pi2[0] + 0))
              if li_rt_str_prefix(nm, "li_log_") == 1 or li_rt_str_prefix(nm, "li_rt_log_") == 1:
                set32768(ftmp, 4088, 1)
              if li_rt_str_prefix(nm, "httpd_") == 1 or li_rt_str_prefix(nm, "li_rt_httpd_") == 1 or li_rt_str_prefix(nm, "proxy_") == 1 or li_rt_str_prefix(nm, "li_rt_proxy_") == 1:
                set32768(ftmp, 4086, 1)
              if li_rt_str_prefix(nm, "net_") == 1 or li_rt_str_prefix(nm, "tcp_") == 1 or li_rt_str_prefix(nm, "epoll_") == 1 or li_rt_str_prefix(nm, "hdr_") == 1 or li_rt_str_prefix(nm, "buf_") == 1 or li_rt_str_prefix(nm, "bytes_") == 1 or li_rt_str_prefix(nm, "li_rt_net") == 1 or li_rt_str_prefix(nm, "li_async_") == 1 or li_rt_str_prefix(nm, "tcp_echo_") == 1:
                set32768(ftmp, 4087, 1)
              if li_rt_str_eq(nm, "path_ends_with_conf") == 1 or li_rt_str_eq(nm, "net_ping") == 1:
                set32768(ftmp, 4087, 1)
    pi2[0] = pi2[0] + 1
  # Note: `lic mir` (lower_to_mir) sets these flags only from direct extern
  # callee names during lowering — the httpd→net→log cascade runs only in the
  # codegen path, so we do NOT apply it here.
  return 0

# Count `parallel for` statements in the currently-lexed token stream. The
# C++ lower_to_mir pushes one __li_par_* function per parallel-for, so the
# MIR header function count is procs + parallel count and uses_openmp = 1.
def mir_count_parallel(src: var ptr,  tk: var array[262144, int],  ts: var array[262144, int], te: var array[262144, int],  n: var array[1, int]) -> int
  requires true
  ensures result >= 0
  decreases 0
=
  var cnt: int = 0
  var i: int = 1
  while i < n[0]:
    if peek_tk(tk, i) == 26:
      if tok_is(src, ts, te, i - 1, "parallel") == 1:
        cnt = cnt + 1
    i = i + 1
  return cnt

def mir_module(src: var ptr,  file_path: ptr, tk: var array[262144, int],  ts: var array[262144, int], te: var array[262144, int],  n: var array[1, int],  pi: var array[1, int], err: var array[1, int]) raises IO -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  var tc: array[1, int]
  tc[0] = 0
  var par_total: int = 0
  var lastop: array[1, int]
  lastop[0] = -1
  var ftok: array[4096, int]
  var nft: array[1, int]
  nft[0] = 0
  var ftmp: array[32768, int]
  var itok: array[4096, int]
  var nit: array[1, int]
  nit[0] = 0
  var itmp: array[4096, int]
  var fatok: array[512, int]
  var nfa: array[1, int]
  nfa[0] = 0
  set512(fatok, 63, 0)
  var matok: array[512, int]
  var nmat: array[1, int]
  nmat[0] = 0
  var ptok: array[128, int]
  var pex: array[128, int]
  var pp0: array[128, int]
  var ppn: array[128, int]
  var pret: array[128, int]
  var pn: array[1, int]
  pn[0] = 0
  var ptok2: array[512, int]
  var pty: array[512, int]
  var pelems: array[512, int]
  var pef: array[512, int]
  var pei: array[512, int]
  var pvar: array[512, int]
  var pmx: array[512, int]
  var pmc: array[512, int]
  var pcount: array[1, int]
  pcount[0] = 0
  # ---- Pre-scan main for imports, store resolved file contents ----
  var imp_n: array[1, int]
  imp_n[0] = 0
  li_rt_import_paths_clear()
  pi[0] = 0
  err[0] = 0
  skip_newlines(tk,  n,  pi,  err)
  while cur_kind(tk,  n,  pi,  err) != 0:
    var ki2: int = cur_kind(tk,  n,  pi,  err)
    if ki2 == 18:
      pi[0] = pi[0] + 1
      if cur_kind(tk,  n,  pi,  err) != 4:
        continue
      var ims: int = peek_tk(ts, pi[0] + 0)
      var ime: int = peek_tk(te, pi[0] + 0)
      pi[0] = pi[0] + 1
      while accept_k(tk,  n,  pi,  err, 72) == 1:
        if cur_kind(tk,  n,  pi,  err) == 4:
          ime = peek_tk(te, pi[0] + 0)
          pi[0] = pi[0] + 1
      if cur_kind(tk,  n,  pi,  err) == 4:
        if tok_is(src, ts, te, pi[0], "as") == 1:
          pi[0] = pi[0] + 1
          if cur_kind(tk,  n,  pi,  err) == 4:
            pi[0] = pi[0] + 1
      var mn2: ptr = bytes_slice_i(src,  ims,  ime - ims)
      var f2: ptr = li_rt_resolve_import(file_path,  mn2)
      if f2 != 0:
        if imp_n[0] < 16:
          li_rt_import_content_store(f2)
          li_rt_import_path_store(li_rt_resolve_import_last_path())
          imp_n[0] = imp_n[0] + 1
      continue
    pi[0] = pi[0] + 1
  # ---- Transitive import resolution: scan each resolved import for ITS imports ----
  var scan_idx: int = 0
  while scan_idx < imp_n[0]:
    var insert_at: int = scan_idx + 1
    n[0] = 0
    var lex_ok: int = lex_source(li_rt_import_content_get(scan_idx), tk, ts, te, n, 0)
    if lex_ok == 0:
      pi[0] = 0
      err[0] = 0
      skip_newlines(tk, n, pi, err)
      while cur_kind(tk, n, pi, err) != 0:
        var ki3: int = cur_kind(tk, n, pi, err)
        if ki3 == 18:
          pi[0] = pi[0] + 1
          if cur_kind(tk, n, pi, err) != 4:
            continue
          var ims2: int = peek_tk(ts, pi[0] + 0)
          var ime2: int = peek_tk(te, pi[0] + 0)
          pi[0] = pi[0] + 1
          while accept_k(tk, n, pi, err, 72) == 1:
            if cur_kind(tk, n, pi, err) == 4:
              ime2 = peek_tk(te, pi[0] + 0)
              pi[0] = pi[0] + 1
          if cur_kind(tk, n, pi, err) == 4:
            if tok_is(li_rt_import_content_get(scan_idx), ts, te, pi[0], "as") == 1:
              pi[0] = pi[0] + 1
              if cur_kind(tk, n, pi, err) == 4:
                pi[0] = pi[0] + 1
          var mn3: ptr = bytes_slice_i(li_rt_import_content_get(scan_idx), ims2, ime2 - ims2)
          var f3: ptr = li_rt_resolve_import(li_rt_import_path_get(scan_idx), mn3)
          if f3 != 0:
            var dup: int = 0
            var jj: int = 0
            # Resolved imports use a ring of content buffers, so the same
            # path can have different content pointers on repeated resolution.
            # Deduplicate by canonical resolved path as well as pointer.
            var new_path: ptr = li_rt_resolve_import_last_path()
            while jj < imp_n[0]:
              if li_rt_import_content_get(jj) == f3:
                dup = 1
              else:
                var old_path: ptr = li_rt_import_path_get(jj)
                if old_path != 0:
                  if li_rt_str_eq(old_path, new_path) == 1:
                    dup = 1
              jj = jj + 1
            if dup == 0:
              if imp_n[0] < 16:
                li_rt_import_content_insert(insert_at, f3)
                li_rt_import_path_insert(insert_at, li_rt_resolve_import_last_path())
                imp_n[0] = imp_n[0] + 1
                insert_at = insert_at + 1
          continue
        pi[0] = pi[0] + 1
    scan_idx = scan_idx + 1
  # ---- Collect: re-lex main, collect, then collect each import ----
  n[0] = 0
  if lex_source(src,  tk,  ts,  te,  n, 0) == 1:
    return 1
  pi[0] = 0  err[0] = 0
  li_rt_pn_set(0)
  li_rt_pidx_set(0)
  li_rt_preg_clear()
  if mir_walk(src,  tk,  ts,  te,  n,  pi,  err,  0, tc,  lastop,  ftok,  nft,  ftmp,  itok,  nit,  itmp,  fatok,  nfa, matok,  nmat, ptok,  pex,  pp0,  ppn,  pret,  pn,  ptok2,  pty,  pelems,  pef,  pei,  pvar,  pmx,  pmc,  pcount) == 1:
    return 1
  pn[0] = li_rt_pn_get()
  var ii: int = 0
  while ii < imp_n[0]:
    n[0] = 0
    if lex_source(li_rt_import_content_get(ii),  tk,  ts,  te,  n, 0) == 0:
      pi[0] = 0
      err[0] = 0
      li_rt_pn_set(pn[0])
      set32768(ftmp, 4096 + ii * 2, li_rt_pn_get())
      if mir_walk(li_rt_import_content_get(ii),  tk,  ts,  te,  n,  pi,  err,  0, tc,  lastop,  ftok,  nft,  ftmp,  itok,  nit,  itmp,  fatok,  nfa, matok,  nmat, ptok,  pex,  pp0,  ppn,  pret,  pn,  ptok2,  pty,  pelems,  pef,  pei,  pvar,  pmx,  pmc,  pcount) == 1:
        return 1
      set32768(ftmp, 4097 + ii * 2, li_rt_pn_get())
      pn[0] = li_rt_pn_get()
    ii = ii + 1
  # ---- Emit: re-lex main, scan flags, header, emit main, then emit imports ----
  n[0] = 0
  if lex_source(src,  tk,  ts,  te,  n, 0) == 1:
    return 1
  var has_async: int = peek32768(ftmp, 4091)
  set32768(ftmp, 4091, 0)
  set32768(ftmp, 4086, 0)
  set32768(ftmp, 4087, 0)
  set32768(ftmp, 4088, 0)
  if mir_scan_rt_flags(src,  tk,  ts,  te,  n,  ftmp,  ptok,  pex,  pn) == 1:
    return 1
  var scan_i: int = 0
  while scan_i < imp_n[0]:
    var scan_path: ptr = li_rt_import_path_get(scan_i)
    # std/runtime/seam.li is a declaration-only ABI manifest. Its names are
    # not executable calls and must not contribute runtime-link flags; package
    # bodies remain scanned normally.
    if li_rt_str_prefix(li_rt_import_content_get(scan_i), "# Trusted runtime ABI") == 0:
      # Package manifests select runtime modules at the module level. Keep
      # this path-based mapping alongside call-name scanning so imported
      # extern declarations remain correct even when their token stream is
      # re-lexed from a different source buffer.
      if scan_path != 0:
        if li_rt_str_contains(scan_path, "/li-http/") == 1:
          set32768(ftmp, 4086, 1)
        if li_rt_str_contains(scan_path, "/li-net-httpd/") == 1:
          set32768(ftmp, 4086, 1)
          set32768(ftmp, 4087, 1)
        if li_rt_str_contains(scan_path, "/li-log/") == 1:
          set32768(ftmp, 4088, 1)
      n[0] = 0
      if lex_source(li_rt_import_content_get(scan_i), tk, ts, te, n, 0) == 0:
        if mir_scan_rt_flags(li_rt_import_content_get(scan_i), tk, ts, te, n, ftmp, ptok, pex, pn) == 1:
          return 1
        par_total = par_total + mir_count_parallel(li_rt_import_content_get(scan_i), tk, ts, te, n)
    scan_i = scan_i + 1
  n[0] = 0
  if lex_source(src, tk, ts, te, n, 0) == 1:
    return 1
  par_total = par_total + mir_count_parallel(src, tk, ts, te, n)
  li_rt_mir_str("MIR")
  li_rt_ast_space()
  li_rt_ast_int(pn[0] + par_total)
  li_rt_ast_space()
  if par_total > 0:
    li_rt_ast_int(1)
  else:
    li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(has_async)
  li_rt_ast_space()
  li_rt_ast_int(peek32768(ftmp, 4086))
  li_rt_ast_space()
  li_rt_ast_int(peek32768(ftmp, 4087))
  li_rt_ast_space()
  li_rt_ast_int(peek32768(ftmp, 4088))
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_nl()
  pi[0] = 0
  err[0] = 0
  pcount[0] = 0
  li_rt_mir_par_counter_reset()
  if mir_walk(src,  tk,  ts,  te,  n,  pi,  err,  1, tc,  lastop,  ftok,  nft,  ftmp,  itok,  nit,  itmp,  fatok,  nfa, matok,  nmat, ptok,  pex,  pp0,  ppn,  pret,  pn,  ptok2,  pty,  pelems,  pef, pei,  pvar,  pmx,  pmc,  pcount) == 1:
    return 1
  # ---- Emit imports (re-lex each import; mir_proc reads from C globals) ----
  ii = 0
  while ii < imp_n[0]:
    var f3: ptr = li_rt_import_content_get(ii)
    n[0] = 0
    if lex_source(f3,  tk,  ts,  te,  n, 0) == 0:
      pi[0] = 0
      err[0] = 0
      if mir_walk(f3,  tk,  ts,  te,  n,  pi,  err,  1, tc,  lastop,  ftok,  nft,  ftmp,  itok,  nit,  itmp,  fatok,  nfa, matok,  nmat, ptok,  pex,  pp0,  ppn,  pret,  pn,  ptok2,  pty,  pelems,  pef,  pei,  pvar,  pmx,  pmc,  pcount) == 1:
        return 1
    ii = ii + 1
  return 0

def main() raises IO -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  var argc: int = li_rt_argc()
  if argc < 2:
    print_usage()
    return 1
  if strcmp(li_rt_argv(1), "--version") == 0:
    print_version()
    return 0
  if strcmp(li_rt_argv(1), "smoke") == 0:
    return 0
  var tk: array[262144, int]
  var ts: array[262144, int]
  var te: array[262144, int]
  var n: array[1, int]
  var pi: array[1, int]
  var err: array[1, int]
  n[0] = 0
  pi[0] = 0
  err[0] = 0
  if strcmp(li_rt_argv(1), "lex") == 0:
    if argc < 3:
      print_usage()
      return 1
    var f: ptr = li_rt_read_file(li_rt_argv(2))
    var r: int = lex_source(f, tk, ts, te, n, 1)
    if r == 1:
      print("lex error")
      return 1
    return 0
  if strcmp(li_rt_argv(1), "parse") == 0:
    if argc < 3:
      print_usage()
      return 1
    var f: ptr = li_rt_read_file(li_rt_argv(2))
    var r: int = parse_file(f, tk, ts, te, n, pi, err, 0, 1)
    if r == 1:
      print("parse error")
      return 1
    print("parse ok")
    return 0
  if strcmp(li_rt_argv(1), "ast") == 0:
    if argc < 3:
      print_usage()
      return 1
    var f: ptr = li_rt_read_file(li_rt_argv(2))
    var r: int = parse_file(f, tk, ts, te, n, pi, err, 1, 0)
    if r == 1:
      print("ast error")
      return 1
    return 0
  if strcmp(li_rt_argv(1), "mir") == 0:
    if argc < 3:
      print_usage()
      return 1
    var f: ptr = li_rt_read_file(li_rt_argv(2))
    var r: int = lex_source(f, tk, ts, te, n, 0)
    if r == 1:
      print("mir error")
      return 1
    var mr: int = mir_module(f, li_rt_argv(2), tk, ts, te, n, pi, err)
    if mr == 1:
      print("mir error")
      return 1
    return 0
  if strcmp(li_rt_argv(1), "check") == 0:
    if argc < 3:
      print_usage()
      return 1
    var f: ptr = li_rt_read_file(li_rt_argv(2))
    var r: int = parse_file(f, tk, ts, te, n, pi, err, 0, 0)
    if r == 1:
      print("check error")
      return 1
    pi[0] = 0
    err[0] = 0
    var cr: int = check_source(f, tk, ts, te, n, pi, err)
    var err_any: array[1, int]
    err_any[0] = err[0]
    pi[0] = 0
    err[0] = 0
    var er: int = effects_check(f, tk, ts, te, n, pi, err)
    if err[0] == 1:
      err_any[0] = 1
    pi[0] = 0
    err[0] = 0
    var br: int = borrow_check(f, tk, ts, te, n, pi, err)
    if err[0] == 1:
      err_any[0] = 1
    pi[0] = 0
    err[0] = 0
    var er2: int = encap_check(f, tk, ts, te, n, pi, err)
    if err[0] == 1:
      err_any[0] = 1
    if err_any[0] == 1:
      print("check error")
      return 1
    print("check ok")
    return 0
  print_usage()
  return 1