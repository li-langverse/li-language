        return 0
      if expect_k(tk, n, pi, err, 52) == 0:
        return 0
      continue
    loop = 0
  return 1

def parse_primary(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], d: int) -> int
