    expect_k(tk, n, pi, err, 56)
    skip_newlines(tk, n, pi, err)
    parse_block(src, tk, ts, te, n, pi, err, d)
    var nelif: array[1,  int]
    nelif[0] = 0
    var tail_done: int = 0
    while tail_done == 0:
      skip_newlines(tk, n, pi, err)
      if cur_kind(tk, n, pi, err) == 24:
        nelif[0] = nelif[0] + 1
        a_line(d, 51)
        a_line(d, 41)
        pi[0] = pi[0] + 1
