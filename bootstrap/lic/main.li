          break
      pi[0] = pi[0] + 1
      if given == 1:
        if cur_kind(tk, n, pi, err) != 4:
          err[0] = 1
          return 1
        gs = pi[0]
        pi[0] = pi[0] + 1
      else:
        if cur_kind(tk, n, pi, err) != 5:
          err[0] = 1
          return 1
        sm = int_text_value(src, ts, te, pi[0])
        pi[0] = pi[0] + 1
      skip_newlines(tk, n, pi, err)
  if d == 1:
    if gs >= 0:
