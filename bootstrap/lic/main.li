          if cur_kind(tk, n, pi, err) == 2:
            bk_check_block(src, tk, ts, te, n, pi, err, 1, bp_name, bp_np, bp_pv, bp_ps, bp_cnt, ls_name, ls_moved, ls_mb, ls_ib, ls_n, rq_proc, rq_pi, rq_op, rq_lit, rq_left, rq_n, iem_src, iem_ns, iem_ne, iem_vis, iem_cnt, iem_uq)
      skip_newlines(tk, n, pi, err)
      continue
    err[0] = 1
    return 1
  return 0

# MIR-lane requires-clause call-site check (C++ E0304 parity in mir output):
# borrow_check's exact two-pass shape, with phase 2 running bo=0 so borrow
# bookkeeping stays off and only rq_check_call can latch errors.

def mir_rq_check(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], iem_src: var array[256, ptr], iem_ns: var array[256, int], iem_ne: var array[256, int], iem_vis: var array[256, int], iem_cnt: var array[1, int]) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  var bp_name: array[256, int]
  var bp_np: array[256, int]
  var bp_pv: array[4096, int]
  var bp_ps: array[4096, int]
  var bp_cnt: array[1, int]
  var pend: array[1, int]
  var decl: array[1, int]
  var ls_name: array[256, int]
  var ls_moved: array[256, int]
  var ls_mb: array[256, int]
  var ls_ib: array[256, int]
  var ls_n: array[1, int]
  var rp_np: array[256, int]
  var rp_ps: array[4096, int]
  var rq_proc: array[256, int]
  var rq_pi: array[256, int]
  var rq_op: array[256, int]
  var rq_lit: array[256, int]
  var rq_left: array[256, int]
  var rq_n: array[1, int]
  var fire: array[1, int]
  var iem_uq: int = 1
  # Borrow-class fire marker (mir lane only): bk_check_use / bk_check_stmt
  # set the preg-23 fire channel only while this marker is up, so the
  # walker's check lane (bo=1, marker absent) stays byte-identical.
  # Preg 14 was never used elsewhere. The set/clears sit inside nested
  # guards on purpose: root-level extern calls would trip the fx extern-IO
  # rule on the walker's own source during bootstrap.
  var mk14: int = 1
  if mk14 == 1:
    li_rt_preg_set(14, 0, 1)
  bp_cnt[0] = 0
  rq_n[0] = 0
  fire[0] = 0
  pend[0] = 0
  pi[0] = 0
  skip_newlines(tk, n, pi, err)
  while cur_kind(tk, n, pi, err) != 0:
    var k: int = cur_kind(tk, n, pi, err)
    if k == 11:
      fx_skip_typealias(src, tk, ts, te, n, pi, err)
      continue
    if k == 76:
      fx_skip_decorators(src, tk, ts, te, n, pi, err, pend)
      continue
    if k == 18:
      parse_import(src, tk, ts, te, n, pi, err, 0)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 13 or k == 12 or k == 14:
      pi[0] = pi[0] + 1
      parse_theorem(src, tk, ts, te, n, pi, err, 0, 0, 0)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 16 or k == 17:
      pi[0] = pi[0] + 1
      skip_newlines(tk, n, pi, err)
      continue
    if k == 32 or k == 10 or k == 33:
      var is_ext: int = 0
      if k == 32:
        is_ext = 1
        pi[0] = pi[0] + 1
        if cur_kind(tk, n, pi, err) == 10:
          pi[0] = pi[0] + 1
      if k == 33:
        pi[0] = pi[0] + 1
        if cur_kind(tk, n, pi, err) == 10:
          pi[0] = pi[0] + 1
      if k == 10:
        pi[0] = pi[0] + 1
      if cur_kind(tk, n, pi, err) != 4:
        err[0] = 1
        li_rt_preg_set(14, 0, 0)
        return fire[0]
      var nm: int = pi[0]
      pi[0] = pi[0] + 1
      var idx: int = bp_cnt[0]
      if idx < 256:
        bp_name[idx] = nm
        bp_np[idx] = 0
        bp_cnt[0] = bp_cnt[0] + 1
      fx_skip_typeparams(tk, n, pi, err)
      expect_k(tk, n, pi, err, 49)
      bk_skip_params_rec(src, tk, ts, te, n, pi, err, bp_np, bp_pv, bp_ps, rp_np, rp_ps, idx)
      fx_record_raises(src, tk, ts, te, n, pi, err, decl)
      if accept_k(tk, n, pi, err, 57) == 1:
        parse_type(src, tk, ts, te, n, pi, err, 0)
      fx_record_raises(src, tk, ts, te, n, pi, err, decl)
      while 1 == 1:
        var ck: int = cur_kind(tk, n, pi, err)
        if ck == 41:
          rq_capture_clause(src, tk, ts, te, n, pi, err, idx, nm, rp_np, rp_ps, rq_proc, rq_pi, rq_op, rq_lit, rq_left, rq_n)
          parse_contract(src, tk, ts, te, n, pi, err, 0)
          continue
        if ck == 42 or ck == 43 or ck == 44 or ck == 45:
          parse_contract(src, tk, ts, te, n, pi, err, 0)
          continue
        break
      if is_ext == 0:
        skip_newlines(tk, n, pi, err)
        if accept_k(tk, n, pi, err, 58) == 1:
          skip_newlines(tk, n, pi, err)
          if cur_kind(tk, n, pi, err) == 2:
            parse_block(src, tk, ts, te, n, pi, err, 0)
      skip_newlines(tk, n, pi, err)
      continue
    err[0] = 1
    return fire[0]
  pi[0] = 0
  pend[0] = 0
  skip_newlines(tk, n, pi, err)
  while cur_kind(tk, n, pi, err) != 0:
    var k: int = cur_kind(tk, n, pi, err)
    if k == 11:
      fx_skip_typealias(src, tk, ts, te, n, pi, err)
      continue
    if k == 76:
      fx_skip_decorators(src, tk, ts, te, n, pi, err, pend)
      continue
    if k == 18:
      parse_import(src, tk, ts, te, n, pi, err, 0)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 13 or k == 12 or k == 14:
      pi[0] = pi[0] + 1
      parse_theorem(src, tk, ts, te, n, pi, err, 0, 0, 0)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 16 or k == 17:
      pi[0] = pi[0] + 1
      skip_newlines(tk, n, pi, err)
      continue
    if k == 32 or k == 10 or k == 33:
      var is_ext: int = 0
      if k == 32:
        is_ext = 1
        pi[0] = pi[0] + 1
        if cur_kind(tk, n, pi, err) == 10:
          pi[0] = pi[0] + 1
      if k == 33:
        pi[0] = pi[0] + 1
        if cur_kind(tk, n, pi, err) == 10:
          pi[0] = pi[0] + 1
      if k == 10:
        pi[0] = pi[0] + 1
      if cur_kind(tk, n, pi, err) != 4:
        err[0] = 1
        li_rt_preg_set(14, 0, 0)
        return fire[0]
      pi[0] = pi[0] + 1
      fx_skip_typeparams(tk, n, pi, err)
      expect_k(tk, n, pi, err, 49)
      # A clean err channel per proc: the fire test after the body walk
      # must see only latches this proc's own walk produced (cur_kind
      # latches err[0] benignly at end-of-stream, so per-proc isolation is
      # what keeps the fire verdict exact).
      err[0] = 0
      ls_n[0] = 0
      bk_skip_params_decl(src, tk, ts, te, n, pi, err, ls_name, ls_moved, ls_mb, ls_ib, ls_n)
      fx_record_raises(src, tk, ts, te, n, pi, err, decl)
      if accept_k(tk, n, pi, err, 57) == 1:
        parse_type(src, tk, ts, te, n, pi, err, 0)
      fx_record_raises(src, tk, ts, te, n, pi, err, decl)
      while 1 == 1:
        var ck: int = cur_kind(tk, n, pi, err)
        if ck == 41 or ck == 42 or ck == 43 or ck == 44 or ck == 45:
          parse_contract(src, tk, ts, te, n, pi, err, 0)
          continue
        break
      if is_ext == 0:
        skip_newlines(tk, n, pi, err)
        if accept_k(tk, n, pi, err, 58) == 1:
          skip_newlines(tk, n, pi, err)
          if cur_kind(tk, n, pi, err) == 2:
            # bo=1 (tenth port): the mir lane now runs the SAME borrow-check
            # pass the check lane always did — move/use-after-move and
            # double-borrow bookkeeping (C++ borrowck) — while rq_check_call
            # still fires at every call site. Fire travels in the li_rt_preg
            # registry (both the E0304 rq latches and the borrow latches
            # gated by the preg-14 mir marker land there); slot 23 is
            # cleared just before the walk, read just after.
            li_rt_preg_set(23, 0, 0)
            bk_check_block(src, tk, ts, te, n, pi, err, 1, bp_name, bp_np, bp_pv, bp_ps, bp_cnt, ls_name, ls_moved, ls_mb, ls_ib, ls_n, rq_proc, rq_pi, rq_op, rq_lit, rq_left, rq_n, iem_src, iem_ns, iem_ne, iem_vis, iem_cnt, iem_uq)
            if li_rt_preg_get(23, 0) == 1:
              fire[0] = 1
      err[0] = 0
      skip_newlines(tk, n, pi, err)
      continue
    err[0] = 1
    return fire[0]
  # The final cur_kind loop-guard latch at end-of-stream is benign: only
  # the accumulated fire verdict travels back to the caller, and err is
  # left clean for the fx driver.
  err[0] = 0
  if mk14 == 1:
    li_rt_preg_set(14, 0, 0)
  return fire[0]

# ---- Layer 4d: encapsulation / visibility / trait / object checks ----
# Mirrors compiler/types/{policy,typecheck}.cpp object/trait semantics.

def ec_find_obj(src: var ptr, ts: var array[262144, int], te: var array[262144, int], ob_name: var array[256, int], ob_cnt: var array[1, int], name_tok: int) -> int
  requires true
  ensures result >= -1
  decreases 0
=
  var k: int = 0
  while k < ob_cnt[0]:
    if tok_eq(src, ts, te, ob_name[k], name_tok) == 1:
      return k
    k = k + 1
  return -1

def ec_find_trait(src: var ptr, ts: var array[262144, int], te: var array[262144, int], tr_name: var array[64, int], tr_cnt: var array[1, int], name_tok: int) -> int
  requires true
  ensures result >= -1
  decreases 0
=
  var k: int = 0
  while k < tr_cnt[0]:
    if tok_eq(src, ts, te, tr_name[k], name_tok) == 1:
      return k
    k = k + 1
  return -1

def ec_name_joins(src: var ptr, ts: var array[262144, int], te: var array[262144, int], a: int, b: int, f: int) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  var la: int = peek_tk(te, a + 0) - peek_tk(ts, a + 0)
  var lb: int = peek_tk(te, b + 0) - peek_tk(ts, b + 0)
  var lf: int = peek_tk(te, f + 0) - peek_tk(ts, f + 0)
  if lf != la + 1 + lb:
    return 0
  var j: int = 0
  while j < la:
    if li_rt_str_char_at(src, peek_tk(ts, a + 0) + j) != li_rt_str_char_at(src, peek_tk(ts, f + 0) + j):
      return 0
    j = j + 1
  if li_rt_str_char_at(src, peek_tk(ts, f + 0) + la) != 95:
    return 0
  j = 0
  while j < lb:
    if li_rt_str_char_at(src, peek_tk(ts, b + 0) + j) != li_rt_str_char_at(src, peek_tk(ts, f + 0) + la + 1 + j):
      return 0
    j = j + 1
  return 1

def ec_has_prefix_join(src: var ptr, ts: var array[262144, int], te: var array[262144, int], a: int, f: int) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  var lf: int = peek_tk(te, f + 0) - peek_tk(ts, f + 0)
  var la: int = peek_tk(te, a + 0) - peek_tk(ts, a + 0)
  if lf < la + 2:
    return 0
  var j: int = 0
  while j < la:
    if li_rt_str_char_at(src, peek_tk(ts, a + 0) + j) != li_rt_str_char_at(src, peek_tk(ts, f + 0) + j):
      return 0
    j = j + 1
  if li_rt_str_char_at(src, peek_tk(ts, f + 0) + la) != 95:
    return 0
  return 1

def ec_same_suffix(src: var ptr, ts: var array[262144, int], te: var array[262144, int], a: int, b: int, f: int, g: int) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  var lf: int = peek_tk(te, f + 0) - peek_tk(ts, f + 0)
  var lg: int = peek_tk(te, g + 0) - peek_tk(ts, g + 0)
  var la: int = peek_tk(te, a + 0) - peek_tk(ts, a + 0)
  var lb: int = peek_tk(te, b + 0) - peek_tk(ts, b + 0)
  if lf - la != lg - lb:
    return 0
  var ls: int = lf - la - 1
  if ls <= 0:
    return 0
  var j: int = 0
  while j < la:
    if li_rt_str_char_at(src, peek_tk(ts, a + 0) + j) != li_rt_str_char_at(src, peek_tk(ts, f + 0) + j):
      return 0
    j = j + 1
  if li_rt_str_char_at(src, peek_tk(ts, f + 0) + la) != 95:
    return 0
  j = 0
  while j < lb:
    if li_rt_str_char_at(src, peek_tk(ts, b + 0) + j) != li_rt_str_char_at(src, peek_tk(ts, g + 0) + j):
      return 0
    j = j + 1
  if li_rt_str_char_at(src, peek_tk(ts, g + 0) + lb) != 95:
    return 0
  j = 0
  while j < ls:
    if li_rt_str_char_at(src, peek_tk(ts, f + 0) + la + 1 + j) != li_rt_str_char_at(src, peek_tk(ts, g + 0) + lb + 1 + j):
      return 0
    j = j + 1
  return 1

def ec_underscore(src: var ptr, ts: var array[262144, int], te: var array[262144, int], tok: int) -> int
  requires true
  ensures result >= -1
  decreases 0
=
  var st: int = peek_tk(ts, tok + 0)
  var en: int = peek_tk(te, tok + 0)
  var j: int = st
  while j < en:
    if li_rt_str_char_at(src, j) == 95:
      return j - st
    j = j + 1
  return -1

def ec_ident_used(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], bind_tok: int) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  var j: int = 0
  while j < n[0]:
    if j != bind_tok:
      if peek_tk(tk, j) == 4:
        if tok_eq(src, ts, te, j, bind_tok) == 1:
          return 1
    j = j + 1
  return 0

def ec_field_idx(src: var ptr, ts: var array[262144, int], te: var array[262144, int], fd_name: var array[8192, int], fd_owner: var array[256, int], fd_cnt: var array[1, int], ob_idx: int, name_tok: int) -> int
  requires true
  ensures result >= -1
  decreases 0
=
  var k: int = 0
  while k < fd_cnt[0]:
    if fd_owner[k] == ob_idx:
      if tok_eq(src, ts, te, fd_name[k], name_tok) == 1:
        return k
    k = k + 1
  return -1

def ec_obj_impl_trait(src: var ptr, ts: var array[262144, int], te: var array[262144, int], tm_name: var array[256, int], tm_owner: var array[256, int], tm_cnt: var array[1, int], ep_name: var array[256, int], ep_cnt: var array[1, int], ob_tok: int, tr_idx: int) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  var m: int = 0
  while m < tm_cnt[0]:
    if tm_owner[m] == tr_idx:
      var found: int = 0
      var p: int = 0
      while p < ep_cnt[0]:
        if ec_name_joins(src, ts, te, ob_tok, tm_name[m], ep_name[p]) == 1:
          found = 1
        p = p + 1
      if found == 0:
        return 0
    m = m + 1
  return 1

def ec_capture_type_tok(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int]) -> int
  requires true
  ensures result >= -1
  decreases 0
=
  var tt: int = -1
  if cur_kind(tk, n, pi, err) == 20:
    pi[0] = pi[0] + 1
  if cur_kind(tk, n, pi, err) == 4:
    tt = pi[0]
  parse_type(src, tk, ts, te, n, pi, err, 0)
  return tt

def ec_record_proc(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], is_priv: int, is_ovr: int, ep_name: var array[256, int], ep_priv: var array[256, int], ep_self: var array[256, int], ep_ret: var array[256, int], ep_bnd: var array[256, int], ep_ovr: var array[256, int], ep_cnt: var array[1, int]) -> int
  requires true
  ensures result == 1
  decreases 0
=
  if cur_kind(tk, n, pi, err) != 4:
    err[0] = 1
    return 1
  var nm: int = pi[0]
  pi[0] = pi[0] + 1
  var idx: int = ep_cnt[0]
  if idx < 256:
    ep_name[idx] = nm
    ep_priv[idx] = is_priv
    ep_self[idx] = -1
    ep_ret[idx] = -1
    ep_bnd[idx] = -1
    ep_ovr[idx] = is_ovr
    ep_cnt[0] = ep_cnt[0] + 1
  if accept_k(tk, n, pi, err, 51) == 1:
    if cur_kind(tk, n, pi, err) != 52:
      var done: int = 0
      while done == 0:
        if cur_kind(tk, n, pi, err) == 4:
          pi[0] = pi[0] + 1
        if accept_k(tk, n, pi, err, 56) == 1:
          if cur_kind(tk, n, pi, err) == 4:
            if idx < 256:
              ep_bnd[idx] = pi[0]
            pi[0] = pi[0] + 1
        if accept_k(tk, n, pi, err, 55) == 1:
          done = 0
        else:
          done = 1
    expect_k(tk, n, pi, err, 52)
  expect_k(tk, n, pi, err, 49)
  skip_param_layout(tk, n, pi, err)
  var first: int = 1
  if cur_kind(tk, n, pi, err) != 50:
    var done: int = 0
    while done == 0:
      skip_param_layout(tk, n, pi, err)
      if cur_kind(tk, n, pi, err) == 4:
        var pn: int = pi[0]
        pi[0] = pi[0] + 1
        expect_k(tk, n, pi, err, 56)
        var tt: int = ec_capture_type_tok(src, tk, ts, te, n, pi, err)
        if first == 1:
          if idx < 256:
            ep_self[idx] = tt
        first = 0
      skip_param_layout(tk, n, pi, err)
      if accept_k(tk, n, pi, err, 55) == 1:
        done = 0
      else:
        done = 1
  skip_param_layout(tk, n, pi, err)
  expect_k(tk, n, pi, err, 50)
  tc_skip_raises(tk, n, pi, err)
  if accept_k(tk, n, pi, err, 57) == 1:
    if idx < 256:
      ep_ret[idx] = ec_capture_type_tok(src, tk, ts, te, n, pi, err)
    else:
      parse_type(src, tk, ts, te, n, pi, err, 0)
  tc_skip_raises(tk, n, pi, err)
  while 1 == 1:
    var ck: int = cur_kind(tk, n, pi, err)
    if ck == 41 or ck == 42 or ck == 43 or ck == 44 or ck == 45:
      parse_contract(src, tk, ts, te, n, pi, err, 0)
      continue
    break
  return 1

def ec_parse_fields(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], ob_idx: int, fd_name: var array[8192, int], fd_priv: var array[8192, int], fd_type: var array[8192, int], fd_owner: var array[256, int], fd_cnt: var array[1, int]) -> int
  requires true
  ensures result == 1
  decreases 0
=
  skip_newlines(tk, n, pi, err)
  while 1 == 1:
    var k: int = cur_kind(tk, n, pi, err)
    if k != 16:
      if k != 17:
        if k != 4:
          break
        if peek_off(tk, n, pi, 1) != 56:
          break
    if k == 16:
      if peek_off(tk, n, pi, 1) == 10:
        break
    if k == 17:
      if peek_off(tk, n, pi, 1) == 10:
        break
    var vis: int = 0
    if k == 16:
      vis = 1
      pi[0] = pi[0] + 1
    else:
      if k == 17:
        pi[0] = pi[0] + 1
    if cur_kind(tk, n, pi, err) != 4:
      err[0] = 1
      break
    var fn: int = pi[0]
    pi[0] = pi[0] + 1
    expect_k(tk, n, pi, err, 56)
    var tt: int = ec_capture_type_tok(src, tk, ts, te, n, pi, err)
    if fd_cnt[0] < 256:
      fd_name[fd_cnt[0]] = fn
      fd_priv[fd_cnt[0]] = vis
      fd_type[fd_cnt[0]] = tt
      fd_owner[fd_cnt[0]] = ob_idx
      fd_cnt[0] = fd_cnt[0] + 1
    skip_newlines(tk, n, pi, err)
  return 1

def ec_parse_trait_methods(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], tr_idx: int, tm_name: var array[256, int], tm_owner: var array[256, int], tm_cnt: var array[1, int]) -> int
  requires true
  ensures result == 1
  decreases 0
=
  skip_newlines(tk, n, pi, err)
  while 1 == 1:
    var k: int = cur_kind(tk, n, pi, err)
    if k == 16:
      pi[0] = pi[0] + 1
    if k == 17:
      pi[0] = pi[0] + 1
    k = cur_kind(tk, n, pi, err)
    if k == 10 or k == 9:
      pi[0] = pi[0] + 1
      if cur_kind(tk, n, pi, err) != 4:
        err[0] = 1
        return 1
      var mn: int = pi[0]
      pi[0] = pi[0] + 1
      expect_k(tk, n, pi, err, 49)
      skip_param_layout(tk, n, pi, err)
      if cur_kind(tk, n, pi, err) != 50:
        var done: int = 0
        while done == 0:
          parse_param(src, tk, ts, te, n, pi, err, 0)
          skip_param_layout(tk, n, pi, err)
          if accept_k(tk, n, pi, err, 55) == 1:
            done = 0
          else:
            done = 1
      skip_param_layout(tk, n, pi, err)
      expect_k(tk, n, pi, err, 50)
      if accept_k(tk, n, pi, err, 57) == 1:
        parse_type(src, tk, ts, te, n, pi, err, 0)
      if tm_cnt[0] < 256:
        tm_name[tm_cnt[0]] = mn
        tm_owner[tm_cnt[0]] = tr_idx
        tm_cnt[0] = tm_cnt[0] + 1
      skip_newlines(tk, n, pi, err)
      continue
    break
  return 1

# ---- policy scan: field privacy, method existence, trait bounds ----
# Mirrors the typecheck.cpp object/trait checks that need base-type info:
#   `v.secret` on an object with a private `secret`  -> lic.error (900)
#   `w.missing()` where no `Widget_missing` proc      -> E0202 (202)
#   `require_hash(b)` where Bad doesn't impl Hash     -> lic.error (900)
# Locals (params + `var x: T`) are tracked per proc; only plain-idents whose
# declared type names a locally-declared object are checked.

def pl_find_ty(src: var ptr, ts: var array[262144, int], te: var array[262144, int], pl_name: var array[256, int], pl_ty: var array[256, int], pl_n: var array[1, int], name_tok: int) -> int
  requires true
  ensures result >= -1
  decreases 0
=
  var k: int = 0
  while k < pl_n[0]:
    if tok_eq(src, ts, te, pl_name[k], name_tok) == 1:
      return pl_ty[k]
    k = k + 1
  return -1

def ec_tok_text(src: var ptr, ts: var array[262144, int], te: var array[262144, int], tok: int) raises IO -> ptr
  requires true
  ensures result >= 0
  decreases 0
=
  return bytes_slice_i(src, peek_tk(ts, tok + 0), peek_tk(te, tok + 0) - peek_tk(ts, tok + 0))

def ec_text_eq(a: ptr, b: ptr) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  if li_rt_str_eq(a, b) == 1:
    return 1
  return 0

# Collect `type X = object` decls from an already-lexed (imported) token
# stream into text tables: im_ob (object names), im_fd_name/im_fd_priv/
# im_fd_owner (fields with visibility). Returns 0.
def ec_collect_import_objects(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], im_ob: var array[64, ptr], im_fd_name: var array[256, ptr], im_fd_priv: var array[8192, int], im_fd_owner: var array[256, int], im_ob_cnt: var array[1, int], im_fd_cnt: var array[1, int]) -> int
  requires true
  ensures result == 0
  decreases 0
=
  pi[0] = 0
  skip_newlines(tk, n, pi, err)
  while cur_kind(tk, n, pi, err) != 0:
    var k: int = cur_kind(tk, n, pi, err)
    if k == 11:
      pi[0] = pi[0] + 1
      if cur_kind(tk, n, pi, err) != 4:
        pi[0] = pi[0] + 1
        continue
      var ob: int = -1
      var nm: int = pi[0]
      pi[0] = pi[0] + 1
      fx_skip_typeparams(tk, n, pi, err)
      if cur_kind(tk, n, pi, err) == 58:
        pi[0] = pi[0] + 1
        skip_newlines(tk, n, pi, err)
        if cur_kind(tk, n, pi, err) == 15:
          pi[0] = pi[0] + 1
          skip_newlines(tk, n, pi, err)
          if cur_kind(tk, n, pi, err) == 4:
            if tok_is(src, ts, te, pi[0], "of") == 1:
              pi[0] = pi[0] + 1
              if cur_kind(tk, n, pi, err) == 4:
                pi[0] = pi[0] + 1
              skip_newlines(tk, n, pi, err)
          ob = im_ob_cnt[0]
          if im_ob_cnt[0] < 64:
            im_ob[im_ob_cnt[0]] = ec_tok_text(src, ts, te, nm)
            im_ob_cnt[0] = im_ob_cnt[0] + 1
          skip_newlines(tk, n, pi, err)
          while 1 == 1:
            var fk: int = cur_kind(tk, n, pi, err)
            if fk != 16:
              if fk != 17:
                if fk != 4:
                  break
                if peek_off(tk, n, pi, 1) != 56:
                  break
            if fk == 16:
              if peek_off(tk, n, pi, 1) == 10:
                break
            if fk == 17:
              if peek_off(tk, n, pi, 1) == 10:
                break
            var vis: int = 0
            if fk == 16:
              vis = 1
              pi[0] = pi[0] + 1
            else:
              if fk == 17:
                pi[0] = pi[0] + 1
            if cur_kind(tk, n, pi, err) != 4:
              break
            var fn: int = pi[0]
            pi[0] = pi[0] + 1
            expect_k(tk, n, pi, err, 56)
            parse_type(src, tk, ts, te, n, pi, err, 0)
            if im_fd_cnt[0] < 256:
              if ob >= 0:
                im_fd_name[im_fd_cnt[0]] = ec_tok_text(src, ts, te, fn)
                im_fd_priv[im_fd_cnt[0]] = vis
                im_fd_owner[im_fd_cnt[0]] = ob
                im_fd_cnt[0] = im_fd_cnt[0] + 1
            skip_newlines(tk, n, pi, err)
        else:
          while cur_kind(tk, n, pi, err) != 1:
            if cur_kind(tk, n, pi, err) == 0:
              break
            pi[0] = pi[0] + 1
          pi[0] = pi[0] + 1
      else:
        pi[0] = pi[0] + 1
      skip_newlines(tk, n, pi, err)
      continue
    if k == 10 or k == 16 or k == 17 or k == 32 or k == 33 or k == 76:
      pi[0] = pi[0] + 1
      skip_newlines(tk, n, pi, err)
      continue
    if k == 18 or k == 13 or k == 12 or k == 14:
      pi[0] = pi[0] + 1
      skip_newlines(tk, n, pi, err)
      continue
    pi[0] = pi[0] + 1
  return 0

# True when object text `ob` declares field text `fld` as private, searching
# the imported text tables.
def ec_import_field_private(im_ob: var array[64, ptr], im_fd_name: var array[256, ptr], im_fd_priv: var array[8192, int], im_fd_owner: var array[256, int], im_ob_cnt: var array[1, int], im_fd_cnt: var array[1, int], ob: ptr, fld: ptr) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  var oi: int = -1
  var q: int = 0
  while q < im_ob_cnt[0]:
    if ec_text_eq(im_ob[q], ob) == 1:
      oi = q
    q = q + 1
  if oi < 0:
    return 0
  q = 0
  while q < im_fd_cnt[0]:
    if im_fd_owner[q] == oi:
      if ec_text_eq(im_fd_name[q], fld) == 1:
        if im_fd_priv[q] == 1:
          return 1
    q = q + 1
  return 0

def pl_add_local(pl_name: var array[256, int], pl_ty: var array[256, int], pl_n: var array[1, int], name_tok: int, ty_tok: int) -> int
  requires true
  ensures result == 0
  decreases 0
=
  if pl_n[0] < 256:
    pl_name[pl_n[0]] = name_tok
    pl_ty[pl_n[0]] = ty_tok
    pl_n[0] = pl_n[0] + 1
  return 0

def pl_proc_bound(src: var ptr, ts: var array[262144, int], te: var array[262144, int], ep_name: var array[256, int], ep_bnd: var array[256, int], ep_cnt: var array[1, int], name_tok: int) -> int
  requires true
  ensures result >= -1
  decreases 0
=
  var q: int = 0
  while q < ep_cnt[0]:
    if tok_eq(src, ts, te, ep_name[q], name_tok) == 1:
      if peek256(ep_bnd, q) >= 0:
        return peek256(ep_bnd, q)
    q = q + 1
  return -1

def pl_obj_has_method(src: var ptr, ts: var array[262144, int], te: var array[262144, int], ob_name: var array[256, int], ob_cnt: var array[1, int], ep_name: var array[256, int], ep_cnt: var array[1, int], ob_tok: int, method_tok: int) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  var q: int = 0
  while q < ep_cnt[0]:
    if ec_name_joins(src, ts, te, ob_tok, method_tok, ep_name[q]) == 1:
      return 1
    q = q + 1
  return 0

