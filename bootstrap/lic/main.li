        skip_newlines(tk, n, pi, err)
        parse_block(src, tk, ts, te, n, pi, err, d)
      else:
        if cur_kind(tk, n, pi, err) == 23:
          pi[0] = pi[0] + 1
          expect_k(tk, n, pi, err, 56)
          skip_newlines(tk, n, pi, err)
          parse_block(src, tk, ts, te, n, pi, err, d)
          tail_done = 1
        else:
          tail_done = 1
    var ci: int = 0
    while ci < nelif[0]:
      a_line(d, 52)
      ci = ci + 1
    return 1
  var save: int = pi[0]
  var ok: int = parse_primary(src, tk, ts, te, n, pi, err, 0)
  if ok == 1:
    ok = parse_postfix(src, tk, ts, te, n, pi, err, 0)
