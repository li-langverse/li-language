  # name cell 6 (empty)
  li_rt_ast_space()
  # f25..f36
  li_rt_ast_space()
  li_rt_ast_int(flag2)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
