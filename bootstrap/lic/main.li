    li_rt_ast_space()
    li_rt_ast_text(src,  s,  e)
    li_rt_ast_space()
    li_rt_ast_int(v2)
    li_rt_ast_nl()
  return 0

def int_text_value(src: var ptr,  ts: var array[262144,  int],  te: var array[262144,  int], i: int) -> int
  requires true
  ensures result >= 0
  decreases 0
=
  var v: int = 0
  var p: int = peek_tk(ts,  i + 0)
  var en: int = peek_tk(te,  i + 0)
  while p < en:
    v = v * 10 + (li_rt_str_char_at(src, p) - 48)
    p = p + 1
  return v

type Pos65536 = {p: int | 0 <= p and p < 65536}
type Pos4096 = {p: int | 0 <= p and p < 4096}
type Pos32768 = {p: int | 0 <= p and p < 32768}
type Pos16384 = {p: int | 0 <= p and p < 16384}
type Pos1024 = {p: int | 0 <= p and p < 1024}
type Pos512 = {p: int | 0 <= p and p < 512}
type Pos128 = {p: int | 0 <= p and p < 128}
type Pos40 = {p: int | 0 <= p and p < 40}
type Pos32 = {p: int | 0 <= p and p < 32}
type Pos16 = {p: int | 0 <= p and p < 16}
type Pos6 = {p: int | 0 <= p and p < 6}

def peek65536(buf: var array[65536, int], p: Pos65536) -> int
  requires true
  ensures result == buf[p]
  decreases 0
=
  return buf[p]

def set65536(buf: var array[65536, int], p: Pos65536, v: int) -> int
  requires true
  ensures result == v
  decreases 0
=
  buf[p] = v
  return v

