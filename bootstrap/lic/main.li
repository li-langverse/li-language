              f27[12] = peek65536(darena, rec + 1)
              f27[13] = peek65536(darena, rec + 2)
              f27[14] = 1
            else:
              if peek65536(darena, rec + 0) == 9:
                var rfb27: int = peek65536(darena, rec + 1)
                if peek65536(darena, rfb27 + 0) == 3:
                  li_rt_mir_str("INS")
                  li_rt_ast_space()
                  li_rt_ast_int(26)
                  li_rt_ast_space()
                  li_rt_ast_int(0)
                  li_rt_ast_space()
                  li_rt_ast_int(0)
                  li_rt_ast_space()
                  li_rt_mir_esc(src, peek_tk(ts, vn + 0), peek_tk(te, vn + 0))
                  # str_value, callee, lhs_ident (empty)
                  li_rt_ast_space()
                  li_rt_ast_space()
                  li_rt_ast_space()
                  li_rt_ast_space()
                  li_rt_mir_str("__li_o_")
                  li_rt_mir_esc(src, peek65536(darena, rfb27 + 1), peek65536(darena, rfb27 + 2))
                  li_rt_mir_str("_")
                  var fs27: ptr = li_rt_type_src_get(-1)
                  if fs27 == 0:
