    ok = parse_postfix(src, tk, ts, te, n, pi, err, 0)
  if ok == 1:
    if accept_k(tk, n, pi, err, 58) == 1:
      pl_check_expr(src, tk, ts, te, n, pi, err, 0, cur, ob_name, ob_cnt, tr_name, tr_cnt, fd_name, fd_priv, fd_owner, fd_cnt, tm_name, tm_owner, tm_cnt, ep_name, ep_bnd, ep_cnt, im_ob, im_fd_name, im_fd_priv, im_fd_owner, im_ob_cnt, im_fd_cnt, pl_name, pl_ty, pl_n)
      return 1
  pi[0] = save
  pl_check_expr(src, tk, ts, te, n, pi, err, 0, cur, ob_name, ob_cnt, tr_name, tr_cnt, fd_name, fd_priv, fd_owner, fd_cnt, tm_name, tm_owner, tm_cnt, ep_name, ep_bnd, ep_cnt, im_ob, im_fd_name, im_fd_priv, im_fd_owner, im_ob_cnt, im_fd_cnt, pl_name, pl_ty, pl_n)
  return 1

def pl_scan_proc(src: var ptr, tk: var array[65536, int], ts: var array[65536, int], te: var array[65536, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], ob_name: var array[256, int], ob_cnt: var array[1, int], tr_name: var array[64, int], tr_cnt: var array[1, int], fd_name: var array[256, int], fd_priv: var array[256, int], fd_owner: var array[256, int], fd_cnt: var array[1, int], tm_name: var array[256, int], tm_owner: var array[256, int], tm_cnt: var array[1, int], im_ob: var array[64, ptr], im_fd_name: var array[256, ptr], im_fd_priv: var array[256, int], im_fd_owner: var array[256, int], im_ob_cnt: var array[1, int], im_fd_cnt: var array[1, int], ep_name: var array[256, int], ep_bnd: var array[256, int], ep_cnt: var array[1, int]) -> int
  requires true
  ensures result == 1
  decreases 0
=
  var pl_name: array[256, int]
  var pl_ty: array[256, int]
  var pl_n: array[1, int]
  pl_n[0] = 0
  if cur_kind(tk, n, pi, err) != 4:
    return 1
  pi[0] = pi[0] + 1
  fx_skip_typeparams(tk, n, pi, err)
  expect_k(tk, n, pi, err, 49)
  skip_param_layout(tk, n, pi, err)
  if cur_kind(tk, n, pi, err) != 50:
    var done: int = 0
    while done == 0:
      skip_param_layout(tk, n, pi, err)
      if cur_kind(tk, n, pi, err) == 4:
        var pn: int = pi[0]
        pi[0] = pi[0] + 1
        expect_k(tk, n, pi, err, 56)
        var pt: int = ec_capture_type_tok(src, tk, ts, te, n, pi, err)
        pl_add_local(pl_name, pl_ty, pl_n, pn, pt)
      skip_param_layout(tk, n, pi, err)
      if accept_k(tk, n, pi, err, 55) == 1:
        done = 0
      else:
        done = 1
  skip_param_layout(tk, n, pi, err)
  expect_k(tk, n, pi, err, 50)
  tc_skip_raises(tk, n, pi, err)
  if accept_k(tk, n, pi, err, 57) == 1:
    parse_type(src, tk, ts, te, n, pi, err, 0)
  tc_skip_raises(tk, n, pi, err)
  while 1 == 1:
    var ck: int = cur_kind(tk, n, pi, err)
    if ck == 41 or ck == 42 or ck == 43 or ck == 44 or ck == 45:
      parse_contract(src, tk, ts, te, n, pi, err, 0)
      continue
    break
  skip_newlines(tk, n, pi, err)
  if accept_k(tk, n, pi, err, 58) == 1:
    skip_newlines(tk, n, pi, err)
    if cur_kind(tk, n, pi, err) == 2:
      pl_check_block(src, tk, ts, te, n, pi, err, ob_name, ob_cnt, tr_name, tr_cnt, fd_name, fd_priv, fd_owner, fd_cnt, tm_name, tm_owner, tm_cnt, ep_name, ep_bnd, ep_cnt, im_ob, im_fd_name, im_fd_priv, im_fd_owner, im_ob_cnt, im_fd_cnt, pl_name, pl_ty, pl_n)
  return 1

def ec_skip_body(src: var ptr, tk: var array[65536, int], ts: var array[65536, int], te: var array[65536, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int]) -> int
  requires true
  ensures result == 1
  decreases 0
=
  skip_newlines(tk, n, pi, err)
  if accept_k(tk, n, pi, err, 58) == 1:
    skip_newlines(tk, n, pi, err)
    parse_block(src, tk, ts, te, n, pi, err, 0)
  return 1

def encap_check(src: var ptr, tk: var array[65536, int], ts: var array[65536, int], te: var array[65536, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int]) raises IO -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  var ob_name: array[256, int]
  var ob_base: array[256, int]
  var ob_cnt: array[1, int]
  var tr_name: array[64, int]
  var tr_cnt: array[1, int]
  var fd_name: array[256, int]
  var fd_priv: array[256, int]
  var fd_type: array[256, int]
  var fd_owner: array[256, int]
  var fd_cnt: array[1, int]
  var tm_name: array[256, int]
  var tm_owner: array[256, int]
  var tm_cnt: array[1, int]
  var ep_name: array[256, int]
  var ep_priv: array[256, int]
  var ep_self: array[256, int]
  var ep_ret: array[256, int]
  var ep_bnd: array[256, int]
  var ep_ovr: array[256, int]
  var ep_cnt: array[1, int]
  var im_ob: array[64, ptr]
  var im_fd_name: array[256, ptr]
  var im_fd_priv: array[256, int]
  var im_fd_owner: array[256, int]
  var im_ob_cnt: array[1, int]
  var im_fd_cnt: array[1, int]
  ob_cnt[0] = 0
  tr_cnt[0] = 0
  fd_cnt[0] = 0
  tm_cnt[0] = 0
  ep_cnt[0] = 0
  im_ob_cnt[0] = 0
  im_fd_cnt[0] = 0
  # Import merge: resolve each `import X` to a sibling X.li and collect its
  # object/field tables as text, so field-privacy checks see imported types.
  # The imported file is lexed into the shared arrays, collected, then the
  # main file is re-lexed back (the token stream is deterministic).
  pi[0] = 0
  skip_newlines(tk, n, pi, err)
  while cur_kind(tk, n, pi, err) != 0:
    if cur_kind(tk, n, pi, err) == 18:
      pi[0] = pi[0] + 1
      if cur_kind(tk, n, pi, err) == 4:
        var mod_tok: int = pi[0]
        pi[0] = pi[0] + 1
        var imp: ptr = li_rt_resolve_import(li_rt_argv(2), ec_tok_text(src, ts, te, mod_tok))
        if imp != 0:
          var r1: int = lex_source(imp, tk, ts, te, n, 0)
          var pi2: array[1, int]
          pi2[0] = 0
          ec_collect_import_objects(imp, tk, ts, te, n, pi2, err, im_ob, im_fd_name, im_fd_priv, im_fd_owner, im_ob_cnt, im_fd_cnt)
          var r2: int = lex_source(src, tk, ts, te, n, 0)
      skip_newlines(tk, n, pi, err)
      continue
    pi[0] = pi[0] + 1
  pi[0] = 0
  skip_newlines(tk, n, pi, err)
  while cur_kind(tk, n, pi, err) != 0:
    var k: int = cur_kind(tk, n, pi, err)
    if k == 18:
      parse_import(src, tk, ts, te, n, pi, err, 0)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 11:
      pi[0] = pi[0] + 1
      if cur_kind(tk, n, pi, err) != 4:
        err[0] = 1
        return 1
      var an: int = pi[0]
      pi[0] = pi[0] + 1
      fx_skip_typeparams(tk, n, pi, err)
      expect_k(tk, n, pi, err, 58)
      skip_newlines(tk, n, pi, err)
      if cur_kind(tk, n, pi, err) == 15:
        pi[0] = pi[0] + 1
        skip_newlines(tk, n, pi, err)
        var bt: int = -1
        if cur_kind(tk, n, pi, err) == 4:
          if tok_is(src, ts, te, pi[0], "of") == 1:
            pi[0] = pi[0] + 1
            if cur_kind(tk, n, pi, err) == 4:
              bt = pi[0]
              pi[0] = pi[0] + 1
            skip_newlines(tk, n, pi, err)
        var oi: int = ob_cnt[0]
        if oi < 64:
          ob_name[oi] = an
          ob_base[oi] = bt
          ob_cnt[0] = ob_cnt[0] + 1
        ec_parse_fields(src, tk, ts, te, n, pi, err, oi, fd_name, fd_priv, fd_type, fd_owner, fd_cnt)
      else:
        if cur_kind(tk, n, pi, err) == 4:
          if tok_is(src, ts, te, pi[0], "trait") == 1:
            pi[0] = pi[0] + 1
            var ti: int = tr_cnt[0]
            if ti < 64:
              tr_name[ti] = an
              tr_cnt[0] = tr_cnt[0] + 1
            ec_parse_trait_methods(src, tk, ts, te, n, pi, err, ti, tm_name, tm_owner, tm_cnt)
          else:
            tc_skip_alias_rhs(src, tk, ts, te, n, pi, err, fd_name, fd_priv, fd_type, fd_cnt)
        else:
          tc_skip_alias_rhs(src, tk, ts, te, n, pi, err, fd_name, fd_priv, fd_type, fd_cnt)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 76:
      var pend: array[1, int]
      pend[0] = 0
      var ovr: int = 0
      if peek_off(tk, n, pi, 1) == 4:
        if tok_is(src, ts, te, pi[0] + 1, "override") == 1:
          ovr = 1
      parse_decorator_list(src, tk, ts, te, n, pi, err, 0)
      if cur_kind(tk, n, pi, err) == 16 or cur_kind(tk, n, pi, err) == 17:
        pi[0] = pi[0] + 1
      if cur_kind(tk, n, pi, err) == 10 or cur_kind(tk, n, pi, err) == 9:
        pi[0] = pi[0] + 1
        ec_record_proc(src, tk, ts, te, n, pi, err, 0, ovr, ep_name, ep_priv, ep_self, ep_ret, ep_bnd, ep_ovr, ep_cnt)
        ec_skip_body(src, tk, ts, te, n, pi, err)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 16 or k == 17:
      var pv: int = 0
      if k == 16:
        pv = 1
      pi[0] = pi[0] + 1
      if cur_kind(tk, n, pi, err) == 10:
        pi[0] = pi[0] + 1
        ec_record_proc(src, tk, ts, te, n, pi, err, pv, 0, ep_name, ep_priv, ep_self, ep_ret, ep_bnd, ep_ovr, ep_cnt)
        ec_skip_body(src, tk, ts, te, n, pi, err)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 10:
      pi[0] = pi[0] + 1
      ec_record_proc(src, tk, ts, te, n, pi, err, 0, 0, ep_name, ep_priv, ep_self, ep_ret, ep_bnd, ep_ovr, ep_cnt)
      ec_skip_body(src, tk, ts, te, n, pi, err)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 32:
      pi[0] = pi[0] + 1
      if cur_kind(tk, n, pi, err) == 10:
        pi[0] = pi[0] + 1
        ec_record_proc(src, tk, ts, te, n, pi, err, 0, 0, ep_name, ep_priv, ep_self, ep_ret, ep_bnd, ep_ovr, ep_cnt)
      else:
        if cur_kind(tk, n, pi, err) == 9:
          err[0] = 1
          li_rt_emit_err(900)
          pi[0] = pi[0] + 1
          skip_newlines(tk, n, pi, err)
          while cur_kind(tk, n, pi, err) != 0:
            if cur_kind(tk, n, pi, err) == 11 or cur_kind(tk, n, pi, err) == 10 or cur_kind(tk, n, pi, err) == 16 or cur_kind(tk, n, pi, err) == 17 or cur_kind(tk, n, pi, err) == 18 or cur_kind(tk, n, pi, err) == 32 or cur_kind(tk, n, pi, err) == 33 or cur_kind(tk, n, pi, err) == 76 or cur_kind(tk, n, pi, err) == 9 or cur_kind(tk, n, pi, err) == 13 or cur_kind(tk, n, pi, err) == 12 or cur_kind(tk, n, pi, err) == 14:
              break
            pi[0] = pi[0] + 1
          continue
        else:
          err[0] = 1
          return 1
      skip_newlines(tk, n, pi, err)
      continue
    if k == 33:
      pi[0] = pi[0] + 1
      if cur_kind(tk, n, pi, err) == 10:
        pi[0] = pi[0] + 1
        ec_record_proc(src, tk, ts, te, n, pi, err, 0, 0, ep_name, ep_priv, ep_self, ep_ret, ep_bnd, ep_ovr, ep_cnt)
        ec_skip_body(src, tk, ts, te, n, pi, err)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 9:
      err[0] = 1
      li_rt_emit_err(900)
      li_rt_emit_err(900)
      pi[0] = pi[0] + 1
      skip_newlines(tk, n, pi, err)
      while cur_kind(tk, n, pi, err) != 0:
        if cur_kind(tk, n, pi, err) == 11 or cur_kind(tk, n, pi, err) == 10 or cur_kind(tk, n, pi, err) == 16 or cur_kind(tk, n, pi, err) == 17 or cur_kind(tk, n, pi, err) == 18 or cur_kind(tk, n, pi, err) == 32 or cur_kind(tk, n, pi, err) == 33 or cur_kind(tk, n, pi, err) == 76 or cur_kind(tk, n, pi, err) == 9 or cur_kind(tk, n, pi, err) == 13 or cur_kind(tk, n, pi, err) == 12 or cur_kind(tk, n, pi, err) == 14:
          break
        pi[0] = pi[0] + 1
      continue
    if k == 13 or k == 12 or k == 14:
      parse_theorem(src, tk, ts, te, n, pi, err, 0, 0, 0)
      skip_newlines(tk, n, pi, err)
      continue
    err[0] = 1
    return 1
  # Post-pass: inheritance layout + override + W0401.
  var o: int = 0
  while o < ob_cnt[0]:
    if ob_base[o] >= 0:
      var bo: int = ec_find_obj(src, ts, te, ob_name, ob_cnt, ob_base[o])
      if bo >= 0:
        var f: int = 0
        while f < fd_cnt[0]:
          if fd_owner[f] == o:
            var bf: int = ec_field_idx(src, ts, te, fd_name, fd_owner, fd_cnt, bo, fd_name[f])
            if bf >= 0:
              if tok_eq(src, ts, te, fd_type[f], peek256(fd_type, bf)) == 0:
                err[0] = 1
                li_rt_emit_err(900)
          f = f + 1
    o = o + 1
  o = 0
  while o < ep_cnt[0]:
    if ep_ovr[o] == 1:
      var us: int = ec_underscore(src, ts, te, ep_name[o])
      if us <= 0:
        err[0] = 1
        li_rt_emit_err(900)
      else:
        var aidx: int = -1
        var q: int = 0
        while q < ob_cnt[0]:
          if ec_has_prefix_join(src, ts, te, ob_name[q], ep_name[o]) == 1:
            aidx = q
          q = q + 1
        if aidx < 0:
          err[0] = 1
          li_rt_emit_err(900)
        else:
          if peek256(ob_base, aidx) < 0:
            err[0] = 1
            li_rt_emit_err(900)
          else:
            var gidx: int = -1
            q = 0
            while q < ep_cnt[0]:
              if q != o:
                if ec_same_suffix(src, ts, te, peek256(ob_name, aidx), peek256(ob_base, aidx), ep_name[o], ep_name[q]) == 1:
                  gidx = q
              q = q + 1
            if gidx < 0:
              err[0] = 1
              li_rt_emit_err(900)
            else:
              if ep_self[o] != -1:
                if peek256(ep_self, gidx) == -1:
                  err[0] = 1
                  li_rt_emit_err(900)
                else:
                  if tok_eq(src, ts, te, ep_self[o], peek256(ep_self, gidx)) == 0:
                    err[0] = 1
                    li_rt_emit_err(900)
              else:
                if peek256(ep_self, gidx) != -1:
                  err[0] = 1
                  li_rt_emit_err(900)
              if ep_ret[o] != -1:
                if peek256(ep_ret, gidx) == -1:
                  err[0] = 1
                  li_rt_emit_err(900)
                else:
                  if tok_eq(src, ts, te, ep_ret[o], peek256(ep_ret, gidx)) == 0:
                    err[0] = 1
                    li_rt_emit_err(900)
              else:
                if peek256(ep_ret, gidx) != -1:
                  err[0] = 1
                  li_rt_emit_err(900)
    o = o + 1
  # W0401: unused imports.
  pi[0] = 0
  skip_newlines(tk, n, pi, err)
  while cur_kind(tk, n, pi, err) != 0:
    if cur_kind(tk, n, pi, err) == 18:
      pi[0] = pi[0] + 1
      var bt2: int = -1
      if cur_kind(tk, n, pi, err) == 4:
        bt2 = pi[0]
        pi[0] = pi[0] + 1
        while accept_k(tk, n, pi, err, 72) == 1:
          if cur_kind(tk, n, pi, err) == 4:
            bt2 = pi[0]
            pi[0] = pi[0] + 1
        if cur_kind(tk, n, pi, err) == 4:
          if tok_is(src, ts, te, pi[0], "as") == 1:
            pi[0] = pi[0] + 1
            if cur_kind(tk, n, pi, err) == 4:
              bt2 = pi[0]
              pi[0] = pi[0] + 1
      if bt2 >= 0:
        if ec_ident_used(src, tk, ts, te, n, bt2) == 0:
          li_rt_emit_err(401)
      skip_newlines(tk, n, pi, err)
      continue
    pi[0] = pi[0] + 1
  # Policy scan: field privacy, method existence, trait bounds (needs the
  # complete object/field/proc/trait tables, so it runs after the collection
  # passes above).
  pi[0] = 0
  skip_newlines(tk, n, pi, err)
  while cur_kind(tk, n, pi, err) != 0:
    var k: int = cur_kind(tk, n, pi, err)
    if k == 18:
      parse_import(src, tk, ts, te, n, pi, err, 0)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 11:
      pi[0] = pi[0] + 1
      if cur_kind(tk, n, pi, err) != 4:
        err[0] = 1
        return 1
      pi[0] = pi[0] + 1
      fx_skip_typeparams(tk, n, pi, err)
      expect_k(tk, n, pi, err, 58)
      tc_skip_alias_rhs(src, tk, ts, te, n, pi, err, fd_name, fd_priv, fd_type, fd_cnt)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 76:
      parse_decorator_list(src, tk, ts, te, n, pi, err, 0)
      if cur_kind(tk, n, pi, err) == 16 or cur_kind(tk, n, pi, err) == 17:
        pi[0] = pi[0] + 1
      if cur_kind(tk, n, pi, err) == 10 or cur_kind(tk, n, pi, err) == 9:
        pi[0] = pi[0] + 1
        pl_scan_proc(src, tk, ts, te, n, pi, err, ob_name, ob_cnt, tr_name, tr_cnt, fd_name, fd_priv, fd_owner, fd_cnt, tm_name, tm_owner, tm_cnt, im_ob, im_fd_name, im_fd_priv, im_fd_owner, im_ob_cnt, im_fd_cnt, ep_name, ep_bnd, ep_cnt)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 16 or k == 17:
      pi[0] = pi[0] + 1
      if cur_kind(tk, n, pi, err) == 10:
        pi[0] = pi[0] + 1
        pl_scan_proc(src, tk, ts, te, n, pi, err, ob_name, ob_cnt, tr_name, tr_cnt, fd_name, fd_priv, fd_owner, fd_cnt, tm_name, tm_owner, tm_cnt, im_ob, im_fd_name, im_fd_priv, im_fd_owner, im_ob_cnt, im_fd_cnt, ep_name, ep_bnd, ep_cnt)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 10 or k == 33:
      pi[0] = pi[0] + 1
      if k == 33:
        if cur_kind(tk, n, pi, err) == 10:
          pi[0] = pi[0] + 1
      pl_scan_proc(src, tk, ts, te, n, pi, err, ob_name, ob_cnt, tr_name, tr_cnt, fd_name, fd_priv, fd_owner, fd_cnt, tm_name, tm_owner, tm_cnt, im_ob, im_fd_name, im_fd_priv, im_fd_owner, im_ob_cnt, im_fd_cnt, ep_name, ep_bnd, ep_cnt)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 32:
      pi[0] = pi[0] + 1
      if cur_kind(tk, n, pi, err) == 10:
        pi[0] = pi[0] + 1
        pl_scan_proc(src, tk, ts, te, n, pi, err, ob_name, ob_cnt, tr_name, tr_cnt, fd_name, fd_priv, fd_owner, fd_cnt, tm_name, tm_owner, tm_cnt, im_ob, im_fd_name, im_fd_priv, im_fd_owner, im_ob_cnt, im_fd_cnt, ep_name, ep_bnd, ep_cnt)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 13 or k == 12 or k == 14:
      parse_theorem(src, tk, ts, te, n, pi, err, 0, 0, 0)
      skip_newlines(tk, n, pi, err)
      continue
    pi[0] = pi[0] + 1
  return 0

# ---------------------------------------------------------------- driver --

def parse_file(src: var ptr, tk: var array[65536, int], ts: var array[65536, int], te: var array[65536, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], d: int, emit_tok: int) raises IO -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  var r: int = lex_source(src, tk, ts, te, n, emit_tok)
  if r == 1:
    return 1
  parse_module(src, tk, ts, te, n, pi, err, d)
  if err[0] == 1:
    return 1
  return 0

def main() raises IO -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  var argc: int = li_rt_argc()
  if argc < 2:
    print_usage()
    return 1
  if strcmp(li_rt_argv(1), "--version") == 0:
    print_version()
    return 0
  if strcmp(li_rt_argv(1), "smoke") == 0:
    return 0
  var tk: array[65536, int]
  var ts: array[65536, int]
  var te: array[65536, int]
  var n: array[1, int]
  var pi: array[1, int]
  var err: array[1, int]
  n[0] = 0
  pi[0] = 0
  err[0] = 0
  if strcmp(li_rt_argv(1), "lex") == 0:
    if argc < 3:
      print_usage()
      return 1
    var f: ptr = li_rt_read_file(li_rt_argv(2))
    var r: int = lex_source(f, tk, ts, te, n, 1)
    if r == 1:
      print("lex error")
      return 1
    return 0
  if strcmp(li_rt_argv(1), "parse") == 0:
    if argc < 3:
      print_usage()
      return 1
    var f: ptr = li_rt_read_file(li_rt_argv(2))
    var r: int = parse_file(f, tk, ts, te, n, pi, err, 0, 1)
    if r == 1:
      print("parse error")
      return 1
    print("parse ok")
    return 0
  if strcmp(li_rt_argv(1), "ast") == 0:
    if argc < 3:
      print_usage()
      return 1
    var f: ptr = li_rt_read_file(li_rt_argv(2))
    var r: int = parse_file(f, tk, ts, te, n, pi, err, 1, 0)
    if r == 1:
      print("ast error")
      return 1
    return 0
  if strcmp(li_rt_argv(1), "mir") == 0:
    # Layer 5 not yet ported — placeholder for the MIR-lowering parity gate.
    print("mir: not yet implemented")
    return 1
  if strcmp(li_rt_argv(1), "check") == 0:
    if argc < 3:
      print_usage()
      return 1
    var f: ptr = li_rt_read_file(li_rt_argv(2))
    var r: int = parse_file(f, tk, ts, te, n, pi, err, 0, 0)
    if r == 1:
      print("check error")
      return 1
    pi[0] = 0
    err[0] = 0
    var cr: int = check_source(f, tk, ts, te, n, pi, err)
    var err_any: array[1, int]
    err_any[0] = err[0]
    pi[0] = 0
    err[0] = 0
    var er: int = effects_check(f, tk, ts, te, n, pi, err)
    if err[0] == 1:
      err_any[0] = 1
    pi[0] = 0
    err[0] = 0
    var br: int = borrow_check(f, tk, ts, te, n, pi, err)
    if err[0] == 1:
      err_any[0] = 1
    pi[0] = 0
    err[0] = 0
    var er2: int = encap_check(f, tk, ts, te, n, pi, err)
    if err[0] == 1:
      err_any[0] = 1
    if err_any[0] == 1:
      print("check error")
      return 1
    print("check ok")
    return 0
  print_usage()
  return 1