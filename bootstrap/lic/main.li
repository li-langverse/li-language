                      var ac_oti: int = mir_obj_find_var(src, ts, te, itmp, peek65536(darena, acrec + 1), peek65536(darena, acrec + 2))
                      var ac_isvar: int = 0
                      var ac_pid: int = peek32768(ftmp, 4090)
