  mir_emit_jump_label(src,  lastop,  43,  4,  ex)
  nlp[0] = nlp[0] - 1
  skip_newlines(tk,  n,  pi,  err)
  return 0

def mir_for(darena: var array[65536, int],  dasp: var array[1, int], src: var ptr,  tk: var array[262144, int],  ts: var array[262144, int], te: var array[262144, int],  n: var array[1, int],  pi: var array[1, int], err: var array[1, int],  tc: var array[1, int],  lastop: var array[1, int], ftok: var array[4096, int],  nft: var array[1, int], ftmp: var array[32768, int],  itok: var array[4096, int],  nit: var array[1, int], itmp: var array[4096, int],  fatok: var array[512, int],  nfa: var array[1, int], matok: var array[512, int],  nmat: var array[1, int], ptok: var array[128, int],  pex: var array[128, int], pp0: var array[128, int],  ppn: var array[128, int], pret: var array[128, int],  pn: var array[1, int], ptok2: var array[512, int],  pty: var array[512, int], pelems: var array[512, int],  pef: var array[512, int], pei: var array[512, int],  pvar: var array[512, int], retf_proc: int,  reti64_proc: int, lhead: var array[32, int],  lexit: var array[32, int],  nlp: var array[1, int]) -> int
