            if accept_k(tk, n, pi, err, 55) == 1:
              done = 0
            else:
              done = 1
        expect_k(tk, n, pi, err, 50)
      continue
    break
  return t

# ---- statement walker (checks return types; consumes tokens) ----
def tc_stmt(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], cur_ret: var array[1, int], sym_s: var array[256, int], sym_kind: var array[256, int], sym_ty: var array[256, int], sym_aux: var array[256, int], sym_n: var array[1, int]) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  var k: int = cur_kind(tk, n, pi, err)
  if k == 20:
    pi[0] = pi[0] + 1
    if cur_kind(tk, n, pi, err) != 4:
      err[0] = 1
      return 1
    var nm: int = pi[0]
