=
  li_rt_mir_str("INS")
  li_rt_ast_space()
  li_rt_ast_int(op)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_mir_str("__li_o_")
  li_rt_mir_esc(src, base_s, base_e)
  # 5 empty name cells
  li_rt_ast_space()
  li_rt_ast_space()
  li_rt_ast_space()
  li_rt_ast_space()
  li_rt_ast_space()
  # f18..f21
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(1)
  # name cell 6 (empty)
  li_rt_ast_space()
  # f25..f36
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(1)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
