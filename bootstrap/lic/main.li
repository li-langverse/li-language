                        var af_isvar: int = 0
                        var af_pid: int = peek32768(ftmp, 4090)
                        if aci > 0:
                          var af_pc: int = li_rt_preg_get(2, af_pid) + aci
                          if li_rt_preg_get(6, af_pc) == 6:
                            var af_oiv: int = li_rt_preg_get(10, af_pc)
                            if af_oiv >= 1000:
