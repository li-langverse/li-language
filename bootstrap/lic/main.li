  tc[0] = hd + 1
  var ex: int = tc[0]
  tc[0] = ex + 1
  set32(lhead, nlp[0],hd)
  set32(lexit, nlp[0],ex)
  nlp[0] = nlp[0] + 1
  mir_emit_jump_label(src,  lastop,  43,  3,  hd)
  var crec: int = mir_parse_expr(darena,  dasp,  src,  tk,  ts,  te,  n,  pi,  err, 0)
  if crec < 0:
    return 1
  if mir_lower_cond(darena,  dasp,  crec,  src,  tk,  ts,  te,  n,  pi,  err,  tc,  lastop, ftok,  nft,  ftmp,  itok,  nit,  itmp,  fatok,  nfa, matok,  nmat, ptok,  pex,  pp0,  ppn,  pret,  pn,  ptok2,  pty,  pelems,  pef, pei,  pvar) == 1:
    return 1
  expect_k(tk,  n,  pi,  err, 56)
  var fb: array[44, int]
  mir_fdef(fb)
  fb[0] = peek65536(darena, crec + 2)
  fb[1] = 0
  fb[2] = 2
  fb[15] = ex
  fb[16] = 4
  fb[17] = 2
  mir_ins_line(src,  fb,  45,  0,  -1,  lastop)
  if mir_stmts(darena,  dasp,  src,  tk,  ts,  te,  n,  pi,  err,  tc,  lastop, ftok,  nft,  ftmp,  itok,  nit,  itmp,  fatok,  nfa, matok,  nmat, ptok,  pex,  pp0,  ppn,  pret,  pn,  ptok2,  pty,  pelems,  pef, pei,  pvar,  retf_proc,  reti64_proc,  lhead,  lexit,  nlp) == 1:
    return 1
