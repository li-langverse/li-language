def parse_trait_method(src: var ptr, tk: var array[65536, int], ts: var array[65536, int], te: var array[65536, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], d: int) -> int
  requires true
  ensures result == 1
  decreases 0
=
  var vis: int = 0
  if cur_kind(tk, n, pi, err) == 16:
    vis = 1
    pi[0] = pi[0] + 1
  else:
    if cur_kind(tk, n, pi, err) == 17:
      pi[0] = pi[0] + 1
  if cur_kind(tk, n, pi, err) == 10:
    pi[0] = pi[0] + 1
  else:
    if cur_kind(tk, n, pi, err) == 9:
      err[0] = 1
      pi[0] = pi[0] + 1
      return 1
    err[0] = 1
    return 1
  var tn: int = pi[0]
  pi[0] = pi[0] + 1
  if d == 1:
    a_line_text_iii(d, src, 4, peek_tk(ts, tn + 0), peek_tk(te, tn + 0), vis, 0, 0)
  expect_k(tk, n, pi, err, 49)
  skip_param_layout(tk, n, pi, err)
  if cur_kind(tk, n, pi, err) != 50:
    var done: int = 0
    while done == 0:
      parse_param(src, tk, ts, te, n, pi, err, d)
      skip_param_layout(tk, n, pi, err)
      if accept_k(tk, n, pi, err, 55) == 1:
        done = 0
      else:
        done = 1
  skip_param_layout(tk, n, pi, err)
  expect_k(tk, n, pi, err, 50)
  if accept_k(tk, n, pi, err, 57) == 1:
    parse_type(src, tk, ts, te, n, pi, err, d)
  skip_newlines(tk, n, pi, err)
  while 1 == 1:
    var ck: int = cur_kind(tk, n, pi, err)
    if ck == 41:
      parse_contract(src, tk, ts, te, n, pi, err, d)
      continue
    if ck == 42:
      parse_contract(src, tk, ts, te, n, pi, err, d)
      continue
    if ck == 43:
      parse_contract(src, tk, ts, te, n, pi, err, d)
      continue
    if ck == 44:
      parse_contract(src, tk, ts, te, n, pi, err, d)
      continue
    if ck == 45:
      parse_contract(src, tk, ts, te, n, pi, err, d)
      continue
    break
  skip_newlines(tk, n, pi, err)
  return 1

def parse_trait_methods(src: var ptr, tk: var array[65536, int], ts: var array[65536, int], te: var array[65536, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], d: int) -> int
  requires true
  ensures result == 1
  decreases 0
=
  skip_newlines(tk, n, pi, err)
  while 1 == 1:
    var k: int = cur_kind(tk, n, pi, err)
    if k == 16:
      parse_trait_method(src, tk, ts, te, n, pi, err, d)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 17:
      parse_trait_method(src, tk, ts, te, n, pi, err, d)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 10:
      parse_trait_method(src, tk, ts, te, n, pi, err, d)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 9:
      parse_trait_method(src, tk, ts, te, n, pi, err, d)
      skip_newlines(tk, n, pi, err)
      continue
    break
  return 1

def parse_type_fields(src: var ptr, tk: var array[65536, int], ts: var array[65536, int], te: var array[65536, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], d: int) -> int
  requires true
  ensures result == 1
  decreases 0
=
  skip_newlines(tk, n, pi, err)
  while 1 == 1:
    var k: int = cur_kind(tk, n, pi, err)
    if k != 16:
      if k != 17:
        if k != 4:
          break
        if peek_off(tk, n, pi, 1) != 56:
          break
    if k == 16:
      if peek_off(tk, n, pi, 1) == 10:
        break
    if k == 17:
      if peek_off(tk, n, pi, 1) == 10:
        break
    var vis: int = 0
    if k == 16:
      vis = 1
      pi[0] = pi[0] + 1
    else:
      if k == 17:
        pi[0] = pi[0] + 1
    if cur_kind(tk, n, pi, err) != 4:
      err[0] = 1
      break
    var fn: int = pi[0]
    pi[0] = pi[0] + 1
    expect_k(tk, n, pi, err, 56)
    # NotRequired[T] unwraps to T with optional=1 (mirrors the C++
    # parse_type_fields post-processing); a leading `var` on the outer type
    # is dropped exactly like the C++ unwrap of the first type argument.
    var opt: int = 0
    var is_nr: int = 0
    var pi0: int = pi[0]
    if cur_kind(tk, n, pi, err) == 20:
      pi0 = pi[0] + 1
    if peek_off(tk, n, pi, pi0 - pi[0]) == 4:
      if peek_off(tk, n, pi, pi0 - pi[0] + 1) == 51:
        if tok_is(src, ts, te, pi0, "NotRequired") == 1:
          is_nr = 1
          opt = 1
    if d == 1:
      a_line_text_ii(d, src, 27, peek_tk(ts, fn), peek_tk(te, fn), opt, vis)
    if is_nr == 1:
      if cur_kind(tk, n, pi, err) == 20:
        pi[0] = pi[0] + 1
      pi[0] = pi[0] + 1
      pi[0] = pi[0] + 1
      opt = 1
      parse_type(src, tk, ts, te, n, pi, err, d)
      while cur_kind(tk, n, pi, err) != 52:
        if accept_k(tk, n, pi, err, 55) == 1:
          parse_type(src, tk, ts, te, n, pi, err, 0)
        else:
          break
      expect_k(tk, n, pi, err, 52)
    else:
      parse_type(src, tk, ts, te, n, pi, err, d)
    skip_newlines(tk, n, pi, err)
  return 1

def emit_tp_lines(d: int, src: var ptr, ts: var array[65536, int], te: var array[65536, int], tbuf: var array[16, int], ntp: var array[1, int]) -> int
  requires true
  ensures result == 0
  decreases 0
=
  var ti: int = 0
  while ti < ntp[0]:
    if d == 1:
      a_line_text_t(d, src, 5, peek_tk(ts, tbuf[ti] + 0), peek_tk(te, tbuf[ti] + 0))
    ti = ti + 1
  return 0

def parse_type_alias(src: var ptr, tk: var array[65536, int], ts: var array[65536, int], te: var array[65536, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], d: int) -> int
  requires true
  ensures result == 1
  decreases 0
=
  expect_k(tk, n, pi, err, 11)
  var an: int = pi[0]
  pi[0] = pi[0] + 1
  var tbuf: array[16, int]
  var ntp: array[1, int]
  ntp[0] = 0
  if accept_k(tk, n, pi, err, 51) == 1:
    if cur_kind(tk, n, pi, err) != 52:
      var done: int = 0
      while done == 0:
        if cur_kind(tk, n, pi, err) != 4:
          err[0] = 1
          break
        tbuf[ntp[0]] = pi[0]
        ntp[0] = ntp[0] + 1
        pi[0] = pi[0] + 1
        if accept_k(tk, n, pi, err, 56) == 1:
          if cur_kind(tk, n, pi, err) != 4:
            err[0] = 1
          else:
            pi[0] = pi[0] + 1
        if accept_k(tk, n, pi, err, 55) == 1:
          done = 0
        else:
          done = 1
    expect_k(tk, n, pi, err, 52)
  expect_k(tk, n, pi, err, 58)
  skip_newlines(tk, n, pi, err)
  if cur_kind(tk, n, pi, err) == 4:
    if tok_is(src, ts, te, pi[0], "typedict") == 1:
      pi[0] = pi[0] + 1
      if d == 1:
        a_line_text_i_text(d, src, 80, peek_tk(ts, an + 0), peek_tk(te, an + 0), 1, 0, 0)
      emit_tp_lines(d, src, ts, te, tbuf, ntp)
      skip_newlines(tk, n, pi, err)
      parse_type_fields(src, tk, ts, te, n, pi, err, d)
      skip_newlines(tk, n, pi, err)
      return 1
  if cur_kind(tk, n, pi, err) == 19:
    pi[0] = pi[0] + 1
    if d == 1:
      a_line_text_i_text(d, src, 80, peek_tk(ts, an + 0), peek_tk(te, an + 0), 2, 0, 0)
    emit_tp_lines(d, src, ts, te, tbuf, ntp)
    skip_newlines(tk, n, pi, err)
    while cur_kind(tk, n, pi, err) == 4:
      if tok_is(src, ts, te, pi[0], "proc") == 1:
        break
      if tok_is(src, ts, te, pi[0], "def") == 1:
        break
      if tok_is(src, ts, te, pi[0], "type") == 1:
        break
      if tok_is(src, ts, te, pi[0], "import") == 1:
        break
      if d == 1:
        a_line_text(d, src, 81, peek_tk(ts, pi[0]), peek_tk(te, pi[0]))
      pi[0] = pi[0] + 1
      skip_newlines(tk, n, pi, err)
    return 1
  if cur_kind(tk, n, pi, err) == 4:
    if tok_is(src, ts, te, pi[0], "trait") == 1:
      pi[0] = pi[0] + 1
      if d == 1:
        a_line_text_i_text(d, src, 80, peek_tk(ts, an + 0), peek_tk(te, an + 0), 4, 0, 0)
      emit_tp_lines(d, src, ts, te, tbuf, ntp)
      skip_newlines(tk, n, pi, err)
      parse_trait_methods(src, tk, ts, te, n, pi, err, d)
      skip_newlines(tk, n, pi, err)
      return 1
  if cur_kind(tk, n, pi, err) == 15:
    pi[0] = pi[0] + 1
    skip_newlines(tk, n, pi, err)
    var base_t: int = -1
    if cur_kind(tk, n, pi, err) == 4:
      if tok_is(src, ts, te, pi[0], "of") == 1:
        pi[0] = pi[0] + 1
        if cur_kind(tk, n, pi, err) != 4:
          err[0] = 1
        else:
          base_t = pi[0]
          pi[0] = pi[0] + 1
        skip_newlines(tk, n, pi, err)
    if d == 1:
      if base_t >= 0:
        a_line_text_i_text(d, src, 80, peek_tk(ts, an + 0), peek_tk(te, an + 0), 3, peek_tk(ts, base_t + 0), peek_tk(te, base_t + 0))
      else:
        a_line_text_i_text(d, src, 80, peek_tk(ts, an + 0), peek_tk(te, an + 0), 3, 0, 0)
    emit_tp_lines(d, src, ts, te, tbuf, ntp)
    parse_type_fields(src, tk, ts, te, n, pi, err, d)
    skip_newlines(tk, n, pi, err)
    return 1
  if d == 1:
    a_line_text_i_text(d, src, 80, peek_tk(ts, an + 0), peek_tk(te, an + 0), 0, 0, 0)
  emit_tp_lines(d, src, ts, te, tbuf, ntp)
  parse_type(src, tk, ts, te, n, pi, err, d)
  skip_newlines(tk, n, pi, err)
  return 1

def parse_module(src: var ptr, tk: var array[65536, int], ts: var array[65536, int], te: var array[65536, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], d: int) -> int
  requires true
  ensures result == 1
  decreases 0
=
  skip_newlines(tk, n, pi, err)
  while 1 == 1:
    var k: int = cur_kind(tk, n, pi, err)
    if k == 0:
      break
    if k == 18:
      parse_import(src, tk, ts, te, n, pi, err, d)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 32:
      pi[0] = pi[0] + 1
      var k2: int = cur_kind(tk, n, pi, err)
      if k2 == 10:
        pi[0] = pi[0] + 1
      else:
        if k2 == 9:
          err[0] = 1
          li_rt_emit_err(900)
          pi[0] = pi[0] + 1
        else:
          err[0] = 1
          return 1
      parse_proc(src, tk, ts, te, n, pi, err, 1, 0, d, 0)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 33:
      pi[0] = pi[0] + 1
      parse_proc(src, tk, ts, te, n, pi, err, 0, 1, d, 0)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 76:
      var save0: int = pi[0]
      parse_decorator_list(src, tk, ts, te, n, pi, err, 0)
      var dpos: int = pi[0]
      if at_fn_kw(tk, n, pi, err) == 0:
        err[0] = 1
        return 1
      var dvis: int = 0
      var dk: int = cur_kind(tk, n, pi, err)
      if dk == 16:
        dvis = 1
      if d == 1:
        var nm: int = dpos + 1
        if dk == 16:
          nm = dpos + 2
        if dk == 17:
          nm = dpos + 2
        a_line_text_iii(d, src, 4, peek_tk(ts, nm + 0), peek_tk(te, nm + 0), dvis, 0, 0)
      pi[0] = save0
      parse_decorator_list(src, tk, ts, te, n, pi, err, d)
      pi[0] = dpos
      parse_proc(src, tk, ts, te, n, pi, err, 0, 0, d, 1)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 16:
      if peek_off(tk, n, pi, 1) == 10:
        parse_proc(src, tk, ts, te, n, pi, err, 0, 0, d, 0)
        skip_newlines(tk, n, pi, err)
        continue
      err[0] = 1
      return 1
    if k == 17:
      if peek_off(tk, n, pi, 1) == 10:
        parse_proc(src, tk, ts, te, n, pi, err, 0, 0, d, 0)
        skip_newlines(tk, n, pi, err)
        continue
      err[0] = 1
      return 1
    if k == 10:
      parse_proc(src, tk, ts, te, n, pi, err, 0, 0, d, 0)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 9:
      err[0] = 1
      li_rt_emit_err(900)
      li_rt_emit_err(900)
      pi[0] = pi[0] + 1
      skip_newlines(tk, n, pi, err)
      continue
    if k == 11:
      parse_type_alias(src, tk, ts, te, n, pi, err, d)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 29:
      parse_error_decl(src, tk, ts, te, n, pi, err, d)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 12:
      pi[0] = pi[0] + 1
      parse_theorem(src, tk, ts, te, n, pi, err, 1, 0, d)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 13:
      pi[0] = pi[0] + 1
      parse_theorem(src, tk, ts, te, n, pi, err, 0, 0, d)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 14:
      pi[0] = pi[0] + 1
      parse_theorem(src, tk, ts, te, n, pi, err, 0, 1, d)
      skip_newlines(tk, n, pi, err)
      continue
    err[0] = 1
    return 1
  return 1

# -------------------------------------------------- Layer 4: typechecker --
# `check <file>` is the first slice of the self-hosted typechecker. It walks
# the token stream a second time (the parser already validated structure) and
# enforces the rules the C++ typechecker applies to the typecheck + generics
# corpus:
#   - name resolution: calls to unknown procs, arity, unknown idents
#   - type unification: binop numeric mixing (int+float, int32+int64),
#     return-type match (incl. generic params)
#   - contract well-formedness: E0301/E0302 requires/ensures presence, E0303
#     `ensures true` on a value-returning non-extern proc
# Verdict parity (exit 0/1) is gated by scripts/check_li_check_parity.sh.
#
# Type codes: 0 int, 1 float, 2 str, 3 bool, 4 binary, 5 ptr, 6 unit,
# 7 array, 8 tuple, 9 protocol, 10 callable, 11 typedict, 12 refinement,
# 13 generic, 14 unknown.
#
# Symbol table is threaded as parameters (Li has no module-level vars):
#   sym_s/sym_e: name token indices; sym_kind: 0=type,1=proc,2=param,3=local
#   sym_ty: type code (proc: return type; alias: kind)
#   sym_aux: proc arity / (unused); sym_n: count

# ---- type-name classification (returns a type code, or 14 unknown) ----
def tc_prim_type(src: var ptr, ts: var array[65536, int], te: var array[65536, int], i: int) -> int
  requires true
  ensures result >= 0
  decreases 0
=
  if tok_is(src, ts, te, i, "int") == 1:
    return 0
  if tok_is(src, ts, te, i, "int64") == 1:
    return 0
  if tok_is(src, ts, te, i, "float") == 1:
    return 1
  if tok_is(src, ts, te, i, "float64") == 1:
    return 1
  if tok_is(src, ts, te, i, "str") == 1:
    return 2
  if tok_is(src, ts, te, i, "bool") == 1:
    return 3
  if tok_is(src, ts, te, i, "binary") == 1:
    return 4
  if tok_is(src, ts, te, i, "ptr") == 1:
    return 5
  if tok_is(src, ts, te, i, "unit") == 1:
    return 6
  if tok_is(src, ts, te, i, "tuple") == 1:
    return 8
  if tok_is(src, ts, te, i, "array") == 1:
    return 7
  if tok_is(src, ts, te, i, "int32") == 1:
    return 15
  if tok_is(src, ts, te, i, "uint8") == 1:
    return 16
  if tok_is(src, ts, te, i, "float32") == 1:
    return 17
  if tok_is(src, ts, te, i, "float8") == 1:
    return 18
  return 14

# Numeric family: 0 = int-family, 1 = float-family, -1 = not numeric.
def tc_family_of(t: int) -> int
  requires true
  ensures result >= -1
  decreases 0
=
  if t == 0:
    return 0
  if t == 15:
    return 0
  if t == 16:
    return 0
  if t == 1:
    return 1
  if t == 17:
    return 1
  if t == 18:
    return 1
  return -1

def tc_is_int(t: int) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  if t == 0:
    return 1
  if t == 15:
    return 1
  if t == 16:
    return 1
  return 0

def tc_is_float(t: int) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  if t == 1:
    return 1
  if t == 17:
    return 1
  if t == 18:
    return 1
  return 0

def tc_is_unsigned(t: int) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  if t == 16:
    return 1
  return 0

def tc_bits(t: int) -> int
  requires true
  ensures result >= -1
  decreases 0
=
  if t == 0:
    return 64
  if t == 1:
    return 64
  if t == 15:
    return 32
  if t == 16:
    return 8
  if t == 17:
    return 32
  if t == 18:
    return 8
  return -1

# ---- type parsing (returns a type code; consumes tokens) ----
def tc_parse_type(src: var ptr, tk: var array[65536, int], ts: var array[65536, int], te: var array[65536, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], sym_s: var array[256, int], sym_kind: var array[256, int], sym_ty: var array[256, int], sym_n: var array[1, int]) -> int
  requires true
  ensures result >= 0
  decreases 0
=
  if cur_kind(tk, n, pi, err) == 53:
    pi[0] = pi[0] + 1
    if cur_kind(tk, n, pi, err) != 4:
      err[0] = 1
      return 14
    pi[0] = pi[0] + 1
    expect_k(tk, n, pi, err, 56)
    var bt: int = tc_parse_type(src, tk, ts, te, n, pi, err, sym_s, sym_kind, sym_ty, sym_n)
    expect_k(tk, n, pi, err, 74)
    parse_contract_expr(src, tk, ts, te, n, pi, err, 0)
    expect_k(tk, n, pi, err, 54)
    return bt
  if cur_kind(tk, n, pi, err) == 20:
    pi[0] = pi[0] + 1
  if cur_kind(tk, n, pi, err) == 47:
    pi[0] = pi[0] + 1
    return 9
  if cur_kind(tk, n, pi, err) == 48:
    pi[0] = pi[0] + 1
    if accept_k(tk, n, pi, err, 51) == 1:
      if accept_k(tk, n, pi, err, 51) == 0:
        err[0] = 1
        return 14
      if cur_kind(tk, n, pi, err) != 52:
        var done: int = 0
        while done == 0:
          tc_parse_type(src, tk, ts, te, n, pi, err, sym_s, sym_kind, sym_ty, sym_n)
          if accept_k(tk, n, pi, err, 55) == 1:
            done = 0
          else:
            done = 1
      expect_k(tk, n, pi, err, 52)
      expect_k(tk, n, pi, err, 55)
      tc_parse_type(src, tk, ts, te, n, pi, err, sym_s, sym_kind, sym_ty, sym_n)
      expect_k(tk, n, pi, err, 52)
    return 10
  if cur_kind(tk, n, pi, err) != 4:
    err[0] = 1
    return 14
  var t0: int = pi[0]
  pi[0] = pi[0] + 1
  var base: int = tc_prim_type(src, ts, te, t0)
  if base == 7:
    if accept_k(tk, n, pi, err, 51) == 1:
      var sz: int = -1
      if cur_kind(tk, n, pi, err) == 5:
        sz = int_text_value(src, ts, te, pi[0])
        pi[0] = pi[0] + 1
      else:
        tc_parse_type(src, tk, ts, te, n, pi, err, sym_s, sym_kind, sym_ty, sym_n)
        expect_k(tk, n, pi, err, 55)
        tc_parse_type(src, tk, ts, te, n, pi, err, sym_s, sym_kind, sym_ty, sym_n)
        expect_k(tk, n, pi, err, 52)
        return 7
      expect_k(tk, n, pi, err, 55)
      tc_parse_type(src, tk, ts, te, n, pi, err, sym_s, sym_kind, sym_ty, sym_n)
      expect_k(tk, n, pi, err, 52)
      if sz >= 0:
        return 1000 + sz
      return 7
    return 7
  if base == 8:
    if accept_k(tk, n, pi, err, 51) == 1:
      if cur_kind(tk, n, pi, err) != 52:
        var done: int = 0
        while done == 0:
          tc_parse_type(src, tk, ts, te, n, pi, err, sym_s, sym_kind, sym_ty, sym_n)
          if accept_k(tk, n, pi, err, 55) == 1:
            done = 0
          else:
            done = 1
      expect_k(tk, n, pi, err, 52)
      return 8
    return 8
  if base != 14:
    return base
  # Named type alias, generic param, or object/enum name.
  var si: int = 0
  while si < sym_n[0]:
    if sym_kind[si] == 4:
      if tok_eq(src, ts, te, sym_s[si], t0) == 1:
        return 13
    si = si + 1
  si = 0
  while si < sym_n[0]:
    if sym_kind[si] == 0:
      if tok_eq(src, ts, te, sym_s[si], t0) == 1:
        var rt: int = sym_ty[si]
        if accept_k(tk, n, pi, err, 51) == 1:
          if cur_kind(tk, n, pi, err) != 52:
            var done: int = 0
            while done == 0:
              tc_parse_type(src, tk, ts, te, n, pi, err, sym_s, sym_kind, sym_ty, sym_n)
              if accept_k(tk, n, pi, err, 55) == 1:
                done = 0
              else:
                done = 1
          expect_k(tk, n, pi, err, 52)
        return rt
    si = si + 1
  # heap generic type app: list[T] / dict[K, V] / set[T] (consume the args)
  if tok_is(src, ts, te, t0, "list") == 1 or tok_is(src, ts, te, t0, "dict") == 1 or tok_is(src, ts, te, t0, "set") == 1:
    if accept_k(tk, n, pi, err, 51) == 1:
      if cur_kind(tk, n, pi, err) != 52:
        var done: int = 0
        while done == 0:
          tc_parse_type(src, tk, ts, te, n, pi, err, sym_s, sym_kind, sym_ty, sym_n)
          if accept_k(tk, n, pi, err, 55) == 1:
            done = 0
          else:
            done = 1
      expect_k(tk, n, pi, err, 52)
    return 19
  return 14

# Consume the RHS of a type alias (`= object | trait | enum | typedict | type`),
# mirroring parse_type_alias; returns the tc type code (14 for named/object).
def tc_skip_alias_rhs(src: var ptr, tk: var array[65536, int], ts: var array[65536, int], te: var array[65536, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], sym_s: var array[256, int], sym_kind: var array[256, int], sym_ty: var array[256, int], sym_n: var array[1, int]) -> int
  requires true
  ensures result >= 0
  decreases 0
=
  skip_newlines(tk, n, pi, err)
  if cur_kind(tk, n, pi, err) == 47:
    pi[0] = pi[0] + 1
    return 9
  if cur_kind(tk, n, pi, err) == 4:
    if tok_is(src, ts, te, pi[0], "typedict") == 1:
      pi[0] = pi[0] + 1
      skip_newlines(tk, n, pi, err)
      parse_type_fields(src, tk, ts, te, n, pi, err, 0)
      return 14
  if cur_kind(tk, n, pi, err) == 19:
    pi[0] = pi[0] + 1
    skip_newlines(tk, n, pi, err)
    while cur_kind(tk, n, pi, err) == 4:
      if tok_is(src, ts, te, pi[0], "proc") == 1:
        break
      if tok_is(src, ts, te, pi[0], "def") == 1:
        break
      if tok_is(src, ts, te, pi[0], "type") == 1:
        break
      if tok_is(src, ts, te, pi[0], "import") == 1:
        break
      pi[0] = pi[0] + 1
      skip_newlines(tk, n, pi, err)
    return 14
  if cur_kind(tk, n, pi, err) == 4:
    if tok_is(src, ts, te, pi[0], "trait") == 1:
      pi[0] = pi[0] + 1
      skip_newlines(tk, n, pi, err)
      parse_trait_methods(src, tk, ts, te, n, pi, err, 0)
      return 14
  if cur_kind(tk, n, pi, err) == 15:
    pi[0] = pi[0] + 1
    skip_newlines(tk, n, pi, err)
    if cur_kind(tk, n, pi, err) == 4:
      if tok_is(src, ts, te, pi[0], "of") == 1:
        pi[0] = pi[0] + 1
        if cur_kind(tk, n, pi, err) == 4:
          pi[0] = pi[0] + 1
        skip_newlines(tk, n, pi, err)
    parse_type_fields(src, tk, ts, te, n, pi, err, 0)
    return 14
  return tc_parse_type(src, tk, ts, te, n, pi, err, sym_s, sym_kind, sym_ty, sym_n)

# ---- symbol lookups ----
def tc_find_proc(src: var ptr, ts: var array[65536, int], te: var array[65536, int], sym_s: var array[256, int], sym_kind: var array[256, int], sym_ty: var array[256, int], sym_n: var array[1, int], i: int) -> int
  requires true
  ensures result >= -1
  decreases 0
=
  var k: int = 0
  while k < sym_n[0]:
    if sym_kind[k] == 1:
      if tok_eq(src, ts, te, sym_s[k], i) == 1:
        return sym_ty[k]
    k = k + 1
  return -1

def tc_proc_arity(src: var ptr, ts: var array[65536, int], te: var array[65536, int], sym_s: var array[256, int], sym_kind: var array[256, int], sym_aux: var array[256, int], sym_n: var array[1, int], i: int) -> int
  requires true
  ensures result >= -1
  decreases 0
=
  var k: int = 0
  while k < sym_n[0]:
    if sym_kind[k] == 1:
      if tok_eq(src, ts, te, sym_s[k], i) == 1:
        return sym_aux[k]
    k = k + 1
  return -1

def tc_local_type(src: var ptr, ts: var array[65536, int], te: var array[65536, int], sym_s: var array[256, int], sym_kind: var array[256, int], sym_ty: var array[256, int], sym_n: var array[1, int], i: int) -> int
  requires true
  ensures result >= -1
  decreases 0
=
  var k: int = 0
  var best_ty: int = -1
  while k < sym_n[0]:
    if sym_kind[k] == 2 or sym_kind[k] == 3:
      if tok_eq(src, ts, te, sym_s[k], i) == 1:
        best_ty = sym_ty[k]
    k = k + 1
  return best_ty

# ---- expression type inference (returns a type code; consumes tokens) ----
def tc_expr(src: var ptr, tk: var array[65536, int], ts: var array[65536, int], te: var array[65536, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], min_prec: int, sym_s: var array[256, int], sym_kind: var array[256, int], sym_ty: var array[256, int], sym_aux: var array[256, int], sym_n: var array[1, int]) -> int
  requires true
  ensures result >= 0
  decreases 0
=
  var lt: int = tc_primary(src, tk, ts, te, n, pi, err, sym_s, sym_kind, sym_ty, sym_aux, sym_n)
  while 1 == 1:
    var p: int = prec_of(cur_kind(tk, n, pi, err))
    if p < 0:
      break
    if p < min_prec:
      break
    var opk: int = cur_kind(tk, n, pi, err)
    pi[0] = pi[0] + 1
    var rt: int = tc_expr(src, tk, ts, te, n, pi, err, p + 1, sym_s, sym_kind, sym_ty, sym_aux, sym_n)
    lt = tc_binop_type(lt, opk, rt, err)
  return lt

def tc_binop_type(l: int, opk: int, r: int, err: var array[1, int]) -> int
  requires true
  ensures result >= 0
  decreases 0
=
  # Comparisons and equality yield bool.
  if opk == 66 or opk == 67 or opk == 68 or opk == 69 or opk == 70 or opk == 71:
    return 3
  if tc_is_int(l) == 1:
    if tc_is_int(r) == 1:
      if tc_is_unsigned(l) != tc_is_unsigned(r):
        err[0] = 1
        li_rt_emit_err(900)
        return 0
      if tc_bits(l) != tc_bits(r):
        err[0] = 1
        li_rt_emit_err(900)
        return 0
      return l
  if tc_is_float(l) == 1:
    if tc_is_float(r) == 1:
      if tc_bits(l) != tc_bits(r):
        err[0] = 1
        li_rt_emit_err(900)
        return 1
      return l
  var lfam: int = tc_family_of(l)
  var rfam: int = tc_family_of(r)
  if lfam >= 0:
    if rfam >= 0:
      err[0] = 1
      li_rt_emit_err(900)
      return 0
  return 14

def tc_primary(src: var ptr, tk: var array[65536, int], ts: var array[65536, int], te: var array[65536, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], sym_s: var array[256, int], sym_kind: var array[256, int], sym_ty: var array[256, int], sym_aux: var array[256, int], sym_n: var array[1, int]) -> int
  requires true
  ensures result >= 0
  decreases 0
=
  var k: int = cur_kind(tk, n, pi, err)
  if k == 60:
    pi[0] = pi[0] + 1
    return tc_primary(src, tk, ts, te, n, pi, err, sym_s, sym_kind, sym_ty, sym_aux, sym_n)
  if k == 34:
    pi[0] = pi[0] + 1
    return tc_primary(src, tk, ts, te, n, pi, err, sym_s, sym_kind, sym_ty, sym_aux, sym_n)
  if k == 5:
    pi[0] = pi[0] + 1
    return tc_postfix(src, tk, ts, te, n, pi, err, 0, sym_s, sym_kind, sym_ty, sym_aux, sym_n)
  if k == 6:
    pi[0] = pi[0] + 1
    return tc_postfix(src, tk, ts, te, n, pi, err, 1, sym_s, sym_kind, sym_ty, sym_aux, sym_n)
  if k == 7:
    pi[0] = pi[0] + 1
    return tc_postfix(src, tk, ts, te, n, pi, err, 4, sym_s, sym_kind, sym_ty, sym_aux, sym_n)
  if k == 8:
    pi[0] = pi[0] + 1
    return tc_postfix(src, tk, ts, te, n, pi, err, 2, sym_s, sym_kind, sym_ty, sym_aux, sym_n)
  if k == 35:
    pi[0] = pi[0] + 1
    return tc_postfix(src, tk, ts, te, n, pi, err, 3, sym_s, sym_kind, sym_ty, sym_aux, sym_n)
  if k == 36:
    pi[0] = pi[0] + 1
    return tc_postfix(src, tk, ts, te, n, pi, err, 3, sym_s, sym_kind, sym_ty, sym_aux, sym_n)
  if k == 4 or k == 46:
    var id0: int = pi[0]
    pi[0] = pi[0] + 1
    if accept_k(tk, n, pi, err, 49) == 1:
      if tok_is(src, ts, te, id0, "print") == 1:
        if cur_kind(tk, n, pi, err) != 50:
          var done: int = 0
          while done == 0:
            tc_expr(src, tk, ts, te, n, pi, err, 0, sym_s, sym_kind, sym_ty, sym_aux, sym_n)
            if accept_k(tk, n, pi, err, 55) == 1:
              done = 0
            else:
              done = 1
        expect_k(tk, n, pi, err, 50)
        return 0
      var callee: int = tc_find_proc(src, ts, te, sym_s, sym_kind, sym_ty, sym_n, id0)
      var carity: int = tc_proc_arity(src, ts, te, sym_s, sym_kind, sym_aux, sym_n, id0)
      var argc: int = 0
      if cur_kind(tk, n, pi, err) != 50:
        var done: int = 0
        while done == 0:
          tc_expr(src, tk, ts, te, n, pi, err, 0, sym_s, sym_kind, sym_ty, sym_aux, sym_n)
          argc = argc + 1
          if accept_k(tk, n, pi, err, 55) == 1:
            done = 0
          else:
            done = 1
      expect_k(tk, n, pi, err, 50)
      if callee >= 0:
        if argc != carity:
          err[0] = 1
          li_rt_emit_err(202)
        return callee
      err[0] = 1
      li_rt_emit_err(202)
      return 14
    var lt: int = tc_local_type(src, ts, te, sym_s, sym_kind, sym_ty, sym_n, id0)
    if lt < 0:
      lt = 14
    return tc_postfix(src, tk, ts, te, n, pi, err, lt, sym_s, sym_kind, sym_ty, sym_aux, sym_n)
  if accept_k(tk, n, pi, err, 49) == 1:
    var it: int = tc_expr(src, tk, ts, te, n, pi, err, 0, sym_s, sym_kind, sym_ty, sym_aux, sym_n)
    expect_k(tk, n, pi, err, 50)
    return tc_postfix(src, tk, ts, te, n, pi, err, it, sym_s, sym_kind, sym_ty, sym_aux, sym_n)
  err[0] = 1
  return 14

def tc_postfix(src: var ptr, tk: var array[65536, int], ts: var array[65536, int], te: var array[65536, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], t: int, sym_s: var array[256, int], sym_kind: var array[256, int], sym_ty: var array[256, int], sym_aux: var array[256, int], sym_n: var array[1, int]) -> int
  requires true
  ensures result >= 0
  decreases 0
=
  while 1 == 1:
    if accept_k(tk, n, pi, err, 51) == 1:
      var ik: int = cur_kind(tk, n, pi, err)
      var iv: int = 0
      if ik == 5:
        iv = int_text_value(src, ts, te, pi[0])
      tc_expr(src, tk, ts, te, n, pi, err, 0, sym_s, sym_kind, sym_ty, sym_aux, sym_n)
      expect_k(tk, n, pi, err, 52)
      if t >= 1000:
        if ik == 5:
          if iv >= t - 1000:
            err[0] = 1
            li_rt_emit_err(201)
      t = 14
      continue
    if accept_k(tk, n, pi, err, 72) == 1:
      if cur_kind(tk, n, pi, err) != 4:
        err[0] = 1
        return 14
      pi[0] = pi[0] + 1
      if accept_k(tk, n, pi, err, 49) == 1:
        if cur_kind(tk, n, pi, err) != 50:
          var done: int = 0
          while done == 0:
            tc_expr(src, tk, ts, te, n, pi, err, 0, sym_s, sym_kind, sym_ty, sym_aux, sym_n)
            if accept_k(tk, n, pi, err, 55) == 1:
              done = 0
            else:
              done = 1
        expect_k(tk, n, pi, err, 50)
      continue
    break
  return t

# ---- statement walker (checks return types; consumes tokens) ----
def tc_stmt(src: var ptr, tk: var array[65536, int], ts: var array[65536, int], te: var array[65536, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], cur_ret: var array[1, int], sym_s: var array[256, int], sym_kind: var array[256, int], sym_ty: var array[256, int], sym_aux: var array[256, int], sym_n: var array[1, int]) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  var k: int = cur_kind(tk, n, pi, err)
  if k == 20:
    pi[0] = pi[0] + 1
    if cur_kind(tk, n, pi, err) != 4:
      err[0] = 1
      return 1
    var nm: int = pi[0]
    pi[0] = pi[0] + 1
    expect_k(tk, n, pi, err, 56)
    var vt: int = tc_parse_type(src, tk, ts, te, n, pi, err, sym_s, sym_kind, sym_ty, sym_n)
    tc_record_local(src, ts, te, sym_s, sym_kind, sym_ty, sym_n, nm, vt)
    if accept_k(tk, n, pi, err, 58) == 1:
      var it: int = tc_expr(src, tk, ts, te, n, pi, err, 0, sym_s, sym_kind, sym_ty, sym_aux, sym_n)
      if vt == 9:
        if it != 7:
          if it < 1000:
            err[0] = 1
            li_rt_emit_err(900)
    return 1
  if k == 30:
    pi[0] = pi[0] + 1
    if cur_kind(tk, n, pi, err) != 1:
      var rt: int = tc_expr(src, tk, ts, te, n, pi, err, 0, sym_s, sym_kind, sym_ty, sym_aux, sym_n)
      if cur_ret[0] >= 0:
        if rt != cur_ret[0]:
          if rt != 14:
            if cur_ret[0] != 14:
              err[0] = 1
              if rt == 13:
                li_rt_emit_err(202)
              else:
                if cur_ret[0] == 13:
                  li_rt_emit_err(202)
                else:
                  li_rt_emit_err(900)
    return 1
  if k == 22:
    pi[0] = pi[0] + 1
    tc_expr(src, tk, ts, te, n, pi, err, 0, sym_s, sym_kind, sym_ty, sym_aux, sym_n)
    expect_k(tk, n, pi, err, 56)
    skip_newlines(tk, n, pi, err)
    tc_block(src, tk, ts, te, n, pi, err, cur_ret, sym_s, sym_kind, sym_ty, sym_aux, sym_n)
    while cur_kind(tk, n, pi, err) == 24:
      pi[0] = pi[0] + 1
      tc_expr(src, tk, ts, te, n, pi, err, 0, sym_s, sym_kind, sym_ty, sym_aux, sym_n)
      expect_k(tk, n, pi, err, 56)
      skip_newlines(tk, n, pi, err)
      tc_block(src, tk, ts, te, n, pi, err, cur_ret, sym_s, sym_kind, sym_ty, sym_aux, sym_n)
    if cur_kind(tk, n, pi, err) == 23:
      pi[0] = pi[0] + 1
      expect_k(tk, n, pi, err, 56)
      skip_newlines(tk, n, pi, err)
      tc_block(src, tk, ts, te, n, pi, err, cur_ret, sym_s, sym_kind, sym_ty, sym_aux, sym_n)
    return 1
  if k == 25:
    pi[0] = pi[0] + 1
    tc_expr(src, tk, ts, te, n, pi, err, 0, sym_s, sym_kind, sym_ty, sym_aux, sym_n)
    if cur_kind(tk, n, pi, err) == 56:
      pi[0] = pi[0] + 1
    skip_newlines(tk, n, pi, err)
    tc_block(src, tk, ts, te, n, pi, err, cur_ret, sym_s, sym_kind, sym_ty, sym_aux, sym_n)
    return 1
  if k == 26:
    pi[0] = pi[0] + 1
    tc_expr(src, tk, ts, te, n, pi, err, 0, sym_s, sym_kind, sym_ty, sym_aux, sym_n)
    skip_newlines(tk, n, pi, err)
    tc_block(src, tk, ts, te, n, pi, err, cur_ret, sym_s, sym_kind, sym_ty, sym_aux, sym_n)
    return 1
  if k == 49:
    pi[0] = pi[0] + 1
    tc_expr(src, tk, ts, te, n, pi, err, 0, sym_s, sym_kind, sym_ty, sym_aux, sym_n)
    expect_k(tk, n, pi, err, 50)
    return 1
  if k == 60:
    pi[0] = pi[0] + 1
    tc_expr(src, tk, ts, te, n, pi, err, 0, sym_s, sym_kind, sym_ty, sym_aux, sym_n)
    return 1
  tc_expr(src, tk, ts, te, n, pi, err, 0, sym_s, sym_kind, sym_ty, sym_aux, sym_n)
  if accept_k(tk, n, pi, err, 58) == 1:
    tc_expr(src, tk, ts, te, n, pi, err, 0, sym_s, sym_kind, sym_ty, sym_aux, sym_n)
  return 1

def tc_block(src: var ptr, tk: var array[65536, int], ts: var array[65536, int], te: var array[65536, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], cur_ret: var array[1, int], sym_s: var array[256, int], sym_kind: var array[256, int], sym_ty: var array[256, int], sym_aux: var array[256, int], sym_n: var array[1, int]) -> int
  requires true
  ensures result == 1
  decreases 0
=
  skip_newlines(tk, n, pi, err)
  if expect_k(tk, n, pi, err, 2) == 0:
    return 1
  skip_newlines(tk, n, pi, err)
  while 1 == 1:
    if cur_kind(tk, n, pi, err) == 3:
      break
    if cur_kind(tk, n, pi, err) == 0:
      break
    var before: int = pi[0]
    tc_stmt(src, tk, ts, te, n, pi, err, cur_ret, sym_s, sym_kind, sym_ty, sym_aux, sym_n)
    if pi[0] == before:
      err[0] = 1
      break
    skip_newlines(tk, n, pi, err)
  expect_k(tk, n, pi, err, 3)
  return 1

# ---- record a local/param type ----
def tc_record_local(src: var ptr, ts: var array[65536, int], te: var array[65536, int],
                    sym_s: var array[256, int], sym_kind: var array[256, int],
                    sym_ty: var array[256, int], sym_n: var array[1, int],
                    i: int, t: int) -> int
  requires true
  ensures result == 0
  decreases 0
=
  var k: int = 0
  while k < sym_n[0]:
    if sym_kind[k] == 3:
      if tok_eq(src, ts, te, sym_s[k], i) == 1:
        sym_ty[k] = t
        return 0
    k = k + 1
  var ni: int = sym_n[0]
  if ni < 256:
    sym_s[ni] = i
    sym_kind[ni] = 3
    sym_ty[ni] = t
    sym_n[0] = sym_n[0] + 1
  return 0

# ---- generic type params: record `[T, U, ...]` as kind 4 (type var) ----
def tc_record_type_params(tk: var array[65536, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], sym_s: var array[256, int], sym_kind: var array[256, int], sym_ty: var array[256, int], sym_n: var array[1, int]) -> int
  requires true
  ensures result == 1
  decreases 0
=
  if accept_k(tk, n, pi, err, 51) == 1:
    if cur_kind(tk, n, pi, err) != 52:
      var done: int = 0
      while done == 0:
        if cur_kind(tk, n, pi, err) != 4:
          err[0] = 1
          break
        var tp: int = sym_n[0]
        if tp < 256:
          sym_s[tp] = pi[0]
          sym_kind[tp] = 4
          sym_ty[tp] = 13        sym_n[0] = sym_n[0] + 1
        pi[0] = pi[0] + 1
        if accept_k(tk, n, pi, err, 56) == 1:
          if cur_kind(tk, n, pi, err) == 4:
            pi[0] = pi[0] + 1
          else:
            err[0] = 1
        if accept_k(tk, n, pi, err, 55) == 1:
          done = 0
        else:
          done = 1
    expect_k(tk, n, pi, err, 52)
  return 1




# ---- consume an optional `raises A, B, ...` clause ----
def tc_skip_raises(tk: var array[65536, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int]) -> int
  requires true
  ensures result == 1
  decreases 0
=
  skip_newlines(tk, n, pi, err)
  if cur_kind(tk, n, pi, err) == 31:
    pi[0] = pi[0] + 1
    if cur_kind(tk, n, pi, err) == 4:
      var rdone: int = 0
      while rdone == 0:
        pi[0] = pi[0] + 1
        if accept_k(tk, n, pi, err, 55) == 1:
          rdone = 0
        else:
          rdone = 1
  skip_newlines(tk, n, pi, err)
  return 1

# ---- proc signature collection (pass 1) ----
def tc_record_proc(src: var ptr, tk: var array[65536, int], ts: var array[65536, int], te: var array[65536, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], is_extern: int, sym_s: var array[256, int], sym_kind: var array[256, int], sym_ty: var array[256, int], sym_aux: var array[256, int], sym_n: var array[1, int]) -> int
  requires true
  ensures result == 1
  decreases 0
=
  if cur_kind(tk, n, pi, err) != 4:
    err[0] = 1
    return 1
  var nm: int = pi[0]
  pi[0] = pi[0] + 1
  var si: int = sym_n[0]
  if si < 256:
    sym_s[si] = nm
    sym_kind[si] = 1
    sym_n[0] = sym_n[0] + 1
  tc_record_type_params(tk, n, pi, err, sym_s, sym_kind, sym_ty, sym_n)
  expect_k(tk, n, pi, err, 49)
  skip_param_layout(tk, n, pi, err)
  var argc: int = 0
  if cur_kind(tk, n, pi, err) != 50:
    var done: int = 0
    while done == 0:
      skip_param_layout(tk, n, pi, err)
      if cur_kind(tk, n, pi, err) != 4:
        err[0] = 1
      else:
        pi[0] = pi[0] + 1
        expect_k(tk, n, pi, err, 56)
        tc_parse_type(src, tk, ts, te, n, pi, err, sym_s, sym_kind, sym_ty, sym_n)
        argc = argc + 1
      skip_param_layout(tk, n, pi, err)
      if accept_k(tk, n, pi, err, 55) == 1:
        done = 0
      else:
        done = 1
  skip_param_layout(tk, n, pi, err)
  expect_k(tk, n, pi, err, 50)
  tc_skip_raises(tk, n, pi, err)
  var ret: int = 6
  if accept_k(tk, n, pi, err, 57) == 1:
    ret = tc_parse_type(src, tk, ts, te, n, pi, err, sym_s, sym_kind, sym_ty, sym_n)
  if si < 256:
    sym_aux[si] = argc
    sym_ty[si] = ret
  return 1

# ---- pass 1 tail skip: contracts (and body for non-extern procs) ----
def tc_skip_proc_tail(src: var ptr, tk: var array[65536, int], ts: var array[65536, int], te: var array[65536, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], is_extern: int) -> int
  requires true
  ensures result == 1
  decreases 0
=
  skip_newlines(tk, n, pi, err)
  tc_skip_raises(tk, n, pi, err)
  while 1 == 1:
    var ck: int = cur_kind(tk, n, pi, err)
    if ck == 41 or ck == 42 or ck == 43 or ck == 44 or ck == 45:
      parse_contract(src, tk, ts, te, n, pi, err, 0)
      continue
    break
  if is_extern == 0:
    skip_newlines(tk, n, pi, err)
    if accept_k(tk, n, pi, err, 58) == 1:
      skip_newlines(tk, n, pi, err)
      if cur_kind(tk, n, pi, err) == 2:
        parse_block(src, tk, ts, te, n, pi, err, 0)
  return 1

# ---- contract collection + well-formedness (E0301/2/3) ----
def tc_collect_contracts(src: var ptr, tk: var array[65536, int], ts: var array[65536, int], te: var array[65536, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], is_extern: int, ret_ty: int, sym_s: var array[256, int], sym_kind: var array[256, int], sym_ty: var array[256, int], sym_aux: var array[256, int], sym_n: var array[1, int]) -> int
  requires true
  ensures result == 1
  decreases 0
=
  var has_req: int = 0
  var has_ens: int = 0
  var weak_ens: int = 0
  while 1 == 1:
    skip_newlines(tk, n, pi, err)
    var ck: int = cur_kind(tk, n, pi, err)
    if ck == 41:
      has_req = 1
      pi[0] = pi[0] + 1
      parse_contract_expr(src, tk, ts, te, n, pi, err, 0)
      continue
    if ck == 42:
      has_ens = 1
      pi[0] = pi[0] + 1
      if cur_kind(tk, n, pi, err) == 35:
        if peek_off(tk, n, pi, 1) == 1:
          weak_ens = 1
      parse_contract_expr(src, tk, ts, te, n, pi, err, 0)
      continue
    if ck == 43 or ck == 44 or ck == 45:
      pi[0] = pi[0] + 1
      parse_contract_expr(src, tk, ts, te, n, pi, err, 0)
      continue
    break
  if has_req == 0:
    err[0] = 1
    li_rt_emit_err(301)
  if has_ens == 0:
    err[0] = 1
    li_rt_emit_err(302)
  if is_extern == 0:
    if weak_ens == 1:
      if ret_ty != 6:
        err[0] = 1
        li_rt_emit_err(303)
  return 1

# ---- pass 2: check a proc body ----
def tc_check_proc_body(src: var ptr, tk: var array[65536, int], ts: var array[65536, int], te: var array[65536, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], ret_ty: int, cur_ret: var array[1, int], sym_s: var array[256, int], sym_kind: var array[256, int], sym_ty: var array[256, int], sym_aux: var array[256, int], sym_n: var array[1, int]) -> int
  requires true
  ensures result == 1
  decreases 0
=
  cur_ret[0] = ret_ty
  skip_newlines(tk, n, pi, err)
  if accept_k(tk, n, pi, err, 58) == 1:
    skip_newlines(tk, n, pi, err)
    tc_block(src, tk, ts, te, n, pi, err, cur_ret, sym_s, sym_kind, sym_ty, sym_aux, sym_n)
  return 1

# ---- skip a param in pass 2 (types already recorded in pass 1) ----
def tc_skip_param(src: var ptr, tk: var array[65536, int], ts: var array[65536, int], te: var array[65536, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], sym_s: var array[256, int], sym_kind: var array[256, int], sym_ty: var array[256, int], sym_n: var array[1, int]) -> int
  requires true
  ensures result == 1
  decreases 0
=
  skip_param_layout(tk, n, pi, err)
  if cur_kind(tk, n, pi, err) != 4:
    err[0] = 1
    return 1
  pi[0] = pi[0] + 1
  expect_k(tk, n, pi, err, 56)
  tc_parse_type(src, tk, ts, te, n, pi, err, sym_s, sym_kind, sym_ty, sym_n)
  return 1

def tc_record_param(src: var ptr, tk: var array[65536, int], ts: var array[65536, int], te: var array[65536, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], sym_s: var array[256, int], sym_kind: var array[256, int], sym_ty: var array[256, int], sym_n: var array[1, int]) -> int
  requires true
  ensures result == 1
  decreases 0
=
  skip_param_layout(tk, n, pi, err)
  if cur_kind(tk, n, pi, err) != 4:
    err[0] = 1
    return 1
  var pn: int = pi[0]
  pi[0] = pi[0] + 1
  expect_k(tk, n, pi, err, 56)
  var pt: int = tc_parse_type(src, tk, ts, te, n, pi, err, sym_s, sym_kind, sym_ty, sym_n)
  var pl: int = sym_n[0]
  if pl < 256:
    sym_s[pl] = pn
    sym_kind[pl] = 2
    sym_ty[pl] = pt
    sym_n[0] = sym_n[0] + 1
  return 1

# ---- top-level: collect types + procs, then check each proc ----
def check_source(src: var ptr, tk: var array[65536, int], ts: var array[65536, int], te: var array[65536, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int]) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  var sym_s: array[256, int]
  var sym_kind: array[256, int]
  var sym_ty: array[256, int]
  var sym_aux: array[256, int]
  var sym_n: array[1, int]
  var cur_ret: array[1, int]
  sym_n[0] = 0
  skip_newlines(tk, n, pi, err)
  while cur_kind(tk, n, pi, err) != 0:
    var k: int = cur_kind(tk, n, pi, err)
    if k == 11:
      pi[0] = pi[0] + 1
      if cur_kind(tk, n, pi, err) != 4:
        err[0] = 1
        return 1
      var tn: int = pi[0]
      pi[0] = pi[0] + 1
      tc_record_type_params(tk, n, pi, err, sym_s, sym_kind, sym_ty, sym_n)
      expect_k(tk, n, pi, err, 58)
      var rt: int = tc_skip_alias_rhs(src, tk, ts, te, n, pi, err, sym_s, sym_kind, sym_ty, sym_n)
      var ti: int = sym_n[0]
      if ti < 256:
        sym_s[ti] = tn
        sym_kind[ti] = 0
        sym_ty[ti] = rt
        sym_n[0] = sym_n[0] + 1
      skip_newlines(tk, n, pi, err)
      continue
    if k == 10:
      pi[0] = pi[0] + 1
      tc_record_proc(src, tk, ts, te, n, pi, err, 0, sym_s, sym_kind, sym_ty, sym_aux, sym_n)
      tc_skip_proc_tail(src, tk, ts, te, n, pi, err, 0)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 32:
      pi[0] = pi[0] + 1
      if cur_kind(tk, n, pi, err) == 10:
        pi[0] = pi[0] + 1
        tc_record_proc(src, tk, ts, te, n, pi, err, 1, sym_s, sym_kind, sym_ty, sym_aux, sym_n)
      tc_skip_proc_tail(src, tk, ts, te, n, pi, err, 1)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 33:
      pi[0] = pi[0] + 1
      if cur_kind(tk, n, pi, err) == 10:
        pi[0] = pi[0] + 1
      tc_record_proc(src, tk, ts, te, n, pi, err, 0, sym_s, sym_kind, sym_ty, sym_aux, sym_n)
      tc_skip_proc_tail(src, tk, ts, te, n, pi, err, 0)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 76:
      parse_decorator_list(src, tk, ts, te, n, pi, err, 0)
      continue
    if k == 18:
      parse_import(src, tk, ts, te, n, pi, err, 0)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 13 or k == 12 or k == 14:
      parse_theorem(src, tk, ts, te, n, pi, err, 0, 0, 0)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 16 or k == 17:
      pi[0] = pi[0] + 1
      continue
    err[0] = 1
    return 1
  pi[0] = 0
  skip_newlines(tk, n, pi, err)
  while cur_kind(tk, n, pi, err) != 0:
    var k: int = cur_kind(tk, n, pi, err)
    if k == 32:
      pi[0] = pi[0] + 1
      if cur_kind(tk, n, pi, err) == 10:
        pi[0] = pi[0] + 1
        if cur_kind(tk, n, pi, err) != 4:
          err[0] = 1
          return 1
        pi[0] = pi[0] + 1
        fx_skip_typeparams(tk, n, pi, err)
        expect_k(tk, n, pi, err, 49)
        skip_param_layout(tk, n, pi, err)
        if cur_kind(tk, n, pi, err) != 50:
          var done: int = 0
          while done == 0:
            tc_skip_param(src, tk, ts, te, n, pi, err, sym_s, sym_kind, sym_ty, sym_n)
            if accept_k(tk, n, pi, err, 55) == 1:
              done = 0
            else:
              done = 1
        skip_param_layout(tk, n, pi, err)
        expect_k(tk, n, pi, err, 50)
        tc_skip_raises(tk, n, pi, err)
        var ret2: int = 6
        if accept_k(tk, n, pi, err, 57) == 1:
          ret2 = tc_parse_type(src, tk, ts, te, n, pi, err, sym_s, sym_kind, sym_ty, sym_n)
        tc_skip_raises(tk, n, pi, err)
        tc_collect_contracts(src, tk, ts, te, n, pi, err, 1, ret2, sym_s, sym_kind, sym_ty, sym_aux, sym_n)
        skip_newlines(tk, n, pi, err)
        continue
    if k == 10 or k == 33:
      pi[0] = pi[0] + 1
      if k == 33:
        if cur_kind(tk, n, pi, err) == 10:
          pi[0] = pi[0] + 1
      if cur_kind(tk, n, pi, err) != 4:
        err[0] = 1
        return 1
      pi[0] = pi[0] + 1
      fx_skip_typeparams(tk, n, pi, err)
      expect_k(tk, n, pi, err, 49)
      skip_param_layout(tk, n, pi, err)
      if cur_kind(tk, n, pi, err) != 50:
        var done: int = 0
        while done == 0:
          tc_record_param(src, tk, ts, te, n, pi, err, sym_s, sym_kind, sym_ty, sym_n)
          if accept_k(tk, n, pi, err, 55) == 1:
            done = 0
          else:
            done = 1
      skip_param_layout(tk, n, pi, err)
      expect_k(tk, n, pi, err, 50)
      tc_skip_raises(tk, n, pi, err)
      var ret3: int = 6
      if accept_k(tk, n, pi, err, 57) == 1:
        ret3 = tc_parse_type(src, tk, ts, te, n, pi, err, sym_s, sym_kind, sym_ty, sym_n)
      tc_skip_raises(tk, n, pi, err)
      tc_collect_contracts(src, tk, ts, te, n, pi, err, 0, ret3, sym_s, sym_kind, sym_ty, sym_aux, sym_n)
      skip_newlines(tk, n, pi, err)
      tc_check_proc_body(src, tk, ts, te, n, pi, err, ret3, cur_ret, sym_s, sym_kind, sym_ty, sym_aux, sym_n)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 11:
      pi[0] = pi[0] + 1
      if cur_kind(tk, n, pi, err) != 4:
        err[0] = 1
        return 1
      pi[0] = pi[0] + 1
      if accept_k(tk, n, pi, err, 51) == 1:
        if cur_kind(tk, n, pi, err) != 52:
          var done: int = 0
          while done == 0:
            if cur_kind(tk, n, pi, err) == 4:
              pi[0] = pi[0] + 1
            if accept_k(tk, n, pi, err, 55) == 1:
              done = 0
            else:
              done = 1
        expect_k(tk, n, pi, err, 52)
      expect_k(tk, n, pi, err, 58)
      tc_skip_alias_rhs(src, tk, ts, te, n, pi, err, sym_s, sym_kind, sym_ty, sym_n)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 76:
      parse_decorator_list(src, tk, ts, te, n, pi, err, 0)
      continue
    if k == 18:
      parse_import(src, tk, ts, te, n, pi, err, 0)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 13 or k == 12 or k == 14:
      parse_theorem(src, tk, ts, te, n, pi, err, 0, 0, 0)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 16 or k == 17:
      pi[0] = pi[0] + 1
      continue
    err[0] = 1
    return 1
  if err[0] == 1:
    return 1
  return 0

# ---- Layer 4b: effect checking (raises IO / Alloc / Net / Async) ----
# Effect bits: IO=1, Alloc=2, Net=4, Async=8 (bitmask; each added once).
def fx_eff_bit(src: var ptr, ts: var array[65536, int], te: var array[65536, int], i: int) -> int
  requires true
  ensures result >= 0
  decreases 0
=
  if tok_is(src, ts, te, i, "IO") == 1:
    return 1
  if tok_is(src, ts, te, i, "Alloc") == 1:
    return 2
  if tok_is(src, ts, te, i, "Net") == 1:
    return 4
  if tok_is(src, ts, te, i, "Async") == 1:
    return 8
  return 0

def fx_has_eff(m: int, b: int) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  if b == 0:
    return 0
  if (m // b) % 2 == 1:
    return 1
  return 0

def fx_add_eff(used: var array[1, int], b: int) -> int
  requires true
  ensures result == 0
  decreases 0
=
  if b > 0:
    if fx_has_eff(used[0], b) == 0:
      used[0] = used[0] + b
  return 0

def fx_is_heap(src: var ptr, ts: var array[65536, int], te: var array[65536, int], i: int) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  if tok_is(src, ts, te, i, "list") == 1:
    return 1
  if tok_is(src, ts, te, i, "dict") == 1:
    return 1
  if tok_is(src, ts, te, i, "set") == 1:
    return 1
  if tok_is(src, ts, te, i, "str") == 1:
    return 1
  if tok_is(src, ts, te, i, "bytes") == 1:
    return 1
  if tok_is(src, ts, te, i, "stringview") == 1:
    return 1
  if tok_is(src, ts, te, i, "Bytes") == 1:
    return 1
  if tok_is(src, ts, te, i, "StringView") == 1:
    return 1
  return 0

def fx_proc_ext(src: var ptr, ts: var array[65536, int], te: var array[65536, int], pn: var array[256, int], pext: var array[256, int], pcnt: var array[1, int], name_tok: int) -> int
  requires true
  ensures result >= -1
  decreases 0
=
  var k: int = 0
  while k < pcnt[0]:
    if tok_eq(src, ts, te, pn[k], name_tok) == 1:
      return pext[k]
    k = k + 1
  return -1

def fx_proc_eff(src: var ptr, ts: var array[65536, int], te: var array[65536, int], pn: var array[256, int], peff: var array[256, int], pcnt: var array[1, int], name_tok: int) -> int
  requires true
  ensures result >= -1
  decreases 0
=
  var k: int = 0
  while k < pcnt[0]:
    if tok_eq(src, ts, te, pn[k], name_tok) == 1:
      return peff[k]
    k = k + 1
  return -1

def fx_skip_typeparams(tk: var array[65536, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int]) -> int
  requires true
  ensures result == 1
  decreases 0
=
  if accept_k(tk, n, pi, err, 51) == 1:
    if cur_kind(tk, n, pi, err) != 52:
      var done: int = 0
      while done == 0:
        pi[0] = pi[0] + 1
        if accept_k(tk, n, pi, err, 56) == 1:
          if cur_kind(tk, n, pi, err) == 4:
            pi[0] = pi[0] + 1
        if accept_k(tk, n, pi, err, 55) == 1:
          done = 0
        else:
          done = 1
    expect_k(tk, n, pi, err, 52)
  return 1

def fx_skip_params(src: var ptr, tk: var array[65536, int], ts: var array[65536, int], te: var array[65536, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], heap: var array[1, int]) -> int
  requires true
  ensures result == 1
  decreases 0
=
  skip_param_layout(tk, n, pi, err)
  if cur_kind(tk, n, pi, err) != 50:
    var done: int = 0
    while done == 0:
      skip_param_layout(tk, n, pi, err)
      if cur_kind(tk, n, pi, err) == 4:
        pi[0] = pi[0] + 1
        expect_k(tk, n, pi, err, 56)
        if cur_kind(tk, n, pi, err) == 4:
          if fx_is_heap(src, ts, te, pi[0]) == 1:
            heap[0] = 1
        parse_type(src, tk, ts, te, n, pi, err, 0)
      skip_param_layout(tk, n, pi, err)
      if accept_k(tk, n, pi, err, 55) == 1:
        done = 0
      else:
        done = 1
  skip_param_layout(tk, n, pi, err)
  expect_k(tk, n, pi, err, 50)
  return 1

def fx_record_raises(src: var ptr, tk: var array[65536, int], ts: var array[65536, int], te: var array[65536, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], decl: var array[1, int]) -> int
  requires true
  ensures result == 1
  decreases 0
=
  skip_newlines(tk, n, pi, err)
  if cur_kind(tk, n, pi, err) == 31:
    pi[0] = pi[0] + 1
    if cur_kind(tk, n, pi, err) == 4:
      var done: int = 0
      while done == 0:
        var b: int = fx_eff_bit(src, ts, te, pi[0])
        fx_add_eff(decl, b)
        pi[0] = pi[0] + 1
        if accept_k(tk, n, pi, err, 55) == 1:
          done = 0
        else:
          done = 1
  skip_newlines(tk, n, pi, err)
  return 1

def fx_skip_decorators(src: var ptr, tk: var array[65536, int], ts: var array[65536, int], te: var array[65536, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], pend: var array[1, int]) -> int
  requires true
  ensures result == 1
  decreases 0
=
  pend[0] = 0
  while cur_kind(tk, n, pi, err) == 76:
    pi[0] = pi[0] + 1
    if cur_kind(tk, n, pi, err) == 33:
      pend[0] = 1
    if cur_kind(tk, n, pi, err) == 4 or cur_kind(tk, n, pi, err) == 33:
      pi[0] = pi[0] + 1
    if accept_k(tk, n, pi, err, 49) == 1:
      if cur_kind(tk, n, pi, err) != 50:
        var done: int = 0
        while done == 0:
          parse_expr(src, tk, ts, te, n, pi, err, 0, 0)
          if accept_k(tk, n, pi, err, 55) == 1:
            done = 0
          else:
            done = 1
      expect_k(tk, n, pi, err, 50)
    skip_newlines(tk, n, pi, err)
  return 1

def fx_skip_typealias(src: var ptr, tk: var array[65536, int], ts: var array[65536, int], te: var array[65536, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int]) -> int
  requires true
  ensures result == 1
  decreases 0
=
  return parse_type_alias(src, tk, ts, te, n, pi, err, 0)

def fx_scan_expr(src: var ptr, tk: var array[65536, int], ts: var array[65536, int], te: var array[65536, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], pn: var array[256, int], peff: var array[256, int], pext: var array[256, int], pcnt: var array[1, int], used: var array[1, int], await_seen: var array[1, int]) -> int
  requires true
  ensures result == 1
  decreases 0
=
  var depth: int = 0
  while 1 == 1:
    var k: int = cur_kind(tk, n, pi, err)
    if depth == 0:
      if k == 1 or k == 3 or k == 0 or k == 56 or k == 55:
        break
    if k == 49 or k == 51 or k == 53:
      depth = depth + 1
    if k == 50 or k == 52 or k == 54:
      depth = depth - 1
    if k == 34:
      await_seen[0] = 1
    if k == 4:
      if peek_off(tk, n, pi, 1) == 49:
        if tok_is(src, ts, te, pi[0], "print") == 1:
          fx_add_eff(used, 1)
        if fx_proc_ext(src, ts, te, pn, pext, pcnt, pi[0]) == 1:
          fx_add_eff(used, 1)
        var cf: int = fx_proc_eff(src, ts, te, pn, peff, pcnt, pi[0])
        if cf >= 0:
          if fx_has_eff(cf, 4) == 1:
            fx_add_eff(used, 4)
          if fx_has_eff(cf, 8) == 1:
            fx_add_eff(used, 8)
    pi[0] = pi[0] + 1
  return 1

def fx_scan_block(src: var ptr, tk: var array[65536, int], ts: var array[65536, int], te: var array[65536, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], pn: var array[256, int], peff: var array[256, int], pext: var array[256, int], pcnt: var array[1, int], used: var array[1, int], await_seen: var array[1, int]) -> int
  requires true
  ensures result == 1
  decreases 0
=
  skip_newlines(tk, n, pi, err)
  if expect_k(tk, n, pi, err, 2) == 0:
    return 1
  skip_newlines(tk, n, pi, err)
  while 1 == 1:
    if cur_kind(tk, n, pi, err) == 3:
      break
    if cur_kind(tk, n, pi, err) == 0:
      break
    var before: int = pi[0]
    fx_scan_stmt(src, tk, ts, te, n, pi, err, pn, peff, pext, pcnt, used, await_seen)
    if pi[0] == before:
      break
    skip_newlines(tk, n, pi, err)
  expect_k(tk, n, pi, err, 3)
  return 1

def fx_scan_stmt(src: var ptr, tk: var array[65536, int], ts: var array[65536, int], te: var array[65536, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], pn: var array[256, int], peff: var array[256, int], pext: var array[256, int], pcnt: var array[1, int], used: var array[1, int], await_seen: var array[1, int]) -> int
  requires true
  ensures result == 1
  decreases 0
=
  var k: int = cur_kind(tk, n, pi, err)
  if k == 20:
    pi[0] = pi[0] + 1
    if cur_kind(tk, n, pi, err) == 4:
      pi[0] = pi[0] + 1
    if accept_k(tk, n, pi, err, 56) == 1:
      parse_type(src, tk, ts, te, n, pi, err, 0)
    if accept_k(tk, n, pi, err, 58) == 1:
      parse_expr(src, tk, ts, te, n, pi, err, 0, 0)
    return 1
  if k == 30:
    pi[0] = pi[0] + 1
    if cur_kind(tk, n, pi, err) != 1:
      fx_scan_expr(src, tk, ts, te, n, pi, err, pn, peff, pext, pcnt, used, await_seen)
    return 1
  if k == 22:
    pi[0] = pi[0] + 1
    fx_scan_expr(src, tk, ts, te, n, pi, err, pn, peff, pext, pcnt, used, await_seen)
    expect_k(tk, n, pi, err, 56)
    skip_newlines(tk, n, pi, err)
    fx_scan_block(src, tk, ts, te, n, pi, err, pn, peff, pext, pcnt, used, await_seen)
    while cur_kind(tk, n, pi, err) == 24:
      pi[0] = pi[0] + 1
      fx_scan_expr(src, tk, ts, te, n, pi, err, pn, peff, pext, pcnt, used, await_seen)
      expect_k(tk, n, pi, err, 56)
      skip_newlines(tk, n, pi, err)
      fx_scan_block(src, tk, ts, te, n, pi, err, pn, peff, pext, pcnt, used, await_seen)
    if cur_kind(tk, n, pi, err) == 23:
      pi[0] = pi[0] + 1
      expect_k(tk, n, pi, err, 56)
      skip_newlines(tk, n, pi, err)
      fx_scan_block(src, tk, ts, te, n, pi, err, pn, peff, pext, pcnt, used, await_seen)
    return 1
  if k == 25:
    pi[0] = pi[0] + 1
    fx_scan_expr(src, tk, ts, te, n, pi, err, pn, peff, pext, pcnt, used, await_seen)
    if cur_kind(tk, n, pi, err) == 56:
      pi[0] = pi[0] + 1
    skip_newlines(tk, n, pi, err)
    fx_scan_block(src, tk, ts, te, n, pi, err, pn, peff, pext, pcnt, used, await_seen)
    return 1
  if k == 26:
    pi[0] = pi[0] + 1
    fx_scan_expr(src, tk, ts, te, n, pi, err, pn, peff, pext, pcnt, used, await_seen)
    skip_newlines(tk, n, pi, err)
    fx_scan_block(src, tk, ts, te, n, pi, err, pn, peff, pext, pcnt, used, await_seen)
    return 1
  fx_scan_expr(src, tk, ts, te, n, pi, err, pn, peff, pext, pcnt, used, await_seen)
  if accept_k(tk, n, pi, err, 58) == 1:
    fx_scan_expr(src, tk, ts, te, n, pi, err, pn, peff, pext, pcnt, used, await_seen)
  return 1

def effects_check(src: var ptr, tk: var array[65536, int], ts: var array[65536, int], te: var array[65536, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int]) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  var pn: array[256, int]
  var peff: array[256, int]
  var pext: array[256, int]
  var pcnt: array[1, int]
  var pend: array[1, int]
  var decl: array[1, int]
  var heap: array[1, int]
  var used: array[1, int]
  var await_seen: array[1, int]
  pcnt[0] = 0
  pend[0] = 0
  pi[0] = 0
  skip_newlines(tk, n, pi, err)
  while cur_kind(tk, n, pi, err) != 0:
    var k: int = cur_kind(tk, n, pi, err)
    if k == 11:
      fx_skip_typealias(src, tk, ts, te, n, pi, err)
      continue
    if k == 76:
      fx_skip_decorators(src, tk, ts, te, n, pi, err, pend)
      continue
    if k == 18:
      parse_import(src, tk, ts, te, n, pi, err, 0)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 13 or k == 12 or k == 14:
      parse_theorem(src, tk, ts, te, n, pi, err, 0, 0, 0)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 16 or k == 17:
      pi[0] = pi[0] + 1
      skip_newlines(tk, n, pi, err)
      continue
    if k == 32 or k == 10 or k == 33:
      var is_ext: int = 0
      var is_asy: int = pend[0]
      pend[0] = 0
      if k == 32:
        is_ext = 1
        pi[0] = pi[0] + 1
        if cur_kind(tk, n, pi, err) == 10:
          pi[0] = pi[0] + 1
      if k == 33:
        is_asy = 1
        pi[0] = pi[0] + 1
        if cur_kind(tk, n, pi, err) == 10:
          pi[0] = pi[0] + 1
      if k == 10:
        pi[0] = pi[0] + 1
      if cur_kind(tk, n, pi, err) != 4:
        err[0] = 1
        return 1
      var nm: int = pi[0]
      pi[0] = pi[0] + 1
      var idx: int = pcnt[0]
      if idx < 256:
        pn[idx] = nm
        pext[idx] = is_ext
        peff[idx] = 0
        pcnt[0] = pcnt[0] + 1
      fx_skip_typeparams(tk, n, pi, err)
      expect_k(tk, n, pi, err, 49)
      decl[0] = 0
      heap[0] = 0
      fx_skip_params(src, tk, ts, te, n, pi, err, heap)
      fx_record_raises(src, tk, ts, te, n, pi, err, decl)
      if accept_k(tk, n, pi, err, 57) == 1:
        if cur_kind(tk, n, pi, err) == 4:
          if fx_is_heap(src, ts, te, pi[0]) == 1:
            heap[0] = 1
        parse_type(src, tk, ts, te, n, pi, err, 0)
      fx_record_raises(src, tk, ts, te, n, pi, err, decl)
      if idx < 256:
        peff[idx] = decl[0]
      while 1 == 1:
        var ck: int = cur_kind(tk, n, pi, err)
        if ck == 41 or ck == 42 or ck == 43 or ck == 44 or ck == 45:
          parse_contract(src, tk, ts, te, n, pi, err, 0)
          continue
        break
      if is_ext == 0:
        skip_newlines(tk, n, pi, err)
        if accept_k(tk, n, pi, err, 58) == 1:
          skip_newlines(tk, n, pi, err)
          if cur_kind(tk, n, pi, err) == 2:
            parse_block(src, tk, ts, te, n, pi, err, 0)
      skip_newlines(tk, n, pi, err)
      continue
    err[0] = 1
    return 1
  pi[0] = 0
  pend[0] = 0
  skip_newlines(tk, n, pi, err)
  while cur_kind(tk, n, pi, err) != 0:
    var k: int = cur_kind(tk, n, pi, err)
    if k == 11:
      fx_skip_typealias(src, tk, ts, te, n, pi, err)
      continue
    if k == 76:
      fx_skip_decorators(src, tk, ts, te, n, pi, err, pend)
      continue
    if k == 18:
      parse_import(src, tk, ts, te, n, pi, err, 0)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 13 or k == 12 or k == 14:
      parse_theorem(src, tk, ts, te, n, pi, err, 0, 0, 0)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 16 or k == 17:
      pi[0] = pi[0] + 1
      skip_newlines(tk, n, pi, err)
      continue
    if k == 32 or k == 10 or k == 33:
      var is_ext: int = 0
      var is_asy: int = pend[0]
      pend[0] = 0
      if k == 32:
        is_ext = 1
        pi[0] = pi[0] + 1
        if cur_kind(tk, n, pi, err) == 10:
          pi[0] = pi[0] + 1
      if k == 33:
        is_asy = 1
        pi[0] = pi[0] + 1
        if cur_kind(tk, n, pi, err) == 10:
          pi[0] = pi[0] + 1
      if k == 10:
        pi[0] = pi[0] + 1
      if cur_kind(tk, n, pi, err) != 4:
        err[0] = 1
        return 1
      pi[0] = pi[0] + 1
      fx_skip_typeparams(tk, n, pi, err)
      expect_k(tk, n, pi, err, 49)
      decl[0] = 0
      heap[0] = 0
      fx_skip_params(src, tk, ts, te, n, pi, err, heap)
      fx_record_raises(src, tk, ts, te, n, pi, err, decl)
      if accept_k(tk, n, pi, err, 57) == 1:
        if cur_kind(tk, n, pi, err) == 4:
          if fx_is_heap(src, ts, te, pi[0]) == 1:
            heap[0] = 1
        parse_type(src, tk, ts, te, n, pi, err, 0)
      fx_record_raises(src, tk, ts, te, n, pi, err, decl)
      while 1 == 1:
        var ck: int = cur_kind(tk, n, pi, err)
        if ck == 41 or ck == 42 or ck == 43 or ck == 44 or ck == 45:
          parse_contract(src, tk, ts, te, n, pi, err, 0)
          continue
        break
      if is_ext == 0:
        used[0] = 0
        await_seen[0] = 0
        skip_newlines(tk, n, pi, err)
        if accept_k(tk, n, pi, err, 58) == 1:
          skip_newlines(tk, n, pi, err)
          fx_scan_block(src, tk, ts, te, n, pi, err, pn, peff, pext, pcnt, used, await_seen)
        if heap[0] == 1:
          if fx_has_eff(decl[0], 2) == 0:
            err[0] = 1
            li_rt_emit_err(900)
        if await_seen[0] == 1:
          if is_asy == 0:
            err[0] = 1
            li_rt_emit_err(900)
        if is_asy == 1:
          if fx_has_eff(decl[0], 8) == 0:
            err[0] = 1
            li_rt_emit_err(900)
        if fx_has_eff(used[0], 1) == 1:
          if fx_has_eff(decl[0], 1) == 0:
            err[0] = 1
            li_rt_emit_err(900)
        if fx_has_eff(used[0], 4) == 1:
          if fx_has_eff(decl[0], 4) == 0:
            err[0] = 1
            li_rt_emit_err(900)
        if fx_has_eff(used[0], 8) == 1:
          if fx_has_eff(decl[0], 8) == 0:
            err[0] = 1
            li_rt_emit_err(900)
      skip_newlines(tk, n, pi, err)
      continue
    err[0] = 1
    return 1
  return 0

# ---- Layer 4c: borrow checking (E0310 double-mut, E0311 use-after-move) ----
# Mirrors compiler/types/borrowck.cpp. A plain-ident call argument moves the
# local iff the callee parameter is non-`var` and non-scalar; reading a moved
# local is E0311, and reading a value with an active `borrow mut` (or taking a
# second borrow) is E0310.

type Pos256 = {p: int | 0 <= p and p < 256}

def peek256(buf: var array[256, int], p: Pos256) -> int
  requires true
  ensures result == buf[p]
  decreases 0
=
  return buf[p]

type Pos4096 = {p: int | 0 <= p and p < 4096}

def peek4096(buf: var array[4096, int], p: Pos4096) -> int
  requires true
  ensures result == buf[p]
  decreases 0
=
  return buf[p]

def bk_scalar_name(src: var ptr, ts: var array[65536, int], te: var array[65536, int], i: int) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  if tok_is(src, ts, te, i, "int") == 1:
    return 1
  if tok_is(src, ts, te, i, "float") == 1:
    return 1
  if tok_is(src, ts, te, i, "i64") == 1:
    return 1
  if tok_is(src, ts, te, i, "int64") == 1:
    return 1
  if tok_is(src, ts, te, i, "bool") == 1:
