        continue
      if ck == 43:
        parse_contract(src, tk, ts, te, n, pi, err, d)
        continue
      if ck == 44:
        parse_contract(src, tk, ts, te, n, pi, err, d)
        continue
      if ck == 45:
        parse_contract(src, tk, ts, te, n, pi, err, d)
        continue
      break
    expect_k(tk, n, pi, err, 3)
    skip_newlines(tk, n, pi, err)
  if accept_k(tk, n, pi, err, 58) == 1:
    skip_newlines(tk, n, pi, err)
    if cur_kind(tk, n, pi, err) == 2:
      parse_block(src, tk, ts, te, n, pi, err, d)
    else:
      a_line(d, 51)
      a_line(d, 52)
  else:
    a_line(d, 51)
    a_line(d, 52)
  return 1

def parse_stmt(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], d: int) -> int
  requires true
