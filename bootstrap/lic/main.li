  return 1

def parse_decorator(src: var ptr, tk: var array[65536, int], ts: var array[65536, int], te: var array[65536, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], d: int) -> int
  requires true
  ensures result == 1
  decreases 0
=
  if expect_k(tk, n, pi, err, 76) == 0:
    return 1
  var k: int = cur_kind(tk, n, pi, err)
  if k != 4:
    if k != 33:
      err[0] = 1
      return 1
  var dn: int = pi[0]
  pi[0] = pi[0] + 1
  if d == 1:
    a_line_text(d, src, 8, peek_tk(ts, dn + 0), peek_tk(te, dn + 0))
  if accept_k(tk, n, pi, err, 49) == 1:
    if cur_kind(tk, n, pi, err) != 50:
      var done: int = 0
      while done == 0:
        if cur_kind(tk, n, pi, err) != 4:
          err[0] = 1
          break
        var an: int = pi[0]
        pi[0] = pi[0] + 1
        if d == 1:
          a_line_text(d, src, 9, peek_tk(ts, an + 0), peek_tk(te, an + 0))
        if accept_k(tk, n, pi, err, 58) == 1:
          parse_decorator_value(src, tk, ts, te, n, pi, err, d)
        else:
          if d == 1:
            a_line_text(d, src, 64, peek_tk(ts, an + 0), peek_tk(te, an + 0))
        if accept_k(tk, n, pi, err, 55) == 1:
          done = 0
        else:
          done = 1
    expect_k(tk, n, pi, err, 50)
  return 1

def parse_decorator_list(src: var ptr, tk: var array[65536, int], ts: var array[65536, int], te: var array[65536, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], d: int) -> int
  requires true
  ensures result == 1
  decreases 0
=
  skip_newlines(tk, n, pi, err)
  while cur_kind(tk, n, pi, err) == 76:
    parse_decorator(src, tk, ts, te, n, pi, err, d)
    skip_newlines(tk, n, pi, err)
  return 1

def parse_for(src: var ptr, tk: var array[65536, int], ts: var array[65536, int], te: var array[65536, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], d: int) -> int
  requires true
  ensures result == 1
  decreases 0
=
  pi[0] = pi[0] + 1
  var iter_t: int = 0
  if cur_kind(tk, n, pi, err) != 4:
    err[0] = 1
  else:
    iter_t = pi[0]
    pi[0] = pi[0] + 1
  if cur_kind(tk, n, pi, err) != 4:
    err[0] = 1
  else:
    if tok_is(src, ts, te, pi[0], "in") == 0:
      err[0] = 1
    else:
      pi[0] = pi[0] + 1
  var st: int = 0
  var en: int = 0
  if cur_kind(tk, n, pi, err) == 5:
    st = int_text_value(src, ts, te, pi[0])
    pi[0] = pi[0] + 1
  if cur_kind(tk, n, pi, err) == 73:
    pi[0] = pi[0] + 1
  else:
    err[0] = 1
  if cur_kind(tk, n, pi, err) == 5:
    en = int_text_value(src, ts, te, pi[0])
    pi[0] = pi[0] + 1
  if cur_kind(tk, n, pi, err) == 56:
    pi[0] = pi[0] + 1
  if d == 1:
    a_line_text_ii(d, src, 43, peek_tk(ts, iter_t + 0), peek_tk(te, iter_t + 0), st, en)
  skip_newlines(tk, n, pi, err)
  parse_block(src, tk, ts, te, n, pi, err, d)
  return 1

def parse_parallel_for(src: var ptr, tk: var array[65536, int], ts: var array[65536, int], te: var array[65536, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], d: int) -> int
  requires true
  ensures result == 1
  decreases 0
=
  pi[0] = pi[0] + 1
  if consume_for_kw(src, tk, ts, te, n, pi, err) == 0:
    err[0] = 1
  var iter_t: int = 0
  if cur_kind(tk, n, pi, err) != 4:
    err[0] = 1
  else:
    iter_t = pi[0]
    pi[0] = pi[0] + 1
  if cur_kind(tk, n, pi, err) != 4:
    err[0] = 1
  else:
    if tok_is(src, ts, te, pi[0], "in") == 0:
      err[0] = 1
    else:
      pi[0] = pi[0] + 1
  var st: int = 0
  var en: int = 0
  if cur_kind(tk, n, pi, err) == 5:
    st = int_text_value(src, ts, te, pi[0])
    pi[0] = pi[0] + 1
  if cur_kind(tk, n, pi, err) == 73:
    pi[0] = pi[0] + 1
  else:
    err[0] = 1
  if cur_kind(tk, n, pi, err) == 5:
    en = int_text_value(src, ts, te, pi[0])
    pi[0] = pi[0] + 1
  if d == 1:
    a_line_text_ii(d, src, 44, peek_tk(ts, iter_t + 0), peek_tk(te, iter_t + 0), st, en)
  skip_newlines(tk, n, pi, err)
  if accept_k(tk, n, pi, err, 2) == 1:
    skip_newlines(tk, n, pi, err)
    while 1 == 1:
      var ck: int = cur_kind(tk, n, pi, err)
      if ck == 41:
        parse_contract(src, tk, ts, te, n, pi, err, d)
        continue
      if ck == 42:
        parse_contract(src, tk, ts, te, n, pi, err, d)
        continue
      if ck == 43:
        parse_contract(src, tk, ts, te, n, pi, err, d)
        continue
      if ck == 44:
        parse_contract(src, tk, ts, te, n, pi, err, d)
        continue
      if ck == 45:
        parse_contract(src, tk, ts, te, n, pi, err, d)
        continue
      break
    expect_k(tk, n, pi, err, 3)
    skip_newlines(tk, n, pi, err)
  if accept_k(tk, n, pi, err, 58) == 1:
    skip_newlines(tk, n, pi, err)
    if cur_kind(tk, n, pi, err) == 2:
      parse_block(src, tk, ts, te, n, pi, err, d)
    else:
      a_line(d, 51)
      a_line(d, 52)
  else:
    a_line(d, 51)
    a_line(d, 52)
  return 1

def parse_stmt(src: var ptr, tk: var array[65536, int], ts: var array[65536, int], te: var array[65536, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], d: int) -> int
  requires true
  ensures result == 1
  decreases 0
=
  if cur_kind(tk, n, pi, err) == 76:
    parse_decorator_list(src, tk, ts, te, n, pi, err, d)
    if cur_kind(tk, n, pi, err) == 25:
      pi[0] = pi[0] + 1
      a_line(d, 42)
      parse_expr(src, tk, ts, te, n, pi, err, 0, d)
      if cur_kind(tk, n, pi, err) == 56:
        pi[0] = pi[0] + 1
      skip_newlines(tk, n, pi, err)
      parse_block(src, tk, ts, te, n, pi, err, d)
      return 1
    if cur_kind(tk, n, pi, err) == 4:
      if tok_is(src, ts, te, pi[0], "parallel") == 1:
        parse_parallel_for(src, tk, ts, te, n, pi, err, d)
        return 1
    if cur_kind(tk, n, pi, err) == 26:
      parse_for(src, tk, ts, te, n, pi, err, d)
      return 1
    err[0] = 1
    return 1
  if cur_kind(tk, n, pi, err) == 4:
    if tok_is(src, ts, te, pi[0], "discard") == 1:
      pi[0] = pi[0] + 1
      a_line(d, 47)
      skip_newlines(tk, n, pi, err)
      return 1
    if tok_is(src, ts, te, pi[0], "borrow") == 1:
      pi[0] = pi[0] + 1
      var bm: int = 0
      if cur_kind(tk, n, pi, err) == 4:
        if tok_is(src, ts, te, pi[0], "mut") == 1:
          bm = 1
          pi[0] = pi[0] + 1
        if tok_is(src, ts, te, pi[0], "imm") == 1:
          pi[0] = pi[0] + 1
      if cur_kind(tk, n, pi, err) != 4:
        err[0] = 1
        return 1
      var bname: int = pi[0]
      pi[0] = pi[0] + 1
      if d == 1:
        a_line_text_i(d, src, 49, peek_tk(ts, bname + 0), peek_tk(te, bname + 0), bm)
      expect_k(tk, n, pi, err, 58)
      parse_expr(src, tk, ts, te, n, pi, err, 0, d)
      skip_newlines(tk, n, pi, err)
      return 1
  if cur_kind(tk, n, pi, err) == 20:
    pi[0] = pi[0] + 1
    var vname: int = pi[0]
    pi[0] = pi[0] + 1
    if d == 1:
      a_line_text(d, src, 48, peek_tk(ts, vname + 0), peek_tk(te, vname + 0))
    expect_k(tk, n, pi, err, 56)
    parse_type(src, tk, ts, te, n, pi, err, d)
    if accept_k(tk, n, pi, err, 58) == 1:
      parse_expr(src, tk, ts, te, n, pi, err, 0, d)
    skip_newlines(tk, n, pi, err)
    return 1
  if cur_kind(tk, n, pi, err) == 27:
    pi[0] = pi[0] + 1
    a_line(d, 45)
    skip_newlines(tk, n, pi, err)
    return 1
  if cur_kind(tk, n, pi, err) == 28:
    pi[0] = pi[0] + 1
    a_line(d, 46)
    skip_newlines(tk, n, pi, err)
    return 1
  if cur_kind(tk, n, pi, err) == 26:
    parse_for(src, tk, ts, te, n, pi, err, d)
    return 1
  if cur_kind(tk, n, pi, err) == 25:
    pi[0] = pi[0] + 1
    a_line(d, 42)
    parse_expr(src, tk, ts, te, n, pi, err, 0, d)
    if cur_kind(tk, n, pi, err) == 56:
      pi[0] = pi[0] + 1
    skip_newlines(tk, n, pi, err)
    parse_block(src, tk, ts, te, n, pi, err, d)
    return 1
  if cur_kind(tk, n, pi, err) == 4:
    if tok_is(src, ts, te, pi[0], "parallel") == 1:
      parse_parallel_for(src, tk, ts, te, n, pi, err, d)
      return 1
  if cur_kind(tk, n, pi, err) == 30:
    pi[0] = pi[0] + 1
    a_line(d, 40)
    var kk: int = cur_kind(tk, n, pi, err)
    if kk != 1:
      if kk != 3:
        if kk != 0:
          parse_expr(src, tk, ts, te, n, pi, err, 0, d)
    skip_newlines(tk, n, pi, err)
    return 1
  if cur_kind(tk, n, pi, err) == 22:
    pi[0] = pi[0] + 1
    a_line(d, 41)
    parse_expr(src, tk, ts, te, n, pi, err, 0, d)
    expect_k(tk, n, pi, err, 56)
    skip_newlines(tk, n, pi, err)
    parse_block(src, tk, ts, te, n, pi, err, d)
    var nelif: array[1,  int]
    nelif[0] = 0
    var tail_done: int = 0
    while tail_done == 0:
      skip_newlines(tk, n, pi, err)
      if cur_kind(tk, n, pi, err) == 24:
        nelif[0] = nelif[0] + 1
        a_line(d, 51)
        a_line(d, 41)
        pi[0] = pi[0] + 1
        parse_expr(src, tk, ts, te, n, pi, err, 0, d)
        expect_k(tk, n, pi, err, 56)
        skip_newlines(tk, n, pi, err)
        parse_block(src, tk, ts, te, n, pi, err, d)
      else:
        if cur_kind(tk, n, pi, err) == 23:
          pi[0] = pi[0] + 1
          expect_k(tk, n, pi, err, 56)
          skip_newlines(tk, n, pi, err)
          parse_block(src, tk, ts, te, n, pi, err, d)
          tail_done = 1
        else:
          tail_done = 1
    var ci: int = 0
    while ci < nelif[0]:
      a_line(d, 52)
      ci = ci + 1
    return 1
  var save: int = pi[0]
  var ok: int = parse_primary(src, tk, ts, te, n, pi, err, 0)
  if ok == 1:
    ok = parse_postfix(src, tk, ts, te, n, pi, err, 0)
  if ok == 1:
    if accept_k(tk, n, pi, err, 58) == 1:
      a_line(d, 50)
      pi[0] = save
      parse_primary(src, tk, ts, te, n, pi, err, d)
      parse_postfix(src, tk, ts, te, n, pi, err, d)
      pi[0] = pi[0] + 1
      parse_expr(src, tk, ts, te, n, pi, err, 0, d)
      skip_newlines(tk, n, pi, err)
      return 1
  pi[0] = save
  a_line(d, 47)
  parse_expr(src, tk, ts, te, n, pi, err, 0, d)
  skip_newlines(tk, n, pi, err)
  return 1

def parse_proc(src: var ptr, tk: var array[65536, int], ts: var array[65536, int], te: var array[65536, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], is_extern: int, is_async: int, d: int, skip_hdr: int) -> int
  requires true
  ensures result == 1
  decreases 0
=
  var vis: int = 0
  if is_extern == 0:
    if cur_kind(tk, n, pi, err) == 16:
      vis = 1
      pi[0] = pi[0] + 1
    else:
      if cur_kind(tk, n, pi, err) == 17:
        pi[0] = pi[0] + 1
    if cur_kind(tk, n, pi, err) == 10:
      pi[0] = pi[0] + 1
    else:
      if cur_kind(tk, n, pi, err) == 9:
        err[0] = 1
        pi[0] = pi[0] + 1
      else:
        err[0] = 1
  var pname: int = pi[0]
  pi[0] = pi[0] + 1
  if d == 1:
    if skip_hdr == 0:
      a_line_text_iii(d, src, 4, peek_tk(ts, pname + 0), peek_tk(te, pname + 0), vis, is_extern, is_async)
  parse_type_params(src, tk, ts, te, n, pi, err, d, 1)
  expect_k(tk, n, pi, err, 49)
  skip_param_layout(tk, n, pi, err)
  if cur_kind(tk, n, pi, err) != 50:
    var done: int = 0
    while done == 0:
      parse_param(src, tk, ts, te, n, pi, err, d)
      skip_param_layout(tk, n, pi, err)
      if accept_k(tk, n, pi, err, 55) == 1:
        done = 0
      else:
        done = 1
  skip_param_layout(tk, n, pi, err)
  expect_k(tk, n, pi, err, 50)
  skip_newlines(tk, n, pi, err)
  # raises lists (before and after the ret type) are buffered and emitted as
  # one group after the params,  with the ret type re-parsed afterwards so the
  # dump order (raises then ret) matches the C++ walker.
  var raises_buf: array[16,  int]
  var n_raises: array[1,  int]
  n_raises[0] = 0
  var rb: int = 0
  if cur_kind(tk, n, pi, err) == 31:
    pi[0] = pi[0] + 1
    if cur_kind(tk, n, pi, err) != 4:
      err[0] = 1
    else:
      var rdone: int = 0
      while rdone == 0:
        raises_buf[n_raises[0]] = pi[0]
        n_raises[0] = n_raises[0] + 1
        pi[0] = pi[0] + 1
        if accept_k(tk, n, pi, err, 55) == 1:
          rdone = 0
        else:
          rdone = 1
    skip_newlines(tk, n, pi, err)
  var has_ret: int = 0
  var ret_pi: int = 0
  if accept_k(tk, n, pi, err, 57) == 1:
    has_ret = 1
    ret_pi = pi[0] - 1
    parse_type(src, tk, ts, te, n, pi, err, 0)
  skip_newlines(tk, n, pi, err)
  if cur_kind(tk, n, pi, err) == 31:
    pi[0] = pi[0] + 1
    if cur_kind(tk, n, pi, err) != 4:
      err[0] = 1
    else:
      var rdone: int = 0
      while rdone == 0:
        raises_buf[n_raises[0]] = pi[0]
        n_raises[0] = n_raises[0] + 1
        pi[0] = pi[0] + 1
        if accept_k(tk, n, pi, err, 55) == 1:
          rdone = 0
        else:
          rdone = 1
    skip_newlines(tk, n, pi, err)
  var ri: int = 0
  while ri < n_raises[0]:
    if d == 1:
      a_line_text(d, src, 10, peek_tk(ts, raises_buf[ri]), peek_tk(te, raises_buf[ri]))
    ri = ri + 1
  if has_ret == 1:
    pi[0] = ret_pi
    pi[0] = pi[0] + 1
    parse_type(src, tk, ts, te, n, pi, err, d)
  # The ret-type re-parse rewound pi to the arrow, so re-skip the already
  # buffered raises list (it is still in the token stream) before contracts.
  skip_newlines(tk, n, pi, err)
  if cur_kind(tk, n, pi, err) == 31:
    pi[0] = pi[0] + 1
    if cur_kind(tk, n, pi, err) == 4:
      var rdone: int = 0
      while rdone == 0:
        pi[0] = pi[0] + 1
        if accept_k(tk, n, pi, err, 55) == 1:
          rdone = 0
        else:
          rdone = 1
    skip_newlines(tk, n, pi, err)
  while 1 == 1:
    var ck: int = cur_kind(tk, n, pi, err)
    if ck == 41:
      parse_contract(src, tk, ts, te, n, pi, err, d)
      continue
    if ck == 42:
      parse_contract(src, tk, ts, te, n, pi, err, d)
      continue
    if ck == 43:
      parse_contract(src, tk, ts, te, n, pi, err, d)
      continue
    if ck == 44:
      parse_contract(src, tk, ts, te, n, pi, err, d)
      continue
    if ck == 45:
      parse_contract(src, tk, ts, te, n, pi, err, d)
      continue
    break
  if is_extern == 1:
    skip_newlines(tk, n, pi, err)
    return 1
  expect_k(tk, n, pi, err, 58)
  skip_newlines(tk, n, pi, err)
  parse_block(src, tk, ts, te, n, pi, err, d)
  return 1

def parse_error_decl(src: var ptr, tk: var array[65536, int], ts: var array[65536, int], te: var array[65536, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], d: int) -> int
