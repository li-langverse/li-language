  if d == 1:
    if ai >= 0:
      a_line_text_text(d, src, 1, peek_tk(ts, fi), peek_tk(te, li), peek_tk(ts, ai + 0), peek_tk(te, ai + 0))
    else:
      a_line_text_text(d, src, 1, peek_tk(ts, fi), peek_tk(te, li), peek_tk(ts, fi), peek_tk(te, li))
  return 1

def parse_theorem(src: var ptr, tk: var array[65536, int], ts: var array[65536, int], te: var array[65536, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], is_axiom: int, is_lemma: int, d: int) -> int
