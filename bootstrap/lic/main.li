    pi[0] = pi[0] + 1
    if d == 1:
      a_line_text(d, src, 63, peek_tk(ts, t0 + 0), peek_tk(te, t0 + 0))
    return 1
  err[0] = 1
  return 1

def parse_decorator(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], d: int) -> int
  requires true
  ensures result == 1
  decreases 0
=
  if expect_k(tk, n, pi, err, 76) == 0:
    return 1
  var k: int = cur_kind(tk, n, pi, err)
  if k != 4:
    if k != 33:
      err[0] = 1
      return 1
  var dn: int = pi[0]
  pi[0] = pi[0] + 1
  if d == 1:
    a_line_text(d, src, 8, peek_tk(ts, dn + 0), peek_tk(te, dn + 0))
  if accept_k(tk, n, pi, err, 49) == 1:
    if cur_kind(tk, n, pi, err) != 50:
      var done: int = 0
      while done == 0:
        if cur_kind(tk, n, pi, err) != 4:
          err[0] = 1
          break
        var an: int = pi[0]
        pi[0] = pi[0] + 1
        if d == 1:
          a_line_text(d, src, 9, peek_tk(ts, an + 0), peek_tk(te, an + 0))
        if accept_k(tk, n, pi, err, 58) == 1:
          parse_decorator_value(src, tk, ts, te, n, pi, err, d)
        else:
          if d == 1:
            a_line_text(d, src, 64, peek_tk(ts, an + 0), peek_tk(te, an + 0))
        if accept_k(tk, n, pi, err, 55) == 1:
          done = 0
        else:
          done = 1
    expect_k(tk, n, pi, err, 50)
  return 1

def parse_decorator_list(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], d: int) -> int
  requires true
  ensures result == 1
  decreases 0
=
  skip_newlines(tk, n, pi, err)
  while cur_kind(tk, n, pi, err) == 76:
    parse_decorator(src, tk, ts, te, n, pi, err, d)
    skip_newlines(tk, n, pi, err)
  return 1

# Consumes the tail of a `for` header — `<ident> in <int> ..< <int> [':']` —
# taken right after the `for` keyword. res[0]=iterator token, res[1]=start,
# res[2]=end. Shared by parse_for, parse_parallel_for and the check passes so
# their token consumption cannot drift.
def for_tail(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], res: var array[3, int]) -> int
  requires true
  ensures result == 1
  decreases 0
=
  res[0] = 0
  res[1] = 0
  res[2] = 0
  if cur_kind(tk, n, pi, err) != 4:
    err[0] = 1
  else:
    res[0] = pi[0]
    pi[0] = pi[0] + 1
  if cur_kind(tk, n, pi, err) != 4:
    err[0] = 1
  else:
    if tok_is(src, ts, te, pi[0], "in") == 0:
      err[0] = 1
    else:
      pi[0] = pi[0] + 1
  if cur_kind(tk, n, pi, err) == 5:
    res[1] = int_text_value(src, ts, te, pi[0])
    pi[0] = pi[0] + 1
  if cur_kind(tk, n, pi, err) == 73:
    pi[0] = pi[0] + 1
  else:
    err[0] = 1
  if cur_kind(tk, n, pi, err) == 5:
    res[2] = int_text_value(src, ts, te, pi[0])
    pi[0] = pi[0] + 1
  if cur_kind(tk, n, pi, err) == 56:
    pi[0] = pi[0] + 1
  return 1

def parse_for(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], d: int) -> int
  requires true
  ensures result == 1
  decreases 0
=
  pi[0] = pi[0] + 1
  var fh: array[3, int]
  for_tail(src, tk, ts, te, n, pi, err, fh)
  if d == 1:
    a_line_text_ii(d, src, 43, peek_tk(ts, fh[0] + 0), peek_tk(te, fh[0] + 0), fh[1], fh[2])
  skip_newlines(tk, n, pi, err)
  parse_block(src, tk, ts, te, n, pi, err, d)
  return 1

def parse_parallel_for(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], d: int) -> int
  requires true
  ensures result == 1
  decreases 0
=
  pi[0] = pi[0] + 1
  if consume_for_kw(src, tk, ts, te, n, pi, err) == 0:
    err[0] = 1
  var fh: array[3, int]
  for_tail(src, tk, ts, te, n, pi, err, fh)
  if d == 1:
    a_line_text_ii(d, src, 44, peek_tk(ts, fh[0] + 0), peek_tk(te, fh[0] + 0), fh[1], fh[2])
  skip_newlines(tk, n, pi, err)
  if accept_k(tk, n, pi, err, 2) == 1:
    skip_newlines(tk, n, pi, err)
    while 1 == 1:
      var ck: int = cur_kind(tk, n, pi, err)
      if ck == 41 or ck == 42 or ck == 43 or ck == 44 or ck == 45:
        parse_contract(src, tk, ts, te, n, pi, err, d)
        continue
      break
    expect_k(tk, n, pi, err, 3)
    skip_newlines(tk, n, pi, err)
  if accept_k(tk, n, pi, err, 58) == 1:
    skip_newlines(tk, n, pi, err)
    if cur_kind(tk, n, pi, err) == 2:
      parse_block(src, tk, ts, te, n, pi, err, d)
    else:
      a_line(d, 51)
      a_line(d, 52)
  else:
    a_line(d, 51)
    a_line(d, 52)
  return 1

def parse_stmt(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], d: int) -> int
  requires true
  ensures result == 1
  decreases 0
=
  if cur_kind(tk, n, pi, err) == 76:
    parse_decorator_list(src, tk, ts, te, n, pi, err, d)
    if cur_kind(tk, n, pi, err) == 25:
      pi[0] = pi[0] + 1
      a_line(d, 42)
      parse_expr(src, tk, ts, te, n, pi, err, 0, d)
      if cur_kind(tk, n, pi, err) == 56:
        pi[0] = pi[0] + 1
      skip_newlines(tk, n, pi, err)
      parse_block(src, tk, ts, te, n, pi, err, d)
      return 1
    if cur_kind(tk, n, pi, err) == 4:
      if tok_is(src, ts, te, pi[0], "parallel") == 1:
        parse_parallel_for(src, tk, ts, te, n, pi, err, d)
        return 1
    if cur_kind(tk, n, pi, err) == 26:
      parse_for(src, tk, ts, te, n, pi, err, d)
      return 1
    err[0] = 1
    return 1
  if cur_kind(tk, n, pi, err) == 4:
    if tok_is(src, ts, te, pi[0], "discard") == 1:
      pi[0] = pi[0] + 1
      a_line(d, 47)
      skip_newlines(tk, n, pi, err)
      return 1
    if tok_is(src, ts, te, pi[0], "borrow") == 1:
      pi[0] = pi[0] + 1
      var bm: int = 0
      if cur_kind(tk, n, pi, err) == 4:
        if tok_is(src, ts, te, pi[0], "mut") == 1:
          bm = 1
          pi[0] = pi[0] + 1
        if tok_is(src, ts, te, pi[0], "imm") == 1:
          pi[0] = pi[0] + 1
      if cur_kind(tk, n, pi, err) != 4:
        err[0] = 1
        return 1
      var bname: int = pi[0]
      pi[0] = pi[0] + 1
      if d == 1:
        a_line_text_i(d, src, 49, peek_tk(ts, bname + 0), peek_tk(te, bname + 0), bm)
      expect_k(tk, n, pi, err, 58)
      parse_expr(src, tk, ts, te, n, pi, err, 0, d)
      skip_newlines(tk, n, pi, err)
      return 1
  if cur_kind(tk, n, pi, err) == 20:
    pi[0] = pi[0] + 1
    var vname: int = pi[0]
    pi[0] = pi[0] + 1
    if d == 1:
      a_line_text(d, src, 48, peek_tk(ts, vname + 0), peek_tk(te, vname + 0))
    expect_k(tk, n, pi, err, 56)
    # Heap-mention watch (proc_mentions_heap's VarDecl scan): while a
    # fx def-body walk is in counting mode, a heap-typed local marks the
    # proc (borrowck's effects_check per-proc heap rule).
    if li_rt_preg_get(17, 4) == 1:
      if fx_is_heap(src, ts, te, pi[0]) == 1:
        li_rt_preg_set(17, 3, 1)
    parse_type(src, tk, ts, te, n, pi, err, d)
    if accept_k(tk, n, pi, err, 58) == 1:
      parse_expr(src, tk, ts, te, n, pi, err, 0, d)
    skip_newlines(tk, n, pi, err)
    return 1
  if cur_kind(tk, n, pi, err) == 27:
    pi[0] = pi[0] + 1
    a_line(d, 45)
    skip_newlines(tk, n, pi, err)
    return 1
  if cur_kind(tk, n, pi, err) == 28:
    pi[0] = pi[0] + 1
    a_line(d, 46)
    skip_newlines(tk, n, pi, err)
    return 1
  if cur_kind(tk, n, pi, err) == 26:
    parse_for(src, tk, ts, te, n, pi, err, d)
    return 1
  if cur_kind(tk, n, pi, err) == 25:
    pi[0] = pi[0] + 1
    a_line(d, 42)
    parse_expr(src, tk, ts, te, n, pi, err, 0, d)
    if cur_kind(tk, n, pi, err) == 56:
      pi[0] = pi[0] + 1
    skip_newlines(tk, n, pi, err)
    parse_block(src, tk, ts, te, n, pi, err, d)
    return 1
  if cur_kind(tk, n, pi, err) == 4:
    if tok_is(src, ts, te, pi[0], "parallel") == 1:
      parse_parallel_for(src, tk, ts, te, n, pi, err, d)
      return 1
  if cur_kind(tk, n, pi, err) == 30:
    pi[0] = pi[0] + 1
    a_line(d, 40)
    var kk: int = cur_kind(tk, n, pi, err)
    var kk_start: int = pi[0]
    var rlit: int = -700000
    # Return counting for fx_mir_pass1's E0303 literal-return rule (flag on
    # preg 17.0 during pass1's def-body parse): bare returns count too (C++
    # count_returns), and the single expr-bearing return contributes its
    # folded int literal to preg 17.2 when the expr parse consumed exactly
    # the folded token run (kind 5, or kind 60 + 5). Any other shape leaves
    # the sentinel, which the post-body eval reads as "not a literal".
    if li_rt_preg_get(17, 0) == 1:
      li_rt_preg_set(17, 1, li_rt_preg_get(17, 1) + 1)
      if kk == 5:
        rlit = int_text_value(src, ts, te, kk_start + 0)
      if kk == 60:
        if peek_off(tk, n, pi, 1) == 5:
          rlit = 0 - int_text_value(src, ts, te, kk_start + 1)
    if kk != 1:
      if kk != 3:
        if kk != 0:
          parse_expr(src, tk, ts, te, n, pi, err, 0, d)
    if li_rt_preg_get(17, 0) == 1:
      if li_rt_preg_get(17, 1) == 1:
        var rpd: int = pi[0] - kk_start
        if (kk == 5 and rpd == 1) or (kk == 60 and rpd == 2):
          li_rt_preg_set(17, 2, rlit)
        else:
          li_rt_preg_set(17, 2, -700000)
      else:
        li_rt_preg_set(17, 2, -700000)
    skip_newlines(tk, n, pi, err)
    return 1
  if cur_kind(tk, n, pi, err) == 22:
    pi[0] = pi[0] + 1
    a_line(d, 41)
    parse_expr(src, tk, ts, te, n, pi, err, 0, d)
    # Expected-colon shape (C++ parser.cpp parse_stmt: expect(Colon, "':'")
    # right after the if/elif chain's condition): parse_expr stops at the
    # first non-expr token, so anything that is not the kind-56 colon here
    # is exactly the broken shape the C++ host rejects as parse error.
    # latched on preg 22 (free slot; 14-22 unused, 23 = E0304 fire) so the
    # fx pipeline's own err[0] scratch channel stays untouched.
    if cur_kind(tk, n, pi, err) != 56:
      li_rt_preg_set(22, 0, 1)
    expect_k(tk, n, pi, err, 56)
    skip_newlines(tk, n, pi, err)
    parse_block(src, tk, ts, te, n, pi, err, d)
    var nelif: array[1,  int]
    nelif[0] = 0
    var tail_done: int = 0
    while tail_done == 0:
      skip_newlines(tk, n, pi, err)
      if cur_kind(tk, n, pi, err) == 24:
        nelif[0] = nelif[0] + 1
        a_line(d, 51)
        a_line(d, 41)
        pi[0] = pi[0] + 1
        parse_expr(src, tk, ts, te, n, pi, err, 0, d)
        expect_k(tk, n, pi, err, 56)
        skip_newlines(tk, n, pi, err)
        parse_block(src, tk, ts, te, n, pi, err, d)
      else:
        if cur_kind(tk, n, pi, err) == 23:
          pi[0] = pi[0] + 1
          expect_k(tk, n, pi, err, 56)
          skip_newlines(tk, n, pi, err)
          parse_block(src, tk, ts, te, n, pi, err, d)
          tail_done = 1
        else:
          tail_done = 1
    var ci: int = 0
    while ci < nelif[0]:
      a_line(d, 52)
      ci = ci + 1
    return 1
  var save: int = pi[0]
  var ok: int = parse_primary(src, tk, ts, te, n, pi, err, 0)
  if ok == 1:
    ok = parse_postfix(src, tk, ts, te, n, pi, err, 0)
  if ok == 1:
    if accept_k(tk, n, pi, err, 58) == 1:
      a_line(d, 50)
      pi[0] = save
      parse_primary(src, tk, ts, te, n, pi, err, d)
      parse_postfix(src, tk, ts, te, n, pi, err, d)
      pi[0] = pi[0] + 1
      parse_expr(src, tk, ts, te, n, pi, err, 0, d)
      skip_newlines(tk, n, pi, err)
      return 1
  pi[0] = save
  a_line(d, 47)
  parse_expr(src, tk, ts, te, n, pi, err, 0, d)
  skip_newlines(tk, n, pi, err)
  return 1

def parse_proc(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], is_extern: int, is_async: int, d: int, skip_hdr: int) -> int
  requires true
  ensures result == 1
  decreases 0
=
  var vis: int = 0
  if is_extern == 0:
    if cur_kind(tk, n, pi, err) == 16:
      vis = 1
      pi[0] = pi[0] + 1
    else:
      if cur_kind(tk, n, pi, err) == 17:
        pi[0] = pi[0] + 1
    if cur_kind(tk, n, pi, err) == 10:
      pi[0] = pi[0] + 1
    else:
      if cur_kind(tk, n, pi, err) == 9:
        err[0] = 1
        pi[0] = pi[0] + 1
      else:
        err[0] = 1
  var pname: int = pi[0]
  pi[0] = pi[0] + 1
  if d == 1:
    if skip_hdr == 0:
      a_line_text_iii(d, src, 4, peek_tk(ts, pname + 0), peek_tk(te, pname + 0), vis, is_extern, is_async)
  parse_type_params(src, tk, ts, te, n, pi, err, d, 1)
  expect_k(tk, n, pi, err, 49)
  skip_param_layout(tk, n, pi, err)
  if cur_kind(tk, n, pi, err) != 50:
    var done: int = 0
    while done == 0:
      parse_param(src, tk, ts, te, n, pi, err, d)
      skip_param_layout(tk, n, pi, err)
      if accept_k(tk, n, pi, err, 55) == 1:
        done = 0
      else:
        done = 1
  skip_param_layout(tk, n, pi, err)
  expect_k(tk, n, pi, err, 50)
  skip_newlines(tk, n, pi, err)
  # raises lists (before and after the ret type) are buffered and emitted as
  # one group after the params,  with the ret type re-parsed afterwards so the
  # dump order (raises then ret) matches the C++ walker.
  var raises_buf: array[16,  int]
  var n_raises: array[1,  int]
  n_raises[0] = 0
  var rb: int = 0
  if cur_kind(tk, n, pi, err) == 31:
    pi[0] = pi[0] + 1
    if cur_kind(tk, n, pi, err) != 4:
      err[0] = 1
    else:
      var rdone: int = 0
      while rdone == 0:
        raises_buf[n_raises[0]] = pi[0]
        n_raises[0] = n_raises[0] + 1
        pi[0] = pi[0] + 1
        if accept_k(tk, n, pi, err, 55) == 1:
          rdone = 0
        else:
          rdone = 1
    skip_newlines(tk, n, pi, err)
  var has_ret: int = 0
  var ret_pi: int = 0
  if accept_k(tk, n, pi, err, 57) == 1:
    has_ret = 1
    ret_pi = pi[0] - 1
    parse_type(src, tk, ts, te, n, pi, err, 0)
  skip_newlines(tk, n, pi, err)
  if cur_kind(tk, n, pi, err) == 31:
    pi[0] = pi[0] + 1
    if cur_kind(tk, n, pi, err) != 4:
      err[0] = 1
    else:
      var rdone: int = 0
      while rdone == 0:
        raises_buf[n_raises[0]] = pi[0]
        n_raises[0] = n_raises[0] + 1
        pi[0] = pi[0] + 1
        if accept_k(tk, n, pi, err, 55) == 1:
          rdone = 0
        else:
          rdone = 1
    skip_newlines(tk, n, pi, err)
  var ri: int = 0
  while ri < n_raises[0]:
    if d == 1:
      a_line_text(d, src, 10, peek_tk(ts, raises_buf[ri]), peek_tk(te, raises_buf[ri]))
    ri = ri + 1
  if has_ret == 1:
    pi[0] = ret_pi
    pi[0] = pi[0] + 1
    parse_type(src, tk, ts, te, n, pi, err, d)
  # The ret-type re-parse rewound pi to the arrow, so re-skip the already
  # buffered raises list (it is still in the token stream) before contracts.
  skip_newlines(tk, n, pi, err)
  if cur_kind(tk, n, pi, err) == 31:
    pi[0] = pi[0] + 1
    if cur_kind(tk, n, pi, err) == 4:
      var rdone: int = 0
      while rdone == 0:
        pi[0] = pi[0] + 1
        if accept_k(tk, n, pi, err, 55) == 1:
          rdone = 0
        else:
          rdone = 1
    skip_newlines(tk, n, pi, err)
  while 1 == 1:
    var ck: int = cur_kind(tk, n, pi, err)
    if ck == 41:
      parse_contract(src, tk, ts, te, n, pi, err, d)
      continue
    if ck == 42:
      parse_contract(src, tk, ts, te, n, pi, err, d)
      continue
    if ck == 43:
      parse_contract(src, tk, ts, te, n, pi, err, d)
      continue
    if ck == 44:
      parse_contract(src, tk, ts, te, n, pi, err, d)
      continue
    if ck == 45:
      parse_contract(src, tk, ts, te, n, pi, err, d)
      continue
    break
  if is_extern == 1:
    skip_newlines(tk, n, pi, err)
    return 1
  expect_k(tk, n, pi, err, 58)
  skip_newlines(tk, n, pi, err)
  parse_block(src, tk, ts, te, n, pi, err, d)
  return 1

def parse_error_decl(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], d: int) -> int
  requires true
  ensures result == 1
  decreases 0
=
  pi[0] = pi[0] + 1
  if cur_kind(tk, n, pi, err) != 4:
    err[0] = 1
    return 1
  var en: int = pi[0]
  pi[0] = pi[0] + 1
  expect_k(tk, n, pi, err, 56)
  if cur_kind(tk, n, pi, err) != 8:
    err[0] = 1
    return 1
  var et: int = pi[0]
  pi[0] = pi[0] + 1
  if d == 1:
    a_line_text_text(d, src, 2, peek_tk(ts, en + 0), peek_tk(te, en + 0), peek_tk(ts, et + 0), peek_tk(te, et + 0))
  return 1

def parse_import(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], d: int) -> int
  requires true
  ensures result == 1
  decreases 0
=
  expect_k(tk, n, pi, err, 18)
  if cur_kind(tk, n, pi, err) != 4:
    err[0] = 1
    return 1
  var fi: int = pi[0]
  var li: int = pi[0]
  pi[0] = pi[0] + 1
  while accept_k(tk, n, pi, err, 72) == 1:
    if cur_kind(tk, n, pi, err) != 4:
      err[0] = 1
      break
    li = pi[0]
    pi[0] = pi[0] + 1
  var ai: int = -1
  if cur_kind(tk, n, pi, err) == 4:
    if tok_is(src, ts, te, pi[0], "as") == 1:
      pi[0] = pi[0] + 1
      if cur_kind(tk, n, pi, err) != 4:
        err[0] = 1
      else:
        ai = pi[0]
        pi[0] = pi[0] + 1
  if d == 1:
    if ai >= 0:
      a_line_text_text(d, src, 1, peek_tk(ts, fi), peek_tk(te, li), peek_tk(ts, ai + 0), peek_tk(te, ai + 0))
    else:
      a_line_text_text(d, src, 1, peek_tk(ts, fi), peek_tk(te, li), peek_tk(ts, fi), peek_tk(te, li))
  return 1

def parse_theorem(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], is_axiom: int, is_lemma: int, d: int) -> int
  requires true
  ensures result == 1
  decreases 0
=
  var tn: int = pi[0]
  pi[0] = pi[0] + 1
  if d == 1:
    a_line_text_ii(d, src, 3, peek_tk(ts, tn + 0), peek_tk(te, tn + 0), is_axiom, is_lemma)
  if accept_k(tk, n, pi, err, 49) == 1:
    skip_param_layout(tk, n, pi, err)
    if cur_kind(tk, n, pi, err) != 50:
      var done: int = 0
      while done == 0:
        parse_param(src, tk, ts, te, n, pi, err, d)
        skip_param_layout(tk, n, pi, err)
        if accept_k(tk, n, pi, err, 55) == 1:
          done = 0
        else:
          done = 1
    skip_param_layout(tk, n, pi, err)
    expect_k(tk, n, pi, err, 50)
  skip_newlines(tk, n, pi, err)
  expect_k(tk, n, pi, err, 56)
  parse_contract_expr(src, tk, ts, te, n, pi, err, d)
  skip_newlines(tk, n, pi, err)
  return 1

def parse_trait_method(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], d: int) -> int
  requires true
  ensures result == 1
  decreases 0
=
  var vis: int = 0
  if cur_kind(tk, n, pi, err) == 16:
    vis = 1
    pi[0] = pi[0] + 1
  else:
    if cur_kind(tk, n, pi, err) == 17:
      pi[0] = pi[0] + 1
  if cur_kind(tk, n, pi, err) == 10:
    pi[0] = pi[0] + 1
  else:
    if cur_kind(tk, n, pi, err) == 9:
      err[0] = 1
      pi[0] = pi[0] + 1
      return 1
    err[0] = 1
    return 1
  var tn: int = pi[0]
  pi[0] = pi[0] + 1
  if d == 1:
    a_line_text_iii(d, src, 4, peek_tk(ts, tn + 0), peek_tk(te, tn + 0), vis, 0, 0)
  expect_k(tk, n, pi, err, 49)
  skip_param_layout(tk, n, pi, err)
  if cur_kind(tk, n, pi, err) != 50:
    var done: int = 0
    while done == 0:
      parse_param(src, tk, ts, te, n, pi, err, d)
      skip_param_layout(tk, n, pi, err)
      if accept_k(tk, n, pi, err, 55) == 1:
        done = 0
      else:
        done = 1
  skip_param_layout(tk, n, pi, err)
  expect_k(tk, n, pi, err, 50)
  if accept_k(tk, n, pi, err, 57) == 1:
    parse_type(src, tk, ts, te, n, pi, err, d)
  skip_newlines(tk, n, pi, err)
  while 1 == 1:
    var ck: int = cur_kind(tk, n, pi, err)
    if ck == 41:
      parse_contract(src, tk, ts, te, n, pi, err, d)
      continue
    if ck == 42:
      parse_contract(src, tk, ts, te, n, pi, err, d)
      continue
    if ck == 43:
      parse_contract(src, tk, ts, te, n, pi, err, d)
      continue
    if ck == 44:
      parse_contract(src, tk, ts, te, n, pi, err, d)
      continue
    if ck == 45:
      parse_contract(src, tk, ts, te, n, pi, err, d)
      continue
    break
  skip_newlines(tk, n, pi, err)
  return 1

def parse_trait_methods(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], d: int) -> int
  requires true
  ensures result == 1
  decreases 0
=
  skip_newlines(tk, n, pi, err)
  while 1 == 1:
    var k: int = cur_kind(tk, n, pi, err)
    if k == 16:
      parse_trait_method(src, tk, ts, te, n, pi, err, d)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 17:
      parse_trait_method(src, tk, ts, te, n, pi, err, d)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 10:
      parse_trait_method(src, tk, ts, te, n, pi, err, d)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 9:
      parse_trait_method(src, tk, ts, te, n, pi, err, d)
      skip_newlines(tk, n, pi, err)
      continue
    break
  return 1

def parse_type_fields(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], d: int) -> int
  requires true
  ensures result == 1
  decreases 0
=
  skip_newlines(tk, n, pi, err)
  while 1 == 1:
    var k: int = cur_kind(tk, n, pi, err)
    if k != 16:
      if k != 17:
        if k != 4:
          break
        if peek_off(tk, n, pi, 1) != 56:
          break
    if k == 16:
      if peek_off(tk, n, pi, 1) == 10:
        break
    if k == 17:
      if peek_off(tk, n, pi, 1) == 10:
        break
    var vis: int = 0
    if k == 16:
      vis = 1
      pi[0] = pi[0] + 1
    else:
      if k == 17:
        pi[0] = pi[0] + 1
    if cur_kind(tk, n, pi, err) != 4:
      err[0] = 1
      break
    var fn: int = pi[0]
    pi[0] = pi[0] + 1
    expect_k(tk, n, pi, err, 56)
    # NotRequired[T] unwraps to T with optional=1 (mirrors the C++
    # parse_type_fields post-processing); a leading `var` on the outer type
    # is dropped exactly like the C++ unwrap of the first type argument.
    var opt: int = 0
    var is_nr: int = 0
    var pi0: int = pi[0]
    if cur_kind(tk, n, pi, err) == 20:
      pi0 = pi[0] + 1
    if peek_off(tk, n, pi, pi0 - pi[0]) == 4:
      if peek_off(tk, n, pi, pi0 - pi[0] + 1) == 51:
        if tok_is(src, ts, te, pi0, "NotRequired") == 1:
          is_nr = 1
          opt = 1
    if d == 1:
      a_line_text_ii(d, src, 27, peek_tk(ts, fn), peek_tk(te, fn), opt, vis)
    if is_nr == 1:
      if cur_kind(tk, n, pi, err) == 20:
        pi[0] = pi[0] + 1
      pi[0] = pi[0] + 1
      pi[0] = pi[0] + 1
      opt = 1
      parse_type(src, tk, ts, te, n, pi, err, d)
      while cur_kind(tk, n, pi, err) != 52:
        if accept_k(tk, n, pi, err, 55) == 1:
          parse_type(src, tk, ts, te, n, pi, err, 0)
        else:
          break
      expect_k(tk, n, pi, err, 52)
    else:
      parse_type(src, tk, ts, te, n, pi, err, d)
    skip_newlines(tk, n, pi, err)
  return 1

def emit_tp_lines(d: int, src: var ptr, ts: var array[262144, int], te: var array[262144, int], tbuf: var array[16, int], ntp: var array[1, int]) -> int
  requires true
  ensures result == 0
  decreases 0
=
  var ti: int = 0
  while ti < ntp[0]:
    if d == 1:
      a_line_text_t(d, src, 5, peek_tk(ts, tbuf[ti] + 0), peek_tk(te, tbuf[ti] + 0))
    ti = ti + 1
  return 0

def parse_type_alias(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], d: int) -> int
  requires true
  ensures result == 1
  decreases 0
=
  expect_k(tk, n, pi, err, 11)
  var an: int = pi[0]
  pi[0] = pi[0] + 1
  var tbuf: array[16, int]
  var ntp: array[1, int]
  ntp[0] = 0
  if accept_k(tk, n, pi, err, 51) == 1:
    if cur_kind(tk, n, pi, err) != 52:
      var done: int = 0
      while done == 0:
        if cur_kind(tk, n, pi, err) != 4:
          err[0] = 1
          break
        tbuf[ntp[0]] = pi[0]
        # Generic binder names (`def f[T: Trait](p: T)`) are registrable
        # param types that never resolve to an object layout in C++
        # (g_object_types has no entry for type mum vars). Registered next
        # to trait alias names so the collector's no-flatten gate consults
        # one roster for both shapes.
        li_rt_mir_trait_add(src, peek_tk(ts, pi[0] + 0), peek_tk(te, pi[0] + 0))
        ntp[0] = ntp[0] + 1
        pi[0] = pi[0] + 1
        if accept_k(tk, n, pi, err, 56) == 1:
          if cur_kind(tk, n, pi, err) != 4:
            err[0] = 1
          else:
            pi[0] = pi[0] + 1
        if accept_k(tk, n, pi, err, 55) == 1:
          done = 0
        else:
          done = 1
    expect_k(tk, n, pi, err, 52)
  expect_k(tk, n, pi, err, 58)
  skip_newlines(tk, n, pi, err)
  if cur_kind(tk, n, pi, err) == 4:
    if tok_is(src, ts, te, pi[0], "typedict") == 1:
      pi[0] = pi[0] + 1
      if d == 1:
        a_line_text_i_text(d, src, 80, peek_tk(ts, an + 0), peek_tk(te, an + 0), 1, 0, 0)
      emit_tp_lines(d, src, ts, te, tbuf, ntp)
      skip_newlines(tk, n, pi, err)
      parse_type_fields(src, tk, ts, te, n, pi, err, d)
      skip_newlines(tk, n, pi, err)
      return 1
  if cur_kind(tk, n, pi, err) == 19:
    pi[0] = pi[0] + 1
    if d == 1:
      a_line_text_i_text(d, src, 80, peek_tk(ts, an + 0), peek_tk(te, an + 0), 2, 0, 0)
    emit_tp_lines(d, src, ts, te, tbuf, ntp)
    skip_newlines(tk, n, pi, err)
    while cur_kind(tk, n, pi, err) == 4:
      if tok_is(src, ts, te, pi[0], "proc") == 1:
        break
      if tok_is(src, ts, te, pi[0], "def") == 1:
        break
      if tok_is(src, ts, te, pi[0], "type") == 1:
        break
      if tok_is(src, ts, te, pi[0], "import") == 1:
        break
      if d == 1:
        a_line_text(d, src, 81, peek_tk(ts, pi[0]), peek_tk(te, pi[0]))
      pi[0] = pi[0] + 1
      skip_newlines(tk, n, pi, err)
    return 1
  if cur_kind(tk, n, pi, err) == 4:
    if tok_is(src, ts, te, pi[0], "trait") == 1:
      pi[0] = pi[0] + 1
      # Trait/generic-type roster (C++ parity): the arg collector must not
      # whole-object-flatten args whose callee param carries a trait name.
      # Registered per walker parse; harmless for ast/tc paths (unused).
      li_rt_mir_trait_add(src, peek_tk(ts, an + 0), peek_tk(te, an + 0))
      if d == 1:
        a_line_text_i_text(d, src, 80, peek_tk(ts, an + 0), peek_tk(te, an + 0), 4, 0, 0)
      emit_tp_lines(d, src, ts, te, tbuf, ntp)
      skip_newlines(tk, n, pi, err)
      parse_trait_methods(src, tk, ts, te, n, pi, err, d)
      skip_newlines(tk, n, pi, err)
      return 1
  if cur_kind(tk, n, pi, err) == 15:
    pi[0] = pi[0] + 1
    skip_newlines(tk, n, pi, err)
    var base_t: int = -1
    if cur_kind(tk, n, pi, err) == 4:
      if tok_is(src, ts, te, pi[0], "of") == 1:
        pi[0] = pi[0] + 1
        if cur_kind(tk, n, pi, err) != 4:
          err[0] = 1
        else:
          base_t = pi[0]
          pi[0] = pi[0] + 1
        skip_newlines(tk, n, pi, err)
    if d == 1:
      if base_t >= 0:
        a_line_text_i_text(d, src, 80, peek_tk(ts, an + 0), peek_tk(te, an + 0), 3, peek_tk(ts, base_t + 0), peek_tk(te, base_t + 0))
      else:
        a_line_text_i_text(d, src, 80, peek_tk(ts, an + 0), peek_tk(te, an + 0), 3, 0, 0)
    emit_tp_lines(d, src, ts, te, tbuf, ntp)
    parse_type_fields(src, tk, ts, te, n, pi, err, d)
    skip_newlines(tk, n, pi, err)
    return 1
  if d == 1:
    a_line_text_i_text(d, src, 80, peek_tk(ts, an + 0), peek_tk(te, an + 0), 0, 0, 0)
  emit_tp_lines(d, src, ts, te, tbuf, ntp)
  parse_type(src, tk, ts, te, n, pi, err, d)
  skip_newlines(tk, n, pi, err)
  return 1

def parse_module(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], d: int) -> int
  requires true
  ensures result == 1
  decreases 0
=
  skip_newlines(tk, n, pi, err)
  while 1 == 1:
    var k: int = cur_kind(tk, n, pi, err)
    if k == 0:
      break
    if k == 18:
      parse_import(src, tk, ts, te, n, pi, err, d)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 32:
      pi[0] = pi[0] + 1
      var k2: int = cur_kind(tk, n, pi, err)
      if k2 == 10:
        pi[0] = pi[0] + 1
      else:
        if k2 == 9:
          err[0] = 1
          li_rt_emit_err(900)
          pi[0] = pi[0] + 1
        else:
          err[0] = 1
          return 1
      parse_proc(src, tk, ts, te, n, pi, err, 1, 0, d, 0)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 33:
      pi[0] = pi[0] + 1
      parse_proc(src, tk, ts, te, n, pi, err, 0, 1, d, 0)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 76:
      var save0: int = pi[0]
      parse_decorator_list(src, tk, ts, te, n, pi, err, 0)
      var dpos: int = pi[0]
      if at_fn_kw(tk, n, pi, err) == 0:
        err[0] = 1
        return 1
      var dvis: int = 0
      var dk: int = cur_kind(tk, n, pi, err)
      if dk == 16:
        dvis = 1
      if d == 1:
        var nm: int = dpos + 1
        if dk == 16:
          nm = dpos + 2
        if dk == 17:
          nm = dpos + 2
        a_line_text_iii(d, src, 4, peek_tk(ts, nm + 0), peek_tk(te, nm + 0), dvis, 0, 0)
      pi[0] = save0
      parse_decorator_list(src, tk, ts, te, n, pi, err, d)
      pi[0] = dpos
      parse_proc(src, tk, ts, te, n, pi, err, 0, 0, d, 1)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 16:
      if peek_off(tk, n, pi, 1) == 10:
        parse_proc(src, tk, ts, te, n, pi, err, 0, 0, d, 0)
        skip_newlines(tk, n, pi, err)
        continue
      err[0] = 1
      return 1
    if k == 17:
      if peek_off(tk, n, pi, 1) == 10:
        parse_proc(src, tk, ts, te, n, pi, err, 0, 0, d, 0)
        skip_newlines(tk, n, pi, err)
        continue
      err[0] = 1
      return 1
    if k == 10:
      parse_proc(src, tk, ts, te, n, pi, err, 0, 0, d, 0)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 9:
      err[0] = 1
      li_rt_emit_err(900)
      li_rt_emit_err(900)
      pi[0] = pi[0] + 1
      skip_newlines(tk, n, pi, err)
      continue
    if k == 11:
      parse_type_alias(src, tk, ts, te, n, pi, err, d)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 29:
      parse_error_decl(src, tk, ts, te, n, pi, err, d)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 12:
      pi[0] = pi[0] + 1
      parse_theorem(src, tk, ts, te, n, pi, err, 1, 0, d)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 13:
      pi[0] = pi[0] + 1
      parse_theorem(src, tk, ts, te, n, pi, err, 0, 0, d)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 14:
      pi[0] = pi[0] + 1
      parse_theorem(src, tk, ts, te, n, pi, err, 0, 1, d)
      skip_newlines(tk, n, pi, err)
      continue
    err[0] = 1
    return 1
  return 1

# -------------------------------------------------- Layer 4: typechecker --
# `check <file>` is the first slice of the self-hosted typechecker. It walks
# the token stream a second time (the parser already validated structure) and
# enforces the rules the C++ typechecker applies to the typecheck + generics
# corpus:
#   - name resolution: calls to unknown procs, arity, unknown idents
#   - type unification: binop numeric mixing (int+float, int32+int64),
#     return-type match (incl. generic params)
#   - contract well-formedness: E0301/E0302 requires/ensures presence, E0303
#     `ensures true` on a value-returning non-extern proc
# Verdict parity (exit 0/1) is gated by scripts/check_li_check_parity.sh.
#
# Type codes: 0 int, 1 float, 2 str, 3 bool, 4 binary, 5 ptr, 6 unit,
# 7 array, 8 tuple, 9 protocol, 10 callable, 11 typedict, 12 refinement,
# 13 generic, 14 unknown.
#
# Symbol table is threaded as parameters (Li has no module-level vars):
#   sym_s/sym_e: name token indices; sym_kind: 0=type,1=proc,2=param,3=local
#   sym_ty: type code (proc: return type; alias: kind)
#   sym_aux: proc arity / (unused); sym_n: count

# ---- type-name classification (returns a type code, or 14 unknown) ----
def tc_prim_type(src: var ptr, ts: var array[262144, int], te: var array[262144, int], i: int) -> int
  requires true
  ensures result >= 0
  decreases 0
=
  if tok_is(src, ts, te, i, "int") == 1:
    return 0
  if tok_is(src, ts, te, i, "int64") == 1:
    return 0
  if tok_is(src, ts, te, i, "float") == 1:
    return 1
  if tok_is(src, ts, te, i, "float64") == 1:
    return 1
  if tok_is(src, ts, te, i, "str") == 1:
    return 2
  if tok_is(src, ts, te, i, "bool") == 1:
    return 3
  if tok_is(src, ts, te, i, "binary") == 1:
    return 4
  if tok_is(src, ts, te, i, "ptr") == 1:
    return 5
  if tok_is(src, ts, te, i, "unit") == 1:
    return 6
  if tok_is(src, ts, te, i, "tuple") == 1:
    return 8
  if tok_is(src, ts, te, i, "array") == 1:
    return 7
  if tok_is(src, ts, te, i, "int32") == 1:
    return 15
  if tok_is(src, ts, te, i, "uint8") == 1:
    return 16
  if tok_is(src, ts, te, i, "float32") == 1:
    return 17
  if tok_is(src, ts, te, i, "float8") == 1:
    return 18
  return 14

# Numeric family: 0 = int-family, 1 = float-family, -1 = not numeric.
def tc_family_of(t: int) -> int
  requires true
  ensures result >= -1
  decreases 0
=
  if t == 0:
    return 0
  if t >= 20000:
    return 0
  if t == 15:
    return 0
  if t == 16:
    return 0
  if t == 1:
    return 1
  if t == 17:
    return 1
  if t == 18:
    return 1
  return -1

def tc_is_int(t: int) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  if t == 0:
    return 1
  if t >= 20000:
    return 1
  if t == 15:
    return 1
  if t == 16:
    return 1
  return 0

def tc_is_float(t: int) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  if t == 1:
    return 1
  if t == 17:
    return 1
  if t == 18:
    return 1
  return 0

def tc_is_unsigned(t: int) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  if t == 16:
    return 1
  return 0

def tc_bits(t: int) -> int
  requires true
  ensures result >= -1
  decreases 0
=
  if t == 0:
    return 64
  if t >= 20000:
    return 64
  if t == 1:
    return 64
  if t == 15:
    return 32
  if t == 16:
    return 8
  if t == 17:
    return 32
  if t == 18:
    return 8
  return -1

def tc_refine_bound(src: var ptr, ts: var array[262144, int], te: var array[262144, int], tk: var array[262144, int], n: var array[1, int], vn: int, a: int, b: int) -> int
  requires true
  ensures result >= -1
  decreases 0
=
  # Extract the refinement's upper bound like typecheck.cpp
  # collect_refinement_bounds: an Ident(v) `<` IntLit conjunct inside the
  # predicate span sets the bound (last match wins, mirroring the C++
  # conjunction walk). -1 when the predicate carries no bound.
  var i: int = b - 3
  var best: int = -1
  while i >= a:
    if peek_tk(tk, i) == 4:
      if tok_eq(src, ts, te, i, vn) == 1:
        if i + 2 < b:
          if tok_is(src, ts, te, i + 1, "<") == 1:
            if peek_tk(tk, i + 2) == 5:
              best = int_text_value(src, ts, te, i + 2)
    i = i - 1
  return best

def tc_local_row(src: var ptr, ts: var array[262144, int], te: var array[262144, int], sym_s: var array[8192, int], sym_kind: var array[8192, int], sym_buf: var array[8192, ptr], sym_b0: var array[8192, int], sym_b1: var array[8192, int], sym_n: var array[1, int], i: int) -> int
  requires true
  ensures result >= -1
  decreases 0
=
  # Most-recent local/param row matching the token text (mirror of
  # tc_local_type's scan: Kind 2 params, Kind 3 locals).
  var k: int = sym_n[0] - 1
  while k >= 0:
    if sym_kind[k] == 2 or sym_kind[k] == 3:
      var m: int = 0
      if li_rt_str_eq(sym_buf[k], src) == 1:
        m = tok_eq(src, ts, te, sym_s[k], i)
      if li_rt_str_eq(sym_buf[k], src) == 0:
        m = fx_span_eq(sym_buf[k], sym_b0[k], sym_b1[k], src, peek_tk(ts, i), peek_tk(te, i))
      if m == 1:
        return k
    k = k - 1
  return -1

def tc_mark_bound_name(src: var ptr, ts: var array[262144, int], te: var array[262144, int], sym_s: var array[8192, int], sym_kind: var array[8192, int], sym_ty: var array[8192, int], sym_buf: var array[8192, ptr], sym_b0: var array[8192, int], sym_b1: var array[8192, int], sym_n: var array[1, int], name_tok: int, bound: int) -> int
  requires true
  ensures result == 0
  decreases 0
=
  # Bounded-index marking for while-guards (C++: locals[v].bounded_index =
  # true, array_size = rhs). Overwrites the row's type code with 20000+bound
  # when the ident resolves to a param/local int row.
  var k: int = sym_n[0] - 1
  while k >= 0:
    if sym_kind[k] == 2 or sym_kind[k] == 3:
      var m: int = 0
      if li_rt_str_eq(sym_buf[k], src) == 1:
        m = tok_eq(src, ts, te, sym_s[k], name_tok)
      if li_rt_str_eq(sym_buf[k], src) == 0:
        m = fx_span_eq(sym_buf[k], sym_b0[k], sym_b1[k], src, peek_tk(ts, name_tok), peek_tk(te, name_tok))
      if m == 1:
        if sym_ty[k] >= 0:
          if sym_ty[k] < 20000:
            sym_ty[k] = 20000 + bound
        return 0
    k = k - 1
  return 0

# ---- type parsing (returns a type code; consumes tokens) ----
def tc_parse_type(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], sym_s: var array[8192, int], sym_kind: var array[8192, int], sym_ty: var array[8192, int], sym_buf: var array[8192, ptr], sym_b0: var array[8192, int], sym_b1: var array[8192, int], sym_n: var array[1, int]) -> int
  requires true
  ensures result >= 0
  decreases 0
=
  if cur_kind(tk, n, pi, err) == 53:
    pi[0] = pi[0] + 1
    if cur_kind(tk, n, pi, err) != 4:
      err[0] = 1
      return 14
    var rv: int = pi[0]
    pi[0] = pi[0] + 1
    expect_k(tk, n, pi, err, 56)
    var bt: int = tc_parse_type(src, tk, ts, te, n, pi, err, sym_s, sym_kind, sym_ty, sym_buf, sym_b0, sym_b1, sym_n)
    expect_k(tk, n, pi, err, 74)
    # A refinement int encodes the extracted upper bound as 20000+N
    # (bounded index, typecheck.cpp resolve_type_expr Refinement). No
    # extractable bound keeps the plain int code (bounded_index unset —
    # the index gate must still fire).
    var p0: int = pi[0]
    parse_contract_expr(src, tk, ts, te, n, pi, err, 0)
    expect_k(tk, n, pi, err, 54)
    if bt == 0:
      var ub: int = tc_refine_bound(src, ts, te, tk, n, rv, p0, pi[0])
      if ub >= 0:
        return 20000 + ub
    return bt
  if cur_kind(tk, n, pi, err) == 20:
    pi[0] = pi[0] + 1
  if cur_kind(tk, n, pi, err) == 47:
    pi[0] = pi[0] + 1
    return 9
  if cur_kind(tk, n, pi, err) == 48:
    pi[0] = pi[0] + 1
    if accept_k(tk, n, pi, err, 51) == 1:
      if accept_k(tk, n, pi, err, 51) == 0:
        err[0] = 1
        return 14
      if cur_kind(tk, n, pi, err) != 52:
        var done: int = 0
        while done == 0:
          tc_parse_type(src, tk, ts, te, n, pi, err, sym_s, sym_kind, sym_ty, sym_buf, sym_b0, sym_b1, sym_n)
          if accept_k(tk, n, pi, err, 55) == 1:
            done = 0
          else:
            done = 1
      expect_k(tk, n, pi, err, 52)
      expect_k(tk, n, pi, err, 55)
      tc_parse_type(src, tk, ts, te, n, pi, err, sym_s, sym_kind, sym_ty, sym_buf, sym_b0, sym_b1, sym_n)
      expect_k(tk, n, pi, err, 52)
    return 10
  if cur_kind(tk, n, pi, err) != 4:
    err[0] = 1
    return 14
  var t0: int = pi[0]
  pi[0] = pi[0] + 1
  var base: int = tc_prim_type(src, ts, te, t0)
  if base == 7:
    if accept_k(tk, n, pi, err, 51) == 1:
      var sz: int = -1
      if cur_kind(tk, n, pi, err) == 5:
        sz = int_text_value(src, ts, te, pi[0])
        pi[0] = pi[0] + 1
      else:
        # array-of-types or list[T]-style bracket group: named fields and
        # variadic tokens inside the group strand tokens the same way the
        # tuple branch did, so pre-consume them here too.
        if cur_kind(tk, n, pi, err) == 75:
          pi[0] = pi[0] + 1
        if cur_kind(tk, n, pi, err) == 4:
          if peek_off(tk, n, pi, 1) == 56:
            pi[0] = pi[0] + 2
        tc_parse_type(src, tk, ts, te, n, pi, err, sym_s, sym_kind, sym_ty, sym_buf, sym_b0, sym_b1, sym_n)
        expect_k(tk, n, pi, err, 55)
        tc_parse_type(src, tk, ts, te, n, pi, err, sym_s, sym_kind, sym_ty, sym_buf, sym_b0, sym_b1, sym_n)
        expect_k(tk, n, pi, err, 52)
        return 7
      expect_k(tk, n, pi, err, 55)
      tc_parse_type(src, tk, ts, te, n, pi, err, sym_s, sym_kind, sym_ty, sym_buf, sym_b0, sym_b1, sym_n)
      expect_k(tk, n, pi, err, 52)
      if sz >= 0:
        return 1000 + sz
      return 7
    return 7
  if base == 8:
    if accept_k(tk, n, pi, err, 51) == 1:
      if cur_kind(tk, n, pi, err) != 52:
        var done: int = 0
        while done == 0:
          # tuple args may be variadic (`tuple[int, ...]`) or named fields
          # (`tuple[x: float, y: float]`); the bare tc_parse_type call
          # stranded the `...` / field `:` tokens and desynced the register
          # walk (walker-only rejects on the collections corpus).
          if cur_kind(tk, n, pi, err) == 75:
            # `tuple[int, ...]`: the ellipsis is the last element of the
            # group; after it only `]` may follow, so skip the element
            # parse here and let the post-loop `]` check close the group.
            pi[0] = pi[0] + 1
            skip_newlines(tk, n, pi, err)
            done = 1
          else:
            if cur_kind(tk, n, pi, err) == 4:
              if peek_off(tk, n, pi, 1) == 56:
                pi[0] = pi[0] + 2
            tc_parse_type(src, tk, ts, te, n, pi, err, sym_s, sym_kind, sym_ty, sym_buf, sym_b0, sym_b1, sym_n)
            if accept_k(tk, n, pi, err, 55) == 1:
              done = 0
            else:
              done = 1
      expect_k(tk, n, pi, err, 52)
      return 8
    return 8
  if base != 14:
    return base
  # Named type alias, generic param, or object/enum name.
  var si: int = sym_n[0] - 1
  while si >= 0:
    if sym_kind[si] == 4:
      if li_rt_str_eq(sym_buf[si], src) == 1:
        if tok_eq(src, ts, te, sym_s[si], t0) == 1:
          return 13
    si = si - 1
  si = sym_n[0] - 1
  while si >= 0:
    if sym_kind[si] == 0:
      var m: int = 0
      if li_rt_str_eq(sym_buf[si], src) == 1:
        m = tok_eq(src, ts, te, sym_s[si], t0)
      if li_rt_str_eq(sym_buf[si], src) == 0:
        m = fx_span_eq(sym_buf[si], sym_b0[si], sym_b1[si], src, peek_tk(ts, t0), peek_tk(te, t0))
      if m == 1:
        var rt: int = sym_ty[si]
        if accept_k(tk, n, pi, err, 51) == 1:
          var arg0: int = -1
          var done_arg: int = 0
          if cur_kind(tk, n, pi, err) != 52:
            var done: int = 0
            while done == 0:
              var at: int = tc_parse_type(src, tk, ts, te, n, pi, err, sym_s, sym_kind, sym_ty, sym_buf, sym_b0, sym_b1, sym_n)
              if done_arg == 0:
                arg0 = at
                done_arg = 1
              if accept_k(tk, n, pi, err, 55) == 1:
                done = 0
              else:
                done = 1
            expect_k(tk, n, pi, err, 52)
          # Generic passthrough alias (`type Box[T] = T`): the application
          # resolves to the first applied argument type, matching the C++
          # resolve_type_expr alias substitution.
          if rt == 13 and arg0 >= 0:
            return arg0
        return rt
    si = si - 1
  # heap generic type app: list[T] / dict[K, V] / set[T] (consume the args)
  if tok_is(src, ts, te, t0, "list") == 1 or tok_is(src, ts, te, t0, "dict") == 1 or tok_is(src, ts, te, t0, "set") == 1:
    if accept_k(tk, n, pi, err, 51) == 1:
      if cur_kind(tk, n, pi, err) != 52:
        var done: int = 0
        while done == 0:
          tc_parse_type(src, tk, ts, te, n, pi, err, sym_s, sym_kind, sym_ty, sym_buf, sym_b0, sym_b1, sym_n)
          if accept_k(tk, n, pi, err, 55) == 1:
            done = 0
          else:
            done = 1
      expect_k(tk, n, pi, err, 52)
    return 19
  # Unknown named type with bracket args (tuple[...], simd[...], or a generic
  # alias application seen before its alias reached the table): consume the
  # balanced bracket group. The C++ reference resolves every bracketed type
  # in resolve_type_expr, so a strand of `[x: float, ...]` tokens would
  # desync the check walk otherwise (walker-only rejects on the named/
  # variadic-tuple and simd-annotation classes).
  if accept_k(tk, n, pi, err, 51) == 1:
    var tgt_depth: int = 1
    while tgt_depth > 0:
      var tbk: int = cur_kind(tk, n, pi, err)
      if tbk == 0:
        break
      if tbk == 51:
        tgt_depth = tgt_depth + 1
      if tbk == 52:
        tgt_depth = tgt_depth - 1
      pi[0] = pi[0] + 1
    return 14
  return 14

# Consume the RHS of a type alias (`= object | trait | enum | typedict | type`),
# mirroring parse_type_alias; returns the tc type code (14 for named/object).
def tc_skip_alias_rhs(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], sym_s: var array[8192, int], sym_kind: var array[8192, int], sym_ty: var array[8192, int], sym_buf: var array[8192, ptr], sym_b0: var array[8192, int], sym_b1: var array[8192, int], sym_n: var array[1, int]) -> int
  requires true
  ensures result >= 0
  decreases 0
=
  skip_newlines(tk, n, pi, err)
  if cur_kind(tk, n, pi, err) == 47:
    pi[0] = pi[0] + 1
    return 9
  if cur_kind(tk, n, pi, err) == 4:
    if tok_is(src, ts, te, pi[0], "typedict") == 1:
      pi[0] = pi[0] + 1
      skip_newlines(tk, n, pi, err)
      parse_type_fields(src, tk, ts, te, n, pi, err, 0)
      return 14
  if cur_kind(tk, n, pi, err) == 19:
    pi[0] = pi[0] + 1
    skip_newlines(tk, n, pi, err)
    while cur_kind(tk, n, pi, err) == 4:
      if tok_is(src, ts, te, pi[0], "proc") == 1:
        break
      if tok_is(src, ts, te, pi[0], "def") == 1:
        break
      if tok_is(src, ts, te, pi[0], "type") == 1:
        break
      if tok_is(src, ts, te, pi[0], "import") == 1:
        break
      pi[0] = pi[0] + 1
      skip_newlines(tk, n, pi, err)
    return 14
  if cur_kind(tk, n, pi, err) == 4:
    if tok_is(src, ts, te, pi[0], "trait") == 1:
      pi[0] = pi[0] + 1
      skip_newlines(tk, n, pi, err)
      parse_trait_methods(src, tk, ts, te, n, pi, err, 0)
      return 14
  if cur_kind(tk, n, pi, err) == 15:
    pi[0] = pi[0] + 1
    skip_newlines(tk, n, pi, err)
    if cur_kind(tk, n, pi, err) == 4:
      if tok_is(src, ts, te, pi[0], "of") == 1:
        pi[0] = pi[0] + 1
        if cur_kind(tk, n, pi, err) == 4:
          pi[0] = pi[0] + 1
        skip_newlines(tk, n, pi, err)
    parse_type_fields(src, tk, ts, te, n, pi, err, 0)
    return 14
  return tc_parse_type(src, tk, ts, te, n, pi, err, sym_s, sym_kind, sym_ty, sym_buf, sym_b0, sym_b1, sym_n)

# ---- symbol lookups ----
def tc_find_proc(src: var ptr, ts: var array[262144, int], te: var array[262144, int], sym_s: var array[8192, int], sym_kind: var array[8192, int], sym_ty: var array[8192, int], sym_buf: var array[8192, ptr], sym_b0: var array[8192, int], sym_b1: var array[8192, int], sym_n: var array[1, int], i: int) -> int
  requires true
  ensures result >= -1
  decreases 0
=
  var k: int = sym_n[0] - 1
  while k >= 0:
    if sym_kind[k] == 1:
      var m: int = 0
      if li_rt_str_eq(sym_buf[k], src) == 1:
        m = tok_eq(src, ts, te, sym_s[k], i)
      if li_rt_str_eq(sym_buf[k], src) == 0:
        m = fx_span_eq(sym_buf[k], sym_b0[k], sym_b1[k], src, peek_tk(ts, i), peek_tk(te, i))
      if m == 1:
        return sym_ty[k]
    k = k - 1
  return -1

def tc_proc_arity(src: var ptr, ts: var array[262144, int], te: var array[262144, int], sym_s: var array[8192, int], sym_kind: var array[8192, int], sym_aux: var array[8192, int], sym_buf: var array[8192, ptr], sym_b0: var array[8192, int], sym_b1: var array[8192, int], sym_n: var array[1, int], i: int) -> int
  requires true
  ensures result >= -1
  decreases 0
=
  var k: int = sym_n[0] - 1
  while k >= 0:
    if sym_kind[k] == 1:
      var m: int = 0
      if li_rt_str_eq(sym_buf[k], src) == 1:
        m = tok_eq(src, ts, te, sym_s[k], i)
      if li_rt_str_eq(sym_buf[k], src) == 0:
        m = fx_span_eq(sym_buf[k], sym_b0[k], sym_b1[k], src, peek_tk(ts, i), peek_tk(te, i))
      if m == 1:
        return sym_aux[k]
    k = k - 1
  return -1

def tc_local_type(src: var ptr, ts: var array[262144, int], te: var array[262144, int], sym_s: var array[8192, int], sym_kind: var array[8192, int], sym_ty: var array[8192, int], sym_buf: var array[8192, ptr], sym_b0: var array[8192, int], sym_b1: var array[8192, int], sym_n: var array[1, int], i: int) -> int
  requires true
  ensures result >= -1
  decreases 0
=
  var k: int = 0
  var best_ty: int = -1
  while k < sym_n[0]:
    if sym_kind[k] == 2 or sym_kind[k] == 3:
      if tok_eq(src, ts, te, sym_s[k], i) == 1:
        best_ty = sym_ty[k]
    k = k + 1
  return best_ty

# ---- expression type inference (returns a type code; consumes tokens) ----
def tc_expr(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], min_prec: int, sym_s: var array[8192, int], sym_kind: var array[8192, int], sym_ty: var array[8192, int], sym_aux: var array[8192, int], sym_buf: var array[8192, ptr], sym_b0: var array[8192, int], sym_b1: var array[8192, int], sym_n: var array[1, int]) -> int
  requires true
  ensures result >= 0
  decreases 0
=
  var lt: int = tc_primary(src, tk, ts, te, n, pi, err, sym_s, sym_kind, sym_ty, sym_aux, sym_buf, sym_b0, sym_b1, sym_n)
  while 1 == 1:
    var p: int = prec_of(cur_kind(tk, n, pi, err))
    if p < 0:
      break
    if p < min_prec:
      break
    var opk: int = cur_kind(tk, n, pi, err)
    pi[0] = pi[0] + 1
    var rt: int = tc_expr(src, tk, ts, te, n, pi, err, p + 1, sym_s, sym_kind, sym_ty, sym_aux, sym_buf, sym_b0, sym_b1, sym_n)
    lt = tc_binop_type(lt, opk, rt, err)
  return lt

def tc_binop_type(l: int, opk: int, r: int, err: var array[1, int]) -> int
  requires true
  ensures result >= 0
  decreases 0
=
  # Comparisons and equality yield bool.
  if opk == 66 or opk == 67 or opk == 68 or opk == 69 or opk == 70 or opk == 71:
    return 3
  # Elementwise array arithmetic: `a + b` / `a * b` on sized arrays yields
  # an array of max size (broadcast for array[1] operands), mirroring the
  # C++ type_of BinOp (ArrayBinOpF64/I64, size = max). The caller checks
  # that the result fits the declared var/return array size. `@` (matmul)
  # is excluded: it yields a scalar and stays on the untyped fallthrough.
  if opk == 59 or opk == 60 or opk == 61 or opk == 62 or opk == 63 or opk == 64 or opk == 65:
    if l >= 1000 and r >= 1000:
      var lsz: int = l - 1000
      var rsz: int = r - 1000
      if rsz > lsz:
        return 1000 + rsz
      return 1000 + lsz
  if tc_is_int(l) == 1:
    if tc_is_int(r) == 1:
      if tc_is_unsigned(l) != tc_is_unsigned(r):
        err[0] = 1
        li_rt_emit_err(900)
        return 0
      if tc_bits(l) != tc_bits(r):
        err[0] = 1
        li_rt_emit_err(900)
        return 0
      # Refinement-typed ids (20000+N) are plain ints to arithmetic, like
      # the C++ Ty::Int base under a refinement — normalize to 0 so the
      # return/var unifies compare the base kind.
      if l >= 20000:
        return 0
      if r >= 20000:
        return 0
      return l
  if tc_is_float(l) == 1:
    if tc_is_float(r) == 1:
      if tc_bits(l) != tc_bits(r):
        err[0] = 1
        li_rt_emit_err(900)
        return 1
      return l
  var lfam: int = tc_family_of(l)
  var rfam: int = tc_family_of(r)
  if lfam >= 0:
    if rfam >= 0:
      err[0] = 1
      li_rt_emit_err(900)
      return 0
  return 14

def tc_primary(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], sym_s: var array[8192, int], sym_kind: var array[8192, int], sym_ty: var array[8192, int], sym_aux: var array[8192, int], sym_buf: var array[8192, ptr], sym_b0: var array[8192, int], sym_b1: var array[8192, int], sym_n: var array[1, int]) -> int
  requires true
  ensures result >= 0
  decreases 0
=
  var k: int = cur_kind(tk, n, pi, err)
  if k == 60:
    pi[0] = pi[0] + 1
    return tc_primary(src, tk, ts, te, n, pi, err, sym_s, sym_kind, sym_ty, sym_aux, sym_buf, sym_b0, sym_b1, sym_n)
  if k == 34:
    pi[0] = pi[0] + 1
    return tc_primary(src, tk, ts, te, n, pi, err, sym_s, sym_kind, sym_ty, sym_aux, sym_buf, sym_b0, sym_b1, sym_n)
  if k == 5:
    pi[0] = pi[0] + 1
    return tc_postfix(src, tk, ts, te, n, pi, err, 0, sym_s, sym_kind, sym_ty, sym_aux, sym_buf, sym_b0, sym_b1, sym_n)
  if k == 6:
    pi[0] = pi[0] + 1
    return tc_postfix(src, tk, ts, te, n, pi, err, 1, sym_s, sym_kind, sym_ty, sym_aux, sym_buf, sym_b0, sym_b1, sym_n)
  if k == 7:
    pi[0] = pi[0] + 1
    return tc_postfix(src, tk, ts, te, n, pi, err, 4, sym_s, sym_kind, sym_ty, sym_aux, sym_buf, sym_b0, sym_b1, sym_n)
  if k == 8:
    pi[0] = pi[0] + 1
    return tc_postfix(src, tk, ts, te, n, pi, err, 2, sym_s, sym_kind, sym_ty, sym_aux, sym_buf, sym_b0, sym_b1, sym_n)
  if k == 35:
    pi[0] = pi[0] + 1
    return tc_postfix(src, tk, ts, te, n, pi, err, 3, sym_s, sym_kind, sym_ty, sym_aux, sym_buf, sym_b0, sym_b1, sym_n)
  if k == 36:
    pi[0] = pi[0] + 1
    return tc_postfix(src, tk, ts, te, n, pi, err, 3, sym_s, sym_kind, sym_ty, sym_aux, sym_buf, sym_b0, sym_b1, sym_n)
  if k == 4 or k == 46:
    var id0: int = pi[0]
    pi[0] = pi[0] + 1
    if accept_k(tk, n, pi, err, 49) == 1:
      if tok_is(src, ts, te, id0, "print") == 1:
        skip_newlines(tk, n, pi, err)
        if cur_kind(tk, n, pi, err) != 50:
          var done: int = 0
          while done == 0:
            skip_newlines(tk, n, pi, err)
            tc_expr(src, tk, ts, te, n, pi, err, 0, sym_s, sym_kind, sym_ty, sym_aux, sym_buf, sym_b0, sym_b1, sym_n)
            skip_newlines(tk, n, pi, err)
            if accept_k(tk, n, pi, err, 55) == 1:
              done = 0
            else:
              done = 1
        skip_newlines(tk, n, pi, err)
        expect_k(tk, n, pi, err, 50)
        return 0
      var callee: int = tc_find_proc(src, ts, te, sym_s, sym_kind, sym_ty, sym_buf, sym_b0, sym_b1, sym_n, id0)
      var carity: int = tc_proc_arity(src, ts, te, sym_s, sym_kind, sym_aux, sym_buf, sym_b0, sym_b1, sym_n, id0)
      var arg0ty: array[1, int]
      var argc: int = 0
      skip_newlines(tk, n, pi, err)
      if cur_kind(tk, n, pi, err) != 50:
        var done: int = 0
        while done == 0:
          skip_newlines(tk, n, pi, err)
          var at: int = tc_expr(src, tk, ts, te, n, pi, err, 0, sym_s, sym_kind, sym_ty, sym_aux, sym_buf, sym_b0, sym_b1, sym_n)
          if argc == 0:
            arg0ty[0] = at
          argc = argc + 1
          skip_newlines(tk, n, pi, err)
          if accept_k(tk, n, pi, err, 55) == 1:
            done = 0
          else:
            done = 1
      skip_newlines(tk, n, pi, err)
      expect_k(tk, n, pi, err, 50)
      # Builtin array reductions / kernels, resolved BEFORE the proc table
      # like the C++ host's type_of (typecheck.cpp: echo/print first (already
      # handled), then sum/norm/dot/axpy + the SIMD primitives, then
      # procs.find → unknown proc). Without the dispatch every `return
      # sum(a)` false-fires E0202 (repro case: `var s: float = sum(1.0)`).
      # sum/norm return the arg's element type in C++; this engine encodes
      # sized arrays by size only (1000+sz), so the element type is not
      # recoverable — return the unknown type 14 (exempt in return-unify,
      # accepted everywhere the host accepts). A non-array arg returns int.
      if callee >= 0:
        # No arity check: the C++ check lane never compares call.args.size()
        # against callee.params.size() (type_of only type-checks the args;
        # per-arg type mismatch is a separate, unported class). A phantom
        # arity fire here rejected 6-arg calls to 5-param imported procs
        # (studio_compose_shell_palette) that the host accepts.
        # Consume trailing postfixes before returning: the resolved-callee
        # result feeds the caller's postfix chain (`call().r`, `call()[i]`),
        # so a bare return left `.r` unconsumed and the enclosing expect(':')
        # failed silently (studio_accessibility-class walker-only rejects).
        return tc_postfix(src, tk, ts, te, n, pi, err, callee, sym_s, sym_kind, sym_ty, sym_aux, sym_buf, sym_b0, sym_b1, sym_n)
      var bt: int = 0 - 1
      if argc == 1:
        if tok_is(src, ts, te, id0, "sum") == 1:
          if arg0ty[0] >= 1000:
            bt = 14
          else:
            bt = 0
        elif tok_is(src, ts, te, id0, "norm") == 1:
          if arg0ty[0] >= 1000 or arg0ty[0] == 7:
            bt = 14
          else:
            bt = 0
        elif tok_is(src, ts, te, id0, "__li_simd_splat_f64") == 1:
          bt = 14
        elif tok_is(src, ts, te, id0, "__li_horiz_sum_f64") == 1:
          bt = 1
      elif argc == 2:
        if tok_is(src, ts, te, id0, "dot") == 1:
          bt = 1
        elif tok_is(src, ts, te, id0, "__li_simd_mul_f64") == 1:
          bt = 14
      elif argc == 3:
        if tok_is(src, ts, te, id0, "axpy") == 1:
          bt = 0
      if bt < 0:
        err[0] = 1
        li_rt_emit_err(202)
        return 14
      return tc_postfix(src, tk, ts, te, n, pi, err, bt, sym_s, sym_kind, sym_ty, sym_aux, sym_buf, sym_b0, sym_b1, sym_n)
    var lt: int = tc_local_type(src, ts, te, sym_s, sym_kind, sym_ty, sym_buf, sym_b0, sym_b1, sym_n, id0)
    if lt < 0:
      lt = 14
    return tc_postfix(src, tk, ts, te, n, pi, err, lt, sym_s, sym_kind, sym_ty, sym_aux, sym_buf, sym_b0, sym_b1, sym_n)
  if accept_k(tk, n, pi, err, 49) == 1:
    var it: int = tc_expr(src, tk, ts, te, n, pi, err, 0, sym_s, sym_kind, sym_ty, sym_aux, sym_buf, sym_b0, sym_b1, sym_n)
    expect_k(tk, n, pi, err, 50)
    return tc_postfix(src, tk, ts, te, n, pi, err, it, sym_s, sym_kind, sym_ty, sym_aux, sym_buf, sym_b0, sym_b1, sym_n)
  err[0] = 1
  return 14

def tc_postfix(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], t: int, sym_s: var array[8192, int], sym_kind: var array[8192, int], sym_ty: var array[8192, int], sym_aux: var array[8192, int], sym_buf: var array[8192, ptr], sym_b0: var array[8192, int], sym_b1: var array[8192, int], sym_n: var array[1, int]) -> int
  requires true
  ensures result >= 0
  decreases 0
=
  while 1 == 1:
    if accept_k(tk, n, pi, err, 51) == 1:
      var ik: int = cur_kind(tk, n, pi, err)
      var iv: int = 0
      # base token is two back from the index token (`[` was consumed).
      # Non-adjacent bases (multi-line `[`) are conservatively skipped.
      var base_tok: int = pi[0] - 2
      if base_tok < 0:
        base_tok = 0
      var idx_tok: int = pi[0]
      if ik == 5:
        iv = int_text_value(src, ts, te, pi[0])
      tc_expr(src, tk, ts, te, n, pi, err, 0, sym_s, sym_kind, sym_ty, sym_aux, sym_buf, sym_b0, sym_b1, sym_n)
      expect_k(tk, n, pi, err, 52)
      if t >= 1000:
        if t >= 29000:
          # var-array encoding: same size semantics as the plain code for
          # the constant-literal rule.
          t = t - 28000
        if ik == 5:
          if iv >= t - 1000:
            err[0] = 1
            li_rt_emit_err(201)
        if ik == 60:
          # `buf[-1]` lexes as unary minus + positive literal (kind 60 +
          # kind 5); the C++ parser folds it into a negative IntLit and
          # the index rule fires "array index out of range".
          err[0] = 1
          li_rt_emit_err(201)
        if ik == 4:
          # C++ Ident-index rule: on a parameter-array base
          # (requires_bounded_index) a LONE-IDENT index must be a bounded
          # int — a refinement param (20000+N) or a bounded loop var.
          # Call/blob-indexed exprs (`a[f(x)]`, `a[i+1]`) are not Idents
          # in the host — they never fire; require the bare `ident ]`.
          if peek_tk(tk, idx_tok + 1) == 52:
            var br: int = tc_local_row(src, ts, te, sym_s, sym_kind, sym_buf, sym_b0, sym_b1, sym_n, base_tok)
            if br >= 0:
              if sym_kind[br] == 2:
                if (sym_ty[br] >= 1000 and sym_ty[br] < 29000) or sym_ty[br] == 7:
                  var ir: int = tc_local_row(src, ts, te, sym_s, sym_kind, sym_buf, sym_b0, sym_b1, sym_n, idx_tok)
                  if ir >= 0:
                    if sym_ty[ir] >= 20000:
                      if sym_ty[ir] - 20000 > sym_ty[br] - 1000:
                        err[0] = 1
                        li_rt_emit_err(900)
                    if sym_ty[ir] < 20000:
                      err[0] = 1
                      li_rt_emit_err(900)
                  if ir < 0:
                    err[0] = 1
                    li_rt_emit_err(900)
      t = 14
      continue
    if accept_k(tk, n, pi, err, 72) == 1:
      if cur_kind(tk, n, pi, err) != 4:
        err[0] = 1
        return 14
      pi[0] = pi[0] + 1
      if accept_k(tk, n, pi, err, 49) == 1:
        if cur_kind(tk, n, pi, err) != 50:
          var done: int = 0
          while done == 0:
            tc_expr(src, tk, ts, te, n, pi, err, 0, sym_s, sym_kind, sym_ty, sym_aux, sym_buf, sym_b0, sym_b1, sym_n)
            if accept_k(tk, n, pi, err, 55) == 1:
              done = 0
            else:
              done = 1
        expect_k(tk, n, pi, err, 50)
      continue
    break
  return t

# ---- statement walker (checks return types; consumes tokens) ----
def tc_stmt(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], cur_ret: var array[1, int], sym_s: var array[8192, int], sym_kind: var array[8192, int], sym_ty: var array[8192, int], sym_aux: var array[8192, int], sym_buf: var array[8192, ptr], sym_b0: var array[8192, int], sym_b1: var array[8192, int], sym_n: var array[1, int]) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  var k: int = cur_kind(tk, n, pi, err)
  if k == 20:
    pi[0] = pi[0] + 1
    if cur_kind(tk, n, pi, err) != 4:
      err[0] = 1
      return 1
    var nm: int = pi[0]
    pi[0] = pi[0] + 1
    expect_k(tk, n, pi, err, 56)
    var vt: int = tc_parse_type(src, tk, ts, te, n, pi, err, sym_s, sym_kind, sym_ty, sym_buf, sym_b0, sym_b1, sym_n)
    tc_record_local(src, ts, te, sym_s, sym_kind, sym_ty, sym_buf, sym_b0, sym_b1, sym_n, nm, vt)
    if accept_k(tk, n, pi, err, 58) == 1:
      var it: int = tc_expr(src, tk, ts, te, n, pi, err, 0, sym_s, sym_kind, sym_ty, sym_aux, sym_buf, sym_b0, sym_b1, sym_n)
      # Scalar init unify (C++ assignable(): same numeric family assigns,
      # different numeric families reject; unknown(14)/typevar(13) exempt;
      # non-numeric families stay under-strict).
      if it != vt:
        if it != 14:
          if vt != 14:
            if it != 13:
              if vt != 13:
                var fg: int = tc_family_of(it)
                var fd: int = tc_family_of(vt)
                if fg >= 0:
                  if fd >= 0:
                    if fg != fd:
                      err[0] = 1
                      li_rt_emit_err(900)
      if vt == 9:
        if it != 7:
          if it < 1000:
            err[0] = 1
            li_rt_emit_err(900)
      # Sized-array var-decl init: the init expression must produce an array
      # of the declared size (elementwise binops propagate size = max). A
      # size mismatch (e.g. array[4] init from array[4] * array[8]) rejects
      # like the C++ typechecker's variable type mismatch.
      if vt >= 1000:
        if it >= 1000:
          if vt != it:
            err[0] = 1
            li_rt_emit_err(900)
    return 1
  if k == 30:
    pi[0] = pi[0] + 1
    if cur_kind(tk, n, pi, err) != 1:
      var rt: int = tc_expr(src, tk, ts, te, n, pi, err, 0, sym_s, sym_kind, sym_ty, sym_aux, sym_buf, sym_b0, sym_b1, sym_n)
      if cur_ret[0] >= 0:
        # Refinement ints normalize to plain int at the unify (the C++
        # assignability compares Ty kinds, not refinement bounds).
        var rtx: int = rt
        if rtx >= 20000:
          rtx = 0
        var ctx: int = cur_ret[0]
        if ctx >= 20000:
          ctx = 0
        if rtx != ctx:
          if rtx != 14:
            if ctx != 14:
              err[0] = 1
              if rtx == 13:
                li_rt_emit_err(202)
              else:
                if ctx == 13:
                  li_rt_emit_err(202)
                else:
                  li_rt_emit_err(900)
    return 1
  if k == 22:
    pi[0] = pi[0] + 1
    tc_expr(src, tk, ts, te, n, pi, err, 0, sym_s, sym_kind, sym_ty, sym_aux, sym_buf, sym_b0, sym_b1, sym_n)
    expect_k(tk, n, pi, err, 56)
    skip_newlines(tk, n, pi, err)
    tc_block(src, tk, ts, te, n, pi, err, cur_ret, sym_s, sym_kind, sym_ty, sym_aux, sym_buf, sym_b0, sym_b1, sym_n)
    while cur_kind(tk, n, pi, err) == 24:
      pi[0] = pi[0] + 1
      tc_expr(src, tk, ts, te, n, pi, err, 0, sym_s, sym_kind, sym_ty, sym_aux, sym_buf, sym_b0, sym_b1, sym_n)
      expect_k(tk, n, pi, err, 56)
      skip_newlines(tk, n, pi, err)
      tc_block(src, tk, ts, te, n, pi, err, cur_ret, sym_s, sym_kind, sym_ty, sym_aux, sym_buf, sym_b0, sym_b1, sym_n)
    if cur_kind(tk, n, pi, err) == 23:
      pi[0] = pi[0] + 1
      expect_k(tk, n, pi, err, 56)
      skip_newlines(tk, n, pi, err)
      tc_block(src, tk, ts, te, n, pi, err, cur_ret, sym_s, sym_kind, sym_ty, sym_aux, sym_buf, sym_b0, sym_b1, sym_n)
    return 1
  if k == 25:
    pi[0] = pi[0] + 1
    var c0: int = pi[0]
    tc_expr(src, tk, ts, te, n, pi, err, 0, sym_s, sym_kind, sym_ty, sym_aux, sym_buf, sym_b0, sym_b1, sym_n)
    # A canonical counted-loop guard `while i < N` proves the loop index is
    # bounded while the body executes (typecheck.cpp While case): mark the
    # ident's sym row as a bounded int (20000+N) so the index gate accepts
    # `arr[i]` inside the body like the host's locals mutation.
    var ci: int = c0
    while ci + 2 < pi[0]:
      if peek_tk(tk, ci) == 4:
        if tok_is(src, ts, te, ci + 1, "<") == 1:
          if peek_tk(tk, ci + 2) == 5:
            tc_mark_bound_name(src, ts, te, sym_s, sym_kind, sym_ty, sym_buf, sym_b0, sym_b1, sym_n, ci, int_text_value(src, ts, te, ci + 2))
      ci = ci + 1
    if cur_kind(tk, n, pi, err) == 56:
      pi[0] = pi[0] + 1
    skip_newlines(tk, n, pi, err)
    tc_block(src, tk, ts, te, n, pi, err, cur_ret, sym_s, sym_kind, sym_ty, sym_aux, sym_buf, sym_b0, sym_b1, sym_n)
    return 1
  if k == 76:
    parse_decorator_list(src, tk, ts, te, n, pi, err, 0)
    skip_newlines(tk, n, pi, err)
    tc_stmt(src, tk, ts, te, n, pi, err, cur_ret, sym_s, sym_kind, sym_ty, sym_aux, sym_buf, sym_b0, sym_b1, sym_n)
    return 1
  if k == 26:
    pi[0] = pi[0] + 1
    var fh: array[3, int]
    for_tail(src, tk, ts, te, n, pi, err, fh)
    if fh[0] != 0:
      # Counted-loop indices are bounded indices (C++ check_stmt For:
      # bounded local with array_size = for_end; a non-literal end keeps
      # bound 0, accepted like the host's <=-size sentinel).
      tc_record_local(src, ts, te, sym_s, sym_kind, sym_ty, sym_buf, sym_b0, sym_b1, sym_n, fh[0], 20000 + fh[2])
    skip_newlines(tk, n, pi, err)
    tc_block(src, tk, ts, te, n, pi, err, cur_ret, sym_s, sym_kind, sym_ty, sym_aux, sym_buf, sym_b0, sym_b1, sym_n)
    return 1
  if k == 4:
    if tok_is(src, ts, te, pi[0], "parallel") == 1:
      # parallel for: the C++ check walker (check_stmt ParallelFor) registers
      # the loop index as a bounded int and walks the body — it never
      # typechecks the contract clauses between the header and the `=`.
      # Mirror exactly that consumption shape.
      pi[0] = pi[0] + 1
      if tok_is(src, ts, te, pi[0], "for") == 1:
        pi[0] = pi[0] + 1
      var fh: array[3, int]
      for_tail(src, tk, ts, te, n, pi, err, fh)
      if fh[0] != 0:
        # parallel for: the C++ check walker (check_stmt ParallelFor)
        # registers the loop index as a bounded int — same bound encoding
        # as the plain for arm above.
        tc_record_local(src, ts, te, sym_s, sym_kind, sym_ty, sym_buf, sym_b0, sym_b1, sym_n, fh[0], 20000 + fh[2])
      skip_newlines(tk, n, pi, err)
      if accept_k(tk, n, pi, err, 2) == 1:
        skip_newlines(tk, n, pi, err)
        var pc: int = 0
        while pc == 0:
          var pck: int = cur_kind(tk, n, pi, err)
          if pck == 41 or pck == 42 or pck == 43 or pck == 44 or pck == 45:
            parse_contract(src, tk, ts, te, n, pi, err, 0)
            continue
          pc = 1
        expect_k(tk, n, pi, err, 3)
        skip_newlines(tk, n, pi, err)
      if accept_k(tk, n, pi, err, 58) == 1:
        skip_newlines(tk, n, pi, err)
        if cur_kind(tk, n, pi, err) == 2:
          tc_block(src, tk, ts, te, n, pi, err, cur_ret, sym_s, sym_kind, sym_ty, sym_aux, sym_buf, sym_b0, sym_b1, sym_n)
      return 1
  if k == 49:
    pi[0] = pi[0] + 1
    tc_expr(src, tk, ts, te, n, pi, err, 0, sym_s, sym_kind, sym_ty, sym_aux, sym_buf, sym_b0, sym_b1, sym_n)
    expect_k(tk, n, pi, err, 50)
    return 1
  if k == 60:
    pi[0] = pi[0] + 1
    tc_expr(src, tk, ts, te, n, pi, err, 0, sym_s, sym_kind, sym_ty, sym_aux, sym_buf, sym_b0, sym_b1, sym_n)
    return 1
  tc_expr(src, tk, ts, te, n, pi, err, 0, sym_s, sym_kind, sym_ty, sym_aux, sym_buf, sym_b0, sym_b1, sym_n)
  if accept_k(tk, n, pi, err, 58) == 1:
    tc_expr(src, tk, ts, te, n, pi, err, 0, sym_s, sym_kind, sym_ty, sym_aux, sym_buf, sym_b0, sym_b1, sym_n)
  return 1

def tc_block(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], cur_ret: var array[1, int], sym_s: var array[8192, int], sym_kind: var array[8192, int], sym_ty: var array[8192, int], sym_aux: var array[8192, int], sym_buf: var array[8192, ptr], sym_b0: var array[8192, int], sym_b1: var array[8192, int], sym_n: var array[1, int]) -> int
  requires true
  ensures result == 1
  decreases 0
=
  skip_newlines(tk, n, pi, err)
  if expect_k(tk, n, pi, err, 2) == 0:
    return 1
  skip_newlines(tk, n, pi, err)
  while 1 == 1:
    if cur_kind(tk, n, pi, err) == 3:
      break
    if cur_kind(tk, n, pi, err) == 0:
      break
    var before: int = pi[0]
    tc_stmt(src, tk, ts, te, n, pi, err, cur_ret, sym_s, sym_kind, sym_ty, sym_aux, sym_buf, sym_b0, sym_b1, sym_n)
    if pi[0] == before:
      err[0] = 1
      break
    skip_newlines(tk, n, pi, err)
  expect_k(tk, n, pi, err, 3)
  return 1

# ---- record a local/param type ----
def tc_record_local(src: var ptr, ts: var array[262144, int], te: var array[262144, int], sym_s: var array[8192, int], sym_kind: var array[8192, int], sym_ty: var array[8192, int], sym_buf: var array[8192, ptr], sym_b0: var array[8192, int], sym_b1: var array[8192, int], sym_n: var array[1, int], i: int, t: int) -> int
  requires true
  ensures result == 0
  decreases 0
=
  var k: int = 0
  while k < sym_n[0]:
    if sym_kind[k] == 3:
      if tok_eq(src, ts, te, sym_s[k], i) == 1:
        sym_ty[k] = t
        return 0
    k = k + 1
  var ni: int = sym_n[0]
  if ni < 8192:
    var ria: int = i
    var rib: int = i
    var rb0: int = peek_tk(ts, ria)
    var rb1: int = peek_tk(te, rib)
    sym_b0[ni] = rb0
    sym_b1[ni] = rb1
    sym_s[ni] = i
    sym_kind[ni] = 3
    sym_ty[ni] = t
    sym_buf[ni] = src
    sym_n[0] = sym_n[0] + 1
  return 0

# ---- generic type params: record `[T, U, ...]` as kind 4 (type var) ----
def tc_record_type_params(src: var ptr, tk: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], sym_s: var array[8192, int], sym_kind: var array[8192, int], sym_ty: var array[8192, int], sym_buf: var array[8192, ptr], sym_b0: var array[8192, int], sym_b1: var array[8192, int], sym_n: var array[1, int]) -> int
  requires true
  ensures result == 1
  decreases 0
=
  if accept_k(tk, n, pi, err, 51) == 1:
    if cur_kind(tk, n, pi, err) != 52:
      var done: int = 0
      while done == 0:
        if cur_kind(tk, n, pi, err) != 4:
          err[0] = 1
          break
        var tp: int = sym_n[0]
        if tp < 8192:
          sym_s[tp] = pi[0]
          sym_kind[tp] = 4
          sym_ty[tp] = 13
          sym_buf[tp] = src
          sym_n[0] = sym_n[0] + 1
        pi[0] = pi[0] + 1
        if accept_k(tk, n, pi, err, 56) == 1:
          if cur_kind(tk, n, pi, err) == 4:
            pi[0] = pi[0] + 1
          else:
            err[0] = 1
        if accept_k(tk, n, pi, err, 55) == 1:
          done = 0
        else:
          done = 1
    expect_k(tk, n, pi, err, 52)
  return 1




# ---- consume an optional `raises A, B, ...` clause ----
def tc_skip_raises(tk: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int]) -> int
  requires true
  ensures result == 1
  decreases 0
=
  skip_newlines(tk, n, pi, err)
  if cur_kind(tk, n, pi, err) == 31:
    pi[0] = pi[0] + 1
    if cur_kind(tk, n, pi, err) == 4:
      var rdone: int = 0
      while rdone == 0:
        pi[0] = pi[0] + 1
        if accept_k(tk, n, pi, err, 55) == 1:
          rdone = 0
        else:
          rdone = 1
  skip_newlines(tk, n, pi, err)
  return 1

# ---- proc signature collection (pass 1) ----
def tc_record_proc(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], is_extern: int, sym_s: var array[8192, int], sym_kind: var array[8192, int], sym_ty: var array[8192, int], sym_aux: var array[8192, int], sym_buf: var array[8192, ptr], sym_b0: var array[8192, int], sym_b1: var array[8192, int], sym_n: var array[1, int]) -> int
  requires true
  ensures result == 1
  decreases 0
=
  if cur_kind(tk, n, pi, err) != 4:
    err[0] = 1
    return 1
  var nm: int = pi[0]
  pi[0] = pi[0] + 1
  var si: int = sym_n[0]
  if si < 8192:
    var rma: int = nm
    var rmb: int = nm
    var rb0: int = peek_tk(ts, rma)
    var rb1: int = peek_tk(te, rmb)
    sym_b0[si] = rb0
    sym_b1[si] = rb1
    sym_s[si] = nm
    sym_kind[si] = 1
    sym_buf[si] = src
    sym_n[0] = sym_n[0] + 1
  tc_record_type_params(src, tk, n, pi, err, sym_s, sym_kind, sym_ty, sym_buf, sym_b0, sym_b1, sym_n)
  expect_k(tk, n, pi, err, 49)
  skip_param_layout(tk, n, pi, err)
  var argc: int = 0
  if cur_kind(tk, n, pi, err) != 50:
    var done: int = 0
    while done == 0:
      skip_param_layout(tk, n, pi, err)
      if cur_kind(tk, n, pi, err) != 4:
        err[0] = 1
      else:
        pi[0] = pi[0] + 1
        expect_k(tk, n, pi, err, 56)
        tc_parse_type(src, tk, ts, te, n, pi, err, sym_s, sym_kind, sym_ty, sym_buf, sym_b0, sym_b1, sym_n)
        argc = argc + 1
      skip_param_layout(tk, n, pi, err)
      if accept_k(tk, n, pi, err, 55) == 1:
        done = 0
      else:
        done = 1
  skip_param_layout(tk, n, pi, err)
  expect_k(tk, n, pi, err, 50)
  tc_skip_raises(tk, n, pi, err)
  var ret: int = 6
  if accept_k(tk, n, pi, err, 57) == 1:
    ret = tc_parse_type(src, tk, ts, te, n, pi, err, sym_s, sym_kind, sym_ty, sym_buf, sym_b0, sym_b1, sym_n)
  if si < 8192:
    sym_aux[si] = argc
    sym_ty[si] = ret
  return 1

# ---- pass 1 tail skip: contracts (and body for non-extern procs) ----
def tc_skip_proc_tail(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], is_extern: int) -> int
  requires true
  ensures result == 1
  decreases 0
=
  skip_newlines(tk, n, pi, err)
  tc_skip_raises(tk, n, pi, err)
  while 1 == 1:
    var ck: int = cur_kind(tk, n, pi, err)
    if ck == 41 or ck == 42 or ck == 43 or ck == 44 or ck == 45:
      parse_contract(src, tk, ts, te, n, pi, err, 0)
      continue
    break
  if is_extern == 0:
    skip_newlines(tk, n, pi, err)
    if accept_k(tk, n, pi, err, 58) == 1:
      skip_newlines(tk, n, pi, err)
      if cur_kind(tk, n, pi, err) == 2:
        parse_block(src, tk, ts, te, n, pi, err, 0)
  return 1

# ---- contract collection + well-formedness (E0301/2/3) ----
def tc_collect_contracts(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], is_extern: int, ret_ty: int, sym_s: var array[8192, int], sym_kind: var array[8192, int], sym_ty: var array[8192, int], sym_aux: var array[8192, int], sym_buf: var array[8192, ptr], sym_b0: var array[8192, int], sym_b1: var array[8192, int], sym_n: var array[1, int]) -> int
  requires true
  ensures result == 1
  decreases 0
=
  var has_req: int = 0
  var has_ens: int = 0
  var weak_ens: int = 0
  var has_prob: int = 0
  while 1 == 1:
    skip_newlines(tk, n, pi, err)
    var ck: int = cur_kind(tk, n, pi, err)
    if ck == 41:
      has_req = 1
      pi[0] = pi[0] + 1
      parse_contract_expr(src, tk, ts, te, n, pi, err, 0)
      continue
    if ck == 42:
      has_ens = 1
      pi[0] = pi[0] + 1
      if cur_kind(tk, n, pi, err) == 35:
        if peek_off(tk, n, pi, 1) == 1:
          weak_ens = 1
      parse_contract_expr(src, tk, ts, te, n, pi, err, 0)
      continue
    if ck == 43:
      has_prob = 1
      pi[0] = pi[0] + 1
      parse_contract_expr(src, tk, ts, te, n, pi, err, 0)
      # prob_ensures carries the `given <dist>` / `samples <n>` tail
      # (parse_contract consumes it; the check re-walk must too, or the
      # dangling tail tokens fail the contract loop iteration — walker-only
      # rejections on the given/samples class).
      skip_newlines(tk, n, pi, err)
      var tg: int = 0
      while tg == 0:
        if cur_kind(tk, n, pi, err) == 4:
          if tok_is(src, ts, te, pi[0], "given") == 1:
            pi[0] = pi[0] + 1
            if cur_kind(tk, n, pi, err) != 4:
              err[0] = 1
              return 1
            pi[0] = pi[0] + 1
            skip_newlines(tk, n, pi, err)
            tg = 0
          else:
            if tok_is(src, ts, te, pi[0], "samples") == 0:
              break
            pi[0] = pi[0] + 1
            if cur_kind(tk, n, pi, err) != 5:
              err[0] = 1
              return 1
            pi[0] = pi[0] + 1
            skip_newlines(tk, n, pi, err)
            tg = 0
        else:
          break
      continue
    if ck == 44 or ck == 45:
      pi[0] = pi[0] + 1
      parse_contract_expr(src, tk, ts, te, n, pi, err, 0)
      continue
    break
  if is_extern == 0:
    if has_req == 0:
      err[0] = 1
      li_rt_emit_err(301)
    if has_ens == 0:
      err[0] = 1
      li_rt_emit_err(302)
  if is_extern == 0:
    if weak_ens == 1:
      if ret_ty != 6:
        err[0] = 1
        li_rt_emit_err(303)
  return 1

# ---- pass 2: check a proc body ----
def tc_check_proc_body(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], ret_ty: int, cur_ret: var array[1, int], sym_s: var array[8192, int], sym_kind: var array[8192, int], sym_ty: var array[8192, int], sym_aux: var array[8192, int], sym_buf: var array[8192, ptr], sym_b0: var array[8192, int], sym_b1: var array[8192, int], sym_n: var array[1, int]) -> int
  requires true
  ensures result == 1
  decreases 0
=
  cur_ret[0] = ret_ty
  skip_newlines(tk, n, pi, err)
  if accept_k(tk, n, pi, err, 58) == 1:
    skip_newlines(tk, n, pi, err)
    tc_block(src, tk, ts, te, n, pi, err, cur_ret, sym_s, sym_kind, sym_ty, sym_aux, sym_buf, sym_b0, sym_b1, sym_n)
  return 1

# ---- skip a param in pass 2 (types already recorded in pass 1) ----
def tc_skip_param(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], sym_s: var array[8192, int], sym_kind: var array[8192, int], sym_ty: var array[8192, int], sym_buf: var array[8192, ptr], sym_b0: var array[8192, int], sym_b1: var array[8192, int], sym_n: var array[1, int]) -> int
  requires true
  ensures result == 1
  decreases 0
=
  skip_param_layout(tk, n, pi, err)
  if cur_kind(tk, n, pi, err) != 4:
    err[0] = 1
    return 1
  pi[0] = pi[0] + 1
  expect_k(tk, n, pi, err, 56)
  tc_parse_type(src, tk, ts, te, n, pi, err, sym_s, sym_kind, sym_ty, sym_buf, sym_b0, sym_b1, sym_n)
  return 1

def tc_record_param(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], sym_s: var array[8192, int], sym_kind: var array[8192, int], sym_ty: var array[8192, int], sym_buf: var array[8192, ptr], sym_b0: var array[8192, int], sym_b1: var array[8192, int], sym_n: var array[1, int]) -> int
  requires true
  ensures result == 1
  decreases 0
=
  skip_param_layout(tk, n, pi, err)
  if cur_kind(tk, n, pi, err) != 4:
    err[0] = 1
    return 1
  var pn: int = pi[0]
  pi[0] = pi[0] + 1
  expect_k(tk, n, pi, err, 56)
  # `param: var array[..]` is a var-param: the C++ host sets
  # requires_bounded_index only for NON-var array params. Encode var arrays
  # into the 29000-range (size kept in the low digits) so the index gate
  # can exempt them exactly like the host.
  var pv: int = 0
  if cur_kind(tk, n, pi, err) == 20:
    pv = 1
  var pt: int = tc_parse_type(src, tk, ts, te, n, pi, err, sym_s, sym_kind, sym_ty, sym_buf, sym_b0, sym_b1, sym_n)
  if pv == 1:
    if pt >= 1000:
      pt = 29000 + (pt - 1000)
  var pl: int = sym_n[0]
  if pl < 8192:
    var rpa: int = pn
    var rpb: int = pn
    var rb0: int = peek_tk(ts, rpa)
    var rb1: int = peek_tk(te, rpb)
    sym_b0[pl] = rb0
    sym_b1[pl] = rb1
    sym_s[pl] = pn
    sym_kind[pl] = 2
    sym_ty[pl] = pt
    sym_buf[pl] = src
    sym_n[0] = sym_n[0] + 1
  return 1

# ---- top-level: collect types + procs, then check each proc ----
# ---- stdlib seal + duplicate top-level definitions (compiler/types/prelude.cpp) ----
# The prelude and the std/ tree own a fixed set of names; a module may not
# redefine them (docs/language/stdlib.md), and a module may not define the same
# top-level name twice. Mirrors the C++ `check_stdlib_seal` /
# `check_duplicate_definitions`: the prelude-type half applies to type aliases
# and procs alike, the std-symbol half is skipped for files under std/, and
# theorem/axiom/lemma share the proc namespace for duplicate detection.

# True when the name token matches one of four spellings; unused slots pass ""
# (no token has empty text).
def seal_any4(src: var ptr, ts: var array[262144, int], te: var array[262144, int], i: int, a: ptr, b: ptr, c: ptr, d: ptr) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  if tok_is(src, ts, te, i, a) == 1:
    return 1
  if tok_is(src, ts, te, i, b) == 1:
    return 1
  if tok_is(src, ts, te, i, c) == 1:
    return 1
  if tok_is(src, ts, te, i, d) == 1:
    return 1
  return 0

# Numeric scalar aliases (compiler/types/numeric_types.cpp `table()`).
def seal_numeric_scalar(src: var ptr, ts: var array[262144, int], te: var array[262144, int], i: int) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  if seal_any4(src, ts, te, i, "int4", "Int4", "i4", "int8") == 1:
    return 1
  if seal_any4(src, ts, te, i, "Int8", "i8", "int16", "Int16") == 1:
    return 1
  if seal_any4(src, ts, te, i, "i16", "int32", "Int32", "i32") == 1:
    return 1
  if seal_any4(src, ts, te, i, "int64", "Int64", "i64", "int") == 1:
    return 1
  if seal_any4(src, ts, te, i, "long", "int128", "Int128", "i128") == 1:
    return 1
  if seal_any4(src, ts, te, i, "int256", "Int256", "i256", "int512") == 1:
    return 1
  if seal_any4(src, ts, te, i, "Int512", "i512", "", "") == 1:
    return 1
  if seal_any4(src, ts, te, i, "uint4", "UInt4", "u4", "uint8") == 1:
    return 1
  if seal_any4(src, ts, te, i, "UInt8", "u8", "uint16", "UInt16") == 1:
    return 1
  if seal_any4(src, ts, te, i, "u16", "uint32", "UInt32", "u32") == 1:
    return 1
  if seal_any4(src, ts, te, i, "uint64", "UInt64", "u64", "uint") == 1:
    return 1
  if seal_any4(src, ts, te, i, "usize", "uint128", "UInt128", "u128") == 1:
    return 1
  if seal_any4(src, ts, te, i, "uint256", "UInt256", "u256", "uint512") == 1:
    return 1
  if seal_any4(src, ts, te, i, "UInt512", "u512", "", "") == 1:
    return 1
  if seal_any4(src, ts, te, i, "float4", "Float4", "f4", "float8") == 1:
    return 1
  if seal_any4(src, ts, te, i, "Float8", "f8", "float16", "Float16") == 1:
    return 1
  if seal_any4(src, ts, te, i, "f16", "float32", "Float32", "f32") == 1:
    return 1
  if seal_any4(src, ts, te, i, "float64", "Float64", "f64", "float") == 1:
    return 1
  if seal_any4(src, ts, te, i, "float128", "Float128", "f128", "float256") == 1:
    return 1
  if seal_any4(src, ts, te, i, "Float256", "f256", "float512", "Float512") == 1:
    return 1
  if seal_any4(src, ts, te, i, "f512", "", "", "") == 1:
    return 1
  return 0

# is_prelude_type_name: the numeric aliases plus the core prelude type names.
def seal_prelude_type(src: var ptr, ts: var array[262144, int], te: var array[262144, int], i: int) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  if seal_any4(src, ts, te, i, "bool", "str", "binary", "Binary") == 1:
    return 1
  if seal_any4(src, ts, te, i, "unit", "list", "dict", "tuple") == 1:
    return 1
  if seal_any4(src, ts, te, i, "Option", "simd", "bytes", "stringview") == 1:
    return 1
  if seal_any4(src, ts, te, i, "ptr", "", "", "") == 1:
    return 1
  return seal_numeric_scalar(src, ts, te, i)

# is_prelude_proc_name
def seal_prelude_proc(src: var ptr, ts: var array[262144, int], te: var array[262144, int], i: int) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  if seal_any4(src, ts, te, i, "print", "sum", "dot", "norm") == 1:
    return 1
  if seal_any4(src, ts, te, i, "axpy", "disjoint_elem", "disjoint_row", "disjoint_slice") == 1:
    return 1
  if seal_any4(src, ts, te, i, "row_ok", "", "", "") == 1:
    return 1
  return 0

# is_std_module_symbol (generated from std/**/*.li by scripts/gen-stdlib-manifest.sh)
def seal_std_symbol(src: var ptr, ts: var array[262144, int], te: var array[262144, int], i: int) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  if seal_any4(src, ts, te, i, "__execution_decorators_doc", "Bytes", "StringView", "Reader") == 1:
    return 1
  if seal_any4(src, ts, te, i, "Writer", "bytes_len", "bytes_slice", "bytes_append") == 1:
    return 1
  if seal_any4(src, ts, te, i, "bytes_byte_at", "bytes_push_byte", "stringview_len", "stringview_byte_at") == 1:
    return 1
  if seal_any4(src, ts, te, i, "reader_new", "reader_remaining", "reader_read_byte", "reader_read_chunk") == 1:
    return 1
  if seal_any4(src, ts, te, i, "writer_new", "writer_push_byte", "writer_len", "") == 1:
    return 1
  return 0

# Reports E0330 for a name reserved by the prelude or the std/ tree. The
# prelude-type half applies to type aliases and procs alike (ns 0 = type alias,
# 1 = proc); the prelude-proc half applies to procs only, and dstd exempts
# files under std/ from the std-export half, as `check_stdlib_seal` does.
def seal_check_reserved(src: var ptr, ts: var array[262144, int], te: var array[262144, int], i: int, ns: int, dstd: int, err: var array[1, int]) -> int
  requires true
  ensures result == 1
  decreases 0
=
  var bad: int = 0
  if seal_prelude_type(src, ts, te, i) == 1:
    bad = 1
  if ns == 1:
    if seal_prelude_proc(src, ts, te, i) == 1:
      bad = 1
  if bad == 0:
    if dstd == 0:
      if seal_std_symbol(src, ts, te, i) == 1:
        bad = 1
  if bad == 1:
    err[0] = 1
    li_rt_emit_err(330)
  return 1

# `duplicate_definition` carries no error code in the C++ reference, so the
# walker reports it through the 900/lic.error slot. The name is recorded either
# way, matching the reference's set-insert semantics.
def seal_check_dup(src: var ptr, ts: var array[262144, int], te: var array[262144, int], i: int, names: var array[256, int], nn: var array[1, int], err: var array[1, int]) -> int
  requires true
  ensures result == 1
  decreases 0
=
  var k: int = 0
  var seen: int = 0
  while k < nn[0]:
    if tok_eq(src, ts, te, names[k], i) == 1:
      seen = 1
    k = k + 1
  if seen == 1:
    err[0] = 1
    li_rt_emit_err(900)
  if nn[0] < 256:
    names[nn[0]] = i
    nn[0] = nn[0] + 1
  return 1

# One entry point for a top-level definition name: ns 0 = type alias,
# ns 1 = proc / extern def / async def. Theorem/axiom/lemma declarations are
# outside the module model the C++ reference checks (Module carries types and
# procs only), so they are outside the seal as well.
def seal_def_check(src: var ptr, ts: var array[262144, int], te: var array[262144, int], i: int, ns: int, dstd: int, tnames: var array[256, int], tn: var array[1, int], pnames: var array[256, int], pn: var array[1, int], err: var array[1, int]) -> int
  requires true
  ensures result == 1
  decreases 0
=
  seal_check_reserved(src, ts, te, i, ns, dstd, err)
  if ns == 0:
    seal_check_dup(src, ts, te, i, tnames, tn, err)
  else:
    seal_check_dup(src, ts, te, i, pnames, pn, err)
  return 1

# ---- pass 1 over a (main or scratch) token stream: record top-level def
# heads into the tc sym tables. tc_mode 0 = register (normal pass 1),
# tc_mode 2 = import head scan only (import seeding: record heads, collect
# module paths, no seal). Only the te/ts/te/te-token scratch the caller owns
# is traversed, so the caller may re-lex other sources onto the same arrays
# between runs; last-write-wins semantics preserve the main module's own
# defs on top of seeded import heads (shadowing). The buffer compare and
# array writes carry src through sym_buf/sym_b0/sym_b1 so cross-buffer name
# matching in the finders distinguishes main vs import heads.
def tc_register_pass(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], sym_s: var array[8192, int], sym_kind: var array[8192, int], sym_ty: var array[8192, int], sym_aux: var array[8192, int], sym_buf: var array[8192, ptr], sym_b0: var array[8192, int], sym_b1: var array[8192, int], sym_n: var array[1, int], tc_mode: int, modq: var array[64, ptr], modp: var array[64, ptr], modn: var array[1, int], seal_tn: var array[256, int], seal_tc: var array[1, int], seal_pn: var array[256, int], seal_pc: var array[1, int], dstd: int) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  skip_newlines(tk, n, pi, err)
  while cur_kind(tk, n, pi, err) != 0:
    var k: int = cur_kind(tk, n, pi, err)
    if k == 11:
      pi[0] = pi[0] + 1
      if cur_kind(tk, n, pi, err) != 4:
        err[0] = 1
        return 1
      var tn: int = pi[0]
      if tc_mode != 2:
        seal_def_check(src, ts, te, tn, 0, dstd, seal_tn, seal_tc, seal_pn, seal_pc, err)
      pi[0] = pi[0] + 1
      tc_record_type_params(src, tk, n, pi, err, sym_s, sym_kind, sym_ty, sym_buf, sym_b0, sym_b1, sym_n)
      expect_k(tk, n, pi, err, 58)
      var rt: int = tc_skip_alias_rhs(src, tk, ts, te, n, pi, err, sym_s, sym_kind, sym_ty, sym_buf, sym_b0, sym_b1, sym_n)
      var ti: int = sym_n[0]
      if ti < 8192:
        var rta: int = tn
        var rtb: int = tn
        var rb0: int = peek_tk(ts, rta)
        var rb1: int = peek_tk(te, rtb)
        sym_b0[ti] = rb0
        sym_b1[ti] = rb1
        sym_s[ti] = tn
        sym_kind[ti] = 0
        sym_ty[ti] = rt
        sym_buf[ti] = src
        sym_n[0] = sym_n[0] + 1
      skip_newlines(tk, n, pi, err)
      continue
    if k == 16 or k == 17:
      # `private`(16)/`public`(17) visibility keyword before a def. In
      # import-head mode a private proc never surfaces into the merged table
      # (C++ merge_module adds only public procs): skip head+tail entirely.
      # The main-module pass records private defs normally (own-file privacy
      # is the encapsulation battery's job, not the sym table's).
      var vis: int = 0
      if k == 16:
        vis = 1
      pi[0] = pi[0] + 1
      if cur_kind(tk, n, pi, err) == 10 and tc_mode != 2:
        pi[0] = pi[0] + 1
        seal_def_check(src, ts, te, pi[0], 1, dstd, seal_tn, seal_tc, seal_pn, seal_pc, err)
        tc_record_proc(src, tk, ts, te, n, pi, err, 0, sym_s, sym_kind, sym_ty, sym_aux, sym_buf, sym_b0, sym_b1, sym_n)
        tc_skip_proc_tail(src, tk, ts, te, n, pi, err, 0)
        skip_newlines(tk, n, pi, err)
        continue
      if cur_kind(tk, n, pi, err) == 10 and tc_mode == 2:
        if vis == 1:
          # private def inside an import: record nothing; skip head + tail.
          pi[0] = pi[0] + 1
          tc_skip_proc_tail(src, tk, ts, te, n, pi, err, 0)
          skip_newlines(tk, n, pi, err)
          continue
        pi[0] = pi[0] + 1
        tc_record_proc(src, tk, ts, te, n, pi, err, 0, sym_s, sym_kind, sym_ty, sym_aux, sym_buf, sym_b0, sym_b1, sym_n)
        tc_skip_proc_tail(src, tk, ts, te, n, pi, err, 0)
        skip_newlines(tk, n, pi, err)
        continue
      skip_newlines(tk, n, pi, err)
      continue
    if k == 10:
      pi[0] = pi[0] + 1
      if tc_mode != 2:
        seal_def_check(src, ts, te, pi[0], 1, dstd, seal_tn, seal_tc, seal_pn, seal_pc, err)
      tc_record_proc(src, tk, ts, te, n, pi, err, 0, sym_s, sym_kind, sym_ty, sym_aux, sym_buf, sym_b0, sym_b1, sym_n)
      tc_skip_proc_tail(src, tk, ts, te, n, pi, err, 0)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 32:
      pi[0] = pi[0] + 1
      if cur_kind(tk, n, pi, err) == 10:
        pi[0] = pi[0] + 1
        if tc_mode != 2:
          seal_def_check(src, ts, te, pi[0], 1, dstd, seal_tn, seal_tc, seal_pn, seal_pc, err)
        tc_record_proc(src, tk, ts, te, n, pi, err, 1, sym_s, sym_kind, sym_ty, sym_aux, sym_buf, sym_b0, sym_b1, sym_n)
      tc_skip_proc_tail(src, tk, ts, te, n, pi, err, 1)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 33:
      pi[0] = pi[0] + 1
      if cur_kind(tk, n, pi, err) == 10:
        pi[0] = pi[0] + 1
        if tc_mode != 2:
          seal_def_check(src, ts, te, pi[0], 1, dstd, seal_tn, seal_tc, seal_pn, seal_pc, err)
      tc_record_proc(src, tk, ts, te, n, pi, err, 0, sym_s, sym_kind, sym_ty, sym_aux, sym_buf, sym_b0, sym_b1, sym_n)
      tc_skip_proc_tail(src, tk, ts, te, n, pi, err, 0)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 76:
      if tc_mode != 2:
        parse_decorator_list(src, tk, ts, te, n, pi, err, 0)
        continue
      pi[0] = pi[0] + 1
      continue
    if k == 18:
      if tc_mode != 2:
        parse_import(src, tk, ts, te, n, pi, err, 0)
        skip_newlines(tk, n, pi, err)
        continue
      # ---- import head collection: module path token run after `import` ----
      pi[0] = pi[0] + 1
      skip_newlines(tk, n, pi, err)
      if cur_kind(tk, n, pi, err) != 4:
        skip_newlines(tk, n, pi, err)
        continue
      var mtok: int = pi[0]
      var im_end: int = mtok
      var im_guard: int = 0
      while im_guard < 8:
        if im_end + 2 < n[0]:
          if peek_tk(tk, im_end + 1) == 72:
            if peek_tk(tk, im_end + 2) == 4:
              im_end = im_end + 2
              im_guard = im_guard + 1
              continue
        break
      var mlen: int = peek_tk(te, im_end) - peek_tk(ts, mtok)
      var mname: ptr = bytes_slice_i(src, peek_tk(ts, mtok), mlen)
      if modn[0] < 64:
        modq[modn[0]] = mname
        modp[modn[0]] = src
        modn[0] = modn[0] + 1
      while pi[0] <= im_end:
        pi[0] = pi[0] + 1
      skip_newlines(tk, n, pi, err)
      continue
    if k == 13 or k == 12 or k == 14:
      if tc_mode != 2:
        pi[0] = pi[0] + 1
        parse_theorem(src, tk, ts, te, n, pi, err, 0, 0, 0)
        skip_newlines(tk, n, pi, err)
        continue
      while cur_kind(tk, n, pi, err) != 1:
        if cur_kind(tk, n, pi, err) == 0:
          break
        pi[0] = pi[0] + 1
      skip_newlines(tk, n, pi, err)
      continue
    if k == 16 or k == 17:
      pi[0] = pi[0] + 1
      continue
    if tc_mode != 2:
      err[0] = 1
      return 1
    pi[0] = pi[0] + 1
  return 0

def check_source(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int]) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  var sym_s: array[8192, int]
  var sym_kind: array[8192, int]
  var sym_ty: array[8192, int]
  var sym_aux: array[8192, int]
  var sym_buf: array[8192, ptr]
  var sym_b0: array[8192, int]
  var sym_b1: array[8192, int]
  var sym_n: array[1, int]
  var cur_ret: array[1, int]
  var seal_tn: array[256, int]
  var seal_tc: array[1, int]
  var seal_pn: array[256, int]
  var seal_pc: array[1, int]
  var seal_std: int = 0
  sym_n[0] = 0
  seal_tc[0] = 0
  seal_pc[0] = 0
  # `defining_std`: a file under std/ may define std exports. The three path
  # shapes are the C++ reference's (prelude.cpp `check_stdlib_seal`): a `std/`
  # prefix, or `/std/` or `\std\` anywhere in the path.
  if li_rt_str_prefix(li_rt_argv(2), "std/") == 1:
    seal_std = 1
  if li_rt_str_contains(li_rt_argv(2), "/std/") == 1:
    seal_std = 1
  if li_rt_str_contains(li_rt_argv(2), "\std\") == 1:
    seal_std = 1
  # ---- import head seeding: register the heads of transitively resolved
  # imports into the shared tc sym tables before pass 1 (C++ merge_module
  # loads imports into the merged module before checking). Each module is
  # lexed onto the shared scratch arrays (clobber + re-lex restore, the
  # type-space gate's own DFS pattern); seeded entries live on with
  # cross-buffer spans (sym_buf/sym_b0/sym_b1) and lose to main-module defs
  # through the finders' reverse scan. An unresolvable or unreadable import
  # disables seeding only (under-reject convention).
  var qc: array[64, ptr]
  var qp: array[64, ptr]
  var qn: int = 0
  var seen_p: array[64, ptr]
  var seen_n: int = 0
  var bail: int = 0
  var wq: array[64, ptr]
  var wp: array[64, ptr]
  var wn: array[1, int]
  wn[0] = 0
  var i_i: int = 0
  while i_i < n[0]:
    if peek_tk(tk, i_i) == 18:
      var ntok: int = i_i + 1
      if ntok < n[0]:
        if peek_tk(tk, ntok) == 4:
          var je: int = ntok
          var jg: int = 0
          while jg < 8:
            if je + 2 < n[0]:
              if peek_tk(tk, je + 1) == 72:
                if peek_tk(tk, je + 2) == 4:
                  je = je + 2
                  jg = jg + 1
                  continue
            break
          var jl: int = peek_tk(te, je) - peek_tk(ts, ntok)
          var jm: ptr = bytes_slice_i(src, peek_tk(ts, ntok), jl)
          var ji: ptr = li_rt_resolve_import(li_rt_argv(2), jm)
          if ji == 0:
            bail = 1
          if ji != 0:
            if qn < 64:
              qc[qn] = ji
              qp[qn] = li_rt_import_path_dup(li_rt_resolve_import_last_path())
              qn = qn + 1
    i_i = i_i + 1
  while qn > 0:
    qn = qn - 1
    var pop_c: ptr = qc[qn]
    var pop_p: ptr = qp[qn]
    var jd: int = 0
    var jj: int = 0
    while jj < seen_n:
      if seen_p[jj] != 0:
        if li_rt_str_eq(seen_p[jj], pop_p) == 1:
          jd = 1
      jj = jj + 1
    if jd == 0:
      if seen_n < 64:
        seen_p[seen_n] = pop_p
        seen_n = seen_n + 1
      n[0] = 0
      pi[0] = 0
      var lx: int = lex_source(pop_c, tk, ts, te, n, 0)
      if lx == 1:
        bail = 1
      if lx == 0:
        var lq: array[64, ptr]
        var lp: array[64, ptr]
        var ln: array[1, int]
        ln[0] = 0
        tc_register_pass(pop_c, tk, ts, te, n, pi, err, sym_s, sym_kind, sym_ty, sym_aux, sym_buf, sym_b0, sym_b1, sym_n, 2, lq, lp, ln, seal_tn, seal_tc, seal_pn, seal_pc, 0)
        var mi: int = 0
        while mi < n[0]:
          var mk: int = peek_tk(tk, mi)
          if mk == 18:
            var m2: int = mi + 1
            if m2 < n[0]:
              if peek_tk(tk, m2) == 4:
                var je2: int = m2
                var jg2: int = 0
                while jg2 < 8:
                  if je2 + 2 < n[0]:
                    if peek_tk(tk, je2 + 1) == 72:
                      if peek_tk(tk, je2 + 2) == 4:
                        je2 = je2 + 2
                        jg2 = jg2 + 1
                        continue
                  break
                var jl2: int = peek_tk(te, je2) - peek_tk(ts, m2)
                var im2: ptr = bytes_slice_i(pop_c, peek_tk(ts, m2), jl2)
                var ji2: ptr = li_rt_resolve_import(pop_p, im2)
                if ji2 == 0:
                  bail = 1
                if ji2 != 0:
                  if qn < 64:
                    qc[qn] = ji2
                    qp[qn] = li_rt_import_path_dup(li_rt_resolve_import_last_path())
                    qn = qn + 1
          mi = mi + 1
  if bail == 1:
    sym_n[0] = 0
  n[0] = 0
  pi[0] = 0
  err[0] = 0
  if lex_source(src, tk, ts, te, n, 0) == 1:
    err[0] = 1
    return 1
  var r1: int = tc_register_pass(src, tk, ts, te, n, pi, err, sym_s, sym_kind, sym_ty, sym_aux, sym_buf, sym_b0, sym_b1, sym_n, 0, wq, wp, wn, seal_tn, seal_tc, seal_pn, seal_pc, seal_std)
  if r1 == 1:
    return 1
  pi[0] = 0
  skip_newlines(tk, n, pi, err)
  while cur_kind(tk, n, pi, err) != 0:
    var k: int = cur_kind(tk, n, pi, err)
    if k == 32:
      pi[0] = pi[0] + 1
      if cur_kind(tk, n, pi, err) == 10:
        pi[0] = pi[0] + 1
        if cur_kind(tk, n, pi, err) != 4:
          err[0] = 1
          return 1
        pi[0] = pi[0] + 1
        fx_skip_typeparams(tk, n, pi, err)
        expect_k(tk, n, pi, err, 49)
        skip_param_layout(tk, n, pi, err)
        if cur_kind(tk, n, pi, err) != 50:
          var done: int = 0
          while done == 0:
            tc_skip_param(src, tk, ts, te, n, pi, err, sym_s, sym_kind, sym_ty, sym_buf, sym_b0, sym_b1, sym_n)
            if accept_k(tk, n, pi, err, 55) == 1:
              done = 0
            else:
              done = 1
        skip_param_layout(tk, n, pi, err)
        expect_k(tk, n, pi, err, 50)
        tc_skip_raises(tk, n, pi, err)
        var ret2: int = 6
        if accept_k(tk, n, pi, err, 57) == 1:
          ret2 = tc_parse_type(src, tk, ts, te, n, pi, err, sym_s, sym_kind, sym_ty, sym_buf, sym_b0, sym_b1, sym_n)
        tc_skip_raises(tk, n, pi, err)
        tc_collect_contracts(src, tk, ts, te, n, pi, err, 1, ret2, sym_s, sym_kind, sym_ty, sym_aux, sym_buf, sym_b0, sym_b1, sym_n)
        skip_newlines(tk, n, pi, err)
        continue
    if k == 10 or k == 33:
      pi[0] = pi[0] + 1
      if k == 33:
        if cur_kind(tk, n, pi, err) == 10:
          pi[0] = pi[0] + 1
      if cur_kind(tk, n, pi, err) != 4:
        err[0] = 1
        return 1
      pi[0] = pi[0] + 1
      fx_skip_typeparams(tk, n, pi, err)
      expect_k(tk, n, pi, err, 49)
      skip_param_layout(tk, n, pi, err)
      if cur_kind(tk, n, pi, err) != 50:
        var done: int = 0
        while done == 0:
          tc_record_param(src, tk, ts, te, n, pi, err, sym_s, sym_kind, sym_ty, sym_buf, sym_b0, sym_b1, sym_n)
          if accept_k(tk, n, pi, err, 55) == 1:
            done = 0
          else:
            done = 1
      skip_param_layout(tk, n, pi, err)
      expect_k(tk, n, pi, err, 50)
      tc_skip_raises(tk, n, pi, err)
      var ret3: int = 6
      if accept_k(tk, n, pi, err, 57) == 1:
        ret3 = tc_parse_type(src, tk, ts, te, n, pi, err, sym_s, sym_kind, sym_ty, sym_buf, sym_b0, sym_b1, sym_n)
      tc_skip_raises(tk, n, pi, err)
      tc_collect_contracts(src, tk, ts, te, n, pi, err, 0, ret3, sym_s, sym_kind, sym_ty, sym_aux, sym_buf, sym_b0, sym_b1, sym_n)
      skip_newlines(tk, n, pi, err)
      tc_check_proc_body(src, tk, ts, te, n, pi, err, ret3, cur_ret, sym_s, sym_kind, sym_ty, sym_aux, sym_buf, sym_b0, sym_b1, sym_n)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 11:
      pi[0] = pi[0] + 1
      if cur_kind(tk, n, pi, err) != 4:
        err[0] = 1
        return 1
      pi[0] = pi[0] + 1
      if accept_k(tk, n, pi, err, 51) == 1:
        if cur_kind(tk, n, pi, err) != 52:
          var done: int = 0
          while done == 0:
            if cur_kind(tk, n, pi, err) == 4:
              pi[0] = pi[0] + 1
            if accept_k(tk, n, pi, err, 55) == 1:
              done = 0
            else:
              done = 1
        expect_k(tk, n, pi, err, 52)
      expect_k(tk, n, pi, err, 58)
      tc_skip_alias_rhs(src, tk, ts, te, n, pi, err, sym_s, sym_kind, sym_ty, sym_buf, sym_b0, sym_b1, sym_n)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 76:
      parse_decorator_list(src, tk, ts, te, n, pi, err, 0)
      continue
    if k == 18:
      parse_import(src, tk, ts, te, n, pi, err, 0)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 13 or k == 12 or k == 14:
      pi[0] = pi[0] + 1
      parse_theorem(src, tk, ts, te, n, pi, err, 0, 0, 0)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 16 or k == 17:
      pi[0] = pi[0] + 1
      continue
    err[0] = 1
    return 1
  if err[0] == 1:
    return 1
  return 0

# ---- Layer 4b: effect checking (raises IO / Alloc / Net / Async) ----
# Effect bits: IO=1, Alloc=2, Net=4, Async=8 (bitmask; each added once).
def fx_eff_bit(src: var ptr, ts: var array[262144, int], te: var array[262144, int], i: int) -> int
  requires true
  ensures result >= 0
  decreases 0
=
  if tok_is(src, ts, te, i, "IO") == 1:
    return 1
  if tok_is(src, ts, te, i, "Alloc") == 1:
    return 2
  if tok_is(src, ts, te, i, "Net") == 1:
    return 4
  if tok_is(src, ts, te, i, "Async") == 1:
    return 8
  return 0

def fx_has_eff(m: int, b: int) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  if b == 0:
    return 0
  if (m // b) % 2 == 1:
    return 1
  return 0

def fx_add_eff(used: var array[1, int], b: int) -> int
  requires true
  ensures result == 0
  decreases 0
=
  if b > 0:
    if fx_has_eff(used[0], b) == 0:
      used[0] = used[0] + b
  return 0

def fx_is_heap(src: var ptr, ts: var array[262144, int], te: var array[262144, int], i: int) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  if tok_is(src, ts, te, i, "list") == 1:
    return 1
  if tok_is(src, ts, te, i, "dict") == 1:
    return 1
  if tok_is(src, ts, te, i, "set") == 1:
    return 1
  if tok_is(src, ts, te, i, "str") == 1:
    return 1
  if tok_is(src, ts, te, i, "bytes") == 1:
    return 1
  if tok_is(src, ts, te, i, "stringview") == 1:
    return 1
  if tok_is(src, ts, te, i, "Bytes") == 1:
    return 1
  if tok_is(src, ts, te, i, "StringView") == 1:
    return 1
  return 0

def fx_proc_ext(src: var ptr, ts: var array[262144, int], te: var array[262144, int], isrc: var array[256, ptr], isn: var array[256, int], ise: var array[256, int], iext: var array[256, int], icnt: var array[1, int], pn: var array[256, int], pext: var array[256, int], pcnt: var array[1, int], name_tok: int) -> int
  requires true
  ensures result >= -1
  decreases 0
=
  # Import-space triples first: entries carry their own source pointer and
  # char span (captured at collection time), so imported-module names
  # resolve while the call-side name token is spanned against the LIVE ts/te
  # — then the main module's token-index table as before.
  var ns2: int = peek_tk(ts, name_tok + 0)
  var ne2: int = peek_tk(te, name_tok + 0)
  var k: int = 0
  while k < icnt[0]:
    if fx_span_eq(isrc[k], isn[k], ise[k], src, ns2, ne2) == 1:
      return iext[k]
    k = k + 1
  k = 0
  while k < pcnt[0]:
    if tok_eq(src, ts, te, pn[k], name_tok) == 1:
      return pext[k]
    k = k + 1
  return -1

def fx_proc_eff(src: var ptr, ts: var array[262144, int], te: var array[262144, int], isrc: var array[256, ptr], isn: var array[256, int], ise: var array[256, int], ieff: var array[256, int], icnt: var array[1, int], pn: var array[256, int], peff: var array[256, int], pcnt: var array[1, int], name_tok: int) -> int
  requires true
  ensures result >= -1
  decreases 0
=
  var ns2: int = peek_tk(ts, name_tok + 0)
  var ne2: int = peek_tk(te, name_tok + 0)
  var k: int = 0
  while k < icnt[0]:
    if fx_span_eq(isrc[k], isn[k], ise[k], src, ns2, ne2) == 1:
      return ieff[k]
    k = k + 1
  k = 0
  while k < pcnt[0]:
    if tok_eq(src, ts, te, pn[k], name_tok) == 1:
      return peff[k]
    k = k + 1
  return -1

def fx_skip_typeparams(tk: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int]) -> int
  requires true
  ensures result == 1
  decreases 0
=
  if accept_k(tk, n, pi, err, 51) == 1:
    if cur_kind(tk, n, pi, err) != 52:
      var done: int = 0
      while done == 0:
        pi[0] = pi[0] + 1
        if accept_k(tk, n, pi, err, 56) == 1:
          if cur_kind(tk, n, pi, err) == 4:
            pi[0] = pi[0] + 1
        if accept_k(tk, n, pi, err, 55) == 1:
          done = 0
        else:
          done = 1
    expect_k(tk, n, pi, err, 52)
  return 1

def fx_skip_params(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], heap: var array[1, int], mask_row: int) -> int
  requires true
  ensures result == 1
  decreases 0
=
  # Param-shape capture for the borrow class (C++ borrowck resolve via the
  # merged proc_map): while walking, every param's is-var/is-scalar head
  # bits accumulate as per-param bit j (pw = 2^j) into two rows keyed by
  # the fx proc-row index (preg 15 = var mask, preg 16 = scalar mask).
  # mask_row < 0 (or >= 256) skips the write: shared callers outside the
  # fx pass1 seed path stay inert.
  var j2: int = 0
  var mvar: int = 0
  var msc: int = 0
  skip_param_layout(tk, n, pi, err)
  if cur_kind(tk, n, pi, err) != 50:
    var done: int = 0
    while done == 0:
      skip_param_layout(tk, n, pi, err)
      if cur_kind(tk, n, pi, err) == 4:
        pi[0] = pi[0] + 1
        expect_k(tk, n, pi, err, 56)
        var mvis: int = 0
        if cur_kind(tk, n, pi, err) == 20:
          mvis = 1
        if cur_kind(tk, n, pi, err) == 4:
          if fx_is_heap(src,ts,te,pi[0]) == 1:
            heap[0] = 1
          if bk_scalar_name(src,ts,te,pi[0]) == 1:
            mvis = 2
        parse_type(src, tk, ts, te, n, pi, err, 0)
        var pw: int = 1
        var q2: int = 0
        while q2 < j2:
          pw = pw * 2
          q2 = q2 + 1
        if mvis == 1:
          mvar = mvar + pw
        if mvis == 2:
          msc = msc + pw
        j2 = j2 + 1
      skip_param_layout(tk, n, pi, err)
      if accept_k(tk, n, pi, err, 55) == 1:
        done = 0
      else:
        done = 1
  skip_param_layout(tk, n, pi, err)
  expect_k(tk, n, pi, err, 50)
  if mask_row >= 0:
    if mask_row < 256:
      li_rt_preg_set(15, mask_row + 0, mvar)
      li_rt_preg_set(16, mask_row + 0, msc)
  return 1

def fx_record_raises(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], decl: var array[1, int]) -> int
  requires true
  ensures result == 1
  decreases 0
=
  skip_newlines(tk, n, pi, err)
  if cur_kind(tk, n, pi, err) == 31:
    pi[0] = pi[0] + 1
    if cur_kind(tk, n, pi, err) == 4:
      var done: int = 0
      while done == 0:
        var b: int = fx_eff_bit(src, ts, te, pi[0])
        fx_add_eff(decl, b)
        pi[0] = pi[0] + 1
        if accept_k(tk, n, pi, err, 55) == 1:
          done = 0
        else:
          done = 1
  skip_newlines(tk, n, pi, err)
  return 1

def fx_skip_decorators(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], pend: var array[1, int]) -> int
  requires true
  ensures result == 1
  decreases 0
=
  pend[0] = 0
  while cur_kind(tk, n, pi, err) == 76:
    pi[0] = pi[0] + 1
    if cur_kind(tk, n, pi, err) == 33:
      pend[0] = 1
    if cur_kind(tk, n, pi, err) == 4 or cur_kind(tk, n, pi, err) == 33:
      pi[0] = pi[0] + 1
    if accept_k(tk, n, pi, err, 49) == 1:
      if cur_kind(tk, n, pi, err) != 50:
        var done: int = 0
        while done == 0:
          # decorator args may be `name = expr` pairs (e.g.
          # `@parallel(disjoint=disjoint_elem)`); the bare parse_expr call
          # left the `=` stranding the fx/borrow walk on E0999-class
          # fallthroughs. Consume the `name =` prefix first (C++
          # parse_decorator_list does the same for assignments).
          if cur_kind(tk, n, pi, err) == 4:
            if peek_off(tk, n, pi, 1) == 58:
              pi[0] = pi[0] + 2
          parse_expr(src, tk, ts, te, n, pi, err, 0, 0)
          if accept_k(tk, n, pi, err, 55) == 1:
            done = 0
          else:
            done = 1
      expect_k(tk, n, pi, err, 50)
    skip_newlines(tk, n, pi, err)
  return 1

def fx_skip_typealias(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int]) -> int
  requires true
  ensures result == 1
  decreases 0
=
  return parse_type_alias(src, tk, ts, te, n, pi, err, 0)

def fx_scan_expr(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], isrc: var array[256, ptr], isn: var array[256, int], ise: var array[256, int], iext: var array[256, int], ieff: var array[256, int], icnt: var array[1, int], pn: var array[256, int], peff: var array[256, int], pext: var array[256, int], pcnt: var array[1, int], depth: int, used: var array[1, int], await_seen: var array[1, int]) -> int
  requires true
  ensures result == 1
  decreases 0
=
  # proc_mentions_extern_call mirror: only the statement ROOT call counts —
  # the head position (bare expr / Return expr) or the token directly after
  # a depth-0 `=` (Assign RHS). Nested calls never fire.
  var p0: int = pi[0]
  var eq_tok: int = 0 - 1
  var depth: int = 0
  while 1 == 1:
    var k: int = cur_kind(tk, n, pi, err)
    if depth == 0:
      if k == 1 or k == 3 or k == 0 or k == 56 or k == 55:
        break
      if k == 58:
        eq_tok = pi[0]
    if k == 49 or k == 51 or k == 53:
      depth = depth + 1
    if k == 50 or k == 52 or k == 54:
      depth = depth - 1
    if k == 34:
      await_seen[0] = 1
    if k == 4:
      if peek_off(tk, n, pi, 1) == 49:
        if tok_is(src, ts, te, pi[0], "print") == 1 or tok_is(src, ts, te, pi[0], "echo") == 1:
          # C++ builtin_output rule: echo/print count as IO output builtin
          # only when no proc of that name is in the proc_map — the merged
          # import-space table supplies count>0 for imported user procs.
          if fx_proc_ext(src, ts, te, isrc, isn, ise, iext, icnt, pn, pext, pcnt, pi[0]) == 0 - 1:
            fx_add_eff(used, 1)
        var is_root: int = 0
        if eq_tok >= 0:
          if pi[0] == eq_tok + 1:
            is_root = 1
        if is_root == 1:
          if depth == 0:
            if fx_proc_ext(src, ts, te, isrc, isn, ise, iext, icnt, pn, pext, pcnt, pi[0]) == 1:
              fx_add_eff(used, 1)
        var cf: int = fx_proc_eff(src, ts, te, isrc, isn, ise, ieff, icnt, pn, peff, pcnt, pi[0])
        if cf >= 0:
          if fx_has_eff(cf, 4) == 1:
            fx_add_eff(used, 4)
          if fx_has_eff(cf, 8) == 1:
            fx_add_eff(used, 8)
    pi[0] = pi[0] + 1
  return 1

def fx_scan_block(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], isrc: var array[256, ptr], isn: var array[256, int], ise: var array[256, int], iext: var array[256, int], ieff: var array[256, int], icnt: var array[1, int], pn: var array[256, int], peff: var array[256, int], pext: var array[256, int], pcnt: var array[1, int], depth: int, used: var array[1, int], await_seen: var array[1, int]) -> int
  requires true
  ensures result == 1
  decreases 0
=
  skip_newlines(tk, n, pi, err)
  if expect_k(tk, n, pi, err, 2) == 0:
    return 1
  skip_newlines(tk, n, pi, err)
  while 1 == 1:
    if cur_kind(tk, n, pi, err) == 3:
      break
    if cur_kind(tk, n, pi, err) == 0:
      break
    var before: int = pi[0]
    fx_scan_stmt(src, tk, ts, te, n, pi, err, isrc, isn, ise, iext, ieff, icnt, pn, peff, pext, pcnt, depth, used, await_seen)
    if pi[0] == before:
      break
    skip_newlines(tk, n, pi, err)
  expect_k(tk, n, pi, err, 3)
  return 1

def fx_scan_stmt(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], isrc: var array[256, ptr], isn: var array[256, int], ise: var array[256, int], iext: var array[256, int], ieff: var array[256, int], icnt: var array[1, int], pn: var array[256, int], peff: var array[256, int], pext: var array[256, int], pcnt: var array[1, int], depth: int, used: var array[1, int], await_seen: var array[1, int]) -> int
  requires true
  ensures result == 1
  decreases 0
=
  var k: int = cur_kind(tk, n, pi, err)
  if k == 20:
    pi[0] = pi[0] + 1
    if cur_kind(tk, n, pi, err) == 4:
      pi[0] = pi[0] + 1
    if accept_k(tk, n, pi, err, 56) == 1:
      parse_type(src, tk, ts, te, n, pi, err, 0)
    if accept_k(tk, n, pi, err, 58) == 1:
      parse_expr(src, tk, ts, te, n, pi, err, 0, 0)
    return 1
  if k == 30:
    pi[0] = pi[0] + 1
    if cur_kind(tk, n, pi, err) != 1:
      # Return stmt: s.expr is a root per proc_mentions_extern_call.
      if cur_kind(tk, n, pi, err) == 4:
        if peek_off(tk, n, pi, 1) == 49:
          if depth == 0:
            if fx_proc_ext(src, ts, te, isrc, isn, ise, iext, icnt, pn, pext, pcnt, pi[0]) == 1:
              fx_add_eff(used, 1)
      fx_scan_expr(src, tk, ts, te, n, pi, err, isrc, isn, ise, iext, ieff, icnt, pn, peff, pext, pcnt, depth, used, await_seen)
    return 1
  if k == 22:
    pi[0] = pi[0] + 1
    fx_scan_expr(src, tk, ts, te, n, pi, err, isrc, isn, ise, iext, ieff, icnt, pn, peff, pext, pcnt, depth, used, await_seen)
    expect_k(tk, n, pi, err, 56)
    skip_newlines(tk, n, pi, err)
    fx_scan_block(src, tk, ts, te, n, pi, err, isrc, isn, ise, iext, ieff, icnt, pn, peff, pext, pcnt, depth + 1, used, await_seen)
    while cur_kind(tk, n, pi, err) == 24:
      pi[0] = pi[0] + 1
      fx_scan_expr(src, tk, ts, te, n, pi, err, isrc, isn, ise, iext, ieff, icnt, pn, peff, pext, pcnt, depth, used, await_seen)
      expect_k(tk, n, pi, err, 56)
      skip_newlines(tk, n, pi, err)
      fx_scan_block(src, tk, ts, te, n, pi, err, isrc, isn, ise, iext, ieff, icnt, pn, peff, pext, pcnt, depth + 1, used, await_seen)
    if cur_kind(tk, n, pi, err) == 23:
      pi[0] = pi[0] + 1
      expect_k(tk, n, pi, err, 56)
      skip_newlines(tk, n, pi, err)
      fx_scan_block(src, tk, ts, te, n, pi, err, isrc, isn, ise, iext, ieff, icnt, pn, peff, pext, pcnt, depth + 1, used, await_seen)
    return 1
  if k == 25:
    pi[0] = pi[0] + 1
    fx_scan_expr(src, tk, ts, te, n, pi, err, isrc, isn, ise, iext, ieff, icnt, pn, peff, pext, pcnt, depth, used, await_seen)
    if cur_kind(tk, n, pi, err) == 56:
      pi[0] = pi[0] + 1
    skip_newlines(tk, n, pi, err)
    fx_scan_block(src, tk, ts, te, n, pi, err, isrc, isn, ise, iext, ieff, icnt, pn, peff, pext, pcnt, depth + 1, used, await_seen)
    return 1
  if k == 76:
    parse_decorator_list(src, tk, ts, te, n, pi, err, 0)
    skip_newlines(tk, n, pi, err)
    fx_scan_stmt(src, tk, ts, te, n, pi, err, isrc, isn, ise, iext, ieff, icnt, pn, peff, pext, pcnt, depth, used, await_seen)
    return 1
  if k == 26:
    pi[0] = pi[0] + 1
    var fh: array[3, int]
    for_tail(src, tk, ts, te, n, pi, err, fh)
    skip_newlines(tk, n, pi, err)
    fx_scan_block(src, tk, ts, te, n, pi, err, isrc, isn, ise, iext, ieff, icnt, pn, peff, pext, pcnt, depth + 1, used, await_seen)
    return 1
  if k == 4:
    if tok_is(src, ts, te, pi[0], "parallel") == 1:
      # parallel for mirrors the tc_stmt branch: the C++ effects pass never
      # walks the contract clauses (check_stmt ParallelFor registers only the
      # loop index and checks the body), so this consumes the header and the
      # contract block quietly and scans the body through fx_scan_block.
      pi[0] = pi[0] + 1
      if tok_is(src, ts, te, pi[0], "for") == 1:
        pi[0] = pi[0] + 1
      var ph: array[3, int]
      for_tail(src, tk, ts, te, n, pi, err, ph)
      skip_newlines(tk, n, pi, err)
      if accept_k(tk, n, pi, err, 2) == 1:
        skip_newlines(tk, n, pi, err)
        var pc: int = 0
        while pc == 0:
          var pk: int = cur_kind(tk, n, pi, err)
          if pk == 41 or pk == 42 or pk == 43 or pk == 44 or pk == 45:
            parse_contract(src, tk, ts, te, n, pi, err, 0)
            continue
          pc = 1
        expect_k(tk, n, pi, err, 3)
        skip_newlines(tk, n, pi, err)
      if accept_k(tk, n, pi, err, 58) == 1:
        skip_newlines(tk, n, pi, err)
        if cur_kind(tk, n, pi, err) == 2:
          fx_scan_block(src, tk, ts, te, n, pi, err, isrc, isn, ise, iext, ieff, icnt, pn, peff, pext, pcnt, depth + 1, used, await_seen)
      return 1
  # Expr/Assign stmt: the head call is a root (s.expr on Expr stmts; the
  # Assign RHS-root is tracked inside fx_scan_expr via the depth-0 `=`).
  # If/while conds and var-decl inits are never roots for the extern rule.
  if cur_kind(tk, n, pi, err) == 4:
    if peek_off(tk, n, pi, 1) == 49:
      if depth == 0:
        if fx_proc_ext(src, ts, te, isrc, isn, ise, iext, icnt, pn, pext, pcnt, pi[0]) == 1:
          fx_add_eff(used, 1)
  fx_scan_expr(src, tk, ts, te, n, pi, err, isrc, isn, ise, iext, ieff, icnt, pn, peff, pext, pcnt, depth, used, await_seen)
  if accept_k(tk, n, pi, err, 58) == 1:
    fx_scan_expr(src, tk, ts, te, n, pi, err, isrc, isn, ise, iext, ieff, icnt, pn, peff, pext, pcnt, depth, used, await_seen)
  return 1

def effects_check(src: var ptr,  file_path: ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int]) raises IO -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  var pn: array[256, int]
  var peff: array[256, int]
  var pext: array[256, int]
  var pcnt: array[1, int]
  var pend: array[1, int]
  var decl: array[1, int]
  var heap: array[1, int]
  var used: array[1, int]
  var await_seen: array[1, int]
  # Import-space proc-name tables (source pointer + char span per entry,
  # fx_span_eq compared) — the C++ host's proc_map contains every proc of
  # the merged module (imports included), so the check lane's echo/print
  # builtin-exclusivity test and extern-call resolution must see imported
  # names too. Seeded from the main module with fx_mir_pass1 (span triples,
  # appended), then merged with every transitively imported module through
  # fx_import_merge — the same path the mir lane uses.
  var isrc: array[256, ptr]
  var isn: array[256, int]
  var ise: array[256, int]
  var iext: array[256, int]
  var ieff: array[256, int]
  var icnt: array[1, int]
  icnt[0] = 0
  # Seed pass may itself fire the E0303 weak-ensures rule (returns 1) or the
  # E0201/E0202 missing-clause rules: capture the verdict — fx_import_merge
  # clears err[0] at its entry, so re-apply it AFTER the merge rather than
  # through the err channel directly (the check driver reads err after this
  # def returns; the walk still completes for whatever comes after).
  var ivis: array[256, int]
  var esv: int = fx_mir_pass1(src, tk, ts, te, n, pi, err, isrc, isn, ise, ieff, iext, ivis, icnt, 1)
  var mr: int = fx_import_merge(file_path, src, tk, ts, te, n, pi, err, isrc, isn, ise, ieff, iext, ivis, icnt)
  if mr != 0 or esv == 1:
    err[0] = 1
  if mr != 0:
    return 1
  pcnt[0] = 0
  pend[0] = 0
  pi[0] = 0
  skip_newlines(tk, n, pi, err)
  while cur_kind(tk, n, pi, err) != 0:
    var k: int = cur_kind(tk, n, pi, err)
    if k == 11:
      fx_skip_typealias(src, tk, ts, te, n, pi, err)
      continue
    if k == 76:
      fx_skip_decorators(src, tk, ts, te, n, pi, err, pend)
      continue
    if k == 18:
      parse_import(src, tk, ts, te, n, pi, err, 0)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 13 or k == 12 or k == 14:
      pi[0] = pi[0] + 1
      parse_theorem(src, tk, ts, te, n, pi, err, 0, 0, 0)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 16 or k == 17:
      pi[0] = pi[0] + 1
      skip_newlines(tk, n, pi, err)
      continue
    if k == 32 or k == 10 or k == 33:
      var is_ext: int = 0
      var is_asy: int = pend[0]
      pend[0] = 0
      if k == 32:
        is_ext = 1
        pi[0] = pi[0] + 1
        if cur_kind(tk, n, pi, err) == 10:
          pi[0] = pi[0] + 1
      if k == 33:
        is_asy = 1
        pi[0] = pi[0] + 1
        if cur_kind(tk, n, pi, err) == 10:
          pi[0] = pi[0] + 1
      if k == 10:
        pi[0] = pi[0] + 1
      if cur_kind(tk, n, pi, err) != 4:
        err[0] = 1
        return 1
      var nm: int = pi[0]
      pi[0] = pi[0] + 1
      var idx: int = pcnt[0]
      if idx < 256:
        pn[idx] = nm
        pext[idx] = is_ext
        peff[idx] = 0
        pcnt[0] = pcnt[0] + 1
      decl[0] = 0
      heap[0] = 0
      fx_skip_typeparams(tk, n, pi, err)
      expect_k(tk, n, pi, err, 49)
      fx_skip_params(src, tk, ts, te, n, pi, err, heap, 0 - 1)
      fx_record_raises(src, tk, ts, te, n, pi, err, decl)
      if accept_k(tk, n, pi, err, 57) == 1:
        if cur_kind(tk, n, pi, err) == 4:
          if fx_is_heap(src, ts, te, pi[0]) == 1:
            heap[0] = 1
        parse_type(src, tk, ts, te, n, pi, err, 0)
      fx_record_raises(src, tk, ts, te, n, pi, err, decl)
      if idx < 256:
        peff[idx] = decl[0]
      while 1 == 1:
        var ck: int = cur_kind(tk, n, pi, err)
        if ck == 41 or ck == 42 or ck == 43 or ck == 44 or ck == 45:
          parse_contract(src, tk, ts, te, n, pi, err, 0)
          continue
        break
      if is_ext == 0:
        skip_newlines(tk, n, pi, err)
        if accept_k(tk, n, pi, err, 58) == 1:
          skip_newlines(tk, n, pi, err)
          if cur_kind(tk, n, pi, err) == 2:
            parse_block(src, tk, ts, te, n, pi, err, 0)
      skip_newlines(tk, n, pi, err)
      continue
    err[0] = 1
    return 1
  pi[0] = 0
  pend[0] = 0
  skip_newlines(tk, n, pi, err)
  while cur_kind(tk, n, pi, err) != 0:
    var k: int = cur_kind(tk, n, pi, err)
    if k == 11:
      fx_skip_typealias(src, tk, ts, te, n, pi, err)
      continue
    if k == 76:
      fx_skip_decorators(src, tk, ts, te, n, pi, err, pend)
      continue
    if k == 18:
      parse_import(src, tk, ts, te, n, pi, err, 0)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 13 or k == 12 or k == 14:
      pi[0] = pi[0] + 1
      parse_theorem(src, tk, ts, te, n, pi, err, 0, 0, 0)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 16 or k == 17:
      pi[0] = pi[0] + 1
      skip_newlines(tk, n, pi, err)
      continue
    if k == 32 or k == 10 or k == 33:
      var is_ext: int = 0
      var is_asy: int = pend[0]
      pend[0] = 0
      if k == 32:
        is_ext = 1
        pi[0] = pi[0] + 1
        if cur_kind(tk, n, pi, err) == 10:
          pi[0] = pi[0] + 1
      if k == 33:
        is_asy = 1
        pi[0] = pi[0] + 1
        if cur_kind(tk, n, pi, err) == 10:
          pi[0] = pi[0] + 1
      if k == 10:
        pi[0] = pi[0] + 1
      if cur_kind(tk, n, pi, err) != 4:
        err[0] = 1
        return 1
      pi[0] = pi[0] + 1
      fx_skip_typeparams(tk, n, pi, err)
      expect_k(tk, n, pi, err, 49)
      decl[0] = 0
      heap[0] = 0
      fx_skip_params(src, tk, ts, te, n, pi, err, heap, 0 - 1)
      fx_record_raises(src, tk, ts, te, n, pi, err, decl)
      if accept_k(tk, n, pi, err, 57) == 1:
        if cur_kind(tk, n, pi, err) == 4:
          if fx_is_heap(src, ts, te, pi[0]) == 1:
            heap[0] = 1
        parse_type(src, tk, ts, te, n, pi, err, 0)
      fx_record_raises(src, tk, ts, te, n, pi, err, decl)
      while 1 == 1:
        var ck: int = cur_kind(tk, n, pi, err)
        if ck == 41 or ck == 42 or ck == 43 or ck == 44 or ck == 45:
          parse_contract(src, tk, ts, te, n, pi, err, 0)
          continue
        break
      if is_ext == 0:
        used[0] = 0
        await_seen[0] = 0
        skip_newlines(tk, n, pi, err)
        if accept_k(tk, n, pi, err, 58) == 1:
          skip_newlines(tk, n, pi, err)
          fx_scan_block(src, tk, ts, te, n, pi, err, isrc, isn, ise, iext, ieff, icnt, pn, peff, pext, pcnt, 0, used, await_seen)
        if heap[0] == 1:
          if fx_has_eff(decl[0], 2) == 0:
            err[0] = 1
            li_rt_emit_err(900)
        # The host's effects lane is exactly three rules (effects_check_module,
        # borrowck.cpp): echo/print -> raises IO, ANY extern call -> raises IO,
        # heap mention -> raises Alloc. The raise-Kind compat checks for Net /
        # Async / await are walker-only phantoms (the C++ propagates callee
        # raises onto no rule of its own) — dropped to mirror the verdicts.
        if fx_has_eff(used[0], 1) == 1:
          if fx_has_eff(decl[0], 1) == 0:
            err[0] = 1
            li_rt_emit_err(900)
      skip_newlines(tk, n, pi, err)
      continue
    err[0] = 1
    return 1
  return 0

# ---- Layer 4b: mir-mode effects port (extern-call class only) ----
# Mirrors compiler/types/borrowck.cpp proc_mentions_extern_call exactly: only
# the TOP-LEVEL body statements of a non-extern main-module proc count, and
# only when the statement's root expression (compiled to C++ Stmt::expr) is a
# direct call (parser.cpp: Expr stmt, Return expr, Assign RHS). Var-decl and
# borrow inits land in Stmt::init in C++ and never count; conditions, nested
# call arguments and nested blocks do not count. `echo` is excluded by name
# (C++ special case). Flag positions match parse_stmt's own dispatch so a
# proc calling a declared extern without `raises IO` rejects in mir mode.

# Name lookup against (source pointer, char span) pairs captured at
# collection time. Token indices are only valid while the module they were
# lexed from is the live tk/ts/te stream, and the import-space merge
# re-lexes later modules over the shared arrays; fx-style token-index
# tables would resolve imported names against the wrong spans. The entry
# carries its own source pointer, so the comparison reads each name from
# its own text while the call-side name token resolves against the LIVE
# ts/te. Returns 1 for a declared extern, 0 for a user-defined non-extern
# proc, and -1 when absent (same shape as fx_proc_ext, which remains the
# check-mode lookup).

# Byte-level span comparison across two different source buffers: both
# spans use the same source inside mir_slice_eq, so names collected from
# imported modules (whose spans live in their own content pointers) need
# each side read from its own buffer.
def fx_span_eq(sr1: ptr, s1: int, e1: int, sr2: ptr, s2: int, e2: int) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  if e1 - s1 != e2 - s2:
    return 0
  var i1: int = s1
  var i2: int = s2
  while i1 < e1:
    if li_rt_str_char_at(sr1, i1) != li_rt_str_char_at(sr2, i2):
      return 0
    i1 = i1 + 1
    i2 = i2 + 1
  return 1

def fx_mir_ext_of(src: ptr, ts: var array[262144, int], te: var array[262144, int], psrc: var array[256, ptr], pns: var array[256, int], pne: var array[256, int], pext: var array[256, int], pcnt: var array[1, int], name_tok: int) -> int
  requires true
  ensures result >= 0 - 1
  decreases 0
=
  var ns2: int = peek_tk(ts, name_tok + 0)
  var ne2: int = peek_tk(te, name_tok + 0)
  var k: int = 0
  while k < pcnt[0]:
    if fx_span_eq(psrc[k], pns[k], pne[k], src, ns2, ne2) == 1:
      return pext[k]
    k = k + 1
  return 0 - 1

def fx_mir_root_call_eff(src: var ptr,  tk: var array[262144, int],  ts: var array[262144, int], te: var array[262144, int],  n: var array[1, int],  pi: var array[1, int], err: var array[1, int],  psrc: var array[256, ptr], pns: var array[256, int], pne: var array[256, int], pext: var array[256, int], pcnt: var array[1, int], used: var array[1, int]) -> int
  requires true
  ensures result == 0
  decreases 0
=
  if cur_kind(tk,  n,  pi,  err) == 4:
    if peek_off(tk,  n,  pi, 1) == 49:
      if tok_is(src,  ts,  te,  pi[0],  "echo") == 0:
        if fx_mir_ext_of(src, ts, te, psrc, pns, pne, pext, pcnt, pi[0]) == 1:
          fx_add_eff(used, 1)
  return 0

def fx_mir_top_stmt(src: var ptr,  tk: var array[262144, int],  ts: var array[262144, int], te: var array[262144, int],  n: var array[1, int],  pi: var array[1, int], err: var array[1, int],  psrc: var array[256, ptr], pns: var array[256, int], pne: var array[256, int], pext: var array[256, int],  pcnt: var array[1, int], used: var array[1, int]) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  skip_newlines(tk,  n,  pi,  err)
  var k: int = cur_kind(tk,  n,  pi,  err)
  if k == 3 or k == 0:
    return 0
  if k == 76:
    parse_decorator_list(src,  tk,  ts,  te,  n,  pi,  err, 0)
    skip_newlines(tk,  n,  pi,  err)
    fx_mir_top_stmt(src,  tk,  ts,  te,  n,  pi,  err,  psrc,  pns,  pne,  pext,  pcnt,  used)
    return 1
  if k == 30:
    # Return: s.expr is the parsed return expr (bare return leaves it null).
    pi[0] = pi[0] + 1
    var rk: int = cur_kind(tk,  n,  pi,  err)
    if rk != 1:
      if rk != 3:
        if rk != 0:
          fx_mir_root_call_eff(src,  tk,  ts,  te,  n,  pi,  err,  psrc,  pns,  pne,  pext,  pcnt,  used)
          parse_expr(src,  tk,  ts,  te,  n,  pi,  err, 0, 0)
    skip_newlines(tk,  n,  pi,  err)
    return 1
  if k == 20:
    # var x: T = init — C++ puts the init in Stmt::init, never in
    # Stmt::expr, so var-decl inits never trigger the extern rule.
    pi[0] = pi[0] + 1
    if cur_kind(tk,  n,  pi,  err) == 4:
      pi[0] = pi[0] + 1
    if accept_k(tk,  n,  pi,  err, 56) == 1:
      # Same heap-mention watch for the fx pass2 body walk's var decls.
      if li_rt_preg_get(17, 4) == 1:
        if fx_is_heap(src,  ts,  te,  pi[0]) == 1:
          li_rt_preg_set(17, 3, 1)
      parse_type(src,  tk,  ts,  te,  n,  pi,  err, 0)
    if accept_k(tk,  n,  pi,  err, 58) == 1:
      parse_expr(src,  tk,  ts,  te,  n,  pi,  err, 0, 0)
    skip_newlines(tk,  n,  pi,  err)
    return 1
  if k == 4:
    if tok_is(src,  ts,  te,  pi[0],  "discard") == 1:
      pi[0] = pi[0] + 1
      var dk: int = cur_kind(tk,  n,  pi,  err)
      if dk != 1:
        if dk != 3:
          if dk != 0:
            # discard + value is Stmt::Kind::Expr in C++ (s.expr set).
            fx_mir_root_call_eff(src,  tk,  ts,  te,  n,  pi,  err,  psrc,  pns,  pne,  pext,  pcnt,  used)
            parse_expr(src,  tk,  ts,  te,  n,  pi,  err, 0, 0)
      skip_newlines(tk,  n,  pi,  err)
      return 1
    if tok_is(src,  ts,  te,  pi[0],  "borrow") == 1:
      parse_stmt(src,  tk,  ts,  te,  n,  pi,  err, 0)
      skip_newlines(tk,  n,  pi,  err)
      return 1
    if tok_is(src,  ts,  te,  pi[0],  "parallel") == 1:
      # parallel for: the C++ stmt is ParallelFor with no Stmt::expr; its
      # body statements nest and never count.
      parse_stmt(src,  tk,  ts,  te,  n,  pi,  err, 0)
      skip_newlines(tk,  n,  pi,  err)
      return 1
    var save: int = pi[0]
    if peek_off(tk,  n,  pi, 1) == 49:
      # Bare callee-root call: Expr-stmt root call (or invalid grammar; the
      # quiet parse still consumes it, and C++ would flag it identically).
      fx_mir_root_call_eff(src,  tk,  ts,  te,  n,  pi,  err,  psrc,  pns,  pne,  pext,  pcnt,  used)
      parse_stmt(src,  tk,  ts,  te,  n,  pi,  err, 0)
      skip_newlines(tk,  n,  pi,  err)
      return 1
    # Mirror parser.cpp: parse_primary + parse_postfix, then Assign iff Eq;
    # the Assign's RHS is Stmt::expr; otherwise restore and treat as a
    # plain Expr stmt (never a flag position).
    parse_primary(src,  tk,  ts,  te,  n,  pi,  err, 0)
    parse_postfix(src,  tk,  ts,  te,  n,  pi,  err, 0)
    if accept_k(tk,  n,  pi,  err, 58) == 1:
      fx_mir_root_call_eff(src,  tk,  ts,  te,  n,  pi,  err,  psrc,  pns,  pne,  pext,  pcnt,  used)
      parse_expr(src,  tk,  ts,  te,  n,  pi,  err, 0, 0)
      skip_newlines(tk,  n,  pi,  err)
      return 1
    pi[0] = save
    parse_stmt(src,  tk,  ts,  te,  n,  pi,  err, 0)
    skip_newlines(tk,  n,  pi,  err)
    return 1
  parse_stmt(src,  tk,  ts,  te,  n,  pi,  err, 0)
  skip_newlines(tk,  n,  pi,  err)
  return 1

def fx_mir_pass1(src: var ptr,  tk: var array[262144, int],  ts: var array[262144, int], te: var array[262144, int],  n: var array[1, int],  pi: var array[1, int], err: var array[1, int],  psrc: var array[256, ptr], pns: var array[256, int], pne: var array[256, int], peff: var array[256, int], pext: var array[256, int], pvis: var array[256, int], pcnt: var array[1, int], vc_on: int) -> int
  requires true
  ensures result == 0
  decreases 0
=
  # Collect proc names, extern flags and declared effects for the token
  # stream currently in tk (must already be lexed). Names are stored as
  # (source pointer, char span) captured from THIS module's own token
  # spans: token indices alone are only valid while this module is the live
  # tk/ts/te stream, and the import-space merge re-lexes later modules over
  # the shared arrays — the (src, span) triple stays valid for later
  # lookups (fx_mir_ext_of). The caller owns and zero-initializes the
  # tables; repeated calls append, so the import-space merge reuses one
  # shared table across modules. Bodies are skipped quietly; a broken
  # stream bails with 0 (the caller's normal pipeline then decides) — never
  # a rejection of its own.
  var pend: array[1, int]
  var decl: array[1, int]
  var heap: array[1, int]
  var pvf: array[1, int]
  pend[0] = 0
  pvf[0] = 0
  pi[0] = 0
  skip_newlines(tk,  n,  pi,  err)
  while cur_kind(tk,  n,  pi,  err) != 0:
    var k1: int = cur_kind(tk,  n,  pi,  err)
    if k1 == 11:
      fx_skip_typealias(src,  tk,  ts,  te,  n,  pi,  err)
      continue
    if k1 == 76:
      fx_skip_decorators(src,  tk,  ts,  te,  n,  pi,  err,  pend)
      continue
    if k1 == 18:
      parse_import(src,  tk,  ts,  te,  n,  pi,  err, 0)
      skip_newlines(tk,  n,  pi,  err)
      continue
    if k1 == 13 or k1 == 12 or k1 == 14:
      parse_theorem(src,  tk,  ts,  te,  n,  pi,  err, 0, 0, 0)
      skip_newlines(tk,  n,  pi,  err)
      continue
    if k1 == 16 or k1 == 17:
      pi[0] = pi[0] + 1
      pvf[0] = 0
      if k1 == 16:
        if cur_kind(tk, n, pi, err) == 10:
          pvf[0] = 1
      skip_newlines(tk,  n,  pi,  err)
      continue
    if k1 == 32 or k1 == 10 or k1 == 33:
      var vis1: int = pvf[0]
      pvf[0] = 0
      var is_ext1: int = 0
      var is_asy1: int = pend[0]
      pend[0] = 0
      if k1 == 32:
        is_ext1 = 1
        pi[0] = pi[0] + 1
        if cur_kind(tk,  n,  pi,  err) == 10:
          pi[0] = pi[0] + 1
      if k1 == 33:
        is_asy1 = 1
        pi[0] = pi[0] + 1
        if cur_kind(tk,  n,  pi,  err) == 10:
          pi[0] = pi[0] + 1
      if k1 == 10:
        pi[0] = pi[0] + 1
      if cur_kind(tk,  n,  pi,  err) != 4:
        return 0
      var nm1: int = pi[0]
      var ns1: int = peek_tk(ts, nm1 + 0)
      var ne1: int = peek_tk(te, nm1 + 0)
      pi[0] = pi[0] + 1
      var idx1: int = pcnt[0]
      var has_ret1: int = 0
      var req1: int = 0
      var ens1: int = 0
      # E0303 literal-return captures (postcondition_is_false_for_literal_
      # return): every `result op <int-literal>` / `<int-literal> op result`
      # arm of THIS def's ensures clauses, evaluated after the body scan
      # because direct_return_expr needs the single-return census
      # (count_returns == 1). Int literals only (kind 5 / folded `-5`) —
      # kind-7 float arms stay uncaptured, the conservative under-reject
      # direction, recorded in the catalog entry.
      var en_op: array[8, int]
      var en_lit: array[8, int]
      var en_left: array[8, int]
      var en_n: array[1, int]
      en_n[0] = 0
      if idx1 < 256:
        psrc[idx1] = src
        pns[idx1] = ns1
        pne[idx1] = ne1
        pext[idx1] = is_ext1
        # pvis domain = call-visible (1 = callable, 0 = imported-private)
        pvis[idx1] = 1
        if vis1 == 1:
          pvis[idx1] = 0
        peff[idx1] = 0
        pcnt[0] = pcnt[0] + 1      fx_skip_typeparams(tk,  n,  pi,  err)
      expect_k(tk,  n,  pi,  err, 49)
      decl[0] = 0
      heap[0] = 0
      fx_skip_params(src,  tk,  ts,  te,  n,  pi,  err,  heap, idx1)
      fx_record_raises(src,  tk,  ts,  te,  n,  pi,  err,  decl)
      if accept_k(tk,  n,  pi,  err, 57) == 1:
        # E0303 dimension: value-returning proc (a `-> T` with T != unit
        # selects this branch; the C++ typecheck's is_unit_type gate is the
        # inline unit check below). Mirrors compiler/types/typecheck.cpp
        # check_proc's weak-ensures rule for non-extern procs.
        has_ret1 = 1
        if cur_kind(tk,  n,  pi,  err) == 4:
          if tok_is(src,  ts,  te,  pi[0],  "unit") == 1:
            has_ret1 = 0
          if fx_is_heap(src,  ts,  te,  pi[0]) == 1:
            heap[0] = 1
        parse_type(src,  tk,  ts,  te,  n,  pi,  err, 0)
      fx_record_raises(src,  tk,  ts,  te,  n,  pi,  err,  decl)
      if idx1 < 256:
        peff[idx1] = decl[0]
      while 1 == 1:
        var ck1: int = cur_kind(tk,  n,  pi,  err)
        if ck1 == 41 or ck1 == 42 or ck1 == 43 or ck1 == 44 or ck1 == 45:
          if tok_is(src,  ts,  te,  pi[0],  "requires") == 1:
            req1 = 1
          if tok_is(src,  ts,  te,  pi[0],  "ensures") == 1:
            ens1 = 1
            # E0303 literal-return arm capture (peek-based, no consumption):
            # mirrors rq_capture_clause's token shape but keyed on the
            # `result` ident (kw 46) taking the operand slot. The walker's
            # returned-literal side arrives via the parse_stmt return hook
            # (preg 17.1 count / 17.2 literal), so only the clause arm is
            # captured here.
            var en_p: int = rq_skip_nl_at(tk, n, pi[0] + 1)
            var en_q: int = rq_skip_nl_at(tk, n, en_p + 1)
            var en_opk: int = peek_tk(tk, en_q + 0)
            if en_opk == 66 or en_opk == 67 or en_opk == 68 or en_opk == 69 or en_opk == 70 or en_opk == 71:
              var en_v: int = rq_skip_nl_at(tk, n, en_q + 1)
              var en_litp: int = en_v
              if peek_tk(tk, en_litp + 0) == 60:
                en_litp = en_litp + 1
              var en_term: int = peek_tk(tk, en_litp + 1)
              if en_term == 1 or en_term == 0 or en_term == 3 or en_term == 44 or en_term == 45:
                if tok_is(src, ts, te, en_p, "result") == 1:
                  if peek_tk(tk, en_litp + 0) == 5:
                    if en_n[0] < 8:
                      en_left[en_n[0]] = 1
                      en_op[en_n[0]] = en_opk
                      en_lit[en_n[0]] = rq_lit_val(src, tk, ts, te, en_v + 0)
                      en_n[0] = en_n[0] + 1
                else:
                  # Mirror rq_capture_clause's lit-left branch exactly:
                  # `lit op result` with an optional leading-minus fold; the
                  # op is read AFTER the literal, and the `result` operand
                  # sits right after the op.
                  if peek_tk(tk, en_p + 0) == 5 or peek_tk(tk, en_p + 0) == 60:
                    var en_lit2: int = en_p
                    var en_litneg: int = en_p
                    if peek_tk(tk, en_lit2 + 0) == 60:
                      en_lit2 = en_lit2 + 1
                    if peek_tk(tk, en_lit2 + 0) == 5:
                      var en_q2: int = rq_skip_nl_at(tk, n, en_lit2 + 1)
                      var en_op2: int = peek_tk(tk, en_q2 + 0)
                      if en_op2 == 66 or en_op2 == 67 or en_op2 == 68 or en_op2 == 69 or en_op2 == 70 or en_op2 == 71:
                        var en_p2: int = rq_skip_nl_at(tk, n, en_q2 + 1)
                        if tok_is(src, ts, te, en_p2, "result") == 1:
                          var en_term2: int = peek_tk(tk, en_p2 + 1)
                          if en_term2 == 1 or en_term2 == 0 or en_term2 == 3 or en_term2 == 44 or en_term2 == 45:
                            if en_n[0] < 8:
                              en_left[en_n[0]] = 0
                              en_op[en_n[0]] = en_op2
                              en_lit[en_n[0]] = rq_lit_val(src, tk, ts, te, en_litneg + 0)
                              en_n[0] = en_n[0] + 1
          # E0303: bare `ensures true` / `ensures false` on a value-returning non-extern proc
          # is a single-token predicate terminated by end of clause. Compound
          # predicates (`true and x`, `(true)`) never match the token shape,
          # mirroring is_true_literal(c.expr) / is_false_literal(c.expr).
          # The rule applies to the MAIN module's procs only (C++ typecheck
          # runs check_proc on the file being checked, not on merged imported
          # procs), so vc_on is 1 for main-module seed calls and 0 for
          # dep-module passes.
          if is_ext1 == 0:
            if vc_on == 1:
              if has_ret1 == 1:
                if tok_is(src,  ts,  te,  pi[0],  "ensures") == 1:
                  if tok_is(src,  ts,  te,  pi[0] + 1,  "true") == 1 or tok_is(src,  ts,  te,  pi[0] + 1,  "false") == 1:
                    var termk1: int = peek_off(tk,  n,  pi, 2)
                    if termk1 == 1 or termk1 == 0 or termk1 == 3:
                      err[0] = 1
                      li_rt_emit_err(303)
                      return 1
          # Contract parse shapes mirror the C++ parse_contract chain
          # (parse_contract_expr -> parse_expr -> parse_primary): a primary
          # that ends on a non-expression token (e.g. `ensures result ==`
          # with no RHS) is exactly C++ parse_primary's "expected expression"
          # reject. The fx lane treats err[0] as benign scratch, so the
          # verdict rides preg 22 and err[0] is restored after the call.
          var perr1: int = err[0]
          err[0] = 0
          parse_contract(src,  tk,  ts,  te,  n,  pi,  err, 0)
          if err[0] == 1:
            li_rt_preg_set(22, 0, 1)
            err[0] = perr1
          continue
        break
      # E0201/E0202 shapes: every non-extern proc in the checked file carries
      # both clauses (C++ check_proc, ungated by allow_open_vc — verified
      # against minimal missing-clause probes; see the catalog entry).
      if vc_on == 1:
        if is_ext1 == 0:
          if req1 == 0:
            err[0] = 1
            li_rt_emit_err(301)
            return 1
          if ens1 == 0:
            err[0] = 1
            li_rt_emit_err(302)
            return 1
      if is_ext1 == 0:
        # Missing-body shape (C++ parser.cpp parse_proc: expect(Eq, "'='")
        # after the contract list, extern exempt): a def whose contract run
        # is followed by anything other than the `=` body marker is the
        # "expected '='" reject. Also latches err[0] from the body parse
        # chain (parse_block -> parse_stmt recursion) — same parity as the
        # contract wrap, verdict on preg 22, err channel restored.
        var perr1b: int = err[0]
        err[0] = 0
        skip_newlines(tk,  n,  pi,  err)
        var has_eq1: int = accept_k(tk,  n,  pi,  err, 58)
        if has_eq1 == 1:
          skip_newlines(tk,  n,  pi,  err)
          if cur_kind(tk,  n,  pi,  err) == 2:
            # Return-counting + single-return-literal capture modes ON for
            # this body (parse_stmt's return branch increments preg 17.1 and
            # writes the folded literal to preg 17.2); the heap-mention watch
            # (preg 17.4/17.3) mirrors proc_mentions_heap's VarDecl scan.
            li_rt_preg_set(17, 0, 1)
            li_rt_preg_set(17, 1, 0)
            li_rt_preg_set(17, 2, -700000)
            li_rt_preg_set(17, 3, 0)
            li_rt_preg_set(17, 4, 1)
            parse_block(src,  tk,  ts,  te,  n,  pi,  err, 0)
            li_rt_preg_set(17, 0, 0)
            li_rt_preg_set(17, 4, 0)
            # C++ typecheck's E0303 literal-return rule, evaluated here like
            # check_proc after the body parse: main-module non-extern
            # value-returning procs, exactly one return anywhere in the body
            # (int literal, negative fold respected), every captured
            # `result <op> <lit>` arm compared with rq_op_violated — a
            # violated arm is E0303 (same channel the weak-ensures arm
            # fires). Kind-7 float arms stay uncaptured (under-reject).
        if err[0] == 1:
          li_rt_preg_set(22, 0, 1)
          err[0] = perr1b
        if is_ext1 == 0:
          if vc_on == 1:
            if has_ret1 == 1:
              if li_rt_preg_get(17, 1) == 1:
                var rlv: int = li_rt_preg_get(17, 2)
                if rlv != -700000:
                  var ea: int = 0
                  while ea < en_n[0]:
                    var ebad: int = 0
                    if en_left[ea] == 1:
                      ebad = rq_op_violated(en_op[ea], rlv, en_lit[ea])
                    else:
                      ebad = rq_op_violated(en_op[ea], en_lit[ea], rlv)
                    if ebad == 1:
                      err[0] = 1
                      li_rt_emit_err(303)
                      return 1
                    ea = ea + 1
        # accept_k returns 0 WITHOUT raising err[0], and a def ending the
        # stream (or DEDENT) before the `=` body marker is a parse silence —
        # C++'s expect(Eq) fires, so latch the single captured verdict here.
        if has_eq1 == 0:
          li_rt_preg_set(22, 0, 1)
      skip_newlines(tk,  n,  pi,  err)
      continue
    return 0
  return 0

def fx_import_merge(file_path: ptr, src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], tsrc: var array[256, ptr], tns: var array[256, int], tne: var array[256, int], teff: var array[256, int], text: var array[256, int], tvis: var array[256, int], tcnt: var array[1, int]) raises IO -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  # Transitive import table (DFS pre-order, mirroring mir_module's own
  # resolution so path canonicalization and order agree): Local work stack,
  # no li_rt_import_* registry writes — mir_module builds its own copies
  # independently afterwards. Factored out of fx_mir_effects so the check
  # lane (effects_check) merges imported proc names into its own tables
  # through the exact same resolve/seed path.
  var wcft: array[64, ptr]
  var wpft: array[64, ptr]
  var wc_n: array[1, int]
  wc_n[0] = 0
  var q_c: array[64, ptr]
  var q_p: array[64, ptr]
  var q_n: array[1, int]
  q_n[0] = 0
  var seen_p: array[64, ptr]
  var seen_n: array[1, int]
  seen_n[0] = 0
  # VC flag: E0303 found inside an imported module (fx_mir_pass1 returns 1 on
  # the weak-ensures rule). Reported as code 2 after the final main-module
  # re-lex so callers can reject without losing the restored token stream.
  var vcf: int = 0
  li_rt_preg_set(20, 0, 0)
  pi[0] = 0
  err[0] = 0
  skip_newlines(tk,  n,  pi,  err)
  while cur_kind(tk,  n,  pi,  err) != 0:
    var ki2f: int = cur_kind(tk,  n,  pi,  err)
    if ki2f == 18:
      pi[0] = pi[0] + 1
      if cur_kind(tk,  n,  pi,  err) != 4:
        continue
      var imsf: int = peek_tk(ts, pi[0] + 0)
      var imef: int = peek_tk(te, pi[0] + 0)
      pi[0] = pi[0] + 1
      while accept_k(tk,  n,  pi,  err, 72) == 1:
        if cur_kind(tk,  n,  pi,  err) == 4:
          imef = peek_tk(te, pi[0] + 0)
          pi[0] = pi[0] + 1
      if cur_kind(tk,  n,  pi,  err) == 4:
        if tok_is(src, ts, te, pi[0], "as") == 1:
          pi[0] = pi[0] + 1
          if cur_kind(tk,  n,  pi,  err) == 4:
            pi[0] = pi[0] + 1
      var mnf: ptr = bytes_slice_i(src,  imsf,  imef - imsf)
      var ffx: ptr = li_rt_resolve_import(file_path,  mnf)
      if ffx != 0:
        if q_n[0] < 64:
          wp64_set(q_c, q_n[0], ffx)
          wp64_set(q_p, q_n[0], li_rt_import_path_dup(li_rt_resolve_import_last_path()))
          q_n[0] = q_n[0] + 1
      if ffx == 0:
        li_rt_preg_set(20, 0, 1)
      continue
    pi[0] = pi[0] + 1
  var qi0f: int = q_n[0]
  while qi0f > 0:
    qi0f = qi0f - 1
    if wc_n[0] < 64:
      wp64_set(wcft, wc_n[0], wp64_get(q_c, qi0f))
      wp64_set(wpft, wc_n[0], wp64_get(q_p, qi0f))
      wc_n[0] = wc_n[0] + 1
  while wc_n[0] > 0:
    wc_n[0] = wc_n[0] - 1
    var pop_cf: ptr = wp64_get(wcft, wc_n[0])
    var pop_pf: ptr = wp64_get(wpft, wc_n[0])
    var dupf: int = 0
    var jj0f: int = 0
    while jj0f < seen_n[0]:
      var old_pf: ptr = wp64_get(seen_p, jj0f)
      if old_pf != 0:
        if li_rt_str_eq(old_pf, pop_pf) == 1:
          dupf = 1
      jj0f = jj0f + 1
    if dupf == 0:
      if seen_n[0] < 64:
        wp64_set(seen_p, seen_n[0], pop_pf)
        seen_n[0] = seen_n[0] + 1
      q_n[0] = 0
      n[0] = 0
      if lex_source(pop_cf, tk, ts, te, n, 0) == 0:
        pi[0] = 0
        err[0] = 0
        if fx_mir_pass1(pop_cf, tk, ts, te, n, pi, err, tsrc, tns, tne, teff, text, tvis, tcnt, 0) == 1:
          vcf = 1
        pi[0] = 0
        err[0] = 0
        skip_newlines(tk, n, pi, err)
        while cur_kind(tk, n, pi, err) != 0:
          var ki3f: int = cur_kind(tk, n, pi, err)
          if ki3f == 18:
            pi[0] = pi[0] + 1
            if cur_kind(tk, n, pi, err) != 4:
              continue
            var ims2f: int = peek_tk(ts, pi[0] + 0)
            var ime2f: int = peek_tk(te, pi[0] + 0)
            pi[0] = pi[0] + 1
            while accept_k(tk, n, pi, err, 72) == 1:
              if cur_kind(tk, n, pi, err) == 4:
                ime2f = peek_tk(te, pi[0] + 0)
                pi[0] = pi[0] + 1
            if cur_kind(tk, n, pi, err) == 4:
              if tok_is(pop_cf, ts, te, pi[0], "as") == 1:
                pi[0] = pi[0] + 1
                if cur_kind(tk, n, pi, err) == 4:
                  pi[0] = pi[0] + 1
            var mn3f: ptr = bytes_slice_i(pop_cf, ims2f, ime2f - ims2f)
            var f3f: ptr = li_rt_resolve_import(pop_pf, mn3f)
            if f3f != 0:
              if q_n[0] < 64:
                wp64_set(q_c, q_n[0], f3f)
                wp64_set(q_p, q_n[0], li_rt_import_path_dup(li_rt_resolve_import_last_path()))
                q_n[0] = q_n[0] + 1
          pi[0] = pi[0] + 1
      var qif: int = q_n[0]
      while qif > 0:
        qif = qif - 1
        if wc_n[0] < 64:
          wp64_set(wcft, wc_n[0], wp64_get(q_c, qif))
          wp64_set(wpft, wc_n[0], wp64_get(q_p, qif))
          wc_n[0] = wc_n[0] + 1
  # Restore the main module's token stream (the import scans lexed the
  # shared buffers); the caller walks the main module afterwards.
  n[0] = 0
  if lex_source(src, tk, ts, te, n, 0) == 1:
    return 1
  if vcf == 1:
    return 2
  return 0

def fx_seal_check(src: var ptr, file_path: ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int]) raises IO -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  # Seal + duplicate top-level names for the mir lane, mirroring check_source
  # 's collection branches (compiler/types/prelude.cpp check_stdlib_seal /
  # check_duplicate_definitions): the prelude-type half applies at ns 0 (type
  # alias), prelude-proc + std-symbol halves at ns 1 (def / extern def /
  # async def), std-export half skipped for files under std/, theorem entry
  # points outside the seal. Walk shape clones fx_mir_pass1's consumption so
  # the token flow matches; returns 1 when any seal/dup fired, 0 otherwise.
  var seal_tn: array[256, int]
  var seal_tc: array[1, int]
  var seal_pn: array[256, int]
  var seal_pc: array[1, int]
  var seal_std: int = 0
  var fired: int = 0
  var pendx: array[1, int]
  var declx: array[1, int]
  var heapx: array[1, int]
  seal_tc[0] = 0
  seal_pc[0] = 0
  pendx[0] = 0
  declx[0] = 0
  heapx[0] = 0
  if li_rt_str_prefix(file_path, "std/") == 1:
    seal_std = 1
  if li_rt_str_contains(file_path, "/std/") == 1:
    seal_std = 1
  if li_rt_str_contains(file_path, "\std\") == 1:
    seal_std = 1
  pi[0] = 0
  skip_newlines(tk, n, pi, err)
  while cur_kind(tk, n, pi, err) != 0:
    # err[0] is per-iteration scratch here: the only writers allowed to latch
    # `fired` are this iteration's seal calls; skipper bugs (or a late-er
    # misaligned consume) must not look like a seal violation.
    err[0] = 0
    var ks: int = cur_kind(tk, n, pi, err)
    if ks == 11:
      # Peek the alias name (pi+1) WITHOUT advancing: fx_skip_typealias expects
      # to start at the `type` keyword itself (pass1's consumption contract).
      # Advancing before it made `type X = object` bodies mis-consume and set
      # err[0] from the skipper, which the fired latch then misread as a seal
      # violation (object_field_smoke false reject).
      if peek_off(tk, n, pi, 1) != 4:
        return 0
      seal_def_check(src, ts, te, pi[0] + 1, 0, seal_std, seal_tn, seal_tc, seal_pn, seal_pc, err)
      if err[0] == 1:
        fired = 1
      fx_skip_typealias(src, tk, ts, te, n, pi, err)
      continue
    if ks == 76:
      fx_skip_decorators(src, tk, ts, te, n, pi, err, pendx)
      skip_newlines(tk, n, pi, err)
      continue
    if ks == 18:
      parse_import(src, tk, ts, te, n, pi, err, 0)
      skip_newlines(tk, n, pi, err)
      continue
    if ks == 13 or ks == 12 or ks == 14:
      parse_theorem(src, tk, ts, te, n, pi, err, 0, 0, 0)
      skip_newlines(tk, n, pi, err)
      continue
    if ks == 16 or ks == 17:
      pi[0] = pi[0] + 1
      continue
    if ks == 32 or ks == 10 or ks == 33:
      if ks == 32:
        pi[0] = pi[0] + 1
        if cur_kind(tk, n, pi, err) == 10:
          pi[0] = pi[0] + 1
          if cur_kind(tk, n, pi, err) != 4:
            return 0
          seal_def_check(src, ts, te, pi[0], 1, seal_std, seal_tn, seal_tc, seal_pn, seal_pc, err)
          if err[0] == 1:
            fired = 1
      if ks == 33:
        pi[0] = pi[0] + 1
        if cur_kind(tk, n, pi, err) == 10:
          pi[0] = pi[0] + 1
          if cur_kind(tk, n, pi, err) != 4:
            return 0
          seal_def_check(src, ts, te, pi[0], 1, seal_std, seal_tn, seal_tc, seal_pn, seal_pc, err)
          if err[0] == 1:
            fired = 1
      if ks == 10:
        pi[0] = pi[0] + 1
        if cur_kind(tk, n, pi, err) != 4:
          return 0
        seal_def_check(src, ts, te, pi[0], 1, seal_std, seal_tn, seal_tc, seal_pn, seal_pc, err)
        if err[0] == 1:
          fired = 1
      if cur_kind(tk, n, pi, err) != 4:
        return 0
      pi[0] = pi[0] + 1
      fx_skip_typeparams(tk, n, pi, err)
      expect_k(tk, n, pi, err, 49)
      declx[0] = 0
      heapx[0] = 0
      fx_skip_params(src, tk, ts, te, n, pi, err, heapx, 0 - 1)
      fx_record_raises(src, tk, ts, te, n, pi, err, declx)
      if accept_k(tk, n, pi, err, 57) == 1:
        parse_type(src, tk, ts, te, n, pi, err, 0)
      fx_record_raises(src, tk, ts, te, n, pi, err, declx)
      while 1 == 1:
        var ckk: int = cur_kind(tk, n, pi, err)
        if ckk == 41 or ckk == 42 or ckk == 43 or ckk == 44 or ckk == 45:
          parse_contract(src, tk, ts, te, n, pi, err, 0)
          continue
        break
      skip_newlines(tk, n, pi, err)
      if accept_k(tk, n, pi, err, 58) == 1:
        skip_newlines(tk, n, pi, err)
        if cur_kind(tk, n, pi, err) == 2:
          parse_block(src, tk, ts, te, n, pi, err, 0)
      skip_newlines(tk, n, pi, err)
      continue
    return 0
  if fired == 1:
    return 1
  return 0

def fx_mir_effects(src: var ptr,  file_path: ptr, tk: var array[262144, int],  ts: var array[262144, int], te: var array[262144, int],  n: var array[1, int],  pi: var array[1, int], err: var array[1, int]) raises IO -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  var peff: array[256, int]
  var pext: array[256, int]
  var pvis: array[256, int]
  var psrc: array[256, ptr]
  var pns: array[256, int]
  var pne: array[256, int]
  var pcnt: array[1, int]
  var pend: array[1, int]
  var decl: array[1, int]
  var heap: array[1, int]
  var used: array[1, int]
  var ioused: array[1, int]
  var found: array[1, int]
  var await_seen: array[1, int]
  pcnt[0] = 0
  found[0] = 0
  # Parse-shape verdict slot (missing if-colon, empty contract expr RHS,
  # missing def body =): cleared at every fx_mir_effects head so a verdict
  # can only come from THIS module's pass1 + import-merge consumption (
  # C++ load_module_recursive forwards nested parse diagnostics, so a
  # mirrored inner-module latch reads as a reject here too).
  li_rt_preg_set(22, 0, 0)
  # CWE-676 extern-shape policy rule (compiler/types/policy.cpp uses the
  # same blunt source-substring test). The needle is assembled at runtime
  # (contains2) because the C++ policy fires on the substring's presence —
  # a contiguous copy anywhere in a checked file, incl. the walker's own
  # source, would reject it.
  if li_rt_str_contains2(src, "extern def str", "cpy") == 1:
    found[0] = 1
  # Pass 1: collect proc names, extern flags and declared effects for the
  # MAIN module, then merge every transitively imported module's proc names
  # into the same table — the C++ host's resolve_imports/merge_module make
  # imported procs visible to call resolution and to the echo/print
  # builtin-exclusivity test (proc_map), so the walker table must too.
  # fx_mir_pass1 returns 1 (contract E0303 found) / 0 otherwise; the weak
  # ensures rule is a whole-module verdict, not a per-proc fx bit.
  if fx_mir_pass1(src, tk, ts, te, n, pi, err, psrc, pns, pne, peff, pext, pvis, pcnt, 1) == 1:
    found[0] = 1
  if li_rt_preg_get(22, 0) == 1:
    found[0] = 1
  # Own-file rows: every proc declared here is call-visible; imported rows
  # keep the merge-time visibility bit (C++ merge_module public-only).
  var ownb: int = pcnt[0]
  var owni: int = 0
  while owni < ownb:
    if owni >= 256:
      # tables cap at 256 rows (the pass1 capture no-ops past idx1 255);
      # overflow disables the unknown-callee gate via the same preg-20
      # failsafe that an unresolved import sets, so a capacity edge cannot
      # invent a reject for a module the C++ host resolves fine.
      li_rt_preg_set(20, 0, 1)
      break
    pvis[owni] = 1
    owni = owni + 1
  # Transitive import table: the DFS pre-order merge lives in fx_import_merge
  # (shared with the check lane's effects_check; same resolve/seed path) —
  # li_rt_import_* registries stay untouched; mir_module builds its own
  # copies independently afterwards. Merge return codes: 0 = ok, 1 = the
  # final main-module re-lex failed (caller must not continue pass 2),
  # 2 = E0303 fired inside an imported module (main stream is re-lexed;
  # the caller flips its verdict channel and keeps walking).
  var mr0: int = fx_import_merge(file_path, src, tk, ts, te, n, pi, err, psrc, pns, pne, peff, pext, pvis, pcnt)
  if mr0 == 1:
    return found[0]
  if mr0 == 2:
    found[0] = 1
  if pcnt[0] >= 256:
    li_rt_preg_set(20, 0, 1)
  pi[0] = 0
  err[0] = 0
  # Seal + duplicate top-level names (prelude/std reserved names, duplicate
  # def/extern/async names, duplicate type aliases): the C++ typecheck seals
  # only the checked file's own top-level definitions, so this runs once on
  # the restored main-module stream, like the contract-shape rules above.
  var sv: int = fx_seal_check(src, file_path, tk, ts, te, n, pi, err)
  if sv == 1:
    found[0] = 1
    pi[0] = 0
  # Literal-requires call-site rule (C++ E0304 parity, mir lane): the
  # capture-then-fire walk saturates the whole module's requires tables
  # before any body walk (the C++ host builds its callee map first), with
  # the borrow bookkeeping off — bo=0 — so only rq_check_call can latch a
  # verdict. First error wins: a fire aborts the remaining mir pipeline.
  pi[0] = 0
  err[0] = 0
  var rqv: int = mir_rq_check(src, tk, ts, te, n, pi, err, psrc, pns, pne, pvis, pcnt)
  if rqv == 1:
    found[0] = 1
    return 1
  err[0] = 0
  pi[0] = 0
  # Pass 2: re-walk the main module's procs; for each non-extern proc, flag
  # only top-level Stmt::expr-shaped root calls to declared externs and
  # require the IO raise bit — the proc_mentions_extern_call rule.
  pi[0] = 0
  pend[0] = 0
  skip_newlines(tk,  n,  pi,  err)
  while cur_kind(tk,  n,  pi,  err) != 0:
    var k2: int = cur_kind(tk,  n,  pi,  err)
    if k2 == 11:
      fx_skip_typealias(src,  tk,  ts,  te,  n,  pi,  err)
      continue
    if k2 == 76:
      fx_skip_decorators(src,  tk,  ts,  te,  n,  pi,  err,  pend)
      continue
    if k2 == 18:
      parse_import(src,  tk,  ts,  te,  n,  pi,  err, 0)
      skip_newlines(tk,  n,  pi,  err)
      continue
    if k2 == 13 or k2 == 12 or k2 == 14:
      parse_theorem(src,  tk,  ts,  te,  n,  pi,  err, 0, 0, 0)
      skip_newlines(tk,  n,  pi,  err)
      continue
    if k2 == 16 or k2 == 17:
      pi[0] = pi[0] + 1
      skip_newlines(tk,  n,  pi,  err)
      continue
    if k2 == 32 or k2 == 10 or k2 == 33:
      var is_ext2: int = 0
      var is_asy2: int = pend[0]
      pend[0] = 0
      if k2 == 32:
        is_ext2 = 1
        pi[0] = pi[0] + 1
        if cur_kind(tk,  n,  pi,  err) == 10:
          pi[0] = pi[0] + 1
      if k2 == 33:
        is_asy2 = 1
        pi[0] = pi[0] + 1
        if cur_kind(tk,  n,  pi,  err) == 10:
          pi[0] = pi[0] + 1
      if k2 == 10:
        pi[0] = pi[0] + 1
      if cur_kind(tk,  n,  pi,  err) != 4:
        return found[0]
      pi[0] = pi[0] + 1
      fx_skip_typeparams(tk,  n,  pi,  err)
      expect_k(tk,  n,  pi,  err, 49)
      decl[0] = 0
      heap[0] = 0
      fx_skip_params(src,  tk,  ts,  te,  n,  pi,  err,  heap, 0 - 1)
      fx_record_raises(src,  tk,  ts,  te,  n,  pi,  err,  decl)
      if accept_k(tk,  n,  pi,  err, 57) == 1:
        if cur_kind(tk,  n,  pi,  err) == 4:
          if fx_is_heap(src,  ts,  te,  pi[0]) == 1:
            heap[0] = 1
        parse_type(src,  tk,  ts,  te,  n,  pi,  err, 0)
      fx_record_raises(src,  tk,  ts,  te,  n,  pi,  err,  decl)
      var ck2: int = 0
      while 1 == 1:
        ck2 = cur_kind(tk,  n,  pi,  err)
        if ck2 == 41 or ck2 == 42 or ck2 == 43 or ck2 == 44 or ck2 == 45:
          parse_contract(src,  tk,  ts,  te,  n,  pi,  err, 0)
          continue
        break
      if is_ext2 == 0:
        used[0] = 0
        ioused[0] = 0
        # Per-proc verdict scratch: a bodyless def must not inherit the
        # previous proc's heap mention.
        li_rt_preg_set(17, 3, 0)
        li_rt_preg_set(17, 4, 0)
        skip_newlines(tk,  n,  pi,  err)
        if accept_k(tk,  n,  pi,  err, 58) == 1:
          skip_newlines(tk,  n,  pi,  err)
          if cur_kind(tk,  n,  pi,  err) == 2:
            var body_start2: int = pi[0]
            li_rt_preg_set(17, 3, 0)
            li_rt_preg_set(17, 4, 1)
            pi[0] = pi[0] + 1
            while cur_kind(tk,  n,  pi,  err) != 3:
              skip_newlines(tk,  n,  pi,  err)
              if cur_kind(tk,  n,  pi,  err) == 3:
                break
              if cur_kind(tk,  n,  pi,  err) == 0:
                break
              var before2: int = pi[0]
              fx_mir_top_stmt(src,  tk,  ts,  te,  n,  pi,  err,  psrc,  pns,  pne,  pext,  pcnt,  used)
              if pi[0] == before2:
                # No progress: abandon the scan and let the walker's normal
                # pipeline decide (a pure scan failure must not reject).
                return found[0]
            if cur_kind(tk,  n,  pi,  err) == 3:
              pi[0] = pi[0] + 1
            # Recursive print/echo IO scan (C++ stmt_mentions_io /
            # expr_mentions_io): a literal builtin `echo`/`print` counts from
            # every expression position (stmt exprs, conditions, inits, call
            # args) and from all nested blocks. Re-walk the same block.
            var iostart2: int = pi[0]
            ioused[0] = 0
            pi[0] = body_start2
            var iosaved2: int = pi[0]
            fx_io_scan_block(src, tk, ts, te, n, pi, err, psrc, pns, pne, peff, pext, pcnt, ioused, await_seen)
            if pi[0] == iosaved2:
              pi[0] = iostart2
              ioused[0] = 0
            else:
              pi[0] = iostart2
        if fx_has_eff(used[0], 1) == 1:
          if fx_has_eff(decl[0], 1) == 0:
            found[0] = 1
            li_rt_emit_err(900)
            return 1
        if fx_has_eff(ioused[0], 1) == 1:
          if fx_has_eff(decl[0], 1) == 0:
            found[0] = 1
            li_rt_emit_err(900)
            return 1
        if fx_has_eff(ioused[0], 1) == 1:
          if fx_has_eff(decl[0], 1) == 0:
            found[0] = 1
            li_rt_emit_err(900)
            return 1
        # Heap-type rule (borrowck.cpp effects_check_module: proc_mentions_
        # heap && !has_effect(raises, Alloc)): heap[0] carries param/ret
        # mentions from this def's walk, preg 17.3 the VarDecl mentions
        # picked up by the heap watch during the body scan; extern procs
        # are excluded by the enclosing is_ext2 gate (C++ continue).
        li_rt_preg_set(17, 4, 0)
        if heap[0] == 1:
          li_rt_preg_set(17, 3, 1)
        if li_rt_preg_get(17, 3) == 1:
          if fx_has_eff(decl[0], 2) == 0:
            found[0] = 1
            li_rt_emit_err(900)
            return 1
        if found[0] == 1:
          return 1
      skip_newlines(tk,  n,  pi,  err)
      continue
    return found[0]
  return found[0]

# The io rule's recursive scan chain: a verbatim mirror of fx_scan_expr /
# fx_scan_block / fx_scan_stmt whose ONLY flag rule is the builtin
# echo/print IO bit, applied at every position C++ counts (stmt exprs,
# conditions, var/borrow inits, assignment both sides, call args, and all
# nested blocks). Var-decl inits are scanned here (unlike fx_scan_stmt,
# which consumes them with the quiet parser) because C++ counts Stmt::init.

def fx_io_scan_expr(src: var ptr,  tk: var array[262144, int],  ts: var array[262144, int], te: var array[262144, int],  n: var array[1, int],  pi: var array[1, int], err: var array[1, int],  psrc: var array[256, ptr], pns: var array[256, int], pne: var array[256, int], peff: var array[256, int], pext: var array[256, int], pcnt: var array[1, int],  used: var array[1, int], await_seen: var array[1, int]) -> int
  requires true
  ensures result == 1
  decreases 0
=
  var depth: int = 0
  while 1 == 1:
    var k: int = cur_kind(tk,  n,  pi,  err)
    if depth == 0:
      if k == 1 or k == 3 or k == 0 or k == 56 or k == 55:
        break
    if k == 0:
      # Broken-input guard: the fx channel only ever sees post-parse tokens,
      # but the mir pre-pass walks freshly lexed unchecked streams — an
      # unclosed bracket depth must not scan past n[0] (that reads the
      # token-span arrays out of bounds and crashes).
      break
    if k == 49 or k == 51 or k == 53:
      depth = depth + 1
    if k == 50 or k == 52 or k == 54:
      depth = depth - 1
    if k == 34:
      await_seen[0] = 1
    if k == 4:
      if peek_off(tk,  n,  pi, 1) == 49:
        # Literal builtin echo/print only: when the walker's own table
        # holds a proc of the same name it is user-defined and never
        # counts (C++ proc_map.count(ident) == 0 condition).
        if tok_is(src,  ts,  te,  pi[0],  "print") == 1:
          if fx_mir_ext_of(src, ts, te, psrc, pns, pne, pext, pcnt, pi[0]) == 0 - 1:
            fx_add_eff(used, 1)
        if tok_is(src,  ts,  te,  pi[0],  "echo") == 1:
          if fx_mir_ext_of(src, ts, te, psrc, pns, pne, pext, pcnt, pi[0]) == 0 - 1:
            fx_add_eff(used, 1)
    pi[0] = pi[0] + 1
    if pi[0] > n[0]:
      break
  return 1

def fx_io_scan_block(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], psrc: var array[256, ptr], pns: var array[256, int], pne: var array[256, int], peff: var array[256, int], pext: var array[256, int], pcnt: var array[1, int], used: var array[1, int], await_seen: var array[1, int]) -> int
  requires true
  ensures result == 1
  decreases 0
=
  skip_newlines(tk, n, pi, err)
  if expect_k(tk, n, pi, err, 2) == 0:
    return 1
  skip_newlines(tk, n, pi, err)
  while 1 == 1:
    if cur_kind(tk, n, pi, err) == 3:
      break
    if cur_kind(tk, n, pi, err) == 0:
      break
    var before: int = pi[0]
    fx_io_scan_stmt(src, tk, ts, te, n, pi, err, psrc, pns, pne, peff, pext, pcnt, used, await_seen)
    if pi[0] == before:
      break
    skip_newlines(tk, n, pi, err)
  expect_k(tk, n, pi, err, 3)
  return 1

def fx_io_scan_stmt(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], psrc: var array[256, ptr], pns: var array[256, int], pne: var array[256, int], peff: var array[256, int], pext: var array[256, int], pcnt: var array[1, int], used: var array[1, int], await_seen: var array[1, int]) -> int
  requires true
  ensures result == 1
  decreases 0
=
  var k: int = cur_kind(tk, n, pi, err)
  if k == 20:
    pi[0] = pi[0] + 1
    if cur_kind(tk, n, pi, err) == 4:
      pi[0] = pi[0] + 1
    if accept_k(tk, n, pi, err, 56) == 1:
      parse_type(src, tk, ts, te, n, pi, err, 0)
    if accept_k(tk, n, pi, err, 58) == 1:
      # Var-decl init: C++ counts Stmt::init, so the init expression is
      # scanned here (fx_scan_stmt consumes it with the quiet parser
      # because the extern rule must not see it — the io rule must).
      fx_io_scan_expr(src, tk, ts, te, n, pi, err, psrc, pns, pne, peff, pext, pcnt, used, await_seen)
    skip_newlines(tk, n, pi, err)
    return 1
  if k == 30:
    pi[0] = pi[0] + 1
    if cur_kind(tk, n, pi, err) != 1:
      fx_io_scan_expr(src, tk, ts, te, n, pi, err, psrc, pns, pne, peff, pext, pcnt, used, await_seen)
    return 1
  if k == 22:
    pi[0] = pi[0] + 1
    fx_io_scan_expr(src, tk, ts, te, n, pi, err, psrc, pns, pne, peff, pext, pcnt, used, await_seen)
    expect_k(tk, n, pi, err, 56)
    skip_newlines(tk, n, pi, err)
    fx_io_scan_block(src, tk, ts, te, n, pi, err, psrc, pns, pne, peff, pext, pcnt, used, await_seen)
    while cur_kind(tk, n, pi, err) == 24:
      pi[0] = pi[0] + 1
      fx_io_scan_expr(src, tk, ts, te, n, pi, err, psrc, pns, pne, peff, pext, pcnt, used, await_seen)
      expect_k(tk, n, pi, err, 56)
      skip_newlines(tk, n, pi, err)
      fx_io_scan_block(src, tk, ts, te, n, pi, err, psrc, pns, pne, peff, pext, pcnt, used, await_seen)
    if cur_kind(tk, n, pi, err) == 23:
      pi[0] = pi[0] + 1
      expect_k(tk, n, pi, err, 56)
      skip_newlines(tk, n, pi, err)
      fx_io_scan_block(src, tk, ts, te, n, pi, err, psrc, pns, pne, peff, pext, pcnt, used, await_seen)
    return 1
  if k == 25:
    pi[0] = pi[0] + 1
    fx_io_scan_expr(src, tk, ts, te, n, pi, err, psrc, pns, pne, peff, pext, pcnt, used, await_seen)
    if cur_kind(tk, n, pi, err) == 56:
      pi[0] = pi[0] + 1
    skip_newlines(tk, n, pi, err)
    fx_io_scan_block(src, tk, ts, te, n, pi, err, psrc, pns, pne, peff, pext, pcnt, used, await_seen)
    return 1
  if k == 76:
    parse_decorator_list(src, tk, ts, te, n, pi, err, 0)
    skip_newlines(tk, n, pi, err)
    fx_io_scan_stmt(src, tk, ts, te, n, pi, err, psrc, pns, pne, peff, pext, pcnt, used, await_seen)
    return 1
  if k == 26:
    pi[0] = pi[0] + 1
    var fh: array[3, int]
    for_tail(src, tk, ts, te, n, pi, err, fh)
    skip_newlines(tk, n, pi, err)
    fx_io_scan_block(src, tk, ts, te, n, pi, err, psrc, pns, pne, peff, pext, pcnt, used, await_seen)
    return 1
  fx_io_scan_expr(src, tk, ts, te, n, pi, err, psrc, pns, pne, peff, pext, pcnt, used, await_seen)
  if accept_k(tk, n, pi, err, 58) == 1:
    fx_io_scan_expr(src, tk, ts, te, n, pi, err, psrc, pns, pne, peff, pext, pcnt, used, await_seen)
  return 1

# ---- Layer 4c: borrow checking (E0310 double-mut, E0311 use-after-move) ----
# Mirrors compiler/types/borrowck.cpp. A plain-ident call argument moves the
# local iff the callee parameter is non-`var` and non-scalar; reading a moved
# local is E0311, and reading a value with an active `borrow mut` (or taking a
# second borrow) is E0310.

type Pos256 = {p: int | 0 <= p and p < 256}

def peek256(buf: var array[256, int], p: Pos256) -> int
  requires true
  ensures result == buf[p]
  decreases 0
=
  return buf[p]

def set256(buf: var array[256, int], p: Pos256, v: int) -> int
  requires true
  ensures result == v
  decreases 0
=
  buf[p] = v
  return v

def bk_scalar_name(src: var ptr, ts: var array[262144, int], te: var array[262144, int], i: int) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  if tok_is(src, ts, te, i, "int") == 1:
    return 1
  if tok_is(src, ts, te, i, "float") == 1:
    return 1
  if tok_is(src, ts, te, i, "i64") == 1:
    return 1
  if tok_is(src, ts, te, i, "int64") == 1:
    return 1
  if tok_is(src, ts, te, i, "long") == 1:
    return 1
  if tok_is(src, ts, te, i, "bool") == 1:
    return 1
  if tok_is(src, ts, te, i, "ptr") == 1:
    return 1
  if tok_is(src, ts, te, i, "str") == 1:
    return 1
  if tok_is(src, ts, te, i, "float64") == 1:
    return 1
  if tok_is(src, ts, te, i, "f32") == 1:
    return 1
  if tok_is(src, ts, te, i, "f64") == 1:
    return 1
  if tok_is(src, ts, te, i, "u32") == 1:
    return 1
  if tok_is(src, ts, te, i, "u64") == 1:
    return 1
  if tok_is(src, ts, te, i, "unit") == 1:
    return 1
  return 0

def bk_proc_index(src: var ptr, ts: var array[262144, int], te: var array[262144, int], bp_name: var array[256, int], bp_cnt: var array[1, int], name_tok: int) -> int
  requires true
  ensures result >= -1
  decreases 0
=
  var k: int = 0
  while k < bp_cnt[0]:
    if tok_eq(src, ts, te, bp_name[k], name_tok) == 1:
      return k
    k = k + 1
  return -1

def bk_param_moves(bp_np: var array[256, int], bp_pv: var array[4096, int], bp_ps: var array[4096, int], pidx: int, j: int) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  if j >= peek256(bp_np, pidx + 0):
    return 0
  if peek4096(bp_pv, pidx * 16 + j) == 1:
    return 0
  if peek4096(bp_ps, pidx * 16 + j) == 1:
    return 0
  return 1

def bk_check_use(src: var ptr, ts: var array[262144, int], te: var array[262144, int], ls_name: var array[256, int], ls_moved: var array[256, int], ls_mb: var array[256, int], ls_n: var array[1, int], name_tok: int, err: var array[1, int]) -> int
  requires true
  ensures result == 0
  decreases 0
=
  var k: int = 0
  while k < ls_n[0]:
    if tok_eq(src, ts, te, ls_name[k], name_tok) == 1:
      if ls_moved[k] == 1:
        err[0] = 1
        li_rt_emit_err(311)
        if li_rt_preg_get(14, 0) == 1:
          li_rt_preg_set(23, 0, 1)
        return 0
      if ls_mb[k] > 0:
        err[0] = 1
        li_rt_emit_err(310)
        if li_rt_preg_get(14, 0) == 1:
          li_rt_preg_set(23, 0, 1)
      return 0
    k = k + 1
  return 0

def bk_mark_moved(src: var ptr, ts: var array[262144, int], te: var array[262144, int], ls_name: var array[256, int], ls_moved: var array[256, int], ls_n: var array[1, int], name_tok: int) -> int
  requires true
  ensures result == 0
  decreases 0
=
  var k: int = 0
  while k < ls_n[0]:
    if tok_eq(src, ts, te, ls_name[k], name_tok) == 1:
      ls_moved[k] = 1
      return 0
    k = k + 1
  return 0

def bk_check_expr(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], bo: int, min_prec: int, bp_name: var array[256, int], bp_np: var array[256, int], bp_pv: var array[4096, int], bp_ps: var array[4096, int], bp_cnt: var array[1, int], ls_name: var array[256, int], ls_moved: var array[256, int], ls_mb: var array[256, int], ls_n: var array[1, int], rq_proc: var array[256, int], rq_pi: var array[256, int], rq_op: var array[256, int], rq_lit: var array[256, int], rq_left: var array[256, int], rq_n: var array[1, int], iem_src: var array[256, ptr], iem_ns: var array[256, int], iem_ne: var array[256, int], iem_vis: var array[256, int], iem_cnt: var array[1, int], iem_uq: int) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  if cur_kind(tk, n, pi, err) == 39:
    pi[0] = pi[0] + 1
    return bk_check_expr(src, tk, ts, te, n, pi, err, bo, 100, bp_name, bp_np, bp_pv, bp_ps, bp_cnt, ls_name, ls_moved, ls_mb, ls_n, rq_proc, rq_pi, rq_op, rq_lit, rq_left, rq_n, iem_src, iem_ns, iem_ne, iem_vis, iem_cnt, iem_uq)
  if cur_kind(tk, n, pi, err) == 60:
    pi[0] = pi[0] + 1
  if bk_check_primary(src, tk, ts, te, n, pi, err, bo, bp_name, bp_np, bp_pv, bp_ps, bp_cnt, ls_name, ls_moved, ls_mb, ls_n, rq_proc, rq_pi, rq_op, rq_lit, rq_left, rq_n, iem_src, iem_ns, iem_ne, iem_vis, iem_cnt, iem_uq) == 0:
    return 0
  while 1 == 1:
    var p: int = prec_of(cur_kind(tk, n, pi, err))
    if p < 0:
      break
    if p < min_prec:
      break
    pi[0] = pi[0] + 1
    if bk_check_expr(src, tk, ts, te, n, pi, err, bo, p + 1, bp_name, bp_np, bp_pv, bp_ps, bp_cnt, ls_name, ls_moved, ls_mb, ls_n, rq_proc, rq_pi, rq_op, rq_lit, rq_left, rq_n, iem_src, iem_ns, iem_ne, iem_vis, iem_cnt, iem_uq) == 0:
      return 0
  return 1

def bk_check_primary(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], bo: int, bp_name: var array[256, int], bp_np: var array[256, int], bp_pv: var array[4096, int], bp_ps: var array[4096, int], bp_cnt: var array[1, int], ls_name: var array[256, int], ls_moved: var array[256, int], ls_mb: var array[256, int], ls_n: var array[1, int], rq_proc: var array[256, int], rq_pi: var array[256, int], rq_op: var array[256, int], rq_lit: var array[256, int], rq_left: var array[256, int], rq_n: var array[1, int], iem_src: var array[256, ptr], iem_ns: var array[256, int], iem_ne: var array[256, int], iem_vis: var array[256, int], iem_cnt: var array[1, int], iem_uq: int) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  var k: int = cur_kind(tk, n, pi, err)
  if k == 34:
    pi[0] = pi[0] + 1
    # `-x` on a non-literal is an Expr::UnaryMinus node in C++; borrowck's
    # check_expr_uses has NO UnaryMinus case, so the host walks the
    # subtree with no use-checks and no move marking — run the subtree
    # bo=0 (rq_check_call stays on, mirroring typecheck.cpp which still
    # visits the subexpr for the callee-requires check).
    if bk_check_primary(src, tk, ts, te, n, pi, err, 0, bp_name, bp_np, bp_pv, bp_ps, bp_cnt, ls_name, ls_moved, ls_mb, ls_n, rq_proc, rq_pi, rq_op, rq_lit, rq_left, rq_n, iem_src, iem_ns, iem_ne, iem_vis, iem_cnt, iem_uq) == 0:
      return 0
    return bk_check_postfix(src, tk, ts, te, n, pi, err, 0, bp_name, bp_np, bp_pv, bp_ps, bp_cnt, ls_name, ls_moved, ls_mb, ls_n, rq_proc, rq_pi, rq_op, rq_lit, rq_left, rq_n, iem_src, iem_ns, iem_ne, iem_vis, iem_cnt, iem_uq)
  if k == 8 or k == 5 or k == 6 or k == 7:
    pi[0] = pi[0] + 1
    return bk_check_postfix(src, tk, ts, te, n, pi, err, bo, bp_name, bp_np, bp_pv, bp_ps, bp_cnt, ls_name, ls_moved, ls_mb, ls_n, rq_proc, rq_pi, rq_op, rq_lit, rq_left, rq_n, iem_src, iem_ns, iem_ne, iem_vis, iem_cnt, iem_uq)
  if k == 4 or k == 46 or k == 35 or k == 36:
    var t4: int = pi[0]
    pi[0] = pi[0] + 1
    if accept_k(tk, n, pi, err, 49) == 1:
      var arg_toks: array[16, int]
      var arg_plains: array[16, int]
      var argc: int = 0
      if cur_kind(tk, n, pi, err) != 50:
        var j: int = 0
        var done: int = 0
        while done == 0:
          skip_newlines(tk, n, pi, err)
          var arg_plain: int = 0
          var arg_tok: int = pi[0]
          if argc < 16:
            arg_toks[argc] = arg_tok
            arg_plains[argc] = 0
            argc = argc + 1
          if cur_kind(tk, n, pi, err) == 4:
            if peek_off(tk, n, pi, 1) == 55 or peek_off(tk, n, pi, 1) == 50:
              arg_plain = 1
          # C++ check_expr_uses checks EVERY arg's uses first; only
          # check_call_moves (after the full arg list) marks. A repeated
          # mover arg `f(a, a)` must use `a` twice unmarked and mark once
          # after the closing paren — immediate per-arg marking would
          # use-check arg 1 against arg 0's fresh mark (probe:
          # li-tests/borrow/probe_same_arg_call.li). Buffer the plain flag
          # per slot and apply the mover marks after expect(50).
          if argc < 16:
            if arg_plain == 1:
              arg_plains[argc - 1] = 1
          skip_newlines(tk, n, pi, err)
          if bk_check_expr(src, tk, ts, te, n, pi, err, bo, 0, bp_name, bp_np, bp_pv, bp_ps, bp_cnt, ls_name, ls_moved, ls_mb, ls_n, rq_proc, rq_pi, rq_op, rq_lit, rq_left, rq_n, iem_src, iem_ns, iem_ne, iem_vis, iem_cnt, iem_uq) == 0:
            return 0
          j = j + 1
          skip_newlines(tk, n, pi, err)
          if accept_k(tk, n, pi, err, 55) == 1:
            done = 0
          else:
            done = 1
      skip_newlines(tk, n, pi, err)
      expect_k(tk, n, pi, err, 50)
      # Apply the buffered mover marks AFTER all arg use-checks (C++
      # check_call_moves ordering). Slot indices here equal j positions for
      # j < 16; args past the 16-slot buffer are not marked (the bp table
      # row is 16 bits per proc and preg masks only reach bit 15, so the
      # pre-port j>=16 verdicts were unreliable anyway — no corpus shape
      # needs them).
      if bo == 1:
        var jj: int = 0
        var pidx: int = bk_proc_index(src, ts, te, bp_name, bp_cnt, t4)
        while jj < argc:
          if arg_plains[jj] == 1:
            if pidx >= 0:
              if bk_param_moves(bp_np, bp_pv, bp_ps, pidx, jj) == 1:
                bk_mark_moved(src, ts, te, ls_name, ls_moved, ls_n, arg_toks[jj])
            else:
              # Import-space fallback (C++ borrowck resolves callees against
              # the MERGED proc_map — merge_module pushes imported public
              # procs): match the callee in the iem rows (fx span triples)
              # and read the row's param masks from preg 15 (is-var) / 16
              # (scalar), written by fx_skip_params during pass1's seed
              # walk. A mover param at slot jj (neither var nor scalar)
              # moves this arg exactly like C++ check_call_moves.
              if iem_uq == 1:
                var r4: int = 0
                var rfound4: int = 0
                while rfound4 == 0:
                  if r4 >= iem_cnt[0]:
                    break
                  if fx_span_eq(iem_src[r4], iem_ns[r4], iem_ne[r4], src, peek_tk(ts, t4 + 0), peek_tk(te, t4 + 0)) == 1:
                    rfound4 = 1
                  else:
                    r4 = r4 + 1
                if rfound4 == 1:
                  var mvr4: int = li_rt_preg_get(15, r4 + 0)
                  var msr4: int = li_rt_preg_get(16, r4 + 0)
                  var pw4: int = 1
                  var q4: int = 0
                  while q4 < jj:
                    pw4 = pw4 * 2
                    q4 = q4 + 1
                  var vbit4: int = (mvr4 // pw4) % 2
                  var sbit4: int = (msr4 // pw4) % 2
                  if vbit4 == 0:
                    if sbit4 == 0:
                      bk_mark_moved(src, ts, te, ls_name, ls_moved, ls_n, arg_toks[jj])
          jj = jj + 1
      rq_check_call(src, tk, ts, te, n, pi, err, t4, arg_toks, argc, rq_proc, rq_pi, rq_op, rq_lit, rq_left, rq_n, bp_name, bp_cnt, iem_src, iem_ns, iem_ne, iem_vis, iem_cnt, iem_uq)
    else:
      if bo == 1:
        # C++ exprs are Field/MethodCall nodes for `x.f` / `x.m(...)`;
        # borrowck's check_expr_uses has no case for those kinds, so the
        # host never use-checks a field/method BASE (moved-then-field-read
        # is accepted — lig_custom_target_ready shape). Bare idents and
        # index bases (Expr::Ident, Expr::Index) still use-check.
        if cur_kind(tk, n, pi, err) == 72:
          # suppressed: field/method base (no-op arm keeps the guard shape;
          # cur_kind is a pure token read)
          cur_kind(tk, n, pi, err)
        else:
          bk_check_use(src, ts, te, ls_name, ls_moved, ls_mb, ls_n, t4, err)
    return bk_check_postfix(src, tk, ts, te, n, pi, err, bo, bp_name, bp_np, bp_pv, bp_ps, bp_cnt, ls_name, ls_moved, ls_mb, ls_n, rq_proc, rq_pi, rq_op, rq_lit, rq_left, rq_n, iem_src, iem_ns, iem_ne, iem_vis, iem_cnt, iem_uq)
  if accept_k(tk, n, pi, err, 49) == 1:
    if bk_check_expr(src, tk, ts, te, n, pi, err, bo, 0, bp_name, bp_np, bp_pv, bp_ps, bp_cnt, ls_name, ls_moved, ls_mb, ls_n, rq_proc, rq_pi, rq_op, rq_lit, rq_left, rq_n, iem_src, iem_ns, iem_ne, iem_vis, iem_cnt, iem_uq) == 0:
      return 0
    expect_k(tk, n, pi, err, 50)
    return bk_check_postfix(src, tk, ts, te, n, pi, err, bo, bp_name, bp_np, bp_pv, bp_ps, bp_cnt, ls_name, ls_moved, ls_mb, ls_n, rq_proc, rq_pi, rq_op, rq_lit, rq_left, rq_n, iem_src, iem_ns, iem_ne, iem_vis, iem_cnt, iem_uq)
  err[0] = 1
  return 0

def bk_check_postfix(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], bo: int, bp_name: var array[256, int], bp_np: var array[256, int], bp_pv: var array[4096, int], bp_ps: var array[4096, int], bp_cnt: var array[1, int], ls_name: var array[256, int], ls_moved: var array[256, int], ls_mb: var array[256, int], ls_n: var array[1, int], rq_proc: var array[256, int], rq_pi: var array[256, int], rq_op: var array[256, int], rq_lit: var array[256, int], rq_left: var array[256, int], rq_n: var array[1, int], iem_src: var array[256, ptr], iem_ns: var array[256, int], iem_ne: var array[256, int], iem_vis: var array[256, int], iem_cnt: var array[1, int], iem_uq: int) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  var loop: int = 1
  while loop == 1:
    if cur_kind(tk, n, pi, err) == 72:
      pi[0] = pi[0] + 1
      pi[0] = pi[0] + 1
      var mcall: int = pi[0] - 1
      if accept_k(tk, n, pi, err, 49) == 1:
        var arg_toks: array[16, int]
        var argc: int = 0
        skip_newlines(tk, n, pi, err)
        if cur_kind(tk, n, pi, err) != 50:
          var done: int = 0
          while done == 0:
            skip_newlines(tk, n, pi, err)
            var at2: int = pi[0]
            if argc < 16:
              arg_toks[argc] = at2
              argc = argc + 1
            if bk_check_expr(src, tk, ts, te, n, pi, err, bo, 0, bp_name, bp_np, bp_pv, bp_ps, bp_cnt, ls_name, ls_moved, ls_mb, ls_n, rq_proc, rq_pi, rq_op, rq_lit, rq_left, rq_n, iem_src, iem_ns, iem_ne, iem_vis, iem_cnt, iem_uq) == 0:
              return 0
            skip_newlines(tk, n, pi, err)
            if accept_k(tk, n, pi, err, 55) == 1:
              done = 0
            else:
              done = 1
        skip_newlines(tk, n, pi, err)
        expect_k(tk, n, pi, err, 50)
        rq_check_call(src, tk, ts, te, n, pi, err, mcall, arg_toks, argc, rq_proc, rq_pi, rq_op, rq_lit, rq_left, rq_n, bp_name, bp_cnt, iem_src, iem_ns, iem_ne, iem_vis, iem_cnt, 0)
      continue
    if cur_kind(tk, n, pi, err) == 51:
      pi[0] = pi[0] + 1
      if bk_check_expr(src, tk, ts, te, n, pi, err, bo, 0, bp_name, bp_np, bp_pv, bp_ps, bp_cnt, ls_name, ls_moved, ls_mb, ls_n, rq_proc, rq_pi, rq_op, rq_lit, rq_left, rq_n, iem_src, iem_ns, iem_ne, iem_vis, iem_cnt, iem_uq) == 0:
        return 0
      expect_k(tk, n, pi, err, 52)
      continue
    loop = 0
  return 1

def bk_check_stmt(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], bo: int, bp_name: var array[256, int], bp_np: var array[256, int], bp_pv: var array[4096, int], bp_ps: var array[4096, int], bp_cnt: var array[1, int], ls_name: var array[256, int], ls_moved: var array[256, int], ls_mb: var array[256, int], ls_ib: var array[256, int], ls_n: var array[1, int], rq_proc: var array[256, int], rq_pi: var array[256, int], rq_op: var array[256, int], rq_lit: var array[256, int], rq_left: var array[256, int], rq_n: var array[1, int], iem_src: var array[256, ptr], iem_ns: var array[256, int], iem_ne: var array[256, int], iem_vis: var array[256, int], iem_cnt: var array[1, int], iem_uq: int) -> int
  requires true
  ensures result == 1
  decreases 0
=
  var k: int = cur_kind(tk, n, pi, err)
  if k == 20:
    pi[0] = pi[0] + 1
    var vn: int = pi[0]
    pi[0] = pi[0] + 1
    expect_k(tk, n, pi, err, 56)
    parse_type(src, tk, ts, te, n, pi, err, 0)
    if accept_k(tk, n, pi, err, 58) == 1:
      bk_check_expr(src, tk, ts, te, n, pi, err, bo, 0, bp_name, bp_np, bp_pv, bp_ps, bp_cnt, ls_name, ls_moved, ls_mb, ls_n, rq_proc, rq_pi, rq_op, rq_lit, rq_left, rq_n, iem_src, iem_ns, iem_ne, iem_vis, iem_cnt, iem_uq)
    if bo == 1:
      ls_name[ls_n[0]] = vn
      ls_moved[ls_n[0]] = 0
      ls_mb[ls_n[0]] = 0
      ls_ib[ls_n[0]] = 0
      ls_n[0] = ls_n[0] + 1
    return 1
  if k == 4:
    if tok_is(src, ts, te, pi[0], "borrow") == 1:
      pi[0] = pi[0] + 1
      var bm: int = 0
      if cur_kind(tk, n, pi, err) == 4:
        if tok_is(src, ts, te, pi[0], "mut") == 1:
          bm = 1
          pi[0] = pi[0] + 1
        else:
          if tok_is(src, ts, te, pi[0], "imm") == 1:
            pi[0] = pi[0] + 1
      var bname: int = pi[0]
      pi[0] = pi[0] + 1
      expect_k(tk, n, pi, err, 58)
      var src_tok: int = pi[0]
      var src_ident: int = 0
      if cur_kind(tk, n, pi, err) == 4:
        src_ident = 1
      if parse_primary(src, tk, ts, te, n, pi, err, 0) == 0:
        return 1
      parse_postfix(src, tk, ts, te, n, pi, err, 0)
      if src_ident == 1 and bo == 1:
        bk_check_use(src, ts, te, ls_name, ls_moved, ls_mb, ls_n, src_tok, err)
        var k2: int = 0
        while k2 < ls_n[0]:
          if tok_eq(src, ts, te, ls_name[k2], src_tok) == 1:
            if bm == 1:
              if ls_mb[k2] > 0 or ls_ib[k2] > 0:
                err[0] = 1
                li_rt_emit_err(310)
                if li_rt_preg_get(14, 0) == 1:
                  li_rt_preg_set(23, 0, 1)
              ls_mb[k2] = ls_mb[k2] + 1
            else:
              if ls_mb[k2] > 0:
                err[0] = 1
                li_rt_emit_err(310)
                if li_rt_preg_get(14, 0) == 1:
                  li_rt_preg_set(23, 0, 1)
              ls_ib[k2] = ls_ib[k2] + 1
            k2 = ls_n[0]
          k2 = k2 + 1
      if bo == 1:
        ls_name[ls_n[0]] = bname
        ls_moved[ls_n[0]] = 0
        ls_mb[ls_n[0]] = 0
        ls_ib[ls_n[0]] = 0
        ls_n[0] = ls_n[0] + 1
      return 1
    if tok_is(src, ts, te, pi[0], "discard") == 1:
      pi[0] = pi[0] + 1
      return 1
  if k == 30:
    pi[0] = pi[0] + 1
    if cur_kind(tk, n, pi, err) != 1:
      if cur_kind(tk, n, pi, err) != 3:
        if cur_kind(tk, n, pi, err) != 0:
          bk_check_expr(src, tk, ts, te, n, pi, err, bo, 0, bp_name, bp_np, bp_pv, bp_ps, bp_cnt, ls_name, ls_moved, ls_mb, ls_n, rq_proc, rq_pi, rq_op, rq_lit, rq_left, rq_n, iem_src, iem_ns, iem_ne, iem_vis, iem_cnt, iem_uq)
    return 1
  if k == 22:
    pi[0] = pi[0] + 1
    bk_check_expr(src, tk, ts, te, n, pi, err, bo, 0, bp_name, bp_np, bp_pv, bp_ps, bp_cnt, ls_name, ls_moved, ls_mb, ls_n, rq_proc, rq_pi, rq_op, rq_lit, rq_left, rq_n, iem_src, iem_ns, iem_ne, iem_vis, iem_cnt, iem_uq)
    expect_k(tk, n, pi, err, 56)
    skip_newlines(tk, n, pi, err)
    bk_check_block(src, tk, ts, te, n, pi, err, bo, bp_name, bp_np, bp_pv, bp_ps, bp_cnt, ls_name, ls_moved, ls_mb, ls_ib, ls_n, rq_proc, rq_pi, rq_op, rq_lit, rq_left, rq_n, iem_src, iem_ns, iem_ne, iem_vis, iem_cnt, iem_uq)
    var tail_done: int = 0
    # C++ check_stmt(If) walks then_body ONLY: elif cond/blocks and the
    # else block sit in else_body, which borrowck never enters. They run
    # bo=0 here (rq lane stays on, borrow/marks stay off).
    while tail_done == 0:
      skip_newlines(tk, n, pi, err)
      if cur_kind(tk, n, pi, err) == 24:
        pi[0] = pi[0] + 1
        bk_check_expr(src, tk, ts, te, n, pi, err, 0, 0, bp_name, bp_np, bp_pv, bp_ps, bp_cnt, ls_name, ls_moved, ls_mb, ls_n, rq_proc, rq_pi, rq_op, rq_lit, rq_left, rq_n, iem_src, iem_ns, iem_ne, iem_vis, iem_cnt, iem_uq)
        expect_k(tk, n, pi, err, 56)
        skip_newlines(tk, n, pi, err)
        bk_check_block(src, tk, ts, te, n, pi, err, 0, bp_name, bp_np, bp_pv, bp_ps, bp_cnt, ls_name, ls_moved, ls_mb, ls_ib, ls_n, rq_proc, rq_pi, rq_op, rq_lit, rq_left, rq_n, iem_src, iem_ns, iem_ne, iem_vis, iem_cnt, iem_uq)
      else:
        if cur_kind(tk, n, pi, err) == 23:
          pi[0] = pi[0] + 1
          expect_k(tk, n, pi, err, 56)
          skip_newlines(tk, n, pi, err)
          bk_check_block(src, tk, ts, te, n, pi, err, 0, bp_name, bp_np, bp_pv, bp_ps, bp_cnt, ls_name, ls_moved, ls_mb, ls_ib, ls_n, rq_proc, rq_pi, rq_op, rq_lit, rq_left, rq_n, iem_src, iem_ns, iem_ne, iem_vis, iem_cnt, iem_uq)
          tail_done = 1
        else:
          tail_done = 1
    return 1
  if k == 25:
    pi[0] = pi[0] + 1
    bk_check_expr(src, tk, ts, te, n, pi, err, bo, 0, bp_name, bp_np, bp_pv, bp_ps, bp_cnt, ls_name, ls_moved, ls_mb, ls_n, rq_proc, rq_pi, rq_op, rq_lit, rq_left, rq_n, iem_src, iem_ns, iem_ne, iem_vis, iem_cnt, iem_uq)
    if cur_kind(tk, n, pi, err) == 56:
      pi[0] = pi[0] + 1
    skip_newlines(tk, n, pi, err)
    # A loop body runs the requires-clause check (C++'s typecheck descends into
    # while bodies) but not the move/borrow bookkeeping: C++'s borrowck only
    # walks if/else bodies, so loop bodies stay opaque to it.
    bk_check_block(src, tk, ts, te, n, pi, err, 0, bp_name, bp_np, bp_pv, bp_ps, bp_cnt, ls_name, ls_moved, ls_mb, ls_ib, ls_n, rq_proc, rq_pi, rq_op, rq_lit, rq_left, rq_n, iem_src, iem_ns, iem_ne, iem_vis, iem_cnt, iem_uq)
    return 1
  if k == 26:
    pi[0] = pi[0] + 1
    var fh: array[3, int]
    for_tail(src, tk, ts, te, n, pi, err, fh)
    skip_newlines(tk, n, pi, err)
    # Loop bodies run the requires-clause check but not the move/borrow
    # bookkeeping: C++'s borrowck only walks if/else bodies.
    bk_check_block(src, tk, ts, te, n, pi, err, 0, bp_name, bp_np, bp_pv, bp_ps, bp_cnt, ls_name, ls_moved, ls_mb, ls_ib, ls_n, rq_proc, rq_pi, rq_op, rq_lit, rq_left, rq_n, iem_src, iem_ns, iem_ne, iem_vis, iem_cnt, iem_uq)
    return 1
  if k == 76:
    parse_decorator_list(src, tk, ts, te, n, pi, err, 0)
    skip_newlines(tk, n, pi, err)
    bk_check_stmt(src, tk, ts, te, n, pi, err, bo, bp_name, bp_np, bp_pv, bp_ps, bp_cnt, ls_name, ls_moved, ls_mb, ls_ib, ls_n, rq_proc, rq_pi, rq_op, rq_lit, rq_left, rq_n, iem_src, iem_ns, iem_ne, iem_vis, iem_cnt, iem_uq)
    return 1
  if k == 27 or k == 28:
    parse_stmt(src, tk, ts, te, n, pi, err, 0)
    return 1
  if k == 4:
    if tok_is(src, ts, te, pi[0], "parallel") == 1:
      parse_stmt(src, tk, ts, te, n, pi, err, 0)
      return 1
  var save: int = pi[0]
  var ok: int = parse_primary(src, tk, ts, te, n, pi, err, 0)
  if ok == 1:
    ok = parse_postfix(src, tk, ts, te, n, pi, err, 0)
  if ok == 1:
    if accept_k(tk, n, pi, err, 58) == 1:
      bk_check_expr(src, tk, ts, te, n, pi, err, bo, 0, bp_name, bp_np, bp_pv, bp_ps, bp_cnt, ls_name, ls_moved, ls_mb, ls_n, rq_proc, rq_pi, rq_op, rq_lit, rq_left, rq_n, iem_src, iem_ns, iem_ne, iem_vis, iem_cnt, iem_uq)
      return 1
  pi[0] = save
  bk_check_expr(src, tk, ts, te, n, pi, err, bo, 0, bp_name, bp_np, bp_pv, bp_ps, bp_cnt, ls_name, ls_moved, ls_mb, ls_n, rq_proc, rq_pi, rq_op, rq_lit, rq_left, rq_n, iem_src, iem_ns, iem_ne, iem_vis, iem_cnt, iem_uq)
  return 1

def bk_check_block(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], bo: int, bp_name: var array[256, int], bp_np: var array[256, int], bp_pv: var array[4096, int], bp_ps: var array[4096, int], bp_cnt: var array[1, int], ls_name: var array[256, int], ls_moved: var array[256, int], ls_mb: var array[256, int], ls_ib: var array[256, int], ls_n: var array[1, int], rq_proc: var array[256, int], rq_pi: var array[256, int], rq_op: var array[256, int], rq_lit: var array[256, int], rq_left: var array[256, int], rq_n: var array[1, int], iem_src: var array[256, ptr], iem_ns: var array[256, int], iem_ne: var array[256, int], iem_vis: var array[256, int], iem_cnt: var array[1, int], iem_uq: int) -> int
  requires true
  ensures result == 1
  decreases 0
=
  skip_newlines(tk, n, pi, err)
  if expect_k(tk, n, pi, err, 2) == 0:
    return 1
  skip_newlines(tk, n, pi, err)
  while 1 == 1:
    if cur_kind(tk, n, pi, err) == 3:
      break
    if cur_kind(tk, n, pi, err) == 0:
      break
    var before: int = pi[0]
    bk_check_stmt(src, tk, ts, te, n, pi, err, bo, bp_name, bp_np, bp_pv, bp_ps, bp_cnt, ls_name, ls_moved, ls_mb, ls_ib, ls_n, rq_proc, rq_pi, rq_op, rq_lit, rq_left, rq_n, iem_src, iem_ns, iem_ne, iem_vis, iem_cnt, iem_uq)
    if pi[0] == before:
      break
    skip_newlines(tk, n, pi, err)
  expect_k(tk, n, pi, err, 3)
  return 1

def bk_skip_params_rec(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], bp_np: var array[256, int], bp_pv: var array[4096, int], bp_ps: var array[4096, int], rp_np: var array[256, int], rp_ps: var array[4096, int], idx: int) -> int
  requires true
  ensures result == 1
  decreases 0
=
  skip_param_layout(tk, n, pi, err)
  var j: int = 0
  if cur_kind(tk, n, pi, err) != 50:
    var done: int = 0
    while done == 0:
      skip_param_layout(tk, n, pi, err)
      if cur_kind(tk, n, pi, err) == 4:
        var pn: int = pi[0]
        pi[0] = pi[0] + 1
        expect_k(tk, n, pi, err, 56)
        var isv: int = 0
        if cur_kind(tk, n, pi, err) == 20:
          isv = 1
        var sc: int = 0
        if cur_kind(tk, n, pi, err) == 4:
          if bk_scalar_name(src, ts, te, pi[0]) == 1:
            sc = 1
        parse_type(src, tk, ts, te, n, pi, err, 0)
        if j < 16:
          if idx < 256:
            bp_pv[idx * 16 + j] = isv
            bp_ps[idx * 16 + j] = sc
            bp_np[idx] = j + 1
            rp_ps[idx * 16 + j] = pn
            rp_np[idx] = j + 1
        j = j + 1
      skip_param_layout(tk, n, pi, err)
      if accept_k(tk, n, pi, err, 55) == 1:
        done = 0
      else:
        done = 1
  skip_param_layout(tk, n, pi, err)
  expect_k(tk, n, pi, err, 50)
  return 1

def bk_skip_params_decl(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], ls_name: var array[256, int], ls_moved: var array[256, int], ls_mb: var array[256, int], ls_ib: var array[256, int], ls_n: var array[1, int]) -> int
  requires true
  ensures result == 1
  decreases 0
=
  skip_param_layout(tk, n, pi, err)
  if cur_kind(tk, n, pi, err) != 50:
    var done: int = 0
    while done == 0:
      skip_param_layout(tk, n, pi, err)
      if cur_kind(tk, n, pi, err) == 4:
        var pn: int = pi[0]
        pi[0] = pi[0] + 1
        expect_k(tk, n, pi, err, 56)
        parse_type(src, tk, ts, te, n, pi, err, 0)
        ls_name[ls_n[0]] = pn
        ls_moved[ls_n[0]] = 0
        ls_mb[ls_n[0]] = 0
        ls_ib[ls_n[0]] = 0
        ls_n[0] = ls_n[0] + 1
      skip_param_layout(tk, n, pi, err)
      if accept_k(tk, n, pi, err, 55) == 1:
        done = 0
      else:
        done = 1
  skip_param_layout(tk, n, pi, err)
  expect_k(tk, n, pi, err, 50)
  return 1

# ---- requires-clause call-site check (C++ E0304 parity) ----
# borrow_check's phase 1 records each proc's `requires param op literal`
# clauses (rq_capture_clause); its phase 2 walk hooks bk_check_primary /
# bk_check_postfix, which flag calls whose matching argument is an int
# literal that makes the clause false (e.g. `callee(-1)` under `requires
# x >= 0`), via rq_check_call.

def rq_lit_val(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], p: int) -> int
  requires true
  ensures result >= 0
  decreases 0
=
  # Token KINDS live in tk (the token-kind stream); ts/te are the byte-span
  # arrays. Reading kinds from ts made rq_lit_val return 0 for every int
  # literal (a start offset is never 60/5/7), so every captured requires
  # literal compared as 0 and the walker fired `param op lit` clauses
  # wrongly in the <,<=,== directions and never in the >=,>,!= ones.
  if peek_tk(tk, p + 0) == 60:
    if peek_tk(tk, p + 1) == 5:
      return 0 - int_text_value(src, ts, te, p + 1)
    return 0
  if peek_tk(tk, p + 0) == 5:
    return int_text_value(src, ts, te, p + 0)
  if peek_tk(tk, p + 0) == 7:
    var s: int = peek_tk(ts, p + 0)
    var e: int = peek_tk(te, p + 0)
    var v: int = 0
    var q: int = s + 2
    while q < e:
      v = v * 2
      if li_rt_str_char_at(src, q + 0) == 49:
        v = v + 1
      q = q + 1
    return v
  return 0

def rq_op_violated(opk: int, l: int, r: int) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  if opk == 70:
    if l == r:
      return 0
    return 1
  if opk == 71:
    if l != r:
      return 0
    return 1
  if opk == 66:
    if l <= r:
      return 0
    return 1
  if opk == 67:
    if l < r:
      return 0
    return 1
  if opk == 68:
    if l >= r:
      return 0
    return 1
  if opk == 69:
    if l > r:
      return 0
    return 1
  return 0

def rq_skip_nl_at(tk: var array[262144, int], n: var array[1, int], q: int) -> int
  requires true
  ensures result >= 0
  decreases 0
=
  while q < n[0]:
    if peek_tk(tk, q + 0) == 1:
      q = q + 1
      continue
    break
  return q

def rq_capture_clause(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], pidx: int, name_tok: int, rp_np: var array[256, int], rp_ps: var array[4096, int], rq_proc: var array[256, int], rq_pi: var array[256, int], rq_op: var array[256, int], rq_lit: var array[256, int], rq_left: var array[256, int], rq_n: var array[1, int]) raises IO -> int
  requires true
  ensures result == 1
  decreases 0
=
  var p: int = rq_skip_nl_at(tk, n, pi[0] + 1)
  if peek_tk(tk, p + 0) == 36:
    # C++ literal_requires_is_false fires on an ident-shaped requires only
    # when it is exactly `false` (compiler/types/typecheck.cpp: Ident &&
    # ident == "false"). Every other ident predicate (`true`, a param,
    # a helper name) is skipped at call sites — capturing it here as the
    # ap=-1 entry made rq_check_call fire E0304 on every call into such a
    # callee (the four lib/smoke false rejects). Mirror the gate.
    if tok_is(src, ts, te, p, "false") == 1:
      if rq_n[0] < 256:
        rq_proc[rq_n[0]] = name_tok
        rq_pi[rq_n[0]] = -1
        rq_op[rq_n[0]] = 0
        rq_lit[rq_n[0]] = 0
        rq_left[rq_n[0]] = 0
        rq_n[0] = rq_n[0] + 1
    return 1
  if peek_tk(tk, p + 0) == 4:
    # param-left `param op lit`
    var q: int = rq_skip_nl_at(tk, n, p + 1)
    var opk: int = peek_tk(tk, q + 0)
    if opk == 66 or opk == 67 or opk == 68 or opk == 69 or opk == 70 or opk == 71:
      # vidx keeps the pre-literal Minus index so rq_lit_val folds the sign
      # (C++ parses `param < -5` with a signed IntLit); litp stays at the
      # bare IntLit for the shape/terminator checks.
      var vidx: int = rq_skip_nl_at(tk, n, q + 1)
      var litp: int = vidx
      if peek_tk(tk, litp + 0) == 60:
        litp = litp + 1
      if peek_tk(tk, litp + 0) == 5 or peek_tk(tk, litp + 0) == 7:
        # single-token literal must terminate the requires expression:
        # C++ parses (param op lit) as one BinOp, so `param op 0 - 5`
        # never yields a literal-bearing right operand.
        var termk: int = peek_tk(tk, litp + 1)
        if termk == 1 or termk == 0 or termk == 3 or termk == 44 or termk == 45:
          var a: int = 0
          while a < rp_np[pidx]:
            if tok_eq(src, ts, te, peek256(rp_ps, pidx * 16 + a), p + 0) == 1:
              if rq_n[0] < 256:
                rq_proc[rq_n[0]] = name_tok
                rq_pi[rq_n[0]] = a
                rq_op[rq_n[0]] = opk
                rq_lit[rq_n[0]] = rq_lit_val(src, tk, ts, te, vidx + 0)
                rq_left[rq_n[0]] = 1
                rq_n[0] = rq_n[0] + 1
              return 1
            a = a + 1
  if peek_tk(tk, p + 0) == 5 or peek_tk(tk, p + 0) == 7 or peek_tk(tk, p + 0) == 60:
    # lit-left `lit op param` (e.g. `0 <= p`); a leading Minus token folds
    # into the literal's sign (C++ UintaryMinus on an IntLit).
    var lit2: int = p
    var litneg: int = p
    if peek_tk(tk, lit2 + 0) == 60:
      lit2 = lit2 + 1
    if peek_tk(tk, lit2 + 0) == 5 or peek_tk(tk, lit2 + 0) == 7:
      var q2: int = rq_skip_nl_at(tk, n, lit2 + 1)
      var op2: int = peek_tk(tk, q2 + 0)
      if op2 == 66 or op2 == 67 or op2 == 68 or op2 == 69 or op2 == 70 or op2 == 71:
        var p2: int = rq_skip_nl_at(tk, n, q2 + 1)
        if peek_tk(tk, p2 + 0) == 4:
          var termk2: int = peek_tk(tk, p2 + 1)
          if termk2 == 1 or termk2 == 0 or termk2 == 3 or termk2 == 44 or termk2 == 45:
            var b: int = 0
            while b < rp_np[pidx]:
              if tok_eq(src, ts, te, peek256(rp_ps, pidx * 16 + b), p2 + 0) == 1:
                if rq_n[0] < 256:
                  rq_proc[rq_n[0]] = name_tok
                  rq_pi[rq_n[0]] = b
                  rq_op[rq_n[0]] = op2
                  rq_lit[rq_n[0]] = rq_lit_val(src, tk, ts, te, litneg + 0)
                  rq_left[rq_n[0]] = 0
                  rq_n[0] = rq_n[0] + 1
                return 1
              b = b + 1
  return 1

def rq_arg_lit(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], p: int, has: var array[1, int]) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  if peek_tk(tk, p + 0) == 60:
    if peek_tk(tk, p + 1) == 5:
      has[0] = 1
      return 0 - int_text_value(src, ts, te, p + 1)
    has[0] = 0
    return 0
  if peek_tk(tk, p + 0) == 5:
    has[0] = 1
    return int_text_value(src, ts, te, p + 0)
  if peek_tk(tk, p + 0) == 7:
    has[0] = 1
    return rq_lit_val(src, tk, ts, te, p + 0)
  has[0] = 0
  return 0

def rq_check_call(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], callee: int, arg_toks: var array[16, int], argc: int, rq_proc: var array[256, int], rq_pi: var array[256, int], rq_op: var array[256, int], rq_lit: var array[256, int], rq_left: var array[256, int], rq_n: var array[1, int], bp_name: var array[256, int], bp_cnt: var array[1, int], iem_src: var array[256, ptr], iem_ns: var array[256, int], iem_ne: var array[256, int], iem_vis: var array[256, int], iem_cnt: var array[1, int], iem_uq: int) raises IO -> int
  requires true
  ensures result == 1
  decreases 0
=
  # Unknown-callee gate (mir lane only): mirrors the C++ typecheck's
  # procs.end() miss — own-file decls (any visibility) + imported public
  # rows resolve; anything else latches E0202 through the shared fire slot.
  # preg 20 (any unresolved import) disables the gate entirely.
  if iem_uq == 1:
    if li_rt_preg_get(20, 0) == 0:
      var ukn: int = 0
      if seal_prelude_proc(src, ts, te, callee) == 1:
        ukn = 1
      # SIMD intrinsics: the C++ typecheck resolves these four names
      # directly in check_expr (before the procs lookup), so they are
      # known builtins for the unknown-callee gate too — without the
      # exemption the gate fired E0202 on simd_type_ok.li, which the
      # C++ host accepts (the MATCH→SKIP baseline flip it caused is the
      # regression this reverts). Exact-name roster, not a prefix rule:
      # anything else starting __li_ stays subject to the gate.
      if seal_any4(src, ts, te, callee, "__li_simd_splat_f64", "__li_simd_mul_f64", "__li_simd_add_f64", "__li_horiz_sum_f64") == 1:
        ukn = 1
      var bi4: int = 0
      while bi4 < bp_cnt[0]:
        if tok_eq(src, ts, te, peek256(bp_name, bi4), callee) == 1:
          ukn = 1
        bi4 = bi4 + 1
      var ii4: int = 0
      while ukn == 0:
        if ii4 >= iem_cnt[0]:
          break
        if iem_vis[ii4] == 1:
          if fx_span_eq(iem_src[ii4], iem_ns[ii4], iem_ne[ii4], src, peek_tk(ts, callee), peek_tk(te, callee)) == 1:
            ukn = 1
        ii4 = ii4 + 1
      if ukn == 0:
        err[0] = 1
        li_rt_emit_err(202)
        li_rt_preg_set(23, 0, 1)
  var i: int = 0
  while i < rq_n[0]:
    if tok_eq(src, ts, te, peek256(rq_proc, i), callee) == 1:
      var ap: int = peek256(rq_pi, i)
      if ap < 0:
        err[0] = 1
        li_rt_emit_err(304)
        # Fire channel for the mir lane's mir_rq_check: the shared err
        # array also latches benign scan misses, so the mir-lane verdict
        # travels in the li_rt_preg registry instead.
        li_rt_preg_set(23, 0, 1)
      else:
        if ap < argc:
          var has: array[1, int]
          var av: int = rq_arg_lit(src, tk, ts, te, arg_toks[ap], has)
          if has[0] == 1:
            var bad: int = 0
            if peek256(rq_left, i) == 1:
              bad = rq_op_violated(peek256(rq_op, i), av, peek256(rq_lit, i))
            else:
              bad = rq_op_violated(peek256(rq_op, i), peek256(rq_lit, i), av)
            if bad == 1:
              err[0] = 1
              li_rt_emit_err(304)
              li_rt_preg_set(23, 0, 1)
    i = i + 1
  return 1

def borrow_check(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int]) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  var bp_name: array[256, int]
  var bp_np: array[256, int]
  var bp_pv: array[4096, int]
  var bp_ps: array[4096, int]
  var bp_cnt: array[1, int]
  var pend: array[1, int]
  var decl: array[1, int]
  var ls_name: array[256, int]
  var ls_moved: array[256, int]
  var ls_mb: array[256, int]
  var ls_ib: array[256, int]
  var ls_n: array[1, int]
  var rp_np: array[256, int]
  var rp_ps: array[4096, int]
  var rq_proc: array[256, int]
  var rq_pi: array[256, int]
  var rq_op: array[256, int]
  var rq_lit: array[256, int]
  var rq_left: array[256, int]
  var rq_n: array[1, int]
  var iem_src: array[256, ptr]
  var iem_ns: array[256, int]
  var iem_ne: array[256, int]
  var iem_vis: array[256, int]
  var iem_cnt: array[1, int]
  var iem_uq: int = 0
  iem_cnt[0] = 0
  bp_cnt[0] = 0
  rq_n[0] = 0
  pend[0] = 0
  pi[0] = 0
  skip_newlines(tk, n, pi, err)
  while cur_kind(tk, n, pi, err) != 0:
    var k: int = cur_kind(tk, n, pi, err)
    if k == 11:
      fx_skip_typealias(src, tk, ts, te, n, pi, err)
      continue
    if k == 76:
      fx_skip_decorators(src, tk, ts, te, n, pi, err, pend)
      continue
    if k == 18:
      parse_import(src, tk, ts, te, n, pi, err, 0)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 13 or k == 12 or k == 14:
      pi[0] = pi[0] + 1
      parse_theorem(src, tk, ts, te, n, pi, err, 0, 0, 0)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 16 or k == 17:
      pi[0] = pi[0] + 1
      skip_newlines(tk, n, pi, err)
      continue
    if k == 32 or k == 10 or k == 33:
      var is_ext: int = 0
      if k == 32:
        is_ext = 1
        pi[0] = pi[0] + 1
        if cur_kind(tk, n, pi, err) == 10:
          pi[0] = pi[0] + 1
      if k == 33:
        pi[0] = pi[0] + 1
        if cur_kind(tk, n, pi, err) == 10:
          pi[0] = pi[0] + 1
      if k == 10:
        pi[0] = pi[0] + 1
      if cur_kind(tk, n, pi, err) != 4:
        err[0] = 1
        return 1
      var nm: int = pi[0]
      pi[0] = pi[0] + 1
      var idx: int = bp_cnt[0]
      if idx < 256:
        bp_name[idx] = nm
        bp_np[idx] = 0
        bp_cnt[0] = bp_cnt[0] + 1
      fx_skip_typeparams(tk, n, pi, err)
      expect_k(tk, n, pi, err, 49)
      bk_skip_params_rec(src, tk, ts, te, n, pi, err, bp_np, bp_pv, bp_ps, rp_np, rp_ps, idx)
      fx_record_raises(src, tk, ts, te, n, pi, err, decl)
      if accept_k(tk, n, pi, err, 57) == 1:
        parse_type(src, tk, ts, te, n, pi, err, 0)
      fx_record_raises(src, tk, ts, te, n, pi, err, decl)
      while 1 == 1:
        var ck: int = cur_kind(tk, n, pi, err)
        if ck == 41:
          rq_capture_clause(src, tk, ts, te, n, pi, err, idx, nm, rp_np, rp_ps, rq_proc, rq_pi, rq_op, rq_lit, rq_left, rq_n)
          parse_contract(src, tk, ts, te, n, pi, err, 0)
          continue
        if ck == 42 or ck == 43 or ck == 44 or ck == 45:
          parse_contract(src, tk, ts, te, n, pi, err, 0)
          continue
        break
      if is_ext == 0:
        skip_newlines(tk, n, pi, err)
        if accept_k(tk, n, pi, err, 58) == 1:
          skip_newlines(tk, n, pi, err)
          if cur_kind(tk, n, pi, err) == 2:
            parse_block(src, tk, ts, te, n, pi, err, 0)
      skip_newlines(tk, n, pi, err)
      continue
    err[0] = 1
    return 1
  pi[0] = 0
  pend[0] = 0
  skip_newlines(tk, n, pi, err)
  while cur_kind(tk, n, pi, err) != 0:
    var k: int = cur_kind(tk, n, pi, err)
    if k == 11:
      fx_skip_typealias(src, tk, ts, te, n, pi, err)
      continue
    if k == 76:
      fx_skip_decorators(src, tk, ts, te, n, pi, err, pend)
      continue
    if k == 18:
      parse_import(src, tk, ts, te, n, pi, err, 0)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 13 or k == 12 or k == 14:
      pi[0] = pi[0] + 1
      parse_theorem(src, tk, ts, te, n, pi, err, 0, 0, 0)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 16 or k == 17:
      pi[0] = pi[0] + 1
      skip_newlines(tk, n, pi, err)
      continue
    if k == 32 or k == 10 or k == 33:
      var is_ext: int = 0
      if k == 32:
        is_ext = 1
        pi[0] = pi[0] + 1
        if cur_kind(tk, n, pi, err) == 10:
          pi[0] = pi[0] + 1
      if k == 33:
        pi[0] = pi[0] + 1
        if cur_kind(tk, n, pi, err) == 10:
          pi[0] = pi[0] + 1
      if k == 10:
        pi[0] = pi[0] + 1
      if cur_kind(tk, n, pi, err) != 4:
        err[0] = 1
        return 1
      pi[0] = pi[0] + 1
      fx_skip_typeparams(tk, n, pi, err)
      expect_k(tk, n, pi, err, 49)
      ls_n[0] = 0
      bk_skip_params_decl(src, tk, ts, te, n, pi, err, ls_name, ls_moved, ls_mb, ls_ib, ls_n)
      fx_record_raises(src, tk, ts, te, n, pi, err, decl)
      if accept_k(tk, n, pi, err, 57) == 1:
        parse_type(src, tk, ts, te, n, pi, err, 0)
      fx_record_raises(src, tk, ts, te, n, pi, err, decl)
      while 1 == 1:
        var ck: int = cur_kind(tk, n, pi, err)
        if ck == 41 or ck == 42 or ck == 43 or ck == 44 or ck == 45:
          parse_contract(src, tk, ts, te, n, pi, err, 0)
          continue
        break
