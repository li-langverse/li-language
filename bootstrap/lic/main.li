  if k == 26:
    pi[0] = pi[0] + 1
    tc_expr(src, tk, ts, te, n, pi, err, 0, sym_s, sym_kind, sym_ty, sym_aux, sym_n)
    skip_newlines(tk, n, pi, err)
    tc_block(src, tk, ts, te, n, pi, err, cur_ret, sym_s, sym_kind, sym_ty, sym_aux, sym_n)
    return 1
  if k == 49:
    pi[0] = pi[0] + 1
    tc_expr(src, tk, ts, te, n, pi, err, 0, sym_s, sym_kind, sym_ty, sym_aux, sym_n)
    expect_k(tk, n, pi, err, 50)
    return 1
  if k == 60:
    pi[0] = pi[0] + 1
    tc_expr(src, tk, ts, te, n, pi, err, 0, sym_s, sym_kind, sym_ty, sym_aux, sym_n)
    return 1
  tc_expr(src, tk, ts, te, n, pi, err, 0, sym_s, sym_kind, sym_ty, sym_aux, sym_n)
  if accept_k(tk, n, pi, err, 58) == 1:
    tc_expr(src, tk, ts, te, n, pi, err, 0, sym_s, sym_kind, sym_ty, sym_aux, sym_n)
  return 1

def tc_block(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], cur_ret: var array[1, int], sym_s: var array[256, int], sym_kind: var array[256, int], sym_ty: var array[256, int], sym_aux: var array[256, int], sym_n: var array[1, int]) -> int
  requires true
  ensures result == 1
  decreases 0
=
  skip_newlines(tk, n, pi, err)
  if expect_k(tk, n, pi, err, 2) == 0:
    return 1
  skip_newlines(tk, n, pi, err)
  while 1 == 1:
    if cur_kind(tk, n, pi, err) == 3:
      break
    if cur_kind(tk, n, pi, err) == 0:
      break
    var before: int = pi[0]
    tc_stmt(src, tk, ts, te, n, pi, err, cur_ret, sym_s, sym_kind, sym_ty, sym_aux, sym_n)
    if pi[0] == before:
      err[0] = 1
      break
    skip_newlines(tk, n, pi, err)
  expect_k(tk, n, pi, err, 3)
  return 1

# ---- record a local/param type ----
def tc_record_local(src: var ptr, ts: var array[262144, int], te: var array[262144, int], sym_s: var array[256, int], sym_kind: var array[256, int], sym_ty: var array[256, int], sym_n: var array[1, int], i: int, t: int) -> int
  requires true
  ensures result == 0
  decreases 0
=
  var k: int = 0
  while k < sym_n[0]:
    if sym_kind[k] == 3:
      if tok_eq(src, ts, te, sym_s[k], i) == 1:
        sym_ty[k] = t
        return 0
    k = k + 1
  var ni: int = sym_n[0]
  if ni < 256:
    sym_s[ni] = i
    sym_kind[ni] = 3
    sym_ty[ni] = t
    sym_n[0] = sym_n[0] + 1
  return 0

# ---- generic type params: record `[T, U, ...]` as kind 4 (type var) ----
def tc_record_type_params(tk: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], sym_s: var array[256, int], sym_kind: var array[256, int], sym_ty: var array[256, int], sym_n: var array[1, int]) -> int
  requires true
  ensures result == 1
  decreases 0
=
  if accept_k(tk, n, pi, err, 51) == 1:
    if cur_kind(tk, n, pi, err) != 52:
      var done: int = 0
      while done == 0:
        if cur_kind(tk, n, pi, err) != 4:
          err[0] = 1
          break
        var tp: int = sym_n[0]
        if tp < 256:
          sym_s[tp] = pi[0]
          sym_kind[tp] = 4
          sym_ty[tp] = 13        sym_n[0] = sym_n[0] + 1
        pi[0] = pi[0] + 1
        if accept_k(tk, n, pi, err, 56) == 1:
          if cur_kind(tk, n, pi, err) == 4:
            pi[0] = pi[0] + 1
          else:
            err[0] = 1
        if accept_k(tk, n, pi, err, 55) == 1:
          done = 0
        else:
          done = 1
    expect_k(tk, n, pi, err, 52)
  return 1




# ---- consume an optional `raises A, B, ...` clause ----
def tc_skip_raises(tk: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int]) -> int
  requires true
  ensures result == 1
  decreases 0
=
  skip_newlines(tk, n, pi, err)
  if cur_kind(tk, n, pi, err) == 31:
    pi[0] = pi[0] + 1
    if cur_kind(tk, n, pi, err) == 4:
      var rdone: int = 0
      while rdone == 0:
        pi[0] = pi[0] + 1
        if accept_k(tk, n, pi, err, 55) == 1:
          rdone = 0
        else:
          rdone = 1
  skip_newlines(tk, n, pi, err)
  return 1

# ---- proc signature collection (pass 1) ----
def tc_record_proc(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], is_extern: int, sym_s: var array[256, int], sym_kind: var array[256, int], sym_ty: var array[256, int], sym_aux: var array[256, int], sym_n: var array[1, int]) -> int
  requires true
  ensures result == 1
  decreases 0
=
  if cur_kind(tk, n, pi, err) != 4:
    err[0] = 1
    return 1
  var nm: int = pi[0]
  pi[0] = pi[0] + 1
  var si: int = sym_n[0]
  if si < 256:
    sym_s[si] = nm
    sym_kind[si] = 1
    sym_n[0] = sym_n[0] + 1
  tc_record_type_params(tk, n, pi, err, sym_s, sym_kind, sym_ty, sym_n)
  expect_k(tk, n, pi, err, 49)
  skip_param_layout(tk, n, pi, err)
  var argc: int = 0
  if cur_kind(tk, n, pi, err) != 50:
    var done: int = 0
    while done == 0:
      skip_param_layout(tk, n, pi, err)
      if cur_kind(tk, n, pi, err) != 4:
        err[0] = 1
      else:
        pi[0] = pi[0] + 1
        expect_k(tk, n, pi, err, 56)
        tc_parse_type(src, tk, ts, te, n, pi, err, sym_s, sym_kind, sym_ty, sym_n)
        argc = argc + 1
      skip_param_layout(tk, n, pi, err)
      if accept_k(tk, n, pi, err, 55) == 1:
        done = 0
      else:
        done = 1
  skip_param_layout(tk, n, pi, err)
  expect_k(tk, n, pi, err, 50)
  tc_skip_raises(tk, n, pi, err)
  var ret: int = 6
  if accept_k(tk, n, pi, err, 57) == 1:
    ret = tc_parse_type(src, tk, ts, te, n, pi, err, sym_s, sym_kind, sym_ty, sym_n)
  if si < 256:
    sym_aux[si] = argc
    sym_ty[si] = ret
  return 1

# ---- pass 1 tail skip: contracts (and body for non-extern procs) ----
def tc_skip_proc_tail(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], is_extern: int) -> int
  requires true
  ensures result == 1
  decreases 0
=
  skip_newlines(tk, n, pi, err)
  tc_skip_raises(tk, n, pi, err)
  while 1 == 1:
    var ck: int = cur_kind(tk, n, pi, err)
    if ck == 41 or ck == 42 or ck == 43 or ck == 44 or ck == 45:
      parse_contract(src, tk, ts, te, n, pi, err, 0)
      continue
    break
  if is_extern == 0:
    skip_newlines(tk, n, pi, err)
    if accept_k(tk, n, pi, err, 58) == 1:
      skip_newlines(tk, n, pi, err)
      if cur_kind(tk, n, pi, err) == 2:
        parse_block(src, tk, ts, te, n, pi, err, 0)
  return 1

# ---- contract collection + well-formedness (E0301/2/3) ----
def tc_collect_contracts(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], is_extern: int, ret_ty: int, sym_s: var array[256, int], sym_kind: var array[256, int], sym_ty: var array[256, int], sym_aux: var array[256, int], sym_n: var array[1, int]) -> int
  requires true
  ensures result == 1
  decreases 0
=
  var has_req: int = 0
  var has_ens: int = 0
  var weak_ens: int = 0
  while 1 == 1:
    skip_newlines(tk, n, pi, err)
    var ck: int = cur_kind(tk, n, pi, err)
    if ck == 41:
      has_req = 1
      pi[0] = pi[0] + 1
      parse_contract_expr(src, tk, ts, te, n, pi, err, 0)
      continue
    if ck == 42:
      has_ens = 1
      pi[0] = pi[0] + 1
      if cur_kind(tk, n, pi, err) == 35:
        if peek_off(tk, n, pi, 1) == 1:
          weak_ens = 1
      parse_contract_expr(src, tk, ts, te, n, pi, err, 0)
      continue
    if ck == 43 or ck == 44 or ck == 45:
      pi[0] = pi[0] + 1
      parse_contract_expr(src, tk, ts, te, n, pi, err, 0)
      continue
    break
  if has_req == 0:
    err[0] = 1
    li_rt_emit_err(301)
  if has_ens == 0:
    err[0] = 1
    li_rt_emit_err(302)
  if is_extern == 0:
    if weak_ens == 1:
      if ret_ty != 6:
        err[0] = 1
        li_rt_emit_err(303)
  return 1

# ---- pass 2: check a proc body ----
def tc_check_proc_body(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], ret_ty: int, cur_ret: var array[1, int], sym_s: var array[256, int], sym_kind: var array[256, int], sym_ty: var array[256, int], sym_aux: var array[256, int], sym_n: var array[1, int]) -> int
  requires true
  ensures result == 1
  decreases 0
=
  cur_ret[0] = ret_ty
  skip_newlines(tk, n, pi, err)
  if accept_k(tk, n, pi, err, 58) == 1:
    skip_newlines(tk, n, pi, err)
    tc_block(src, tk, ts, te, n, pi, err, cur_ret, sym_s, sym_kind, sym_ty, sym_aux, sym_n)
  return 1

# ---- skip a param in pass 2 (types already recorded in pass 1) ----
def tc_skip_param(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], sym_s: var array[256, int], sym_kind: var array[256, int], sym_ty: var array[256, int], sym_n: var array[1, int]) -> int
  requires true
  ensures result == 1
  decreases 0
=
  skip_param_layout(tk, n, pi, err)
  if cur_kind(tk, n, pi, err) != 4:
    err[0] = 1
    return 1
  pi[0] = pi[0] + 1
  expect_k(tk, n, pi, err, 56)
  tc_parse_type(src, tk, ts, te, n, pi, err, sym_s, sym_kind, sym_ty, sym_n)
  return 1

def tc_record_param(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], sym_s: var array[256, int], sym_kind: var array[256, int], sym_ty: var array[256, int], sym_n: var array[1, int]) -> int
  requires true
  ensures result == 1
  decreases 0
=
  skip_param_layout(tk, n, pi, err)
  if cur_kind(tk, n, pi, err) != 4:
    err[0] = 1
    return 1
  var pn: int = pi[0]
  pi[0] = pi[0] + 1
  expect_k(tk, n, pi, err, 56)
  var pt: int = tc_parse_type(src, tk, ts, te, n, pi, err, sym_s, sym_kind, sym_ty, sym_n)
  var pl: int = sym_n[0]
  if pl < 256:
    sym_s[pl] = pn
    sym_kind[pl] = 2
    sym_ty[pl] = pt
    sym_n[0] = sym_n[0] + 1
  return 1

# ---- top-level: collect types + procs, then check each proc ----
def check_source(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int]) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  var sym_s: array[256, int]
  var sym_kind: array[256, int]
  var sym_ty: array[256, int]
  var sym_aux: array[256, int]
  var sym_n: array[1, int]
  var cur_ret: array[1, int]
  sym_n[0] = 0
  skip_newlines(tk, n, pi, err)
  while cur_kind(tk, n, pi, err) != 0:
    var k: int = cur_kind(tk, n, pi, err)
    if k == 11:
      pi[0] = pi[0] + 1
      if cur_kind(tk, n, pi, err) != 4:
        err[0] = 1
        return 1
      var tn: int = pi[0]
      pi[0] = pi[0] + 1
      tc_record_type_params(tk, n, pi, err, sym_s, sym_kind, sym_ty, sym_n)
      expect_k(tk, n, pi, err, 58)
      var rt: int = tc_skip_alias_rhs(src, tk, ts, te, n, pi, err, sym_s, sym_kind, sym_ty, sym_n)
      var ti: int = sym_n[0]
      if ti < 256:
        sym_s[ti] = tn
        sym_kind[ti] = 0
        sym_ty[ti] = rt
        sym_n[0] = sym_n[0] + 1
      skip_newlines(tk, n, pi, err)
      continue
    if k == 10:
      pi[0] = pi[0] + 1
      tc_record_proc(src, tk, ts, te, n, pi, err, 0, sym_s, sym_kind, sym_ty, sym_aux, sym_n)
      tc_skip_proc_tail(src, tk, ts, te, n, pi, err, 0)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 32:
      pi[0] = pi[0] + 1
      if cur_kind(tk, n, pi, err) == 10:
        pi[0] = pi[0] + 1
        tc_record_proc(src, tk, ts, te, n, pi, err, 1, sym_s, sym_kind, sym_ty, sym_aux, sym_n)
      tc_skip_proc_tail(src, tk, ts, te, n, pi, err, 1)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 33:
      pi[0] = pi[0] + 1
      if cur_kind(tk, n, pi, err) == 10:
        pi[0] = pi[0] + 1
      tc_record_proc(src, tk, ts, te, n, pi, err, 0, sym_s, sym_kind, sym_ty, sym_aux, sym_n)
      tc_skip_proc_tail(src, tk, ts, te, n, pi, err, 0)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 76:
      parse_decorator_list(src, tk, ts, te, n, pi, err, 0)
      continue
    if k == 18:
      parse_import(src, tk, ts, te, n, pi, err, 0)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 13 or k == 12 or k == 14:
      parse_theorem(src, tk, ts, te, n, pi, err, 0, 0, 0)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 16 or k == 17:
      pi[0] = pi[0] + 1
      continue
    err[0] = 1
    return 1
  pi[0] = 0
  skip_newlines(tk, n, pi, err)
  while cur_kind(tk, n, pi, err) != 0:
    var k: int = cur_kind(tk, n, pi, err)
    if k == 32:
      pi[0] = pi[0] + 1
      if cur_kind(tk, n, pi, err) == 10:
        pi[0] = pi[0] + 1
        if cur_kind(tk, n, pi, err) != 4:
          err[0] = 1
          return 1
        pi[0] = pi[0] + 1
        fx_skip_typeparams(tk, n, pi, err)
        expect_k(tk, n, pi, err, 49)
        skip_param_layout(tk, n, pi, err)
        if cur_kind(tk, n, pi, err) != 50:
          var done: int = 0
          while done == 0:
            tc_skip_param(src, tk, ts, te, n, pi, err, sym_s, sym_kind, sym_ty, sym_n)
            if accept_k(tk, n, pi, err, 55) == 1:
              done = 0
            else:
              done = 1
        skip_param_layout(tk, n, pi, err)
        expect_k(tk, n, pi, err, 50)
        tc_skip_raises(tk, n, pi, err)
        var ret2: int = 6
        if accept_k(tk, n, pi, err, 57) == 1:
          ret2 = tc_parse_type(src, tk, ts, te, n, pi, err, sym_s, sym_kind, sym_ty, sym_n)
        tc_skip_raises(tk, n, pi, err)
        tc_collect_contracts(src, tk, ts, te, n, pi, err, 1, ret2, sym_s, sym_kind, sym_ty, sym_aux, sym_n)
        skip_newlines(tk, n, pi, err)
        continue
    if k == 10 or k == 33:
      pi[0] = pi[0] + 1
      if k == 33:
        if cur_kind(tk, n, pi, err) == 10:
          pi[0] = pi[0] + 1
      if cur_kind(tk, n, pi, err) != 4:
        err[0] = 1
        return 1
      pi[0] = pi[0] + 1
      fx_skip_typeparams(tk, n, pi, err)
      expect_k(tk, n, pi, err, 49)
      skip_param_layout(tk, n, pi, err)
      if cur_kind(tk, n, pi, err) != 50:
        var done: int = 0
        while done == 0:
          tc_record_param(src, tk, ts, te, n, pi, err, sym_s, sym_kind, sym_ty, sym_n)
          if accept_k(tk, n, pi, err, 55) == 1:
            done = 0
          else:
            done = 1
      skip_param_layout(tk, n, pi, err)
      expect_k(tk, n, pi, err, 50)
      tc_skip_raises(tk, n, pi, err)
      var ret3: int = 6
      if accept_k(tk, n, pi, err, 57) == 1:
        ret3 = tc_parse_type(src, tk, ts, te, n, pi, err, sym_s, sym_kind, sym_ty, sym_n)
      tc_skip_raises(tk, n, pi, err)
      tc_collect_contracts(src, tk, ts, te, n, pi, err, 0, ret3, sym_s, sym_kind, sym_ty, sym_aux, sym_n)
      skip_newlines(tk, n, pi, err)
      tc_check_proc_body(src, tk, ts, te, n, pi, err, ret3, cur_ret, sym_s, sym_kind, sym_ty, sym_aux, sym_n)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 11:
      pi[0] = pi[0] + 1
      if cur_kind(tk, n, pi, err) != 4:
        err[0] = 1
        return 1
      pi[0] = pi[0] + 1
      if accept_k(tk, n, pi, err, 51) == 1:
        if cur_kind(tk, n, pi, err) != 52:
          var done: int = 0
          while done == 0:
            if cur_kind(tk, n, pi, err) == 4:
              pi[0] = pi[0] + 1
            if accept_k(tk, n, pi, err, 55) == 1:
              done = 0
            else:
              done = 1
        expect_k(tk, n, pi, err, 52)
      expect_k(tk, n, pi, err, 58)
      tc_skip_alias_rhs(src, tk, ts, te, n, pi, err, sym_s, sym_kind, sym_ty, sym_n)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 76:
      parse_decorator_list(src, tk, ts, te, n, pi, err, 0)
      continue
    if k == 18:
      parse_import(src, tk, ts, te, n, pi, err, 0)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 13 or k == 12 or k == 14:
      parse_theorem(src, tk, ts, te, n, pi, err, 0, 0, 0)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 16 or k == 17:
      pi[0] = pi[0] + 1
      continue
    err[0] = 1
    return 1
  if err[0] == 1:
    return 1
  return 0

# ---- Layer 4b: effect checking (raises IO / Alloc / Net / Async) ----
# Effect bits: IO=1, Alloc=2, Net=4, Async=8 (bitmask; each added once).
def fx_eff_bit(src: var ptr, ts: var array[262144, int], te: var array[262144, int], i: int) -> int
  requires true
  ensures result >= 0
  decreases 0
=
  if tok_is(src, ts, te, i, "IO") == 1:
    return 1
  if tok_is(src, ts, te, i, "Alloc") == 1:
    return 2
  if tok_is(src, ts, te, i, "Net") == 1:
    return 4
  if tok_is(src, ts, te, i, "Async") == 1:
    return 8
  return 0

def fx_has_eff(m: int, b: int) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  if b == 0:
    return 0
  if (m // b) % 2 == 1:
    return 1
  return 0

def fx_add_eff(used: var array[1, int], b: int) -> int
  requires true
  ensures result == 0
  decreases 0
=
  if b > 0:
    if fx_has_eff(used[0], b) == 0:
      used[0] = used[0] + b
  return 0

def fx_is_heap(src: var ptr, ts: var array[262144, int], te: var array[262144, int], i: int) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  if tok_is(src, ts, te, i, "list") == 1:
    return 1
  if tok_is(src, ts, te, i, "dict") == 1:
    return 1
  if tok_is(src, ts, te, i, "set") == 1:
    return 1
  if tok_is(src, ts, te, i, "str") == 1:
    return 1
  if tok_is(src, ts, te, i, "bytes") == 1:
    return 1
  if tok_is(src, ts, te, i, "stringview") == 1:
    return 1
  if tok_is(src, ts, te, i, "Bytes") == 1:
    return 1
  if tok_is(src, ts, te, i, "StringView") == 1:
    return 1
  return 0

def fx_proc_ext(src: var ptr, ts: var array[262144, int], te: var array[262144, int], pn: var array[256, int], pext: var array[256, int], pcnt: var array[1, int], name_tok: int) -> int
  requires true
  ensures result >= -1
  decreases 0
=
  var k: int = 0
  while k < pcnt[0]:
    if tok_eq(src, ts, te, pn[k], name_tok) == 1:
      return pext[k]
    k = k + 1
  return -1

def fx_proc_eff(src: var ptr, ts: var array[262144, int], te: var array[262144, int], pn: var array[256, int], peff: var array[256, int], pcnt: var array[1, int], name_tok: int) -> int
  requires true
  ensures result >= -1
  decreases 0
=
  var k: int = 0
  while k < pcnt[0]:
    if tok_eq(src, ts, te, pn[k], name_tok) == 1:
      return peff[k]
    k = k + 1
  return -1

def fx_skip_typeparams(tk: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int]) -> int
  requires true
  ensures result == 1
  decreases 0
=
  if accept_k(tk, n, pi, err, 51) == 1:
    if cur_kind(tk, n, pi, err) != 52:
      var done: int = 0
      while done == 0:
        pi[0] = pi[0] + 1
        if accept_k(tk, n, pi, err, 56) == 1:
          if cur_kind(tk, n, pi, err) == 4:
            pi[0] = pi[0] + 1
        if accept_k(tk, n, pi, err, 55) == 1:
          done = 0
        else:
          done = 1
    expect_k(tk, n, pi, err, 52)
  return 1

def fx_skip_params(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], heap: var array[1, int]) -> int
  requires true
  ensures result == 1
  decreases 0
=
  skip_param_layout(tk, n, pi, err)
  if cur_kind(tk, n, pi, err) != 50:
    var done: int = 0
    while done == 0:
      skip_param_layout(tk, n, pi, err)
      if cur_kind(tk, n, pi, err) == 4:
        pi[0] = pi[0] + 1
        expect_k(tk, n, pi, err, 56)
        if cur_kind(tk, n, pi, err) == 4:
          if fx_is_heap(src, ts, te, pi[0]) == 1:
            heap[0] = 1
        parse_type(src, tk, ts, te, n, pi, err, 0)
      skip_param_layout(tk, n, pi, err)
      if accept_k(tk, n, pi, err, 55) == 1:
        done = 0
      else:
        done = 1
  skip_param_layout(tk, n, pi, err)
  expect_k(tk, n, pi, err, 50)
  return 1

def fx_record_raises(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], decl: var array[1, int]) -> int
  requires true
  ensures result == 1
  decreases 0
=
  skip_newlines(tk, n, pi, err)
  if cur_kind(tk, n, pi, err) == 31:
    pi[0] = pi[0] + 1
    if cur_kind(tk, n, pi, err) == 4:
      var done: int = 0
      while done == 0:
        var b: int = fx_eff_bit(src, ts, te, pi[0])
        fx_add_eff(decl, b)
        pi[0] = pi[0] + 1
        if accept_k(tk, n, pi, err, 55) == 1:
          done = 0
        else:
          done = 1
  skip_newlines(tk, n, pi, err)
  return 1

def fx_skip_decorators(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], pend: var array[1, int]) -> int
  requires true
  ensures result == 1
  decreases 0
=
  pend[0] = 0
  while cur_kind(tk, n, pi, err) == 76:
    pi[0] = pi[0] + 1
    if cur_kind(tk, n, pi, err) == 33:
      pend[0] = 1
    if cur_kind(tk, n, pi, err) == 4 or cur_kind(tk, n, pi, err) == 33:
      pi[0] = pi[0] + 1
    if accept_k(tk, n, pi, err, 49) == 1:
      if cur_kind(tk, n, pi, err) != 50:
        var done: int = 0
        while done == 0:
          parse_expr(src, tk, ts, te, n, pi, err, 0, 0)
          if accept_k(tk, n, pi, err, 55) == 1:
            done = 0
          else:
            done = 1
      expect_k(tk, n, pi, err, 50)
    skip_newlines(tk, n, pi, err)
  return 1

def fx_skip_typealias(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int]) -> int
  requires true
  ensures result == 1
  decreases 0
=
  return parse_type_alias(src, tk, ts, te, n, pi, err, 0)

def fx_scan_expr(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], pn: var array[256, int], peff: var array[256, int], pext: var array[256, int], pcnt: var array[1, int], used: var array[1, int], await_seen: var array[1, int]) -> int
  requires true
  ensures result == 1
  decreases 0
=
  var depth: int = 0
  while 1 == 1:
    var k: int = cur_kind(tk, n, pi, err)
    if depth == 0:
      if k == 1 or k == 3 or k == 0 or k == 56 or k == 55:
        break
    if k == 49 or k == 51 or k == 53:
      depth = depth + 1
    if k == 50 or k == 52 or k == 54:
      depth = depth - 1
    if k == 34:
      await_seen[0] = 1
    if k == 4:
      if peek_off(tk, n, pi, 1) == 49:
        if tok_is(src, ts, te, pi[0], "print") == 1:
          fx_add_eff(used, 1)
        if fx_proc_ext(src, ts, te, pn, pext, pcnt, pi[0]) == 1:
          fx_add_eff(used, 1)
        var cf: int = fx_proc_eff(src, ts, te, pn, peff, pcnt, pi[0])
        if cf >= 0:
          if fx_has_eff(cf, 4) == 1:
            fx_add_eff(used, 4)
          if fx_has_eff(cf, 8) == 1:
            fx_add_eff(used, 8)
    pi[0] = pi[0] + 1
  return 1

def fx_scan_block(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], pn: var array[256, int], peff: var array[256, int], pext: var array[256, int], pcnt: var array[1, int], used: var array[1, int], await_seen: var array[1, int]) -> int
  requires true
  ensures result == 1
  decreases 0
=
  skip_newlines(tk, n, pi, err)
  if expect_k(tk, n, pi, err, 2) == 0:
    return 1
  skip_newlines(tk, n, pi, err)
  while 1 == 1:
    if cur_kind(tk, n, pi, err) == 3:
      break
    if cur_kind(tk, n, pi, err) == 0:
      break
    var before: int = pi[0]
    fx_scan_stmt(src, tk, ts, te, n, pi, err, pn, peff, pext, pcnt, used, await_seen)
    if pi[0] == before:
      break
    skip_newlines(tk, n, pi, err)
  expect_k(tk, n, pi, err, 3)
  return 1

def fx_scan_stmt(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], pn: var array[256, int], peff: var array[256, int], pext: var array[256, int], pcnt: var array[1, int], used: var array[1, int], await_seen: var array[1, int]) -> int
  requires true
  ensures result == 1
  decreases 0
=
  var k: int = cur_kind(tk, n, pi, err)
  if k == 20:
    pi[0] = pi[0] + 1
    if cur_kind(tk, n, pi, err) == 4:
      pi[0] = pi[0] + 1
    if accept_k(tk, n, pi, err, 56) == 1:
      parse_type(src, tk, ts, te, n, pi, err, 0)
    if accept_k(tk, n, pi, err, 58) == 1:
      parse_expr(src, tk, ts, te, n, pi, err, 0, 0)
    return 1
  if k == 30:
    pi[0] = pi[0] + 1
    if cur_kind(tk, n, pi, err) != 1:
      fx_scan_expr(src, tk, ts, te, n, pi, err, pn, peff, pext, pcnt, used, await_seen)
    return 1
  if k == 22:
    pi[0] = pi[0] + 1
    fx_scan_expr(src, tk, ts, te, n, pi, err, pn, peff, pext, pcnt, used, await_seen)
    expect_k(tk, n, pi, err, 56)
    skip_newlines(tk, n, pi, err)
    fx_scan_block(src, tk, ts, te, n, pi, err, pn, peff, pext, pcnt, used, await_seen)
    while cur_kind(tk, n, pi, err) == 24:
      pi[0] = pi[0] + 1
      fx_scan_expr(src, tk, ts, te, n, pi, err, pn, peff, pext, pcnt, used, await_seen)
      expect_k(tk, n, pi, err, 56)
      skip_newlines(tk, n, pi, err)
      fx_scan_block(src, tk, ts, te, n, pi, err, pn, peff, pext, pcnt, used, await_seen)
    if cur_kind(tk, n, pi, err) == 23:
      pi[0] = pi[0] + 1
      expect_k(tk, n, pi, err, 56)
      skip_newlines(tk, n, pi, err)
      fx_scan_block(src, tk, ts, te, n, pi, err, pn, peff, pext, pcnt, used, await_seen)
    return 1
  if k == 25:
    pi[0] = pi[0] + 1
    fx_scan_expr(src, tk, ts, te, n, pi, err, pn, peff, pext, pcnt, used, await_seen)
    if cur_kind(tk, n, pi, err) == 56:
      pi[0] = pi[0] + 1
    skip_newlines(tk, n, pi, err)
    fx_scan_block(src, tk, ts, te, n, pi, err, pn, peff, pext, pcnt, used, await_seen)
    return 1
  if k == 26:
    pi[0] = pi[0] + 1
    fx_scan_expr(src, tk, ts, te, n, pi, err, pn, peff, pext, pcnt, used, await_seen)
    skip_newlines(tk, n, pi, err)
    fx_scan_block(src, tk, ts, te, n, pi, err, pn, peff, pext, pcnt, used, await_seen)
    return 1
  fx_scan_expr(src, tk, ts, te, n, pi, err, pn, peff, pext, pcnt, used, await_seen)
  if accept_k(tk, n, pi, err, 58) == 1:
    fx_scan_expr(src, tk, ts, te, n, pi, err, pn, peff, pext, pcnt, used, await_seen)
  return 1

def effects_check(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int]) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  var pn: array[256, int]
  var peff: array[256, int]
  var pext: array[256, int]
  var pcnt: array[1, int]
  var pend: array[1, int]
  var decl: array[1, int]
  var heap: array[1, int]
  var used: array[1, int]
  var await_seen: array[1, int]
  pcnt[0] = 0
  pend[0] = 0
  pi[0] = 0
  skip_newlines(tk, n, pi, err)
  while cur_kind(tk, n, pi, err) != 0:
    var k: int = cur_kind(tk, n, pi, err)
    if k == 11:
      fx_skip_typealias(src, tk, ts, te, n, pi, err)
      continue
    if k == 76:
      fx_skip_decorators(src, tk, ts, te, n, pi, err, pend)
      continue
    if k == 18:
      parse_import(src, tk, ts, te, n, pi, err, 0)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 13 or k == 12 or k == 14:
      parse_theorem(src, tk, ts, te, n, pi, err, 0, 0, 0)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 16 or k == 17:
      pi[0] = pi[0] + 1
      skip_newlines(tk, n, pi, err)
      continue
    if k == 32 or k == 10 or k == 33:
      var is_ext: int = 0
      var is_asy: int = pend[0]
      pend[0] = 0
      if k == 32:
        is_ext = 1
        pi[0] = pi[0] + 1
        if cur_kind(tk, n, pi, err) == 10:
          pi[0] = pi[0] + 1
      if k == 33:
        is_asy = 1
        pi[0] = pi[0] + 1
        if cur_kind(tk, n, pi, err) == 10:
          pi[0] = pi[0] + 1
      if k == 10:
        pi[0] = pi[0] + 1
      if cur_kind(tk, n, pi, err) != 4:
        err[0] = 1
        return 1
      var nm: int = pi[0]
      pi[0] = pi[0] + 1
      var idx: int = pcnt[0]
      if idx < 256:
        pn[idx] = nm
        pext[idx] = is_ext
        peff[idx] = 0
        pcnt[0] = pcnt[0] + 1
      fx_skip_typeparams(tk, n, pi, err)
      expect_k(tk, n, pi, err, 49)
      decl[0] = 0
      heap[0] = 0
      fx_skip_params(src, tk, ts, te, n, pi, err, heap)
      fx_record_raises(src, tk, ts, te, n, pi, err, decl)
      if accept_k(tk, n, pi, err, 57) == 1:
        if cur_kind(tk, n, pi, err) == 4:
          if fx_is_heap(src, ts, te, pi[0]) == 1:
            heap[0] = 1
        parse_type(src, tk, ts, te, n, pi, err, 0)
      fx_record_raises(src, tk, ts, te, n, pi, err, decl)
      if idx < 256:
        peff[idx] = decl[0]
      while 1 == 1:
        var ck: int = cur_kind(tk, n, pi, err)
        if ck == 41 or ck == 42 or ck == 43 or ck == 44 or ck == 45:
          parse_contract(src, tk, ts, te, n, pi, err, 0)
          continue
        break
      if is_ext == 0:
        skip_newlines(tk, n, pi, err)
        if accept_k(tk, n, pi, err, 58) == 1:
          skip_newlines(tk, n, pi, err)
          if cur_kind(tk, n, pi, err) == 2:
            parse_block(src, tk, ts, te, n, pi, err, 0)
      skip_newlines(tk, n, pi, err)
      continue
    err[0] = 1
    return 1
  pi[0] = 0
  pend[0] = 0
  skip_newlines(tk, n, pi, err)
  while cur_kind(tk, n, pi, err) != 0:
    var k: int = cur_kind(tk, n, pi, err)
    if k == 11:
      fx_skip_typealias(src, tk, ts, te, n, pi, err)
      continue
    if k == 76:
      fx_skip_decorators(src, tk, ts, te, n, pi, err, pend)
      continue
    if k == 18:
      parse_import(src, tk, ts, te, n, pi, err, 0)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 13 or k == 12 or k == 14:
      parse_theorem(src, tk, ts, te, n, pi, err, 0, 0, 0)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 16 or k == 17:
      pi[0] = pi[0] + 1
      skip_newlines(tk, n, pi, err)
      continue
    if k == 32 or k == 10 or k == 33:
      var is_ext: int = 0
      var is_asy: int = pend[0]
      pend[0] = 0
      if k == 32:
        is_ext = 1
        pi[0] = pi[0] + 1
        if cur_kind(tk, n, pi, err) == 10:
          pi[0] = pi[0] + 1
      if k == 33:
        is_asy = 1
        pi[0] = pi[0] + 1
        if cur_kind(tk, n, pi, err) == 10:
          pi[0] = pi[0] + 1
      if k == 10:
        pi[0] = pi[0] + 1
      if cur_kind(tk, n, pi, err) != 4:
        err[0] = 1
        return 1
      pi[0] = pi[0] + 1
      fx_skip_typeparams(tk, n, pi, err)
      expect_k(tk, n, pi, err, 49)
      decl[0] = 0
      heap[0] = 0
      fx_skip_params(src, tk, ts, te, n, pi, err, heap)
      fx_record_raises(src, tk, ts, te, n, pi, err, decl)
      if accept_k(tk, n, pi, err, 57) == 1:
        if cur_kind(tk, n, pi, err) == 4:
          if fx_is_heap(src, ts, te, pi[0]) == 1:
            heap[0] = 1
        parse_type(src, tk, ts, te, n, pi, err, 0)
      fx_record_raises(src, tk, ts, te, n, pi, err, decl)
      while 1 == 1:
        var ck: int = cur_kind(tk, n, pi, err)
        if ck == 41 or ck == 42 or ck == 43 or ck == 44 or ck == 45:
          parse_contract(src, tk, ts, te, n, pi, err, 0)
          continue
        break
      if is_ext == 0:
        used[0] = 0
        await_seen[0] = 0
        skip_newlines(tk, n, pi, err)
        if accept_k(tk, n, pi, err, 58) == 1:
          skip_newlines(tk, n, pi, err)
          fx_scan_block(src, tk, ts, te, n, pi, err, pn, peff, pext, pcnt, used, await_seen)
        if heap[0] == 1:
          if fx_has_eff(decl[0], 2) == 0:
            err[0] = 1
            li_rt_emit_err(900)
        if await_seen[0] == 1:
          if is_asy == 0:
            err[0] = 1
            li_rt_emit_err(900)
        if is_asy == 1:
          if fx_has_eff(decl[0], 8) == 0:
            err[0] = 1
            li_rt_emit_err(900)
        if fx_has_eff(used[0], 1) == 1:
          if fx_has_eff(decl[0], 1) == 0:
            err[0] = 1
            li_rt_emit_err(900)
        if fx_has_eff(used[0], 4) == 1:
          if fx_has_eff(decl[0], 4) == 0:
            err[0] = 1
            li_rt_emit_err(900)
        if fx_has_eff(used[0], 8) == 1:
          if fx_has_eff(decl[0], 8) == 0:
            err[0] = 1
            li_rt_emit_err(900)
      skip_newlines(tk, n, pi, err)
      continue
    err[0] = 1
    return 1
  return 0

# ---- Layer 4c: borrow checking (E0310 double-mut, E0311 use-after-move) ----
# Mirrors compiler/types/borrowck.cpp. A plain-ident call argument moves the
# local iff the callee parameter is non-`var` and non-scalar; reading a moved
# local is E0311, and reading a value with an active `borrow mut` (or taking a
# second borrow) is E0310.

type Pos256 = {p: int | 0 <= p and p < 256}

def peek256(buf: var array[256, int], p: Pos256) -> int
  requires true
  ensures result == buf[p]
  decreases 0
=
  return buf[p]

def set256(buf: var array[256, int], p: Pos256, v: int) -> int
  requires true
  ensures result == v
  decreases 0
=
  buf[p] = v
  return v

def bk_scalar_name(src: var ptr, ts: var array[262144, int], te: var array[262144, int], i: int) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  if tok_is(src, ts, te, i, "int") == 1:
    return 1
  if tok_is(src, ts, te, i, "float") == 1:
    return 1
  if tok_is(src, ts, te, i, "i64") == 1:
    return 1
  if tok_is(src, ts, te, i, "int64") == 1:
    return 1
  if tok_is(src, ts, te, i, "bool") == 1:
    return 1
  if tok_is(src, ts, te, i, "f32") == 1:
    return 1
  if tok_is(src, ts, te, i, "f64") == 1:
    return 1
  if tok_is(src, ts, te, i, "u32") == 1:
    return 1
  if tok_is(src, ts, te, i, "u64") == 1:
    return 1
  if tok_is(src, ts, te, i, "unit") == 1:
    return 1
  return 0

def bk_proc_index(src: var ptr, ts: var array[262144, int], te: var array[262144, int], bp_name: var array[256, int], bp_cnt: var array[1, int], name_tok: int) -> int
  requires true
  ensures result >= -1
  decreases 0
=
  var k: int = 0
  while k < bp_cnt[0]:
    if tok_eq(src, ts, te, bp_name[k], name_tok) == 1:
      return k
    k = k + 1
  return -1

def bk_param_moves(bp_np: var array[256, int], bp_pv: var array[4096, int], bp_ps: var array[4096, int], pidx: int, j: int) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  if j >= peek256(bp_np, pidx + 0):
    return 0
  if peek4096(bp_pv, pidx * 16 + j) == 1:
    return 0
  if peek4096(bp_ps, pidx * 16 + j) == 1:
    return 0
  return 1

def bk_check_use(src: var ptr, ts: var array[262144, int], te: var array[262144, int], ls_name: var array[256, int], ls_moved: var array[256, int], ls_mb: var array[256, int], ls_n: var array[1, int], name_tok: int, err: var array[1, int]) -> int
  requires true
  ensures result == 0
  decreases 0
=
  var k: int = 0
  while k < ls_n[0]:
    if tok_eq(src, ts, te, ls_name[k], name_tok) == 1:
      if ls_moved[k] == 1:
        err[0] = 1
        li_rt_emit_err(311)
        return 0
      if ls_mb[k] > 0:
        err[0] = 1
        li_rt_emit_err(310)
      return 0
    k = k + 1
  return 0

def bk_mark_moved(src: var ptr, ts: var array[262144, int], te: var array[262144, int], ls_name: var array[256, int], ls_moved: var array[256, int], ls_n: var array[1, int], name_tok: int) -> int
  requires true
  ensures result == 0
  decreases 0
=
  var k: int = 0
  while k < ls_n[0]:
    if tok_eq(src, ts, te, ls_name[k], name_tok) == 1:
      ls_moved[k] = 1
      return 0
    k = k + 1
  return 0

def bk_check_expr(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], min_prec: int, bp_name: var array[256, int], bp_np: var array[256, int], bp_pv: var array[4096, int], bp_ps: var array[4096, int], bp_cnt: var array[1, int], ls_name: var array[256, int], ls_moved: var array[256, int], ls_mb: var array[256, int], ls_n: var array[1, int]) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  if cur_kind(tk, n, pi, err) == 39:
    pi[0] = pi[0] + 1
    return bk_check_expr(src, tk, ts, te, n, pi, err, 100, bp_name, bp_np, bp_pv, bp_ps, bp_cnt, ls_name, ls_moved, ls_mb, ls_n)
  if cur_kind(tk, n, pi, err) == 60:
    pi[0] = pi[0] + 1
  if bk_check_primary(src, tk, ts, te, n, pi, err, bp_name, bp_np, bp_pv, bp_ps, bp_cnt, ls_name, ls_moved, ls_mb, ls_n) == 0:
    return 0
  while 1 == 1:
    var p: int = prec_of(cur_kind(tk, n, pi, err))
    if p < 0:
      break
    if p < min_prec:
      break
    pi[0] = pi[0] + 1
    if bk_check_expr(src, tk, ts, te, n, pi, err, p + 1, bp_name, bp_np, bp_pv, bp_ps, bp_cnt, ls_name, ls_moved, ls_mb, ls_n) == 0:
      return 0
  return 1

def bk_check_primary(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], bp_name: var array[256, int], bp_np: var array[256, int], bp_pv: var array[4096, int], bp_ps: var array[4096, int], bp_cnt: var array[1, int], ls_name: var array[256, int], ls_moved: var array[256, int], ls_mb: var array[256, int], ls_n: var array[1, int]) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  var k: int = cur_kind(tk, n, pi, err)
  if k == 34:
    pi[0] = pi[0] + 1
    if bk_check_primary(src, tk, ts, te, n, pi, err, bp_name, bp_np, bp_pv, bp_ps, bp_cnt, ls_name, ls_moved, ls_mb, ls_n) == 0:
      return 0
    return bk_check_postfix(src, tk, ts, te, n, pi, err, bp_name, bp_np, bp_pv, bp_ps, bp_cnt, ls_name, ls_moved, ls_mb, ls_n)
  if k == 8 or k == 5 or k == 6 or k == 7:
    pi[0] = pi[0] + 1
    return bk_check_postfix(src, tk, ts, te, n, pi, err, bp_name, bp_np, bp_pv, bp_ps, bp_cnt, ls_name, ls_moved, ls_mb, ls_n)
  if k == 4 or k == 46 or k == 35 or k == 36:
    var t4: int = pi[0]
    pi[0] = pi[0] + 1
    if accept_k(tk, n, pi, err, 49) == 1:
      if cur_kind(tk, n, pi, err) != 50:
        var j: int = 0
        var done: int = 0
        while done == 0:
          var arg_plain: int = 0
          var arg_tok: int = pi[0]
          if cur_kind(tk, n, pi, err) == 4:
            if peek_off(tk, n, pi, 1) == 55 or peek_off(tk, n, pi, 1) == 50:
              arg_plain = 1
          if bk_check_expr(src, tk, ts, te, n, pi, err, 0, bp_name, bp_np, bp_pv, bp_ps, bp_cnt, ls_name, ls_moved, ls_mb, ls_n) == 0:
            return 0
          if arg_plain == 1:
            var pidx: int = bk_proc_index(src, ts, te, bp_name, bp_cnt, t4)
            if pidx >= 0:
              if bk_param_moves(bp_np, bp_pv, bp_ps, pidx, j) == 1:
                bk_mark_moved(src, ts, te, ls_name, ls_moved, ls_n, arg_tok)
          j = j + 1
          if accept_k(tk, n, pi, err, 55) == 1:
            done = 0
          else:
            done = 1
      expect_k(tk, n, pi, err, 50)
    else:
      bk_check_use(src, ts, te, ls_name, ls_moved, ls_mb, ls_n, t4, err)
    return bk_check_postfix(src, tk, ts, te, n, pi, err, bp_name, bp_np, bp_pv, bp_ps, bp_cnt, ls_name, ls_moved, ls_mb, ls_n)
  if accept_k(tk, n, pi, err, 49) == 1:
    if bk_check_expr(src, tk, ts, te, n, pi, err, 0, bp_name, bp_np, bp_pv, bp_ps, bp_cnt, ls_name, ls_moved, ls_mb, ls_n) == 0:
      return 0
    expect_k(tk, n, pi, err, 50)
    return bk_check_postfix(src, tk, ts, te, n, pi, err, bp_name, bp_np, bp_pv, bp_ps, bp_cnt, ls_name, ls_moved, ls_mb, ls_n)
  err[0] = 1
  return 0

def bk_check_postfix(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], bp_name: var array[256, int], bp_np: var array[256, int], bp_pv: var array[4096, int], bp_ps: var array[4096, int], bp_cnt: var array[1, int], ls_name: var array[256, int], ls_moved: var array[256, int], ls_mb: var array[256, int], ls_n: var array[1, int]) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  var loop: int = 1
  while loop == 1:
    if cur_kind(tk, n, pi, err) == 72:
      pi[0] = pi[0] + 1
      pi[0] = pi[0] + 1
      if accept_k(tk, n, pi, err, 49) == 1:
        if cur_kind(tk, n, pi, err) != 50:
          var done: int = 0
          while done == 0:
            if bk_check_expr(src, tk, ts, te, n, pi, err, 0, bp_name, bp_np, bp_pv, bp_ps, bp_cnt, ls_name, ls_moved, ls_mb, ls_n) == 0:
              return 0
            if accept_k(tk, n, pi, err, 55) == 1:
              done = 0
            else:
              done = 1
        expect_k(tk, n, pi, err, 50)
      continue
    if cur_kind(tk, n, pi, err) == 51:
      pi[0] = pi[0] + 1
      if bk_check_expr(src, tk, ts, te, n, pi, err, 0, bp_name, bp_np, bp_pv, bp_ps, bp_cnt, ls_name, ls_moved, ls_mb, ls_n) == 0:
        return 0
      expect_k(tk, n, pi, err, 52)
      continue
    loop = 0
  return 1

def bk_check_stmt(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], bp_name: var array[256, int], bp_np: var array[256, int], bp_pv: var array[4096, int], bp_ps: var array[4096, int], bp_cnt: var array[1, int], ls_name: var array[256, int], ls_moved: var array[256, int], ls_mb: var array[256, int], ls_ib: var array[256, int], ls_n: var array[1, int]) -> int
  requires true
  ensures result == 1
  decreases 0
=
  var k: int = cur_kind(tk, n, pi, err)
  if k == 20:
    pi[0] = pi[0] + 1
    var vn: int = pi[0]
    pi[0] = pi[0] + 1
    expect_k(tk, n, pi, err, 56)
    parse_type(src, tk, ts, te, n, pi, err, 0)
    if accept_k(tk, n, pi, err, 58) == 1:
      bk_check_expr(src, tk, ts, te, n, pi, err, 0, bp_name, bp_np, bp_pv, bp_ps, bp_cnt, ls_name, ls_moved, ls_mb, ls_n)
    ls_name[ls_n[0]] = vn
    ls_moved[ls_n[0]] = 0
    ls_mb[ls_n[0]] = 0
    ls_ib[ls_n[0]] = 0
    ls_n[0] = ls_n[0] + 1
    return 1
  if k == 4:
    if tok_is(src, ts, te, pi[0], "borrow") == 1:
      pi[0] = pi[0] + 1
      var bm: int = 0
      if cur_kind(tk, n, pi, err) == 4:
        if tok_is(src, ts, te, pi[0], "mut") == 1:
          bm = 1
          pi[0] = pi[0] + 1
        else:
          if tok_is(src, ts, te, pi[0], "imm") == 1:
            pi[0] = pi[0] + 1
      var bname: int = pi[0]
      pi[0] = pi[0] + 1
      expect_k(tk, n, pi, err, 58)
      var src_tok: int = pi[0]
      var src_ident: int = 0
      if cur_kind(tk, n, pi, err) == 4:
        src_ident = 1
      if parse_primary(src, tk, ts, te, n, pi, err, 0) == 0:
        return 1
      parse_postfix(src, tk, ts, te, n, pi, err, 0)
      if src_ident == 1:
        bk_check_use(src, ts, te, ls_name, ls_moved, ls_mb, ls_n, src_tok, err)
        var k2: int = 0
        while k2 < ls_n[0]:
          if tok_eq(src, ts, te, ls_name[k2], src_tok) == 1:
            if bm == 1:
              if ls_mb[k2] > 0 or ls_ib[k2] > 0:
                err[0] = 1
                li_rt_emit_err(310)
              ls_mb[k2] = ls_mb[k2] + 1
            else:
              if ls_mb[k2] > 0:
                err[0] = 1
                li_rt_emit_err(310)
              ls_ib[k2] = ls_ib[k2] + 1
            k2 = ls_n[0]
          k2 = k2 + 1
      ls_name[ls_n[0]] = bname
      ls_moved[ls_n[0]] = 0
      ls_mb[ls_n[0]] = 0
      ls_ib[ls_n[0]] = 0
      ls_n[0] = ls_n[0] + 1
      return 1
    if tok_is(src, ts, te, pi[0], "discard") == 1:
      pi[0] = pi[0] + 1
      return 1
  if k == 30:
    pi[0] = pi[0] + 1
    if cur_kind(tk, n, pi, err) != 1:
      if cur_kind(tk, n, pi, err) != 3:
        if cur_kind(tk, n, pi, err) != 0:
          bk_check_expr(src, tk, ts, te, n, pi, err, 0, bp_name, bp_np, bp_pv, bp_ps, bp_cnt, ls_name, ls_moved, ls_mb, ls_n)
    return 1
  if k == 22:
    pi[0] = pi[0] + 1
    bk_check_expr(src, tk, ts, te, n, pi, err, 0, bp_name, bp_np, bp_pv, bp_ps, bp_cnt, ls_name, ls_moved, ls_mb, ls_n)
    expect_k(tk, n, pi, err, 56)
    skip_newlines(tk, n, pi, err)
    bk_check_block(src, tk, ts, te, n, pi, err, bp_name, bp_np, bp_pv, bp_ps, bp_cnt, ls_name, ls_moved, ls_mb, ls_ib, ls_n)
    var tail_done: int = 0
    while tail_done == 0:
      skip_newlines(tk, n, pi, err)
      if cur_kind(tk, n, pi, err) == 24:
        pi[0] = pi[0] + 1
        parse_expr(src, tk, ts, te, n, pi, err, 0, 0)
        expect_k(tk, n, pi, err, 56)
        skip_newlines(tk, n, pi, err)
        parse_block(src, tk, ts, te, n, pi, err, 0)
      else:
        if cur_kind(tk, n, pi, err) == 23:
          pi[0] = pi[0] + 1
          expect_k(tk, n, pi, err, 56)
          skip_newlines(tk, n, pi, err)
          parse_block(src, tk, ts, te, n, pi, err, 0)
          tail_done = 1
        else:
          tail_done = 1
    return 1
  if k == 25 or k == 26 or k == 27 or k == 28 or k == 76:
    parse_stmt(src, tk, ts, te, n, pi, err, 0)
    return 1
  if k == 4:
    if tok_is(src, ts, te, pi[0], "parallel") == 1:
      parse_stmt(src, tk, ts, te, n, pi, err, 0)
      return 1
  var save: int = pi[0]
  var ok: int = parse_primary(src, tk, ts, te, n, pi, err, 0)
  if ok == 1:
    ok = parse_postfix(src, tk, ts, te, n, pi, err, 0)
  if ok == 1:
    if accept_k(tk, n, pi, err, 58) == 1:
      bk_check_expr(src, tk, ts, te, n, pi, err, 0, bp_name, bp_np, bp_pv, bp_ps, bp_cnt, ls_name, ls_moved, ls_mb, ls_n)
      return 1
  pi[0] = save
  bk_check_expr(src, tk, ts, te, n, pi, err, 0, bp_name, bp_np, bp_pv, bp_ps, bp_cnt, ls_name, ls_moved, ls_mb, ls_n)
  return 1

def bk_check_block(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], bp_name: var array[256, int], bp_np: var array[256, int], bp_pv: var array[4096, int], bp_ps: var array[4096, int], bp_cnt: var array[1, int], ls_name: var array[256, int], ls_moved: var array[256, int], ls_mb: var array[256, int], ls_ib: var array[256, int], ls_n: var array[1, int]) -> int
  requires true
  ensures result == 1
  decreases 0
=
  skip_newlines(tk, n, pi, err)
  if expect_k(tk, n, pi, err, 2) == 0:
    return 1
  skip_newlines(tk, n, pi, err)
  while 1 == 1:
    if cur_kind(tk, n, pi, err) == 3:
      break
    if cur_kind(tk, n, pi, err) == 0:
      break
    var before: int = pi[0]
    bk_check_stmt(src, tk, ts, te, n, pi, err, bp_name, bp_np, bp_pv, bp_ps, bp_cnt, ls_name, ls_moved, ls_mb, ls_ib, ls_n)
    if pi[0] == before:
      break
    skip_newlines(tk, n, pi, err)
  expect_k(tk, n, pi, err, 3)
  return 1

def bk_skip_params_rec(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], bp_np: var array[256, int], bp_pv: var array[4096, int], bp_ps: var array[4096, int], idx: int) -> int
  requires true
  ensures result == 1
  decreases 0
=
  skip_param_layout(tk, n, pi, err)
  var j: int = 0
  if cur_kind(tk, n, pi, err) != 50:
    var done: int = 0
    while done == 0:
      skip_param_layout(tk, n, pi, err)
      if cur_kind(tk, n, pi, err) == 4:
        pi[0] = pi[0] + 1
        expect_k(tk, n, pi, err, 56)
        var isv: int = 0
        if cur_kind(tk, n, pi, err) == 20:
          isv = 1
        var sc: int = 0
        if cur_kind(tk, n, pi, err) == 4:
          if bk_scalar_name(src, ts, te, pi[0]) == 1:
            sc = 1
        parse_type(src, tk, ts, te, n, pi, err, 0)
        if j < 16:
          if idx < 256:
            bp_pv[idx * 16 + j] = isv
            bp_ps[idx * 16 + j] = sc
            bp_np[idx] = j + 1
        j = j + 1
      skip_param_layout(tk, n, pi, err)
      if accept_k(tk, n, pi, err, 55) == 1:
        done = 0
      else:
        done = 1
  skip_param_layout(tk, n, pi, err)
  expect_k(tk, n, pi, err, 50)
  return 1

def bk_skip_params_decl(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], ls_name: var array[256, int], ls_moved: var array[256, int], ls_mb: var array[256, int], ls_ib: var array[256, int], ls_n: var array[1, int]) -> int
  requires true
  ensures result == 1
  decreases 0
=
  skip_param_layout(tk, n, pi, err)
  if cur_kind(tk, n, pi, err) != 50:
    var done: int = 0
    while done == 0:
      skip_param_layout(tk, n, pi, err)
      if cur_kind(tk, n, pi, err) == 4:
        var pn: int = pi[0]
        pi[0] = pi[0] + 1
        expect_k(tk, n, pi, err, 56)
        parse_type(src, tk, ts, te, n, pi, err, 0)
        ls_name[ls_n[0]] = pn
        ls_moved[ls_n[0]] = 0
        ls_mb[ls_n[0]] = 0
        ls_ib[ls_n[0]] = 0
        ls_n[0] = ls_n[0] + 1
      skip_param_layout(tk, n, pi, err)
      if accept_k(tk, n, pi, err, 55) == 1:
        done = 0
      else:
        done = 1
  skip_param_layout(tk, n, pi, err)
  expect_k(tk, n, pi, err, 50)
  return 1

def borrow_check(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int]) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  var bp_name: array[256, int]
  var bp_np: array[256, int]
  var bp_pv: array[4096, int]
  var bp_ps: array[4096, int]
  var bp_cnt: array[1, int]
  var pend: array[1, int]
  var decl: array[1, int]
  var ls_name: array[256, int]
  var ls_moved: array[256, int]
  var ls_mb: array[256, int]
  var ls_ib: array[256, int]
  var ls_n: array[1, int]
  bp_cnt[0] = 0
  pend[0] = 0
  pi[0] = 0
  skip_newlines(tk, n, pi, err)
  while cur_kind(tk, n, pi, err) != 0:
    var k: int = cur_kind(tk, n, pi, err)
    if k == 11:
      fx_skip_typealias(src, tk, ts, te, n, pi, err)
      continue
    if k == 76:
      fx_skip_decorators(src, tk, ts, te, n, pi, err, pend)
      continue
    if k == 18:
      parse_import(src, tk, ts, te, n, pi, err, 0)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 13 or k == 12 or k == 14:
      parse_theorem(src, tk, ts, te, n, pi, err, 0, 0, 0)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 16 or k == 17:
      pi[0] = pi[0] + 1
      skip_newlines(tk, n, pi, err)
      continue
    if k == 32 or k == 10 or k == 33:
      var is_ext: int = 0
      if k == 32:
        is_ext = 1
        pi[0] = pi[0] + 1
        if cur_kind(tk, n, pi, err) == 10:
          pi[0] = pi[0] + 1
      if k == 33:
        pi[0] = pi[0] + 1
        if cur_kind(tk, n, pi, err) == 10:
          pi[0] = pi[0] + 1
      if k == 10:
        pi[0] = pi[0] + 1
      if cur_kind(tk, n, pi, err) != 4:
        err[0] = 1
        return 1
      var nm: int = pi[0]
      pi[0] = pi[0] + 1
      var idx: int = bp_cnt[0]
      if idx < 256:
        bp_name[idx] = nm
        bp_np[idx] = 0
        bp_cnt[0] = bp_cnt[0] + 1
      fx_skip_typeparams(tk, n, pi, err)
      expect_k(tk, n, pi, err, 49)
      bk_skip_params_rec(src, tk, ts, te, n, pi, err, bp_np, bp_pv, bp_ps, idx)
      fx_record_raises(src, tk, ts, te, n, pi, err, decl)
      if accept_k(tk, n, pi, err, 57) == 1:
        parse_type(src, tk, ts, te, n, pi, err, 0)
      fx_record_raises(src, tk, ts, te, n, pi, err, decl)
      while 1 == 1:
        var ck: int = cur_kind(tk, n, pi, err)
        if ck == 41 or ck == 42 or ck == 43 or ck == 44 or ck == 45:
          parse_contract(src, tk, ts, te, n, pi, err, 0)
          continue
        break
      if is_ext == 0:
        skip_newlines(tk, n, pi, err)
        if accept_k(tk, n, pi, err, 58) == 1:
          skip_newlines(tk, n, pi, err)
          if cur_kind(tk, n, pi, err) == 2:
            parse_block(src, tk, ts, te, n, pi, err, 0)
      skip_newlines(tk, n, pi, err)
      continue
    err[0] = 1
    return 1
  pi[0] = 0
  pend[0] = 0
  skip_newlines(tk, n, pi, err)
  while cur_kind(tk, n, pi, err) != 0:
    var k: int = cur_kind(tk, n, pi, err)
    if k == 11:
      fx_skip_typealias(src, tk, ts, te, n, pi, err)
      continue
    if k == 76:
      fx_skip_decorators(src, tk, ts, te, n, pi, err, pend)
      continue
    if k == 18:
      parse_import(src, tk, ts, te, n, pi, err, 0)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 13 or k == 12 or k == 14:
      parse_theorem(src, tk, ts, te, n, pi, err, 0, 0, 0)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 16 or k == 17:
      pi[0] = pi[0] + 1
      skip_newlines(tk, n, pi, err)
      continue
    if k == 32 or k == 10 or k == 33:
      var is_ext: int = 0
      if k == 32:
        is_ext = 1
        pi[0] = pi[0] + 1
        if cur_kind(tk, n, pi, err) == 10:
          pi[0] = pi[0] + 1
      if k == 33:
        pi[0] = pi[0] + 1
        if cur_kind(tk, n, pi, err) == 10:
          pi[0] = pi[0] + 1
      if k == 10:
        pi[0] = pi[0] + 1
      if cur_kind(tk, n, pi, err) != 4:
        err[0] = 1
        return 1
      pi[0] = pi[0] + 1
      fx_skip_typeparams(tk, n, pi, err)
      expect_k(tk, n, pi, err, 49)
      ls_n[0] = 0
      bk_skip_params_decl(src, tk, ts, te, n, pi, err, ls_name, ls_moved, ls_mb, ls_ib, ls_n)
      fx_record_raises(src, tk, ts, te, n, pi, err, decl)
      if accept_k(tk, n, pi, err, 57) == 1:
        parse_type(src, tk, ts, te, n, pi, err, 0)
      fx_record_raises(src, tk, ts, te, n, pi, err, decl)
      while 1 == 1:
        var ck: int = cur_kind(tk, n, pi, err)
        if ck == 41 or ck == 42 or ck == 43 or ck == 44 or ck == 45:
          parse_contract(src, tk, ts, te, n, pi, err, 0)
          continue
        break
      if is_ext == 0:
        skip_newlines(tk, n, pi, err)
        if accept_k(tk, n, pi, err, 58) == 1:
          skip_newlines(tk, n, pi, err)
          if cur_kind(tk, n, pi, err) == 2:
            bk_check_block(src, tk, ts, te, n, pi, err, bp_name, bp_np, bp_pv, bp_ps, bp_cnt, ls_name, ls_moved, ls_mb, ls_ib, ls_n)
      skip_newlines(tk, n, pi, err)
      continue
    err[0] = 1
    return 1
  return 0

# ---- Layer 4d: encapsulation / visibility / trait / object checks ----
# Mirrors compiler/types/{policy,typecheck}.cpp object/trait semantics.

def ec_find_obj(src: var ptr, ts: var array[262144, int], te: var array[262144, int], ob_name: var array[256, int], ob_cnt: var array[1, int], name_tok: int) -> int
  requires true
  ensures result >= -1
  decreases 0
=
  var k: int = 0
  while k < ob_cnt[0]:
    if tok_eq(src, ts, te, ob_name[k], name_tok) == 1:
      return k
    k = k + 1
  return -1

def ec_find_trait(src: var ptr, ts: var array[262144, int], te: var array[262144, int], tr_name: var array[64, int], tr_cnt: var array[1, int], name_tok: int) -> int
  requires true
  ensures result >= -1
  decreases 0
=
  var k: int = 0
  while k < tr_cnt[0]:
    if tok_eq(src, ts, te, tr_name[k], name_tok) == 1:
      return k
    k = k + 1
  return -1

def ec_name_joins(src: var ptr, ts: var array[262144, int], te: var array[262144, int], a: int, b: int, f: int) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  var la: int = peek_tk(te, a + 0) - peek_tk(ts, a + 0)
  var lb: int = peek_tk(te, b + 0) - peek_tk(ts, b + 0)
  var lf: int = peek_tk(te, f + 0) - peek_tk(ts, f + 0)
  if lf != la + 1 + lb:
    return 0
  var j: int = 0
  while j < la:
    if li_rt_str_char_at(src, peek_tk(ts, a + 0) + j) != li_rt_str_char_at(src, peek_tk(ts, f + 0) + j):
      return 0
    j = j + 1
  if li_rt_str_char_at(src, peek_tk(ts, f + 0) + la) != 95:
    return 0
  j = 0
  while j < lb:
    if li_rt_str_char_at(src, peek_tk(ts, b + 0) + j) != li_rt_str_char_at(src, peek_tk(ts, f + 0) + la + 1 + j):
      return 0
    j = j + 1
  return 1

def ec_has_prefix_join(src: var ptr, ts: var array[262144, int], te: var array[262144, int], a: int, f: int) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  var lf: int = peek_tk(te, f + 0) - peek_tk(ts, f + 0)
  var la: int = peek_tk(te, a + 0) - peek_tk(ts, a + 0)
  if lf < la + 2:
    return 0
  var j: int = 0
  while j < la:
    if li_rt_str_char_at(src, peek_tk(ts, a + 0) + j) != li_rt_str_char_at(src, peek_tk(ts, f + 0) + j):
      return 0
    j = j + 1
  if li_rt_str_char_at(src, peek_tk(ts, f + 0) + la) != 95:
    return 0
  return 1

def ec_same_suffix(src: var ptr, ts: var array[262144, int], te: var array[262144, int], a: int, b: int, f: int, g: int) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  var lf: int = peek_tk(te, f + 0) - peek_tk(ts, f + 0)
  var lg: int = peek_tk(te, g + 0) - peek_tk(ts, g + 0)
  var la: int = peek_tk(te, a + 0) - peek_tk(ts, a + 0)
  var lb: int = peek_tk(te, b + 0) - peek_tk(ts, b + 0)
  if lf - la != lg - lb:
    return 0
  var ls: int = lf - la - 1
  if ls <= 0:
    return 0
  var j: int = 0
  while j < la:
    if li_rt_str_char_at(src, peek_tk(ts, a + 0) + j) != li_rt_str_char_at(src, peek_tk(ts, f + 0) + j):
      return 0
    j = j + 1
  if li_rt_str_char_at(src, peek_tk(ts, f + 0) + la) != 95:
    return 0
  j = 0
  while j < lb:
    if li_rt_str_char_at(src, peek_tk(ts, b + 0) + j) != li_rt_str_char_at(src, peek_tk(ts, g + 0) + j):
      return 0
    j = j + 1
  if li_rt_str_char_at(src, peek_tk(ts, g + 0) + lb) != 95:
    return 0
  j = 0
  while j < ls:
    if li_rt_str_char_at(src, peek_tk(ts, f + 0) + la + 1 + j) != li_rt_str_char_at(src, peek_tk(ts, g + 0) + lb + 1 + j):
      return 0
    j = j + 1
  return 1

def ec_underscore(src: var ptr, ts: var array[262144, int], te: var array[262144, int], tok: int) -> int
  requires true
  ensures result >= -1
  decreases 0
=
  var st: int = peek_tk(ts, tok + 0)
  var en: int = peek_tk(te, tok + 0)
  var j: int = st
  while j < en:
    if li_rt_str_char_at(src, j) == 95:
      return j - st
    j = j + 1
  return -1

def ec_ident_used(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], bind_tok: int) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  var j: int = 0
  while j < n[0]:
    if j != bind_tok:
      if peek_tk(tk, j) == 4:
        if tok_eq(src, ts, te, j, bind_tok) == 1:
          return 1
    j = j + 1
  return 0

def ec_field_idx(src: var ptr, ts: var array[262144, int], te: var array[262144, int], fd_name: var array[256, int], fd_owner: var array[256, int], fd_cnt: var array[1, int], ob_idx: int, name_tok: int) -> int
  requires true
  ensures result >= -1
  decreases 0
=
  var k: int = 0
  while k < fd_cnt[0]:
    if fd_owner[k] == ob_idx:
      if tok_eq(src, ts, te, fd_name[k], name_tok) == 1:
        return k
    k = k + 1
  return -1

def ec_obj_impl_trait(src: var ptr, ts: var array[262144, int], te: var array[262144, int], tm_name: var array[256, int], tm_owner: var array[256, int], tm_cnt: var array[1, int], ep_name: var array[256, int], ep_cnt: var array[1, int], ob_tok: int, tr_idx: int) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  var m: int = 0
  while m < tm_cnt[0]:
    if tm_owner[m] == tr_idx:
      var found: int = 0
      var p: int = 0
      while p < ep_cnt[0]:
        if ec_name_joins(src, ts, te, ob_tok, tm_name[m], ep_name[p]) == 1:
          found = 1
        p = p + 1
      if found == 0:
        return 0
    m = m + 1
  return 1

def ec_capture_type_tok(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int]) -> int
  requires true
  ensures result >= -1
  decreases 0
=
  var tt: int = -1
  if cur_kind(tk, n, pi, err) == 20:
    pi[0] = pi[0] + 1
  if cur_kind(tk, n, pi, err) == 4:
    tt = pi[0]
  parse_type(src, tk, ts, te, n, pi, err, 0)
  return tt

def ec_record_proc(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], is_priv: int, is_ovr: int, ep_name: var array[256, int], ep_priv: var array[256, int], ep_self: var array[256, int], ep_ret: var array[256, int], ep_bnd: var array[256, int], ep_ovr: var array[256, int], ep_cnt: var array[1, int]) -> int
  requires true
  ensures result == 1
  decreases 0
=
  if cur_kind(tk, n, pi, err) != 4:
    err[0] = 1
    return 1
  var nm: int = pi[0]
  pi[0] = pi[0] + 1
  var idx: int = ep_cnt[0]
  if idx < 256:
    ep_name[idx] = nm
    ep_priv[idx] = is_priv
    ep_self[idx] = -1
    ep_ret[idx] = -1
    ep_bnd[idx] = -1
    ep_ovr[idx] = is_ovr
    ep_cnt[0] = ep_cnt[0] + 1
  if accept_k(tk, n, pi, err, 51) == 1:
    if cur_kind(tk, n, pi, err) != 52:
      var done: int = 0
      while done == 0:
        if cur_kind(tk, n, pi, err) == 4:
          pi[0] = pi[0] + 1
        if accept_k(tk, n, pi, err, 56) == 1:
          if cur_kind(tk, n, pi, err) == 4:
            if idx < 256:
              ep_bnd[idx] = pi[0]
            pi[0] = pi[0] + 1
        if accept_k(tk, n, pi, err, 55) == 1:
          done = 0
        else:
          done = 1
    expect_k(tk, n, pi, err, 52)
  expect_k(tk, n, pi, err, 49)
  skip_param_layout(tk, n, pi, err)
  var first: int = 1
  if cur_kind(tk, n, pi, err) != 50:
    var done: int = 0
    while done == 0:
      skip_param_layout(tk, n, pi, err)
      if cur_kind(tk, n, pi, err) == 4:
        var pn: int = pi[0]
        pi[0] = pi[0] + 1
        expect_k(tk, n, pi, err, 56)
        var tt: int = ec_capture_type_tok(src, tk, ts, te, n, pi, err)
        if first == 1:
          if idx < 256:
            ep_self[idx] = tt
        first = 0
      skip_param_layout(tk, n, pi, err)
      if accept_k(tk, n, pi, err, 55) == 1:
        done = 0
      else:
        done = 1
  skip_param_layout(tk, n, pi, err)
  expect_k(tk, n, pi, err, 50)
  tc_skip_raises(tk, n, pi, err)
  if accept_k(tk, n, pi, err, 57) == 1:
    if idx < 256:
      ep_ret[idx] = ec_capture_type_tok(src, tk, ts, te, n, pi, err)
    else:
      parse_type(src, tk, ts, te, n, pi, err, 0)
  tc_skip_raises(tk, n, pi, err)
  while 1 == 1:
    var ck: int = cur_kind(tk, n, pi, err)
    if ck == 41 or ck == 42 or ck == 43 or ck == 44 or ck == 45:
      parse_contract(src, tk, ts, te, n, pi, err, 0)
      continue
    break
  return 1

def ec_parse_fields(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], ob_idx: int, fd_name: var array[256, int], fd_priv: var array[256, int], fd_type: var array[256, int], fd_owner: var array[256, int], fd_cnt: var array[1, int]) -> int
  requires true
  ensures result == 1
  decreases 0
=
  skip_newlines(tk, n, pi, err)
  while 1 == 1:
    var k: int = cur_kind(tk, n, pi, err)
    if k != 16:
      if k != 17:
        if k != 4:
          break
        if peek_off(tk, n, pi, 1) != 56:
          break
    if k == 16:
      if peek_off(tk, n, pi, 1) == 10:
        break
    if k == 17:
      if peek_off(tk, n, pi, 1) == 10:
        break
    var vis: int = 0
    if k == 16:
      vis = 1
      pi[0] = pi[0] + 1
    else:
      if k == 17:
        pi[0] = pi[0] + 1
    if cur_kind(tk, n, pi, err) != 4:
      err[0] = 1
      break
    var fn: int = pi[0]
    pi[0] = pi[0] + 1
    expect_k(tk, n, pi, err, 56)
    var tt: int = ec_capture_type_tok(src, tk, ts, te, n, pi, err)
    if fd_cnt[0] < 256:
      fd_name[fd_cnt[0]] = fn
      fd_priv[fd_cnt[0]] = vis
      fd_type[fd_cnt[0]] = tt
      fd_owner[fd_cnt[0]] = ob_idx
      fd_cnt[0] = fd_cnt[0] + 1
    skip_newlines(tk, n, pi, err)
  return 1

def ec_parse_trait_methods(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], tr_idx: int, tm_name: var array[256, int], tm_owner: var array[256, int], tm_cnt: var array[1, int]) -> int
  requires true
  ensures result == 1
  decreases 0
=
  skip_newlines(tk, n, pi, err)
  while 1 == 1:
    var k: int = cur_kind(tk, n, pi, err)
    if k == 16:
      pi[0] = pi[0] + 1
    if k == 17:
      pi[0] = pi[0] + 1
    k = cur_kind(tk, n, pi, err)
    if k == 10 or k == 9:
      pi[0] = pi[0] + 1
      if cur_kind(tk, n, pi, err) != 4:
        err[0] = 1
        return 1
      var mn: int = pi[0]
      pi[0] = pi[0] + 1
      expect_k(tk, n, pi, err, 49)
      skip_param_layout(tk, n, pi, err)
      if cur_kind(tk, n, pi, err) != 50:
        var done: int = 0
        while done == 0:
          parse_param(src, tk, ts, te, n, pi, err, 0)
          skip_param_layout(tk, n, pi, err)
          if accept_k(tk, n, pi, err, 55) == 1:
            done = 0
          else:
            done = 1
      skip_param_layout(tk, n, pi, err)
      expect_k(tk, n, pi, err, 50)
      if accept_k(tk, n, pi, err, 57) == 1:
        parse_type(src, tk, ts, te, n, pi, err, 0)
      if tm_cnt[0] < 256:
        tm_name[tm_cnt[0]] = mn
        tm_owner[tm_cnt[0]] = tr_idx
        tm_cnt[0] = tm_cnt[0] + 1
      skip_newlines(tk, n, pi, err)
      continue
    break
  return 1

# ---- policy scan: field privacy, method existence, trait bounds ----
# Mirrors the typecheck.cpp object/trait checks that need base-type info:
#   `v.secret` on an object with a private `secret`  -> lic.error (900)
#   `w.missing()` where no `Widget_missing` proc      -> E0202 (202)
#   `require_hash(b)` where Bad doesn't impl Hash     -> lic.error (900)
# Locals (params + `var x: T`) are tracked per proc; only plain-idents whose
# declared type names a locally-declared object are checked.

def pl_find_ty(src: var ptr, ts: var array[262144, int], te: var array[262144, int], pl_name: var array[256, int], pl_ty: var array[256, int], pl_n: var array[1, int], name_tok: int) -> int
  requires true
  ensures result >= -1
  decreases 0
=
  var k: int = 0
  while k < pl_n[0]:
    if tok_eq(src, ts, te, pl_name[k], name_tok) == 1:
      return pl_ty[k]
    k = k + 1
  return -1

def ec_tok_text(src: var ptr, ts: var array[262144, int], te: var array[262144, int], tok: int) raises IO -> ptr
  requires true
  ensures result >= 0
  decreases 0
=
  return bytes_slice_i(src, peek_tk(ts, tok + 0), peek_tk(te, tok + 0) - peek_tk(ts, tok + 0))

def ec_text_eq(a: ptr, b: ptr) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  if li_rt_str_eq(a, b) == 1:
    return 1
  return 0

# Collect `type X = object` decls from an already-lexed (imported) token
# stream into text tables: im_ob (object names), im_fd_name/im_fd_priv/
# im_fd_owner (fields with visibility). Returns 0.
def ec_collect_import_objects(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], im_ob: var array[64, ptr], im_fd_name: var array[256, ptr], im_fd_priv: var array[256, int], im_fd_owner: var array[256, int], im_ob_cnt: var array[1, int], im_fd_cnt: var array[1, int]) -> int
  requires true
  ensures result == 0
  decreases 0
=
  pi[0] = 0
  skip_newlines(tk, n, pi, err)
  while cur_kind(tk, n, pi, err) != 0:
    var k: int = cur_kind(tk, n, pi, err)
    if k == 11:
      pi[0] = pi[0] + 1
      if cur_kind(tk, n, pi, err) != 4:
        pi[0] = pi[0] + 1
        continue
      var ob: int = -1
      var nm: int = pi[0]
      pi[0] = pi[0] + 1
      fx_skip_typeparams(tk, n, pi, err)
      if cur_kind(tk, n, pi, err) == 58:
        pi[0] = pi[0] + 1
        skip_newlines(tk, n, pi, err)
        if cur_kind(tk, n, pi, err) == 15:
          pi[0] = pi[0] + 1
          skip_newlines(tk, n, pi, err)
          if cur_kind(tk, n, pi, err) == 4:
            if tok_is(src, ts, te, pi[0], "of") == 1:
              pi[0] = pi[0] + 1
              if cur_kind(tk, n, pi, err) == 4:
                pi[0] = pi[0] + 1
              skip_newlines(tk, n, pi, err)
          ob = im_ob_cnt[0]
          if im_ob_cnt[0] < 64:
            im_ob[im_ob_cnt[0]] = ec_tok_text(src, ts, te, nm)
            im_ob_cnt[0] = im_ob_cnt[0] + 1
          skip_newlines(tk, n, pi, err)
          while 1 == 1:
            var fk: int = cur_kind(tk, n, pi, err)
            if fk != 16:
              if fk != 17:
                if fk != 4:
                  break
                if peek_off(tk, n, pi, 1) != 56:
                  break
            if fk == 16:
              if peek_off(tk, n, pi, 1) == 10:
                break
            if fk == 17:
              if peek_off(tk, n, pi, 1) == 10:
                break
            var vis: int = 0
            if fk == 16:
              vis = 1
              pi[0] = pi[0] + 1
            else:
              if fk == 17:
                pi[0] = pi[0] + 1
            if cur_kind(tk, n, pi, err) != 4:
              break
            var fn: int = pi[0]
            pi[0] = pi[0] + 1
            expect_k(tk, n, pi, err, 56)
            parse_type(src, tk, ts, te, n, pi, err, 0)
            if im_fd_cnt[0] < 256:
              if ob >= 0:
                im_fd_name[im_fd_cnt[0]] = ec_tok_text(src, ts, te, fn)
                im_fd_priv[im_fd_cnt[0]] = vis
                im_fd_owner[im_fd_cnt[0]] = ob
                im_fd_cnt[0] = im_fd_cnt[0] + 1
            skip_newlines(tk, n, pi, err)
        else:
          while cur_kind(tk, n, pi, err) != 1:
            if cur_kind(tk, n, pi, err) == 0:
              break
            pi[0] = pi[0] + 1
          pi[0] = pi[0] + 1
      else:
        pi[0] = pi[0] + 1
      skip_newlines(tk, n, pi, err)
      continue
    if k == 10 or k == 16 or k == 17 or k == 32 or k == 33 or k == 76:
      pi[0] = pi[0] + 1
      skip_newlines(tk, n, pi, err)
      continue
    if k == 18 or k == 13 or k == 12 or k == 14:
      pi[0] = pi[0] + 1
      skip_newlines(tk, n, pi, err)
      continue
    pi[0] = pi[0] + 1
  return 0

# True when object text `ob` declares field text `fld` as private, searching
# the imported text tables.
def ec_import_field_private(im_ob: var array[64, ptr], im_fd_name: var array[256, ptr], im_fd_priv: var array[256, int], im_fd_owner: var array[256, int], im_ob_cnt: var array[1, int], im_fd_cnt: var array[1, int], ob: ptr, fld: ptr) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  var oi: int = -1
  var q: int = 0
  while q < im_ob_cnt[0]:
    if ec_text_eq(im_ob[q], ob) == 1:
      oi = q
    q = q + 1
  if oi < 0:
    return 0
  q = 0
  while q < im_fd_cnt[0]:
    if im_fd_owner[q] == oi:
      if ec_text_eq(im_fd_name[q], fld) == 1:
        if im_fd_priv[q] == 1:
          return 1
    q = q + 1
  return 0

def pl_add_local(pl_name: var array[256, int], pl_ty: var array[256, int], pl_n: var array[1, int], name_tok: int, ty_tok: int) -> int
  requires true
  ensures result == 0
  decreases 0
=
  if pl_n[0] < 256:
    pl_name[pl_n[0]] = name_tok
    pl_ty[pl_n[0]] = ty_tok
    pl_n[0] = pl_n[0] + 1
  return 0

def pl_proc_bound(src: var ptr, ts: var array[262144, int], te: var array[262144, int], ep_name: var array[256, int], ep_bnd: var array[256, int], ep_cnt: var array[1, int], name_tok: int) -> int
  requires true
  ensures result >= -1
  decreases 0
=
  var q: int = 0
  while q < ep_cnt[0]:
    if tok_eq(src, ts, te, ep_name[q], name_tok) == 1:
      if peek256(ep_bnd, q) >= 0:
        return peek256(ep_bnd, q)
    q = q + 1
  return -1

def pl_obj_has_method(src: var ptr, ts: var array[262144, int], te: var array[262144, int], ob_name: var array[256, int], ob_cnt: var array[1, int], ep_name: var array[256, int], ep_cnt: var array[1, int], ob_tok: int, method_tok: int) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  var q: int = 0
  while q < ep_cnt[0]:
    if ec_name_joins(src, ts, te, ob_tok, method_tok, ep_name[q]) == 1:
      return 1
    q = q + 1
  return 0

def pl_check_expr(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], min_prec: int, cur: var array[1, int], ob_name: var array[256, int], ob_cnt: var array[1, int], tr_name: var array[64, int], tr_cnt: var array[1, int], fd_name: var array[256, int], fd_priv: var array[256, int], fd_owner: var array[256, int], fd_cnt: var array[1, int], tm_name: var array[256, int], tm_owner: var array[256, int], tm_cnt: var array[1, int], ep_name: var array[256, int], ep_bnd: var array[256, int], ep_cnt: var array[1, int], im_ob: var array[64, ptr], im_fd_name: var array[256, ptr], im_fd_priv: var array[256, int], im_fd_owner: var array[256, int], im_ob_cnt: var array[1, int], im_fd_cnt: var array[1, int], pl_name: var array[256, int], pl_ty: var array[256, int], pl_n: var array[1, int]) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  if cur_kind(tk, n, pi, err) == 39:
    pi[0] = pi[0] + 1
    return pl_check_expr(src, tk, ts, te, n, pi, err, 100, cur, ob_name, ob_cnt, tr_name, tr_cnt, fd_name, fd_priv, fd_owner, fd_cnt, tm_name, tm_owner, tm_cnt, ep_name, ep_bnd, ep_cnt, im_ob, im_fd_name, im_fd_priv, im_fd_owner, im_ob_cnt, im_fd_cnt, pl_name, pl_ty, pl_n)
  if cur_kind(tk, n, pi, err) == 60:
    pi[0] = pi[0] + 1
  if pl_check_primary(src, tk, ts, te, n, pi, err, cur, ob_name, ob_cnt, tr_name, tr_cnt, fd_name, fd_priv, fd_owner, fd_cnt, tm_name, tm_owner, tm_cnt, ep_name, ep_bnd, ep_cnt, im_ob, im_fd_name, im_fd_priv, im_fd_owner, im_ob_cnt, im_fd_cnt, pl_name, pl_ty, pl_n) == 0:
    return 0
  while 1 == 1:
    var p: int = prec_of(cur_kind(tk, n, pi, err))
    if p < 0:
      break
    if p < min_prec:
      break
    pi[0] = pi[0] + 1
    if pl_check_expr(src, tk, ts, te, n, pi, err, p + 1, cur, ob_name, ob_cnt, tr_name, tr_cnt, fd_name, fd_priv, fd_owner, fd_cnt, tm_name, tm_owner, tm_cnt, ep_name, ep_bnd, ep_cnt, im_ob, im_fd_name, im_fd_priv, im_fd_owner, im_ob_cnt, im_fd_cnt, pl_name, pl_ty, pl_n) == 0:
      return 0
  return 1

def pl_check_primary(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], cur: var array[1, int], ob_name: var array[256, int], ob_cnt: var array[1, int], tr_name: var array[64, int], tr_cnt: var array[1, int], fd_name: var array[256, int], fd_priv: var array[256, int], fd_owner: var array[256, int], fd_cnt: var array[1, int], tm_name: var array[256, int], tm_owner: var array[256, int], tm_cnt: var array[1, int], ep_name: var array[256, int], ep_bnd: var array[256, int], ep_cnt: var array[1, int], im_ob: var array[64, ptr], im_fd_name: var array[256, ptr], im_fd_priv: var array[256, int], im_fd_owner: var array[256, int], im_ob_cnt: var array[1, int], im_fd_cnt: var array[1, int], pl_name: var array[256, int], pl_ty: var array[256, int], pl_n: var array[1, int]) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  var k: int = cur_kind(tk, n, pi, err)
  if k == 34:
    pi[0] = pi[0] + 1
    if pl_check_primary(src, tk, ts, te, n, pi, err, cur, ob_name, ob_cnt, tr_name, tr_cnt, fd_name, fd_priv, fd_owner, fd_cnt, tm_name, tm_owner, tm_cnt, ep_name, ep_bnd, ep_cnt, im_ob, im_fd_name, im_fd_priv, im_fd_owner, im_ob_cnt, im_fd_cnt, pl_name, pl_ty, pl_n) == 0:
      return 0
    return pl_check_postfix(src, tk, ts, te, n, pi, err, cur, ob_name, ob_cnt, tr_name, tr_cnt, fd_name, fd_priv, fd_owner, fd_cnt, tm_name, tm_owner, tm_cnt, ep_name, ep_bnd, ep_cnt, im_ob, im_fd_name, im_fd_priv, im_fd_owner, im_ob_cnt, im_fd_cnt, pl_name, pl_ty, pl_n)
  if k == 8 or k == 5 or k == 6 or k == 7:
    pi[0] = pi[0] + 1
    cur[0] = -1
    return pl_check_postfix(src, tk, ts, te, n, pi, err, cur, ob_name, ob_cnt, tr_name, tr_cnt, fd_name, fd_priv, fd_owner, fd_cnt, tm_name, tm_owner, tm_cnt, ep_name, ep_bnd, ep_cnt, im_ob, im_fd_name, im_fd_priv, im_fd_owner, im_ob_cnt, im_fd_cnt, pl_name, pl_ty, pl_n)
  if k == 4 or k == 46 or k == 35 or k == 36:
    var t4: int = pi[0]
    pi[0] = pi[0] + 1
    if accept_k(tk, n, pi, err, 49) == 1:
      # Plain call `f(args)`: check trait bounds if f is a recorded generic.
      var callee: int = t4
      var first_arg: int = -1
      var first_plain: int = 0
      if cur_kind(tk, n, pi, err) != 50:
        var done: int = 0
        while done == 0:
          var at: int = pi[0]
          var ap: int = 0
          if cur_kind(tk, n, pi, err) == 4:
            if peek_off(tk, n, pi, 1) == 55 or peek_off(tk, n, pi, 1) == 50:
              ap = 1
          if pl_check_expr(src, tk, ts, te, n, pi, err, 0, cur, ob_name, ob_cnt, tr_name, tr_cnt, fd_name, fd_priv, fd_owner, fd_cnt, tm_name, tm_owner, tm_cnt, ep_name, ep_bnd, ep_cnt, im_ob, im_fd_name, im_fd_priv, im_fd_owner, im_ob_cnt, im_fd_cnt, pl_name, pl_ty, pl_n) == 0:
            return 0
          if first_arg < 0:
            first_arg = at
            if ap == 1:
              first_plain = 1
          if accept_k(tk, n, pi, err, 55) == 1:
            done = 0
          else:
            done = 1
      expect_k(tk, n, pi, err, 50)
      if first_plain == 1:
        var bnd: int = pl_proc_bound(src, ts, te, ep_name, ep_bnd, ep_cnt, callee)
        if bnd >= 0:
          var arg_ty: int = pl_find_ty(src, ts, te, pl_name, pl_ty, pl_n, first_arg)
          if arg_ty >= 0:
            var oi: int = ec_find_obj(src, ts, te, ob_name, ob_cnt, arg_ty)
            if oi >= 0:
              var ti: int = ec_find_trait(src, ts, te, tr_name, tr_cnt, bnd)
              if ti >= 0:
                if ec_obj_impl_trait(src, ts, te, tm_name, tm_owner, tm_cnt, ep_name, ep_cnt, peek256(ob_name, oi), ti) == 0:
                  err[0] = 1
                  li_rt_emit_err(900)
      cur[0] = -1
      return pl_check_postfix(src, tk, ts, te, n, pi, err, cur, ob_name, ob_cnt, tr_name, tr_cnt, fd_name, fd_priv, fd_owner, fd_cnt, tm_name, tm_owner, tm_cnt, ep_name, ep_bnd, ep_cnt, im_ob, im_fd_name, im_fd_priv, im_fd_owner, im_ob_cnt, im_fd_cnt, pl_name, pl_ty, pl_n)
    cur[0] = t4
    return pl_check_postfix(src, tk, ts, te, n, pi, err, cur, ob_name, ob_cnt, tr_name, tr_cnt, fd_name, fd_priv, fd_owner, fd_cnt, tm_name, tm_owner, tm_cnt, ep_name, ep_bnd, ep_cnt, im_ob, im_fd_name, im_fd_priv, im_fd_owner, im_ob_cnt, im_fd_cnt, pl_name, pl_ty, pl_n)
  if accept_k(tk, n, pi, err, 49) == 1:
    if pl_check_expr(src, tk, ts, te, n, pi, err, 0, cur, ob_name, ob_cnt, tr_name, tr_cnt, fd_name, fd_priv, fd_owner, fd_cnt, tm_name, tm_owner, tm_cnt, ep_name, ep_bnd, ep_cnt, im_ob, im_fd_name, im_fd_priv, im_fd_owner, im_ob_cnt, im_fd_cnt, pl_name, pl_ty, pl_n) == 0:
      return 0
    if expect_k(tk, n, pi, err, 50) == 0:
      return 0
    cur[0] = -1
    return pl_check_postfix(src, tk, ts, te, n, pi, err, cur, ob_name, ob_cnt, tr_name, tr_cnt, fd_name, fd_priv, fd_owner, fd_cnt, tm_name, tm_owner, tm_cnt, ep_name, ep_bnd, ep_cnt, im_ob, im_fd_name, im_fd_priv, im_fd_owner, im_ob_cnt, im_fd_cnt, pl_name, pl_ty, pl_n)
  err[0] = 1
  return 0

def pl_check_postfix(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], cur: var array[1, int], ob_name: var array[256, int], ob_cnt: var array[1, int], tr_name: var array[64, int], tr_cnt: var array[1, int], fd_name: var array[256, int], fd_priv: var array[256, int], fd_owner: var array[256, int], fd_cnt: var array[1, int], tm_name: var array[256, int], tm_owner: var array[256, int], tm_cnt: var array[1, int], ep_name: var array[256, int], ep_bnd: var array[256, int], ep_cnt: var array[1, int], im_ob: var array[64, ptr], im_fd_name: var array[256, ptr], im_fd_priv: var array[256, int], im_fd_owner: var array[256, int], im_ob_cnt: var array[1, int], im_fd_cnt: var array[1, int], pl_name: var array[256, int], pl_ty: var array[256, int], pl_n: var array[1, int]) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  var loop: int = 1
  while loop == 1:
    if cur_kind(tk, n, pi, err) == 72:
      pi[0] = pi[0] + 1
      if cur_kind(tk, n, pi, err) != 4:
        err[0] = 1
        return 0
      var field_tok: int = pi[0]
      pi[0] = pi[0] + 1
      var is_call: int = 0
      if accept_k(tk, n, pi, err, 49) == 1:
        is_call = 1
        if cur_kind(tk, n, pi, err) != 50:
          var done: int = 0
          while done == 0:
            if pl_check_expr(src, tk, ts, te, n, pi, err, 0, cur, ob_name, ob_cnt, tr_name, tr_cnt, fd_name, fd_priv, fd_owner, fd_cnt, tm_name, tm_owner, tm_cnt, ep_name, ep_bnd, ep_cnt, im_ob, im_fd_name, im_fd_priv, im_fd_owner, im_ob_cnt, im_fd_cnt, pl_name, pl_ty, pl_n) == 0:
              return 0
            if accept_k(tk, n, pi, err, 55) == 1:
              done = 0
            else:
              done = 1
        expect_k(tk, n, pi, err, 50)
      # Resolve base local type -> object, then check field/method.
      if cur[0] >= 0:
        var bty: int = pl_find_ty(src, ts, te, pl_name, pl_ty, pl_n, cur[0])
        if bty >= 0:
          var oi: int = ec_find_obj(src, ts, te, ob_name, ob_cnt, bty)
          if oi >= 0:
            if is_call == 1:
              if pl_obj_has_method(src, ts, te, ob_name, ob_cnt, ep_name, ep_cnt, peek256(ob_name, oi), field_tok) == 0:
                err[0] = 1
                li_rt_emit_err(202)
            else:
              var fi: int = ec_field_idx(src, ts, te, fd_name, fd_owner, fd_cnt, oi, field_tok)
              if fi >= 0:
                if peek256(fd_priv, fi) == 1:
                  err[0] = 1
                  li_rt_emit_err(900)
          else:
            if is_call == 0:
              if ec_import_field_private(im_ob, im_fd_name, im_fd_priv, im_fd_owner, im_ob_cnt, im_fd_cnt, ec_tok_text(src, ts, te, bty), ec_tok_text(src, ts, te, field_tok)) == 1:
                err[0] = 1
                li_rt_emit_err(900)
      cur[0] = -1
      continue
    if cur_kind(tk, n, pi, err) == 51:
      pi[0] = pi[0] + 1
      if pl_check_expr(src, tk, ts, te, n, pi, err, 0, cur, ob_name, ob_cnt, tr_name, tr_cnt, fd_name, fd_priv, fd_owner, fd_cnt, tm_name, tm_owner, tm_cnt, ep_name, ep_bnd, ep_cnt, im_ob, im_fd_name, im_fd_priv, im_fd_owner, im_ob_cnt, im_fd_cnt, pl_name, pl_ty, pl_n) == 0:
        return 0
      expect_k(tk, n, pi, err, 52)
      cur[0] = -1
      continue
    loop = 0
  return 1

def pl_check_block(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], ob_name: var array[256, int], ob_cnt: var array[1, int], tr_name: var array[64, int], tr_cnt: var array[1, int], fd_name: var array[256, int], fd_priv: var array[256, int], fd_owner: var array[256, int], fd_cnt: var array[1, int], tm_name: var array[256, int], tm_owner: var array[256, int], tm_cnt: var array[1, int], ep_name: var array[256, int], ep_bnd: var array[256, int], ep_cnt: var array[1, int], im_ob: var array[64, ptr], im_fd_name: var array[256, ptr], im_fd_priv: var array[256, int], im_fd_owner: var array[256, int], im_ob_cnt: var array[1, int], im_fd_cnt: var array[1, int], pl_name: var array[256, int], pl_ty: var array[256, int], pl_n: var array[1, int]) -> int
  requires true
  ensures result == 1
  decreases 0
=
  var cur: array[1, int]
  cur[0] = -1
  skip_newlines(tk, n, pi, err)
  if expect_k(tk, n, pi, err, 2) == 0:
    return 1
  skip_newlines(tk, n, pi, err)
  while 1 == 1:
    if cur_kind(tk, n, pi, err) == 3:
      break
    if cur_kind(tk, n, pi, err) == 0:
      break
    var before: int = pi[0]
    pl_check_stmt(src, tk, ts, te, n, pi, err, cur, ob_name, ob_cnt, tr_name, tr_cnt, fd_name, fd_priv, fd_owner, fd_cnt, tm_name, tm_owner, tm_cnt, ep_name, ep_bnd, ep_cnt, im_ob, im_fd_name, im_fd_priv, im_fd_owner, im_ob_cnt, im_fd_cnt, pl_name, pl_ty, pl_n)
    if pi[0] == before:
      break
    skip_newlines(tk, n, pi, err)
  expect_k(tk, n, pi, err, 3)
  return 1

def pl_check_stmt(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], cur: var array[1, int], ob_name: var array[256, int], ob_cnt: var array[1, int], tr_name: var array[64, int], tr_cnt: var array[1, int], fd_name: var array[256, int], fd_priv: var array[256, int], fd_owner: var array[256, int], fd_cnt: var array[1, int], tm_name: var array[256, int], tm_owner: var array[256, int], tm_cnt: var array[1, int], ep_name: var array[256, int], ep_bnd: var array[256, int], ep_cnt: var array[1, int], im_ob: var array[64, ptr], im_fd_name: var array[256, ptr], im_fd_priv: var array[256, int], im_fd_owner: var array[256, int], im_ob_cnt: var array[1, int], im_fd_cnt: var array[1, int], pl_name: var array[256, int], pl_ty: var array[256, int], pl_n: var array[1, int]) -> int
  requires true
  ensures result == 1
  decreases 0
=
  var k: int = cur_kind(tk, n, pi, err)
  if k == 20:
    pi[0] = pi[0] + 1
    var vn: int = pi[0]
    pi[0] = pi[0] + 1
    expect_k(tk, n, pi, err, 56)
    var vt: int = ec_capture_type_tok(src, tk, ts, te, n, pi, err)
    if accept_k(tk, n, pi, err, 58) == 1:
      pl_check_expr(src, tk, ts, te, n, pi, err, 0, cur, ob_name, ob_cnt, tr_name, tr_cnt, fd_name, fd_priv, fd_owner, fd_cnt, tm_name, tm_owner, tm_cnt, ep_name, ep_bnd, ep_cnt, im_ob, im_fd_name, im_fd_priv, im_fd_owner, im_ob_cnt, im_fd_cnt, pl_name, pl_ty, pl_n)
    pl_add_local(pl_name, pl_ty, pl_n, vn, vt)
    return 1
  if k == 4:
    if tok_is(src, ts, te, pi[0], "borrow") == 1:
      pi[0] = pi[0] + 1
      if cur_kind(tk, n, pi, err) == 4:
        if tok_is(src, ts, te, pi[0], "mut") == 1:
          pi[0] = pi[0] + 1
        else:
          if tok_is(src, ts, te, pi[0], "imm") == 1:
            pi[0] = pi[0] + 1
      pi[0] = pi[0] + 1
      expect_k(tk, n, pi, err, 58)
      pl_check_expr(src, tk, ts, te, n, pi, err, 0, cur, ob_name, ob_cnt, tr_name, tr_cnt, fd_name, fd_priv, fd_owner, fd_cnt, tm_name, tm_owner, tm_cnt, ep_name, ep_bnd, ep_cnt, im_ob, im_fd_name, im_fd_priv, im_fd_owner, im_ob_cnt, im_fd_cnt, pl_name, pl_ty, pl_n)
      return 1
    if tok_is(src, ts, te, pi[0], "discard") == 1:
      pi[0] = pi[0] + 1
      return 1
  if k == 30:
    pi[0] = pi[0] + 1
    if cur_kind(tk, n, pi, err) != 1:
      if cur_kind(tk, n, pi, err) != 3:
        if cur_kind(tk, n, pi, err) != 0:
          pl_check_expr(src, tk, ts, te, n, pi, err, 0, cur, ob_name, ob_cnt, tr_name, tr_cnt, fd_name, fd_priv, fd_owner, fd_cnt, tm_name, tm_owner, tm_cnt, ep_name, ep_bnd, ep_cnt, im_ob, im_fd_name, im_fd_priv, im_fd_owner, im_ob_cnt, im_fd_cnt, pl_name, pl_ty, pl_n)
    return 1
  if k == 22:
    pi[0] = pi[0] + 1
    pl_check_expr(src, tk, ts, te, n, pi, err, 0, cur, ob_name, ob_cnt, tr_name, tr_cnt, fd_name, fd_priv, fd_owner, fd_cnt, tm_name, tm_owner, tm_cnt, ep_name, ep_bnd, ep_cnt, im_ob, im_fd_name, im_fd_priv, im_fd_owner, im_ob_cnt, im_fd_cnt, pl_name, pl_ty, pl_n)
    expect_k(tk, n, pi, err, 56)
    skip_newlines(tk, n, pi, err)
    pl_check_block(src, tk, ts, te, n, pi, err, ob_name, ob_cnt, tr_name, tr_cnt, fd_name, fd_priv, fd_owner, fd_cnt, tm_name, tm_owner, tm_cnt, ep_name, ep_bnd, ep_cnt, im_ob, im_fd_name, im_fd_priv, im_fd_owner, im_ob_cnt, im_fd_cnt, pl_name, pl_ty, pl_n)
    var tail_done: int = 0
    while tail_done == 0:
      skip_newlines(tk, n, pi, err)
      if cur_kind(tk, n, pi, err) == 24:
        pi[0] = pi[0] + 1
        parse_expr(src, tk, ts, te, n, pi, err, 0, 0)
        expect_k(tk, n, pi, err, 56)
        skip_newlines(tk, n, pi, err)
        pl_check_block(src, tk, ts, te, n, pi, err, ob_name, ob_cnt, tr_name, tr_cnt, fd_name, fd_priv, fd_owner, fd_cnt, tm_name, tm_owner, tm_cnt, ep_name, ep_bnd, ep_cnt, im_ob, im_fd_name, im_fd_priv, im_fd_owner, im_ob_cnt, im_fd_cnt, pl_name, pl_ty, pl_n)
      else:
        if cur_kind(tk, n, pi, err) == 23:
          pi[0] = pi[0] + 1
          expect_k(tk, n, pi, err, 56)
          skip_newlines(tk, n, pi, err)
          pl_check_block(src, tk, ts, te, n, pi, err, ob_name, ob_cnt, tr_name, tr_cnt, fd_name, fd_priv, fd_owner, fd_cnt, tm_name, tm_owner, tm_cnt, ep_name, ep_bnd, ep_cnt, im_ob, im_fd_name, im_fd_priv, im_fd_owner, im_ob_cnt, im_fd_cnt, pl_name, pl_ty, pl_n)
          tail_done = 1
        else:
          tail_done = 1
    return 1
  if k == 25 or k == 26 or k == 27 or k == 28 or k == 76:
    parse_stmt(src, tk, ts, te, n, pi, err, 0)
    return 1
  if k == 4:
    if tok_is(src, ts, te, pi[0], "parallel") == 1:
      parse_stmt(src, tk, ts, te, n, pi, err, 0)
      return 1
  var save: int = pi[0]
  var ok: int = parse_primary(src, tk, ts, te, n, pi, err, 0)
  if ok == 1:
    ok = parse_postfix(src, tk, ts, te, n, pi, err, 0)
  if ok == 1:
    if accept_k(tk, n, pi, err, 58) == 1:
      pl_check_expr(src, tk, ts, te, n, pi, err, 0, cur, ob_name, ob_cnt, tr_name, tr_cnt, fd_name, fd_priv, fd_owner, fd_cnt, tm_name, tm_owner, tm_cnt, ep_name, ep_bnd, ep_cnt, im_ob, im_fd_name, im_fd_priv, im_fd_owner, im_ob_cnt, im_fd_cnt, pl_name, pl_ty, pl_n)
      return 1
  pi[0] = save
  pl_check_expr(src, tk, ts, te, n, pi, err, 0, cur, ob_name, ob_cnt, tr_name, tr_cnt, fd_name, fd_priv, fd_owner, fd_cnt, tm_name, tm_owner, tm_cnt, ep_name, ep_bnd, ep_cnt, im_ob, im_fd_name, im_fd_priv, im_fd_owner, im_ob_cnt, im_fd_cnt, pl_name, pl_ty, pl_n)
  return 1

def pl_scan_proc(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], ob_name: var array[256, int], ob_cnt: var array[1, int], tr_name: var array[64, int], tr_cnt: var array[1, int], fd_name: var array[256, int], fd_priv: var array[256, int], fd_owner: var array[256, int], fd_cnt: var array[1, int], tm_name: var array[256, int], tm_owner: var array[256, int], tm_cnt: var array[1, int], im_ob: var array[64, ptr], im_fd_name: var array[256, ptr], im_fd_priv: var array[256, int], im_fd_owner: var array[256, int], im_ob_cnt: var array[1, int], im_fd_cnt: var array[1, int], ep_name: var array[256, int], ep_bnd: var array[256, int], ep_cnt: var array[1, int]) -> int
  requires true
  ensures result == 1
  decreases 0
=
  var pl_name: array[256, int]
  var pl_ty: array[256, int]
  var pl_n: array[1, int]
  pl_n[0] = 0
  if cur_kind(tk, n, pi, err) != 4:
    return 1
  pi[0] = pi[0] + 1
  fx_skip_typeparams(tk, n, pi, err)
  expect_k(tk, n, pi, err, 49)
  skip_param_layout(tk, n, pi, err)
  if cur_kind(tk, n, pi, err) != 50:
    var done: int = 0
    while done == 0:
      skip_param_layout(tk, n, pi, err)
      if cur_kind(tk, n, pi, err) == 4:
        var pn: int = pi[0]
        pi[0] = pi[0] + 1
        expect_k(tk, n, pi, err, 56)
        var pt: int = ec_capture_type_tok(src, tk, ts, te, n, pi, err)
        pl_add_local(pl_name, pl_ty, pl_n, pn, pt)
      skip_param_layout(tk, n, pi, err)
      if accept_k(tk, n, pi, err, 55) == 1:
        done = 0
      else:
        done = 1
  skip_param_layout(tk, n, pi, err)
  expect_k(tk, n, pi, err, 50)
  tc_skip_raises(tk, n, pi, err)
  if accept_k(tk, n, pi, err, 57) == 1:
    parse_type(src, tk, ts, te, n, pi, err, 0)
  tc_skip_raises(tk, n, pi, err)
  while 1 == 1:
    var ck: int = cur_kind(tk, n, pi, err)
    if ck == 41 or ck == 42 or ck == 43 or ck == 44 or ck == 45:
      parse_contract(src, tk, ts, te, n, pi, err, 0)
      continue
    break
  skip_newlines(tk, n, pi, err)
  if accept_k(tk, n, pi, err, 58) == 1:
    skip_newlines(tk, n, pi, err)
    if cur_kind(tk, n, pi, err) == 2:
      pl_check_block(src, tk, ts, te, n, pi, err, ob_name, ob_cnt, tr_name, tr_cnt, fd_name, fd_priv, fd_owner, fd_cnt, tm_name, tm_owner, tm_cnt, ep_name, ep_bnd, ep_cnt, im_ob, im_fd_name, im_fd_priv, im_fd_owner, im_ob_cnt, im_fd_cnt, pl_name, pl_ty, pl_n)
  return 1

def ec_skip_body(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int]) -> int
  requires true
  ensures result == 1
  decreases 0
=
  skip_newlines(tk, n, pi, err)
  if accept_k(tk, n, pi, err, 58) == 1:
    skip_newlines(tk, n, pi, err)
    parse_block(src, tk, ts, te, n, pi, err, 0)
  return 1

def encap_check(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int]) raises IO -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  var ob_name: array[256, int]
  var ob_base: array[256, int]
  var ob_cnt: array[1, int]
  var tr_name: array[64, int]
  var tr_cnt: array[1, int]
  var fd_name: array[256, int]
  var fd_priv: array[256, int]
  var fd_type: array[256, int]
  var fd_owner: array[256, int]
  var fd_cnt: array[1, int]
  var tm_name: array[256, int]
  var tm_owner: array[256, int]
  var tm_cnt: array[1, int]
  var ep_name: array[256, int]
  var ep_priv: array[256, int]
  var ep_self: array[256, int]
  var ep_ret: array[256, int]
  var ep_bnd: array[256, int]
  var ep_ovr: array[256, int]
  var ep_cnt: array[1, int]
  var im_ob: array[64, ptr]
  var im_fd_name: array[256, ptr]
  var im_fd_priv: array[256, int]
  var im_fd_owner: array[256, int]
  var im_ob_cnt: array[1, int]
  var im_fd_cnt: array[1, int]
  ob_cnt[0] = 0
  tr_cnt[0] = 0
  fd_cnt[0] = 0
  tm_cnt[0] = 0
  ep_cnt[0] = 0
  im_ob_cnt[0] = 0
  im_fd_cnt[0] = 0
  # Import merge: resolve each `import X` to a sibling X.li and collect its
  # object/field tables as text, so field-privacy checks see imported types.
  # The imported file is lexed into the shared arrays, collected, then the
  # main file is re-lexed back (the token stream is deterministic).
  pi[0] = 0
  skip_newlines(tk, n, pi, err)
  while cur_kind(tk, n, pi, err) != 0:
    if cur_kind(tk, n, pi, err) == 18:
      pi[0] = pi[0] + 1
      if cur_kind(tk, n, pi, err) == 4:
        var mod_tok: int = pi[0]
        pi[0] = pi[0] + 1
        var imp: ptr = li_rt_resolve_import(li_rt_argv(2), ec_tok_text(src, ts, te, mod_tok))
        if imp != 0:
          n[0] = 0
          var r1: int = lex_source(imp, tk, ts, te, n, 0)
          var pi2: array[1, int]
          pi2[0] = 0
          ec_collect_import_objects(imp, tk, ts, te, n, pi2, err, im_ob, im_fd_name, im_fd_priv, im_fd_owner, im_ob_cnt, im_fd_cnt)
          n[0] = 0
          var r2: int = lex_source(src, tk, ts, te, n, 0)
      skip_newlines(tk, n, pi, err)
      continue
    pi[0] = pi[0] + 1
  pi[0] = 0
  skip_newlines(tk, n, pi, err)
  while cur_kind(tk, n, pi, err) != 0:
    var k: int = cur_kind(tk, n, pi, err)
    if k == 18:
      parse_import(src, tk, ts, te, n, pi, err, 0)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 11:
      pi[0] = pi[0] + 1
      if cur_kind(tk, n, pi, err) != 4:
        err[0] = 1
        return 1
      var an: int = pi[0]
      pi[0] = pi[0] + 1
      fx_skip_typeparams(tk, n, pi, err)
      expect_k(tk, n, pi, err, 58)
      skip_newlines(tk, n, pi, err)
      if cur_kind(tk, n, pi, err) == 15:
        pi[0] = pi[0] + 1
        skip_newlines(tk, n, pi, err)
        var bt: int = -1
        if cur_kind(tk, n, pi, err) == 4:
          if tok_is(src, ts, te, pi[0], "of") == 1:
            pi[0] = pi[0] + 1
            if cur_kind(tk, n, pi, err) == 4:
              bt = pi[0]
              pi[0] = pi[0] + 1
            skip_newlines(tk, n, pi, err)
        var oi: int = ob_cnt[0]
        if oi < 64:
          ob_name[oi] = an
          ob_base[oi] = bt
          ob_cnt[0] = ob_cnt[0] + 1
        ec_parse_fields(src, tk, ts, te, n, pi, err, oi, fd_name, fd_priv, fd_type, fd_owner, fd_cnt)
      else:
        if cur_kind(tk, n, pi, err) == 4:
          if tok_is(src, ts, te, pi[0], "trait") == 1:
            pi[0] = pi[0] + 1
            var ti: int = tr_cnt[0]
            if ti < 64:
              tr_name[ti] = an
              tr_cnt[0] = tr_cnt[0] + 1
            ec_parse_trait_methods(src, tk, ts, te, n, pi, err, ti, tm_name, tm_owner, tm_cnt)
          else:
            tc_skip_alias_rhs(src, tk, ts, te, n, pi, err, fd_name, fd_priv, fd_type, fd_cnt)
        else:
          tc_skip_alias_rhs(src, tk, ts, te, n, pi, err, fd_name, fd_priv, fd_type, fd_cnt)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 76:
      var pend: array[1, int]
      pend[0] = 0
      var ovr: int = 0
      if peek_off(tk, n, pi, 1) == 4:
        if tok_is(src, ts, te, pi[0] + 1, "override") == 1:
          ovr = 1
      parse_decorator_list(src, tk, ts, te, n, pi, err, 0)
      if cur_kind(tk, n, pi, err) == 16 or cur_kind(tk, n, pi, err) == 17:
        pi[0] = pi[0] + 1
      if cur_kind(tk, n, pi, err) == 10 or cur_kind(tk, n, pi, err) == 9:
        pi[0] = pi[0] + 1
        ec_record_proc(src, tk, ts, te, n, pi, err, 0, ovr, ep_name, ep_priv, ep_self, ep_ret, ep_bnd, ep_ovr, ep_cnt)
        ec_skip_body(src, tk, ts, te, n, pi, err)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 16 or k == 17:
      var pv: int = 0
      if k == 16:
        pv = 1
      pi[0] = pi[0] + 1
      if cur_kind(tk, n, pi, err) == 10:
        pi[0] = pi[0] + 1
        ec_record_proc(src, tk, ts, te, n, pi, err, pv, 0, ep_name, ep_priv, ep_self, ep_ret, ep_bnd, ep_ovr, ep_cnt)
        ec_skip_body(src, tk, ts, te, n, pi, err)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 10:
      pi[0] = pi[0] + 1
      ec_record_proc(src, tk, ts, te, n, pi, err, 0, 0, ep_name, ep_priv, ep_self, ep_ret, ep_bnd, ep_ovr, ep_cnt)
      ec_skip_body(src, tk, ts, te, n, pi, err)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 32:
      pi[0] = pi[0] + 1
      if cur_kind(tk, n, pi, err) == 10:
        pi[0] = pi[0] + 1
        ec_record_proc(src, tk, ts, te, n, pi, err, 0, 0, ep_name, ep_priv, ep_self, ep_ret, ep_bnd, ep_ovr, ep_cnt)
      else:
        if cur_kind(tk, n, pi, err) == 9:
          err[0] = 1
          li_rt_emit_err(900)
          pi[0] = pi[0] + 1
          skip_newlines(tk, n, pi, err)
          while cur_kind(tk, n, pi, err) != 0:
            if cur_kind(tk, n, pi, err) == 11 or cur_kind(tk, n, pi, err) == 10 or cur_kind(tk, n, pi, err) == 16 or cur_kind(tk, n, pi, err) == 17 or cur_kind(tk, n, pi, err) == 18 or cur_kind(tk, n, pi, err) == 32 or cur_kind(tk, n, pi, err) == 33 or cur_kind(tk, n, pi, err) == 76 or cur_kind(tk, n, pi, err) == 9 or cur_kind(tk, n, pi, err) == 13 or cur_kind(tk, n, pi, err) == 12 or cur_kind(tk, n, pi, err) == 14:
              break
            pi[0] = pi[0] + 1
          continue
        else:
          err[0] = 1
          return 1
      skip_newlines(tk, n, pi, err)
      continue
    if k == 33:
      pi[0] = pi[0] + 1
      if cur_kind(tk, n, pi, err) == 10:
        pi[0] = pi[0] + 1
        ec_record_proc(src, tk, ts, te, n, pi, err, 0, 0, ep_name, ep_priv, ep_self, ep_ret, ep_bnd, ep_ovr, ep_cnt)
        ec_skip_body(src, tk, ts, te, n, pi, err)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 9:
      err[0] = 1
      li_rt_emit_err(900)
      li_rt_emit_err(900)
      pi[0] = pi[0] + 1
      skip_newlines(tk, n, pi, err)
      while cur_kind(tk, n, pi, err) != 0:
        if cur_kind(tk, n, pi, err) == 11 or cur_kind(tk, n, pi, err) == 10 or cur_kind(tk, n, pi, err) == 16 or cur_kind(tk, n, pi, err) == 17 or cur_kind(tk, n, pi, err) == 18 or cur_kind(tk, n, pi, err) == 32 or cur_kind(tk, n, pi, err) == 33 or cur_kind(tk, n, pi, err) == 76 or cur_kind(tk, n, pi, err) == 9 or cur_kind(tk, n, pi, err) == 13 or cur_kind(tk, n, pi, err) == 12 or cur_kind(tk, n, pi, err) == 14:
          break
        pi[0] = pi[0] + 1
      continue
    if k == 13 or k == 12 or k == 14:
      parse_theorem(src, tk, ts, te, n, pi, err, 0, 0, 0)
      skip_newlines(tk, n, pi, err)
      continue
    err[0] = 1
    return 1
  # Post-pass: inheritance layout + override + W0401.
  var o: int = 0
  while o < ob_cnt[0]:
    if ob_base[o] >= 0:
      var bo: int = ec_find_obj(src, ts, te, ob_name, ob_cnt, ob_base[o])
      if bo >= 0:
        var f: int = 0
        while f < fd_cnt[0]:
          if fd_owner[f] == o:
            var bf: int = ec_field_idx(src, ts, te, fd_name, fd_owner, fd_cnt, bo, fd_name[f])
            if bf >= 0:
              if tok_eq(src, ts, te, fd_type[f], peek256(fd_type, bf)) == 0:
                err[0] = 1
                li_rt_emit_err(900)
          f = f + 1
    o = o + 1
  o = 0
  while o < ep_cnt[0]:
    if ep_ovr[o] == 1:
      var us: int = ec_underscore(src, ts, te, ep_name[o])
      if us <= 0:
        err[0] = 1
        li_rt_emit_err(900)
      else:
        var aidx: int = -1
        var q: int = 0
        while q < ob_cnt[0]:
          if ec_has_prefix_join(src, ts, te, ob_name[q], ep_name[o]) == 1:
            aidx = q
          q = q + 1
        if aidx < 0:
          err[0] = 1
          li_rt_emit_err(900)
        else:
          if peek256(ob_base, aidx) < 0:
            err[0] = 1
            li_rt_emit_err(900)
          else:
            var gidx: int = -1
            q = 0
            while q < ep_cnt[0]:
              if q != o:
                if ec_same_suffix(src, ts, te, peek256(ob_name, aidx), peek256(ob_base, aidx), ep_name[o], ep_name[q]) == 1:
                  gidx = q
              q = q + 1
            if gidx < 0:
              err[0] = 1
              li_rt_emit_err(900)
            else:
              if ep_self[o] != -1:
                if peek256(ep_self, gidx) == -1:
                  err[0] = 1
                  li_rt_emit_err(900)
                else:
                  if tok_eq(src, ts, te, ep_self[o], peek256(ep_self, gidx)) == 0:
                    err[0] = 1
                    li_rt_emit_err(900)
              else:
                if peek256(ep_self, gidx) != -1:
                  err[0] = 1
                  li_rt_emit_err(900)
              if ep_ret[o] != -1:
                if peek256(ep_ret, gidx) == -1:
                  err[0] = 1
                  li_rt_emit_err(900)
                else:
                  if tok_eq(src, ts, te, ep_ret[o], peek256(ep_ret, gidx)) == 0:
                    err[0] = 1
                    li_rt_emit_err(900)
              else:
                if peek256(ep_ret, gidx) != -1:
                  err[0] = 1
                  li_rt_emit_err(900)
    o = o + 1
  # W0401: unused imports.
  pi[0] = 0
  skip_newlines(tk, n, pi, err)
  while cur_kind(tk, n, pi, err) != 0:
    if cur_kind(tk, n, pi, err) == 18:
      pi[0] = pi[0] + 1
      var bt2: int = -1
      if cur_kind(tk, n, pi, err) == 4:
        bt2 = pi[0]
        pi[0] = pi[0] + 1
        while accept_k(tk, n, pi, err, 72) == 1:
          if cur_kind(tk, n, pi, err) == 4:
            bt2 = pi[0]
            pi[0] = pi[0] + 1
        if cur_kind(tk, n, pi, err) == 4:
          if tok_is(src, ts, te, pi[0], "as") == 1:
            pi[0] = pi[0] + 1
            if cur_kind(tk, n, pi, err) == 4:
              bt2 = pi[0]
              pi[0] = pi[0] + 1
      if bt2 >= 0:
        if ec_ident_used(src, tk, ts, te, n, bt2) == 0:
          li_rt_emit_err(401)
      skip_newlines(tk, n, pi, err)
      continue
    pi[0] = pi[0] + 1
  # Policy scan: field privacy, method existence, trait bounds (needs the
  # complete object/field/proc/trait tables, so it runs after the collection
  # passes above).
  pi[0] = 0
  skip_newlines(tk, n, pi, err)
  while cur_kind(tk, n, pi, err) != 0:
    var k: int = cur_kind(tk, n, pi, err)
    if k == 18:
      parse_import(src, tk, ts, te, n, pi, err, 0)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 11:
      pi[0] = pi[0] + 1
      if cur_kind(tk, n, pi, err) != 4:
        err[0] = 1
        return 1
      pi[0] = pi[0] + 1
      fx_skip_typeparams(tk, n, pi, err)
      expect_k(tk, n, pi, err, 58)
      tc_skip_alias_rhs(src, tk, ts, te, n, pi, err, fd_name, fd_priv, fd_type, fd_cnt)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 76:
      parse_decorator_list(src, tk, ts, te, n, pi, err, 0)
      if cur_kind(tk, n, pi, err) == 16 or cur_kind(tk, n, pi, err) == 17:
        pi[0] = pi[0] + 1
      if cur_kind(tk, n, pi, err) == 10 or cur_kind(tk, n, pi, err) == 9:
        pi[0] = pi[0] + 1
        pl_scan_proc(src, tk, ts, te, n, pi, err, ob_name, ob_cnt, tr_name, tr_cnt, fd_name, fd_priv, fd_owner, fd_cnt, tm_name, tm_owner, tm_cnt, im_ob, im_fd_name, im_fd_priv, im_fd_owner, im_ob_cnt, im_fd_cnt, ep_name, ep_bnd, ep_cnt)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 16 or k == 17:
      pi[0] = pi[0] + 1
      if cur_kind(tk, n, pi, err) == 10:
        pi[0] = pi[0] + 1
        pl_scan_proc(src, tk, ts, te, n, pi, err, ob_name, ob_cnt, tr_name, tr_cnt, fd_name, fd_priv, fd_owner, fd_cnt, tm_name, tm_owner, tm_cnt, im_ob, im_fd_name, im_fd_priv, im_fd_owner, im_ob_cnt, im_fd_cnt, ep_name, ep_bnd, ep_cnt)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 10 or k == 33:
      pi[0] = pi[0] + 1
      if k == 33:
        if cur_kind(tk, n, pi, err) == 10:
          pi[0] = pi[0] + 1
      pl_scan_proc(src, tk, ts, te, n, pi, err, ob_name, ob_cnt, tr_name, tr_cnt, fd_name, fd_priv, fd_owner, fd_cnt, tm_name, tm_owner, tm_cnt, im_ob, im_fd_name, im_fd_priv, im_fd_owner, im_ob_cnt, im_fd_cnt, ep_name, ep_bnd, ep_cnt)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 32:
      pi[0] = pi[0] + 1
      if cur_kind(tk, n, pi, err) == 10:
        pi[0] = pi[0] + 1
        pl_scan_proc(src, tk, ts, te, n, pi, err, ob_name, ob_cnt, tr_name, tr_cnt, fd_name, fd_priv, fd_owner, fd_cnt, tm_name, tm_owner, tm_cnt, im_ob, im_fd_name, im_fd_priv, im_fd_owner, im_ob_cnt, im_fd_cnt, ep_name, ep_bnd, ep_cnt)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 13 or k == 12 or k == 14:
      parse_theorem(src, tk, ts, te, n, pi, err, 0, 0, 0)
      skip_newlines(tk, n, pi, err)
      continue
    pi[0] = pi[0] + 1
  return 0

# ---------------------------------------------------------------- driver --

def parse_file(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], d: int, emit_tok: int) raises IO -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  var r: int = lex_source(src, tk, ts, te, n, emit_tok)
  if r == 1:
    return 1
  parse_module(src, tk, ts, te, n, pi, err, d)
  if err[0] == 1:
    return 1
  return 0

# ================= Layer 5: MIR lowering (`mir <file>`) =====================
# Byte-exact port of compiler/mir/lower.cpp for the scalar slice, gated by
# scripts/check_li_mir_parity.sh against the C++ `lic mir` dump. The walk
# mirrors parse_module/parse_proc/parse_stmt/parse_expr but emits INS/ARG/PARAM
# lines. The module-global temp counter (tc) is shared across all functions
# like lower_to_mir's temp_counter; labels consume the same counter.
# Float literals are parsed into the runtime table (ids), never held as Li
# doubles. Names are represented as (s, e, code) triples: code 0 empty, code 1
# source slice, code 2 counter-name (prefix code in e: 0=__t 1=else_ 2=merge_
# 3=while_head_ 4=while_exit_ 5=for_head_ 6=for_exit_).
#
# Descriptor arena (6 ints per record):
#   0=int-lit [v, s, e] | 1=float-lit [fid, s, e] | 2=str-lit [cs, ce, -]
#   3=ident [s, e, -] | 4=call [cs, ce, args_start, argc]
#   5=index [base, index] | 6=unary-not [operand]
#   7=binop [opk, lhs, rhs] | 8=name [is_tmp, v1, v2] (src: v1=s v2=e; tmp: v1=c)

# ---- text / name helpers ----
def mir_slice_eq(src: var ptr,  s1: int,  e1: int,  s2: int,  e2: int) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  if e1 - s1 != e2 - s2:
    return 0
  var k: int = 0
  while k < e1 - s1:
    if li_rt_str_char_at(src,  s1 + k) != li_rt_str_char_at(src,  s2 + k):
      return 0
    k = k + 1
  return 1

# Is the name [s,e) one of the float source names (token indices in ftok)?
def mir_name_float(src: var ptr,  ts: var array[262144, int],  te: var array[262144, int], s: int,  e: int,  ftok: var array[4096, int],  nft: var array[1, int]) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  var k: int = 0
  while k < nft[0]:
    if mir_slice_eq(src,  s,  e,  peek_tk(ts, peek4096(ftok, k + 0) + 0),  peek_tk(te, peek4096(ftok, k + 0) + 0)) == 1:
      return 1
    k = k + 1
  return 0

# Is the name [s,e) one of the i64 source names (token indices in itok)?
def mir_name_farray(src: var ptr,  ts: var array[262144, int],  te: var array[262144, int], s: int,  e: int,  fatok: var array[512, int],  nfa: var array[1, int]) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  var k: int = 0
  while k < nfa[0]:
    if mir_slice_eq(src,  s,  e,  peek_tk(ts, peek512(fatok, 2 * k + 0) + 0),  peek_tk(te, peek512(fatok, 2 * k + 0) + 0)) == 1:
      return 1
    k = k + 1
  return 0

# Local matrix names use a side table in fatok[62], separate from the
# float-array and int-array tables. This lets nested matrix loads participate
# in float classification without pretending the matrix is a 1D array.
def mir_name_matrix_local(src: var ptr, ts: var array[262144, int], te: var array[262144, int], s: int, e: int, fatok: var array[512, int]) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  var nm: int = peek512(fatok, 62)
  var k: int = 0
  while k < nm:
    if mir_slice_eq(src, s, e, peek_tk(ts, peek512(fatok, 64 + k * 2) + 0), peek_tk(te, peek512(fatok, 64 + k * 2) + 0)) == 1:
      return 1
    k = k + 1
  return 0

# Size of the 1D float array named [s,e) (from the proc/param tables), else 0.
# Mirrors the C++ `float_array_sizes` map seeded by seed_float_array_params.
def mir_farray_size(src: var ptr,  ts: var array[262144, int],  te: var array[262144, int], s: int,  e: int,  ptok2: var array[512, int],  pelems: var array[512, int],  pef: var array[512, int],  pp0: var array[128, int],  ppn: var array[128, int],  pn: var array[1, int],  fatok: var array[512, int],  nfa: var array[1, int]) -> int
  requires true
  ensures result >= 0
  decreases 0
=
  # Float-array size lookup is scoped to the CURRENT proc only: the emit pass
  # registers the current proc's float-array params + locals in fatok before
  # lowering bodies (2-slot encoding: [name, size] per entry). Scanning all
  # procs' params would leak e.g. `r: var array[8,float]` from another proc
  # into a scalar `r` here, wrongly firing the array-scale path.
  var k: int = 0
  while k < nfa[0]:
    if mir_slice_eq(src,  s,  e,  peek_tk(ts, peek512(fatok, 2 * k + 0) + 0),  peek_tk(te, peek512(fatok, 2 * k + 0) + 0)) == 1:
      return peek512(fatok, 2 * k + 1)
    k = k + 1
  return 0

# Read the float-array size stored in ftmp for a temp node (kind 1 or 8).
# Returns the element count if the temp is a registered float array, else 0.
def mir_farray_tmp_size(darena: var array[65536, int], rec: int, ftmp: var array[32768, int]) -> int
  requires true
  ensures result >= 0
  decreases 0
=
  var k: int = peek65536(darena, rec + 0)
  if k == 1:
    var v: int = peek32768(ftmp, peek65536(darena, rec + 2))
    if v > 1:
      return v
    return 0
  if k == 8:
    if peek65536(darena, rec + 1) == 1:
      var v2: int = peek32768(ftmp, peek65536(darena, rec + 2))
      if v2 > 1:
        return v2
    return 0
  return 0

# Look up the element count for a local int array.
# Int array entries are stored in fatok after float entries:
#   fatok[0..2*nfa-1] = float arrays, fatok[2*nfa..2*nfa+2*nia-1] = int arrays
# nia (int array count) is stored at fatok[63].
def mir_iarray_size(src: var ptr,  ts: var array[262144, int],  te: var array[262144, int], s: int,  e: int,  fatok: var array[512, int],  nfa: var array[1, int]) -> int
  requires true
  ensures result >= 0
  decreases 0
=
  var nia_v: int = peek512(fatok, 63)
  var base: int = 2 * nfa[0]
  var k: int = 0
  while k < nia_v:
    if mir_slice_eq(src,  s,  e,  peek_tk(ts, peek512(fatok, base + 2 * k) + 0),  peek_tk(te, peek512(fatok, base + 2 * k) + 0)) == 1:
      return peek512(fatok, base + 2 * k + 1)
    k = k + 1
  return 0

# Is the name [s,e) one of the local matrix names (token indices in matok)?
# matok stores triples: (name_token, rows, cols) for each matrix.
# The C++ matrix_names set holds only local (var-declared) matrices; matrix
# params are not seeded, so 2D loads/stores on params fall through to no-emit.
def mir_name_matrix(src: var ptr,  ts: var array[262144, int],  te: var array[262144, int], s: int,  e: int,  matok: var array[512, int],  nmat: var array[1, int]) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  var k: int = 0
  while k < nmat[0]:
    if mir_slice_eq(src,  s,  e,  peek_tk(ts, peek512(matok, k * 3) + 0),  peek_tk(te, peek512(matok, k * 3) + 0)) == 1:
      return 1
    k = k + 1
  return 0

# Look up matrix dims for name [s,e). Returns rows via ret[0], cols via ret[1].
# Returns 1 if found, 0 if not.
def mir_mat_dims(src: var ptr,  ts: var array[262144, int],  te: var array[262144, int], s: int,  e: int,  matok: var array[512, int],  nmat: var array[1, int], ret: var array[2, int]) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  var k: int = 0
  while k < nmat[0]:
    if mir_slice_eq(src,  s,  e,  peek_tk(ts, peek512(matok, k * 3) + 0),  peek_tk(te, peek512(matok, k * 3) + 0)) == 1:
      ret[0] = peek512(matok, k * 3 + 1)
      ret[1] = peek512(matok, k * 3 + 2)
      return 1
    k = k + 1
  return 0

# Resolve matrix dimensions for an expression descriptor. Source identifiers
# use the normal token-keyed matrix table; a kind-8 temporary uses a negative
# key (-1-temp_id), allowing chained `(A @ B) @ D` lowering.
def mir_mat_operand_dims(darena: var array[65536, int], rec: int, src: var ptr, ts: var array[262144, int], te: var array[262144, int], matok: var array[512, int], nmat: var array[1, int], ret: var array[2, int]) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  if peek65536(darena, rec + 0) == 3:
    return mir_mat_dims(src, ts, te, peek65536(darena, rec + 1), peek65536(darena, rec + 2), matok, nmat, ret)
  if peek65536(darena, rec + 0) == 8:
    if peek65536(darena, rec + 1) == 1:
      var tid: int = peek65536(darena, rec + 2)
      var k: int = 0
      while k < nmat[0]:
        if peek512(matok, k * 3 + 0) == 0 - tid - 1:
          ret[0] = peek512(matok, k * 3 + 1)
          ret[1] = peek512(matok, k * 3 + 2)
          return 1
        k = k + 1
  return 0

def mir_name_i64(src: var ptr,  ts: var array[262144, int],  te: var array[262144, int], s: int,  e: int,  itok: var array[4096, int],  nit: var array[1, int]) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  var k: int = 0
  while k < nit[0]:
    if mir_slice_eq(src,  s,  e,  peek_tk(ts, peek4096(itok, k + 0) + 0),  peek_tk(te, peek4096(itok, k + 0) + 0)) == 1:
      return 1
    k = k + 1
  return 0

# ---- descriptor arena ----
def d_alloc(darena: var array[65536, int],  dasp: var array[1, int],  kind: int, v1: int,  v2: int,  v3: int) -> int
  requires true
  ensures result >= 0
  decreases 0
=
  var rec: int = dasp[0]
  set65536(darena, rec + 0,kind)
  set65536(darena, rec + 1,v1)
  set65536(darena, rec + 2,v2)
  set65536(darena, rec + 3,v3)
  set65536(darena, rec + 4,-1)
  set65536(darena, rec + 5,-1)
  dasp[0] = rec + 6
  return rec

# ---- Object type registry (stored in itmp 3000..3999) ----
# itmp[3000] = nobj (number of object types)
# itmp[3001 + i*6 + 0] = type name tok start
# itmp[3001 + i*6 + 1] = type name tok end
# itmp[3001 + i*6 + 2] = number of fields
# itmp[3001 + i*6 + 3] = fields base index in objflds array
# itmp[3001 + i*6 + 4] = base type tok start (-1 if none)
# itmp[3001 + i*6 + 5] = base type tok end
# itmp[3200] = nfield (number of registered fields)
# itmp[3201 + j*2 + 0] = field name tok start
# itmp[3201 + j*2 + 1] = field name tok end
# itmp[3401 + j] = field float bit
# itmp[3501 + j] = fixed-array element count
# itmp[3601 + j*2 + 0] = field declared type-name tok start (object types)
# itmp[3601 + j*2 + 1] = field declared type-name tok end
# itmp[3300] = nobjvar (number of registered object variables)
# itmp[3301 + k*3 + 0] = var name tok start
# itmp[3301 + k*3 + 1] = var name tok end
# itmp[3301 + k*3 + 2] = type index (into object type registry)

# Emit INS with a mangled name like __li_o_<base>_<field>
# format: INS op iv 0 <mangled_name>      0 0 0 1  0 <flags> ...
def mir_ins_mangled(src: var ptr, op: int, iv: int, base_s: int, base_e: int, fld_s: int, fld_e: int, flag1: int, flag2: int, val: int, lastop: var array[1, int], rhs_s: int, rhs_e: int, rhs_t: int, rhs_p_s: int, rhs_p_e: int, rhs_f_s: int, rhs_f_e: int, fld_src_fallback: int, arr_flt: int) raises IO -> int
  requires true
  ensures result == 0
  decreases 0
=
  li_rt_mir_str("INS")
  li_rt_ast_space()
  li_rt_ast_int(op)
  li_rt_ast_space()
  li_rt_ast_int(iv)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_mir_str("__li_o_")
  li_rt_mir_esc(src, base_s, base_e)
  li_rt_mir_str("_")
  # Field name slices: the alloc/copy paths read type-declared field positions
  # that are relative to the type's defining file, which the caller stored in
  # the -1 type-source slot. But user-written field access/stores (out.detail,
  # fld_src_fallback != 0) carry offsets relative to this caller's src buffer,
  # regardless of where the object type is declared - so they must read from src.
  # Reading them from -1 picks up whatever unrelated type was last registered,
  # which for an imported-typed local object is the wrong buffer (NUL/garbage,
  # and it shifts across runs). Honor the caller's src for the fallback flag.
  if fld_src_fallback == 1:
    li_rt_mir_esc(src, fld_s, fld_e)
  else:
    var fs2: ptr = li_rt_type_src_get(-1)
    if fs2 == 0:
      li_rt_mir_esc(src, fld_s, fld_e)
    else:
      li_rt_mir_esc(fs2, fld_s, fld_e)
  # empty name cells: str_value, callee, lhs_ident (each needs its own
  # separator space, so 4 spaces land before rhs_ident like C++ mir_dump)
  li_rt_ast_space()
  li_rt_ast_space()
  li_rt_ast_space()
  li_rt_ast_space()
  # rhs_ident: plain source ident, scalar lowered temp, object call result,
  # or a nested object field path. The negative encoding -2-crid is private
  # to this emitter and prints the aggregate call-result slot used by C++ MIR.
  if rhs_p_s >= 0:
    li_rt_mir_str("__li_o_")
    li_rt_mir_esc(src, rhs_s, rhs_e)
    li_rt_mir_str("_")
    li_rt_mir_esc(src, rhs_p_s, rhs_p_e)
    li_rt_mir_str("_")
    li_rt_mir_esc(src, rhs_f_s, rhs_f_e)
  else:
    if rhs_t >= 0:
      li_rt_mir_label(0, rhs_t)
    else:
      if rhs_t <= -2:
        li_rt_mir_str("__li_o___cr")
        li_rt_ast_int(-2 - rhs_t)
      else:
        if rhs_s >= 0:
          li_rt_mir_esc(src, rhs_s, rhs_e)
  # label cell (empty)
  li_rt_ast_space()
  # f18..f21
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(1)
  # name cell 6 (empty)
  li_rt_ast_space()
  # f25..f36
  li_rt_ast_space()
  li_rt_ast_int(flag1)
  li_rt_ast_space()
  li_rt_ast_int(flag2)
  li_rt_ast_space()
  # int_value cell: only literal RHS carries a value here (C++ prints 0 for
  # ident/nested sources). Parsing the ident span would leak any digits in
  # the variable name (d5 -> 5).
  li_rt_ast_int(val)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  # array_is_float cell: C++ mir_dump puts the float-array bit here; the
  # walker previously printed it in the trailing simd_lanes cell.
  li_rt_ast_int(arr_flt)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_nl()
  lastop[0] = op
  return 0

# Emit INS with a nested-object mangled name __li_o_<base>_<p>_<fld>
# (e.g. `s.swapchain.backend_id` -> __li_o_s_swapchain_backend_id). Same
# field layout as mir_ins_mangled; p_s/p_e is the parent object field.
def mir_ins_mangled_nested(src: var ptr, op: int, iv: int, base_s: int, base_e: int, p_s: int, p_e: int, fld_s: int, fld_e: int, flag1: int, flag2: int, val: int, lastop: var array[1, int], arr_flt: int) raises IO -> int
  requires true
  ensures result == 0
  decreases 0
=
  li_rt_mir_str("INS")
  li_rt_ast_space()
  li_rt_ast_int(op)
  li_rt_ast_space()
  li_rt_ast_int(iv)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_mir_str("__li_o_")
  li_rt_mir_esc(src, base_s, base_e)
  li_rt_mir_str("_")
  # Field positions are type-source-relative (captured by mir_obj_reg_field
  # against the type's defining file), so read p_s/p_e and fld_s/fld_e from
  # the type source stored during allocation, not the caller's src buffer.
  var nsrc2: ptr = li_rt_type_src_get(-1)
  if nsrc2 == 0:
    nsrc2 = src
  li_rt_mir_esc(nsrc2, p_s, p_e)
  li_rt_mir_str("_")
  li_rt_mir_esc(nsrc2, fld_s, fld_e)
  # empty name cells: str_value, callee, lhs_ident (4 spaces before rhs)
  li_rt_ast_space()
  li_rt_ast_space()
  li_rt_ast_space()
  li_rt_ast_space()
  # label cell (empty)
  li_rt_ast_space()
  # f18..f21
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(1)
  # name cell 6 (empty)
  li_rt_ast_space()
  # f25..f36
  li_rt_ast_space()
  li_rt_ast_int(flag1)
  li_rt_ast_space()
  li_rt_ast_int(flag2)
  li_rt_ast_space()
  li_rt_ast_int(val)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  # array_is_float cell (mirror mir_ins_mangled)
  li_rt_ast_int(arr_flt)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_nl()
  lastop[0] = op
  return 0

# Recursively emit LocalAlloc (INS 24/35/9) for every leaf field of an object
# type, flattening nested object fields into compound mangled slots. p_s/p_e
# is the enclosing object field name (-1 at the top level).
def mir_obj_alloc_fields(src: var ptr,  ts: var array[262144, int],  te: var array[262144, int], itmp: var array[4096, int],  base_s: int,  base_e: int,  type_idx: int,  p_s: int,  p_e: int, lastop: var array[1, int]) raises IO -> int
  requires true
  ensures result == 0
  decreases 0
=
  # Use the type definition's source for field name positions, not the caller's.
  var tsrc: ptr = li_rt_type_src_get(type_idx)
  if tsrc == 0:
    tsrc = src
  li_rt_type_src_store(-1, tsrc)
  var nf_a: int = mir_obj_field_count(itmp, type_idx)
  var i_a: int = 0
  var fa_a: array[2, int]
  while i_a < nf_a:
    mir_obj_field_name(itmp, type_idx, i_a, fa_a)
    var sub_a: int = mir_obj_field_obj_type(src, ts, te, itmp, type_idx, i_a)
    if sub_a >= 0:
      mir_obj_alloc_fields(src, ts, te, itmp, base_s, base_e, sub_a, fa_a[0], fa_a[1], lastop)
    else:
      var elems_a: int = mir_obj_field_elems(itmp, type_idx, i_a)
      if elems_a > 0:
        if p_s >= 0:
          mir_ins_mangled_nested(src, 9, elems_a, base_s, base_e, p_s, p_e, fa_a[0], fa_a[1], 0, 1, 0, lastop, mir_obj_field_float(itmp, type_idx, i_a))
        else:
          mir_ins_mangled(src, 9, elems_a, base_s, base_e, fa_a[0], fa_a[1], 0, 1, 0, lastop, -1, -1, -1, -1, -1, -1, -1, 0, mir_obj_field_float(itmp, type_idx, i_a))
      else:
        if mir_obj_field_float(itmp, type_idx, i_a) == 1:
          if p_s >= 0:
            mir_ins_mangled_nested(src, 35, 0, base_s, base_e, p_s, p_e, fa_a[0], fa_a[1], 0, 1, 0, lastop, 0)
          else:
            mir_ins_mangled(src, 35, 0, base_s, base_e, fa_a[0], fa_a[1], 0, 1, 0, lastop, -1, -1, -1, -1, -1, -1, -1, 0, 0)
        else:
          if p_s >= 0:
            mir_ins_mangled_nested(src, 24, 0, base_s, base_e, p_s, p_e, fa_a[0], fa_a[1], 0, 1, 0, lastop, 0)
          else:
            mir_ins_mangled(src, 24, 0, base_s, base_e, fa_a[0], fa_a[1], 0, 1, 0, lastop, -1, -1, -1, -1, -1, -1, -1, 0, 0)
    i_a = i_a + 1
  return 0

# Recursively emit LocalAlloc for a return-object cr<N> temp, flattening
# nested object fields: __li_o___cr<N>[_<parent>_]<leaf>.
def mir_cr_alloc_fields(src: var ptr,  ts: var array[262144, int],  te: var array[262144, int], itmp: var array[4096, int],  crid: int,  type_idx: int,  p_s: int,  p_e: int) raises IO -> int
  requires true
  ensures result == 0
  decreases 0
=
  var tsrc: ptr = li_rt_type_src_get(type_idx)
  if tsrc == 0:
    tsrc = src
  li_rt_type_src_store(-1, tsrc)
  var nf_c: int = mir_obj_field_count(itmp, type_idx)
  var i_c: int = 0
  var fa_c: array[2, int]
  while i_c < nf_c:
    mir_obj_field_name(itmp, type_idx, i_c, fa_c)
    var sub_c: int = mir_obj_field_obj_type(src, ts, te, itmp, type_idx, i_c)
    if sub_c >= 0:
      mir_cr_alloc_fields(src,  ts,  te,  itmp,  crid,  sub_c,  fa_c[0],  fa_c[1])
    else:
      var cop_c: int = 24
      var iv_c: int = 0
      if mir_obj_field_elems(itmp, type_idx, i_c) > 0:
        cop_c = 9
        iv_c = mir_obj_field_elems(itmp, type_idx, i_c)
      else:
        if mir_obj_field_float(itmp, type_idx, i_c) == 1:
          cop_c = 35
      var flt_c: int = 0
      if cop_c == 9:
        flt_c = mir_obj_field_float(itmp, type_idx, i_c)
      li_rt_mir_str("INS")
      li_rt_ast_space()
      li_rt_ast_int(cop_c)
      li_rt_ast_space()
      li_rt_ast_int(iv_c)
      li_rt_ast_space()
      li_rt_ast_int(0)
      li_rt_ast_space()
      li_rt_mir_str("__li_o___cr")
      li_rt_ast_int(crid)
      li_rt_mir_str("_")
      if p_s >= 0:
        li_rt_mir_esc(tsrc, p_s, p_e)
        li_rt_mir_str("_")
      li_rt_mir_esc(tsrc, fa_c[0], fa_c[1])
      # 5 empty name cells
      li_rt_ast_space()
      li_rt_ast_space()
      li_rt_ast_space()
      li_rt_ast_space()
      li_rt_ast_space()
      # f18..f21
      li_rt_ast_space()
      li_rt_ast_int(0)
      li_rt_ast_space()
      li_rt_ast_int(0)
      li_rt_ast_space()
      li_rt_ast_int(0)
      li_rt_ast_space()
      li_rt_ast_int(1)
      # name cell 6 (empty)
      li_rt_ast_space()
      # f25..f36
      li_rt_ast_space()
      li_rt_ast_int(0)
      li_rt_ast_space()
      li_rt_ast_int(1)
      li_rt_ast_space()
      li_rt_ast_int(0)
      li_rt_ast_space()
      li_rt_ast_int(0)
      li_rt_ast_space()
      li_rt_ast_int(0)
      li_rt_ast_space()
      li_rt_ast_int(0)
      li_rt_ast_space()
      li_rt_ast_int(0)
      li_rt_ast_space()
      li_rt_ast_int(flt_c)
      li_rt_ast_space()
      li_rt_ast_int(0)
      li_rt_ast_space()
      li_rt_ast_int(0)
      li_rt_ast_space()
      li_rt_ast_int(0)
      li_rt_ast_space()
      li_rt_ast_int(0)
      li_rt_ast_nl()
    i_c = i_c + 1
  return 0

# Emit the CallProc line for a call that returns an object: INS 8 with
# ident = __li_o___cr<crid>, callee name, then the OBJ return layout. The cr
# slot LocalAllocs are emitted by mir_cr_alloc_fields before this.
def mir_cr_call_line(src: var ptr,  ts: var array[262144, int],  te: var array[262144, int], itmp: var array[4096, int],  crid: int,  cal_s: int,  cal_e: int,  obj_ti: int,  lastop: var array[1, int]) raises IO -> int
  requires true
  ensures result == 0
  decreases 0
=
  li_rt_mir_str("INS")
  li_rt_ast_space()
  li_rt_ast_int(8)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_mir_str("__li_o___cr")
  li_rt_ast_int(crid)
  # str_value cell (empty), then callee name cell
  li_rt_ast_space()
  li_rt_ast_space()
  li_rt_mir_esc(src, cal_s, cal_e)
  # 3 empty name cells (lhs_ident, rhs_ident, label)
  li_rt_ast_space()
  li_rt_ast_space()
  li_rt_ast_space()
  # f18..f21
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(1)
  # name cell 6 (empty)
  li_rt_ast_space()
  # f25..f36
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(1)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_nl()
  lastop[0] = 8
  return 0

