      skip_newlines(tk, n, pi, err)
      continue
    break
  return 1

def parse_type_fields(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], d: int) -> int
  requires true
  ensures result == 1
  decreases 0
=
  skip_newlines(tk, n, pi, err)
  while 1 == 1:
    var k: int = cur_kind(tk, n, pi, err)
    if k != 16:
      if k != 17:
        if k != 4:
          break
        if peek_off(tk, n, pi, 1) != 56:
          break
    if k == 16:
      if peek_off(tk, n, pi, 1) == 10:
        break
    if k == 17:
      if peek_off(tk, n, pi, 1) == 10:
        break
    var vis: int = 0
    if k == 16:
      vis = 1
      pi[0] = pi[0] + 1
    else:
      if k == 17:
        pi[0] = pi[0] + 1
    if cur_kind(tk, n, pi, err) != 4:
      err[0] = 1
      break
    var fn: int = pi[0]
    pi[0] = pi[0] + 1
    expect_k(tk, n, pi, err, 56)
    # NotRequired[T] unwraps to T with optional=1 (mirrors the C++
    # parse_type_fields post-processing); a leading `var` on the outer type
    # is dropped exactly like the C++ unwrap of the first type argument.
    var opt: int = 0
    var is_nr: int = 0
    var pi0: int = pi[0]
    if cur_kind(tk, n, pi, err) == 20:
      pi0 = pi[0] + 1
    if peek_off(tk, n, pi, pi0 - pi[0]) == 4:
      if peek_off(tk, n, pi, pi0 - pi[0] + 1) == 51:
        if tok_is(src, ts, te, pi0, "NotRequired") == 1:
          is_nr = 1
          opt = 1
    if d == 1:
      a_line_text_ii(d, src, 27, peek_tk(ts, fn), peek_tk(te, fn), opt, vis)
    if is_nr == 1:
      if cur_kind(tk, n, pi, err) == 20:
        pi[0] = pi[0] + 1
      pi[0] = pi[0] + 1
      pi[0] = pi[0] + 1
      opt = 1
      parse_type(src, tk, ts, te, n, pi, err, d)
      while cur_kind(tk, n, pi, err) != 52:
        if accept_k(tk, n, pi, err, 55) == 1:
          parse_type(src, tk, ts, te, n, pi, err, 0)
        else:
          break
      expect_k(tk, n, pi, err, 52)
    else:
      parse_type(src, tk, ts, te, n, pi, err, d)
    skip_newlines(tk, n, pi, err)
  return 1

def emit_tp_lines(d: int, src: var ptr, ts: var array[262144, int], te: var array[262144, int], tbuf: var array[16, int], ntp: var array[1, int]) -> int
  requires true
  ensures result == 0
  decreases 0
=
  var ti: int = 0
  while ti < ntp[0]:
    if d == 1:
      a_line_text_t(d, src, 5, peek_tk(ts, tbuf[ti] + 0), peek_tk(te, tbuf[ti] + 0))
    ti = ti + 1
  return 0

def parse_type_alias(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], d: int) -> int
  requires true
  ensures result == 1
  decreases 0
=
  expect_k(tk, n, pi, err, 11)
  var an: int = pi[0]
  pi[0] = pi[0] + 1
  var tbuf: array[16, int]
  var ntp: array[1, int]
  ntp[0] = 0
  if accept_k(tk, n, pi, err, 51) == 1:
    if cur_kind(tk, n, pi, err) != 52:
      var done: int = 0
      while done == 0:
        if cur_kind(tk, n, pi, err) != 4:
          err[0] = 1
          break
        tbuf[ntp[0]] = pi[0]
        ntp[0] = ntp[0] + 1
        pi[0] = pi[0] + 1
        if accept_k(tk, n, pi, err, 56) == 1:
          if cur_kind(tk, n, pi, err) != 4:
            err[0] = 1
          else:
            pi[0] = pi[0] + 1
        if accept_k(tk, n, pi, err, 55) == 1:
          done = 0
        else:
          done = 1
    expect_k(tk, n, pi, err, 52)
  expect_k(tk, n, pi, err, 58)
  skip_newlines(tk, n, pi, err)
  if cur_kind(tk, n, pi, err) == 4:
    if tok_is(src, ts, te, pi[0], "typedict") == 1:
      pi[0] = pi[0] + 1
      if d == 1:
        a_line_text_i_text(d, src, 80, peek_tk(ts, an + 0), peek_tk(te, an + 0), 1, 0, 0)
      emit_tp_lines(d, src, ts, te, tbuf, ntp)
      skip_newlines(tk, n, pi, err)
      parse_type_fields(src, tk, ts, te, n, pi, err, d)
      skip_newlines(tk, n, pi, err)
      return 1
  if cur_kind(tk, n, pi, err) == 19:
    pi[0] = pi[0] + 1
    if d == 1:
      a_line_text_i_text(d, src, 80, peek_tk(ts, an + 0), peek_tk(te, an + 0), 2, 0, 0)
    emit_tp_lines(d, src, ts, te, tbuf, ntp)
    skip_newlines(tk, n, pi, err)
    while cur_kind(tk, n, pi, err) == 4:
      if tok_is(src, ts, te, pi[0], "proc") == 1:
        break
      if tok_is(src, ts, te, pi[0], "def") == 1:
        break
      if tok_is(src, ts, te, pi[0], "type") == 1:
        break
      if tok_is(src, ts, te, pi[0], "import") == 1:
        break
      if d == 1:
        a_line_text(d, src, 81, peek_tk(ts, pi[0]), peek_tk(te, pi[0]))
      pi[0] = pi[0] + 1
      skip_newlines(tk, n, pi, err)
    return 1
  if cur_kind(tk, n, pi, err) == 4:
    if tok_is(src, ts, te, pi[0], "trait") == 1:
      pi[0] = pi[0] + 1
      if d == 1:
        a_line_text_i_text(d, src, 80, peek_tk(ts, an + 0), peek_tk(te, an + 0), 4, 0, 0)
      emit_tp_lines(d, src, ts, te, tbuf, ntp)
      skip_newlines(tk, n, pi, err)
      parse_trait_methods(src, tk, ts, te, n, pi, err, d)
      skip_newlines(tk, n, pi, err)
      return 1
  if cur_kind(tk, n, pi, err) == 15:
    pi[0] = pi[0] + 1
    skip_newlines(tk, n, pi, err)
    var base_t: int = -1
    if cur_kind(tk, n, pi, err) == 4:
      if tok_is(src, ts, te, pi[0], "of") == 1:
        pi[0] = pi[0] + 1
        if cur_kind(tk, n, pi, err) != 4:
          err[0] = 1
        else:
          base_t = pi[0]
          pi[0] = pi[0] + 1
        skip_newlines(tk, n, pi, err)
    if d == 1:
      if base_t >= 0:
        a_line_text_i_text(d, src, 80, peek_tk(ts, an + 0), peek_tk(te, an + 0), 3, peek_tk(ts, base_t + 0), peek_tk(te, base_t + 0))
      else:
        a_line_text_i_text(d, src, 80, peek_tk(ts, an + 0), peek_tk(te, an + 0), 3, 0, 0)
    emit_tp_lines(d, src, ts, te, tbuf, ntp)
    parse_type_fields(src, tk, ts, te, n, pi, err, d)
    skip_newlines(tk, n, pi, err)
    return 1
  if d == 1:
    a_line_text_i_text(d, src, 80, peek_tk(ts, an + 0), peek_tk(te, an + 0), 0, 0, 0)
  emit_tp_lines(d, src, ts, te, tbuf, ntp)
  parse_type(src, tk, ts, te, n, pi, err, d)
  skip_newlines(tk, n, pi, err)
  return 1

def parse_module(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], d: int) -> int
  requires true
  ensures result == 1
  decreases 0
=
  skip_newlines(tk, n, pi, err)
  while 1 == 1:
    var k: int = cur_kind(tk, n, pi, err)
    if k == 0:
      break
    if k == 18:
      parse_import(src, tk, ts, te, n, pi, err, d)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 32:
      pi[0] = pi[0] + 1
      var k2: int = cur_kind(tk, n, pi, err)
      if k2 == 10:
        pi[0] = pi[0] + 1
      else:
        if k2 == 9:
          err[0] = 1
          li_rt_emit_err(900)
          pi[0] = pi[0] + 1
        else:
          err[0] = 1
          return 1
      parse_proc(src, tk, ts, te, n, pi, err, 1, 0, d, 0)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 33:
      pi[0] = pi[0] + 1
      parse_proc(src, tk, ts, te, n, pi, err, 0, 1, d, 0)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 76:
      var save0: int = pi[0]
      parse_decorator_list(src, tk, ts, te, n, pi, err, 0)
      var dpos: int = pi[0]
      if at_fn_kw(tk, n, pi, err) == 0:
        err[0] = 1
        return 1
      var dvis: int = 0
      var dk: int = cur_kind(tk, n, pi, err)
      if dk == 16:
        dvis = 1
      if d == 1:
        var nm: int = dpos + 1
        if dk == 16:
          nm = dpos + 2
        if dk == 17:
          nm = dpos + 2
        a_line_text_iii(d, src, 4, peek_tk(ts, nm + 0), peek_tk(te, nm + 0), dvis, 0, 0)
      pi[0] = save0
      parse_decorator_list(src, tk, ts, te, n, pi, err, d)
      pi[0] = dpos
      parse_proc(src, tk, ts, te, n, pi, err, 0, 0, d, 1)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 16:
      if peek_off(tk, n, pi, 1) == 10:
        parse_proc(src, tk, ts, te, n, pi, err, 0, 0, d, 0)
        skip_newlines(tk, n, pi, err)
        continue
      err[0] = 1
      return 1
    if k == 17:
      if peek_off(tk, n, pi, 1) == 10:
        parse_proc(src, tk, ts, te, n, pi, err, 0, 0, d, 0)
        skip_newlines(tk, n, pi, err)
        continue
      err[0] = 1
      return 1
    if k == 10:
      parse_proc(src, tk, ts, te, n, pi, err, 0, 0, d, 0)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 9:
      err[0] = 1
      li_rt_emit_err(900)
      li_rt_emit_err(900)
      pi[0] = pi[0] + 1
      skip_newlines(tk, n, pi, err)
      continue
    if k == 11:
      parse_type_alias(src, tk, ts, te, n, pi, err, d)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 29:
      parse_error_decl(src, tk, ts, te, n, pi, err, d)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 12:
      pi[0] = pi[0] + 1
      parse_theorem(src, tk, ts, te, n, pi, err, 1, 0, d)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 13:
      pi[0] = pi[0] + 1
      parse_theorem(src, tk, ts, te, n, pi, err, 0, 0, d)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 14:
      pi[0] = pi[0] + 1
      parse_theorem(src, tk, ts, te, n, pi, err, 0, 1, d)
      skip_newlines(tk, n, pi, err)
      continue
    err[0] = 1
    return 1
  return 1

# -------------------------------------------------- Layer 4: typechecker --
# `check <file>` is the first slice of the self-hosted typechecker. It walks
# the token stream a second time (the parser already validated structure) and
# enforces the rules the C++ typechecker applies to the typecheck + generics
# corpus:
#   - name resolution: calls to unknown procs, arity, unknown idents
#   - type unification: binop numeric mixing (int+float, int32+int64),
#     return-type match (incl. generic params)
#   - contract well-formedness: E0301/E0302 requires/ensures presence, E0303
#     `ensures true` on a value-returning non-extern proc
# Verdict parity (exit 0/1) is gated by scripts/check_li_check_parity.sh.
#
# Type codes: 0 int, 1 float, 2 str, 3 bool, 4 binary, 5 ptr, 6 unit,
# 7 array, 8 tuple, 9 protocol, 10 callable, 11 typedict, 12 refinement,
# 13 generic, 14 unknown.
#
# Symbol table is threaded as parameters (Li has no module-level vars):
#   sym_s/sym_e: name token indices; sym_kind: 0=type,1=proc,2=param,3=local
#   sym_ty: type code (proc: return type; alias: kind)
#   sym_aux: proc arity / (unused); sym_n: count

# ---- type-name classification (returns a type code, or 14 unknown) ----
def tc_prim_type(src: var ptr, ts: var array[262144, int], te: var array[262144, int], i: int) -> int
  requires true
  ensures result >= 0
  decreases 0
=
  if tok_is(src, ts, te, i, "int") == 1:
    return 0
  if tok_is(src, ts, te, i, "int64") == 1:
    return 0
  if tok_is(src, ts, te, i, "float") == 1:
    return 1
  if tok_is(src, ts, te, i, "float64") == 1:
    return 1
  if tok_is(src, ts, te, i, "str") == 1:
    return 2
  if tok_is(src, ts, te, i, "bool") == 1:
    return 3
  if tok_is(src, ts, te, i, "binary") == 1:
    return 4
  if tok_is(src, ts, te, i, "ptr") == 1:
    return 5
  if tok_is(src, ts, te, i, "unit") == 1:
    return 6
  if tok_is(src, ts, te, i, "tuple") == 1:
    return 8
  if tok_is(src, ts, te, i, "array") == 1:
    return 7
  if tok_is(src, ts, te, i, "int32") == 1:
    return 15
  if tok_is(src, ts, te, i, "uint8") == 1:
    return 16
  if tok_is(src, ts, te, i, "float32") == 1:
    return 17
  if tok_is(src, ts, te, i, "float8") == 1:
    return 18
  return 14

# Numeric family: 0 = int-family, 1 = float-family, -1 = not numeric.
def tc_family_of(t: int) -> int
  requires true
  ensures result >= -1
  decreases 0
=
  if t == 0:
    return 0
  if t == 15:
    return 0
  if t == 16:
    return 0
  if t == 1:
    return 1
  if t == 17:
    return 1
  if t == 18:
    return 1
  return -1

def tc_is_int(t: int) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  if t == 0:
    return 1
  if t == 15:
    return 1
  if t == 16:
    return 1
  return 0

def tc_is_float(t: int) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  if t == 1:
    return 1
  if t == 17:
    return 1
  if t == 18:
    return 1
  return 0

def tc_is_unsigned(t: int) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  if t == 16:
    return 1
  return 0

def tc_bits(t: int) -> int
  requires true
  ensures result >= -1
  decreases 0
=
  if t == 0:
    return 64
  if t == 1:
    return 64
  if t == 15:
    return 32
  if t == 16:
    return 8
  if t == 17:
    return 32
  if t == 18:
    return 8
  return -1

# ---- type parsing (returns a type code; consumes tokens) ----
def tc_parse_type(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], sym_s: var array[256, int], sym_kind: var array[256, int], sym_ty: var array[256, int], sym_n: var array[1, int]) -> int
  requires true
  ensures result >= 0
  decreases 0
=
  if cur_kind(tk, n, pi, err) == 53:
    pi[0] = pi[0] + 1
    if cur_kind(tk, n, pi, err) != 4:
      err[0] = 1
      return 14
    pi[0] = pi[0] + 1
    expect_k(tk, n, pi, err, 56)
    var bt: int = tc_parse_type(src, tk, ts, te, n, pi, err, sym_s, sym_kind, sym_ty, sym_n)
    expect_k(tk, n, pi, err, 74)
    parse_contract_expr(src, tk, ts, te, n, pi, err, 0)
    expect_k(tk, n, pi, err, 54)
    return bt
  if cur_kind(tk, n, pi, err) == 20:
    pi[0] = pi[0] + 1
  if cur_kind(tk, n, pi, err) == 47:
    pi[0] = pi[0] + 1
    return 9
  if cur_kind(tk, n, pi, err) == 48:
    pi[0] = pi[0] + 1
    if accept_k(tk, n, pi, err, 51) == 1:
      if accept_k(tk, n, pi, err, 51) == 0:
        err[0] = 1
        return 14
      if cur_kind(tk, n, pi, err) != 52:
        var done: int = 0
        while done == 0:
          tc_parse_type(src, tk, ts, te, n, pi, err, sym_s, sym_kind, sym_ty, sym_n)
          if accept_k(tk, n, pi, err, 55) == 1:
            done = 0
          else:
            done = 1
      expect_k(tk, n, pi, err, 52)
      expect_k(tk, n, pi, err, 55)
      tc_parse_type(src, tk, ts, te, n, pi, err, sym_s, sym_kind, sym_ty, sym_n)
      expect_k(tk, n, pi, err, 52)
    return 10
  if cur_kind(tk, n, pi, err) != 4:
    err[0] = 1
    return 14
  var t0: int = pi[0]
  pi[0] = pi[0] + 1
  var base: int = tc_prim_type(src, ts, te, t0)
  if base == 7:
    if accept_k(tk, n, pi, err, 51) == 1:
      var sz: int = -1
      if cur_kind(tk, n, pi, err) == 5:
        sz = int_text_value(src, ts, te, pi[0])
        pi[0] = pi[0] + 1
      else:
        tc_parse_type(src, tk, ts, te, n, pi, err, sym_s, sym_kind, sym_ty, sym_n)
        expect_k(tk, n, pi, err, 55)
        tc_parse_type(src, tk, ts, te, n, pi, err, sym_s, sym_kind, sym_ty, sym_n)
        expect_k(tk, n, pi, err, 52)
        return 7
      expect_k(tk, n, pi, err, 55)
      tc_parse_type(src, tk, ts, te, n, pi, err, sym_s, sym_kind, sym_ty, sym_n)
      expect_k(tk, n, pi, err, 52)
      if sz >= 0:
        return 1000 + sz
      return 7
    return 7
  if base == 8:
    if accept_k(tk, n, pi, err, 51) == 1:
      if cur_kind(tk, n, pi, err) != 52:
        var done: int = 0
        while done == 0:
          tc_parse_type(src, tk, ts, te, n, pi, err, sym_s, sym_kind, sym_ty, sym_n)
          if accept_k(tk, n, pi, err, 55) == 1:
            done = 0
          else:
            done = 1
      expect_k(tk, n, pi, err, 52)
      return 8
    return 8
  if base != 14:
    return base
  # Named type alias, generic param, or object/enum name.
  var si: int = 0
  while si < sym_n[0]:
    if sym_kind[si] == 4:
      if tok_eq(src, ts, te, sym_s[si], t0) == 1:
        return 13
    si = si + 1
  si = 0
  while si < sym_n[0]:
    if sym_kind[si] == 0:
      if tok_eq(src, ts, te, sym_s[si], t0) == 1:
        var rt: int = sym_ty[si]
        if accept_k(tk, n, pi, err, 51) == 1:
          if cur_kind(tk, n, pi, err) != 52:
            var done: int = 0
            while done == 0:
              tc_parse_type(src, tk, ts, te, n, pi, err, sym_s, sym_kind, sym_ty, sym_n)
              if accept_k(tk, n, pi, err, 55) == 1:
                done = 0
              else:
                done = 1
          expect_k(tk, n, pi, err, 52)
        return rt
    si = si + 1
  # heap generic type app: list[T] / dict[K, V] / set[T] (consume the args)
  if tok_is(src, ts, te, t0, "list") == 1 or tok_is(src, ts, te, t0, "dict") == 1 or tok_is(src, ts, te, t0, "set") == 1:
    if accept_k(tk, n, pi, err, 51) == 1:
      if cur_kind(tk, n, pi, err) != 52:
        var done: int = 0
        while done == 0:
          tc_parse_type(src, tk, ts, te, n, pi, err, sym_s, sym_kind, sym_ty, sym_n)
          if accept_k(tk, n, pi, err, 55) == 1:
            done = 0
          else:
            done = 1
      expect_k(tk, n, pi, err, 52)
    return 19
  return 14

# Consume the RHS of a type alias (`= object | trait | enum | typedict | type`),
# mirroring parse_type_alias; returns the tc type code (14 for named/object).
def tc_skip_alias_rhs(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], sym_s: var array[256, int], sym_kind: var array[256, int], sym_ty: var array[256, int], sym_n: var array[1, int]) -> int
  requires true
  ensures result >= 0
  decreases 0
=
  skip_newlines(tk, n, pi, err)
  if cur_kind(tk, n, pi, err) == 47:
    pi[0] = pi[0] + 1
    return 9
  if cur_kind(tk, n, pi, err) == 4:
    if tok_is(src, ts, te, pi[0], "typedict") == 1:
      pi[0] = pi[0] + 1
      skip_newlines(tk, n, pi, err)
      parse_type_fields(src, tk, ts, te, n, pi, err, 0)
      return 14
  if cur_kind(tk, n, pi, err) == 19:
    pi[0] = pi[0] + 1
    skip_newlines(tk, n, pi, err)
    while cur_kind(tk, n, pi, err) == 4:
      if tok_is(src, ts, te, pi[0], "proc") == 1:
        break
      if tok_is(src, ts, te, pi[0], "def") == 1:
        break
      if tok_is(src, ts, te, pi[0], "type") == 1:
        break
      if tok_is(src, ts, te, pi[0], "import") == 1:
        break
      pi[0] = pi[0] + 1
      skip_newlines(tk, n, pi, err)
    return 14
  if cur_kind(tk, n, pi, err) == 4:
    if tok_is(src, ts, te, pi[0], "trait") == 1:
      pi[0] = pi[0] + 1
      skip_newlines(tk, n, pi, err)
      parse_trait_methods(src, tk, ts, te, n, pi, err, 0)
      return 14
  if cur_kind(tk, n, pi, err) == 15:
    pi[0] = pi[0] + 1
    skip_newlines(tk, n, pi, err)
    if cur_kind(tk, n, pi, err) == 4:
      if tok_is(src, ts, te, pi[0], "of") == 1:
        pi[0] = pi[0] + 1
        if cur_kind(tk, n, pi, err) == 4:
          pi[0] = pi[0] + 1
        skip_newlines(tk, n, pi, err)
    parse_type_fields(src, tk, ts, te, n, pi, err, 0)
    return 14
  return tc_parse_type(src, tk, ts, te, n, pi, err, sym_s, sym_kind, sym_ty, sym_n)

# ---- symbol lookups ----
def tc_find_proc(src: var ptr, ts: var array[262144, int], te: var array[262144, int], sym_s: var array[256, int], sym_kind: var array[256, int], sym_ty: var array[256, int], sym_n: var array[1, int], i: int) -> int
  requires true
  ensures result >= -1
  decreases 0
=
  var k: int = 0
  while k < sym_n[0]:
    if sym_kind[k] == 1:
      if tok_eq(src, ts, te, sym_s[k], i) == 1:
        return sym_ty[k]
    k = k + 1
  return -1

def tc_proc_arity(src: var ptr, ts: var array[262144, int], te: var array[262144, int], sym_s: var array[256, int], sym_kind: var array[256, int], sym_aux: var array[256, int], sym_n: var array[1, int], i: int) -> int
  requires true
  ensures result >= -1
  decreases 0
=
  var k: int = 0
  while k < sym_n[0]:
    if sym_kind[k] == 1:
      if tok_eq(src, ts, te, sym_s[k], i) == 1:
        return sym_aux[k]
    k = k + 1
  return -1

def tc_local_type(src: var ptr, ts: var array[262144, int], te: var array[262144, int], sym_s: var array[256, int], sym_kind: var array[256, int], sym_ty: var array[256, int], sym_n: var array[1, int], i: int) -> int
  requires true
  ensures result >= -1
  decreases 0
=
  var k: int = 0
  var best_ty: int = -1
  while k < sym_n[0]:
    if sym_kind[k] == 2 or sym_kind[k] == 3:
      if tok_eq(src, ts, te, sym_s[k], i) == 1:
        best_ty = sym_ty[k]
    k = k + 1
  return best_ty

# ---- expression type inference (returns a type code; consumes tokens) ----
def tc_expr(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], min_prec: int, sym_s: var array[256, int], sym_kind: var array[256, int], sym_ty: var array[256, int], sym_aux: var array[256, int], sym_n: var array[1, int]) -> int
  requires true
  ensures result >= 0
  decreases 0
=
  var lt: int = tc_primary(src, tk, ts, te, n, pi, err, sym_s, sym_kind, sym_ty, sym_aux, sym_n)
  while 1 == 1:
    var p: int = prec_of(cur_kind(tk, n, pi, err))
    if p < 0:
      break
    if p < min_prec:
      break
    var opk: int = cur_kind(tk, n, pi, err)
    pi[0] = pi[0] + 1
    var rt: int = tc_expr(src, tk, ts, te, n, pi, err, p + 1, sym_s, sym_kind, sym_ty, sym_aux, sym_n)
    lt = tc_binop_type(lt, opk, rt, err)
  return lt

def tc_binop_type(l: int, opk: int, r: int, err: var array[1, int]) -> int
  requires true
  ensures result >= 0
  decreases 0
=
  # Comparisons and equality yield bool.
  if opk == 66 or opk == 67 or opk == 68 or opk == 69 or opk == 70 or opk == 71:
    return 3
  if tc_is_int(l) == 1:
    if tc_is_int(r) == 1:
      if tc_is_unsigned(l) != tc_is_unsigned(r):
        err[0] = 1
        li_rt_emit_err(900)
        return 0
      if tc_bits(l) != tc_bits(r):
        err[0] = 1
        li_rt_emit_err(900)
        return 0
      return l
  if tc_is_float(l) == 1:
    if tc_is_float(r) == 1:
      if tc_bits(l) != tc_bits(r):
        err[0] = 1
        li_rt_emit_err(900)
        return 1
      return l
  var lfam: int = tc_family_of(l)
  var rfam: int = tc_family_of(r)
  if lfam >= 0:
    if rfam >= 0:
      err[0] = 1
      li_rt_emit_err(900)
      return 0
  return 14

def tc_primary(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], sym_s: var array[256, int], sym_kind: var array[256, int], sym_ty: var array[256, int], sym_aux: var array[256, int], sym_n: var array[1, int]) -> int
  requires true
  ensures result >= 0
  decreases 0
=
  var k: int = cur_kind(tk, n, pi, err)
  if k == 60:
    pi[0] = pi[0] + 1
    return tc_primary(src, tk, ts, te, n, pi, err, sym_s, sym_kind, sym_ty, sym_aux, sym_n)
  if k == 34:
    pi[0] = pi[0] + 1
    return tc_primary(src, tk, ts, te, n, pi, err, sym_s, sym_kind, sym_ty, sym_aux, sym_n)
  if k == 5:
    pi[0] = pi[0] + 1
    return tc_postfix(src, tk, ts, te, n, pi, err, 0, sym_s, sym_kind, sym_ty, sym_aux, sym_n)
  if k == 6:
    pi[0] = pi[0] + 1
    return tc_postfix(src, tk, ts, te, n, pi, err, 1, sym_s, sym_kind, sym_ty, sym_aux, sym_n)
  if k == 7:
    pi[0] = pi[0] + 1
    return tc_postfix(src, tk, ts, te, n, pi, err, 4, sym_s, sym_kind, sym_ty, sym_aux, sym_n)
  if k == 8:
    pi[0] = pi[0] + 1
    return tc_postfix(src, tk, ts, te, n, pi, err, 2, sym_s, sym_kind, sym_ty, sym_aux, sym_n)
  if k == 35:
    pi[0] = pi[0] + 1
    return tc_postfix(src, tk, ts, te, n, pi, err, 3, sym_s, sym_kind, sym_ty, sym_aux, sym_n)
  if k == 36:
    pi[0] = pi[0] + 1
    return tc_postfix(src, tk, ts, te, n, pi, err, 3, sym_s, sym_kind, sym_ty, sym_aux, sym_n)
  if k == 4 or k == 46:
    var id0: int = pi[0]
    pi[0] = pi[0] + 1
    if accept_k(tk, n, pi, err, 49) == 1:
      if tok_is(src, ts, te, id0, "print") == 1:
        if cur_kind(tk, n, pi, err) != 50:
          var done: int = 0
          while done == 0:
            tc_expr(src, tk, ts, te, n, pi, err, 0, sym_s, sym_kind, sym_ty, sym_aux, sym_n)
            if accept_k(tk, n, pi, err, 55) == 1:
              done = 0
            else:
              done = 1
        expect_k(tk, n, pi, err, 50)
        return 0
      var callee: int = tc_find_proc(src, ts, te, sym_s, sym_kind, sym_ty, sym_n, id0)
      var carity: int = tc_proc_arity(src, ts, te, sym_s, sym_kind, sym_aux, sym_n, id0)
      var argc: int = 0
      if cur_kind(tk, n, pi, err) != 50:
        var done: int = 0
        while done == 0:
          tc_expr(src, tk, ts, te, n, pi, err, 0, sym_s, sym_kind, sym_ty, sym_aux, sym_n)
          argc = argc + 1
          if accept_k(tk, n, pi, err, 55) == 1:
            done = 0
          else:
            done = 1
      expect_k(tk, n, pi, err, 50)
      if callee >= 0:
        if argc != carity:
          err[0] = 1
          li_rt_emit_err(202)
        return callee
      err[0] = 1
      li_rt_emit_err(202)
      return 14
    var lt: int = tc_local_type(src, ts, te, sym_s, sym_kind, sym_ty, sym_n, id0)
    if lt < 0:
      lt = 14
    return tc_postfix(src, tk, ts, te, n, pi, err, lt, sym_s, sym_kind, sym_ty, sym_aux, sym_n)
  if accept_k(tk, n, pi, err, 49) == 1:
    var it: int = tc_expr(src, tk, ts, te, n, pi, err, 0, sym_s, sym_kind, sym_ty, sym_aux, sym_n)
    expect_k(tk, n, pi, err, 50)
    return tc_postfix(src, tk, ts, te, n, pi, err, it, sym_s, sym_kind, sym_ty, sym_aux, sym_n)
  err[0] = 1
  return 14

def tc_postfix(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], t: int, sym_s: var array[256, int], sym_kind: var array[256, int], sym_ty: var array[256, int], sym_aux: var array[256, int], sym_n: var array[1, int]) -> int
  requires true
  ensures result >= 0
  decreases 0
=
  while 1 == 1:
