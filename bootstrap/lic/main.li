          skip_newlines(tk, n, pi, err)
          if cur_kind(tk, n, pi, err) == 2:
            parse_block(src, tk, ts, te, n, pi, err, 0)
      skip_newlines(tk, n, pi, err)
      continue
    err[0] = 1
    return 1
  pi[0] = 0
  pend[0] = 0
  skip_newlines(tk, n, pi, err)
  while cur_kind(tk, n, pi, err) != 0:
    var k: int = cur_kind(tk, n, pi, err)
    if k == 11:
      fx_skip_typealias(src, tk, ts, te, n, pi, err)
      continue
    if k == 76:
      fx_skip_decorators(src, tk, ts, te, n, pi, err, pend)
      continue
    if k == 18:
      parse_import(src, tk, ts, te, n, pi, err, 0)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 13 or k == 12 or k == 14:
      parse_theorem(src, tk, ts, te, n, pi, err, 0, 0, 0)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 16 or k == 17:
      pi[0] = pi[0] + 1
      skip_newlines(tk, n, pi, err)
      continue
    if k == 32 or k == 10 or k == 33:
      var is_ext: int = 0
      if k == 32:
        is_ext = 1
        pi[0] = pi[0] + 1
        if cur_kind(tk, n, pi, err) == 10:
          pi[0] = pi[0] + 1
      if k == 33:
        pi[0] = pi[0] + 1
        if cur_kind(tk, n, pi, err) == 10:
          pi[0] = pi[0] + 1
      if k == 10:
        pi[0] = pi[0] + 1
      if cur_kind(tk, n, pi, err) != 4:
        err[0] = 1
        return 1
      pi[0] = pi[0] + 1
      fx_skip_typeparams(tk, n, pi, err)
      expect_k(tk, n, pi, err, 49)
      ls_n[0] = 0
      bk_skip_params_decl(src, tk, ts, te, n, pi, err, ls_name, ls_moved, ls_mb, ls_ib, ls_n)
      fx_record_raises(src, tk, ts, te, n, pi, err, decl)
      if accept_k(tk, n, pi, err, 57) == 1:
        parse_type(src, tk, ts, te, n, pi, err, 0)
      fx_record_raises(src, tk, ts, te, n, pi, err, decl)
      while 1 == 1:
        var ck: int = cur_kind(tk, n, pi, err)
        if ck == 41 or ck == 42 or ck == 43 or ck == 44 or ck == 45:
          parse_contract(src, tk, ts, te, n, pi, err, 0)
          continue
        break
      if is_ext == 0:
        skip_newlines(tk, n, pi, err)
        if accept_k(tk, n, pi, err, 58) == 1:
          skip_newlines(tk, n, pi, err)
          if cur_kind(tk, n, pi, err) == 2:
            bk_check_block(src, tk, ts, te, n, pi, err, bp_name, bp_np, bp_pv, bp_ps, bp_cnt, ls_name, ls_moved, ls_mb, ls_ib, ls_n)
      skip_newlines(tk, n, pi, err)
      continue
    err[0] = 1
    return 1
  return 0

# ---- Layer 4d: encapsulation / visibility / trait / object checks ----
# Mirrors compiler/types/{policy,typecheck}.cpp object/trait semantics.

def ec_find_obj(src: var ptr, ts: var array[65536, int], te: var array[65536, int], ob_name: var array[256, int], ob_cnt: var array[1, int], name_tok: int) -> int
  requires true
  ensures result >= -1
  decreases 0
=
  var k: int = 0
  while k < ob_cnt[0]:
    if tok_eq(src, ts, te, ob_name[k], name_tok) == 1:
      return k
    k = k + 1
  return -1

def ec_find_trait(src: var ptr, ts: var array[65536, int], te: var array[65536, int], tr_name: var array[64, int], tr_cnt: var array[1, int], name_tok: int) -> int
  requires true
  ensures result >= -1
  decreases 0
=
  var k: int = 0
  while k < tr_cnt[0]:
    if tok_eq(src, ts, te, tr_name[k], name_tok) == 1:
      return k
    k = k + 1
  return -1

def ec_name_joins(src: var ptr, ts: var array[65536, int], te: var array[65536, int], a: int, b: int, f: int) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  var la: int = peek_tk(te, a + 0) - peek_tk(ts, a + 0)
  var lb: int = peek_tk(te, b + 0) - peek_tk(ts, b + 0)
  var lf: int = peek_tk(te, f + 0) - peek_tk(ts, f + 0)
  if lf != la + 1 + lb:
    return 0
  var j: int = 0
  while j < la:
    if li_rt_str_char_at(src, peek_tk(ts, a + 0) + j) != li_rt_str_char_at(src, peek_tk(ts, f + 0) + j):
      return 0
    j = j + 1
  if li_rt_str_char_at(src, peek_tk(ts, f + 0) + la) != 95:
    return 0
  j = 0
  while j < lb:
    if li_rt_str_char_at(src, peek_tk(ts, b + 0) + j) != li_rt_str_char_at(src, peek_tk(ts, f + 0) + la + 1 + j):
      return 0
    j = j + 1
  return 1

def ec_has_prefix_join(src: var ptr, ts: var array[65536, int], te: var array[65536, int], a: int, f: int) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  var lf: int = peek_tk(te, f + 0) - peek_tk(ts, f + 0)
  var la: int = peek_tk(te, a + 0) - peek_tk(ts, a + 0)
  if lf < la + 2:
    return 0
  var j: int = 0
  while j < la:
    if li_rt_str_char_at(src, peek_tk(ts, a + 0) + j) != li_rt_str_char_at(src, peek_tk(ts, f + 0) + j):
      return 0
    j = j + 1
  if li_rt_str_char_at(src, peek_tk(ts, f + 0) + la) != 95:
    return 0
  return 1

def ec_same_suffix(src: var ptr, ts: var array[65536, int], te: var array[65536, int], a: int, b: int, f: int, g: int) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  var lf: int = peek_tk(te, f + 0) - peek_tk(ts, f + 0)
  var lg: int = peek_tk(te, g + 0) - peek_tk(ts, g + 0)
  var la: int = peek_tk(te, a + 0) - peek_tk(ts, a + 0)
  var lb: int = peek_tk(te, b + 0) - peek_tk(ts, b + 0)
  if lf - la != lg - lb:
    return 0
  var ls: int = lf - la - 1
  if ls <= 0:
    return 0
  var j: int = 0
  while j < la:
    if li_rt_str_char_at(src, peek_tk(ts, a + 0) + j) != li_rt_str_char_at(src, peek_tk(ts, f + 0) + j):
      return 0
    j = j + 1
  if li_rt_str_char_at(src, peek_tk(ts, f + 0) + la) != 95:
    return 0
  j = 0
  while j < lb:
    if li_rt_str_char_at(src, peek_tk(ts, b + 0) + j) != li_rt_str_char_at(src, peek_tk(ts, g + 0) + j):
      return 0
    j = j + 1
  if li_rt_str_char_at(src, peek_tk(ts, g + 0) + lb) != 95:
    return 0
  j = 0
  while j < ls:
    if li_rt_str_char_at(src, peek_tk(ts, f + 0) + la + 1 + j) != li_rt_str_char_at(src, peek_tk(ts, g + 0) + lb + 1 + j):
      return 0
    j = j + 1
  return 1

def ec_underscore(src: var ptr, ts: var array[65536, int], te: var array[65536, int], tok: int) -> int
  requires true
  ensures result >= -1
  decreases 0
=
  var st: int = peek_tk(ts, tok + 0)
  var en: int = peek_tk(te, tok + 0)
  var j: int = st
  while j < en:
    if li_rt_str_char_at(src, j) == 95:
      return j - st
    j = j + 1
  return -1

def ec_ident_used(src: var ptr, tk: var array[65536, int], ts: var array[65536, int], te: var array[65536, int], n: var array[1, int], bind_tok: int) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  var j: int = 0
  while j < n[0]:
    if j != bind_tok:
      if peek_tk(tk, j) == 4:
        if tok_eq(src, ts, te, j, bind_tok) == 1:
          return 1
    j = j + 1
  return 0

def ec_field_idx(src: var ptr, ts: var array[65536, int], te: var array[65536, int], fd_name: var array[256, int], fd_owner: var array[256, int], fd_cnt: var array[1, int], ob_idx: int, name_tok: int) -> int
  requires true
  ensures result >= -1
  decreases 0
=
  var k: int = 0
  while k < fd_cnt[0]:
    if fd_owner[k] == ob_idx:
      if tok_eq(src, ts, te, fd_name[k], name_tok) == 1:
        return k
    k = k + 1
  return -1

def ec_obj_impl_trait(src: var ptr, ts: var array[65536, int], te: var array[65536, int], tm_name: var array[256, int], tm_owner: var array[256, int], tm_cnt: var array[1, int], ep_name: var array[256, int], ep_cnt: var array[1, int], ob_tok: int, tr_idx: int) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  var m: int = 0
  while m < tm_cnt[0]:
    if tm_owner[m] == tr_idx:
      var found: int = 0
      var p: int = 0
      while p < ep_cnt[0]:
        if ec_name_joins(src, ts, te, ob_tok, tm_name[m], ep_name[p]) == 1:
          found = 1
        p = p + 1
      if found == 0:
        return 0
    m = m + 1
  return 1

def ec_capture_type_tok(src: var ptr, tk: var array[65536, int], ts: var array[65536, int], te: var array[65536, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int]) -> int
  requires true
  ensures result >= -1
  decreases 0
=
  var tt: int = -1
  if cur_kind(tk, n, pi, err) == 20:
    pi[0] = pi[0] + 1
  if cur_kind(tk, n, pi, err) == 4:
    tt = pi[0]
  parse_type(src, tk, ts, te, n, pi, err, 0)
  return tt

def ec_record_proc(src: var ptr, tk: var array[65536, int], ts: var array[65536, int], te: var array[65536, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], is_priv: int, is_ovr: int, ep_name: var array[256, int], ep_priv: var array[256, int], ep_self: var array[256, int], ep_ret: var array[256, int], ep_bnd: var array[256, int], ep_ovr: var array[256, int], ep_cnt: var array[1, int]) -> int
  requires true
  ensures result == 1
  decreases 0
=
  if cur_kind(tk, n, pi, err) != 4:
    err[0] = 1
    return 1
  var nm: int = pi[0]
  pi[0] = pi[0] + 1
  var idx: int = ep_cnt[0]
  if idx < 256:
    ep_name[idx] = nm
    ep_priv[idx] = is_priv
    ep_self[idx] = -1
    ep_ret[idx] = -1
    ep_bnd[idx] = -1
    ep_ovr[idx] = is_ovr
    ep_cnt[0] = ep_cnt[0] + 1
  if accept_k(tk, n, pi, err, 51) == 1:
    if cur_kind(tk, n, pi, err) != 52:
      var done: int = 0
      while done == 0:
        if cur_kind(tk, n, pi, err) == 4:
          pi[0] = pi[0] + 1
        if accept_k(tk, n, pi, err, 56) == 1:
          if cur_kind(tk, n, pi, err) == 4:
            if idx < 256:
              ep_bnd[idx] = pi[0]
            pi[0] = pi[0] + 1
        if accept_k(tk, n, pi, err, 55) == 1:
          done = 0
        else:
          done = 1
    expect_k(tk, n, pi, err, 52)
  expect_k(tk, n, pi, err, 49)
  skip_param_layout(tk, n, pi, err)
  var first: int = 1
  if cur_kind(tk, n, pi, err) != 50:
    var done: int = 0
    while done == 0:
      skip_param_layout(tk, n, pi, err)
      if cur_kind(tk, n, pi, err) == 4:
        var pn: int = pi[0]
        pi[0] = pi[0] + 1
        expect_k(tk, n, pi, err, 56)
        var tt: int = ec_capture_type_tok(src, tk, ts, te, n, pi, err)
        if first == 1:
          if idx < 256:
            ep_self[idx] = tt
        first = 0
      skip_param_layout(tk, n, pi, err)
      if accept_k(tk, n, pi, err, 55) == 1:
        done = 0
      else:
        done = 1
  skip_param_layout(tk, n, pi, err)
  expect_k(tk, n, pi, err, 50)
  tc_skip_raises(tk, n, pi, err)
  if accept_k(tk, n, pi, err, 57) == 1:
    if idx < 256:
      ep_ret[idx] = ec_capture_type_tok(src, tk, ts, te, n, pi, err)
    else:
      parse_type(src, tk, ts, te, n, pi, err, 0)
  tc_skip_raises(tk, n, pi, err)
  while 1 == 1:
    var ck: int = cur_kind(tk, n, pi, err)
    if ck == 41 or ck == 42 or ck == 43 or ck == 44 or ck == 45:
      parse_contract(src, tk, ts, te, n, pi, err, 0)
      continue
    break
  return 1

def ec_parse_fields(src: var ptr, tk: var array[65536, int], ts: var array[65536, int], te: var array[65536, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], ob_idx: int, fd_name: var array[256, int], fd_priv: var array[256, int], fd_type: var array[256, int], fd_owner: var array[256, int], fd_cnt: var array[1, int]) -> int
  requires true
  ensures result == 1
  decreases 0
=
  skip_newlines(tk, n, pi, err)
  while 1 == 1:
    var k: int = cur_kind(tk, n, pi, err)
    if k != 16:
      if k != 17:
        if k != 4:
          break
        if peek_off(tk, n, pi, 1) != 56:
          break
    if k == 16:
      if peek_off(tk, n, pi, 1) == 10:
        break
    if k == 17:
      if peek_off(tk, n, pi, 1) == 10:
        break
    var vis: int = 0
    if k == 16:
      vis = 1
      pi[0] = pi[0] + 1
    else:
      if k == 17:
        pi[0] = pi[0] + 1
    if cur_kind(tk, n, pi, err) != 4:
      err[0] = 1
      break
    var fn: int = pi[0]
    pi[0] = pi[0] + 1
    expect_k(tk, n, pi, err, 56)
    var tt: int = ec_capture_type_tok(src, tk, ts, te, n, pi, err)
    if fd_cnt[0] < 256:
      fd_name[fd_cnt[0]] = fn
      fd_priv[fd_cnt[0]] = vis
      fd_type[fd_cnt[0]] = tt
      fd_owner[fd_cnt[0]] = ob_idx
      fd_cnt[0] = fd_cnt[0] + 1
    skip_newlines(tk, n, pi, err)
  return 1

def ec_parse_trait_methods(src: var ptr, tk: var array[65536, int], ts: var array[65536, int], te: var array[65536, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], tr_idx: int, tm_name: var array[256, int], tm_owner: var array[256, int], tm_cnt: var array[1, int]) -> int
  requires true
  ensures result == 1
  decreases 0
=
  skip_newlines(tk, n, pi, err)
  while 1 == 1:
    var k: int = cur_kind(tk, n, pi, err)
    if k == 16:
      pi[0] = pi[0] + 1
    if k == 17:
      pi[0] = pi[0] + 1
    k = cur_kind(tk, n, pi, err)
    if k == 10 or k == 9:
      pi[0] = pi[0] + 1
      if cur_kind(tk, n, pi, err) != 4:
        err[0] = 1
        return 1
      var mn: int = pi[0]
      pi[0] = pi[0] + 1
      expect_k(tk, n, pi, err, 49)
      skip_param_layout(tk, n, pi, err)
      if cur_kind(tk, n, pi, err) != 50:
        var done: int = 0
        while done == 0:
          parse_param(src, tk, ts, te, n, pi, err, 0)
          skip_param_layout(tk, n, pi, err)
          if accept_k(tk, n, pi, err, 55) == 1:
            done = 0
          else:
            done = 1
      skip_param_layout(tk, n, pi, err)
      expect_k(tk, n, pi, err, 50)
      if accept_k(tk, n, pi, err, 57) == 1:
        parse_type(src, tk, ts, te, n, pi, err, 0)
      if tm_cnt[0] < 256:
        tm_name[tm_cnt[0]] = mn
        tm_owner[tm_cnt[0]] = tr_idx
        tm_cnt[0] = tm_cnt[0] + 1
      skip_newlines(tk, n, pi, err)
      continue
    break
  return 1

# ---- policy scan: field privacy, method existence, trait bounds ----
# Mirrors the typecheck.cpp object/trait checks that need base-type info:
#   `v.secret` on an object with a private `secret`  -> lic.error (900)
#   `w.missing()` where no `Widget_missing` proc      -> E0202 (202)
#   `require_hash(b)` where Bad doesn't impl Hash     -> lic.error (900)
# Locals (params + `var x: T`) are tracked per proc; only plain-idents whose
# declared type names a locally-declared object are checked.

def pl_find_ty(src: var ptr, ts: var array[65536, int], te: var array[65536, int], pl_name: var array[256, int], pl_ty: var array[256, int], pl_n: var array[1, int], name_tok: int) -> int
  requires true
  ensures result >= -1
  decreases 0
=
  var k: int = 0
  while k < pl_n[0]:
    if tok_eq(src, ts, te, pl_name[k], name_tok) == 1:
      return pl_ty[k]
    k = k + 1
  return -1

def ec_tok_text(src: var ptr, ts: var array[65536, int], te: var array[65536, int], tok: int) raises IO -> ptr
  requires true
  ensures true
  decreases 0
=
  return bytes_slice_i(src, peek_tk(ts, tok + 0), peek_tk(te, tok + 0) - peek_tk(ts, tok + 0))

def ec_text_eq(a: ptr, b: ptr) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  if li_rt_str_eq(a, b) == 1:
    return 1
  return 0

# Collect `type X = object` decls from an already-lexed (imported) token
# stream into text tables: im_ob (object names), im_fd_name/im_fd_priv/
# im_fd_owner (fields with visibility). Returns 0.
def ec_collect_import_objects(src: var ptr, tk: var array[65536, int], ts: var array[65536, int], te: var array[65536, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], im_ob: var array[64, ptr], im_fd_name: var array[256, ptr], im_fd_priv: var array[256, int], im_fd_owner: var array[256, int], im_ob_cnt: var array[1, int], im_fd_cnt: var array[1, int]) -> int
  requires true
  ensures result == 0
  decreases 0
=
  pi[0] = 0
  skip_newlines(tk, n, pi, err)
  while cur_kind(tk, n, pi, err) != 0:
    var k: int = cur_kind(tk, n, pi, err)
    if k == 11:
      pi[0] = pi[0] + 1
      if cur_kind(tk, n, pi, err) != 4:
        pi[0] = pi[0] + 1
        continue
      var ob: int = -1
      var nm: int = pi[0]
      pi[0] = pi[0] + 1
      fx_skip_typeparams(tk, n, pi, err)
      if cur_kind(tk, n, pi, err) == 58:
        pi[0] = pi[0] + 1
        skip_newlines(tk, n, pi, err)
        if cur_kind(tk, n, pi, err) == 15:
          pi[0] = pi[0] + 1
          skip_newlines(tk, n, pi, err)
          if cur_kind(tk, n, pi, err) == 4:
            if tok_is(src, ts, te, pi[0], "of") == 1:
              pi[0] = pi[0] + 1
              if cur_kind(tk, n, pi, err) == 4:
                pi[0] = pi[0] + 1
              skip_newlines(tk, n, pi, err)
          ob = im_ob_cnt[0]
          if im_ob_cnt[0] < 64:
            im_ob[im_ob_cnt[0]] = ec_tok_text(src, ts, te, nm)
            im_ob_cnt[0] = im_ob_cnt[0] + 1
          skip_newlines(tk, n, pi, err)
          while 1 == 1:
            var fk: int = cur_kind(tk, n, pi, err)
            if fk != 16:
              if fk != 17:
                if fk != 4:
                  break
                if peek_off(tk, n, pi, 1) != 56:
                  break
            if fk == 16:
              if peek_off(tk, n, pi, 1) == 10:
                break
            if fk == 17:
              if peek_off(tk, n, pi, 1) == 10:
                break
            var vis: int = 0
            if fk == 16:
              vis = 1
              pi[0] = pi[0] + 1
            else:
              if fk == 17:
                pi[0] = pi[0] + 1
            if cur_kind(tk, n, pi, err) != 4:
              break
            var fn: int = pi[0]
            pi[0] = pi[0] + 1
            expect_k(tk, n, pi, err, 56)
            parse_type(src, tk, ts, te, n, pi, err, 0)
            if im_fd_cnt[0] < 256:
              if ob >= 0:
                im_fd_name[im_fd_cnt[0]] = ec_tok_text(src, ts, te, fn)
                im_fd_priv[im_fd_cnt[0]] = vis
                im_fd_owner[im_fd_cnt[0]] = ob
                im_fd_cnt[0] = im_fd_cnt[0] + 1
            skip_newlines(tk, n, pi, err)
        else:
          while cur_kind(tk, n, pi, err) != 1:
            if cur_kind(tk, n, pi, err) == 0:
              break
            pi[0] = pi[0] + 1
          pi[0] = pi[0] + 1
      else:
        pi[0] = pi[0] + 1
      skip_newlines(tk, n, pi, err)
      continue
    if k == 10 or k == 16 or k == 17 or k == 32 or k == 33 or k == 76:
      pi[0] = pi[0] + 1
      skip_newlines(tk, n, pi, err)
      continue
    if k == 18 or k == 13 or k == 12 or k == 14:
      pi[0] = pi[0] + 1
      skip_newlines(tk, n, pi, err)
      continue
    pi[0] = pi[0] + 1
  return 0

# True when object text `ob` declares field text `fld` as private, searching
# the imported text tables.
def ec_import_field_private(im_ob: var array[64, ptr], im_fd_name: var array[256, ptr], im_fd_priv: var array[256, int], im_fd_owner: var array[256, int], im_ob_cnt: var array[1, int], im_fd_cnt: var array[1, int], ob: ptr, fld: ptr) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  var oi: int = -1
  var q: int = 0
  while q < im_ob_cnt[0]:
    if ec_text_eq(im_ob[q], ob) == 1:
      oi = q
    q = q + 1
  if oi < 0:
    return 0
