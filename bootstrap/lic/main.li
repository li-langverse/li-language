          cop_w = 35
      li_rt_mir_str("INS")
      li_rt_ast_space()
      li_rt_ast_int(cop_w)
      li_rt_ast_space()
      li_rt_ast_int(iv_w)
      li_rt_ast_space()
      li_rt_ast_int(0)
      li_rt_ast_space()
      li_rt_mir_str("__li_o_wb")
      li_rt_ast_int(crid)
      li_rt_mir_str("_")
      if p_s >= 0:
        li_rt_mir_esc(tsrc, p_s, p_e)
        li_rt_mir_str("_")
      li_rt_mir_esc(tsrc, fa_w[0], fa_w[1])
      # 5 empty name cells
      li_rt_ast_space()
      li_rt_ast_space()
      li_rt_ast_space()
      li_rt_ast_space()
      li_rt_ast_space()
      # f18..f21
      li_rt_ast_space()
      li_rt_ast_int(0)
      li_rt_ast_space()
      li_rt_ast_int(0)
      li_rt_ast_space()
      li_rt_ast_int(0)
      li_rt_ast_space()
      li_rt_ast_int(1)
      # name cell 6 (empty)
      li_rt_ast_space()
      # f25..f36
      li_rt_ast_space()
      li_rt_ast_int(0)
      li_rt_ast_space()
      li_rt_ast_int(1)
      li_rt_ast_space()
      li_rt_ast_int(0)
      li_rt_ast_space()
      li_rt_ast_int(0)
      li_rt_ast_space()
      li_rt_ast_int(0)
      li_rt_ast_space()
      li_rt_ast_int(0)
      li_rt_ast_space()
      li_rt_ast_int(0)
      li_rt_ast_space()
      li_rt_ast_int(0)
      li_rt_ast_space()
      li_rt_ast_int(0)
      li_rt_ast_space()
      li_rt_ast_int(0)
      li_rt_ast_space()
      li_rt_ast_int(0)
      li_rt_ast_space()
      li_rt_ast_int(0)
      li_rt_ast_nl()
    i_w = i_w + 1
  return 0

