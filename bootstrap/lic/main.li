def parse_import(src: var ptr, tk: var array[65536, int], ts: var array[65536, int], te: var array[65536, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], d: int) -> int
  requires true
  ensures result == 1
  decreases 0
=
