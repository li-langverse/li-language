=
  pi[0] = pi[0] + 1
  var iter_t: int = pi[0]
  pi[0] = pi[0] + 1
  pi[0] = pi[0] + 1
  var st: int = 0
  var en: int = 0
  if cur_kind(tk,  n,  pi,  err) == 5:
    st = int_text_value(src,  ts,  te,  pi[0])
    pi[0] = pi[0] + 1
  pi[0] = pi[0] + 1
  if cur_kind(tk,  n,  pi,  err) == 5:
    en = int_text_value(src,  ts,  te,  pi[0])
    pi[0] = pi[0] + 1
  expect_k(tk,  n,  pi,  err, 56)
  var hd: int = tc[0]
  tc[0] = hd + 1
  var ex: int = tc[0]
  tc[0] = ex + 1
  set32(lhead, nlp[0],hd)
  set32(lexit, nlp[0],ex)
  nlp[0] = nlp[0] + 1
  var f24: array[44, int]
  mir_fdef(f24)
  f24[0] = peek_tk(ts, iter_t + 0)
  f24[1] = peek_tk(te, iter_t + 0)
  f24[2] = 1
  mir_ins_line(src,  f24,  24,  0,  -1,  lastop)
