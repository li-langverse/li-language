=
  var k: int = cur_kind(tk, n, pi, err)
  var t0: int = pi[0]
  if k == 4:
    pi[0] = pi[0] + 1
    if d == 1:
      a_line_text(d, src, 64, peek_tk(ts, t0 + 0), peek_tk(te, t0 + 0))
    return 1
  if k == 35:
    pi[0] = pi[0] + 1
    if d == 1:
      a_line_text(d, src, 64, peek_tk(ts, t0 + 0), peek_tk(te, t0 + 0))
    return 1
  if k == 36:
    pi[0] = pi[0] + 1
    if d == 1:
      a_line_text(d, src, 64, peek_tk(ts, t0 + 0), peek_tk(te, t0 + 0))
    return 1
  if k == 5:
    pi[0] = pi[0] + 1
    if d == 1:
      a_line_text(d, src, 60, peek_tk(ts, t0 + 0), peek_tk(te, t0 + 0))
    return 1
  if k == 6:
    pi[0] = pi[0] + 1
    if d == 1:
      a_line_text(d, src, 61, peek_tk(ts, t0 + 0), peek_tk(te, t0 + 0))
    return 1
  if k == 7:
    pi[0] = pi[0] + 1
    if d == 1:
      a_line_text(d, src, 62, peek_tk(ts, t0 + 0), peek_tk(te, t0 + 0))
    return 1
  if k == 8:
    pi[0] = pi[0] + 1
    if d == 1:
      a_line_text(d, src, 63, peek_tk(ts, t0 + 0), peek_tk(te, t0 + 0))
    return 1
