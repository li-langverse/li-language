# Li bootstrap compiler — self-hosted lexer + parser (milestones 1-2 of the Li front end)
# Built by the C++ host:  lic build bootstrap/lic/main.li -o lic-from-li
#
# Subcommands:
#   lic-from-li --version
#   lic-from-li smoke
#   lic-from-li lex <file>       # token dump, same format as C++ `lic lex`
#   lic-from-li parse <file>     # token dump + `parse ok` / `parse error`
#
# The token stream must match the C++ Lexer (compiler/lexer) exactly; the
# parity gate is scripts/check_li_lexer_parity.sh. The parser must accept /
# reject exactly the files the C++ Parser (compiler/parser) does; the gate is
# scripts/check_li_parser_parity.sh, which also diffs the token stream the li
# parser consumes against `lic lex` (token-stream parity vs the C++ parser).
# Token kind codes are the C++ TokenKind enum ordinals:
#   Eof=0 Newline=1 Indent=2 Dedent=3 Ident=4 IntLit=5 FloatLit=6 BinaryLit=7
#   StringLit=8 KwProc=9 KwDef=10 KwType=11 KwAxiom=12 KwTheorem=13 KwLemma=14
#   KwObject=15 KwPrivate=16 KwPublic=17 KwImport=18 KwEnum=19 KwVar=20
#   KwLet=21 KwIf=22 KwElse=23 KwElif=24 KwWhile=25 KwFor=26 KwBreak=27
#   KwContinue=28 KwError=29 KwReturn=30 KwRaises=31 KwExtern=32 KwAsync=33
#   KwAwait=34 KwTrue=35 KwFalse=36 KwAnd=37 KwOr=38 KwNot=39 KwIs=40
#   KwRequires=41 KwEnsures=42 KwProbEnsures=43 KwDecreases=44 KwInvariant=45
#   KwResult=46 KwProtocol=47 KwCallable=48 LParen=49 RParen=50 LBracket=51
#   RBracket=52 LBrace=53 RBrace=54 Comma=55 Colon=56 Arrow=57 Eq=58 Plus=59
#   Minus=60 Star=61 StarStar=62 Slash=63 SlashSlash=64 Percent=65 Le=66 Lt=67
#   Ge=68 Gt=69 EqEq=70 Ne=71 Dot=72 DotDotLt=73 Pipe=74 Ellipsis=75 At=76
#
# Open-VC note: like bootstrap/prover/main.li, the CLI plumbing procs use
# `ensures result == 0 or result == 1` which the native engine leaves open;
# scripts/bootstrap_lic.sh therefore builds with --allow-open-vc (documented).
# The lexer is gated by token-stream parity and the parser by accept/reject
# parity, not by VC discharge.

extern def li_rt_argc() -> int
  requires true
  ensures true
extern def li_rt_argv(i: int) -> ptr
  requires true
  ensures true
extern def strcmp(a: ptr,  b: ptr) -> int
  requires true
  ensures true
extern def li_rt_str_len(s: ptr) -> int
  requires true
  ensures true
extern def li_rt_str_char_at(s: var ptr,  i: int) -> int
  requires true
  ensures true
extern def li_rt_str_eq(a: ptr,  b: ptr) -> int
  requires true
  ensures true
extern def bytes_slice_i(b: ptr,  off: int,  n: int) -> ptr
  requires true
  ensures true
extern def li_rt_read_file(path: ptr) -> ptr
  requires true
  ensures true
extern def li_rt_resolve_import(file_path: ptr,  module: ptr) -> ptr
  requires true
  ensures true
extern def li_rt_emit_token(code: int,  text: ptr,  s: int,  e: int) -> int
  requires true
  ensures true

# ---------------- canonical AST dump (self-host milestone 3: tree parity) ----
# The `ast <file>` subcommand emits an int-encoded canonical dump of the parse
# tree, byte-identical to the C++ `lic ast` dump (gate:
# scripts/check_li_ast_parity.sh). Node codes are the shared table in
# compiler/ast/include/li/ast_dump.hpp. Emission happens inline during the
# recursive-descent parse when the `d` (dump) flag is 1; postfix nodes and
# BinOp nodes print after their base/lhs operand subtree, mirroring the
# streaming order of the C++ dump walker.

extern def li_rt_ast_int(v: int) -> int
  requires true
  ensures true
extern def li_rt_ast_text(s: ptr,  start: int,  end: int) -> int
  requires true
  ensures true
extern def li_rt_ast_space() -> int
  requires true
  ensures true
extern def li_rt_ast_nl() -> int
  requires true
  ensures true
extern def li_rt_emit_err(code: int) -> int
  requires true
  ensures true

def a_line(d: int,  code: int) -> int
  requires true
  ensures result == 0
  decreases 0
=
  if d == 1:
    li_rt_ast_int(code)
    li_rt_ast_nl()
  return 0

def a_line_i(d: int,  code: int,  v: int) -> int
  requires true
  ensures result == 0
  decreases 0
=
  if d == 1:
    li_rt_ast_int(code)
    li_rt_ast_space()
    li_rt_ast_int(v)
    li_rt_ast_nl()
  return 0

def a_line_ii(d: int,  code: int,  v1: int,  v2: int) -> int
  requires true
  ensures result == 0
  decreases 0
=
  if d == 1:
    li_rt_ast_int(code)
    li_rt_ast_space()
    li_rt_ast_int(v1)
    li_rt_ast_space()
    li_rt_ast_int(v2)
    li_rt_ast_nl()
  return 0

def a_line_text(d: int,  src: var ptr,  code: int,  s: int,  e: int) -> int
  requires true
  ensures result == 0
  decreases 0
=
  if d == 1:
    li_rt_ast_int(code)
    li_rt_ast_space()
    li_rt_ast_text(src,  s,  e)
    li_rt_ast_nl()
  return 0

def a_line_text_t(d: int,  src: var ptr,  code: int,  s: int,  e: int) -> int
  requires true
  ensures result == 0
  decreases 0
=
  if d == 1:
    li_rt_ast_int(code)
    li_rt_ast_space()
    li_rt_ast_text(src,  s,  e)
    li_rt_ast_space()
    li_rt_ast_nl()
  return 0

def a_line_text_i(d: int,  src: var ptr,  code: int,  s: int,  e: int,  v: int) -> int
  requires true
  ensures result == 0
  decreases 0
=
  if d == 1:
    li_rt_ast_int(code)
    li_rt_ast_space()
    li_rt_ast_text(src,  s,  e)
    li_rt_ast_space()
    li_rt_ast_int(v)
    li_rt_ast_nl()
  return 0

def a_line_text_ii(d: int,  src: var ptr,  code: int,  s: int,  e: int, v1: int,  v2: int) -> int
  requires true
  ensures result == 0
  decreases 0
=
  if d == 1:
    li_rt_ast_int(code)
    li_rt_ast_space()
    li_rt_ast_text(src,  s,  e)
    li_rt_ast_space()
    li_rt_ast_int(v1)
    li_rt_ast_space()
    li_rt_ast_int(v2)
    li_rt_ast_nl()
  return 0

def a_line_text_iii(d: int,  src: var ptr,  code: int,  s: int,  e: int, v1: int,  v2: int,  v3: int) -> int
  requires true
  ensures result == 0
  decreases 0
=
  if d == 1:
    li_rt_ast_int(code)
    li_rt_ast_space()
    li_rt_ast_text(src,  s,  e)
    li_rt_ast_space()
    li_rt_ast_int(v1)
    li_rt_ast_space()
    li_rt_ast_int(v2)
    li_rt_ast_space()
    li_rt_ast_int(v3)
    li_rt_ast_nl()
  return 0

def a_line_text_text(d: int,  src: var ptr,  code: int,  s1: int,  e1: int, s2: int,  e2: int) -> int
  requires true
  ensures result == 0
  decreases 0
=
  if d == 1:
    var ta: ptr = src
    var tb: ptr = src
    li_rt_ast_int(code)
    li_rt_ast_space()
    li_rt_ast_text(ta,  s1,  e1)
    li_rt_ast_space()
    li_rt_ast_text(tb,  s2,  e2)
    li_rt_ast_nl()
  return 0

def a_line_text_i_text(d: int,  src: var ptr,  code: int,  s1: int,  e1: int, v: int,  s2: int,  e2: int) -> int
  requires true
  ensures result == 0
  decreases 0
=
  if d == 1:
    var ta: ptr = src
    var tb: ptr = src
    li_rt_ast_int(code)
    li_rt_ast_space()
    li_rt_ast_text(ta,  s1,  e1)
    li_rt_ast_space()
    li_rt_ast_int(v)
    li_rt_ast_space()
    li_rt_ast_text(tb,  s2,  e2)
    li_rt_ast_nl()
  return 0

def a_line_i_text_i(d: int,  code: int,  v1: int,  src: var ptr, s: int,  e: int,  v2: int) -> int
  requires true
  ensures result == 0
  decreases 0
=
  if d == 1:
    li_rt_ast_int(code)
    li_rt_ast_space()
    li_rt_ast_int(v1)
    li_rt_ast_space()
    li_rt_ast_text(src,  s,  e)
    li_rt_ast_space()
    li_rt_ast_int(v2)
    li_rt_ast_nl()
  return 0

def int_text_value(src: var ptr,  ts: var array[65536,  int],  te: var array[65536,  int], i: int) -> int
  requires true
  ensures result >= 0
  decreases 0
=
  var v: int = 0
  var p: int = peek_tk(ts,  i + 0)
  var en: int = peek_tk(te,  i + 0)
  while p < en:
    v = v * 10 + (li_rt_str_char_at(src, p) - 48)
    p = p + 1
  return v

type Pos65536 = {p: int | 0 <= p and p < 65536}

def peek_tk(buf: var array[65536,  int],  p: Pos65536) -> int
  requires true
  ensures result == buf[p]
  decreases 0
=
  return buf[p]

def set_tk(buf: var array[65536,  int],  p: Pos65536,  v: int) -> int
  requires true
  ensures result == v
  decreases 0
=
  buf[p] = v
  return v

type Pos64 = {p: int | 0 <= p and p < 64}

def peek64(buf: var array[64,  int],  p: Pos64) -> int
  requires true
  ensures result == buf[p]
  decreases 0
=
  return buf[p]

def set64(buf: var array[64,  int],  p: Pos64,  v: int) -> int
  requires true
  ensures result == v
  decreases 0
=
  buf[p] = v
  return v

def print_version() raises IO -> int
  requires true
  ensures result == 0
  decreases 0
=
  print("lic 0.2.0-bootstrap (compiled with Li)")
  return 0

def print_usage() raises IO -> int
  requires true
  ensures result == 1
  decreases 0
=
  print("usage: lic-from-li --version | smoke | lex <file> | parse <file> | ast <file>")
  return 1

# ------------------------------------------------------------------ lexer --
# Port of compiler/lexer/lexer.cpp (tokenize + process_line_begin +
# skip_whitespace_inline + the token switch). All state lives in array[1, int]
# counters plus the indent stack, mirroring the bootstrap prover's idioms.
# Tokens are buffered into tk/ts/te (kind,  start,  end) AND emitted when
# `emit == 1` so the `parse` subcommand re-dumps the exact stream it consumed
# (token-stream parity vs the C++ parser).

def store_token(tk: var array[65536,  int],  ts: var array[65536,  int], te: var array[65536,  int],  n: var array[1,  int],  src: var ptr, emit: int,  code: int,  s: int,  e: int) raises IO -> int
  requires true
  ensures result == 0
  decreases 0
=
  set_tk(tk,  n[0],  code)
  set_tk(ts,  n[0],  s)
  set_tk(te,  n[0],  e)
  if emit == 1:
    if code == 7:
      # Binary literal: the span stored is the full `0b10110100`, but the
      # token-stream dump (like the C++ lexer's `t.text`) shows the bits only.
      li_rt_emit_token(code,  src,  s + 2,  e)
    else:
      li_rt_emit_token(code,  src,  s,  e)
  n[0] = n[0] + 1
  return 0

def lex_source(src: var ptr,  tk: var array[65536,  int],  ts: var array[65536,  int], te: var array[65536,  int],  n: var array[1,  int], emit: int) raises IO -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  var srclen: int = li_rt_str_len(src)
  var pos: array[1, int]
  var at_ls: array[1, int]
  var bm: array[1, int]
  var pending: array[1, int]
  var istack: array[64, int]
  var isz: array[1, int]
  pos[0] = 0
  at_ls[0] = 1
  bm[0] = 0
  pending[0] = 0
  isz[0] = 1
  set64(istack,  0,  0)
  while pos[0] < srclen:
    if at_ls[0] == 1:
      # ---- process line begin (indentation,  comments,  `=` body marker) ----
      var i: int = pos[0]
      var spaces: int = 0
      while li_rt_str_char_at(src,  i) == 32:
        spaces = spaces + 1
        i = i + 1
      var c: int = li_rt_str_char_at(src,  i)
      if c == 9:
        return 1
      if c != 35:
        if bm[0] == 0:
          if spaces == 0:
            if c == 61:
              var nc: int = li_rt_str_char_at(src,  i + 1)
              if nc == 10 or nc == 13 or i + 1 >= srclen:
                store_token(tk,  ts,  te,  n,  src,  emit,  58,  i,  i + 1)
                bm[0] = 1
                isz[0] = 1
                set64(istack,  0,  0)
                pending[0] = 0
                pos[0] = i + 1
                if nc == 10:
                  at_ls[0] = 1
                else:
                  at_ls[0] = 0
              else:
                # C++ quirk: a `=` not followed by a newline is dropped
                # entirely (the tokenizer resumes after it).
                pos[0] = i + 1
                at_ls[0] = 0
            else:
              pos[0] = i
              at_ls[0] = 0
          else:
            pos[0] = i
            at_ls[0] = 0
        else:
          var top: int = peek64(istack,  isz[0] - 1)
          if pending[0] == 1:
            if spaces <= top:
              return 1
          if spaces > top:
            if spaces - top != 2:
              return 1
            set64(istack,  isz[0],  spaces)
            isz[0] = isz[0] + 1
            store_token(tk,  ts,  te,  n,  src,  emit,  2,  0,  0)
          else:
            if spaces < top:
              var dd: int = 1
              while dd == 1:
                if isz[0] > 1:
                  if peek64(istack,  isz[0] - 1) > spaces:
                    isz[0] = isz[0] - 1
                    store_token(tk,  ts,  te,  n,  src,  emit,  3,  0,  0)
                  else:
                    dd = 0
                else:
                  dd = 0
              if peek64(istack,  isz[0] - 1) != spaces:
                return 1
              if isz[0] == 1:
                if spaces == 0:
                  bm[0] = 0
          pending[0] = 0
          if li_rt_str_char_at(src,  i) == 10:
            pos[0] = i
            at_ls[0] = 0
          else:
            if li_rt_str_char_at(src,  i) == 61:
              var j: int = i + 1
              var jc: int = li_rt_str_char_at(src,  j)
              while jc == 32 or jc == 9:
                j = j + 1
                jc = li_rt_str_char_at(src,  j)
              if jc == 10 or jc == 13 or j >= srclen:
                store_token(tk,  ts,  te,  n,  src,  emit,  58,  i,  i + 1)
                pos[0] = j
                if jc == 10:
                  at_ls[0] = 1
                else:
                  at_ls[0] = 0
              else:
                pos[0] = i
                at_ls[0] = 0
            else:
              pos[0] = i
              at_ls[0] = 0
      if pos[0] >= srclen:
        break
      if li_rt_str_char_at(src,  pos[0]) == 10:
        pos[0] = pos[0] + 1
        at_ls[0] = 1
        store_token(tk,  ts,  te,  n,  src,  emit,  1,  0,  0)
        continue
    # ---- skip inline whitespace and comments ----
    var skipping: int = 1
    while skipping == 1:
      var sc: int = li_rt_str_char_at(src,  pos[0])
      if sc == 32:
        pos[0] = pos[0] + 1
      else:
        if sc == 13:
          pos[0] = pos[0] + 1
        else:
          if sc == 35:
            var cskip: int = 1
            while cskip == 1:
              var cc: int = li_rt_str_char_at(src,  pos[0])
              if cc == 10:
                cskip = 0
              else:
                if pos[0] >= srclen:
                  cskip = 0
                else:
                  pos[0] = pos[0] + 1
          else:
            skipping = 0
    if pos[0] >= srclen:
      break
    # ---- lex one token ----
    var start: int = pos[0]
    var c: int = li_rt_str_char_at(src,  start)
    pos[0] = start + 1
    if c == 10:
      store_token(tk,  ts,  te,  n,  src,  emit,  1,  0,  0)
      at_ls[0] = 1
      continue
    if c == 40:
      store_token(tk,  ts,  te,  n,  src,  emit,  49,  start,  pos[0])
      continue
    if c == 41:
      store_token(tk,  ts,  te,  n,  src,  emit,  50,  start,  pos[0])
      continue
    if c == 91:
      store_token(tk,  ts,  te,  n,  src,  emit,  51,  start,  pos[0])
      continue
    if c == 93:
      store_token(tk,  ts,  te,  n,  src,  emit,  52,  start,  pos[0])
      continue
    if c == 123:
      store_token(tk,  ts,  te,  n,  src,  emit,  53,  start,  pos[0])
      continue
    if c == 125:
      store_token(tk,  ts,  te,  n,  src,  emit,  54,  start,  pos[0])
      continue
    if c == 44:
      store_token(tk,  ts,  te,  n,  src,  emit,  55,  start,  pos[0])
      continue
    if c == 58:
      if bm[0] == 1:
        var j: int = pos[0]
        var jc: int = li_rt_str_char_at(src,  j)
        while jc == 32 or jc == 9:
          j = j + 1
          jc = li_rt_str_char_at(src,  j)
        if jc == 10 or jc == 35 or j >= srclen:
          pending[0] = 1
      store_token(tk,  ts,  te,  n,  src,  emit,  56,  start,  pos[0])
      continue
    if c == 46:
      if li_rt_str_char_at(src,  pos[0]) == 46:
        pos[0] = pos[0] + 1
        if li_rt_str_char_at(src,  pos[0]) == 46:
          pos[0] = pos[0] + 1
          store_token(tk,  ts,  te,  n,  src,  emit,  75,  start,  pos[0])
        else:
          if li_rt_str_char_at(src,  pos[0]) == 60:
            pos[0] = pos[0] + 1
            store_token(tk,  ts,  te,  n,  src,  emit,  73,  start,  pos[0])
          else:
            return 1
      else:
        store_token(tk,  ts,  te,  n,  src,  emit,  72,  start,  pos[0])
      continue
    if c == 64:
      store_token(tk,  ts,  te,  n,  src,  emit,  76,  start,  pos[0])
      continue
    if c == 124:
      store_token(tk,  ts,  te,  n,  src,  emit,  74,  start,  pos[0])
      continue
    if c == 43:
      store_token(tk,  ts,  te,  n,  src,  emit,  59,  start,  pos[0])
      continue
    if c == 45:
      if li_rt_str_char_at(src,  pos[0]) == 62:
        pos[0] = pos[0] + 1
        store_token(tk,  ts,  te,  n,  src,  emit,  57,  start,  pos[0])
      else:
        store_token(tk,  ts,  te,  n,  src,  emit,  60,  start,  pos[0])
      continue
    if c == 42:
      if li_rt_str_char_at(src,  pos[0]) == 42:
        pos[0] = pos[0] + 1
        store_token(tk,  ts,  te,  n,  src,  emit,  62,  start,  pos[0])
      else:
        store_token(tk,  ts,  te,  n,  src,  emit,  61,  start,  pos[0])
      continue
    if c == 47:
      if li_rt_str_char_at(src,  pos[0]) == 47:
        pos[0] = pos[0] + 1
        store_token(tk,  ts,  te,  n,  src,  emit,  64,  start,  pos[0])
      else:
        store_token(tk,  ts,  te,  n,  src,  emit,  63,  start,  pos[0])
      continue
    if c == 37:
      store_token(tk,  ts,  te,  n,  src,  emit,  65,  start,  pos[0])
      continue
    if c == 61:
      if li_rt_str_char_at(src,  pos[0]) == 61:
        pos[0] = pos[0] + 1
        store_token(tk,  ts,  te,  n,  src,  emit,  70,  start,  pos[0])
      else:
        store_token(tk,  ts,  te,  n,  src,  emit,  58,  start,  pos[0])
      continue
    if c == 60:
      if li_rt_str_char_at(src,  pos[0]) == 61:
        pos[0] = pos[0] + 1
        store_token(tk,  ts,  te,  n,  src,  emit,  66,  start,  pos[0])
      else:
        store_token(tk,  ts,  te,  n,  src,  emit,  67,  start,  pos[0])
      continue
    if c == 62:
      if li_rt_str_char_at(src,  pos[0]) == 61:
        pos[0] = pos[0] + 1
        store_token(tk,  ts,  te,  n,  src,  emit,  68,  start,  pos[0])
      else:
        store_token(tk,  ts,  te,  n,  src,  emit,  69,  start,  pos[0])
      continue
    if c == 33:
      if li_rt_str_char_at(src,  pos[0]) == 61:
        pos[0] = pos[0] + 1
        store_token(tk,  ts,  te,  n,  src,  emit,  71,  start,  pos[0])
      else:
        return 1
      continue
    if c == 34:
      var sp: int = start + 1
      var sd: int = 1
      while sd == 1:
        var ch: int = li_rt_str_char_at(src,  sp)
        if ch == 34:
          sd = 0
        else:
          if sp >= srclen:
            sd = 0
          else:
            sp = sp + 1
      if li_rt_str_char_at(src,  sp) == 34:
        sp = sp + 1
      store_token(tk,  ts,  te,  n,  src,  emit,  8,  start,  sp)
      pos[0] = sp
      continue
    if c >= 48:
      if c <= 57:
        if c == 48:
          if li_rt_str_char_at(src,  start + 1) == 98:
            var bpos: int = start + 2
            var bany: int = 0
            var bc: int = li_rt_str_char_at(src,  bpos)
            while bc == 48 or bc == 49:
              bpos = bpos + 1
              bany = 1
              bc = li_rt_str_char_at(src,  bpos)
            if bany == 1:
              store_token(tk,  ts,  te,  n,  src,  emit,  7,  start,  bpos)
              pos[0] = bpos
              continue
        var np: int = start + 1
        var is_float: int = 0
        var nc: int = li_rt_str_char_at(src,  np)
        while nc >= 48 and nc <= 57:
          np = np + 1
          nc = li_rt_str_char_at(src,  np)
        if is_float == 0:
          if nc == 46:
            var nd: int = li_rt_str_char_at(src,  np + 1)
            if nd >= 48:
              if nd <= 57:
                is_float = 1
                np = np + 1
                nc = li_rt_str_char_at(src,  np)
                while nc >= 48 and nc <= 57:
                  np = np + 1
                  nc = li_rt_str_char_at(src,  np)
        if nc == 101 or nc == 69:
          is_float = 1
          np = np + 1
          nc = li_rt_str_char_at(src,  np)
          if nc == 43 or nc == 45:
            np = np + 1
            nc = li_rt_str_char_at(src,  np)
          while nc >= 48 and nc <= 57:
            np = np + 1
            nc = li_rt_str_char_at(src,  np)
        # Literal suffixes (e.g. `f32` in `0.0f32`) are consumed from the
        # stream but excluded from the token text, matching lex_literal_suffix.
        var sfc: int = li_rt_str_char_at(src,  np)
        var np_end: int = np
        while (sfc >= 48 and sfc <= 57) or (sfc >= 65 and sfc <= 90) or (sfc >= 97 and sfc <= 122) or sfc == 95:
          np = np + 1
          sfc = li_rt_str_char_at(src,  np)
        if is_float == 1:
          store_token(tk,  ts,  te,  n,  src,  emit,  6,  start,  np_end)
        else:
          store_token(tk,  ts,  te,  n,  src,  emit,  5,  start,  np_end)
        pos[0] = np
        continue
    var is_id: int = 0
    if c >= 65:
      if c <= 90:
        is_id = 1
    if c >= 97:
      if c <= 122:
        is_id = 1
    if c == 95:
      is_id = 1
    if is_id == 1:
      var ip: int = start
      var ic: int = li_rt_str_char_at(src,  ip)
      while (ic >= 48 and ic <= 57) or (ic >= 65 and ic <= 90) or (ic >= 97 and ic <= 122) or ic == 95:
        ip = ip + 1
        ic = li_rt_str_char_at(src,  ip)
      var sl: ptr = bytes_slice_i(src,  start,  ip - start)
      var kw: int = 4
      if li_rt_str_eq(sl,  "proc") == 1:
        kw = 9
      if li_rt_str_eq(sl,  "def") == 1:
        kw = 10
      if li_rt_str_eq(sl,  "type") == 1:
        kw = 11
      if li_rt_str_eq(sl,  "axiom") == 1:
        kw = 12
      if li_rt_str_eq(sl,  "theorem") == 1:
        kw = 13
      if li_rt_str_eq(sl,  "lemma") == 1:
        kw = 14
      if li_rt_str_eq(sl,  "object") == 1:
        kw = 15
      if li_rt_str_eq(sl,  "private") == 1:
        kw = 16
      if li_rt_str_eq(sl,  "public") == 1:
        kw = 17
      if li_rt_str_eq(sl,  "import") == 1:
        kw = 18
      if li_rt_str_eq(sl,  "enum") == 1:
        kw = 19
      if li_rt_str_eq(sl,  "var") == 1:
        kw = 20
      if li_rt_str_eq(sl,  "let") == 1:
        kw = 21
      if li_rt_str_eq(sl,  "if") == 1:
        kw = 22
      if li_rt_str_eq(sl,  "else") == 1:
        kw = 23
      if li_rt_str_eq(sl,  "elif") == 1:
        kw = 24
      if li_rt_str_eq(sl,  "while") == 1:
        kw = 25
      if li_rt_str_eq(sl,  "for") == 1:
        kw = 26
      if li_rt_str_eq(sl,  "break") == 1:
        kw = 27
      if li_rt_str_eq(sl,  "continue") == 1:
        kw = 28
      if li_rt_str_eq(sl,  "error") == 1:
        kw = 29
      if li_rt_str_eq(sl,  "return") == 1:
        kw = 30
      if li_rt_str_eq(sl,  "raises") == 1:
        kw = 31
      if li_rt_str_eq(sl,  "extern") == 1:
        kw = 32
      if li_rt_str_eq(sl,  "async") == 1:
        kw = 33
      if li_rt_str_eq(sl,  "await") == 1:
        kw = 34
      if li_rt_str_eq(sl,  "true") == 1:
        kw = 35
      if li_rt_str_eq(sl,  "false") == 1:
        kw = 36
      if li_rt_str_eq(sl,  "and") == 1:
        kw = 37
      if li_rt_str_eq(sl,  "or") == 1:
        kw = 38
      if li_rt_str_eq(sl,  "not") == 1:
        kw = 39
      if li_rt_str_eq(sl,  "is") == 1:
        kw = 40
      if li_rt_str_eq(sl,  "requires") == 1:
        kw = 41
      if li_rt_str_eq(sl,  "ensures") == 1:
        kw = 42
      if li_rt_str_eq(sl,  "prob_ensures") == 1:
        kw = 43
      if li_rt_str_eq(sl,  "decreases") == 1:
        kw = 44
      if li_rt_str_eq(sl,  "invariant") == 1:
        kw = 45
      if li_rt_str_eq(sl,  "result") == 1:
        kw = 46
      if li_rt_str_eq(sl,  "Protocol") == 1:
        kw = 47
      if li_rt_str_eq(sl,  "Callable") == 1:
        kw = 48
      store_token(tk,  ts,  te,  n,  src,  emit,  kw,  start,  ip)
      pos[0] = ip
      continue
    return 1
  # ---- end of source: unwind remaining body indentation, then Eof ----
  if bm[0] == 1:
    var dd2: int = 1
    while dd2 == 1:
      if isz[0] > 1:
        isz[0] = isz[0] - 1
        store_token(tk,  ts,  te,  n,  src,  emit,  3,  0,  0)
      else:
        dd2 = 0
  # Eof lexeme is empty (start=0,  end=0); li_rt_argv(0) is a safe dummy
  # pointer so the moved `src` is not reused outside the loop.
  store_token(tk,  ts,  te,  n,  li_rt_argv(0),  emit,  0,  0,  0)
  return 0

# ----------------------------------------------------------------- parser --
# Validating recursive-descent port of compiler/parser/parser.cpp. The C++
# parser records a diagnostic for every syntax error and `lic parse` fails if
# any diagnostic exists, so the li parser mirrors the exact set of error
# conditions in a sticky `err` flag: err == 1 <=> C++ diagnostics non-empty.
# Spans / AST values are irrelevant for accept/reject parity and are omitted.

def cur_kind(tk: var array[65536,  int],  n: var array[1,  int], pi: var array[1,  int],  err: var array[1,  int]) -> int
  requires true
  ensures result >= 0
  decreases 0
=
  var i: int = pi[0]
  if i >= n[0]:
    i = n[0] - 1
    err[0] = 1
  return peek_tk(tk,  i)

def peek_off(tk: var array[65536,  int],  n: var array[1,  int], pi: var array[1,  int],  off: int) -> int
  requires true
  ensures result >= 0
  decreases 0
=
  var j: int = pi[0] + off
  if j >= n[0]:
    j = n[0] - 1
  return peek_tk(tk,  j)

def accept_k(tk: var array[65536,  int],  n: var array[1,  int], pi: var array[1,  int],  err: var array[1,  int],  k: int) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  if cur_kind(tk,  n,  pi,  err) == k:
    pi[0] = pi[0] + 1
    return 1
  return 0

def expect_k(tk: var array[65536,  int],  n: var array[1,  int], pi: var array[1,  int],  err: var array[1,  int],  k: int) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  if accept_k(tk,  n,  pi,  err,  k) == 1:
    return 1
  err[0] = 1
  return 0

def skip_newlines(tk: var array[65536,  int],  n: var array[1,  int], pi: var array[1,  int],  err: var array[1,  int]) -> int
  requires true
  ensures result == 0
  decreases 0
=
  while cur_kind(tk,  n,  pi,  err) == 1:
    pi[0] = pi[0] + 1
  return 0

def skip_param_layout(tk: var array[65536,  int],  n: var array[1,  int], pi: var array[1,  int],  err: var array[1,  int]) -> int
  requires true
  ensures result == 0
  decreases 0
=
  skip_newlines(tk,  n,  pi,  err)
  while cur_kind(tk,  n,  pi,  err) == 2:
    pi[0] = pi[0] + 1
  return 0

def tok_is(src: var ptr,  ts: var array[65536,  int],  te: var array[65536,  int], i: int,  s: ptr) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  var len: int = li_rt_str_len(s)
  var st: int = peek_tk(ts,  i + 0)
  var en: int = peek_tk(te,  i + 0)
  if en - st != len:
    return 0
  var j: int = 0
  while j < len:
    if li_rt_str_char_at(src,  st + j) != li_rt_str_char_at(s,  j):
      return 0
    j = j + 1
  return 1

# Compare the text of two tokens (by span), so the same identifier can be
# matched across signature and body positions.
def tok_eq(src: var ptr, ts: var array[65536, int], te: var array[65536, int],
           i: int, j: int) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  var s1: int = peek_tk(ts, i + 0)
  var e1: int = peek_tk(te, i + 0)
  var s2: int = peek_tk(ts, j + 0)
  var e2: int = peek_tk(te, j + 0)
  if e1 - s1 != e2 - s2:
    return 0
  var k: int = 0
  while k < e1 - s1:
    if li_rt_str_char_at(src, s1 + k) != li_rt_str_char_at(src, s2 + k):
      return 0
    k = k + 1
  return 1

def prec_of(k: int) -> int
  requires true
  ensures result >= -1
  decreases 0
=
  if k == 57:
    return 0
  if k == 38:
    return 1
  if k == 37:
    return 2
  if k == 70:
    return 3
  if k == 71:
    return 3
  if k == 67:
    return 3
  if k == 66:
    return 3
  if k == 69:
    return 3
  if k == 68:
    return 3
  if k == 59:
    return 4
  if k == 60:
    return 4
  if k == 61:
    return 5
  if k == 63:
    return 5
  if k == 65:
    return 5
  if k == 64:
    return 5
  if k == 62:
    return 6
  if k == 76:
    return 6
  return -1

def at_fn_kw(tk: var array[65536,  int],  n: var array[1,  int], pi: var array[1,  int],  err: var array[1,  int]) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  var k: int = cur_kind(tk,  n,  pi,  err)
  if k == 10:
    return 1
  if k == 9:
    return 1
  return 0

def consume_for_kw(src: var ptr,  tk: var array[65536,  int],  ts: var array[65536,  int], te: var array[65536,  int],  n: var array[1,  int], pi: var array[1,  int],  err: var array[1,  int]) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  if cur_kind(tk,  n,  pi,  err) == 26:
    pi[0] = pi[0] + 1
    return 1
  if cur_kind(tk,  n,  pi,  err) == 4:
    if tok_is(src,  ts,  te,  pi[0],  "for") == 1:
      pi[0] = pi[0] + 1
      return 1
  return 0

def parse_postfix(src: var ptr,  tk: var array[65536,  int],  ts: var array[65536,  int], te: var array[65536,  int],  n: var array[1,  int], pi: var array[1,  int],  err: var array[1,  int],  d: int) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  var loop: int = 1
  while loop == 1:
    if cur_kind(tk,  n,  pi,  err) == 72:
      pi[0] = pi[0] + 1
      if cur_kind(tk,  n,  pi,  err) != 4:
        err[0] = 1
        return 1
      var ft: int = pi[0]
      # Scan the `.ident` chain ahead: if it ends in `(`,  the whole chain is
      # a method call and every field in it peels away (mirroring the C++
      # peel_method_receiver),  with the innermost field as the method name.
      var j: int = pi[0] + 1
      var mcall: int = 0
      while peek_off(tk, n, pi, j - pi[0]) == 72:
        if peek_off(tk, n, pi, j - pi[0] + 1) == 4:
          j = j + 2
        else:
          break
      if peek_off(tk, n, pi, j - pi[0]) == 49:
        mcall = 1
      if mcall == 1:
        if d == 1:
          a_line_text(d, src, 70, peek_tk(ts, ft), peek_tk(te, ft))
        pi[0] = j
        pi[0] = pi[0] + 1
        if cur_kind(tk, n, pi, err) != 50:
          var done: int = 0
          while done == 0:
            if parse_expr(src, tk, ts, te, n, pi, err, 0, d) == 0:
              return 0
            if accept_k(tk, n, pi, err, 55) == 1:
              done = 0
            else:
              done = 1
        if expect_k(tk, n, pi, err, 50) == 0:
          return 0
        continue
      pi[0] = pi[0] + 1
      if d == 1:
        a_line_text(d, src, 69, peek_tk(ts, ft), peek_tk(te, ft))
      continue
    if cur_kind(tk, n, pi, err) == 51:
      pi[0] = pi[0] + 1
      if d == 1:
        a_line(d, 68)
      if parse_expr(src, tk, ts, te, n, pi, err, 0, d) == 0:
        return 0
      if expect_k(tk, n, pi, err, 52) == 0:
        return 0
      continue
    loop = 0
  return 1

def parse_primary(src: var ptr, tk: var array[65536, int], ts: var array[65536, int], te: var array[65536, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], d: int) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  var k: int = cur_kind(tk, n, pi, err)
  if k == 34:
    pi[0] = pi[0] + 1
    if d == 1:
      a_line(d, 71)
    if parse_primary(src, tk, ts, te, n, pi, err, d) == 0:
      return 0
    return parse_postfix(src, tk, ts, te, n, pi, err, d)
  if k == 8:
    var t0: int = pi[0]
    pi[0] = pi[0] + 1
    if d == 1:
      a_line_text(d, src, 63, peek_tk(ts, t0 + 0), peek_tk(te, t0 + 0))
    return parse_postfix(src, tk, ts, te, n, pi, err, d)
  if k == 5:
    var t1: int = pi[0]
    pi[0] = pi[0] + 1
    if d == 1:
      a_line_text(d, src, 60, peek_tk(ts, t1 + 0), peek_tk(te, t1 + 0))
    return parse_postfix(src, tk, ts, te, n, pi, err, d)
  if k == 6:
    var t2: int = pi[0]
    pi[0] = pi[0] + 1
    if d == 1:
      a_line_text(d, src, 61, peek_tk(ts, t2 + 0), peek_tk(te, t2 + 0))
    return parse_postfix(src, tk, ts, te, n, pi, err, d)
  if k == 7:
    var t3: int = pi[0]
    pi[0] = pi[0] + 1
    if d == 1:
      a_line_text(d, src, 62, peek_tk(ts, t3 + 0), peek_tk(te, t3 + 0))
    return parse_postfix(src, tk, ts, te, n, pi, err, d)
  if k == 4 or k == 46 or k == 35 or k == 36:
    var t4: int = pi[0]
    pi[0] = pi[0] + 1
    if accept_k(tk, n, pi, err, 49) == 1:
      if d == 1:
        a_line_text(d, src, 66, peek_tk(ts, t4 + 0), peek_tk(te, t4 + 0))
      if cur_kind(tk, n, pi, err) != 50:
        var done: int = 0
        while done == 0:
          if parse_expr(src, tk, ts, te, n, pi, err, 0, d) == 0:
            return 0
          if accept_k(tk, n, pi, err, 55) == 1:
            done = 0
          else:
            done = 1
      if expect_k(tk, n, pi, err, 50) == 0:
        return 0
    else:
      if d == 1:
        a_line_text(d, src, 64, peek_tk(ts, t4 + 0), peek_tk(te, t4 + 0))
    return parse_postfix(src, tk, ts, te, n, pi, err, d)
  if accept_k(tk, n, pi, err, 49) == 1:
    if parse_expr(src, tk, ts, te, n, pi, err, 0, d) == 0:
      return 0
    if expect_k(tk, n, pi, err, 50) == 0:
      return 0
    return parse_postfix(src, tk, ts, te, n, pi, err, d)
  err[0] = 1
  return 0

def parse_expr(src: var ptr, tk: var array[65536, int], ts: var array[65536, int], te: var array[65536, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], min_prec: int, d: int) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  var left_ok: int = 0
  var k: int = cur_kind(tk, n, pi, err)
  if k == 39:
    pi[0] = pi[0] + 1
    if d == 1:
      a_line(d, 67)
    left_ok = parse_expr(src, tk, ts, te, n, pi, err, 100, d)
  if k == 60:
    pi[0] = pi[0] + 1
    left_ok = parse_primary(src, tk, ts, te, n, pi, err, d)
  if k != 39:
    if k != 60:
      left_ok = parse_primary(src, tk, ts, te, n, pi, err, d)
  if left_ok == 0:
    return 0
  while 1 == 1:
    var p: int = prec_of(cur_kind(tk, n, pi, err))
    if p < 0:
      break
    if p < min_prec:
      break
    var opk: int = cur_kind(tk, n, pi, err)
    pi[0] = pi[0] + 1
    if d == 1:
      a_line_i(d, 65, opk)
    if parse_expr(src, tk, ts, te, n, pi, err, p + 1, d) == 0:
      return 0
  return 1

def parse_contract_expr(src: var ptr, tk: var array[65536, int], ts: var array[65536, int], te: var array[65536, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], d: int) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  skip_newlines(tk, n, pi, err)
  return parse_expr(src, tk, ts, te, n, pi, err, 0, d)

def parse_type(src: var ptr, tk: var array[65536, int], ts: var array[65536, int], te: var array[65536, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], d: int) -> int
  requires true
  ensures result == 1
  decreases 0
=
  if accept_k(tk, n, pi, err, 53) == 1:
    if cur_kind(tk, n, pi, err) != 4:
      err[0] = 1
      return 1
    var rv: int = pi[0]
    pi[0] = pi[0] + 1
    expect_k(tk, n, pi, err, 56)
    if d == 1:
      a_line_text_i(d, src, 22, peek_tk(ts, rv + 0), peek_tk(te, rv + 0), 0)
    parse_type(src, tk, ts, te, n, pi, err, d)
    expect_k(tk, n, pi, err, 74)
    parse_contract_expr(src, tk, ts, te, n, pi, err, d)
    expect_k(tk, n, pi, err, 54)
    return 1
  var isv: int = 0
  if cur_kind(tk, n, pi, err) == 20:
    isv = 1
    pi[0] = pi[0] + 1
  var k: int = cur_kind(tk, n, pi, err)
  if k != 4:
    if k != 48:
      if k != 47:
        err[0] = 1
        return 1
  var name: int = 0
  if k == 48:
    name = 1
  if k == 4:
    if tok_is(src, ts, te, pi[0], "Callable") == 1:
      name = 1
    if tok_is(src, ts, te, pi[0], "array") == 1:
      name = 2
    if tok_is(src, ts, te, pi[0], "tuple") == 1:
      name = 3
    if tok_is(src, ts, te, pi[0], "simd") == 1:
      name = 4
  var nt: int = pi[0]
  pi[0] = pi[0] + 1
  if name == 1:
    if accept_k(tk, n, pi, err, 51) == 1:
      if d == 1:
        a_line_i(d, 24, isv)
      if accept_k(tk, n, pi, err, 51) == 0:
        err[0] = 1
        return 1
      if cur_kind(tk, n, pi, err) != 52:
        var done: int = 0
        while done == 0:
          parse_type(src, tk, ts, te, n, pi, err, d)
          if accept_k(tk, n, pi, err, 55) == 1:
            done = 0
          else:
            done = 1
      expect_k(tk, n, pi, err, 52)
      expect_k(tk, n, pi, err, 55)
      parse_type(src, tk, ts, te, n, pi, err, d)
      expect_k(tk, n, pi, err, 52)
      return 1
    if d == 1:
      a_line_text_i(d, src, 20, peek_tk(ts, nt + 0), peek_tk(te, nt + 0), isv)
    return 1
  if name == 2:
    if accept_k(tk, n, pi, err, 51) == 1:
      if cur_kind(tk, n, pi, err) != 5:
        err[0] = 1
        return 1
      var sz: int = pi[0]
      pi[0] = pi[0] + 1
      if d == 1:
        a_line_ii(d, 21, isv, int_text_value(src, ts, te, sz))
      expect_k(tk, n, pi, err, 55)
      parse_type(src, tk, ts, te, n, pi, err, d)
      expect_k(tk, n, pi, err, 52)
      return 1
    if d == 1:
      a_line_text_i(d, src, 20, peek_tk(ts, nt + 0), peek_tk(te, nt + 0), isv)
    return 1
  if name == 3:
    if accept_k(tk, n, pi, err, 51) == 1:
      var named: int = 0
      if cur_kind(tk, n, pi, err) == 4:
        if peek_off(tk, n, pi, 1) == 56:
          named = 1
      if named == 1:
        if d == 1:
          a_line_ii(d, 26, isv, 0)
        if cur_kind(tk, n, pi, err) != 52:
          var done: int = 0
          while done == 0:
            var fn: int = pi[0]
            pi[0] = pi[0] + 1
            expect_k(tk, n, pi, err, 56)
            if d == 1:
              a_line_text_ii(d, src, 27, peek_tk(ts, fn), peek_tk(te, fn), 0, 0)
            parse_type(src, tk, ts, te, n, pi, err, d)
            if accept_k(tk, n, pi, err, 55) == 1:
              done = 0
            else:
              done = 1
      else:
        if d == 1:
          a_line_text_ii(d, src, 23, peek_tk(ts, nt + 0), peek_tk(te, nt + 0), isv, 0)
        if cur_kind(tk, n, pi, err) != 52:
          parse_type(src, tk, ts, te, n, pi, err, d)
          if accept_k(tk, n, pi, err, 55) == 1:
            if cur_kind(tk, n, pi, err) == 75:
              pi[0] = pi[0] + 1
              if d == 1:
                a_line(d, 82)
            else:
              var done: int = 0
              while done == 0:
                parse_type(src, tk, ts, te, n, pi, err, d)
                if accept_k(tk, n, pi, err, 55) == 1:
                  done = 0
                else:
                  done = 1
      expect_k(tk, n, pi, err, 52)
      return 1
    if d == 1:
      a_line_text_i(d, src, 20, peek_tk(ts, nt + 0), peek_tk(te, nt + 0), isv)
    return 1
  if name == 4:
    if accept_k(tk, n, pi, err, 51) == 1:
      if d == 1:
        a_line_i(d, 28, isv)
      parse_type(src, tk, ts, te, n, pi, err, d)
      expect_k(tk, n, pi, err, 55)
      if cur_kind(tk, n, pi, err) == 5:
        var sz: int = pi[0]
        pi[0] = pi[0] + 1
        if d == 1:
          a_line_i(d, 83, int_text_value(src, ts, te, sz))
      else:
        parse_type(src, tk, ts, te, n, pi, err, d)
      expect_k(tk, n, pi, err, 52)
      return 1
    if d == 1:
      a_line_text_i(d, src, 20, peek_tk(ts, nt + 0), peek_tk(te, nt + 0), isv)
    return 1
  if accept_k(tk, n, pi, err, 51) == 1:
    if d == 1:
      a_line_text_ii(d, src, 23, peek_tk(ts, nt + 0), peek_tk(te, nt + 0), isv, 0)
    if cur_kind(tk, n, pi, err) != 52:
      var done: int = 0
      while done == 0:
        parse_type(src, tk, ts, te, n, pi, err, d)
        if accept_k(tk, n, pi, err, 55) == 1:
          done = 0
        else:
          done = 1
    expect_k(tk, n, pi, err, 52)
    return 1
  if d == 1:
    a_line_text_i(d, src, 20, peek_tk(ts, nt + 0), peek_tk(te, nt + 0), isv)
  return 1

def parse_type_params(src: var ptr, tk: var array[65536, int], ts: var array[65536, int], te: var array[65536, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], d: int, rec: int) -> int
  requires true
  ensures result == 1
  decreases 0
=
  if accept_k(tk, n, pi, err, 51) == 0:
    return 1
  if cur_kind(tk, n, pi, err) != 52:
    var done: int = 0
    while done == 0:
      if cur_kind(tk, n, pi, err) != 4:
        err[0] = 1
        break
      var tn: int = pi[0]
      pi[0] = pi[0] + 1
      var bnd: int = -1
      if accept_k(tk, n, pi, err, 56) == 1:
        if cur_kind(tk, n, pi, err) != 4:
          err[0] = 1
        else:
          bnd = pi[0]
          pi[0] = pi[0] + 1
      if d == 1:
        if rec == 1:
          if bnd >= 0:
            a_line_text_text(d, src, 5, peek_tk(ts, tn + 0), peek_tk(te, tn + 0), peek_tk(ts, bnd), peek_tk(te, bnd))
          else:
            a_line_text_t(d, src, 5, peek_tk(ts, tn + 0), peek_tk(te, tn + 0))
        else:
          a_line_text_t(d, src, 5, peek_tk(ts, tn + 0), peek_tk(te, tn + 0))
      if accept_k(tk, n, pi, err, 55) == 1:
        done = 0
      else:
        done = 1
  expect_k(tk, n, pi, err, 52)
  return 1

def parse_param(src: var ptr, tk: var array[65536, int], ts: var array[65536, int], te: var array[65536, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], d: int) -> int
  requires true
  ensures result == 1
  decreases 0
=
  skip_param_layout(tk, n, pi, err)
  var pn: int = pi[0]
  pi[0] = pi[0] + 1
  if d == 1:
    a_line_text(d, src, 6, peek_tk(ts, pn + 0), peek_tk(te, pn + 0))
  expect_k(tk, n, pi, err, 56)
  parse_type(src, tk, ts, te, n, pi, err, d)
