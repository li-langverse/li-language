  if cur_kind(tk, n, pi, err) == 25:
    pi[0] = pi[0] + 1
    a_line(d, 42)
    parse_expr(src, tk, ts, te, n, pi, err, 0, d)
    if cur_kind(tk, n, pi, err) == 56:
