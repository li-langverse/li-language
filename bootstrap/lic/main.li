  if cur_kind(tk, n, pi, err) != 4:
    err[0] = 1
    return 1
  var fi: int = pi[0]
  var li: int = pi[0]
  pi[0] = pi[0] + 1
  while accept_k(tk, n, pi, err, 72) == 1:
    if cur_kind(tk, n, pi, err) != 4:
      err[0] = 1
      break
    li = pi[0]
    pi[0] = pi[0] + 1
  var ai: int = -1
  if cur_kind(tk, n, pi, err) == 4:
    if tok_is(src, ts, te, pi[0], "as") == 1:
