                  else:
                    var f4: array[44, int]
                    mir_fdef(f4)
                    f4[0] = peek65536(darena, rec + 2)
                    f4[2] = 2
                    var rf4: int = retf_proc
                    var ri4: int = reti64_proc
                    if mir_desc_float(darena,  rec,  src,  ts,  te,  ftok,  nft,  ftmp,  fatok,  nfa, itmp) == 1:
                      rf4 = 1
                    if mir_rec_name_i64(darena,  rec,  src,  ts,  te,  itok,  nit,  itmp) == 1:
                      ri4 = 1
                    f4[19] = rf4
                    f4[20] = ri4
                    mir_ins_line(src,  f4,  3,  0,  -1,  lastop)
                else:
                  var f5: array[44, int]
                  mir_fdef(f5)
                  mir_ins_line(src,  f5,  0,  0,  -1,  lastop)
  skip_newlines(tk,  n,  pi,  err)
  return 0

def mir_var_decl(darena: var array[65536, int],  dasp: var array[1, int], src: var ptr,  tk: var array[262144, int],  ts: var array[262144, int], te: var array[262144, int],  n: var array[1, int],  pi: var array[1, int], err: var array[1, int],  tc: var array[1, int],  lastop: var array[1, int], ftok: var array[4096, int],  nft: var array[1, int], ftmp: var array[32768, int],  itok: var array[4096, int],  nit: var array[1, int], itmp: var array[4096, int],  fatok: var array[512, int],  nfa: var array[1, int], matok: var array[512, int],  nmat: var array[1, int], ptok: var array[128, int],  pex: var array[128, int], pp0: var array[128, int],  ppn: var array[128, int], pret: var array[128, int],  pn: var array[1, int], ptok2: var array[512, int],  pty: var array[512, int], pelems: var array[512, int],  pef: var array[512, int], pei: var array[512, int],  pvar: var array[512, int], retf_proc: int,  reti64_proc: int, lhead: var array[32, int],  lexit: var array[32, int],  nlp: var array[1, int]) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  pi[0] = pi[0] + 1
  var vn: int = pi[0]
  pi[0] = pi[0] + 1
  expect_k(tk,  n,  pi,  err, 56)
  # Save type name position for object type lookup
  var type_name_pos: int = pi[0]
  var ti: array[6, int]
  if mir_type_info(src,  tk,  ts,  te,  n,  pi,  err, ti) == 1:
    return 1
  var has_init: int = 0
  var rec: int = -1
  var init_s: int = 0
  var init_e: int = 0
  if accept_k(tk,  n,  pi,  err, 58) == 1:
    has_init = 1
    init_s = pi[0]
    rec = mir_parse_expr(darena,  dasp,  src,  tk,  ts,  te,  n,  pi,  err, 0)
    init_e = pi[0]
    if rec < 0:
      return 1
  var ty: int = ti[0]
  # Array-shape binop binding check (C++ E0302 variable-type-mismatch
  # class; closes math_linalg/elementwise_len_mismatch). C++ type_of on an
  # elementwise ident-array binop yields elem + array_size = max(szl,
  # szr) (broadcast len-1 allowed); the var-decl binding then requires the
  # declared array_size to equal that shape exactly. The walker lowers
  # the binop with esz = max unconditionally, so reject the mismatched
  # binding here on the mir lane:
  #   var c: array[4, float] = a * b   (a: array[4], b: array[8]) -> error
  # Broadcast still binds: array[4] = a1 * b4 (max 4) accepts, as does
  # array[8] = a * b (max 8). Reuters BOTH operand sizes resolved from the
  # same family table (float or int): cross-family (float*int) is not an
  # elementwise array binop in C++ and must not fire.
  if has_init == 1:
    if ty == 5:
      var asz_a: int = 0
      var asz_b: int = 0
      var bi2: int = init_s
      var bfound: int = 0
      while bi2 + 2 < init_e:
        if bfound == 0:
          if peek_tk(tk, bi2) == 4:
            if peek_tk(tk, bi2 + 1) == 59 or peek_tk(tk, bi2 + 1) == 61:
              if peek_tk(tk, bi2 + 2) == 4:
                var fa2: int = mir_farray_size(src,  ts,  te,  peek_tk(ts, bi2 + 0),  peek_tk(te, bi2 + 0),  ptok2,  pelems,  pef,  pp0,  ppn,  pn,  fatok,  nfa)
                var fb2: int = mir_farray_size(src,  ts,  te,  peek_tk(ts, bi2 + 2),  peek_tk(te, bi2 + 2),  ptok2,  pelems,  pef,  pp0,  ppn,  pn,  fatok,  nfa)
                if fa2 <= 0:
                  var ia2: int = mir_iarray_size(src,  ts,  te,  peek_tk(ts, bi2 + 0),  peek_tk(te, bi2 + 0),  fatok,  nfa)
                  var ib2: int = mir_iarray_size(src,  ts,  te,  peek_tk(ts, bi2 + 2),  peek_tk(te, bi2 + 2),  fatok,  nfa)
                  if ia2 > 0:
                    if ib2 > 0:
                      asz_a = ia2
                      asz_b = ib2
                      bfound = 1
                else:
                  if fb2 > 0:
                    asz_a = fa2
                    asz_b = fb2
                    bfound = 1
        bi2 = bi2 + 1
      if bfound == 1:
        var bmax: int = asz_a
        if asz_b > bmax:
          bmax = asz_b
        if ti[2] != bmax:
          err[0] = 1
          return 1
  # Object type check: if type name is a registered object type, flatten fields
  if ty == 6:
    var obj_ti: int = mir_obj_find_type(src, ts, te, itmp, peek_tk(ts, type_name_pos + 0), peek_tk(te, type_name_pos + 0))
    if obj_ti >= 0:
      # Register this variable as an object
      mir_obj_reg_var(itmp, peek_tk(ts, vn + 0), peek_tk(te, vn + 0), obj_ti)
      # Emit LocalAlloc for every leaf field with mangled name
      # __li_o_<var>_<field> (nested object fields flatten to
      # __li_o_<var>_<parent>_<leaf> like the C++ layout).
      var nfld: int = mir_obj_field_count(itmp, obj_ti)
      var ff_arr: array[2, int]
      mir_obj_alloc_fields(src,  ts,  te,  itmp,  peek_tk(ts, vn + 0),  peek_tk(te, vn + 0),  obj_ti,  -1, lastop)
      # Call init returning object: `var u: T = f()` lowers to cr<N> slots,
      # CallProc with OBJ layout, then field copies into the var slots.
      # Write-back state for a var-Object first arg (e.g. layout_region_rect
      # in studio_shell_composables): the wb id is consumed BEFORE the
      # nested-arg temps and the cr id, mirroring the C++ counter order.
      var vd_on: int = 0
      var vd_ti: int = -1
      var vd_nf: int = 0
      var vd_wb: int = -1
      var vd_ps: int = 0
      var vd_pe: int = 0
      if has_init == 1:
        if peek65536(darena, rec + 0) == 4:
          # var-Object first arg: allocate wb<N> slots and copy the receiver
          # in before any call-argument evaluation (wb id first).
          if peek65536(darena, rec + 4) >= 1:
            var fst_a: int = peek65536(darena, peek65536(darena, rec + 5) + 0)
            if peek65536(darena, fst_a + 0) == 3:
              var cpid: int = mir_proc_find(src, ts, te, peek65536(darena, rec + 1), peek65536(darena, rec + 2), ptok, pn)
              if mir_method_first_var(src, ts, te, cpid, pp0, pvar) == 1:
                var wbt: int = mir_obj_find_var(src, ts, te, itmp, peek65536(darena, fst_a + 1), peek65536(darena, fst_a + 2))
                if wbt >= 0:
                  vd_on = 1
                  vd_ti = wbt
                  vd_nf = mir_obj_field_count(itmp, wbt)
                  vd_ps = peek65536(darena, fst_a + 1)
                  vd_pe = peek65536(darena, fst_a + 2)
                  vd_wb = tc[0]
                  tc[0] = vd_wb + 1
                  mir_wb_alloc_fields(src, ts, te, itmp, vd_wb, vd_ti, -1)
                  var vwfi: int = 0
                  while vwfi < vd_nf:
                    mir_obj_emit_copy(src, ts, te, itmp, vd_ti, vwfi, 0, 0, vd_ps, vd_pe, 2, vd_wb, tc)
                    vwfi = vwfi + 1
          # Pre-evaluate nested-call args (kind 4) before the cr dest alloc
          # (counter order must match C++: call args first, then the cr id).
          var ap4: int = 0
          while ap4 < peek65536(darena, rec + 4):
            var ar4: int = peek65536(darena, peek65536(darena, rec + 5) + ap4)
            if peek65536(darena, ar4 + 0) == 4:
              if mir_lower_expr(darena,  dasp,  ar4,  src,  tk,  ts,  te,  n,  pi,  err,  tc,  lastop, ftok,  nft,  ftmp,  itok,  nit,  itmp,  fatok,  nfa, matok,  nmat, ptok,  pex,  pp0,  ppn,  pret,  pn,  ptok2,  pty,  pelems,  pef, pei,  pvar) == 1:
                return 1
            ap4 = ap4 + 1
          var crid: int = tc[0]
          tc[0] = crid + 1
          mir_cr_alloc_fields(src,  ts,  te,  itmp,  crid,  obj_ti,  -1)
          # INS 8 CallProc with mangled base dest + callee + OBJ layout
          li_rt_mir_str("INS")
          li_rt_ast_space()
          li_rt_ast_int(8)
          li_rt_ast_space()
          li_rt_ast_int(0)
          li_rt_ast_space()
          li_rt_ast_int(0)
          li_rt_ast_space()
          li_rt_mir_str("__li_o___cr")
          li_rt_ast_int(crid)
          # str_value cell (empty), then callee name cell
          li_rt_ast_space()
          li_rt_ast_space()
          li_rt_mir_esc(src,  peek65536(darena, rec + 1),  peek65536(darena, rec + 2))
          # 3 empty name cells (lhs_ident, rhs_ident, label)
          li_rt_ast_space()
          li_rt_ast_space()
          li_rt_ast_space()
          # f18..f21
          li_rt_ast_space()
          li_rt_ast_int(0)
          li_rt_ast_space()
          li_rt_ast_int(0)
          li_rt_ast_space()
          li_rt_ast_int(0)
          li_rt_ast_space()
          li_rt_ast_int(1)
          # name cell 6 (empty)
          li_rt_ast_space()
          # f25..f36
          li_rt_ast_space()
          li_rt_ast_int(0)
          li_rt_ast_space()
          li_rt_ast_int(1)
          li_rt_ast_space()
          li_rt_ast_int(0)
          li_rt_ast_space()
          li_rt_ast_int(0)
          li_rt_ast_space()
          li_rt_ast_int(0)
          li_rt_ast_space()
          li_rt_ast_int(0)
          li_rt_ast_space()
          li_rt_ast_int(0)
          li_rt_ast_space()
          li_rt_ast_int(0)
          li_rt_ast_space()
          li_rt_ast_int(0)
          li_rt_ast_space()
          li_rt_ast_int(0)
          li_rt_ast_space()
          li_rt_ast_int(0)
          li_rt_ast_space()
          li_rt_ast_int(0)
