def parse_contract(src: var ptr, tk: var array[65536, int], ts: var array[65536, int], te: var array[65536, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], d: int) -> int
  requires true
  ensures result == 1
  decreases 0
=
  var ck: int = 0
  var k0: int = cur_kind(tk, n, pi, err)
  if k0 == 42:
    ck = 1
  if k0 == 43:
    ck = 4
  if k0 == 44:
    ck = 2
  if k0 == 45:
    ck = 3
  pi[0] = pi[0] + 1
  # The proposition is parsed before the given/samples tail,  so the contract
  # line prints after the expr on both implementations.
  parse_contract_expr(src, tk, ts, te, n, pi, err, d)
  var gs: int = -1
  var sm: int = 0
  if ck == 4:
    skip_newlines(tk, n, pi, err)
    while cur_kind(tk, n, pi, err) == 4:
      var given: int = 0
      if tok_is(src, ts, te, pi[0], "given") == 1:
        given = 1
      if given == 0:
        if tok_is(src, ts, te, pi[0], "samples") == 0:
          break
      pi[0] = pi[0] + 1
      if given == 1:
        if cur_kind(tk, n, pi, err) != 4:
          err[0] = 1
          return 1
        gs = pi[0]
        pi[0] = pi[0] + 1
      else:
        if cur_kind(tk, n, pi, err) != 5:
          err[0] = 1
          return 1
        sm = int_text_value(src, ts, te, pi[0])
        pi[0] = pi[0] + 1
      skip_newlines(tk, n, pi, err)
  if d == 1:
    if gs >= 0:
      a_line_i_text_i(d, 7, ck, src, peek_tk(ts, gs + 0), peek_tk(te, gs + 0), sm)
    else:
      a_line_i_text_i(d, 7, ck, src, 0, 0, sm)
  skip_newlines(tk, n, pi, err)
  return 1

def parse_block(src: var ptr, tk: var array[65536, int], ts: var array[65536, int], te: var array[65536, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], d: int) -> int
  requires true
  ensures result == 1
  decreases 0
=
  skip_newlines(tk, n, pi, err)
  if expect_k(tk, n, pi, err, 2) == 0:
    return 1
  if d == 1:
    a_line(d, 51)
  skip_newlines(tk, n, pi, err)
  while 1 == 1:
    if cur_kind(tk, n, pi, err) == 3:
      break
    if cur_kind(tk, n, pi, err) == 0:
      break
    var before: int = pi[0]
    parse_stmt(src, tk, ts, te, n, pi, err, d)
    if pi[0] == before:
      err[0] = 1
      break
    skip_newlines(tk, n, pi, err)
  if d == 1:
    a_line(d, 52)
  expect_k(tk, n, pi, err, 3)
  return 1

def parse_decorator_value(src: var ptr, tk: var array[65536, int], ts: var array[65536, int], te: var array[65536, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], d: int) -> int
  requires true
