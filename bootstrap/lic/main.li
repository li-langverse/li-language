  mir_fdef(f26)
  f26[0] = el
  f26[2] = 2
  f26[26] = 1
  f26[27] = en
  mir_ins_line(src,  f26,  26,  0,  -1,  lastop)
  var f26b: array[44, int]
  mir_fdef(f26b)
  f26b[0] = peek_tk(ts, iter_t + 0)
  f26b[1] = peek_tk(te, iter_t + 0)
  f26b[2] = 1
  f26b[26] = 1
  f26b[27] = st
  mir_ins_line(src,  f26b,  26,  0,  -1,  lastop)
  mir_emit_jump_label(src,  lastop,  43,  5,  hd)
  var df: int = tc[0]
  tc[0] = df + 1
  var fd: array[44, int]
  mir_fdef(fd)
  fd[0] = df
  fd[2] = 2
  fd[9] = el
  fd[10] = 0
  fd[11] = 2
  fd[12] = peek_tk(ts, iter_t + 0)
  fd[13] = peek_tk(te, iter_t + 0)
  fd[14] = 1
  fd[18] = 1
  mir_ins_line(src,  fd,  30,  0,  -1,  lastop)
  var fb: array[44, int]
  mir_fdef(fb)
  fb[0] = df
  fb[1] = 0
  fb[2] = 2
  fb[15] = ex
  fb[16] = 6
  fb[17] = 2
  mir_ins_line(src,  fb,  45,  0,  -1,  lastop)
  if peek32768(ftmp, 4095) == 1:
    var fsimd: array[44, int]
    mir_fdef(fsimd)
    mir_ins_line(src,  fsimd,  49,  1,  -1,  lastop)
  if mir_stmts(darena,  dasp,  src,  tk,  ts,  te,  n,  pi,  err,  tc,  lastop, ftok,  nft,  ftmp,  itok,  nit,  itmp,  fatok,  nfa, matok,  nmat, ptok,  pex,  pp0,  ppn,  pret,  pn,  ptok2,  pty,  pelems,  pef, pei,  pvar,  retf_proc,  reti64_proc,  lhead,  lexit,  nlp) == 1:
    return 1
