                  li_rt_ast_space()
                  li_rt_ast_space()
                  li_rt_ast_space()
                  li_rt_ast_space()
                  li_rt_ast_space()
                  li_rt_ast_int(0)
                  li_rt_ast_space()
                  li_rt_ast_int(0)
                  li_rt_ast_space()
                  li_rt_ast_int(0)
                  li_rt_ast_space()
                  li_rt_ast_int(1)
