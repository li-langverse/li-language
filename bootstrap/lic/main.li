  pl_n[0] = 0
  if cur_kind(tk, n, pi, err) != 4:
    return 1
  pi[0] = pi[0] + 1
  fx_skip_typeparams(tk, n, pi, err)
  expect_k(tk, n, pi, err, 49)
  skip_param_layout(tk, n, pi, err)
  if cur_kind(tk, n, pi, err) != 50:
    var done: int = 0
    while done == 0:
      skip_param_layout(tk, n, pi, err)
      if cur_kind(tk, n, pi, err) == 4:
        var pn: int = pi[0]
        pi[0] = pi[0] + 1
        expect_k(tk, n, pi, err, 56)
        var pt: int = ec_capture_type_tok(src, tk, ts, te, n, pi, err)
        pl_add_local(pl_name, pl_ty, pl_n, pn, pt)
      skip_param_layout(tk, n, pi, err)
      if accept_k(tk, n, pi, err, 55) == 1:
        done = 0
      else:
        done = 1
  skip_param_layout(tk, n, pi, err)
  expect_k(tk, n, pi, err, 50)
  tc_skip_raises(tk, n, pi, err)
  if accept_k(tk, n, pi, err, 57) == 1:
    parse_type(src, tk, ts, te, n, pi, err, 0)
  tc_skip_raises(tk, n, pi, err)
  while 1 == 1:
    var ck: int = cur_kind(tk, n, pi, err)
    if ck == 41 or ck == 42 or ck == 43 or ck == 44 or ck == 45:
      parse_contract(src, tk, ts, te, n, pi, err, 0)
      continue
    break
  skip_newlines(tk, n, pi, err)
  if accept_k(tk, n, pi, err, 58) == 1:
    skip_newlines(tk, n, pi, err)
    if cur_kind(tk, n, pi, err) == 2:
      pl_check_block(src, tk, ts, te, n, pi, err, ob_name, ob_cnt, tr_name, tr_cnt, fd_name, fd_priv, fd_owner, fd_cnt, tm_name, tm_owner, tm_cnt, ep_name, ep_bnd, ep_cnt, im_ob, im_fd_name, im_fd_priv, im_fd_owner, im_ob_cnt, im_fd_cnt, pl_name, pl_ty, pl_n)
  return 1

def ec_skip_body(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int]) -> int
  requires true
  ensures result == 1
  decreases 0
=
  skip_newlines(tk, n, pi, err)
  if accept_k(tk, n, pi, err, 58) == 1:
    skip_newlines(tk, n, pi, err)
    parse_block(src, tk, ts, te, n, pi, err, 0)
  return 1

def encap_check(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int]) raises IO -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  var ob_name: array[256, int]
  var ob_base: array[256, int]
  var ob_cnt: array[1, int]
  var tr_name: array[64, int]
  var tr_cnt: array[1, int]
  var fd_name: array[8192, int]
  var fd_priv: array[8192, int]
  var fd_type: array[8192, int]
  var fd_buf: array[8192, ptr]
  var fd_b0: array[8192, int]
  var fd_b1: array[8192, int]
  var fd_owner: array[256, int]
  var fd_cnt: array[1, int]
  var tm_name: array[256, int]
  var tm_owner: array[256, int]
  var tm_cnt: array[1, int]
  var ep_name: array[256, int]
  var ep_priv: array[256, int]
  var ep_self: array[256, int]
  var ep_ret: array[256, int]
  var ep_bnd: array[256, int]
  var ep_ovr: array[256, int]
  var ep_cnt: array[1, int]
  var im_ob: array[64, ptr]
  var im_fd_name: array[256, ptr]
  var im_fd_priv: array[8192, int]
  var im_fd_owner: array[256, int]
  var im_ob_cnt: array[1, int]
  var im_fd_cnt: array[1, int]
  ob_cnt[0] = 0
  tr_cnt[0] = 0
  fd_cnt[0] = 0
  tm_cnt[0] = 0
  ep_cnt[0] = 0
  im_ob_cnt[0] = 0
  im_fd_cnt[0] = 0
  # Import merge: resolve each `import X` to a sibling X.li and collect its
  # object/field tables as text, so field-privacy checks see imported types.
  # The imported file is lexed into the shared arrays, collected, then the
  # main file is re-lexed back (the token stream is deterministic).
  # Import-cycle detection mirrors the C++ resolve_module_imports loading
  # set: when a resolved import's own imports resolve back to the current
  # file (or to an import already being merged), the module graph is cyclic
  # and both files reject (li-tests/modules/import_cycle_a/b).
  pi[0] = 0
  skip_newlines(tk, n, pi, err)
  while cur_kind(tk, n, pi, err) != 0:
    if cur_kind(tk, n, pi, err) == 18:
      pi[0] = pi[0] + 1
      if cur_kind(tk, n, pi, err) == 4:
        var mod_tok: int = pi[0]
        pi[0] = pi[0] + 1
        var imp: ptr = li_rt_resolve_import(li_rt_argv(2), ec_tok_text(src, ts, te, mod_tok))
        if imp != 0:
          var imp_path: ptr = li_rt_resolve_import_last_path()
          var cyc: int = 0
          n[0] = 0
          var r1: int = lex_source(imp, tk, ts, te, n, 0)
          var pi2: array[1, int]
          pi2[0] = 0
          skip_newlines(tk, n, pi2, err)
          while cur_kind(tk, n, pi2, err) != 0:
            if cur_kind(tk, n, pi2, err) == 18:
              pi2[0] = pi2[0] + 1
              if cur_kind(tk, n, pi2, err) == 4:
                var nm2: int = pi2[0]
                pi2[0] = pi2[0] + 1
                var imp2: ptr = li_rt_resolve_import(imp_path, ec_tok_text(imp, ts, te, nm2))
                if imp2 != 0:
                  if li_rt_str_eq(li_rt_resolve_import_last_path(), li_rt_argv(2)) == 1:
                    cyc = 1
                skip_newlines(tk, n, pi2, err)
                continue
            pi2[0] = pi2[0] + 1
          ec_collect_import_objects(imp, tk, ts, te, n, pi2, err, im_ob, im_fd_name, im_fd_priv, im_fd_owner, im_ob_cnt, im_fd_cnt)
          n[0] = 0
          var r2: int = lex_source(src, tk, ts, te, n, 0)
          if cyc == 1:
            err[0] = 1
            li_rt_emit_err(900)
      skip_newlines(tk, n, pi, err)
      continue
    pi[0] = pi[0] + 1
  pi[0] = 0
  skip_newlines(tk, n, pi, err)
  while cur_kind(tk, n, pi, err) != 0:
    var k: int = cur_kind(tk, n, pi, err)
    if k == 18:
      parse_import(src, tk, ts, te, n, pi, err, 0)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 11:
      pi[0] = pi[0] + 1
      if cur_kind(tk, n, pi, err) != 4:
        err[0] = 1
        return 1
      var an: int = pi[0]
      pi[0] = pi[0] + 1
      fx_skip_typeparams(tk, n, pi, err)
      expect_k(tk, n, pi, err, 58)
      skip_newlines(tk, n, pi, err)
      if cur_kind(tk, n, pi, err) == 15:
        pi[0] = pi[0] + 1
        skip_newlines(tk, n, pi, err)
        var bt: int = -1
        if cur_kind(tk, n, pi, err) == 4:
          if tok_is(src, ts, te, pi[0], "of") == 1:
            pi[0] = pi[0] + 1
            if cur_kind(tk, n, pi, err) == 4:
              bt = pi[0]
              pi[0] = pi[0] + 1
            skip_newlines(tk, n, pi, err)
        var oi: int = ob_cnt[0]
        if oi < 64:
          ob_name[oi] = an
          ob_base[oi] = bt
          ob_cnt[0] = ob_cnt[0] + 1
        ec_parse_fields(src, tk, ts, te, n, pi, err, oi, fd_name, fd_priv, fd_type, fd_owner, fd_cnt)
      else:
        if cur_kind(tk, n, pi, err) == 4:
          if tok_is(src, ts, te, pi[0], "trait") == 1:
            pi[0] = pi[0] + 1
            var ti: int = tr_cnt[0]
            if ti < 64:
              tr_name[ti] = an
              tr_cnt[0] = tr_cnt[0] + 1
            ec_parse_trait_methods(src, tk, ts, te, n, pi, err, ti, tm_name, tm_owner, tm_cnt)
          else:
            tc_skip_alias_rhs(src, tk, ts, te, n, pi, err, fd_name, fd_priv, fd_type, fd_buf, fd_b0, fd_b1, fd_cnt)
        else:
          tc_skip_alias_rhs(src, tk, ts, te, n, pi, err, fd_name, fd_priv, fd_type, fd_buf, fd_b0, fd_b1, fd_cnt)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 76:
      var pend: array[1, int]
      pend[0] = 0
      var ovr: int = 0
      if peek_off(tk, n, pi, 1) == 4:
        if tok_is(src, ts, te, pi[0] + 1, "override") == 1:
          ovr = 1
      parse_decorator_list(src, tk, ts, te, n, pi, err, 0)
      if cur_kind(tk, n, pi, err) == 16 or cur_kind(tk, n, pi, err) == 17:
        pi[0] = pi[0] + 1
      if cur_kind(tk, n, pi, err) == 10 or cur_kind(tk, n, pi, err) == 9:
        pi[0] = pi[0] + 1
        ec_record_proc(src, tk, ts, te, n, pi, err, 0, ovr, ep_name, ep_priv, ep_self, ep_ret, ep_bnd, ep_ovr, ep_cnt)
        ec_skip_body(src, tk, ts, te, n, pi, err)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 16 or k == 17:
      var pv: int = 0
      if k == 16:
        pv = 1
      pi[0] = pi[0] + 1
      if cur_kind(tk, n, pi, err) == 10:
        pi[0] = pi[0] + 1
        ec_record_proc(src, tk, ts, te, n, pi, err, pv, 0, ep_name, ep_priv, ep_self, ep_ret, ep_bnd, ep_ovr, ep_cnt)
        ec_skip_body(src, tk, ts, te, n, pi, err)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 10:
      pi[0] = pi[0] + 1
      ec_record_proc(src, tk, ts, te, n, pi, err, 0, 0, ep_name, ep_priv, ep_self, ep_ret, ep_bnd, ep_ovr, ep_cnt)
      ec_skip_body(src, tk, ts, te, n, pi, err)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 32:
      pi[0] = pi[0] + 1
      if cur_kind(tk, n, pi, err) == 10:
        pi[0] = pi[0] + 1
        ec_record_proc(src, tk, ts, te, n, pi, err, 0, 0, ep_name, ep_priv, ep_self, ep_ret, ep_bnd, ep_ovr, ep_cnt)
      else:
        if cur_kind(tk, n, pi, err) == 9:
          err[0] = 1
          li_rt_emit_err(900)
          pi[0] = pi[0] + 1
          skip_newlines(tk, n, pi, err)
          while cur_kind(tk, n, pi, err) != 0:
            if cur_kind(tk, n, pi, err) == 11 or cur_kind(tk, n, pi, err) == 10 or cur_kind(tk, n, pi, err) == 16 or cur_kind(tk, n, pi, err) == 17 or cur_kind(tk, n, pi, err) == 18 or cur_kind(tk, n, pi, err) == 32 or cur_kind(tk, n, pi, err) == 33 or cur_kind(tk, n, pi, err) == 76 or cur_kind(tk, n, pi, err) == 9 or cur_kind(tk, n, pi, err) == 13 or cur_kind(tk, n, pi, err) == 12 or cur_kind(tk, n, pi, err) == 14:
              break
            pi[0] = pi[0] + 1
          continue
        else:
          err[0] = 1
          return 1
      skip_newlines(tk, n, pi, err)
      continue
    if k == 33:
      pi[0] = pi[0] + 1
      if cur_kind(tk, n, pi, err) == 10:
        pi[0] = pi[0] + 1
        ec_record_proc(src, tk, ts, te, n, pi, err, 0, 0, ep_name, ep_priv, ep_self, ep_ret, ep_bnd, ep_ovr, ep_cnt)
        ec_skip_body(src, tk, ts, te, n, pi, err)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 9:
      err[0] = 1
      li_rt_emit_err(900)
      li_rt_emit_err(900)
      pi[0] = pi[0] + 1
      skip_newlines(tk, n, pi, err)
      while cur_kind(tk, n, pi, err) != 0:
        if cur_kind(tk, n, pi, err) == 11 or cur_kind(tk, n, pi, err) == 10 or cur_kind(tk, n, pi, err) == 16 or cur_kind(tk, n, pi, err) == 17 or cur_kind(tk, n, pi, err) == 18 or cur_kind(tk, n, pi, err) == 32 or cur_kind(tk, n, pi, err) == 33 or cur_kind(tk, n, pi, err) == 76 or cur_kind(tk, n, pi, err) == 9 or cur_kind(tk, n, pi, err) == 13 or cur_kind(tk, n, pi, err) == 12 or cur_kind(tk, n, pi, err) == 14:
          break
        pi[0] = pi[0] + 1
      continue
    if k == 13 or k == 12 or k == 14:
      pi[0] = pi[0] + 1
      parse_theorem(src, tk, ts, te, n, pi, err, 0, 0, 0)
      skip_newlines(tk, n, pi, err)
      continue
    err[0] = 1
    return 1
  # Post-pass: inheritance layout + override + W0401. The redeclared-field
  # slot is a walk-only register now: the C++ typechecker accepts `object of
  # Base` fields redeclared with any type (the last declaration wins for
  # layout), so a differing width is NOT a parity reject.
  var o: int = 0
  while o < ob_cnt[0]:
    if ob_base[o] >= 0:
      var bo: int = 0
      bo = ec_find_obj(src, ts, te, ob_name, ob_cnt, ob_base[o])
    o = o + 1
  o = 0
  while o < ep_cnt[0]:
    if ep_ovr[o] == 1:
      var us: int = ec_underscore(src, ts, te, ep_name[o])
      if us <= 0:
        err[0] = 1
        li_rt_emit_err(900)
      else:
        var aidx: int = -1
        var q: int = 0
        while q < ob_cnt[0]:
          if ec_has_prefix_join(src, ts, te, ob_name[q], ep_name[o]) == 1:
            aidx = q
          q = q + 1
        if aidx < 0:
          err[0] = 1
          li_rt_emit_err(900)
        else:
          if peek256(ob_base, aidx) < 0:
            err[0] = 1
            li_rt_emit_err(900)
          else:
            var gidx: int = -1
            q = 0
            while q < ep_cnt[0]:
              if q != o:
                if ec_same_suffix(src, ts, te, peek256(ob_name, aidx), peek256(ob_base, aidx), ep_name[o], ep_name[q]) == 1:
                  gidx = q
              q = q + 1
            if gidx < 0:
              err[0] = 1
              li_rt_emit_err(900)
            else:
              if ep_self[o] != -1:
                if peek256(ep_self, gidx) == -1:
                  err[0] = 1
                  li_rt_emit_err(900)
                else:
                  if tok_eq(src, ts, te, ep_self[o], peek256(ep_self, gidx)) == 0:
                    err[0] = 1
                    li_rt_emit_err(900)
              else:
                if peek256(ep_self, gidx) != -1:
                  err[0] = 1
                  li_rt_emit_err(900)
              if ep_ret[o] != -1:
                if peek256(ep_ret, gidx) == -1:
                  err[0] = 1
                  li_rt_emit_err(900)
                else:
                  if tok_eq(src, ts, te, ep_ret[o], peek256(ep_ret, gidx)) == 0:
                    err[0] = 1
                    li_rt_emit_err(900)
              else:
                if peek256(ep_ret, gidx) != -1:
                  err[0] = 1
                  li_rt_emit_err(900)
    o = o + 1
  # W0401: unused imports.
  pi[0] = 0
  skip_newlines(tk, n, pi, err)
  while cur_kind(tk, n, pi, err) != 0:
    if cur_kind(tk, n, pi, err) == 18:
      pi[0] = pi[0] + 1
      var bt2: int = -1
      if cur_kind(tk, n, pi, err) == 4:
        bt2 = pi[0]
        pi[0] = pi[0] + 1
        while accept_k(tk, n, pi, err, 72) == 1:
          if cur_kind(tk, n, pi, err) == 4:
            bt2 = pi[0]
            pi[0] = pi[0] + 1
        if cur_kind(tk, n, pi, err) == 4:
          if tok_is(src, ts, te, pi[0], "as") == 1:
            pi[0] = pi[0] + 1
            if cur_kind(tk, n, pi, err) == 4:
              bt2 = pi[0]
              pi[0] = pi[0] + 1
      if bt2 >= 0:
        if ec_ident_used(src, tk, ts, te, n, bt2) == 0:
          li_rt_emit_err(401)
      skip_newlines(tk, n, pi, err)
      continue
    pi[0] = pi[0] + 1
  # Policy scan: field privacy, method existence, trait bounds (needs the
  # complete object/field/proc/trait tables, so it runs after the collection
  # passes above).
  pi[0] = 0
  skip_newlines(tk, n, pi, err)
  while cur_kind(tk, n, pi, err) != 0:
    var k: int = cur_kind(tk, n, pi, err)
    if k == 18:
      parse_import(src, tk, ts, te, n, pi, err, 0)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 11:
      pi[0] = pi[0] + 1
      if cur_kind(tk, n, pi, err) != 4:
        err[0] = 1
        return 1
      pi[0] = pi[0] + 1
      fx_skip_typeparams(tk, n, pi, err)
      expect_k(tk, n, pi, err, 58)
      tc_skip_alias_rhs(src, tk, ts, te, n, pi, err, fd_name, fd_priv, fd_type, fd_buf, fd_b0, fd_b1, fd_cnt)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 76:
      parse_decorator_list(src, tk, ts, te, n, pi, err, 0)
      if cur_kind(tk, n, pi, err) == 16 or cur_kind(tk, n, pi, err) == 17:
        pi[0] = pi[0] + 1
      if cur_kind(tk, n, pi, err) == 10 or cur_kind(tk, n, pi, err) == 9:
        pi[0] = pi[0] + 1
        pl_scan_proc(src, tk, ts, te, n, pi, err, ob_name, ob_cnt, tr_name, tr_cnt, fd_name, fd_priv, fd_owner, fd_cnt, tm_name, tm_owner, tm_cnt, im_ob, im_fd_name, im_fd_priv, im_fd_owner, im_ob_cnt, im_fd_cnt, ep_name, ep_bnd, ep_cnt)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 16 or k == 17:
      pi[0] = pi[0] + 1
      if cur_kind(tk, n, pi, err) == 10:
        pi[0] = pi[0] + 1
        pl_scan_proc(src, tk, ts, te, n, pi, err, ob_name, ob_cnt, tr_name, tr_cnt, fd_name, fd_priv, fd_owner, fd_cnt, tm_name, tm_owner, tm_cnt, im_ob, im_fd_name, im_fd_priv, im_fd_owner, im_ob_cnt, im_fd_cnt, ep_name, ep_bnd, ep_cnt)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 10 or k == 33:
      pi[0] = pi[0] + 1
      if k == 33:
        if cur_kind(tk, n, pi, err) == 10:
          pi[0] = pi[0] + 1
      pl_scan_proc(src, tk, ts, te, n, pi, err, ob_name, ob_cnt, tr_name, tr_cnt, fd_name, fd_priv, fd_owner, fd_cnt, tm_name, tm_owner, tm_cnt, im_ob, im_fd_name, im_fd_priv, im_fd_owner, im_ob_cnt, im_fd_cnt, ep_name, ep_bnd, ep_cnt)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 32:
      pi[0] = pi[0] + 1
      if cur_kind(tk, n, pi, err) == 10:
        pi[0] = pi[0] + 1
        pl_scan_proc(src, tk, ts, te, n, pi, err, ob_name, ob_cnt, tr_name, tr_cnt, fd_name, fd_priv, fd_owner, fd_cnt, tm_name, tm_owner, tm_cnt, im_ob, im_fd_name, im_fd_priv, im_fd_owner, im_ob_cnt, im_fd_cnt, ep_name, ep_bnd, ep_cnt)
      skip_newlines(tk, n, pi, err)
      continue
    if k == 13 or k == 12 or k == 14:
      pi[0] = pi[0] + 1
      parse_theorem(src, tk, ts, te, n, pi, err, 0, 0, 0)
      skip_newlines(tk, n, pi, err)
      continue
    pi[0] = pi[0] + 1
  return 0

# ---------------------------------------------------------------- driver --

def parse_file(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], d: int, emit_tok: int) raises IO -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  var r: int = lex_source(src, tk, ts, te, n, emit_tok)
  if r == 1:
    return 1
  parse_module(src, tk, ts, te, n, pi, err, d)
  if err[0] == 1:
    return 1
  return 0

# ================= Layer 5: MIR lowering (`mir <file>`) =====================
# Byte-exact port of compiler/mir/lower.cpp for the scalar slice, gated by
# scripts/check_li_mir_parity.sh against the C++ `lic mir` dump. The walk
# mirrors parse_module/parse_proc/parse_stmt/parse_expr but emits INS/ARG/PARAM
# lines. The module-global temp counter (tc) is shared across all functions
# like lower_to_mir's temp_counter; labels consume the same counter.
# Float literals are parsed into the runtime table (ids), never held as Li
# doubles. Names are represented as (s, e, code) triples: code 0 empty, code 1
# source slice, code 2 counter-name (prefix code in e: 0=__t 1=else_ 2=merge_
# 3=while_head_ 4=while_exit_ 5=for_head_ 6=for_exit_).
#
# Descriptor arena (6 ints per record):
#   0=int-lit [v, s, e] | 1=float-lit [fid, s, e] | 2=str-lit [cs, ce, -]
#   3=ident [s, e, -] | 4=call [cs, ce, args_start, argc]
#   5=index [base, index] | 6=unary-not [operand]
#   7=binop [opk, lhs, rhs] | 8=name [is_tmp, v1, v2] (src: v1=s v2=e; tmp: v1=c)

# ---- text / name helpers ----
def mir_slice_eq(src: var ptr,  s1: int,  e1: int,  s2: int,  e2: int) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  if e1 - s1 != e2 - s2:
    return 0
  var k: int = 0
  while k < e1 - s1:
    if li_rt_str_char_at(src,  s1 + k) != li_rt_str_char_at(src,  s2 + k):
      return 0
    k = k + 1
  return 1

# Is the name [s,e) one of the float source names (token indices in ftok)?
def mir_name_float(src: var ptr,  ts: var array[262144, int],  te: var array[262144, int], s: int,  e: int,  ftok: var array[4096, int],  nft: var array[1, int]) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  var k: int = 0
  while k < nft[0]:
    if mir_slice_eq(src,  s,  e,  peek_tk(ts, peek4096(ftok, k + 0) + 0),  peek_tk(te, peek4096(ftok, k + 0) + 0)) == 1:
      return 1
    k = k + 1
  return 0

# Is the name [s,e) one of the i64 source names (token indices in itok)?
def mir_name_farray(src: var ptr,  ts: var array[262144, int],  te: var array[262144, int], s: int,  e: int,  fatok: var array[512, int],  nfa: var array[1, int]) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  var k: int = 0
  while k < nfa[0]:
    if mir_slice_eq(src,  s,  e,  peek_tk(ts, peek512(fatok, 2 * k + 0) + 0),  peek_tk(te, peek512(fatok, 2 * k + 0) + 0)) == 1:
      return 1
    k = k + 1
  return 0

# Local matrix names use a side table in fatok[62], separate from the
# float-array and int-array tables. This lets nested matrix loads participate
# in float classification without pretending the matrix is a 1D array.
def mir_name_matrix_local(src: var ptr, ts: var array[262144, int], te: var array[262144, int], s: int, e: int, fatok: var array[512, int]) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  var nm: int = peek512(fatok, 62)
  var k: int = 0
  while k < nm:
    if mir_slice_eq(src, s, e, peek_tk(ts, peek512(fatok, 64 + k * 2) + 0), peek_tk(te, peek512(fatok, 64 + k * 2) + 0)) == 1:
      return 1
    k = k + 1
  return 0

# Size of the 1D float array named [s,e) (from the proc/param tables), else 0.
# Mirrors the C++ `float_array_sizes` map seeded by seed_float_array_params.
def mir_farray_size(src: var ptr,  ts: var array[262144, int],  te: var array[262144, int], s: int,  e: int,  ptok2: var array[512, int],  pelems: var array[512, int],  pef: var array[512, int],  pp0: var array[128, int],  ppn: var array[128, int],  pn: var array[1, int],  fatok: var array[512, int],  nfa: var array[1, int]) -> int
  requires true
  ensures result >= 0
  decreases 0
=
  # Float-array size lookup is scoped to the CURRENT proc only: the emit pass
  # registers the current proc's float-array params + locals in fatok before
  # lowering bodies (2-slot encoding: [name, size] per entry). Scanning all
  # procs' params would leak e.g. `r: var array[8,float]` from another proc
  # into a scalar `r` here, wrongly firing the array-scale path.
  var k: int = 0
  while k < nfa[0]:
    if mir_slice_eq(src,  s,  e,  peek_tk(ts, peek512(fatok, 2 * k + 0) + 0),  peek_tk(te, peek512(fatok, 2 * k + 0) + 0)) == 1:
      return peek512(fatok, 2 * k + 1)
    k = k + 1
  return 0

# Read the float-array size stored in ftmp for a temp node (kind 1 or 8).
# Returns the element count if the temp is a registered float array, else 0.
def mir_farray_tmp_size(darena: var array[65536, int], rec: int, ftmp: var array[32768, int]) -> int
  requires true
  ensures result >= 0
  decreases 0
=
  var k: int = peek65536(darena, rec + 0)
  if k == 1:
    var v: int = peek32768(ftmp, peek65536(darena, rec + 2))
    if v > 1:
      return v
    return 0
  if k == 8:
    if peek65536(darena, rec + 1) == 1:
      var v2: int = peek32768(ftmp, peek65536(darena, rec + 2))
      if v2 > 1:
        return v2
    return 0
  return 0

# Look up the element count for a local int array.
# Int array entries are stored in fatok after float entries:
#   fatok[0..2*nfa-1] = float arrays, fatok[2*nfa..2*nfa+2*nia-1] = int arrays
# nia (int array count) is stored at fatok[63].
def mir_iarray_size(src: var ptr,  ts: var array[262144, int],  te: var array[262144, int], s: int,  e: int,  fatok: var array[512, int],  nfa: var array[1, int]) -> int
  requires true
  ensures result >= 0
  decreases 0
=
  var nia_v: int = peek512(fatok, 63)
  var base: int = 2 * nfa[0]
  var k: int = 0
  while k < nia_v:
    if mir_slice_eq(src,  s,  e,  peek_tk(ts, peek512(fatok, base + 2 * k) + 0),  peek_tk(te, peek512(fatok, base + 2 * k) + 0)) == 1:
      return peek512(fatok, base + 2 * k + 1)
    k = k + 1
  return 0

# Is the name [s,e) one of the local matrix names (token indices in matok)?
# matok stores triples: (name_token, rows, cols) for each matrix.
# The C++ matrix_names set holds only local (var-declared) matrices; matrix
# params are not seeded, so 2D loads/stores on params fall through to no-emit.
def mir_name_matrix(src: var ptr,  ts: var array[262144, int],  te: var array[262144, int], s: int,  e: int,  matok: var array[512, int],  nmat: var array[1, int]) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  var k: int = 0
  while k < nmat[0]:
    if mir_slice_eq(src,  s,  e,  peek_tk(ts, peek512(matok, k * 3) + 0),  peek_tk(te, peek512(matok, k * 3) + 0)) == 1:
      return 1
    k = k + 1
  return 0

# Look up matrix dims for name [s,e). Returns rows via ret[0], cols via ret[1].
# Returns 1 if found, 0 if not.
def mir_mat_dims(src: var ptr,  ts: var array[262144, int],  te: var array[262144, int], s: int,  e: int,  matok: var array[512, int],  nmat: var array[1, int], ret: var array[2, int]) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  var k: int = 0
  while k < nmat[0]:
    if mir_slice_eq(src,  s,  e,  peek_tk(ts, peek512(matok, k * 3) + 0),  peek_tk(te, peek512(matok, k * 3) + 0)) == 1:
      ret[0] = peek512(matok, k * 3 + 1)
      ret[1] = peek512(matok, k * 3 + 2)
      return 1
    k = k + 1
  return 0

# Resolve matrix dimensions for an expression descriptor. Source identifiers
# use the normal token-keyed matrix table; a kind-8 temporary uses a negative
# key (-1-temp_id), allowing chained `(A @ B) @ D` lowering.
def mir_mat_operand_dims(darena: var array[65536, int], rec: int, src: var ptr, ts: var array[262144, int], te: var array[262144, int], matok: var array[512, int], nmat: var array[1, int], ret: var array[2, int]) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  if peek65536(darena, rec + 0) == 3:
    return mir_mat_dims(src, ts, te, peek65536(darena, rec + 1), peek65536(darena, rec + 2), matok, nmat, ret)
  if peek65536(darena, rec + 0) == 8:
    if peek65536(darena, rec + 1) == 1:
      var tid: int = peek65536(darena, rec + 2)
      var k: int = 0
      while k < nmat[0]:
        if peek512(matok, k * 3 + 0) == 0 - tid - 1:
          ret[0] = peek512(matok, k * 3 + 1)
          ret[1] = peek512(matok, k * 3 + 2)
          return 1
        k = k + 1
  return 0

def mir_name_i64(src: var ptr,  ts: var array[262144, int],  te: var array[262144, int], s: int,  e: int,  itok: var array[4096, int],  nit: var array[1, int]) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  var k: int = 0
  while k < nit[0]:
    if mir_slice_eq(src,  s,  e,  peek_tk(ts, peek4096(itok, k + 0) + 0),  peek_tk(te, peek4096(itok, k + 0) + 0)) == 1:
      return 1
    k = k + 1
  return 0

# ---- descriptor arena ----
def d_alloc(darena: var array[65536, int],  dasp: var array[1, int],  kind: int, v1: int,  v2: int,  v3: int) -> int
  requires true
  ensures result >= 0
  decreases 0
=
  var rec: int = dasp[0]
  set65536(darena, rec + 0,kind)
  set65536(darena, rec + 1,v1)
  set65536(darena, rec + 2,v2)
  set65536(darena, rec + 3,v3)
  set65536(darena, rec + 4,-1)
  set65536(darena, rec + 5,-1)
  dasp[0] = rec + 6
  return rec

# ---- Object type registry (heap-backed cell store) ----
# Cells live in the runtime heap cell store (li_rt_reg_get/set), NOT in the
# 4096-cell itmp stack array: the old fixed layout packed every region inside
# itmp and its hard-coded bases overlapped once a closure declared ~50 fields
# (the field-name cells overran the nobjvar counter, and the field type-hash
# cells overran the type hash registry), silently corrupting a neighbouring
# region instead of failing. Region bases are now
# derived from the previous region's capacity, and the store grows on demand,
# so capacity no longer depends on the array size.
#
# Caps are set far above the largest real import closure measured over the
# whole corpus (474 files: at most 9 object types, 41 fields, 39 object vars):
#   cap_var   = 512   (measured max 39)
#   cap_type  = 512   (measured max 9)
#   cap_field = 4096  (measured max 41)
#
# Cell map (each base = previous base + previous capacity * stride):
#   n_type  = 0                         number of registered object types
#   n_field = 1                         number of registered fields
#   n_var   = 2                         number of registered object vars
#   var_b   + k*3 + {0,1,2}             var name start, end, type index
#   type_b  + i*6 + {0..5}              type name start/end, field count,
#                                       fields base, base type start/end
#   fname_b + j*2 + {0,1}               field name start, end
#   ffloat_b+ j                         field float bit
#   felems_b+ j                         fixed-array element count
#   ftype_b + j*2 + {0,1}               field declared type-name hash, length
#   thash_b + i                         type name hash
#   tlen_b  + i                         type name length
#   fhash_b + j                         field name hash
def lr_var_cap() -> int
  requires true
  ensures result >= 0
  decreases 0
=
  return 512

def lr_type_cap() -> int
  requires true
  ensures result >= 0
  decreases 0
=
  return 512

def lr_field_cap() -> int
  requires true
  ensures result >= 0
  decreases 0
=
  return 4096

# Cells below lr_reg_base() are reserved for the temp/aggregate flag map, which
# mir_mk_name/li_rt_reg_get index by the module temp counter (mir_rec_name_i64
# reads it). The old layout put the flag map at itmp[0..tc] and the registry
# above it at 2800, so the registry must stay clear of the flag map here too;
# measured worst case over the whole corpus is tc[0] = 2136.
def lr_reg_base() -> int
  requires true
  ensures result >= 0
  decreases 0
=
  return 8192

def lr_n_type() -> int
  requires true
  ensures result >= 0
  decreases 0
=
  return lr_reg_base() + 0

def lr_n_field() -> int
  requires true
  ensures result >= 0
  decreases 0
=
  return lr_reg_base() + 1

def lr_n_var() -> int
  requires true
  ensures result >= 0
  decreases 0
=
  return lr_reg_base() + 2

def lr_var_b() -> int
  requires true
  ensures result >= 0
  decreases 0
=
  return lr_reg_base() + 8

def lr_type_b() -> int
  requires true
  ensures result >= 0
  decreases 0
=
  return lr_var_b() + lr_var_cap() * 3

def lr_fname_b() -> int
  requires true
  ensures result >= 0
  decreases 0
=
  return lr_type_b() + lr_type_cap() * 6

def lr_ffloat_b() -> int
  requires true
  ensures result >= 0
  decreases 0
=
  return lr_fname_b() + lr_field_cap() * 2

def lr_felems_b() -> int
  requires true
  ensures result >= 0
  decreases 0
=
  return lr_ffloat_b() + lr_field_cap()

def lr_ftype_b() -> int
  requires true
  ensures result >= 0
  decreases 0
=
  return lr_felems_b() + lr_field_cap()

def lr_thash_b() -> int
  requires true
  ensures result >= 0
  decreases 0
=
  return lr_ftype_b() + lr_field_cap() * 2

def lr_tlen_b() -> int
  requires true
  ensures result >= 0
  decreases 0
=
  return lr_thash_b() + lr_type_cap()

def lr_fhash_b() -> int
  requires true
  ensures result >= 0
  decreases 0
=
  return lr_tlen_b() + lr_type_cap()

# Thin local wrapper over the registry store intrinsic. A bare extern call in
# statement position would force `raises IO` onto every registrar and its
# callers; routing the writes through this keeps the effect surface flat.
# Reads stay direct (li_rt_reg_get) because expression-position extern calls are
# already allowed; the few accessors whose whole body is a bare `return <call>`
# bind through a local first.
def mir_reg_set(idx: int,  val: int) -> int
  requires true
  ensures result == 0
  decreases 0
=
  var s: int = li_rt_reg_set(idx, val)
  return 0

# Record that temp `c` names an aggregate (object) result. The flag map is the
# low cell range; a temp counter that would run into the registry base marks the
# store unusable instead of silently overwriting the first registry cells.
def mir_reg_flag(c: int) -> int
  requires true
  ensures result == 0
  decreases 0
=
  if c < 0:
    var f0: int = li_rt_reg_fail()
  else:
    if c >= lr_reg_base():
      var f1: int = li_rt_reg_fail()
    else:
      var f2: int = li_rt_reg_set(c, 1)
  return 0

def mir_reg_fail() -> int
  requires true
  ensures result == 0
  decreases 0
=
  var s: int = li_rt_reg_fail()
  return 0

# Emit INS with a mangled name like __li_o_<base>_<field>
# format: INS op iv 0 <mangled_name>      0 0 0 1  0 <flags> ...
def mir_ins_mangled(src: var ptr, op: int, iv: int, base_s: int, base_e: int, fld_s: int, fld_e: int, flag1: int, flag2: int, val: int, lastop: var array[1, int], rhs_s: int, rhs_e: int, rhs_t: int, rhs_p_s: int, rhs_p_e: int, rhs_f_s: int, rhs_f_e: int, rhs_q_s: int, rhs_q_e: int, arr_flt: int) raises IO -> int
  requires true
  ensures result == 0
  decreases 0
=
  li_rt_mir_str("INS")
  li_rt_ast_space()
  li_rt_ast_int(op)
  li_rt_ast_space()
  li_rt_ast_int(iv)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_mir_str("__li_o_")
  li_rt_mir_esc(src, base_s, base_e)
  li_rt_mir_str("_")
  # Field name offsets for user-written field access/stores are relative to
  # this caller's src buffer, regardless of where the object type is declared,
  # so they always read from src. Type-declared positions go through the
  # objname/fieldpath registries instead, which resolve each segment against
  # the file that declares it.
  li_rt_mir_esc(src, fld_s, fld_e)
  # empty name cells: str_value, callee, lhs_ident (each needs its own
  # separator space, so 4 spaces land before rhs_ident like C++ mir_dump)
  li_rt_ast_space()
  li_rt_ast_space()
  li_rt_ast_space()
  li_rt_ast_space()
  # rhs_ident: plain source ident, scalar lowered temp, object call result,
  # or a nested object field path. The negative encoding -2-crid is private
  # to this emitter and prints the aggregate call-result slot used by C++ MIR.
  if rhs_q_s >= 0:
    # Two-intermediate chain source: __li_o_<base>_<m1>_<m2>_<fld>
    li_rt_mir_str("__li_o_")
    li_rt_mir_esc(src, rhs_s, rhs_e)
    li_rt_mir_str("_")
    li_rt_mir_esc(src, rhs_p_s, rhs_p_e)
    li_rt_mir_str("_")
    li_rt_mir_esc(src, rhs_q_s, rhs_q_e)
    li_rt_mir_str("_")
    li_rt_mir_esc(src, rhs_f_s, rhs_f_e)
  else:
    if rhs_p_s >= 0:
      li_rt_mir_str("__li_o_")
      li_rt_mir_esc(src, rhs_s, rhs_e)
      li_rt_mir_str("_")
      li_rt_mir_esc(src, rhs_p_s, rhs_p_e)
      li_rt_mir_str("_")
      li_rt_mir_esc(src, rhs_f_s, rhs_f_e)
    else:
      if rhs_t >= 0:
        li_rt_mir_label(0, rhs_t)
      else:
        if rhs_t <= -2:
          li_rt_mir_str("__li_o___cr")
          li_rt_ast_int(-2 - rhs_t)
        else:
          if rhs_s >= 0:
            if rhs_f_s >= 0:
              # Single-level field source: mangled leaf __li_o_<base>_<fld>
              li_rt_mir_str("__li_o_")
              li_rt_mir_esc(src, rhs_s, rhs_e)
              li_rt_mir_str("_")
              li_rt_mir_esc(src, rhs_f_s, rhs_f_e)
            else:
              li_rt_mir_esc(src, rhs_s, rhs_e)
  # label cell (empty)
  li_rt_ast_space()
  # f18..f21
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(1)
  # name cell 6 (empty)
  li_rt_ast_space()
  # f25..f36
  li_rt_ast_space()
  li_rt_ast_int(flag1)
  li_rt_ast_space()
  li_rt_ast_int(flag2)
  li_rt_ast_space()
  # int_value cell: only literal RHS carries a value here (C++ prints 0 for
  # ident/nested sources). Parsing the ident span would leak any digits in
  # the variable name (d5 -> 5).
  li_rt_ast_int(val)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  # array_is_float cell: C++ mir_dump puts the float-array bit here; the
  # walker previously printed it in the trailing simd_lanes cell.
  li_rt_ast_int(arr_flt)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_nl()
  lastop[0] = op
  return 0

# Emit INS with an object leaf name held in the objname registry. The entry
# carries the full accumulated field path (__li_o_<base>[_<parent>...]_<leaf>),
# so a 3-level chain keeps every segment, and each segment was rendered
# against the type that declares it when its prefix was registered. Same cell
# layout as mir_ins_mangled.
def mir_ins_mangled_oi(op: int, iv: int, oi: int, flag1: int, flag2: int, val: int, lastop: var array[1, int], arr_flt: int) raises IO -> int
  requires true
  ensures result == 0
  decreases 0
=
  li_rt_mir_str("INS")
  li_rt_ast_space()
  li_rt_ast_int(op)
  li_rt_ast_space()
  li_rt_ast_int(iv)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_mir_objname_out(oi)
  # empty name cells: str_value, callee, lhs_ident (4 spaces before rhs)
  li_rt_ast_space()
  li_rt_ast_space()
  li_rt_ast_space()
  li_rt_ast_space()
  # label cell (empty)
  li_rt_ast_space()
  # f18..f21
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(1)
  # name cell 6 (empty)
  li_rt_ast_space()
  # f25..f36
  li_rt_ast_space()
  li_rt_ast_int(flag1)
  li_rt_ast_space()
  li_rt_ast_int(flag2)
  li_rt_ast_space()
  li_rt_ast_int(val)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  # array_is_float cell (mirror mir_ins_mangled)
  li_rt_ast_int(arr_flt)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_nl()
  lastop[0] = op
  return 0

# Recursively emit LocalAlloc (INS 24/35/9) for every leaf field of an object
# type. Every leaf takes a registered compound prefix name, so nested object
# fields flatten to their full path and each path segment is read from the type
# that declares it. prefix_oi is the accumulated objname index (-1 at the top
# level, where base_s/base_e name the object var).
def mir_obj_alloc_fields(src: var ptr,  ts: var array[262144, int],  te: var array[262144, int], itmp: var array[4096, int],  base_s: int,  base_e: int,  type_idx: int,  prefix_oi: int, lastop: var array[1, int]) raises IO -> int
  requires true
  ensures result == 0
  decreases 0
=
  # Use the type definition's source for field name positions, not the caller's.
  var tsrc: ptr = li_rt_type_src_get(type_idx)
  if tsrc == 0:
    tsrc = src
  li_rt_type_src_store(-1, tsrc)
  var nf_a: int = mir_obj_field_count(itmp, type_idx)
  var i_a: int = 0
  var fa_a: array[2, int]
  while i_a < nf_a:
    mir_obj_field_name(itmp, type_idx, i_a, fa_a)
    var oi_a: int = 0
    if prefix_oi < 0:
      oi_a = li_rt_mir_objname_reg_prefix(src, base_s, base_e, fa_a[0], fa_a[1], 0, 0, tsrc)
    else:
      oi_a = li_rt_mir_objname_add_nested(prefix_oi, tsrc, fa_a[0], fa_a[1])
    var sub_a: int = mir_obj_field_obj_type(src, ts, te, itmp, type_idx, i_a)
    if sub_a >= 0:
      mir_obj_alloc_fields(src, ts, te, itmp, base_s, base_e, sub_a, oi_a, lastop)
    else:
      var elems_a: int = mir_obj_field_elems(itmp, type_idx, i_a)
      if elems_a > 0:
        mir_ins_mangled_oi(9, elems_a, oi_a, 0, 1, 0, lastop, mir_obj_field_float(itmp, type_idx, i_a))
      else:
        if mir_obj_field_float(itmp, type_idx, i_a) == 1:
          mir_ins_mangled_oi(35, 0, oi_a, 0, 1, 0, lastop, 0)
        else:
          mir_ins_mangled_oi(24, 0, oi_a, 0, 1, 0, lastop, 0)
    i_a = i_a + 1
  return 0

# Recursively emit LocalAlloc for a return-object cr<N> temp, flattening
# nested object fields: __li_o___cr<N>[_<parent>_]<leaf>.
def mir_cr_alloc_fields(src: var ptr,  ts: var array[262144, int],  te: var array[262144, int], itmp: var array[4096, int],  crid: int,  type_idx: int,  prefix_oi: int) raises IO -> int
  requires true
  ensures result == 0
  decreases 0
=
  var tsrc: ptr = li_rt_type_src_get(type_idx)
  if tsrc == 0:
    tsrc = src
  li_rt_type_src_store(-1, tsrc)
  var nf_c: int = mir_obj_field_count(itmp, type_idx)
  var i_c: int = 0
  var fa_c: array[2, int]
  while i_c < nf_c:
    mir_obj_field_name(itmp, type_idx, i_c, fa_c)
    var oi_c: int = 0
    if prefix_oi < 0:
      oi_c = li_rt_mir_objname_reg_prefix(src, 0, 0, fa_c[0], fa_c[1], 1, crid, tsrc)
    else:
      oi_c = li_rt_mir_objname_add_nested(prefix_oi, tsrc, fa_c[0], fa_c[1])
    var sub_c: int = mir_obj_field_obj_type(src, ts, te, itmp, type_idx, i_c)
    if sub_c >= 0:
      mir_cr_alloc_fields(src,  ts,  te,  itmp,  crid,  sub_c,  oi_c)
    else:
      var cop_c: int = 24
      var iv_c: int = 0
      if mir_obj_field_elems(itmp, type_idx, i_c) > 0:
        cop_c = 9
        iv_c = mir_obj_field_elems(itmp, type_idx, i_c)
      else:
        if mir_obj_field_float(itmp, type_idx, i_c) == 1:
          cop_c = 35
      var flt_c: int = 0
      if cop_c == 9:
        flt_c = mir_obj_field_float(itmp, type_idx, i_c)
      li_rt_mir_str("INS")
      li_rt_ast_space()
      li_rt_ast_int(cop_c)
      li_rt_ast_space()
      li_rt_ast_int(iv_c)
      li_rt_ast_space()
      li_rt_ast_int(0)
      li_rt_ast_space()
      li_rt_mir_objname_out(oi_c)
      # 5 empty name cells
      li_rt_ast_space()
      li_rt_ast_space()
      li_rt_ast_space()
      li_rt_ast_space()
      li_rt_ast_space()
      # f18..f21
      li_rt_ast_space()
      li_rt_ast_int(0)
      li_rt_ast_space()
      li_rt_ast_int(0)
      li_rt_ast_space()
      li_rt_ast_int(0)
      li_rt_ast_space()
      li_rt_ast_int(1)
      # name cell 6 (empty)
      li_rt_ast_space()
      # f25..f36
      li_rt_ast_space()
      li_rt_ast_int(0)
      li_rt_ast_space()
      li_rt_ast_int(1)
      li_rt_ast_space()
      li_rt_ast_int(0)
      li_rt_ast_space()
      li_rt_ast_int(0)
      li_rt_ast_space()
      li_rt_ast_int(0)
      li_rt_ast_space()
      li_rt_ast_int(0)
      li_rt_ast_space()
      li_rt_ast_int(0)
      li_rt_ast_space()
      li_rt_ast_int(flt_c)
      li_rt_ast_space()
      li_rt_ast_int(0)
      li_rt_ast_space()
      li_rt_ast_int(0)
      li_rt_ast_space()
      li_rt_ast_int(0)
      li_rt_ast_space()
      li_rt_ast_int(0)
      li_rt_ast_nl()
    i_c = i_c + 1
  return 0

# Emit the CallProc line for a call that returns an object: INS 8 with
# ident = __li_o___cr<crid>, callee name, then the OBJ return layout. The cr
# slot LocalAllocs are emitted by mir_cr_alloc_fields before this.
def mir_cr_call_line(src: var ptr,  ts: var array[262144, int],  te: var array[262144, int], itmp: var array[4096, int],  crid: int,  cal_s: int,  cal_e: int,  obj_ti: int,  lastop: var array[1, int]) raises IO -> int
  requires true
  ensures result == 0
  decreases 0
=
  li_rt_mir_str("INS")
  li_rt_ast_space()
  li_rt_ast_int(8)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_mir_str("__li_o___cr")
  li_rt_ast_int(crid)
  # str_value cell (empty), then callee name cell
  li_rt_ast_space()
  li_rt_ast_space()
  li_rt_mir_esc(src, cal_s, cal_e)
  # 3 empty name cells (lhs_ident, rhs_ident, label)
  li_rt_ast_space()
  li_rt_ast_space()
  li_rt_ast_space()
  # f18..f21
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(1)
  # name cell 6 (empty)
  li_rt_ast_space()
  # f25..f36
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(1)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_nl()
  lastop[0] = 8
  return 0

# Recursively emit LocalAlloc for a method-call write-back temp wb<N>,
# flattening nested object fields: __li_o_wb<N>[_<parent>_]<leaf>.
def mir_wb_alloc_fields(src: var ptr,  ts: var array[262144, int],  te: var array[262144, int], itmp: var array[4096, int],  crid: int,  type_idx: int,  prefix_oi: int) raises IO -> int
  requires true
  ensures result == 0
  decreases 0
=
  var tsrc: ptr = li_rt_type_src_get(type_idx)
  if tsrc == 0:
    tsrc = src
  li_rt_type_src_store(-1, tsrc)
  var nf_w: int = mir_obj_field_count(itmp, type_idx)
  var fa_w: array[2, int]
  var i_w: int = 0
  while i_w < nf_w:
    mir_obj_field_name(itmp, type_idx, i_w, fa_w)
    var oi_w: int = 0
    if prefix_oi < 0:
      oi_w = li_rt_mir_objname_reg_prefix(src, 0, 0, fa_w[0], fa_w[1], 3, crid, tsrc)
    else:
      oi_w = li_rt_mir_objname_add_nested(prefix_oi, tsrc, fa_w[0], fa_w[1])
    var sub_w: int = mir_obj_field_obj_type(src, ts, te, itmp, type_idx, i_w)
    if sub_w >= 0:
      mir_wb_alloc_fields(src,  ts,  te,  itmp,  crid,  sub_w,  oi_w)
    else:
      var cop_w: int = 24
      var iv_w: int = 0
      if mir_obj_field_elems(itmp, type_idx, i_w) > 0:
        cop_w = 9
        iv_w = mir_obj_field_elems(itmp, type_idx, i_w)
      else:
        if mir_obj_field_float(itmp, type_idx, i_w) == 1:
          cop_w = 35
      li_rt_mir_str("INS")
      li_rt_ast_space()
      li_rt_ast_int(cop_w)
      li_rt_ast_space()
      li_rt_ast_int(iv_w)
      li_rt_ast_space()
      li_rt_ast_int(0)
      li_rt_ast_space()
      li_rt_mir_objname_out(oi_w)
      # 5 empty name cells
      li_rt_ast_space()
      li_rt_ast_space()
      li_rt_ast_space()
      li_rt_ast_space()
      li_rt_ast_space()
      # f18..f21
      li_rt_ast_space()
      li_rt_ast_int(0)
      li_rt_ast_space()
      li_rt_ast_int(0)
      li_rt_ast_space()
      li_rt_ast_int(0)
      li_rt_ast_space()
      li_rt_ast_int(1)
      # name cell 6 (empty)
      li_rt_ast_space()
      # f25..f36
      li_rt_ast_space()
      li_rt_ast_int(0)
      li_rt_ast_space()
      li_rt_ast_int(1)
      li_rt_ast_space()
      li_rt_ast_int(0)
      li_rt_ast_space()
      li_rt_ast_int(0)
      li_rt_ast_space()
      li_rt_ast_int(0)
      li_rt_ast_space()
      li_rt_ast_int(0)
      li_rt_ast_space()
      li_rt_ast_int(0)
      li_rt_ast_space()
      li_rt_ast_int(0)
      li_rt_ast_space()
      li_rt_ast_int(0)
      li_rt_ast_space()
      li_rt_ast_int(0)
      li_rt_ast_space()
      li_rt_ast_int(0)
      li_rt_ast_space()
      li_rt_ast_int(0)
      li_rt_ast_nl()
    i_w = i_w + 1
  return 0

# Emit INS with a mangled base-only name (e.g. `return v` -> INS 4 __li_o_v)
def mir_ins_mangled_base(src: var ptr, op: int, base_s: int, base_e: int, lastop: var array[1, int]) raises IO -> int
  requires true
