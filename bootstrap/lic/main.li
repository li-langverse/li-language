def a_line_text_text(d: int,  src: var ptr,  code: int,  s1: int,  e1: int, s2: int,  e2: int) -> int
  requires true
  ensures result == 0
  decreases 0
=
  if d == 1:
    var ta: ptr = src
    var tb: ptr = src
    li_rt_ast_int(code)
    li_rt_ast_space()
    li_rt_ast_text(ta,  s1,  e1)
    li_rt_ast_space()
    li_rt_ast_text(tb,  s2,  e2)
    li_rt_ast_nl()
  return 0

