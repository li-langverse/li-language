            var szl: int = mir_farray_size(src,  ts,  te,  peek65536(darena, el + 1),  peek65536(darena, el + 2),  ptok2,  pelems,  pef,  pp0,  ppn,  pn,  fatok,  nfa)
            if szl > 0:
              var szr: int = mir_farray_size(src,  ts,  te,  peek65536(darena, er + 1),  peek65536(darena, er + 2),  ptok2,  pelems,  pef,  pp0,  ppn,  pn,  fatok,  nfa)
              if szr > 0:
                var eb: int = 0
                if szl == szr:
                  eb = 1
                if szl == 1:
                  if szr > 1:
                    eb = 1
                if szr == 1:
                  if szl > 1:
                    eb = 1
                if eb == 1:
                  var f20: array[44, int]
                  mir_fdef(f20)
                  f20[0] = peek65536(darena, lrec + 1)
                  f20[1] = peek65536(darena, lrec + 2)
                  f20[2] = 1
                  f20[9] = peek65536(darena, el + 1)
                  f20[10] = peek65536(darena, el + 2)
                  f20[11] = 1
                  f20[12] = peek65536(darena, er + 1)
                  f20[13] = peek65536(darena, er + 2)
                  f20[14] = 1
                  f20[18] = mir_binop_code(eopk)
                  if szl == 1:
                    if szr > 1:
                      f20[34] = 1
                  if szr == 1:
                    if szl > 1:
                      f20[35] = 1
                  var esz: int = szl
                  if szr > esz:
                    esz = szr
                  mir_ins_line(src,  f20,  20,  esz,  -1,  lastop)
                  return 0
    # 2D matrix multiply assignment: C = A @ B -> ArrayMatMul2DF64
    if eopk == 76:
      var ml2: int = peek65536(darena, rrec + 2)
      var mr2: int = peek65536(darena, rrec + 3)
      if peek65536(darena, ml2 + 0) == 3:
        if peek65536(darena, mr2 + 0) == 3:
          var dda2: array[2, int]
          var ddb2: array[2, int]
          if mir_mat_dims(src,  ts,  te,  peek65536(darena, ml2 + 1),  peek65536(darena, ml2 + 2),  matok,  nmat,  dda2) == 1:
            if mir_mat_dims(src,  ts,  te,  peek65536(darena, mr2 + 1),  peek65536(darena, mr2 + 2),  matok,  nmat,  ddb2) == 1:
              if dda2[1] == ddb2[0]:
                var fmm2: array[44, int]
                mir_fdef(fmm2)
                fmm2[0] = peek65536(darena, lrec + 1)
                fmm2[1] = peek65536(darena, lrec + 2)
                fmm2[2] = 1
                fmm2[9] = peek65536(darena, ml2 + 1)
                fmm2[10] = peek65536(darena, ml2 + 2)
                fmm2[11] = 1
                fmm2[12] = peek65536(darena, mr2 + 1)
                fmm2[13] = peek65536(darena, mr2 + 2)
                fmm2[14] = 1
                fmm2[27] = dda2[1]
                fmm2[30] = ddb2[1]
                mir_ins_line(src,  fmm2,  17,  dda2[0],  -1,  lastop)
                return 0
    var flt: int = mir_name_float(src,  ts,  te,  peek65536(darena, lrec + 1),  peek65536(darena, lrec + 2),  ftok,  nft)
    if flt == 1:
      if peek65536(darena, rrec + 0) == 7:
        if mir_try_fma(darena,  lrec,  rrec,  src,  ts,  te,  lastop) == 1:
          return 0
    var op2: int = 26
    if flt == 1:
      op2 = 28
    var f2: array[44, int]
    mir_fdef(f2)
    f2[0] = peek65536(darena, lrec + 1)
    f2[1] = peek65536(darena, lrec + 2)
    f2[2] = 1
    var fid2: int = -1
    if flt == 1:
      if peek65536(darena, rrec + 0) == 1:
        f2[26] = 1
        fid2 = peek65536(darena, rrec + 1)
      else:
        if peek65536(darena, rrec + 0) == 3:
          f2[26] = 0
          f2[12] = peek65536(darena, rrec + 1)
          f2[13] = peek65536(darena, rrec + 2)
          f2[14] = 1
        else:
          if mir_lower_expr(darena,  dasp,  rrec,  src,  tk,  ts,  te,  n,  pi,  err,  tc,  lastop, ftok,  nft,  ftmp,  itok,  nit,  itmp,  fatok,  nfa, matok,  nmat, ptok,  pex,  pp0,  ppn,  pret,  pn,  ptok2,  pty,  pelems,  pef, pei,  pvar) == 1:
            return 1
          f2[26] = 0
          f2[12] = peek65536(darena, rrec + 2)
          f2[14] = mir_name_mode_lowered(darena, rrec)
    else:
      if peek65536(darena, rrec + 0) == 0:
        f2[26] = 1
        f2[27] = peek65536(darena, rrec + 1)
      else:
        if peek65536(darena, rrec + 0) == 3:
          f2[26] = 0
          f2[12] = peek65536(darena, rrec + 1)
          f2[13] = peek65536(darena, rrec + 2)
          f2[14] = 1
        else:
          if mir_lower_expr(darena,  dasp,  rrec,  src,  tk,  ts,  te,  n,  pi,  err,  tc,  lastop, ftok,  nft,  ftmp,  itok,  nit,  itmp,  fatok,  nfa, matok,  nmat, ptok,  pex,  pp0,  ppn,  pret,  pn,  ptok2,  pty,  pelems,  pef, pei,  pvar) == 1:
            return 1
          f2[26] = 0
          f2[12] = peek65536(darena, rrec + 2)
          f2[14] = mir_name_mode_lowered(darena, rrec)
    mir_ins_line(src,  f2,  op2,  0,  fid2,  lastop)
    return 0
  err[0] = 1
  return 1

def mir_fn_line(src: var ptr,  ts: var array[262144, int],  te: var array[262144, int], name_tok: int,  retf: int,  reti64: int,  retvoid: int,  retobj: int,  is_extern: int,  no_vec: int,  is_async_fn: int) raises IO -> int
  requires true
  ensures result == 0
  decreases 0
=
  li_rt_mir_str("FN")
  li_rt_ast_space()
  li_rt_ast_text(src,  peek_tk(ts, name_tok + 0),  peek_tk(te, name_tok + 0))
  li_rt_ast_space()
  li_rt_ast_int(retf)
  li_rt_ast_space()
  li_rt_ast_int(reti64)
  li_rt_ast_space()
  li_rt_ast_int(retvoid)
  li_rt_ast_space()
  li_rt_ast_int(retobj)
  li_rt_ast_space()
  li_rt_ast_int(is_extern)
  li_rt_ast_space()
  li_rt_ast_int(is_async_fn)
  li_rt_ast_space()
  li_rt_ast_int(no_vec)
  li_rt_ast_nl()
  return 0

# One RETPARAM line for a leaf field, named by its accumulated field path
# (path == 0 prints nothing, so callers always register at least one segment).
def mir_retparam_line(src: var ptr,  ts: var array[262144, int],  te: var array[262144, int], itmp: var array[4096, int],  type_idx: int,  field_idx: int,  path: int) raises IO -> int
  requires true
  ensures result == 0
  decreases 0
=
  var fflt: int = mir_obj_field_float(itmp, type_idx, field_idx)
  var felems_r: int = mir_obj_field_elems(itmp, type_idx, field_idx)
  li_rt_mir_str("RETPARAM")
  li_rt_ast_space()
  li_rt_mir_fieldpath_out(path)
  li_rt_ast_space()
  li_rt_ast_int(fflt)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(felems_r)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_nl()
  return 0

# Recursively emit RETPARAM lines for a return object, flattening nested
# object fields into their full compound path (swapchain_viewport_w etc.). path
# is the accumulated field path (0 at the top level); each segment is registered
# against the type that declares it.
def mir_obj_retparams(src: var ptr,  ts: var array[262144, int],  te: var array[262144, int], itmp: var array[4096, int],  type_idx: int,  path: int) raises IO -> int
  requires true
  ensures result == 0
  decreases 0
=
  var nf_r: int = mir_obj_field_count(itmp, type_idx)
  var i_r: int = 0
  var fa_r: array[2, int]
  var tsrc_r: ptr = li_rt_type_src_get(type_idx)
  if tsrc_r == 0:
    tsrc_r = src
  while i_r < nf_r:
    mir_obj_field_name(itmp, type_idx, i_r, fa_r)
    var path_r: int = li_rt_mir_fieldpath_add(path, tsrc_r, fa_r[0], fa_r[1])
    var sub_r: int = mir_obj_field_obj_type(src, ts, te, itmp, type_idx, i_r)
    if sub_r >= 0:
      mir_obj_retparams(src,  ts,  te,  itmp,  sub_r,  path_r)
    else:
      mir_retparam_line(src,  ts,  te,  itmp,  type_idx,  i_r,  path_r)
    i_r = i_r + 1
  return 0

def mir_obj_line_r(src: var ptr,  ts: var array[262144, int],  te: var array[262144, int], itmp: var array[4096, int],  type_idx: int,  field_idx: int,  parent_path: int) raises IO -> int
  requires true
  ensures result == 0
  decreases 0
=
  var fa: array[2, int]
  mir_obj_field_name(itmp, type_idx, field_idx, fa)
  var obj_tsrc: ptr = li_rt_type_src_get(type_idx)
  if obj_tsrc == 0:
    obj_tsrc = src
  var sub: int = mir_obj_field_obj_type(src, ts, te, itmp, type_idx, field_idx)
  var path: int = li_rt_mir_fieldpath_add(parent_path, obj_tsrc, fa[0], fa[1])
  if sub >= 0:
    var sn: int = mir_obj_field_count(itmp, sub)
    var si: int = 0
    while si < sn:
      mir_obj_line_r(src, ts, te, itmp, sub, si, path)
      si = si + 1
  else:
    var fflt: int = mir_obj_field_float(itmp, type_idx, field_idx)
    var felems_o: int = mir_obj_field_elems(itmp, type_idx, field_idx)
    li_rt_mir_str("OBJ")
    li_rt_ast_space()
    if parent_path == 0:
      li_rt_ast_text(obj_tsrc, fa[0], fa[1])
    else:
      li_rt_mir_fieldpath_out(path)
    li_rt_ast_space()
    li_rt_ast_int(fflt)
    li_rt_ast_space()
    li_rt_ast_int(0)
    li_rt_ast_space()
    li_rt_ast_int(0)
    li_rt_ast_space()
    li_rt_ast_int(0)
    li_rt_ast_space()
    li_rt_ast_int(0)
    li_rt_ast_space()
    li_rt_ast_int(felems_o)
    li_rt_ast_space()
    li_rt_ast_int(0)
    li_rt_ast_space()
    li_rt_ast_int(0)
    li_rt_ast_space()
    li_rt_ast_int(0)
    li_rt_ast_nl()
  return 0

def mir_obj_line(src: var ptr,  ts: var array[262144, int],  te: var array[262144, int], itmp: var array[4096, int],  type_idx: int,  field_idx: int) raises IO -> int
  requires true
  ensures result == 0
  decreases 0
=
  mir_obj_line_r(src, ts, te, itmp, type_idx, field_idx, 0)
  return 0

def mir_dec_line(src: var ptr,  ts: var array[262144, int],  te: var array[262144, int], name_tok: int,  lanes: int,  vectorized: int,  parallel: int,  disjoint: int) raises IO -> int
  requires true
  ensures result == 0
  decreases 0
=
  li_rt_mir_str("DEC")
  li_rt_ast_space()
  li_rt_ast_text(src,  peek_tk(ts, name_tok + 0),  peek_tk(te, name_tok + 0))
  li_rt_ast_space()
  li_rt_ast_int(lanes)
  li_rt_ast_space()
  li_rt_ast_int(vectorized)
  li_rt_ast_space()
  li_rt_ast_int(parallel)
  li_rt_ast_space()
  li_rt_ast_int(disjoint)
  li_rt_ast_nl()
  return 0

def mir_param_line(src: var ptr,  ts: var array[262144, int],  te: var array[262144, int], name_tok: int,  ty: int,  elems: int,  ef: int,  ei: int,  is_var: int,  mx: int,  mc: int) raises IO -> int
  requires true
  ensures result == 0
  decreases 0
=
  li_rt_mir_str("PARAM")
  li_rt_ast_space()
  li_rt_ast_text(src,  peek_tk(ts, name_tok + 0),  peek_tk(te, name_tok + 0))
  var pf: int = 0
  if ty == 1:
    pf = 1
  if ty == 5:
    if ef == 1:
      pf = 1
    if mx == 1:
      pf = 1
  var ps: int = 0
  if ty == 2 or ty == 3:
    ps = 1
  var pi2: int = 0
  if ty == 4 or ty == 2:
    pi2 = 1
  if ty == 5:
    if ei == 1:
      pi2 = 1
  var fe: int = 0
  if ty == 5:
    fe = elems
  li_rt_ast_space()
  li_rt_ast_int(pf)
  li_rt_ast_space()
  li_rt_ast_int(ps)
  li_rt_ast_space()
  li_rt_ast_int(pi2)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(fe)
  li_rt_ast_space()
  li_rt_ast_int(mx)
  li_rt_ast_space()
  li_rt_ast_int(mc)
  li_rt_ast_space()
  if mx == 1:
    # C++ lower_to_mir only sets is_var for plain fixed-size arrays; 2D
    # matrix params keep is_var false (default MirParam).
    li_rt_ast_int(0)
  else:
    li_rt_ast_int(is_var)
  li_rt_ast_nl()
  return 0

# Emit one flattened object parameter, e.g. Vec3 a -> __li_o_a_x.
def mir_obj_param_line_r(src: var ptr, ts: var array[262144, int], te: var array[262144, int], itmp: var array[4096, int], type_idx: int, base_s: int, base_e: int, field_idx: int, is_var: int, parent_path: int) raises IO -> int
  requires true
  ensures result == 0
  decreases 0
=
  var fa: array[2, int]
  mir_obj_field_name(itmp, type_idx, field_idx, fa)
  var op_tsrc: ptr = li_rt_type_src_get(type_idx)
  if op_tsrc == 0:
    op_tsrc = src
  var sub: int = mir_obj_field_obj_type(src, ts, te, itmp, type_idx, field_idx)
  var path: int = li_rt_mir_fieldpath_add(parent_path, op_tsrc, fa[0], fa[1])
  if sub >= 0:
    var sn: int = mir_obj_field_count(itmp, sub)
    var si: int = 0
    while si < sn:
      mir_obj_param_line_r(src, ts, te, itmp, sub, base_s, base_e, si, is_var, path)
      si = si + 1
  else:
    var ffloat: int = mir_obj_field_float(itmp, type_idx, field_idx)
    var felems: int = mir_obj_field_elems(itmp, type_idx, field_idx)
    li_rt_mir_str("PARAM")
    li_rt_ast_space()
    li_rt_mir_str("__li_o_")
    li_rt_mir_esc(src, base_s, base_e)
    li_rt_mir_str("_")
    if parent_path == 0:
      li_rt_mir_esc(op_tsrc, fa[0], fa[1])
    else:
      li_rt_mir_fieldpath_out(path)
    li_rt_ast_space()
    li_rt_ast_int(ffloat)
    li_rt_ast_space()
    li_rt_ast_int(0)
    li_rt_ast_space()
    li_rt_ast_int(0)
    li_rt_ast_space()
    li_rt_ast_int(0)
    li_rt_ast_space()
    li_rt_ast_int(0)
    li_rt_ast_space()
    li_rt_ast_int(felems)
    li_rt_ast_space()
    li_rt_ast_int(0)
    li_rt_ast_space()
    li_rt_ast_int(0)
    li_rt_ast_space()
    li_rt_ast_int(is_var)
    li_rt_ast_nl()
  return 0

def mir_obj_param_line(src: var ptr, ts: var array[262144, int], te: var array[262144, int], itmp: var array[4096, int], type_idx: int, base_s: int, base_e: int, field_idx: int, is_var: int) raises IO -> int
  requires true
  ensures result == 0
  decreases 0
=
  mir_obj_param_line_r(src, ts, te, itmp, type_idx, base_s, base_e, field_idx, is_var, 0)
  return 0

def mir_emit_object_params(src: var ptr, ts: var array[262144, int], te: var array[262144, int], itmp: var array[4096, int], type_idx: int, base_s: int, base_e: int, is_var: int) raises IO -> int
  requires true
  ensures result == 0
  decreases 0
=
  var nf: int = mir_obj_field_count(itmp, type_idx)
  var j: int = 0
  while j < nf:
    mir_obj_param_line(src, ts, te, itmp, type_idx, base_s, base_e, j, is_var)
    j = j + 1
  return 0

def mir_skip_raises(tk: var array[262144, int],  n: var array[1, int],  pi: var array[1, int],  err: var array[1, int]) -> int

  requires true
  ensures result == 0
  decreases 0
=
  if cur_kind(tk,  n,  pi,  err) == 31:
    pi[0] = pi[0] + 1
    if cur_kind(tk,  n,  pi,  err) == 4:
      var done: int = 0
      while done == 0:
        pi[0] = pi[0] + 1
        if accept_k(tk,  n,  pi,  err, 55) == 1:
          done = 0
        else:
          done = 1
  return 0

def mir_skip_contracts(src: var ptr,  tk: var array[262144, int],  ts: var array[262144, int], te: var array[262144, int],  n: var array[1, int],  pi: var array[1, int], err: var array[1, int]) -> int
  requires true
  ensures result == 0
  decreases 0
=
  while 1 == 1:
    var ck: int = cur_kind(tk,  n,  pi,  err)
    if ck == 41 or ck == 42 or ck == 43 or ck == 44 or ck == 45:
      parse_contract(src,  tk,  ts,  te,  n,  pi,  err, 0)
      continue
    break
  return 0

def mir_collect_proc(src: var ptr,  tk: var array[262144, int],  ts: var array[262144, int], te: var array[262144, int],  n: var array[1, int],  pi: var array[1, int], err: var array[1, int],  is_extern: int,  pid: int, ptok: var array[128, int],  pex: var array[128, int], pp0: var array[128, int],  ppn: var array[128, int], pret: var array[128, int],  ptok2: var array[512, int], pty: var array[512, int],  pelems: var array[512, int],  pef: var array[512, int],  pei: var array[512, int], pvar: var array[512, int],  pmx: var array[512, int],  pmc: var array[512, int],  itmp: var array[4096, int],  pcount: var array[1, int]) raises IO -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  if is_extern == 0:
    if cur_kind(tk,  n,  pi,  err) == 16:
      pi[0] = pi[0] + 1
    else:
      if cur_kind(tk,  n,  pi,  err) == 17:
        pi[0] = pi[0] + 1
    if cur_kind(tk,  n,  pi,  err) == 10:
      pi[0] = pi[0] + 1
    else:
      err[0] = 1
      return 1
  var pname: int = pi[0]
  pi[0] = pi[0] + 1
  li_rt_preg_set(0, pid, pname)
  li_rt_preg_set(1, pid, is_extern)
  parse_type_params(src,  tk,  ts,  te,  n,  pi,  err, 0, 1)
  expect_k(tk,  n,  pi,  err, 49)
  skip_param_layout(tk,  n,  pi,  err)
  var _pc: int = li_rt_pidx_get()
  li_rt_preg_set(2, pid, _pc)
  if cur_kind(tk,  n,  pi,  err) != 50:
    var done: int = 0
    while done == 0:
      skip_param_layout(tk,  n,  pi,  err)
      var pn2: int = pi[0]
      pi[0] = pi[0] + 1
      expect_k(tk,  n,  pi,  err, 56)
      var type_tok: int = pi[0]
      if peek_tk(tk, type_tok + 0) == 20:
        type_tok = type_tok + 1
      var ti: array[6, int]
      if mir_type_info(src,  tk,  ts,  te,  n,  pi,  err,  ti) == 1:
        return 1
      li_rt_preg_set(5, _pc, pn2)
      li_rt_preg_set(6, _pc, ti[0])
      li_rt_preg_set(7, _pc, ti[2])
      if ti[3] == 1:
        li_rt_preg_set(8, _pc, 1)
      else:
        li_rt_preg_set(8, _pc, 0)
      if ti[3] == 2 or ti[3] == 4:
        li_rt_preg_set(9, _pc, 1)
      else:
        li_rt_preg_set(9, _pc, 0)
      if ti[3] == 5:
        if ti[5] == 1:
          li_rt_preg_set(11, _pc, 1)
          li_rt_preg_set(12, _pc, ti[4])
        else:
          li_rt_preg_set(11, _pc, 0)
          li_rt_preg_set(12, _pc, 0)
      else:
        li_rt_preg_set(11, _pc, 0)
        li_rt_preg_set(12, _pc, 0)
      if ti[0] == 5:
        li_rt_preg_set(10, _pc, ti[1])
        li_rt_preg_set(13, _pc, -1)
      else:
        if ti[0] == 6:
          li_rt_preg_set(10, _pc, 1000 + type_tok * 2 + ti[1])
          # Preserve the resolved object index for cross-file emit. The type
          # token itself belongs to this source file and cannot be reused
          # against the caller's token buffer.
          li_rt_preg_set(13, _pc, mir_obj_find_type(src, ts, te, itmp, peek_tk(ts, type_tok + 0), peek_tk(te, type_tok + 0)))
        else:
          li_rt_preg_set(10, _pc, 0)
          li_rt_preg_set(13, _pc, -1)
      if ti[0] == 6:
        li_rt_preg_set(12, _pc, type_tok)
      _pc = _pc + 1
      skip_param_layout(tk,  n,  pi,  err)
      if accept_k(tk,  n,  pi,  err, 55) == 1:
        done = 0
      else:
        done = 1
  li_rt_pidx_set(_pc)
  li_rt_preg_set(3, pid, _pc - li_rt_preg_get(2, pid))
  skip_param_layout(tk,  n,  pi,  err)
  expect_k(tk,  n,  pi,  err, 50)
  skip_newlines(tk,  n,  pi,  err)
  mir_skip_raises(tk,  n,  pi,  err)
  skip_newlines(tk,  n,  pi,  err)
  var ret: int = 8
  if accept_k(tk,  n,  pi,  err, 57) == 1:
    var rt_tok2: int = -1
    var rk3: int = cur_kind(tk,  n,  pi,  err)
    if rk3 == 4 or rk3 == 47 or rk3 == 48:
      rt_tok2 = pi[0]
    var ti2: array[6, int]
    if mir_type_info(src,  tk,  ts,  te,  n,  pi,  err,  ti2) == 1:
      return 1
    if ti2[0] == 7:
      ret = 0
    else:
      if ti2[0] == 0:
        ret = 1
      else:
        if ti2[0] == 1:
          ret = 2
        else:
          if ti2[0] == 2:
            ret = 3
          else:
            if ti2[0] == 3:
              ret = 3
            else:
              if ti2[0] == 4:
                ret = 4
              else:
                if ti2[0] == 5:
                  ret = 5
                else:
                  ret = 6
                  # Store the return type name so the call-site lowering can
                  # resolve this callee's object layout (C++ callee_ret_obj).
                  if rt_tok2 >= 0:
                    li_rt_mir_retname_store(pid, src, peek_tk(ts, rt_tok2 + 0), peek_tk(te, rt_tok2 + 0))
  li_rt_preg_set(4, pid, ret)
  skip_newlines(tk,  n,  pi,  err)
  mir_skip_raises(tk,  n,  pi,  err)
  skip_newlines(tk,  n,  pi,  err)
  mir_skip_contracts(src,  tk,  ts,  te,  n,  pi,  err)
  if is_extern == 1:
    skip_newlines(tk,  n,  pi,  err)
    return 0
  expect_k(tk,  n,  pi,  err, 58)
  skip_newlines(tk,  n,  pi,  err)
  parse_block(src,  tk,  ts,  te,  n,  pi,  err, 0)
  return 0# Import-cycle gate (C++ import_resolve.cpp load DFS with an in-progress
# set, "import_cycle: <path>"): depth-2 transitive mirror for the mir
# lane. The root's direct imports are scanned; each resolved import is
# token-lexed into a LOCAL scratch stream (never mutating the root's
# token arrays) and its own imports are re-resolved — if any level-1 or
# level-2 import resolves back to the root's path (or imports itself),
# the load DFS would revisit an in-progress module and the host rejects.
# Depth beyond 2 is not covered yet: the sweep corpus only contains the
# import_cycle pair shape. Unresolved imports are skipped without
# rejecting (resolution fail differs from a cycle).
def mir_import_cycle_check(root: ptr,  src: var ptr,  tk: var array[262144, int],  ts: var array[262144, int],  te: var array[262144, int],  n: var array[1, int],  err: var array[1, int]) raises IO -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  var c1: int = 0
  while c1 < n[0]:
    if peek_tk(tk, c1) == 18:
      var ntok: int = c1 + 1
      if ntok < n[0]:
        if peek_tk(tk, ntok) == 4:
          var im_end: int = ntok
          var im_guard: int = 0
          while im_guard < 8:
            if im_end + 2 < n[0]:
              if peek_tk(tk, im_end + 1) == 72:
                if peek_tk(tk, im_end + 2) == 4:
                  im_end = im_end + 2
                  im_guard = im_guard + 1
                  continue
            break
          var mlen1: int = peek_tk(te, im_end) - peek_tk(ts, ntok)
          var mname1: ptr = bytes_slice_i(src,  peek_tk(ts, ntok), mlen1)
          var imp1: ptr = li_rt_resolve_import(root,  mname1)
          if imp1 != 0:
            var ipath1: ptr = li_rt_resolve_import_last_path()
            if li_rt_str_eq(ipath1,  root) == 1:
              err[0] = 1
              return 1
            # ---- level 2: lex the import, rescan its imports ----
            var tk2: array[8192, int]
            var ts2: array[8192, int]
            var te2: array[8192, int]
            var n2: array[1, int]
            n2[0] = 0
            var lx2: int = lex_source(imp1,  tk2,  ts2,  te2,  n2, 0)
            if lx2 == 0:
              var c2: int = 0
              while c2 < n2[0]:
                if peek_tk(tk2, c2) == 18:
                  var ntok2: int = c2 + 1
                  if ntok2 < n2[0]:
                    if peek_tk(tk2, ntok2) == 4:
                      var im_end2: int = ntok2
                      var im_guard2: int = 0
                      while im_guard2 < 8:
                        if im_end2 + 2 < n2[0]:
                          if peek_tk(tk2, im_end2 + 1) == 72:
                            if peek_tk(tk2, im_end2 + 2) == 4:
                              im_end2 = im_end2 + 2
                              im_guard2 = im_guard2 + 1
                              continue
                        break
                      var mlen2: int = peek_tk(te2, im_end2) - peek_tk(ts2, ntok2)
                      var mname2: ptr = bytes_slice_i(src,  peek_tk(ts2, ntok2), mlen2)
                      var imp2: ptr = li_rt_resolve_import(ipath1,  mname2)
                      if imp2 != 0:
                        var ipath2: ptr = li_rt_resolve_import_last_path()
                        if li_rt_str_eq(ipath2,  root) == 1:
                          err[0] = 1
                          return 1
                        if li_rt_str_eq(ipath2,  ipath1) == 1:
                          err[0] = 1
                          return 1
                c2 = c2 + 1
    c1 = c1 + 1
  return 0

# ------------------------------------------------------------ type space gate --
# Unknown-type gate (C++ typecheck_module; the "unknown type '<name>'" class,
# compiler/types/typecheck.cpp resolve_type_expr):
#   * only the MAIN module's own procs are typechecked — check_count =
#     min(main_proc_count, module.procs.size()) — so the scan fires on
#     annotation positions of root-file procs only; imported procs are
#     call-resolvable but never re-checked, and alias bodies are only
#     resolved at use sites;
#   * known names = C++ primitive set (resolve_type_expr Named branch) +
#     bracket builtins (simd/list/dict/tuple; 'Any' is forbidden so it stays
#     unknown) + the merged alias space (own `type`/`enum` heads + ALL type
#     heads of transitively resolved imports: merge_module merges types
#     without a visibility filter) + the current proc's `[T, ...]` type
#     vars (type_vars cleared per check_proc);
#   * extern defs are exempt (check_proc returns early);
#   * verdicts return directly, never through err[0]; every subshape failure
#     restores the err snapshot and under-rejects, and any unresolved or
#     unlexable import disables the whole gate (the preg-20 convention).
# Closed by this pass: the std bytes pair — reader_writer_smoke +
# packages/li-bytes/src/lib.li reject with `lic mir` (`unknown type 'bytes'`;
# `import std.bytes` exports only Bytes/StringView/Reader/Writer), which the
# walker previously accepted because lowercase `bytes`/`StringView` were
# hardcoded walker type codes in mir_type_info.
def ts_alias_skip(tk: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int]) -> int
  requires true
  ensures result == 0
  decreases 0
=
  # Consume a `type NAME ... = RHS` head so the scan never typechecks its
  # body. C++ keeps trait/object/enum inner defs in module.types (alias
  # entries), not module.procs, so check_proc never sees `Self`/trait-scoped
  # annotations — the walker must skip them too. Shapes:
  #   `type N = { p: int | ... }` refinement: whole brace group.
  #   `type N = array[8, T]` one-liner / `= trait` ident RHS: line only.
  #   `type N = object|trait|enum <newline> INDENT body DEDENT`: body tokens,
  #     with nested 2/3 indent/dedent pairs counted so the stop lands on the
  #     dedent that closes the alias body.
  # Any malformed head consumes up to the line end and returns (under-reject:
  # never fires the gate).
  var esv: int = err[0]
  err[0] = 0
  pi[0] = pi[0] + 1
  if cur_kind(tk, n, pi, err) != 4:
    while cur_kind(tk, n, pi, err) != 1:
      if cur_kind(tk, n, pi, err) == 0:
        break
      pi[0] = pi[0] + 1
    err[0] = esv
    return 0
  pi[0] = pi[0] + 1
  if cur_kind(tk, n, pi, err) == 51:
    ts_skip_group(tk, n, pi, err)
  if cur_kind(tk, n, pi, err) != 58:
    while cur_kind(tk, n, pi, err) != 1:
      if cur_kind(tk, n, pi, err) == 0:
        break
      pi[0] = pi[0] + 1
    err[0] = esv
    return 0
  pi[0] = pi[0] + 1
  var rhs: int = cur_kind(tk, n, pi, err)
  if rhs == 53:
    pi[0] = pi[0] + 1
    err[0] = esv
    return 0
  if rhs == 4:
    pi[0] = pi[0] + 1
    if cur_kind(tk, n, pi, err) == 51:
      ts_skip_group(tk, n, pi, err)
  var skipguard: int = 0
  while skipguard < 2048:
    var pk: int = cur_kind(tk, n, pi, err)
    if pk == 0:
      break
    if pk == 1:
      break
    pi[0] = pi[0] + 1
    skipguard = skipguard + 1
  var depth: int = 0
  var bguard: int = 0
  while bguard < 32768:
    var bk: int = cur_kind(tk, n, pi, err)
    if bk == 0:
      break
    pi[0] = pi[0] + 1
    if bk == 2:
      depth = depth + 1
    if bk == 3:
      if depth == 0:
        break
      depth = depth - 1
    bguard = bguard + 1
  err[0] = esv
  return 0

def ts_skip_group(tk: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int]) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  # Consume one balanced bracket group starting at the current token
  # ( opener 49/51/53 ). Fail-open on unbalanced input.
  var dep: int = 0
  var guard: int = 0
  while guard < 65536:
    var k: int = cur_kind(tk, n, pi, err)
    if k == 0:
      return 0
    pi[0] = pi[0] + 1
    if k == 49:
      dep = dep + 1
    if k == 51:
      dep = dep + 1
    if k == 53:
      dep = dep + 1
    if k == 50:
      if dep == 1:
        return 1
      dep = dep - 1
    if k == 52:
      if dep == 1:
        return 1
      dep = dep - 1
    if k == 54:
      if dep == 1:
        return 1
      dep = dep - 1
    guard = guard + 1
  return 0

def ts_is_prim(src: var ptr, ts: var array[262144, int], te: var array[262144, int], tok: int) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  # C++ resolve_type_expr's Named primitives, exactly (compiler/types/
  # typecheck.cpp): lowercase `bytes`/`string`/walker-only scalar spellings
  # are deliberately NOT in this set — the host rejects them with
  # `unknown type` unless an alias defines them.
  if tok_is(src, ts, te, tok, "int") == 1:
    return 1
  if tok_is(src, ts, te, tok, "bool") == 1:
    return 1
  if tok_is(src, ts, te, tok, "ptr") == 1:
    return 1
  if tok_is(src, ts, te, tok, "float") == 1:
    return 1
  if tok_is(src, ts, te, tok, "float64") == 1:
    return 1
  if tok_is(src, ts, te, tok, "f64") == 1:
    return 1
  if tok_is(src, ts, te, tok, "float32") == 1:
    return 1
  if tok_is(src, ts, te, tok, "f32") == 1:
    return 1
  if tok_is(src, ts, te, tok, "float8") == 1:
    return 1
  if tok_is(src, ts, te, tok, "f8") == 1:
    return 1
  if tok_is(src, ts, te, tok, "int64") == 1:
    return 1
  if tok_is(src, ts, te, tok, "i64") == 1:
    return 1
  if tok_is(src, ts, te, tok, "long") == 1:
    return 1
  if tok_is(src, ts, te, tok, "int32") == 1:
    return 1
  if tok_is(src, ts, te, tok, "i32") == 1:
    return 1
  if tok_is(src, ts, te, tok, "uint8") == 1:
    return 1
  if tok_is(src, ts, te, tok, "u8") == 1:
    return 1
  if tok_is(src, ts, te, tok, "binary") == 1:
    return 1
  if tok_is(src, ts, te, tok, "str") == 1:
    return 1
  if tok_is(src, ts, te, tok, "unit") == 1:
    return 1
  if tok_is(src, ts, te, tok, "simd") == 1:
    return 1
  if tok_is(src, ts, te, tok, "list") == 1:
    return 1
  if tok_is(src, ts, te, tok, "dict") == 1:
    return 1
  if tok_is(src, ts, te, tok, "tuple") == 1:
    return 1
  return 0

def ts_name_resolves(src: var ptr, ts: var array[262144, int], te: var array[262144, int], tok: int, A_src: var array[256, ptr], A_s: var array[256, int], A_e: var array[256, int], A_cnt: var array[1, int], TVsrc: var array[64, ptr], TV_s: var array[64, int], TV_e: var array[64, int], TV_cnt: var array[1, int]) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  # Known-name oracle for a kind-4 ident in a type-annotation position:
  # C++ primitives, then the merged alias space (byte-span triples so
  # imported-module entries resolve cross-buffer), then this proc's type
  # vars. Byte-span equality via fx_span_eq, never token indexes.
  if ts_is_prim(src, ts, te, tok) == 1:
    return 1
  var ns: int = peek_tk(ts, tok + 0)
  var ne: int = peek_tk(te, tok + 0)
  var k: int = 0
  while k < A_cnt[0]:
    if fx_span_eq(A_src[k], A_s[k], A_e[k], src, ns, ne) == 1:
      return 1
    k = k + 1
  k = 0
  while k < TV_cnt[0]:
    if fx_span_eq(TVsrc[k], TV_s[k], TV_e[k], src, ns, ne) == 1:
      return 1
    k = k + 1
  return 0

def ts_type_expr(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], A_src: var array[256, ptr], A_s: var array[256, int], A_e: var array[256, int], A_cnt: var array[1, int], TVsrc: var array[64, ptr], TV_s: var array[64, int], TV_e: var array[64, int], TV_cnt: var array[1, int]) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  # Mirror of mir_type_info's type-expression consumption, verdict-only:
  # fires 1 when an unknown kind-4 name is found anywhere in the annotation.
  # All parse-shape diffs restore the err snapshot and under-reject.
  var esv: int = err[0]
  err[0] = 0
  if accept_k(tk, n, pi, err, 53) == 1:
    if cur_kind(tk, n, pi, err) != 4:
      err[0] = esv
      return 0
    pi[0] = pi[0] + 1
    expect_k(tk, n, pi, err, 56)
    var emsub: int = ts_type_expr(src, tk, ts, te, n, pi, err, A_src, A_s, A_e, A_cnt, TVsrc, TV_s, TV_e, TV_cnt)
    expect_k(tk, n, pi, err, 74)
    parse_contract_expr(src, tk, ts, te, n, pi, err, 0)
    err[0] = esv
    return emsub
  if cur_kind(tk, n, pi, err) == 20:
    pi[0] = pi[0] + 1
  var k: int = cur_kind(tk, n, pi, err)
  if k != 4:
    if k != 48:
      if k != 47:
        err[0] = esv
        return 0
  var nm: int = pi[0]
  pi[0] = pi[0] + 1
  # Builtin-collection and Callable shapes resolve scheme-first, exactly
  # like C++ resolve_type_expr: their names are not in the alias space, so
  # they must be consumed BEFORE the alias lookup (order was wrong once;
  # `array[N, T]` used to be misjudged as unknown).
  if k == 4:
    if tok_is(src, ts, te, nm, "array") == 1:
      if accept_k(tk, n, pi, err, 51) == 1:
        if cur_kind(tk, n, pi, err) != 5:
          err[0] = esv
          return 0
        pi[0] = pi[0] + 1
        expect_k(tk, n, pi, err, 55)
        var easub: int = ts_type_expr(src, tk, ts, te, n, pi, err, A_src, A_s, A_e, A_cnt, TVsrc, TV_s, TV_e, TV_cnt)
        expect_k(tk, n, pi, err, 52)
        err[0] = esv
        return easub
      err[0] = esv
      return 0
    if tok_is(src, ts, te, nm, "simd") == 1:
      if accept_k(tk, n, pi, err, 51) == 1:
        var eisub: int = ts_type_expr(src, tk, ts, te, n, pi, err, A_src, A_s, A_e, A_cnt, TVsrc, TV_s, TV_e, TV_cnt)
        if accept_k(tk, n, pi, err, 55) == 1:
          if cur_kind(tk, n, pi, err) == 5:
            pi[0] = pi[0] + 1
        expect_k(tk, n, pi, err, 52)
        err[0] = esv
        return eisub
      err[0] = esv
      return 0
    if tok_is(src, ts, te, nm, "list") == 1:
      if accept_k(tk, n, pi, err, 51) == 1:
        var elsub: int = ts_list_args(src, tk, ts, te, n, pi, err, A_src, A_s, A_e, A_cnt, TVsrc, TV_s, TV_e, TV_cnt)
        err[0] = esv
        return elsub
      err[0] = esv
      return 0
    if tok_is(src, ts, te, nm, "dict") == 1:
      if accept_k(tk, n, pi, err, 51) == 1:
        var edsub: int = ts_list_args(src, tk, ts, te, n, pi, err, A_src, A_s, A_e, A_cnt, TVsrc, TV_s, TV_e, TV_cnt)
        err[0] = esv
        return edsub
      err[0] = esv
      return 0
    if tok_is(src, ts, te, nm, "tuple") == 1:
      if accept_k(tk, n, pi, err, 51) == 1:
        var etsub: int = ts_list_args(src, tk, ts, te, n, pi, err, A_src, A_s, A_e, A_cnt, TVsrc, TV_s, TV_e, TV_cnt)
        err[0] = esv
        return etsub
      err[0] = esv
      return 0
    if ts_name_resolves(src, ts, te, nm, A_src, A_s, A_e, A_cnt, TVsrc, TV_s, TV_e, TV_cnt) == 0:
      err[0] = esv
      return 1
  if tok_is(src, ts, te, nm, "Callable") == 1:
    # `Callable[[T1, ...], Ret]` — tok_is compares the token text, so this
    # covers both the ident spelling and the keyword kind (lexed as 48).
    if cur_kind(tk, n, pi, err) != 51:
      err[0] = esv
      return 0
    pi[0] = pi[0] + 1
    var ecsub: int = 0
    if cur_kind(tk, n, pi, err) != 51:
      err[0] = esv
      return 0
    pi[0] = pi[0] + 1
    var cg: int = 0
    while cg < 256:
      var ck2: int = cur_kind(tk, n, pi, err)
      if ck2 == 0:
        break
      if ck2 == 52:
        pi[0] = pi[0] + 1
        break
      var cpm: int = pi[0]
      var cf: int = ts_type_expr(src, tk, ts, te, n, pi, err, A_src, A_s, A_e, A_cnt, TVsrc, TV_s, TV_e, TV_cnt)
      if cf == 1:
        ecsub = 1
      if pi[0] == cpm:
        pi[0] = pi[0] + 1
      cg = cg + 1
    if accept_k(tk, n, pi, err, 55) == 1:
      var crsub: int = ts_type_expr(src, tk, ts, te, n, pi, err, A_src, A_s, A_e, A_cnt, TVsrc, TV_s, TV_e, TV_cnt)
      if crsub == 1:
        ecsub = 1
    if cur_kind(tk, n, pi, err) == 52:
      pi[0] = pi[0] + 1
    err[0] = esv
    return ecsub
  if cur_kind(tk, n, pi, err) == 49:
    ts_skip_group(tk, n, pi, err)
  if cur_kind(tk, n, pi, err) == 51:
    ts_skip_group(tk, n, pi, err)
  err[0] = esv
  return 0

def ts_list_args(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], A_src: var array[256, ptr], A_s: var array[256, int], A_e: var array[256, int], A_cnt: var array[1, int], TVsrc: var array[64, ptr], TV_s: var array[64, int], TV_e: var array[64, int], TV_cnt: var array[1, int]) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  # Bracketed builtin-collection args (list/dict/tuple): element type exprs
  # separated by commas; `tuple[name: type, ...]` named-field shape skips the
  # field name + colon first (C++ resolve_builtin_collection resolves the
  # field type exprs). Non-type shapes (`...`) are consumed raw.
  var fired: int = 0
  var g2: int = 0
  while g2 < 2048:
    var kk: int = cur_kind(tk, n, pi, err)
    if kk == 0:
      break
    if kk == 52:
      pi[0] = pi[0] + 1
      break
    var pmark: int = pi[0]
    var wasfield: int = 0
    if kk == 4:
      if peek_off(tk, n, pi, 1) == 56:
        pi[0] = pi[0] + 2
        var sf: int = ts_type_expr(src, tk, ts, te, n, pi, err, A_src, A_s, A_e, A_cnt, TVsrc, TV_s, TV_e, TV_cnt)
        if sf == 1:
          fired = 1
        wasfield = 1
    if wasfield == 0:
      var sa: int = ts_type_expr(src, tk, ts, te, n, pi, err, A_src, A_s, A_e, A_cnt, TVsrc, TV_s, TV_e, TV_cnt)
      if sa == 1:
        fired = 1
    if pi[0] == pmark:
      pi[0] = pi[0] + 1
    if cur_kind(tk, n, pi, err) == 55:
      pi[0] = pi[0] + 1
    g2 = g2 + 1
  return fired

def ts_def_head(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], A_src: var array[256, ptr], A_s: var array[256, int], A_e: var array[256, int], A_cnt: var array[1, int], TVsrc: var array[64, ptr], TV_s: var array[64, int], TV_e: var array[64, int], TV_cnt: var array[1, int], checks: int, stop58: int) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  # One proc head: capture `[T, ...]` type vars (type_vars cleared per
  # check_proc), split the param list on top-level commas, consume each
  # param annotation, then the raises tail and the `->` return annotation.
  # checks == 0 mirrors check_proc's extern early return (consume, never
  # fire). stop58 == 1 skips the contract region to the `=` body marker;
  # stop58 == 0 (bodyless extern heads) stops at the next declarative head.
  var esv: int = err[0]
  err[0] = 0
  var fired: int = 0
  var fired_ret: int = 0
  TV_cnt[0] = 0
  pi[0] = pi[0] + 1
  if cur_kind(tk, n, pi, err) != 4:
    err[0] = esv
    return 0
  pi[0] = pi[0] + 1
  var gguard: int = 0
  if cur_kind(tk, n, pi, err) == 51:
    pi[0] = pi[0] + 1
    while gguard < 64:
      var kg: int = cur_kind(tk, n, pi, err)
      if kg == 0:
        break
      if kg == 52:
        pi[0] = pi[0] + 1
        break
      if kg == 56:
        pi[0] = pi[0] + 1
        var gg2: int = 0
        while gg2 < 64:
          var kg2: int = cur_kind(tk, n, pi, err)
          if kg2 == 0:
            break
          if kg2 == 55:
            break
          if kg2 == 52:
            break
          pi[0] = pi[0] + 1
          gg2 = gg2 + 1
        gguard = gguard + 1
        continue
      if kg == 4:
        if TV_cnt[0] < 64:
          TVsrc[TV_cnt[0]] = src
          TV_s[TV_cnt[0]] = peek_tk(ts, pi[0])
          TV_e[TV_cnt[0]] = peek_tk(te, pi[0])
          TV_cnt[0] = TV_cnt[0] + 1
      pi[0] = pi[0] + 1
      gguard = gguard + 1
  if cur_kind(tk, n, pi, err) != 49:
    err[0] = esv
    return fired
  var pa: int = pi[0] + 1
  var depth: int = 1
  var guardp: int = 0
  pi[0] = pa
  var pend: int = pa
  while guardp < 65536:
    var kp: int = cur_kind(tk, n, pi, err)
    if kp == 0:
      break
    pi[0] = pi[0] + 1
    if kp == 49:
      depth = depth + 1
    if kp == 50:
      depth = depth - 1
      if depth == 0:
        pend = pi[0] - 1
        break
    guardp = guardp + 1
  var pb: array[130, int]
  var pb_n: int = 0
  var si: int = pa
  var sdepth: int = 0
  while si < pend:
    var sk: int = peek_tk(tk, si)
    if sk == 51:
      sdepth = sdepth + 1
    if sk == 52:
      sdepth = sdepth - 1
    if sdepth == 0:
      if sk == 55:
        if pb_n < 129:
          pb[pb_n] = si
          pb_n = pb_n + 1
    si = si + 1
  if pb_n < 130:
    pb[pb_n] = pend
    pb_n = pb_n + 1
  var seg_a: int = pa
  var pkk: int = 0
  while pkk < pb_n:
    var seg_z: int = pb[pkk]
    if seg_a < seg_z:
      if peek_tk(tk, seg_a) == 4:
        if peek_tk(tk, seg_a + 1) == 56:
          var tpos: int = seg_a + 2
          if peek_tk(tk, tpos) == 20:
            tpos = tpos + 1
          if tpos < seg_z:
            var epi: array[1, int]
            epi[0] = tpos
            var sub: int = ts_type_expr(src, tk, ts, te, n, epi, err, A_src, A_s, A_e, A_cnt, TVsrc, TV_s, TV_e, TV_cnt)
            if checks == 1:
              if sub == 1:
                fired = 1
            tpos = epi[0]
            while tpos < seg_z:
              var dk: int = peek_tk(tk, tpos)
              if dk == 55:
                break
              if dk == 50:
                break
              tpos = tpos + 1
    seg_a = seg_z + 1
    pkk = pkk + 1
  pi[0] = pend + 1
  var skguard: int = 0
  while skguard < 4096:
    var rk: int = cur_kind(tk, n, pi, err)
    if rk == 0:
      break
    if rk == 57:
      break
    if rk == 10:
      break
    if rk == 11:
      break
    if rk == 19:
      break
    if rk == 18:
      break
    pi[0] = pi[0] + 1
    skguard = skguard + 1
  if cur_kind(tk, n, pi, err) == 57:
    pi[0] = pi[0] + 1
    var sr: int = ts_type_expr(src, tk, ts, te, n, pi, err, A_src, A_s, A_e, A_cnt, TVsrc, TV_s, TV_e, TV_cnt)
    if checks == 1:
      if sr == 1:
        fired_ret = 2
  var skipguard: int = 0
  while skipguard < 65536:
    var pk: int = cur_kind(tk, n, pi, err)
    if pk == 0:
      break
    if stop58 == 1:
      if pk == 58:
        pi[0] = pi[0] + 1
        break
    if pk == 10:
      break
    if pk == 11:
      break
    if pk == 19:
      break
    if pk == 18:
      break
    pi[0] = pi[0] + 1
    skipguard = skipguard + 1
  err[0] = esv
  return fired + fired_ret

def mir_type_space_check(root: ptr, src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], err: var array[1, int]) raises IO -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  # ---- merged alias space: own `type`/`enum` heads + ALL type heads of
  # ---- transitively resolved imports (merge_module has no type filter).
  var A_src: array[256, ptr]
  var A_s: array[256, int]
  var A_e: array[256, int]
  var A_cnt: array[1, int]
  A_cnt[0] = 0
  var TVsrc: array[64, ptr]
  var TV_s: array[64, int]
  var TV_e: array[64, int]
  var TV_cnt: array[1, int]
  TV_cnt[0] = 0
  var ai: int = 0
  while ai + 1 < n[0]:
    var ak: int = peek_tk(tk, ai)
    if ak == 11:
      if peek_tk(tk, ai + 1) == 4:
        if A_cnt[0] < 256:
          A_src[A_cnt[0]] = src
          A_s[A_cnt[0]] = peek_tk(ts, ai + 1)
          A_e[A_cnt[0]] = peek_tk(te, ai + 1)
          A_cnt[0] = A_cnt[0] + 1
    if ak == 19:
      if peek_tk(tk, ai + 1) == 4:
        if A_cnt[0] < 256:
          A_src[A_cnt[0]] = src
          A_s[A_cnt[0]] = peek_tk(ts, ai + 1)
          A_e[A_cnt[0]] = peek_tk(te, ai + 1)
          A_cnt[0] = A_cnt[0] + 1
    ai = ai + 1
  # ---- transitive import DFS (fx_import_merge-shaped; clobber + re-lex
  # ---- restores the root stream) over scratch-lexed module sources.
  var qc: array[64, ptr]
  var qp: array[64, ptr]
  var qn: int = 0
  var seen_p: array[64, ptr]
  var seen_n: int = 0
  var bail: int = 0
  var ii: int = 0
  while ii < n[0]:
    if peek_tk(tk, ii) == 18:
      var ntok: int = ii + 1
      if ntok < n[0]:
        if peek_tk(tk, ntok) == 4:
          var im_end: int = ntok
          var im_guard: int = 0
          while im_guard < 8:
            if im_end + 2 < n[0]:
              if peek_tk(tk, im_end + 1) == 72:
                if peek_tk(tk, im_end + 2) == 4:
                  im_end = im_end + 2
                  im_guard = im_guard + 1
                  continue
            break
          var mlen: int = peek_tk(te, im_end) - peek_tk(ts, ntok)
          var mname: ptr = bytes_slice_i(src, peek_tk(ts, ntok), mlen)
          var imp: ptr = li_rt_resolve_import(root, mname)
          if imp == 0:
            bail = 1
          if imp != 0:
            if qn < 64:
              qc[qn] = imp
              qp[qn] = li_rt_import_path_dup(li_rt_resolve_import_last_path())
              qn = qn + 1
    ii = ii + 1
  while qn > 0:
    qn = qn - 1
    var pop_c: ptr = qc[qn]
    var pop_p: ptr = qp[qn]
    var dup: int = 0
    var jj: int = 0
    while jj < seen_n:
      if seen_p[jj] != 0:
        if li_rt_str_eq(seen_p[jj], pop_p) == 1:
          dup = 1
      jj = jj + 1
    if dup == 0:
      if seen_n < 64:
        seen_p[seen_n] = pop_p
        seen_n = seen_n + 1
      n[0] = 0
      if lex_source(pop_c, tk, ts, te, n, 0) == 1:
        bail = 1
      var mi: int = 0
      while mi < n[0]:
        var mk: int = peek_tk(tk, mi)
        if mk == 11:
          if mi + 1 < n[0]:
            if peek_tk(tk, mi + 1) == 4:
              if A_cnt[0] < 256:
                A_src[A_cnt[0]] = pop_c
                A_s[A_cnt[0]] = peek_tk(ts, mi + 1)
                A_e[A_cnt[0]] = peek_tk(te, mi + 1)
                A_cnt[0] = A_cnt[0] + 1
        if mk == 19:
          if mi + 1 < n[0]:
            if peek_tk(tk, mi + 1) == 4:
              if A_cnt[0] < 256:
                A_src[A_cnt[0]] = pop_c
                A_s[A_cnt[0]] = peek_tk(ts, mi + 1)
                A_e[A_cnt[0]] = peek_tk(te, mi + 1)
                A_cnt[0] = A_cnt[0] + 1
        if mk == 18:
          var ntok2: int = mi + 1
          if ntok2 < n[0]:
            if peek_tk(tk, ntok2) == 4:
              var im_end2: int = ntok2
              var im_guard2: int = 0
              while im_guard2 < 8:
                if im_end2 + 2 < n[0]:
                  if peek_tk(tk, im_end2 + 1) == 72:
                    if peek_tk(tk, im_end2 + 2) == 4:
                      im_end2 = im_end2 + 2
                      im_guard2 = im_guard2 + 1
                      continue
                break
              var mlen2: int = peek_tk(te, im_end2) - peek_tk(ts, ntok2)
              var mname2: ptr = bytes_slice_i(pop_c, peek_tk(ts, ntok2), mlen2)
              var imp2: ptr = li_rt_resolve_import(pop_p, mname2)
              if imp2 == 0:
                bail = 1
              if imp2 != 0:
                if qn < 64:
                  qc[qn] = imp2
                  qp[qn] = li_rt_import_path_dup(li_rt_resolve_import_last_path())
                  qn = qn + 1
        mi = mi + 1
  n[0] = 0
  if lex_source(src, tk, ts, te, n, 0) == 1:
    return 0
  if bail == 1:
    return 0
  # ---- annotation scan over the restored main-module stream.
  var fired: int = 0
  var i: int = 0
  var handled: array[1, int]
  while i < n[0]:
    if fired == 1:
      break
    var kk: int = peek_tk(tk, i)
    handled[0] = 0
    if kk == 11:
      # Alias head: C++ keeps trait/object/enum inner defs out of
      # module.procs (register-only), so the walker never typechecks their
      # bodies — `type Hash = trait` containing `def hash(self: Self)` would
      # otherwise reject on `Self`. Skip the whole head+body.
      handled[0] = 1
      var apos: array[1, int]
      var aerr: array[1, int]
      apos[0] = i
      aerr[0] = 0
      ts_alias_skip(tk, n, apos, aerr)
      i = apos[0]
      if apos[0] <= i:
        i = i + 1
    if kk == 10:
      var dpos: array[1, int]
      var derr: array[1, int]
      dpos[0] = i
      derr[0] = 0
      var checks: int = 1
      if i > 0:
        if peek_tk(tk, i - 1) == 32:
          checks = 0
      var dsub: int = ts_def_head(src, tk, ts, te, n, dpos, derr, A_src, A_s, A_e, A_cnt, TVsrc, TV_s, TV_e, TV_cnt, checks, 1)
      if derr[0] == 1:
        i = i + 1
      if derr[0] == 1 and dpos[0] <= i:
        dpos[0] = i + 1
      if dsub == 1:
        fired = 2
      if dsub >= 2:
        fired = 4
      if dpos[0] > i:
        i = dpos[0]
      if dpos[0] <= i:
        i = i + 1
    if handled[0] == 0 and (kk == 20 or kk == 21):
      if i + 2 < n[0]:
        if peek_tk(tk, i + 1) == 4:
          if peek_tk(tk, i + 2) == 56:
            var vpos: array[1, int]
            var verr: array[1, int]
            vpos[0] = i + 3
            verr[0] = 0
            var vsub: int = ts_type_expr(src, tk, ts, te, n, vpos, verr, A_src, A_s, A_e, A_cnt, TVsrc, TV_s, TV_e, TV_cnt)
            i = vpos[0]
            if vsub == 1:
              fired = 3
            if vpos[0] <= i:
              i = i + 1
            handled[0] = 1
    if handled[0] == 0:
      i = i + 1
  if fired > 0:
    return 1
  return 0

# Index-safety pass (mirrors C++ typecheck.cpp index rules; closes
# cwe787_oob_index + cwe787_dyn_index):
#   * a constant index must satisfy 0 <= i < (resolved) base array size
#     ("array index out of range");
#   * a bare dynamic ident index is accepted only when the index name is
#     registered as bounded: a loop variable (`for i in 0..<N`,
#     `parallel for i in 0..<N`, `while i < N`) or a refinement-alias-typed
#     param (`i: Idx8` with `type Idx8 = {i | ... i < B}`), and the bound
#     must not exceed the base array size (C++ bounded_index + array_size
#     check; C++ locals are per-proc flat maps, so a loop var stays bounded
#     for the whole proc body, no scope pop).
# Bounded-index-required bases (requires_bounded_index): non-`var` array
# params and non-`var` array-alias params (`g: Grid` with
# `type Grid = array[8, ...]`), resolved by a file-wide token scan.
# Locals and `var`-prefixed bases stay lax, exactly like the C++ host.
# All ident comparisons are by SOURCE TEXT (mir_slice_eq on ts/te spans),
# not by token index: an index occurrence and a loop-var creation site
# always have different token indexes.
def mir_index_check(src: var ptr,  tk: var array[262144, int],  ts: var array[262144, int],  te: var array[262144, int],  n: var array[1, int],  err: var array[1, int],  plist_s: int,  plist_e: int,  body_s: int,  body_e: int) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  # ---- file-wide alias scans ----
  # array aliases:      `type NAME = array N` -> (name token, size)
  # refinement aliases: `type NAME = { ... first < LIT ... }` -> bound
  var an_tok: array[64, int]
  var an_sz: array[64, int]
  var an_n: int = 0
  var rn_tok: array[64, int]
  var rn_bound: array[64, int]
  var rn_n: int = 0
  var ai: int = 0
  while ai + 5 < n[0]:
    if peek_tk(tk, ai) == 11:
      if peek_tk(tk, ai + 1) == 4:
        if peek_tk(tk, ai + 2) == 58:
          if peek_tk(tk, ai + 3) == 4:
            if tok_is(src,  ts,  te,  ai + 3,  "array") == 1:
              if peek_tk(tk, ai + 4) == 51:
                if peek_tk(tk, ai + 5) == 5:
                  if an_n < 64:
                    an_tok[an_n] = ai + 1
                    an_sz[an_n] = int_text_value(src,  ts,  te,  ai + 5)
                    an_n = an_n + 1
    ai = ai + 1
  var rj: int = 0
  while rj + 3 < n[0]:
    if peek_tk(tk, rj) == 11:
      if peek_tk(tk, rj + 1) == 4:
        if peek_tk(tk, rj + 2) == 58:
          if peek_tk(tk, rj + 3) == 53:
            var kb: int = rj + 4
            var kf_found: int = 0
            var kf_bound: int = 0
            var kguard: int = 0
            while kb < n[0]:
              if kf_found == 1:
                break
              if peek_tk(tk, kb) == 54:
                break
              if kguard >= 96:
                break
              if peek_tk(tk, kb) == 67:
                if peek_tk(tk, kb + 1) == 5:
                  kf_bound = int_text_value(src,  ts,  te,  kb + 1)
                  kf_found = 1
              kguard = kguard + 1
              kb = kb + 1
            if kf_found == 1:
              if rn_n < 64:
                rn_tok[rn_n] = rj + 1
                rn_bound[rn_n] = kf_bound
                rn_n = rn_n + 1
    rj = rj + 1
  # ---- parameter segments: candidates + refinement-bounded index params ----
  var lv_tok: array[64, int]
  var lv_bound: array[64, int]
  var lv_n: int = 0
  var cand_tok: array[64, int]
  var cand_sz: array[64, int]
  var cand_n: int = 0
  # Segment boundaries: kind-55 commas at bracket depth 0, plus the end.
  var pb: array[130, int]
  var pb_n: int = 0
  var si: int = plist_s
  var pdepth: int = 0
  while si < plist_e:
    var sk: int = peek_tk(tk, si)
    if sk == 51:
      pdepth = pdepth + 1
    if sk == 52:
      pdepth = pdepth - 1
    if pdepth == 0:
      if sk == 55:
        if pb_n < 130:
          pb[pb_n] = si
          pb_n = pb_n + 1
    si = si + 1
  if pb_n < 130:
    pb[pb_n] = plist_e
    pb_n = pb_n + 1
  var seg_a: int = plist_s
  var pkk: int = 0
  while pkk < pb_n:
    var seg_z: int = pb[pkk]
    if seg_a < seg_z:
      if peek_tk(tk, seg_a) == 4:
        if seg_a + 2 < n[0]:
          if peek_tk(tk, seg_a + 1) == 56:
            var tpos: int = seg_a + 2
            var ivs: int = 0
            if peek_tk(tk, tpos) == 20:
              ivs = 1
              tpos = tpos + 1
            if tpos < seg_z:
              if peek_tk(tk, tpos) == 4:
                var atok: int = tpos
                var atyp: int = 0
                if tok_is(src,  ts,  te,  atok,  "array") == 1:
                  atyp = 1
                  if tpos + 2 < seg_z:
                    if peek_tk(tk, tpos + 1) == 51:
                      if peek_tk(tk, tpos + 2) == 5:
                        if ivs == 0:
                          if cand_n < 64:
                            cand_tok[cand_n] = seg_a
                            cand_sz[cand_n] = int_text_value(src,  ts,  te,  tpos + 2)
                            cand_n = cand_n + 1
                if atyp == 0:
                  var aq: int = 0
                  while aq < an_n:
                    if mir_slice_eq(src,  peek_tk(ts, atok),  peek_tk(te, atok),  peek_tk(ts, an_tok[aq]),  peek_tk(te, an_tok[aq])) == 1:
                      if ivs == 0:
                        if cand_n < 64:
                          cand_tok[cand_n] = seg_a
                          cand_sz[cand_n] = an_sz[aq]
                          cand_n = cand_n + 1
                    aq = aq + 1
                  var rq: int = 0
                  while rq < rn_n:
                    if mir_slice_eq(src,  peek_tk(ts, atok),  peek_tk(te, atok),  peek_tk(ts, rn_tok[rq]),  peek_tk(te, rn_tok[rq])) == 1:
                      if lv_n < 64:
                        lv_tok[lv_n] = seg_a
                        lv_bound[lv_n] = rn_bound[rq]
                        lv_n = lv_n + 1
                    rq = rq + 1
    seg_a = seg_z + 1
    pkk = pkk + 1
  # ---- loop variables over the body range ----
  var bi: int = body_s
  while bi < body_e:
    var bkind: int = peek_tk(tk, bi)
    if bkind == 26:
      var vtok: int = bi + 1
      if vtok < body_e:
        if peek_tk(tk, vtok) == 4:
          if tok_is(src,  ts,  te,  vtok,  "in") == 0:
            if vtok + 4 < n[0]:
              if tok_is(src,  ts,  te,  vtok + 1,  "in") == 1:
                if peek_tk(tk, vtok + 2) == 5:
                  var rng: int = vtok + 3
                  if peek_tk(tk, rng) == 73:
                    if peek_tk(tk, rng + 1) == 5:
                      if lv_n < 64:
                        lv_tok[lv_n] = vtok
                        lv_bound[lv_n] = int_text_value(src,  ts,  te,  rng + 1)
                        lv_n = lv_n + 1
                  if peek_tk(tk, rng) == 74:
                    if peek_tk(tk, rng + 1) == 5:
                      if lv_n < 64:
                        lv_tok[lv_n] = vtok
                        lv_bound[lv_n] = int_text_value(src,  ts,  te,  rng + 1)
                        lv_n = lv_n + 1
    if bkind == 25:
      if bi + 3 < body_e:
        if peek_tk(tk, bi + 1) == 4:
          if peek_tk(tk, bi + 2) == 67:
            if peek_tk(tk, bi + 3) == 5:
              if lv_n < 64:
                lv_tok[lv_n] = bi + 1
                lv_bound[lv_n] = int_text_value(src,  ts,  te,  bi + 3)
                lv_n = lv_n + 1
    bi = bi + 1
  # ---- index events over the body range ----
  # The [ must be closed by ] immediately after the index token: C++ rules
  # only on Expr Index with an Ident index; `a[f(...)]` (call as index) is
  # a different Expr kind and is folded by the prover, not rejected here.
  var ei: int = body_s
  while ei < body_e:
    if peek_tk(tk, ei) == 4:
      var ck: int = 0
      var hit: int = 0
      var hsz: int = 0
      while ck < cand_n:
        if mir_slice_eq(src,  peek_tk(ts, ei),  peek_tk(te, ei),  peek_tk(ts, cand_tok[ck]),  peek_tk(te, cand_tok[ck])) == 1:
          hit = 1
          hsz = cand_sz[ck]
        ck = ck + 1
      if hit == 1:
        if ei + 3 < n[0]:
          if peek_tk(tk, ei + 1) == 51:
            if peek_tk(tk, ei + 3) == 52:
              if peek_tk(tk, ei + 2) == 5:
                var ival: int = int_text_value(src,  ts,  te,  ei + 2)
                if hsz > 0:
                  if ival >= hsz:
                    err[0] = 1
                    return 1
              if peek_tk(tk, ei + 2) == 4:
                if tok_is(src,  ts,  te,  ei + 2,  "in") == 0:
                  var lv2: int = 0
                  var lhit: int = 0
                  var lbound: int = 0
                  while lv2 < lv_n:
                    if mir_slice_eq(src,  peek_tk(ts, ei + 2),  peek_tk(te, ei + 2),  peek_tk(ts, lv_tok[lv2]),  peek_tk(te, lv_tok[lv2])) == 1:
                      lhit = 1
                      lbound = lv_bound[lv2]
                    lv2 = lv2 + 1
                  if lhit == 0:
                    err[0] = 1
                    return 1
                  if hsz > 0:
                    if lbound > hsz:
                      err[0] = 1
                      return 1
    ei = ei + 1
  return 0

# Int/float width-mixing mirror (C++ typecheck.cpp BinOp width rule,
# "cannot mix int widths without explicit cast"): arithmetic binops
# (+ - * / // % **) over two same-family but different-width scalars
# reject on the mir lane. Width classes follow the C++ TyKinds, where
# plain `int` (Int), `int32` (Int32) and `int64` (Int64) are three
# DISTINCT kinds with no implicit widening; fixed-width float sizes too
# (Float =10 plain/f64/float64, Float32 =11, Float8 =12). Numeric
# literals classify as Int (0) / Float (10). Unregistered idents (call
# results, arrays, ptrs) carry class -1 and never fire. The host runs
# this predicate on every `lic mir`, so a file it accepts cannot trip
# here. Locals also register via their `var NAME: TYPE` declarations;
# widths do not leak across procs.
def mir_width_check(src: var ptr,  tk: var array[262144, int],  ts: var array[262144, int],  te: var array[262144, int],  n: var array[1, int],  err: var array[1, int],  plist_s: int,  plist_e: int,  body_s: int,  body_e: int) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  var wt_tok: array[96, int]
  var wt_cls: array[96, int]
  var wt_n: int = 0
  # ---- parameter segments (same splitter shape as mir_index_check) ----
  var pb: array[130, int]
  var pb_n: int = 0
  var si: int = plist_s
  var pdepth: int = 0
  while si < plist_e:
    var sk: int = peek_tk(tk, si)
    if sk == 51:
      pdepth = pdepth + 1
    if sk == 52:
      pdepth = pdepth - 1
    if pdepth == 0:
      if sk == 55:
        if pb_n < 130:
          pb[pb_n] = si
          pb_n = pb_n + 1
    si = si + 1
  if pb_n < 130:
    pb[pb_n] = plist_e
    pb_n = pb_n + 1
  var seg_a: int = plist_s
  var pkk: int = 0
  while pkk < pb_n:
    var seg_z: int = pb[pkk]
    if seg_a < seg_z:
      if peek_tk(tk, seg_a) == 4:
        if seg_a + 2 < n[0]:
          if peek_tk(tk, seg_a + 1) == 56:
            var tpos: int = seg_a + 2
            var ivs: int = 0
            if peek_tk(tk, tpos) == 20:
              ivs = 1
              tpos = tpos + 1
            if ivs == 0:
              if peek_tk(tk, tpos) == 4:
                if tpos < n[0]:
                  var wcls2: int = -1
                  if tok_is(src,  ts,  te,  tpos,  "int") == 1:
                    wcls2 = 0
                  if tok_is(src,  ts,  te,  tpos,  "int32") == 1:
                    wcls2 = 1
                  if tok_is(src,  ts,  te,  tpos,  "i32") == 1:
                    wcls2 = 1
                  if tok_is(src,  ts,  te,  tpos,  "Int32") == 1:
                    wcls2 = 1
                  if tok_is(src,  ts,  te,  tpos,  "int64") == 1:
                    wcls2 = 2
                  if tok_is(src,  ts,  te,  tpos,  "i64") == 1:
                    wcls2 = 2
                  if tok_is(src,  ts,  te,  tpos,  "Int64") == 1:
                    wcls2 = 2
                  if tok_is(src,  ts,  te,  tpos,  "long") == 1:
                    wcls2 = 2
                  if tok_is(src,  ts,  te,  tpos,  "uint8") == 1:
                    wcls2 = 3
                  if tok_is(src,  ts,  te,  tpos,  "u8") == 1:
                    wcls2 = 3
                  if tok_is(src,  ts,  te,  tpos,  "float") == 1:
                    wcls2 = 10
                  if tok_is(src,  ts,  te,  tpos,  "f64") == 1:
                    wcls2 = 10
                  if tok_is(src,  ts,  te,  tpos,  "float64") == 1:
                    wcls2 = 10
                  if tok_is(src,  ts,  te,  tpos,  "float32") == 1:
                    wcls2 = 11
                  if tok_is(src,  ts,  te,  tpos,  "f32") == 1:
                    wcls2 = 11
                  if tok_is(src,  ts,  te,  tpos,  "float8") == 1:
                    wcls2 = 12
                  if tok_is(src,  ts,  te,  tpos,  "f8") == 1:
                    wcls2 = 12
                  if wcls2 >= 0:
                    if wt_n < 96:
                      wt_tok[wt_n] = seg_a
                      wt_cls[wt_n] = wcls2
                      wt_n = wt_n + 1
    seg_a = seg_z + 1
    pkk = pkk + 1
  # ---- local var decls in the body: `var NAME: width-type ...` ----
  var li2: int = body_s
  while li2 < body_e:
    if peek_tk(tk, li2) == 20:
      if li2 + 3 < n[0]:
        if peek_tk(tk, li2 + 1) == 4:
          if peek_tk(tk, li2 + 2) == 56:
            var ltok: int = li2 + 3
            if peek_tk(tk, ltok) == 4:
              var wcls3: int = -1
              if tok_is(src,  ts,  te,  ltok,  "int") == 1:
                wcls3 = 0
              if tok_is(src,  ts,  te,  ltok,  "int32") == 1:
                wcls3 = 1
              if tok_is(src,  ts,  te,  ltok,  "i32") == 1:
                wcls3 = 1
              if tok_is(src,  ts,  te,  ltok,  "Int32") == 1:
                wcls3 = 1
              if tok_is(src,  ts,  te,  ltok,  "int64") == 1:
                wcls3 = 2
              if tok_is(src,  ts,  te,  ltok,  "i64") == 1:
                wcls3 = 2
              if tok_is(src,  ts,  te,  ltok,  "Int64") == 1:
                wcls3 = 2
              if tok_is(src,  ts,  te,  ltok,  "long") == 1:
                wcls3 = 2
              if tok_is(src,  ts,  te,  ltok,  "uint8") == 1:
                wcls3 = 3
              if tok_is(src,  ts,  te,  ltok,  "u8") == 1:
                wcls3 = 3
              if tok_is(src,  ts,  te,  ltok,  "float") == 1:
                wcls3 = 10
              if tok_is(src,  ts,  te,  ltok,  "f64") == 1:
                wcls3 = 10
              if tok_is(src,  ts,  te,  ltok,  "float64") == 1:
                wcls3 = 10
              if tok_is(src,  ts,  te,  ltok,  "float32") == 1:
                wcls3 = 11
              if tok_is(src,  ts,  te,  ltok,  "f32") == 1:
                wcls3 = 11
              if tok_is(src,  ts,  te,  ltok,  "float8") == 1:
                wcls3 = 12
              if tok_is(src,  ts,  te,  ltok,  "f8") == 1:
                wcls3 = 12
              if wcls3 >= 0:
                if wt_n < 96:
                  wt_tok[wt_n] = li2 + 1
                  wt_cls[wt_n] = wcls3
                  wt_n = wt_n + 1
    li2 = li2 + 1
  # ---- arithmetic-binop events over the body range ----
  var ei2: int = body_s
  while ei2 < body_e:
    if peek_tk(tk, ei2) == 4:
      var okop: int = 0
      var opk: int = peek_tk(tk, ei2 + 1)
      if opk == 59:
        okop = 1
      if opk == 60:
        okop = 1
      if opk == 61:
        okop = 1
      if opk == 62:
        okop = 1
      if opk == 63:
        okop = 1
      if opk == 64:
        okop = 1
      if opk == 65:
        okop = 1
      if okop == 1:
        if ei2 + 2 < n[0]:
          var rcls: int = -1
          var lcls: int = -1
          var wl3: int = 0
          while wl3 < wt_n:
            if mir_slice_eq(src,  peek_tk(ts, ei2),  peek_tk(te, ei2),  peek_tk(ts, wt_tok[wl3]),  peek_tk(te, wt_tok[wl3])) == 1:
              lcls = wt_cls[wl3]
            if mir_slice_eq(src,  peek_tk(ts, ei2 + 2),  peek_tk(te, ei2 + 2),  peek_tk(ts, wt_tok[wl3]),  peek_tk(te, wt_tok[wl3])) == 1:
              rcls = wt_cls[wl3]
            wl3 = wl3 + 1
          if peek_tk(tk, ei2 + 2) == 5:
            rcls = 0
          if peek_tk(tk, ei2 + 2) == 6:
            rcls = 10
          if lcls >= 0:
            if rcls >= 0:
              var lint: int = 0
              var rint: int = 0
              if lcls <= 3:
                lint = 1
              if rcls <= 3:
                rint = 1
              if lint == 1:
                if rint == 1:
                  if lcls != rcls:
                    err[0] = 1
                    return 1
              var lflt: int = 0
              var rflt: int = 0
              if lcls >= 10:
                lflt = 1
              if rcls >= 10:
                rflt = 1
              if lflt == 1:
                if rflt == 1:
                  if lcls != rcls:
                    err[0] = 1
                    return 1
    ei2 = ei2 + 1
  return 0

# Generic-return resolution mirror (C++ typecheck.cpp check_proc top-level
# return rule, "return type mismatch for generic type parameter"): a
# top-level `return <bare ident>` whose binder is generic-typed (param
# `x: T` or local `var y: T`, T = a declared type parameter) rejects when
# the declared return type is CONCRETE: the host resolves the returned
# ident to TypeVar T and TypeVar only matches a same-name TypeVar return
# via assignable. `-> T` self-typed generics stay accepted. Token mirror:
# type-param names from the header `[T, ...]`, generic-typed binders from
# the param segments + `var NAME: GNAME` decls, the return type from the
# first `->` before the body, and top-level body depth from
# INDENT/DEDENT counting (C++ checks only p.body statements, not nested
# ones).
def mir_generic_ret_check(src: var ptr,  tk: var array[262144, int],  ts: var array[262144, int],  te: var array[262144, int],  n: var array[1, int],  err: var array[1, int],  ptp_s: int,  ptp_e: int,  plist_s: int,  plist_e: int,  head_e: int,  body_s: int,  body_e: int) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  var gnames: array[8, int]
  var g_n: int = 0
  var gi: int = ptp_s
  while gi < ptp_e:
    if peek_tk(tk, gi) == 4:
      if g_n < 8:
        gnames[g_n] = gi
        g_n = g_n + 1
    gi = gi + 1
  if g_n == 0:
    return 0
  var btok: array[16, int]
  var b_n: int = 0
  # ---- generic-typed params: `NAME : [var] GNAME` in the param list ----
  var pb: array[130, int]
  var pb_n: int = 0
  var si: int = plist_s
  var pdepth: int = 0
  while si < plist_e:
    var sk: int = peek_tk(tk, si)
    if sk == 51:
      pdepth = pdepth + 1
    if sk == 52:
      pdepth = pdepth - 1
    if pdepth == 0:
      if sk == 55:
        if pb_n < 130:
          pb[pb_n] = si
          pb_n = pb_n + 1
    si = si + 1
  if pb_n < 130:
    pb[pb_n] = plist_e
    pb_n = pb_n + 1
  var seg_a: int = plist_s
  var pkk: int = 0
  while pkk < pb_n:
    var seg_z: int = pb[pkk]
    if seg_a < seg_z:
      if peek_tk(tk, seg_a) == 4:
        if seg_a + 1 < n[0]:
          if peek_tk(tk, seg_a + 1) == 56:
            var tpos: int = seg_a + 2
            if peek_tk(tk, tpos) == 20:
              tpos = tpos + 1
            if tpos < seg_z:
              if peek_tk(tk, tpos) == 4:
                var qg: int = 0
                while qg < g_n:
                  if mir_slice_eq(src,  peek_tk(ts, tpos),  peek_tk(te, tpos),  peek_tk(ts, gnames[qg]),  peek_tk(te, gnames[qg])) == 1:
                    if b_n < 16:
                      btok[b_n] = seg_a
                      b_n = b_n + 1
                  qg = qg + 1
    seg_a = seg_z + 1
    pkk = pkk + 1
  # ---- generic-typed locals: `var NAME: GNAME ...` in the body ----
  var li3: int = body_s
  while li3 < body_e:
    if peek_tk(tk, li3) == 20:
      if li3 + 3 < n[0]:
        if peek_tk(tk, li3 + 1) == 4:
          if peek_tk(tk, li3 + 2) == 56:
            if peek_tk(tk, li3 + 3) == 4:
              var qg2: int = 0
              while qg2 < g_n:
                if mir_slice_eq(src,  peek_tk(ts, li3 + 3),  peek_tk(te, li3 + 3),  peek_tk(ts, gnames[qg2]),  peek_tk(te, gnames[qg2])) == 1:
                  if b_n < 16:
                    btok[b_n] = li3 + 1
                    b_n = b_n + 1
                qg2 = qg2 + 1
    li3 = li3 + 1
  # ---- return type token (first `->` after the param span) ----
  var rtok: int = -1
  var rj: int = ptp_e
  while rj < head_e:
    if peek_tk(tk, rj) == 57:
      var cand: int = rj + 1
      if cand < head_e:
        if peek_tk(tk, cand) == 20:
          cand = cand + 1
        if cand < head_e:
          if peek_tk(tk, cand) == 4:
            rtok = cand
      break
    rj = rj + 1
  if rtok == -1:
    return 0
  var r_is_generic: int = 0
  var gk: int = 0
  while gk < g_n:
    if mir_slice_eq(src,  peek_tk(ts, rtok),  peek_tk(te, rtok),  peek_tk(ts, gnames[gk]),  peek_tk(te, gnames[gk])) == 1:
      r_is_generic = 1
    gk = gk + 1
  if r_is_generic == 1:
    return 0
  # ---- top-level bare returns of a generic-typed binder ----
  var depth: int = 0
  var rj2: int = body_s
  while rj2 < body_e:
    var rk: int = peek_tk(tk, rj2)
    if rk == 2:
      depth = depth + 1
    if rk == 3:
      depth = depth - 1
    if depth == 1:
      if rk == 30:
        var rn: int = rj2 + 1
        var rguard: int = 0
        while rn < body_e:
          if rguard >= 4:
            break
          var rk2: int = peek_tk(tk, rn)
          if rk2 == 1 or rk2 == 2 or rk2 == 3:
            rn = rn + 1
            rguard = rguard + 1
          else:
            break
        if rn < body_e:
          if peek_tk(tk, rn) == 4:
            var bk: int = 0
            while bk < b_n:
              if mir_slice_eq(src,  peek_tk(ts, rn),  peek_tk(te, rn),  peek_tk(ts, btok[bk]),  peek_tk(te, btok[bk])) == 1:
                err[0] = 1
                return 1
              bk = bk + 1
    rj2 = rj2 + 1
  return 0

def mir_proc(src: var ptr,  tk: var array[262144, int],  ts: var array[262144, int], te: var array[262144, int],  n: var array[1, int],  pi: var array[1, int], err: var array[1, int],  is_extern: int,  pid: int, tc: var array[1, int],  lastop: var array[1, int], ftok: var array[4096, int],  nft: var array[1, int], ftmp: var array[32768, int],  itok: var array[4096, int],  nit: var array[1, int], itmp: var array[4096, int],  fatok: var array[512, int],  nfa: var array[1, int], matok: var array[512, int],  nmat: var array[1, int], ptok: var array[128, int],  pex: var array[128, int], pp0: var array[128, int],  ppn: var array[128, int],  pret: var array[128, int],  pn: var array[1, int], ptok2: var array[512, int],  pty: var array[512, int], pelems: var array[512, int],  pef: var array[512, int], pei: var array[512, int],  pvar: var array[512, int], pmx: var array[512, int],  pmc: var array[512, int]) raises IO -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  # Float/i64/float-array name tables are per-proc (the C++ lowering uses a
  # fresh float_names / i64_locals / float_array_names set per proc). Temp
  # flag tables (ftmp/itmp) stay global because temp counters are global.
  nft[0] = 0
  nit[0] = 0
  nfa[0] = 0
  nmat[0] = 0
  set512(fatok, 62, 0)
  set512(fatok, 63, 0)
  # Object-var registry is per-proc too: C++ clears g_object_vars per proc
  # (lower.cpp), so a name reused across procs must resolve to THIS proc's
  # object vars only. Params re-register below; locals re-register at their
  # declarations. Without the reset, `return n` in a later proc matched an
  # unrelated object var from an earlier proc and emitted a bogus
  # ReturnObject + OBJ layout.
  mir_reg_set(lr_n_var(), 0)
  if is_extern == 0:
    if cur_kind(tk,  n,  pi,  err) == 16:
      pi[0] = pi[0] + 1
    else:
      if cur_kind(tk,  n,  pi,  err) == 17:
        pi[0] = pi[0] + 1
    if cur_kind(tk,  n,  pi,  err) == 10:
      pi[0] = pi[0] + 1
    else:
      err[0] = 1
      return 1
  var pname: int = pi[0]
  pi[0] = pi[0] + 1
  var ptp_s: int = pi[0]
  parse_type_params(src,  tk,  ts,  te,  n,  pi,  err, 0, 1)
  var ptp_e: int = pi[0]
  expect_k(tk,  n,  pi,  err, 49)
  skip_param_layout(tk,  n,  pi,  err)
  var plist_s: int = pi[0]
  if cur_kind(tk,  n,  pi,  err) != 50:
    var done: int = 0
    while done == 0:
      skip_param_layout(tk,  n,  pi,  err)
      pi[0] = pi[0] + 1
      expect_k(tk,  n,  pi,  err, 56)
      var ti: array[6, int]
      if mir_type_info(src,  tk,  ts,  te,  n,  pi,  err,  ti) == 1:
        return 1
      skip_param_layout(tk,  n,  pi,  err)
      if accept_k(tk,  n,  pi,  err, 55) == 1:
        done = 0
      else:
        done = 1
  skip_param_layout(tk,  n,  pi,  err)
  var plist_e: int = pi[0]
  expect_k(tk,  n,  pi,  err, 50)
  skip_newlines(tk,  n,  pi,  err)
  mir_skip_raises(tk,  n,  pi,  err)
  skip_newlines(tk,  n,  pi,  err)
  var rt_tok2: int = -1
  if accept_k(tk,  n,  pi,  err, 57) == 1:
    var rk3: int = cur_kind(tk,  n,  pi,  err)
    if rk3 == 4 or rk3 == 47 or rk3 == 48:
      rt_tok2 = pi[0]
    var ti2: array[6, int]
    if mir_type_info(src,  tk,  ts,  te,  n,  pi,  err,  ti2) == 1:
      return 1
  skip_newlines(tk,  n,  pi,  err)
  mir_skip_raises(tk,  n,  pi,  err)
  skip_newlines(tk,  n,  pi,  err)
  mir_skip_contracts(src,  tk,  ts,  te,  n,  pi,  err)
  var ret: int = li_rt_preg_get(4, pid)
  var retf: int = 0
  var reti64: int = 0
  var retvoid: int = 0
  var retobj: int = 0
  var ret_obj_ti: int = -1
  if ret == 2:
    retf = 1
  if ret == 3 or ret == 4:
    reti64 = 1
  if ret == 0:
    retvoid = 1
  if ret == 8:
    # No `-> type` clause. C++ sets returns_void=false for non-extern procs
    # with no return type; extern procs without a return type are void.
    if is_extern == 1:
      retvoid = 1
  if ret == 6:
    if rt_tok2 >= 0:
      ret_obj_ti = mir_obj_find_type(src, ts, te, itmp, peek_tk(ts, rt_tok2 + 0), peek_tk(te, rt_tok2 + 0))
      if ret_obj_ti >= 0:
        retobj = 1
  set32768(ftmp, 4090, pid)
  # Hold-buffer this proc's output: if the body contains `parallel for`, its
  # synthesized __li_par_* function text must replay BEFORE this FN header
  # (C++ push-order parity). Passthrough otherwise.
  li_rt_mir_hold_open()
  mir_fn_line(src,  ts,  te,  li_rt_preg_get(0, pid),  retf,  reti64,  retvoid,  retobj,  is_extern,  peek32768(ftmp, 4092),  peek32768(ftmp, 4091))
  if peek32768(ftmp, 4093) >= 0:
    if peek32768(ftmp, 4088) == 1:
      if peek32768(ftmp, 4086) >= 0:
        mir_dec_line(src, ts, te, peek32768(ftmp, 4086), 0, 0, 0, 0)
      mir_dec_line(src, ts, te, peek32768(ftmp, 4093), 0, 0, 1, peek32768(ftmp, 4087))
    else:
      mir_dec_line(src,  ts,  te,  peek32768(ftmp, 4093),  peek32768(ftmp, 4094),  peek32768(ftmp, 4095),  0,  0)
  var j: int = 0
  while j < li_rt_preg_get(3, pid):
    var pi2: int = li_rt_preg_get(2, pid) + j
    var ptype2: int = li_rt_preg_get(6, pi2)
    var pobj2: int = -1
    if ptype2 == 6:
      pobj2 = li_rt_preg_get(13, pi2)
      if pobj2 < 0:
        var ptype_tok2: int = li_rt_preg_get(12, pi2)
        pobj2 = mir_obj_find_type(src, ts, te, itmp, peek_tk(ts, ptype_tok2 + 0), peek_tk(te, ptype_tok2 + 0))
        # Cross-file repair: the param's type may resolve only after the
        # declaring file's dependency types were collected. Store it back so
        # call-site collectors (which read preg 13 directly) see the layout
        # instead of collapsing whole-object args to plain idents.
        if pobj2 >= 0:
          li_rt_preg_set(13, pi2, pobj2)
    if pobj2 >= 0:
      mir_obj_reg_var(itmp, peek_tk(ts, li_rt_preg_get(5, pi2) + 0), peek_tk(te, li_rt_preg_get(5, pi2) + 0), pobj2)
      var obj_is_var2: int = 0
      var obj_code2: int = li_rt_preg_get(10, pi2)
      if obj_code2 >= 1000:
        obj_is_var2 = (obj_code2 - 1000) % 2
      mir_emit_object_params(src, ts, te, itmp, pobj2, peek_tk(ts, li_rt_preg_get(5, pi2) + 0), peek_tk(te, li_rt_preg_get(5, pi2) + 0), obj_is_var2)
    else:
      if ptype2 == 6:
        # Unknown named types (generic/protocol parameters) are not object
        # layouts; do not leak the encoded type-token through PARAM fields.
        mir_param_line(src, ts, te, li_rt_preg_get(5, pi2), ptype2, 0, 0, 0, 0, 0, 0)
      else:
        mir_param_line(src, ts, te, li_rt_preg_get(5, pi2), ptype2, li_rt_preg_get(7, pi2), li_rt_preg_get(8, pi2), li_rt_preg_get(9, pi2), li_rt_preg_get(10, pi2), li_rt_preg_get(11, pi2), li_rt_preg_get(12, pi2))
    if ptype2 == 1:
      set4096(ftok, nft[0],li_rt_preg_get(5, pi2))
      nft[0] = nft[0] + 1
    else:
      if li_rt_preg_get(6, pi2) == 2 or li_rt_preg_get(6, pi2) == 3 or li_rt_preg_get(6, pi2) == 4:
        set4096(itok, nit[0],li_rt_preg_get(5, pi2))
        nit[0] = nit[0] + 1
      else:
        if li_rt_preg_get(6, pi2) == 5:
          if li_rt_preg_get(8, pi2) == 1:
            set512(fatok, 2 * nfa[0],li_rt_preg_get(5, pi2))
            set512(fatok, 2 * nfa[0] + 1,li_rt_preg_get(7, pi2))
            nfa[0] = nfa[0] + 1
          if li_rt_preg_get(8, pi2) == 0:
            var pnia: int = peek512(fatok, 63)
            set512(fatok, 2 * nfa[0] + 2 * pnia, li_rt_preg_get(5, pi2))
            set512(fatok, 2 * nfa[0] + 2 * pnia + 1, li_rt_preg_get(7, pi2))
            set512(fatok, 63, pnia + 1)
    j = j + 1
  if ret_obj_ti >= 0:
    mir_obj_retparams(src,  ts,  te,  itmp,  ret_obj_ti,  0)
  lastop[0] = -1
  if is_extern == 1:
    skip_newlines(tk,  n,  pi,  err)
    li_rt_mir_hold_flush_close()
    return 0
  expect_k(tk,  n,  pi,  err, 58)
  var is_async_proc: int = peek32768(ftmp, 4091)
  if is_async_proc == 1:
    var fae: array[44, int]
    mir_fdef(fae)
    mir_ins_line(src,  fae,  47,  0,  -1,  lastop)
    var fal: array[44, int]
    mir_fdef(fal)
    mir_ins_line(src,  fal,  48,  0,  -1,  lastop)
  var lhead: array[32, int]
  var lexit: array[32, int]
  var nlp: array[1, int]
  nlp[0] = 0
  var darena: array[65536, int]
  var dasp: array[1, int]
  dasp[0] = 0
  var ics: int = pi[0]
  if mir_stmts(darena,  dasp,  src,  tk,  ts,  te,  n,  pi,  err,  tc,  lastop, ftok,  nft,  ftmp,  itok,  nit,  itmp,  fatok,  nfa, matok,  nmat, ptok,  pex,  pp0,  ppn,  pret,  pn,  ptok2,  pty,  pelems,  pef,  pei,  pvar,  retf,  reti64,  lhead,  lexit,  nlp) == 1:
    li_rt_mir_hold_flush_close()
    return 1
  # Index-safety pass (C++ typecheck index rules) over the walked body
  # range: body lowered fine, so [ics, pi[0]) is the exact token span.
  var icr: int = mir_index_check(src,  tk,  ts,  te,  n,  err,  plist_s,  plist_e,  ics,  pi[0])
  if icr == 1:
    li_rt_mir_hold_flush_close()
    return 1
  # Width-mixing mirror (typecheck.cpp BinOp width rule) over the same span.
  var wcr: int = mir_width_check(src,  tk,  ts,  te,  n,  err,  plist_s,  plist_e,  ics,  pi[0])
  if wcr == 1:
    li_rt_mir_hold_flush_close()
    return 1
  # Generic-return resolution mirror (typecheck.cpp top-level return rule).
  var grc: int = mir_generic_ret_check(src,  tk,  ts,  te,  n,  err,  ptp_s,  ptp_e,  plist_s,  plist_e,  ics,  ics,  pi[0])
  if grc == 1:
    li_rt_mir_hold_flush_close()
    return 1
  if lastop[0] < 0:
    var f0: array[44, int]
    mir_fdef(f0)
    mir_ins_line(src,  f0,  0,  0,  -1,  lastop)
  else:
    if lastop[0] > 4:
      var f0b: array[44, int]
      mir_fdef(f0b)
      mir_ins_line(src,  f0b,  0,  0,  -1,  lastop)
  li_rt_mir_hold_flush_close()
  return 0

def mir_walk(src: var ptr,  tk: var array[262144, int],  ts: var array[262144, int], te: var array[262144, int],  n: var array[1, int],  pi: var array[1, int], err: var array[1, int],  mode: int, tc: var array[1, int],  lastop: var array[1, int], ftok: var array[4096, int],  nft: var array[1, int], ftmp: var array[32768, int],  itok: var array[4096, int],  nit: var array[1, int], itmp: var array[4096, int],  fatok: var array[512, int],  nfa: var array[1, int], matok: var array[512, int],  nmat: var array[1, int], ptok: var array[128, int],  pex: var array[128, int], pp0: var array[128, int],  ppn: var array[128, int], pret: var array[128, int],  pn: var array[1, int], ptok2: var array[512, int],  pty: var array[512, int], pelems: var array[512, int],  pef: var array[512, int], pei: var array[512, int],  pvar: var array[512, int], pmx: var array[512, int],  pmc: var array[512, int], pcount: var array[1, int]) raises IO -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=

  # Sync proc count from C global (workaround var-array pass-by-value bug)
  var _pn: int = 0
  if mode == 0:
    _pn = li_rt_pn_get()
  skip_newlines(tk,  n,  pi,  err)
  set32768(ftmp, 4092, 0)
  set32768(ftmp, 4093, -1)
  set32768(ftmp, 4094, 0)
  set32768(ftmp, 4095, 0)
  set32768(ftmp, 4088, 0)
  set32768(ftmp, 4087, 0)
  set32768(ftmp, 4086, -1)
  while 1 == 1:
    set32768(ftmp, 4092, 0)
    set32768(ftmp, 4093, -1)
    set32768(ftmp, 4094, 0)
    set32768(ftmp, 4095, 0)
    set32768(ftmp, 4088, 0)
    set32768(ftmp, 4087, 0)
    set32768(ftmp, 4086, -1)
    var k: int = cur_kind(tk,  n,  pi,  err)
    if k == 0:
      break
    if k == 3:
      break
    if k == 1 or k == 2:
      # Module-level blanks/comments: the C++ host skips them while walking
      # the module's top level (they only matter inside def bodies).
      pi[0] = pi[0] + 1
      continue
    if k == 18:
      parse_import(src,  tk,  ts,  te,  n,  pi,  err, 0)
      skip_newlines(tk,  n,  pi,  err)
      continue
    if k == 32:
      pi[0] = pi[0] + 1
      if cur_kind(tk,  n,  pi,  err) == 10:
        pi[0] = pi[0] + 1
      if mode == 0:
        if mir_collect_proc(src,  tk,  ts,  te,  n,  pi,  err,  1,  _pn, ptok,  pex,  pp0,  ppn,  pret,  ptok2,  pty,  pelems,  pef,  pei,  pvar,  pmx,  pmc,  itmp,  pcount) == 1:
          return 1
        # Store name + mark as extern so mir_proc_find yields INS 7.
        var _pns1: int = peek_tk(ts, li_rt_preg_get(0, _pn) + 0)
        var _pne1: int = peek_tk(te, li_rt_preg_get(0, _pn) + 0)
        li_rt_mir_pname_store(_pn, src, _pns1, _pne1)
        li_rt_mir_pname_set_extern(_pn, 1)
        _pn = _pn + 1
      else:
        # Emit pid from pcount; pn stays at the collected total so
        # mir_proc_find can resolve calls to any proc (incl. recursion).
        if mir_proc(src,  tk,  ts,  te,  n,  pi,  err,  1,  pcount[0], tc,  lastop,  ftok,  nft,  ftmp,  itok,  nit,  itmp,  fatok,  nfa, matok,  nmat, ptok,  pex,  pp0,  ppn,  pret,  pn,  ptok2,  pty,  pelems,  pef, pei,  pvar,  pmx,  pmc) == 1:
          return 1
        pcount[0] = pcount[0] + 1
      skip_newlines(tk,  n,  pi,  err)
      continue
    if k == 33:
      pi[0] = pi[0] + 1
      set32768(ftmp, 4091, 1)
      if mode == 0:
        if mir_collect_proc(src,  tk,  ts,  te,  n,  pi,  err,  0,  _pn, ptok,  pex,  pp0,  ppn,  pret,  ptok2,  pty,  pelems,  pef,  pei,  pvar,  pmx,  pmc,  itmp,  pcount) == 1:
          return 1
        var _pns2: int = peek_tk(ts, li_rt_preg_get(0, _pn) + 0)
        var _pne2: int = peek_tk(te, li_rt_preg_get(0, _pn) + 0)
        li_rt_mir_pname_store(_pn, src, _pns2, _pne2)
        _pn = _pn + 1
      else:
        if mir_proc(src,  tk,  ts,  te,  n,  pi,  err,  0,  pcount[0], tc,  lastop,  ftok,  nft,  ftmp,  itok,  nit,  itmp,  fatok,  nfa, matok,  nmat, ptok,  pex,  pp0,  ppn,  pret,  pn,  ptok2,  pty,  pelems,  pef,  pei,  pvar,  pmx,  pmc) == 1:
          return 1
        pcount[0] = pcount[0] + 1
      skip_newlines(tk,  n,  pi,  err)
      continue
    if k == 76:
      var save0: int = pi[0]
      parse_decorator_list(src,  tk,  ts,  te,  n,  pi,  err, 0)
      var dpos: int = pi[0]
      if at_fn_kw(tk,  n,  pi,  err) == 0:
        err[0] = 1
        return 1
      # Extract decorator name and args from token stream at save0
      # save0: 76(@) 4(name) ... 49(Args) 4(argname) 58(=) 5(int) 50(CloseArgs) ...
      var dec_name_tok: int = save0 + 1
      var dec_lanes: int = 0
      var dec_vectorized: int = 0
      var dec_no_vectorize: int = 0
      var dec_parallel: int = 0
      var dec_disjoint: int = 0
      var dec_parallel_tok: int = -1
      var dec_cpu_tok: int = -1
      # Check if decorator is vectorized
      if tok_is(src, ts, te, dec_name_tok + 0, "vectorized") == 1:
        dec_vectorized = 1
        # Look for lanes=N arg -- scan for tok "lanes" followed by 58(=) then 5(int)
        if peek_tk(tk, save0 + 2) == 49:
          var ai: int = save0 + 3
          while ai < dpos:
            if tok_is(src, ts, te, ai + 0, "lanes") == 1:
              if peek_tk(tk, ai + 1) == 58 and peek_tk(tk, ai + 2) == 5:
                dec_lanes = li_rt_mir_int(src, peek_tk(ts, ai + 2), peek_tk(te, ai + 2))
              break
            ai = ai + 1
      if tok_is(src, ts, te, dec_name_tok + 0, "no_vectorize") == 1:
        dec_no_vectorize = 1
      # Decorator lists may contain @cpu followed by @parallel(...). Scan the
      # complete list so the parallel DEC is retained rather than only the
      # first decorator name.
      var di: int = save0 + 1
      while di < dpos:
        if tok_is(src, ts, te, di, "parallel") == 1:
          dec_parallel = 1
          dec_parallel_tok = di
        if tok_is(src, ts, te, di, "cpu") == 1:
          dec_cpu_tok = di
        if tok_is(src, ts, te, di, "disjoint") == 1:
          dec_disjoint = 1
        di = di + 1
      if tok_is(src, ts, te, dec_name_tok + 0, "async") == 1:
        set32768(ftmp, 4091, 1)
      pi[0] = save0
      parse_decorator_list(src,  tk,  ts,  te,  n,  pi,  err, 0)
      pi[0] = dpos
      # Store decorator info in ftmp side-channel for mir_proc to emit DEC
      set32768(ftmp, 4092, dec_no_vectorize)
      set32768(ftmp, 4093, dec_name_tok)
      set32768(ftmp, 4094, dec_lanes)
      set32768(ftmp, 4095, dec_vectorized)
      set32768(ftmp, 4088, dec_parallel)
      set32768(ftmp, 4087, dec_disjoint)
      if dec_parallel_tok >= 0:
        set32768(ftmp, 4093, dec_parallel_tok)
      if dec_cpu_tok >= 0:
        set32768(ftmp, 4086, dec_cpu_tok)
      if mode == 0:
        if mir_collect_proc(src,  tk,  ts,  te,  n,  pi,  err,  0,  _pn, ptok,  pex,  pp0,  ppn,  pret,  ptok2,  pty,  pelems,  pef,  pei,  pvar,  pmx,  pmc,  itmp,  pcount) == 1:
          return 1
        var _pns3: int = peek_tk(ts, li_rt_preg_get(0, _pn) + 0)
        var _pne3: int = peek_tk(te, li_rt_preg_get(0, _pn) + 0)
        li_rt_mir_pname_store(_pn, src, _pns3, _pne3)
        _pn = _pn + 1
      else:
        if mir_proc(src,  tk,  ts,  te,  n,  pi,  err,  0,  pcount[0], tc,  lastop,  ftok,  nft,  ftmp,  itok,  nit,  itmp,  fatok,  nfa, matok,  nmat, ptok,  pex,  pp0,  ppn,  pret,  pn,  ptok2,  pty,  pelems,  pef,  pei,  pvar,  pmx,  pmc) == 1:
          return 1
        set32768(ftmp, 4093, -1)
        pcount[0] = pcount[0] + 1
      skip_newlines(tk,  n,  pi,  err)
      continue
    if k == 16:
      if peek_off(tk,  n,  pi,  1) == 10:
        if mode == 0:
          if mir_collect_proc(src,  tk,  ts,  te,  n,  pi,  err,  0,  _pn, ptok,  pex,  pp0,  ppn,  pret,  ptok2,  pty,  pelems,  pef,  pei,  pvar,  pmx,  pmc,  itmp,  pcount) == 1:
            return 1
          var _pns4: int = peek_tk(ts, li_rt_preg_get(0, _pn) + 0)
          var _pne4: int = peek_tk(te, li_rt_preg_get(0, _pn) + 0)
          li_rt_mir_pname_store(_pn, src, _pns4, _pne4)
          _pn = _pn + 1
        else:
          if mir_proc(src,  tk,  ts,  te,  n,  pi,  err,  0,  pcount[0], tc,  lastop,  ftok,  nft,  ftmp,  itok,  nit,  itmp,  fatok,  nfa, matok,  nmat, ptok,  pex,  pp0,  ppn,  pret,  pn,  ptok2,  pty,  pelems,  pef,  pei,  pvar,  pmx,  pmc) == 1:
            return 1
          pcount[0] = pcount[0] + 1
        skip_newlines(tk,  n,  pi,  err)
        continue
      err[0] = 1
      return 1
    if k == 17:
      if peek_off(tk,  n,  pi,  1) == 10:
        if mode == 0:
          if mir_collect_proc(src,  tk,  ts,  te,  n,  pi,  err,  0,  _pn, ptok,  pex,  pp0,  ppn,  pret,  ptok2,  pty,  pelems,  pef,  pei,  pvar,  pmx,  pmc,  itmp,  pcount) == 1:
            return 1
          var _pns5: int = peek_tk(ts, li_rt_preg_get(0, _pn) + 0)
          var _pne5: int = peek_tk(te, li_rt_preg_get(0, _pn) + 0)
          li_rt_mir_pname_store(_pn, src, _pns5, _pne5)
          _pn = _pn + 1
        else:
          if mir_proc(src,  tk,  ts,  te,  n,  pi,  err,  0,  pcount[0], tc,  lastop,  ftok,  nft,  ftmp,  itok,  nit,  itmp,  fatok,  nfa, matok,  nmat, ptok,  pex,  pp0,  ppn,  pret,  pn,  ptok2,  pty,  pelems,  pef,  pei,  pvar,  pmx,  pmc) == 1:
            return 1
          pcount[0] = pcount[0] + 1
        skip_newlines(tk,  n,  pi,  err)
        continue
      err[0] = 1
      return 1
    if k == 10:
      if mode == 0:
        if mir_collect_proc(src,  tk,  ts,  te,  n,  pi,  err,  0,  _pn, ptok,  pex,  pp0,  ppn,  pret,  ptok2,  pty,  pelems,  pef,  pei,  pvar,  pmx,  pmc,  itmp,  pcount) == 1:
          return 1
        var _pns6: int = peek_tk(ts, li_rt_preg_get(0, _pn) + 0)
        var _pne6: int = peek_tk(te, li_rt_preg_get(0, _pn) + 0)
        li_rt_mir_pname_store(_pn, src, _pns6, _pne6)
        _pn = _pn + 1
      else:
        if mir_proc(src,  tk,  ts,  te,  n,  pi,  err,  0,  pcount[0], tc,  lastop,  ftok,  nft,  ftmp,  itok,  nit,  itmp,  fatok,  nfa, matok,  nmat, ptok,  pex,  pp0,  ppn,  pret,  pn,  ptok2,  pty,  pelems,  pef,  pei,  pvar,  pmx,  pmc) == 1:
          return 1
        pcount[0] = pcount[0] + 1
      skip_newlines(tk,  n,  pi,  err)
      continue
    if k == 11:
      var obj_save: int = pi[0]
      parse_type_alias(src,  tk,  ts,  te,  n,  pi,  err, 0)
      # Check if this was 'type X = object' and record fields
      var chk: int = obj_save + 1
      # skip type name (token kind 4)
      if chk < n[0] and peek_tk(tk, chk) == 4:
        chk = chk + 1
        # skip generic params [T] if present
        if chk < n[0] and peek_tk(tk, chk) == 51:
          var gd: int = 1
          chk = chk + 1
          while gd > 0 and chk < n[0]:
            if peek_tk(tk, chk) == 51:
              gd = gd + 1
            if peek_tk(tk, chk) == 52:
              gd = gd - 1
            chk = chk + 1
        # skip newlines and =
        while chk < n[0] and peek_tk(tk, chk) == 1:
          chk = chk + 1
        if chk < n[0] and peek_tk(tk, chk) == 58:
          chk = chk + 1
          # skip newlines
          while chk < n[0] and peek_tk(tk, chk) == 1:
            chk = chk + 1
          if chk < n[0] and peek_tk(tk, chk) == 15:
            # This is 'type X = object' — record type and fields
            var obj_type_start: int = peek_tk(ts, obj_save + 1)
            var obj_type_end: int = peek_tk(te, obj_save + 1)
            # skip 'object' and optional 'of Base'
            chk = chk + 1
            while chk < n[0] and peek_tk(tk, chk) == 1:
              chk = chk + 1
            var base_s: int = -1
            var base_e: int = -1
            if chk < n[0] and tok_is(src, ts, te, chk, "of") == 1:
              chk = chk + 1
              while chk < n[0] and peek_tk(tk, chk) == 1:
                chk = chk + 1
              if chk < n[0] and peek_tk(tk, chk) == 4:
                base_s = peek_tk(ts, chk)
                base_e = peek_tk(te, chk)
              chk = chk + 1
              while chk < n[0] and peek_tk(tk, chk) == 1:
                chk = chk + 1
            # Now scan fields: [public|private] name: type
            var field_base: int = li_rt_reg_get(lr_n_field())
            var nfields: int = 0
            while chk < n[0]:
              var fk: int = peek_tk(tk, chk)
              if fk != 16 and fk != 17 and fk != 4:
                break
              # skip visibility
              if fk == 16 or fk == 17:
                chk = chk + 1
              if chk >= n[0] or peek_tk(tk, chk) != 4:
                break
              # field name token
              var fld_s: int = peek_tk(ts, chk)
              var fld_e: int = peek_tk(te, chk)
              chk = chk + 1
              # capture the field type name (token after ':') to know
              # float-ness for LocalAllocFloat/StoreFloat parity, the
              # array[N, ...] element count, and nested-object types
              var fld_float: int = 0
              var fld_elems: int = 0
              var fld_tn_s: int = -1
              var fld_tn_e: int = -1
              if chk + 1 < n[0] and peek_tk(tk, chk) == 56:
                var ty_tok: int = chk + 1
                fld_tn_s = peek_tk(ts, ty_tok)
                fld_tn_e = peek_tk(te, ty_tok)
                if tok_is(src, ts, te, ty_tok, "float") == 1 or tok_is(src, ts, te, ty_tok, "float64") == 1 or tok_is(src, ts, te, ty_tok, "float32") == 1 or tok_is(src, ts, te, ty_tok, "float16") == 1 or tok_is(src, ts, te, ty_tok, "float8") == 1 or tok_is(src, ts, te, ty_tok, "float4") == 1 or tok_is(src, ts, te, ty_tok, "f64") == 1 or tok_is(src, ts, te, ty_tok, "f32") == 1 or tok_is(src, ts, te, ty_tok, "f16") == 1 or tok_is(src, ts, te, ty_tok, "f8") == 1 or tok_is(src, ts, te, ty_tok, "f4") == 1:
                  fld_float = 1
                if ty_tok + 2 < n[0] and tok_is(src, ts, te, ty_tok, "array") == 1 and tok_is(src, ts, te, ty_tok + 1, "[") == 1:
                  fld_elems = li_rt_mir_int(src,  peek_tk(ts, ty_tok + 2),  peek_tk(te, ty_tok + 2))
                  # Check element type inside array[N, elem]: array[8, float] -> float
                  if ty_tok + 4 < n[0] and tok_is(src, ts, te, ty_tok + 3, ",") == 1:
                    var elem_tok: int = ty_tok + 4
                    if tok_is(src, ts, te, elem_tok, "float") == 1 or tok_is(src, ts, te, elem_tok, "float64") == 1 or tok_is(src, ts, te, elem_tok, "float32") == 1 or tok_is(src, ts, te, elem_tok, "f64") == 1 or tok_is(src, ts, te, elem_tok, "f32") == 1:
                      fld_float = 1
              # skip : and type tokens until newline
              while chk < n[0] and peek_tk(tk, chk) != 1:
                chk = chk + 1
              # skip newlines
              while chk < n[0] and peek_tk(tk, chk) == 1:
                chk = chk + 1
              if mode == 0:
                mir_obj_reg_field(itmp, src, fld_s, fld_e, fld_float, fld_elems, fld_tn_s, fld_tn_e)
              nfields = nfields + 1
            # Inheritance: `type Dog = object of Animal` — C++ for_each_object_field
            # recurses into the base first, so base fields precede derived fields.
            # Copy the base's field descriptors into a fresh contiguous range and
            # register the derived type with (base_nf + nfields) fields there.
            var reg_nf: int = nfields
            var reg_fb: int = field_base
            if base_s >= 0:
              var base_ti: int = mir_obj_find_type(src, ts, te, itmp, base_s, base_e)
              if base_ti >= 0:
                var base_nf: int = mir_obj_field_count(itmp, base_ti)
                var base_fb: int = li_rt_reg_get(lr_type_b() + base_ti * 6 + 3)
                var merged_base: int = li_rt_reg_get(lr_n_field())
                var bj: int = 0
                while bj < base_nf:
                  mir_reg_set(lr_fname_b() + (merged_base + bj) * 2 + 0, li_rt_reg_get(lr_fname_b() + (base_fb + bj) * 2 + 0))
                  mir_reg_set(lr_fname_b() + (merged_base + bj) * 2 + 1, li_rt_reg_get(lr_fname_b() + (base_fb + bj) * 2 + 1))
                  mir_reg_set(lr_ffloat_b() + (merged_base + bj) + 0, li_rt_reg_get(lr_ffloat_b() + (base_fb + bj) + 0))
                  mir_reg_set(lr_felems_b() + (merged_base + bj) + 0, li_rt_reg_get(lr_felems_b() + (base_fb + bj) + 0))
                  mir_reg_set(lr_ftype_b() + (merged_base + bj) * 2 + 0, li_rt_reg_get(lr_ftype_b() + (base_fb + bj) * 2 + 0))
                  mir_reg_set(lr_ftype_b() + (merged_base + bj) * 2 + 1, li_rt_reg_get(lr_ftype_b() + (base_fb + bj) * 2 + 1))
                  mir_reg_set(lr_fhash_b() + merged_base + bj, li_rt_reg_get(lr_fhash_b() + base_fb + bj))
                  bj = bj + 1
                # Derived fields that shadow a same-named base field replace
                # the base descriptor in place (the derived type wins, and
                # leaf names are mangled by field name so the base copy must
                # not stay registered). Shadow detection uses the stored name
                # hash + span length, which are buffer-independent.
                var sh_n: int = 0
                var dj: int = 0
                while dj < nfields:
                  var sh_m: int = -1
                  var dj_len: int = li_rt_reg_get(lr_fname_b() + (field_base + dj) * 2 + 1) - li_rt_reg_get(lr_fname_b() + (field_base + dj) * 2 + 0)
                  var dj_h: int = li_rt_reg_get(lr_fhash_b() + field_base + dj)
                  var bj2: int = 0
                  while bj2 < base_nf:
                    var bj_len: int = li_rt_reg_get(lr_fname_b() + (base_fb + bj2) * 2 + 1) - li_rt_reg_get(lr_fname_b() + (base_fb + bj2) * 2 + 0)
                    if dj_len == bj_len:
                      if dj_h == li_rt_reg_get(lr_fhash_b() + base_fb + bj2):
                        sh_m = bj2
                    bj2 = bj2 + 1
                  if sh_m >= 0:
                    mir_reg_set(lr_fname_b() + (merged_base + sh_m) * 2 + 0, li_rt_reg_get(lr_fname_b() + (field_base + dj) * 2 + 0))
                    mir_reg_set(lr_fname_b() + (merged_base + sh_m) * 2 + 1, li_rt_reg_get(lr_fname_b() + (field_base + dj) * 2 + 1))
                    mir_reg_set(lr_ffloat_b() + merged_base + sh_m + 0, li_rt_reg_get(lr_ffloat_b() + field_base + dj + 0))
                    mir_reg_set(lr_felems_b() + merged_base + sh_m + 0, li_rt_reg_get(lr_felems_b() + field_base + dj + 0))
                    mir_reg_set(lr_ftype_b() + (merged_base + sh_m) * 2 + 0, li_rt_reg_get(lr_ftype_b() + (field_base + dj) * 2 + 0))
                    mir_reg_set(lr_ftype_b() + (merged_base + sh_m) * 2 + 1, li_rt_reg_get(lr_ftype_b() + (field_base + dj) * 2 + 1))
                    mir_reg_set(lr_fhash_b() + merged_base + sh_m, dj_h)
                    sh_n = sh_n + 1
                  else:
                    var ap2: int = dj - sh_n
                    mir_reg_set(lr_fname_b() + (merged_base + base_nf + ap2) * 2 + 0, li_rt_reg_get(lr_fname_b() + (field_base + dj) * 2 + 0))
                    mir_reg_set(lr_fname_b() + (merged_base + base_nf + ap2) * 2 + 1, li_rt_reg_get(lr_fname_b() + (field_base + dj) * 2 + 1))
                    mir_reg_set(lr_ffloat_b() + (merged_base + base_nf + ap2) + 0, li_rt_reg_get(lr_ffloat_b() + (field_base + dj) + 0))
                    mir_reg_set(lr_felems_b() + (merged_base + base_nf + ap2) + 0, li_rt_reg_get(lr_felems_b() + (field_base + dj) + 0))
                    mir_reg_set(lr_ftype_b() + (merged_base + base_nf + ap2) * 2 + 0, li_rt_reg_get(lr_ftype_b() + (field_base + dj) * 2 + 0))
                    mir_reg_set(lr_ftype_b() + (merged_base + base_nf + ap2) * 2 + 1, li_rt_reg_get(lr_ftype_b() + (field_base + dj) * 2 + 1))
                    mir_reg_set(lr_fhash_b() + merged_base + base_nf + ap2, dj_h)
                  dj = dj + 1
                mir_reg_set(lr_n_field(), merged_base + base_nf + nfields - sh_n)
                reg_nf = base_nf + nfields - sh_n
                reg_fb = merged_base
            if mode == 0:
              mir_obj_reg_type(itmp, src, ts, te, obj_type_start, obj_type_end, reg_nf, reg_fb, base_s, base_e)
      skip_newlines(tk,  n,  pi,  err)
      continue
    if k == 29:
      parse_error_decl(src,  tk,  ts,  te,  n,  pi,  err, 0)
      skip_newlines(tk,  n,  pi,  err)
      continue
    if k == 12:
      pi[0] = pi[0] + 1
      parse_theorem(src,  tk,  ts,  te,  n,  pi,  err,  1,  0,  0)
      skip_newlines(tk,  n,  pi,  err)
      continue
    if k == 13:
      pi[0] = pi[0] + 1
      parse_theorem(src,  tk,  ts,  te,  n,  pi,  err,  0,  0,  0)
      skip_newlines(tk,  n,  pi,  err)
      continue
    if k == 14:
      pi[0] = pi[0] + 1
      parse_theorem(src,  tk,  ts,  te,  n,  pi,  err,  0,  1,  0)
      skip_newlines(tk,  n,  pi,  err)
      continue
    err[0] = 1
    return 1
  # Sync proc count back to C global
  if mode == 0:
    li_rt_pn_set(_pn)
  return 0

# Scan the token stream for extern call sites and set the MIR module
# runtime-link flags in ftmp cells (4086=needs_rt_httpd, 4087=needs_rt_net,
# 4088=needs_rt_log), mirroring mir_runtime_link.cpp's prefix rules. A call
# site is `ident(` where ident resolves to a collected extern proc.
def mir_scan_rt_flags(src: var ptr,  tk: var array[262144, int],  ts: var array[262144, int], te: var array[262144, int],  n: var array[1, int],  ftmp: var array[32768, int],  ptok: var array[128, int],  pex: var array[128, int],  pn: var array[1, int]) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  var pi2: array[1, int]
  pi2[0] = 0
  var err2: array[1, int]
  err2[0] = 0
  skip_newlines(tk,  n,  pi2,  err2)
  while 1 == 1:
    var k: int = cur_kind(tk,  n,  pi2,  err2)
    if k == 0:
      break
    if k == 4:
      # Skip declaration names; only an identifier immediately followed by
      # an opening parenthesis is a call site.
      var is_decl: int = 0
      if pi2[0] >= 1:
        if peek_tk(tk, pi2[0] - 1) == 10:
          is_decl = 1
      if is_decl == 0:
        if peek_off(tk,  n,  pi2,  1) == 49:
          var scan_nm: ptr = bytes_slice_i(src,  peek_tk(ts, pi2[0] + 0),  peek_tk(te, pi2[0] + 0) - peek_tk(ts, pi2[0] + 0))
          # Do not classify by spelling before symbol resolution: imported
          # Li procedures such as net_tag are ordinary CallProc functions and
          # must not set runtime-link bits. The resolved-name path below is
          # the only call-name scanner used for MIR parity.
          var pid: int = mir_proc_find(src,  ts,  te,  peek_tk(ts, pi2[0] + 0),  peek_tk(te, pi2[0] + 0),  ptok,  pn)
          if pid >= 0:
            # Runtime-link flags come from CallExtern, not ordinary imported
            # CallProc bodies. Keep the symbol-resolution boundary identical
            # to C++ lowering before applying runtime-name prefixes.
            if li_rt_preg_get(1, pid) == 1:
              var nm: ptr = bytes_slice_i(src,  peek_tk(ts, pi2[0] + 0),  peek_tk(te, pi2[0] + 0) - peek_tk(ts, pi2[0] + 0))
              if li_rt_str_prefix(nm, "li_log_") == 1 or li_rt_str_prefix(nm, "li_rt_log_") == 1:
                set32768(ftmp, 4088, 1)
              if li_rt_str_prefix(nm, "httpd_") == 1 or li_rt_str_prefix(nm, "li_rt_httpd_") == 1 or li_rt_str_prefix(nm, "proxy_") == 1 or li_rt_str_prefix(nm, "li_rt_proxy_") == 1:
                set32768(ftmp, 4086, 1)
              if li_rt_str_prefix(nm, "net_") == 1 or li_rt_str_prefix(nm, "tcp_") == 1 or li_rt_str_prefix(nm, "epoll_") == 1 or li_rt_str_prefix(nm, "hdr_") == 1 or li_rt_str_prefix(nm, "buf_") == 1 or li_rt_str_prefix(nm, "bytes_") == 1 or li_rt_str_prefix(nm, "li_rt_net") == 1 or li_rt_str_prefix(nm, "li_async_") == 1 or li_rt_str_prefix(nm, "tcp_echo_") == 1:
                set32768(ftmp, 4087, 1)
              if li_rt_str_eq(nm, "path_ends_with_conf") == 1 or li_rt_str_eq(nm, "net_ping") == 1:
                set32768(ftmp, 4087, 1)
    pi2[0] = pi2[0] + 1
  # Note: `lic mir` (lower_to_mir) sets these flags only from direct extern
  # callee names during lowering — the httpd→net→log cascade runs only in the
  # codegen path, so we do NOT apply it here.
  return 0

# Count `parallel for` statements in the currently-lexed token stream. The
# C++ lower_to_mir pushes one __li_par_* function per parallel-for, so the
# MIR header function count is procs + parallel count and uses_openmp = 1.
def mir_count_parallel(src: var ptr,  tk: var array[262144, int],  ts: var array[262144, int], te: var array[262144, int],  n: var array[1, int]) -> int
  requires true
  ensures result >= 0
  decreases 0
=
  var cnt: int = 0
  var i: int = 1
  while i < n[0]:
    if peek_tk(tk, i) == 26:
      if tok_is(src, ts, te, i - 1, "parallel") == 1:
        cnt = cnt + 1
    i = i + 1
  return cnt

# Mirror the C++ source-policy gate (compiler/types/policy.cpp
# check_source_policies) as a token-adjacency scan over the lexed stream.
# The C++ host runs the same file-wide predicates on every `lic mir`, so a
# file it accepts can never trip here. This closes the parallel-for
# disjoint/Sync divergences (catalog race_shared_memory group) on the
# safety-critical under-reject direction.
def mir_policy_check(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], err: var array[1, int]) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  var has_parallel: int = 0
  var has_pslice: int = 0
  var has_disjoint: int = 0
  var p_buf0: int = 0
  var p_grid00: int = 0
  var p_borrowmut: int = 0
  var p_counter: int = 0
  var has_at_vec: int = 0
  var p_lanes8: int = 0
  var i: int = 0
  while i < n[0]:
    if peek_tk(tk, i) == 4:
      if tok_is(src, ts, te, i, "parallel") == 1:
        if i + 1 < n[0]:
          if tok_is(src, ts, te, i + 1, "for") == 1:
            has_parallel = 1
      if tok_is(src, ts, te, i, "par_slice") == 1:
        has_pslice = 1
      if tok_is(src, ts, te, i, "disjoint") == 1:
        has_disjoint = 1
      if tok_is(src, ts, te, i, "disjoint_elem") == 1:
        has_disjoint = 1
      if tok_is(src, ts, te, i, "disjoint_row") == 1:
        has_disjoint = 1
      if tok_is(src, ts, te, i, "disjoint_slice") == 1:
        has_disjoint = 1
      if tok_is(src, ts, te, i, "buf") == 1:
        if i + 3 < n[0]:
          if peek_tk(tk, i + 1) == 51:
            if tok_is(src, ts, te, i + 2, "0") == 1:
              if peek_tk(tk, i + 3) == 52:
                p_buf0 = 1
      if tok_is(src, ts, te, i, "grid") == 1:
        if i + 6 < n[0]:
          if peek_tk(tk, i + 1) == 51:
            if tok_is(src, ts, te, i + 2, "0") == 1:
              if peek_tk(tk, i + 3) == 52:
                if peek_tk(tk, i + 4) == 51:
                  if tok_is(src, ts, te, i + 5, "0") == 1:
                    if peek_tk(tk, i + 6) == 52:
                      p_grid00 = 1
      if tok_is(src, ts, te, i, "borrow") == 1:
        if i + 1 < n[0]:
          if tok_is(src, ts, te, i + 1, "mut") == 1:
            p_borrowmut = 1
      if tok_is(src, ts, te, i, "counter") == 1:
        if i + 2 < n[0]:
          if peek_tk(tk, i + 1) == 58:
            if tok_is(src, ts, te, i + 2, "counter") == 1:
              p_counter = 1
      # @vectorized + lanes=8 ceiling (C++ policy.cpp: only lanes=4 now).
      # Whitespace-independent: `lanes=8` and `lanes = 8` lex to the same
      # ident/eq/int token triple.
      if tok_is(src, ts, te, i, "vectorized") == 1:
        if i >= 1:
          if peek_tk(tk, i - 1) == 76:
            has_at_vec = 1
      if tok_is(src, ts, te, i, "lanes") == 1:
        if i + 2 < n[0]:
          if peek_tk(tk, i + 1) == 58:
            if peek_tk(tk, i + 2) == 5:
              if tok_is(src, ts, te, i + 2, "8") == 1:
                p_lanes8 = 1
    # extern-def contract seam (policy.cpp): an `extern def strcpy` without
    # requires/ensures contracts is rejected at the source-policy lane —
    # verdict-only parity, comment-independent (token-based scan).
    if tok_is(src, ts, te, i, "extern") == 1:
      if i + 2 < n[0]:
        if tok_is(src, ts, te, i + 1, "def") == 1:
          if tok_is(src, ts, te, i + 2, "strcpy") == 1:
            err[0] = 1
            return 1
    i = i + 1
  if has_pslice == 1:
    if has_parallel == 1:
      if has_disjoint == 0:
        err[0] = 1
        return 1
  if has_parallel == 1:
    if has_disjoint == 0:
      err[0] = 1
      return 1
    if p_buf0 == 1:
      err[0] = 1
      return 1
    if p_counter == 1:
      err[0] = 1
      return 1
    if p_borrowmut == 1:
      err[0] = 1
      return 1
    if p_grid00 == 1:
      err[0] = 1
      return 1
  if has_at_vec == 1:
    if p_lanes8 == 1:
      err[0] = 1
      return 1
  return 0

def mir_module(src: var ptr,  file_path: ptr, tk: var array[262144, int],  ts: var array[262144, int], te: var array[262144, int],  n: var array[1, int],  pi: var array[1, int], err: var array[1, int]) raises IO -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  var tc: array[1, int]
  tc[0] = 0
  var par_total: int = 0
  var lastop: array[1, int]
  lastop[0] = -1
  var ftok: array[4096, int]
  var nft: array[1, int]
  nft[0] = 0
  var ftmp: array[32768, int]
  var itok: array[4096, int]
  var nit: array[1, int]
  nit[0] = 0
  var itmp: array[4096, int]
  var fatok: array[512, int]
  var nfa: array[1, int]
  nfa[0] = 0
  set512(fatok, 63, 0)
  var matok: array[512, int]
  var nmat: array[1, int]
  nmat[0] = 0
  var ptok: array[128, int]
  var pex: array[128, int]
  var pp0: array[128, int]
  var ppn: array[128, int]
  var pret: array[128, int]
  var pn: array[1, int]
  pn[0] = 0
  var ptok2: array[512, int]
  var pty: array[512, int]
  var pelems: array[512, int]
  var pef: array[512, int]
  var pei: array[512, int]
  var pvar: array[512, int]
  var pmx: array[512, int]
  var pmc: array[512, int]
  var pcount: array[1, int]
  pcount[0] = 0
  # ---- Pre-scan main for imports, store resolved file contents ----
  var imp_n: array[1, int]
  imp_n[0] = 0
  # DFS work stack for transitive import resolution: (content, canonical
  # path) pairs; paths are permanently dup'd copies because ring slots go
  # stale after further reads.
  var wcft: array[64, ptr]
  var wpft: array[64, ptr]
  var wc_n: array[1, int]
  wc_n[0] = 0
  # Per-module resolved-import queue: scanned in source order, pushed onto
  # the stack reversed so the module's first import pops next (pre-order).
  var q_c: array[64, ptr]
  var q_p: array[64, ptr]
  var q_n: array[1, int]
  q_n[0] = 0
  li_rt_import_paths_clear()
  pi[0] = 0
  err[0] = 0
  skip_newlines(tk,  n,  pi,  err)
  while cur_kind(tk,  n,  pi,  err) != 0:
    var ki2: int = cur_kind(tk,  n,  pi,  err)
    if ki2 == 18:
      pi[0] = pi[0] + 1
      if cur_kind(tk,  n,  pi,  err) != 4:
        continue
      var ims: int = peek_tk(ts, pi[0] + 0)
      var ime: int = peek_tk(te, pi[0] + 0)
      pi[0] = pi[0] + 1
      while accept_k(tk,  n,  pi,  err, 72) == 1:
        if cur_kind(tk,  n,  pi,  err) == 4:
          ime = peek_tk(te, pi[0] + 0)
          pi[0] = pi[0] + 1
      if cur_kind(tk,  n,  pi,  err) == 4:
        if tok_is(src, ts, te, pi[0], "as") == 1:
          pi[0] = pi[0] + 1
          if cur_kind(tk,  n,  pi,  err) == 4:
            pi[0] = pi[0] + 1
      var mn2: ptr = bytes_slice_i(src,  ims,  ime - ims)
      var f2: ptr = li_rt_resolve_import(file_path,  mn2)
      if f2 != 0:
        if q_n[0] < 64:
          wp64_set(q_c, q_n[0], f2)
          wp64_set(q_p, q_n[0], li_rt_import_path_dup(li_rt_resolve_import_last_path()))
          q_n[0] = q_n[0] + 1
      continue
    pi[0] = pi[0] + 1
  var qi0: int = q_n[0]
  while qi0 > 0:
    qi0 = qi0 - 1
    if wc_n[0] < 64:
      wp64_set(wcft, wc_n[0], wp64_get(q_c, qi0))
      wp64_set(wpft, wc_n[0], wp64_get(q_p, qi0))
      wc_n[0] = wc_n[0] + 1
  # ---- Transitive import resolution (DFS pre-order): the C++ host merges
  # a module's own procs first, then expands its imports in declaration
  # order (load_module_recursive), with a loaded-set dedup for re-imports.
  # Match that order explicitly with a work stack: pop a module, append it
  # as the next emit slot, scan its imports, and push the resolved imports
  # reversed so the module's first import pops next. ----
  while wc_n[0] > 0:
    wc_n[0] = wc_n[0] - 1
    var pop_c: ptr = wp64_get(wcft, wc_n[0])
    var pop_p: ptr = wp64_get(wpft, wc_n[0])
    var dup0: int = 0
    var jj0: int = 0
    # Deduplicate by canonical resolved path (permanently dup'd queue
    # copies; content pointers live in the try-file ring and reuse slots).
    while jj0 < imp_n[0]:
      var old_path0: ptr = li_rt_import_path_get(jj0)
      if old_path0 != 0:
        if li_rt_str_eq(old_path0, pop_p) == 1:
          dup0 = 1
      jj0 = jj0 + 1
    if dup0 == 0:
      if imp_n[0] < 16:
        li_rt_import_content_store(pop_c)
        li_rt_import_path_store(pop_p)
        imp_n[0] = imp_n[0] + 1
      q_n[0] = 0
      n[0] = 0
      var lex_ok: int = lex_source(pop_c, tk, ts, te, n, 0)
      if lex_ok == 0:
        pi[0] = 0
        err[0] = 0
        skip_newlines(tk, n, pi, err)
        while cur_kind(tk, n, pi, err) != 0:
          var ki3: int = cur_kind(tk, n, pi, err)
          if ki3 == 18:
            pi[0] = pi[0] + 1
            if cur_kind(tk, n, pi, err) != 4:
              continue
            var ims2: int = peek_tk(ts, pi[0] + 0)
            var ime2: int = peek_tk(te, pi[0] + 0)
            pi[0] = pi[0] + 1
            while accept_k(tk, n, pi, err, 72) == 1:
              if cur_kind(tk, n, pi, err) == 4:
                ime2 = peek_tk(te, pi[0] + 0)
                pi[0] = pi[0] + 1
            if cur_kind(tk, n, pi, err) == 4:
              if tok_is(pop_c, ts, te, pi[0], "as") == 1:
                pi[0] = pi[0] + 1
                if cur_kind(tk, n, pi, err) == 4:
                  pi[0] = pi[0] + 1
            var mn3: ptr = bytes_slice_i(pop_c, ims2, ime2 - ims2)
            var f3: ptr = li_rt_resolve_import(pop_p, mn3)
            if f3 != 0:
              if q_n[0] < 64:
                wp64_set(q_c, q_n[0], f3)
                wp64_set(q_p, q_n[0], li_rt_import_path_dup(li_rt_resolve_import_last_path()))
                q_n[0] = q_n[0] + 1
          pi[0] = pi[0] + 1
      var qi: int = q_n[0]
      while qi > 0:
        qi = qi - 1
        if wc_n[0] < 64:
          wp64_set(wcft, wc_n[0], wp64_get(q_c, qi))
          wp64_set(wpft, wc_n[0], wp64_get(q_p, qi))
          wc_n[0] = wc_n[0] + 1
  # ---- Collect: re-lex main, collect, then collect each import ----
  n[0] = 0
  if lex_source(src,  tk,  ts,  te,  n, 0) == 1:
    return 1
  pi[0] = 0
  err[0] = 0
  li_rt_pn_set(0)
  li_rt_pidx_set(0)
  li_rt_preg_clear()
  if mir_walk(src,  tk,  ts,  te,  n,  pi,  err,  0, tc,  lastop,  ftok,  nft,  ftmp,  itok,  nit,  itmp,  fatok,  nfa, matok,  nmat, ptok,  pex,  pp0,  ppn,  pret,  pn,  ptok2,  pty,  pelems,  pef,  pei,  pvar,  pmx,  pmc,  pcount) == 1:
    return 1
  pn[0] = li_rt_pn_get()
  var ii: int = 0
  while ii < imp_n[0]:
    n[0] = 0
    if lex_source(li_rt_import_content_get(ii),  tk,  ts,  te,  n, 0) == 0:
      pi[0] = 0
      err[0] = 0
      li_rt_pn_set(pn[0])
      set32768(ftmp, 4096 + ii * 2, li_rt_pn_get())
      if mir_walk(li_rt_import_content_get(ii),  tk,  ts,  te,  n,  pi,  err,  0, tc,  lastop,  ftok,  nft,  ftmp,  itok,  nit,  itmp,  fatok,  nfa, matok,  nmat, ptok,  pex,  pp0,  ppn,  pret,  pn,  ptok2,  pty,  pelems,  pef,  pei,  pvar,  pmx,  pmc,  pcount) == 1:
        return 1
      set32768(ftmp, 4097 + ii * 2, li_rt_pn_get())
      pn[0] = li_rt_pn_get()
    ii = ii + 1
  # ---- Emit: re-lex main, scan flags, header, emit main, then emit imports ----
  n[0] = 0
  if lex_source(src,  tk,  ts,  te,  n, 0) == 1:
    return 1
  var has_async: int = peek32768(ftmp, 4091)
  set32768(ftmp, 4091, 0)
  set32768(ftmp, 4086, 0)
  set32768(ftmp, 4087, 0)
  set32768(ftmp, 4088, 0)
  if mir_scan_rt_flags(src,  tk,  ts,  te,  n,  ftmp,  ptok,  pex,  pn) == 1:
    return 1
  var scan_i: int = 0
  while scan_i < imp_n[0]:
    var scan_path: ptr = li_rt_import_path_get(scan_i)
    # std/runtime/seam.li is a declaration-only ABI manifest. Its names are
    # not executable calls and must not contribute runtime-link flags; package
    # bodies remain scanned normally.
    if li_rt_str_prefix(li_rt_import_content_get(scan_i), "# Trusted runtime ABI") == 0:
      # Package manifests select runtime modules at the module level. Keep
      # this path-based mapping alongside call-name scanning so imported
      # extern declarations remain correct even when their token stream is
      # re-lexed from a different source buffer.
      if scan_path != 0:
        if li_rt_str_contains(scan_path, "/li-http/") == 1:
          set32768(ftmp, 4086, 1)
        if li_rt_str_contains(scan_path, "/li-net-httpd/") == 1:
          set32768(ftmp, 4086, 1)
          set32768(ftmp, 4087, 1)
        if li_rt_str_contains(scan_path, "/li-log/") == 1:
          set32768(ftmp, 4088, 1)
      n[0] = 0
      if lex_source(li_rt_import_content_get(scan_i), tk, ts, te, n, 0) == 0:
        if mir_scan_rt_flags(li_rt_import_content_get(scan_i), tk, ts, te, n, ftmp, ptok, pex, pn) == 1:
          return 1
        par_total = par_total + mir_count_parallel(li_rt_import_content_get(scan_i), tk, ts, te, n)
    scan_i = scan_i + 1
  n[0] = 0
  if lex_source(src, tk, ts, te, n, 0) == 1:
    return 1
  par_total = par_total + mir_count_parallel(src, tk, ts, te, n)
  li_rt_mir_str("MIR")
  li_rt_ast_space()
  li_rt_ast_int(pn[0] + par_total)
  li_rt_ast_space()
  if par_total > 0:
    li_rt_ast_int(1)
  else:
    li_rt_ast_int(0)
  li_rt_ast_space()
  li_rt_ast_int(has_async)
  li_rt_ast_space()
  li_rt_ast_int(peek32768(ftmp, 4086))
  li_rt_ast_space()
  li_rt_ast_int(peek32768(ftmp, 4087))
  li_rt_ast_space()
  li_rt_ast_int(peek32768(ftmp, 4088))
  li_rt_ast_space()
  li_rt_ast_int(0)
  li_rt_ast_nl()
  pi[0] = 0
  err[0] = 0
  pcount[0] = 0
  li_rt_mir_par_counter_reset()
  if mir_walk(src,  tk,  ts,  te,  n,  pi,  err,  1, tc,  lastop,  ftok,  nft,  ftmp,  itok,  nit,  itmp,  fatok,  nfa, matok,  nmat, ptok,  pex,  pp0,  ppn,  pret,  pn,  ptok2,  pty,  pelems,  pef, pei,  pvar,  pmx,  pmc,  pcount) == 1:
    return 1
  # ---- Emit imports (re-lex each import; mir_proc reads from C globals) ----
  ii = 0
  while ii < imp_n[0]:
    var f3: ptr = li_rt_import_content_get(ii)
    n[0] = 0
    if lex_source(f3,  tk,  ts,  te,  n, 0) == 0:
      pi[0] = 0
      err[0] = 0
      if mir_walk(f3,  tk,  ts,  te,  n,  pi,  err,  1, tc,  lastop,  ftok,  nft,  ftmp,  itok,  nit,  itmp,  fatok,  nfa, matok,  nmat, ptok,  pex,  pp0,  ppn,  pret,  pn,  ptok2,  pty,  pelems,  pef,  pei,  pvar,  pmx,  pmc,  pcount) == 1:
        return 1
    ii = ii + 1
  # Fail loudly rather than emit MIR built from a registry that dropped
  # entries: a registrar that cannot fit an entry marks the store unusable.
  if li_rt_reg_failed() == 1:
    print("mir error: object registry capacity exceeded")
    return 1
  if li_rt_mir_fieldpath_failed() == 1:
    print("mir error: field-path registry capacity exceeded")
    return 1
  if li_rt_mir_objname_failed() == 1:
    print("mir error: objname registry capacity exceeded")
    return 1
  if li_rt_mir_f64_failed() == 1:
    print("mir error: float literal registry capacity exceeded")
    return 1
  return 0

def main() raises IO -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  var argc: int = li_rt_argc()
  if argc < 2:
    print_usage()
    return 1
  if strcmp(li_rt_argv(1), "--version") == 0:
    print_version()
    return 0
  if strcmp(li_rt_argv(1), "smoke") == 0:
    return 0
  var tk: array[262144, int]
  var ts: array[262144, int]
  var te: array[262144, int]
  var n: array[1, int]
  var pi: array[1, int]
  var err: array[1, int]
  n[0] = 0
  pi[0] = 0
  err[0] = 0
  if strcmp(li_rt_argv(1), "lex") == 0:
    if argc < 3:
      print_usage()
      return 1
    var f: ptr = li_rt_read_file(li_rt_argv(2))
    var r: int = lex_source(f, tk, ts, te, n, 1)
    if r == 1:
      print("lex error")
      return 1
    return 0
  if strcmp(li_rt_argv(1), "parse") == 0:
    if argc < 3:
      print_usage()
      return 1
    var f: ptr = li_rt_read_file(li_rt_argv(2))
    var r: int = parse_file(f, tk, ts, te, n, pi, err, 0, 1)
    if r == 1:
      print("parse error")
      return 1
    print("parse ok")
    return 0
  if strcmp(li_rt_argv(1), "ast") == 0:
    if argc < 3:
      print_usage()
      return 1
    var f: ptr = li_rt_read_file(li_rt_argv(2))
    var r: int = parse_file(f, tk, ts, te, n, pi, err, 1, 0)
    if r == 1:
      print("ast error")
      return 1
    return 0
  if strcmp(li_rt_argv(1), "mir") == 0:
    if argc < 3:
      print_usage()
      return 1
    var f: ptr = li_rt_read_file(li_rt_argv(2))
    var r: int = lex_source(f, tk, ts, te, n, 0)
    if r == 1:
      print("mir error")
      return 1
    # C++ `lic mir` runs check_source_policies before lowering; mirror the
    # gate so policy rejections match the host on the `mir` lane.
    var pr: int = mir_policy_check(f, tk, ts, te, n, err)
    if pr == 1:
      print("mir error")
      return 1
    # Import-cycle gate (C++ load DFS in-progress set; depth-2 mirror).
    var iccr: int = mir_import_cycle_check(li_rt_argv(2), f, tk, ts, te, n, err)
    if iccr == 1:
      print("mir error")
      return 1
    # Unknown-type gate (C++ typecheck_module unknown-type class; checks only
    # the main module's own annotation spans against the merged alias space).
    var tsr: int = mir_type_space_check(li_rt_argv(2), f, tk, ts, te, n, err)
    if tsr == 1:
      print("mir error")
      return 1
      print("mir error")
      return 1
    var fxr: int = fx_mir_effects(f, li_rt_argv(2), tk, ts, te, n, pi, err)
    if fxr == 1:
      print("mir error")
      return 1
    var mr: int = mir_module(f, li_rt_argv(2), tk, ts, te, n, pi, err)
    if mr == 1:
      print("mir error")
      return 1
    return 0
  if strcmp(li_rt_argv(1), "check") == 0:
    if argc < 3:
      print_usage()
      return 1
    var f: ptr = li_rt_read_file(li_rt_argv(2))
    var r: int = parse_file(f, tk, ts, te, n, pi, err, 0, 0)
    if r == 1:
      print("check error")
      return 1
    # Unknown-type gate (C++ `li check` runs typecheck_module; unknown type
    # names in the main module's annotations reject). The gate re-lexes and
    # restores the token arrays, so the batteries below see the same stream.
    var tsr2: int = mir_type_space_check(li_rt_argv(2), f, tk, ts, te, n, err)
    pi[0] = 0
    err[0] = 0
    var err_any: array[1, int]
    err_any[0] = tsr2
    # Source-policy gate (C++ check_source_policies — parallel_requires_disjoint,
    # buf[0]/counter/borrow-mut rules, lanes=8 ceiling): same token scan the
    # mir lane already runs, folded into the check verdict like the C++
    # policy pass sits ahead of typecheck in `li check`.
    var polcheck: int = mir_policy_check(f, tk, ts, te, n, err)
    if polcheck == 1:
      err_any[0] = 1
    var cr: int = check_source(f, tk, ts, te, n, pi, err)
    if err[0] == 1:
      err_any[0] = 1
    pi[0] = 0
    err[0] = 0
    var er: int = effects_check(f, li_rt_argv(2), tk, ts, te, n, pi, err)
    if err[0] == 1:
      err_any[0] = 1
    pi[0] = 0
    err[0] = 0
    var br: int = borrow_check(f, tk, ts, te, n, pi, err)
    if err[0] == 1:
      err_any[0] = 1
    pi[0] = 0
    err[0] = 0
    var er2: int = encap_check(f, tk, ts, te, n, pi, err)
    if err[0] == 1:
      err_any[0] = 1
    if err_any[0] == 1:
      print("check error")
      return 1
    print("check ok")
    return 0
  print_usage()
  return 1    