def parse_type_params(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], d: int, rec: int) -> int
  requires true
  ensures result == 1
  decreases 0
=
  if accept_k(tk, n, pi, err, 51) == 0:
    return 1
  if cur_kind(tk, n, pi, err) != 52:
    var done: int = 0
    while done == 0:
      if cur_kind(tk, n, pi, err) != 4:
        err[0] = 1
        break
      var tn: int = pi[0]
      pi[0] = pi[0] + 1
      var bnd: int = -1
      if accept_k(tk, n, pi, err, 56) == 1:
        if cur_kind(tk, n, pi, err) != 4:
          err[0] = 1
        else:
          bnd = pi[0]
          pi[0] = pi[0] + 1
      # Generic binder names (`def f[T: Trait](p: T)`) never resolve to an
      # object layout in the C++ host (g_object_types has no type-var entry),
      # yet an unresolved lookup at a later call site would keep only the
      # arg-is-object-var fallback and wrongly flatten. Register next to
      # trait alias names so the collector's no-flatten gate consults one
      # roster for both shapes.
      li_rt_mir_trait_add(src, peek_tk(ts, tn + 0), peek_tk(te, tn + 0))
      if d == 1:
        if rec == 1:
          if bnd >= 0:
            a_line_text_text(d, src, 5, peek_tk(ts, tn + 0), peek_tk(te, tn + 0), peek_tk(ts, bnd), peek_tk(te, bnd))
          else:
