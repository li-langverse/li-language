    return 1
  if cur_kind(tk,  n,  pi,  err) == 4:
    if tok_is(src,  ts,  te,  pi[0],  "for") == 1:
      pi[0] = pi[0] + 1
      return 1
  return 0

# Skip layout tokens that the lexer interleaves with continued lines inside
# parenthesized argument lists: Newline (1), Indent (2), Dedent (3). The C++
# parser's skip_newlines does the same while brace_depth_ > 0.
def skip_arg_layout(tk: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int]) -> int
  requires true
  ensures result == 0
  decreases 0
=
  while cur_kind(tk, n, pi, err) == 1 or cur_kind(tk, n, pi, err) == 2 or cur_kind(tk, n, pi, err) == 3:
    pi[0] = pi[0] + 1
  return 0

def parse_postfix(src: var ptr,  tk: var array[262144,  int],  ts: var array[262144,  int], te: var array[262144,  int],  n: var array[1,  int], pi: var array[1,  int],  err: var array[1,  int],  d: int) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  var loop: int = 1
  while loop == 1:
    if cur_kind(tk,  n,  pi,  err) == 72:
      pi[0] = pi[0] + 1
      if cur_kind(tk,  n,  pi,  err) != 4:
        err[0] = 1
        return 1
      var ft: int = pi[0]
      # Scan the `.ident` chain ahead: if it ends in `(`,  the whole chain is
      # a method call and every field in it peels away (mirroring the C++
      # peel_method_receiver),  with the innermost field as the method name.
      var j: int = pi[0] + 1
      var mcall: int = 0
      while peek_off(tk, n, pi, j - pi[0]) == 72:
        if peek_off(tk, n, pi, j - pi[0] + 1) == 4:
          j = j + 2
        else:
          break
      if peek_off(tk, n, pi, j - pi[0]) == 49:
        mcall = 1
      if mcall == 1:
        if d == 1:
          a_line_text(d, src, 70, peek_tk(ts, ft), peek_tk(te, ft))
        pi[0] = j
        pi[0] = pi[0] + 1
        if cur_kind(tk, n, pi, err) != 50:
          var done: int = 0
          # Multi-line method-call arguments: skip layout tokens as in parse_primary.
          skip_arg_layout(tk, n, pi, err)
          while done == 0:
            skip_arg_layout(tk, n, pi, err)
            if parse_expr(src, tk, ts, te, n, pi, err, 0, d) == 0:
              return 0
            if accept_k(tk, n, pi, err, 55) == 1:
              done = 0
            else:
              done = 1
        skip_arg_layout(tk, n, pi, err)
        if expect_k(tk, n, pi, err, 50) == 0:
          return 0
        continue
      pi[0] = pi[0] + 1
      if d == 1:
        a_line_text(d, src, 69, peek_tk(ts, ft), peek_tk(te, ft))
      continue
    if cur_kind(tk, n, pi, err) == 51:
      pi[0] = pi[0] + 1
      if d == 1:
        a_line(d, 68)
      if parse_expr(src, tk, ts, te, n, pi, err, 0, d) == 0:
        return 0
      if expect_k(tk, n, pi, err, 52) == 0:
        return 0
      continue
    loop = 0
  return 1

def parse_primary(src: var ptr, tk: var array[262144, int], ts: var array[262144, int], te: var array[262144, int], n: var array[1, int], pi: var array[1, int], err: var array[1, int], d: int) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  var k: int = cur_kind(tk, n, pi, err)
