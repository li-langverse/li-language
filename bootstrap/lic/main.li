def mir_rec_name_i64(darena: var array[65536, int],  rec: int,  src: var ptr, ts: var array[262144, int],  te: var array[262144, int], itok: var array[4096, int],  nit: var array[1, int], itmp: var array[4096, int]) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  if peek65536(darena, rec + 1) == 1:
    return li_rt_reg_get(peek65536(darena, rec + 2))
  return mir_name_i64(src,  ts,  te,  peek65536(darena, rec + 2),  peek65536(darena, rec + 3),  itok,  nit)

def mir_type_info(src: var ptr,  tk: var array[262144, int],  ts: var array[262144, int], te: var array[262144, int],  n: var array[1, int],  pi: var array[1, int], err: var array[1, int],  ti: var array[6, int]) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  ti[0] = 6
  ti[1] = 0
  ti[2] = 0
  ti[3] = 0
  ti[4] = 0
  ti[5] = 0
  if accept_k(tk,  n,  pi,  err, 53) == 1:
    if cur_kind(tk,  n,  pi,  err) != 4:
      err[0] = 1
      return 1
    pi[0] = pi[0] + 1
    expect_k(tk,  n,  pi,  err, 56)
    if mir_type_info(src,  tk,  ts,  te,  n,  pi,  err,  ti) == 1:
      return 1
    expect_k(tk,  n,  pi,  err, 74)
    parse_contract_expr(src,  tk,  ts,  te,  n,  pi,  err, 0)
    expect_k(tk,  n,  pi,  err, 54)
    return 0
  if cur_kind(tk,  n,  pi,  err) == 20:
    ti[1] = 1
    pi[0] = pi[0] + 1
  var k: int = cur_kind(tk,  n,  pi,  err)
  if k != 4:
    if k != 48:
      if k != 47:
        err[0] = 1
        return 1
  var nm: int = pi[0]
  pi[0] = pi[0] + 1
  if tok_is(src,  ts,  te,  nm,  "array") == 1:
    if accept_k(tk,  n,  pi,  err, 51) == 1:
      if cur_kind(tk,  n,  pi,  err) != 5:
        err[0] = 1
        return 1
      ti[2] = int_text_value(src,  ts,  te,  pi[0])
      pi[0] = pi[0] + 1
      expect_k(tk,  n,  pi,  err, 55)
      var eti: array[6, int]
      if mir_type_info(src,  tk,  ts,  te,  n,  pi,  err,  eti) == 1:
        return 1
      expect_k(tk,  n,  pi,  err, 52)
      ti[0] = 5
      ti[3] = eti[0]
      if eti[0] == 5:
        ti[4] = eti[2]
        ti[5] = eti[3]
      return 0
    ti[0] = 5
    return 0
  if tok_is(src,  ts,  te,  nm,  "int") == 1:
    ti[0] = 0
    return 0
  if tok_is(src,  ts,  te,  nm,  "bool") == 1:
    ti[0] = 0
    return 0
  if tok_is(src,  ts,  te,  nm,  "float") == 1:
    ti[0] = 1
    return 0
  if tok_is(src,  ts,  te,  nm,  "float64") == 1:
    ti[0] = 1
    return 0
  if tok_is(src,  ts,  te,  nm,  "float32") == 1:
    ti[0] = 1
    return 0
  if tok_is(src,  ts,  te,  nm,  "float16") == 1:
    ti[0] = 1
    return 0
  if tok_is(src,  ts,  te,  nm,  "float8") == 1:
    ti[0] = 1
    return 0
  if tok_is(src,  ts,  te,  nm,  "float4") == 1:
    ti[0] = 1
    return 0
  if tok_is(src,  ts,  te,  nm,  "f64") == 1:
    ti[0] = 1
    return 0
  if tok_is(src,  ts,  te,  nm,  "f32") == 1:
    ti[0] = 1
    return 0
  if tok_is(src,  ts,  te,  nm,  "f16") == 1:
    ti[0] = 1
    return 0
  if tok_is(src,  ts,  te,  nm,  "f8") == 1:
    ti[0] = 1
    return 0
  if tok_is(src,  ts,  te,  nm,  "f4") == 1:
    ti[0] = 1
    return 0
  if tok_is(src,  ts,  te,  nm,  "int32") == 1:
    ti[0] = 0
    return 0
  if tok_is(src,  ts,  te,  nm,  "int16") == 1:
    ti[0] = 0
    return 0
  if tok_is(src,  ts,  te,  nm,  "int8") == 1:
    ti[0] = 0
    return 0
  if tok_is(src,  ts,  te,  nm,  "i32") == 1:
    ti[0] = 0
    return 0
  if tok_is(src,  ts,  te,  nm,  "i16") == 1:
    ti[0] = 0
    return 0
  if tok_is(src,  ts,  te,  nm,  "i8") == 1:
    ti[0] = 0
    return 0
  if tok_is(src,  ts,  te,  nm,  "str") == 1:
    ti[0] = 2
    return 0
  if tok_is(src,  ts,  te,  nm,  "string") == 1:
    ti[0] = 2
    return 0
  if tok_is(src,  ts,  te,  nm,  "bytes") == 1:
    ti[0] = 3
    return 0
  if tok_is(src,  ts,  te,  nm,  "StringView") == 1:
    ti[0] = 3
    return 0
  if tok_is(src,  ts,  te,  nm,  "ptr") == 1:
    ti[0] = 4
    return 0
  if tok_is(src,  ts,  te,  nm,  "int64") == 1:
    ti[0] = 4
    return 0
  if tok_is(src,  ts,  te,  nm,  "i64") == 1:
    ti[0] = 4
    return 0
  if tok_is(src,  ts,  te,  nm,  "long") == 1:
    ti[0] = 4
    return 0
  if tok_is(src,  ts,  te,  nm,  "unit") == 1:
    ti[0] = 7
    return 0
  if tok_is(src,  ts,  te,  nm,  "simd") == 1:
    # simd[f64, N] — record lanes in ti[2] (type code 8 = simd f64).
    ti[0] = 8
    if accept_k(tk,  n,  pi,  err, 51) == 1:
      var eti3: array[6, int]
      if mir_type_info(src,  tk,  ts,  te,  n,  pi,  err,  eti3) == 1:
        return 1
      if accept_k(tk,  n,  pi,  err, 55) == 1:
        if cur_kind(tk,  n,  pi,  err) == 5:
          ti[2] = int_text_value(src,  ts,  te,  pi[0])
          pi[0] = pi[0] + 1
      expect_k(tk,  n,  pi,  err, 52)
    return 0
  # unknown named type (object/callable/tuple): skip type args
  if cur_kind(tk,  n,  pi,  err) == 49 or cur_kind(tk,  n,  pi,  err) == 51:
    var dep: int = 0
    var d2: int = 0
    while d2 == 0:
      var kk: int = cur_kind(tk,  n,  pi,  err)
      if kk == 49 or kk == 51:
        dep = dep + 1
      if kk == 50 or kk == 52:
        dep = dep - 1
      pi[0] = pi[0] + 1
      if dep <= 0:
        d2 = 1
  return 0

def mir_try_fma(darena: var array[65536, int],  lrec: int,  rrec: int,  src: var ptr, ts: var array[262144, int],  te: var array[262144, int], lastop: var array[1, int]) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  if peek65536(darena, rrec + 0) != 7:
    return 0
  if peek65536(darena, rrec + 1) != 59:
    return 0
  var ml: int = peek65536(darena, rrec + 2)
  var ad: int = peek65536(darena, rrec + 3)
  if peek65536(darena, ml + 0) != 7:
    return 0
  if peek65536(darena, ml + 1) != 61:
    return 0
  var m1: int = peek65536(darena, ml + 2)
  var m2: int = peek65536(darena, ml + 3)
  var adfid: int = -1
  if peek65536(darena, ad + 0) == 1:
    adfid = peek65536(darena, ad + 1)
  else:
    if peek65536(darena, ad + 0) == 0:
      adfid = li_rt_mir_f64_of_int(peek65536(darena, ad + 1))
    else:
      return 0
  var factor: int = -1
  if peek65536(darena, m1 + 0) == 3 and peek65536(darena, m2 + 0) == 3:
    if peek65536(darena, lrec + 0) == 3:
      if mir_slice_eq(src,  peek65536(darena, m1 + 1),  peek65536(darena, m1 + 2),  peek65536(darena, lrec + 1),  peek65536(darena, lrec + 2)) == 1:
        factor = m2
      else:
        if mir_slice_eq(src,  peek65536(darena, m2 + 1),  peek65536(darena, m2 + 2),  peek65536(darena, lrec + 1),  peek65536(darena, lrec + 2)) == 1:
          factor = m1
  if factor < 0:
    return 0
  var f: array[44, int]
  mir_fdef(f)
  f[0] = peek65536(darena, lrec + 1)
  f[1] = peek65536(darena, lrec + 2)
  f[2] = 1
  f[9] = peek65536(darena, factor + 1)
  f[10] = peek65536(darena, factor + 2)
  f[11] = 1
  f[12] = peek65536(darena, lrec + 1)
  f[13] = peek65536(darena, lrec + 2)
  f[14] = 1
  mir_ins_line(src,  f,  32,  0,  adfid,  lastop)
  return 1

def mir_return(darena: var array[65536, int],  dasp: var array[1, int], src: var ptr,  tk: var array[262144, int],  ts: var array[262144, int], te: var array[262144, int],  n: var array[1, int],  pi: var array[1, int], err: var array[1, int],  tc: var array[1, int],  lastop: var array[1, int], ftok: var array[4096, int],  nft: var array[1, int], ftmp: var array[32768, int],  itok: var array[4096, int],  nit: var array[1, int], itmp: var array[4096, int],  fatok: var array[512, int],  nfa: var array[1, int], matok: var array[512, int],  nmat: var array[1, int], ptok: var array[128, int],  pex: var array[128, int], pp0: var array[128, int],  ppn: var array[128, int], pret: var array[128, int],  pn: var array[1, int], ptok2: var array[512, int],  pty: var array[512, int], pelems: var array[512, int],  pef: var array[512, int], pei: var array[512, int],  pvar: var array[512, int], retf_proc: int,  reti64_proc: int, lhead: var array[32, int],  lexit: var array[32, int],  nlp: var array[1, int]) -> int
  requires true
  ensures result == 0 or result == 1
  decreases 0
=
  pi[0] = pi[0] + 1
  var kk: int = cur_kind(tk,  n,  pi,  err)
  # await in return: emit ReturnVoid to match C++ MIR (async calls lowered at LLVM level)
  if kk == 34:
    pi[0] = pi[0] + 1
    mir_parse_expr(darena,  dasp,  src,  tk,  ts,  te,  n,  pi,  err, 0)
    var f0aw: array[44, int]
    mir_fdef(f0aw)
    mir_ins_line(src,  f0aw,  0,  0,  -1,  lastop)
    return 0
  if kk == 1:
    var f0: array[44, int]
    mir_fdef(f0)
    mir_ins_line(src,  f0,  0,  0,  -1,  lastop)
  else:
    if kk == 3:
      var f0a: array[44, int]
      mir_fdef(f0a)
      mir_ins_line(src,  f0a,  0,  0,  -1,  lastop)
    else:
      if kk == 0:
        var f0b: array[44, int]
        mir_fdef(f0b)
        mir_ins_line(src,  f0b,  0,  0,  -1,  lastop)
      else:
        var rec: int = mir_parse_expr(darena,  dasp,  src,  tk,  ts,  te,  n,  pi,  err, 0)
        if rec < 0:
          return 1
        var rk: int = peek65536(darena, rec + 0)
        if rk == 0:
          var f1: array[44, int]
          mir_fdef(f1)
          mir_ins_line(src,  f1,  1,  peek65536(darena, rec + 1),  -1,  lastop)
        else:
          if rk == 1:
            var f2: array[44, int]
            mir_fdef(f2)
            mir_ins_line(src,  f2,  2,  0,  peek65536(darena, rec + 1),  lastop)
          else:
            if rk == 3:
              # Object return: `return v` -> INS 4 (mangled base) + OBJ layout
              var robj: int = mir_obj_find_var(src,  ts,  te,  itmp,  peek65536(darena, rec + 1),  peek65536(darena, rec + 2))
              if robj >= 0:
                mir_ins_mangled_base(src, 4, peek65536(darena, rec + 1), peek65536(darena, rec + 2), lastop)
                var nfo: int = mir_obj_field_count(itmp, robj)
                var fo: int = 0
                while fo < nfo:
                  mir_obj_line(src,  ts,  te,  itmp,  robj,  fo)
                  fo = fo + 1
              else:
                var f3: array[44, int]
                mir_fdef(f3)
                f3[0] = peek65536(darena, rec + 1)
                f3[1] = peek65536(darena, rec + 2)
                f3[2] = 1
                var rf: int = retf_proc
                var ri: int = reti64_proc
                if mir_name_float(src,  ts,  te,  peek65536(darena, rec + 1),  peek65536(darena, rec + 2),  ftok,  nft) == 1:
                  rf = 1
                if mir_name_i64(src,  ts,  te,  peek65536(darena, rec + 1),  peek65536(darena, rec + 2),  itok,  nit) == 1:
                  ri = 1
                f3[19] = rf
                f3[20] = ri
                mir_ins_line(src,  f3,  3,  0,  -1,  lastop)
            else:
              if rk == 9:
                # `return o.field` -> INS 3 with mangled slot name
                var rfb: int = peek65536(darena, rec + 1)
                var rfs: int = peek65536(darena, rec + 2)
                var rfe: int = peek65536(darena, rec + 3)
                if peek65536(darena, rfb + 0) == 3:
                  mir_ins_mangled(src, 3, 0, peek65536(darena, rfb + 1), peek65536(darena, rfb + 2), rfs, rfe, 0, 1, 0, lastop, -1, -1, -1, -1, -1, -1, -1, -1, -1, 0)
                else:
                  # Nested chain root (base itself a field access): the C++
                  # Field-return path reads e.base->ident, which is EMPTY for
                  # a Field base, so the name collapses to
                  # __li_o__<field> (e.g. `return compose.config.x` ->
                  # __li_o__x). Mirror that byte-for-byte instead of falling
                  # back to ReturnVoid. Passing base_s == fld_s emits the
                  # empty base span, so the name renders __li_o__<field>.
                  mir_ins_mangled(src, 3, 0, rfs, rfs, rfs, rfe, 0, 1, 0, lastop, -1, -1, -1, -1, -1, -1, -1, -1, -1, 0)
              else:
                if rk == 7 or rk == 4 or rk == 5 or rk == 11:
                  if mir_lower_expr(darena,  dasp,  rec,  src,  tk,  ts,  te,  n,  pi,  err,  tc,  lastop, ftok,  nft,  ftmp,  itok,  nit,  itmp,  fatok,  nfa, matok,  nmat, ptok,  pex,  pp0,  ppn,  pret,  pn,  ptok2,  pty,  pelems,  pef, pei,  pvar) == 1:
                    return 1
                  # Object-returning call: lower_expr emitted cr slots + INS 8
                  # + OBJ; now emit INS 4 (ReturnObject) with the cr ident and
                  # the callee's return-object layout, matching the C++
                  # append_return_object path.
                  if peek65536(darena, rec + 0) == 8 and peek65536(darena, rec + 1) == 3:
                    var crid4: int = peek65536(darena, rec + 2)
                    var robj4: int = peek65536(darena, rec + 3)
                    li_rt_mir_str("INS")
                    li_rt_ast_space()
                    li_rt_ast_int(4)
                    li_rt_ast_space()
                    li_rt_ast_int(0)
                    li_rt_ast_space()
                    li_rt_ast_int(0)
                    li_rt_ast_space()
                    li_rt_mir_str("__li_o___cr")
                    li_rt_ast_int(crid4)
                    # 5 empty name cells (str_value, callee, lhs, rhs, label)
                    li_rt_ast_space()
                    li_rt_ast_space()
                    li_rt_ast_space()
                    li_rt_ast_space()
                    li_rt_ast_space()
                    # f18..f21: bin_op, ret_is_float, ret_is_i64, index_is_literal (default 1)
                    li_rt_ast_space()
                    li_rt_ast_int(0)
                    li_rt_ast_space()
                    li_rt_ast_int(0)
                    li_rt_ast_space()
                    li_rt_ast_int(0)
                    li_rt_ast_space()
                    li_rt_ast_int(1)
                    # name cell 6 (index_ident, empty)
                    li_rt_ast_space()
                    # f25..f36
                    li_rt_ast_space()
                    li_rt_ast_int(0)
                    li_rt_ast_space()
                    li_rt_ast_int(1)
                    li_rt_ast_space()
                    li_rt_ast_int(0)
                    li_rt_ast_space()
                    li_rt_ast_int(0)
                    li_rt_ast_space()
                    li_rt_ast_int(0)
                    li_rt_ast_space()
                    li_rt_ast_int(0)
                    li_rt_ast_space()
                    li_rt_ast_int(0)
                    li_rt_ast_space()
                    li_rt_ast_int(0)
                    li_rt_ast_space()
                    li_rt_ast_int(0)
                    li_rt_ast_space()
                    li_rt_ast_int(0)
                    li_rt_ast_space()
                    li_rt_ast_int(0)
                    li_rt_ast_space()
                    li_rt_ast_int(0)
                    li_rt_ast_nl()
                    lastop[0] = 4
                    var nf5: int = mir_obj_field_count(itmp, robj4)
                    var fi5: int = 0
                    while fi5 < nf5:
                      mir_obj_line(src,  ts,  te,  itmp,  robj4,  fi5)
