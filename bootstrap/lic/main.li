            else:
              if ack == 1:
                mir_arg_line(src, 0, 0, 1, peek65536(darena, acrec + 1), 0, 0, 0, 0, 0, 0, 0, 0)
              else:
                if ack == 2:
                  mir_arg_line(src, 0, 0, 0, -1, 0, 0, 0, 1, peek65536(darena, acrec + 1), peek65536(darena, acrec + 2), 0, 0)
                else:
